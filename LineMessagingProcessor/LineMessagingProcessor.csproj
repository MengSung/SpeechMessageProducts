<!--
檔案整體說明

目的與定位：定義舊LINE功能外觀及相容轉接的MSBuild專案邊界，集中target、套件及專案參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net10.0；條件評估後的實際輸出以MSBuild為準。
專案參考包含Line.Messaging.csproj、SpeechMessage.Tenancy.csproj；不能新增反向相依或將主機狀態引入純核心。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LineMessagingProcessor</RootNamespace>
    <AssemblyName>LineMessagingProcessor</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS8602;CS8603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Configuration\**" />
    <Compile Remove="DependencyInjection\**" />
    <Compile Remove="Facades\**" />
    <Compile Remove="Factory\**" />
    <Compile Remove="Interfaces\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Services\**" />
    <EmbeddedResource Remove="Configuration\**" />
    <EmbeddedResource Remove="DependencyInjection\**" />
    <EmbeddedResource Remove="Facades\**" />
    <EmbeddedResource Remove="Factory\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Services\**" />
    <None Remove="Configuration\**" />
    <None Remove="DependencyInjection\**" />
    <None Remove="Facades\**" />
    <None Remove="Factory\**" />
    <None Remove="Interfaces\**" />
    <None Remove="Models\**" />
    <None Remove="Services\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="RestSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Line.Messaging\Line.Messaging.csproj" />
    <ProjectReference Include="..\SpeechMessage.Tenancy\SpeechMessage.Tenancy.csproj" />
  </ItemGroup>

</Project>
