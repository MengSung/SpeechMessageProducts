<Project ToolsVersion="15.0" Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <AssemblyName>ChurchReport</AssemblyName>
    <OutputType>Exe</OutputType>
    <BuildInParallel>false</BuildInParallel>
    <!-- 移除 RuntimeIdentifier，.NET 10 不支援 win7-x86 -->
    
    <!-- ✅ Phase 5.1: GC 優化設定 -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    
    <!-- 允許套件降級警告不影響建置 -->
    <NoWarn>$(NoWarn);NU1605;NU1902;NU1903;ASPDEPR005;CA1416;CA2200;CS0105;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0472;CS0618;CS0649;CS8073;CS8632;CS8981;CS1717;CS4014;MVC1000;SYSLIB0014;SYSLIB0021</NoWarn>
    
    <!-- ✅ Phase 5: .NET 10 效能優化設定 -->
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>
    <EnableAVX>true</EnableAVX>
    
    <!-- ✅ 啟用 Ready to Run 編譯，加速冷啟動 -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*;Views\**\*;Areas\**\Views;appsettings.json;appsettings.Production.json;web.config">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
