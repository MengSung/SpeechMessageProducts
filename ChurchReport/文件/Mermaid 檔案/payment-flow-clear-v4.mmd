flowchart TB
    A([奉獻者送出付款])
    B[ChurchReport 產品流程<br/>整理姓名、金額、項目、付款方式]
    C[Profile Resolver<br/>PAY_PROVIDER 對應 Payment Profile]
    D[CreateRequestFactory<br/>產品資料轉 PaymentCreateRequest]
    E[IPaymentGateway.CreatePaymentAsync<br/>進入純金流核心]
    F{依 Profile 選擇 Provider}
    G[PaymentCreateResult<br/>PaymentPageUrl + ProviderOrderRef]
    H[Redirect 到外部金流頁]
    I[外部金流完成付款或失敗]
    J[Callback Controller<br/>MyPay / TSPG / QPay return URL]
    K[PaymentHttpRequestMapper<br/>HttpRequest 轉 PaymentCallbackRequest]
    L[IPaymentGateway.ParseCallbackAsync]
    M{Provider callback parser<br/>驗簽、解密、hash、狀態轉換}
    N[PaymentCallbackResult<br/>訂單、狀態、金額、Ack、診斷資料]
    O[PaymentAcknowledgementResultMapper<br/>回覆金流平台 PlainText / JSON / Redirect]
    P[PaymentWorkflowResultMapper<br/>轉成付款後流程 context]
    Q[PaymentPostPaymentWorkflow<br/>呼叫抽象 handler]
    R[ChurchReportPaymentRecordUpdater<br/>更新 CRM 付費單或奉獻紀錄]
    S[ChurchReportPaymentPayerNotifier<br/>LINE 通知付款者]
    T([ChurchReport 結果頁或後續流程])

    F --> F1[Sinopac/QPay Provider<br/>信用卡 / ATM / callback parser]
    F --> F2[MyPay Provider<br/>高鉅交易 / callback parser]
    F --> F3[Taishin/TSPG Provider<br/>台新交易 / callback parser]
    F1 --> G
    F2 --> G
    F3 --> G

    M --> M1[Sinopac parser]
    M --> M2[MyPay parser]
    M --> M3[Taishin parser]
    M1 --> N
    M2 --> N
    M3 --> N

    A --> B --> C --> D --> E --> F
    G --> H --> I --> J --> K --> L --> M
    N --> O
    N --> P --> Q
    Q --> R --> T
    Q --> S --> T

    classDef product fill:#fff7ed,stroke:#c2410c,stroke-width:2px,color:#111827;
    classDef host fill:#ecfeff,stroke:#0891b2,stroke-width:2px,color:#111827;
    classDef core fill:#eef2ff,stroke:#4f46e5,stroke-width:2px,color:#111827;
    classDef provider fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#111827;
    classDef decision fill:#fef9c3,stroke:#ca8a04,stroke-width:2px,color:#111827;

    class A,B,C,D,J,R,S,T product;
    class K,O,P,Q host;
    class E,G,L,N core;
    class F,M decision;
    class F1,F2,F3,M1,M2,M3,H,I provider;
