    function cellTemplate(cellElement, cellInfo) {
    $('<a/>')
        .attr({ href: '/FeeManagement/Fee/' + `${cellInfo.data.DiscipleLessonsId}` })
        .text(`${cellInfo.data.DiscipleLessonsName}`)
        .appendTo(cellElement)
    }

    function OnRowPrepared(e) {
        e.rowElement.css({ height: 32 });
        e.rowElement.css('font-size', '16px');
        if (e.rowType == 'data') {
            //e.rowElement.css('background', '#fff2a8');
            e.rowElement[0].addEventListener("mouseover", function () {
              e.rowElement.css('background', '#f8fbff');
              e.rowElement.css("transition", "background-color 0.2s");
            });
            e.rowElement[0].addEventListener("mouseleave", function () {
              e.rowElement[0].style.background = ""
            });
        }
    }

</script>
