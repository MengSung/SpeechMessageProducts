@model ChurchReport.ViewModels.MemberInfoDetailViewModel

<style>
    .member-info-detail {
        display: grid;
        align-content: start;
        gap: 14px;
        grid-template-columns: 240px minmax(0, 1fr);
        min-height: 100%;
    }

    .member-info-side {
        border-right: 1px solid #e2e8f0;
        padding: 4px 12px 4px 4px;
    }

    .member-info-photo {
        width: 198px;
        height: 198px;
        border: 3px solid #dbe4ea;
        border-radius: 10px;
        display: block;
        margin: 0 auto 14px;
        object-fit: cover;
        background: #f8fafc;
    }

    /* 大頭照 + 右下角相機圖示(可拍照/選相片，選好即上傳) */
    .member-info-photo-wrapper {
        position: relative;
        width: 198px;
        margin: 0 auto 14px;
    }

    .member-info-photo-wrapper .member-info-photo {
        margin: 0;
        cursor: pointer;
    }

    .member-info-photo-camera {
        position: absolute;
        right: -6px;
        bottom: -6px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #16a34a;
        border: 2px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0, 0, 0, .3);
        transition: background .15s ease;
    }

    .member-info-photo-camera:hover {
        background: #15803d;
    }

    .member-info-photo-camera svg {
        width: 18px;
        height: 18px;
        fill: #fff;
    }

    /* 用 ID 選擇器確保蓋過全域 input[type=file] 樣式(與個人資料頁 #imageFileInput 同作法)；
       以程式 .click() 觸發，display:none 仍可開啟檔案選擇。 */
    #memberInfoPhotoInput {
        display: none !important;
    }

    .member-info-photo-busy {
        opacity: .6;
        pointer-events: none;
    }

    @@media (max-width: 720px) {
        .member-info-photo-wrapper {
            width: 156px;
        }
    }

    .member-info-tabs {
        display: grid;
        gap: 8px;
    }

    .member-info-tab {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        color: #334155;
        cursor: pointer;
        font-weight: 700;
        min-height: 38px;
    }

    .member-info-tab.active {
        border-color: #2563eb;
        background: #eaf2ff;
        color: #1d4ed8;
    }

    .member-info-main {
        min-width: 0;
    }

    .member-info-fields {
        display: grid;
        gap: 8px 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 14px;
    }

    .member-info-field {
        border-bottom: 1px solid #edf2f7;
        min-height: 38px;
        padding-bottom: 6px;
    }

    .member-info-label {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 2px;
    }

    .member-info-value {
        color: #1f2937;
        font-size: 1.1rem;
        overflow-wrap: anywhere;
    }

    .member-info-relations {
        grid-column: 1 / -1;
    }

    .member-info-subgrid {
        display: none;
    }

    .member-info-subgrid.active {
        display: block;
    }

    .member-info-subgrid .dx-datagrid {
        max-width: 100%;
    }

    @@media (max-width: 720px) {
        .member-info-detail {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .member-info-subgrid {
            min-width: 0;
        }

        /* 手機：DataGrid 列區只保留水平溢出；垂直手勢交給外層原生捲動容器。 */
        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container {
            -ms-touch-action: pan-x pan-y;
            touch-action: pan-x pan-y;
            overflow-x: scroll;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }

        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container::-webkit-scrollbar {
            height: 12px;
            -webkit-appearance: none;
        }

        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container::-webkit-scrollbar-thumb {
            background: rgba(37, 99, 235, .65);
            border: 2px solid rgba(255, 255, 255, .7);
            border-radius: 7px;
        }

        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, .1);
            border-radius: 7px;
        }

        .member-info-side {
            border-right: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 0 12px;
        }

        .member-info-photo {
            width: 156px;
            height: 156px;
        }

        .member-info-tabs {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .member-info-fields {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="member-info-detail" data-contact-id="@Model.ContactId">
    <aside class="member-info-side">
        <div class="member-info-photo-wrapper">
            <img id="memberInfoDetailPhoto"
                 class="member-info-photo"
                 src="/MemberInfo/GetContactImage?contactId=@Model.ContactId&size=256"
                 alt="大頭照"
                 loading="eager" decoding="async"
                 onclick="memberInfoTriggerPhotoUpload()" />
            <label class="member-info-photo-camera" title="拍照或選擇相片" onclick="memberInfoTriggerPhotoUpload()">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3 7.17 5H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3.17L15 3H9zm3 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
            </label>
            <input type="file" id="memberInfoPhotoInput" class="member-info-photo-input"
                   accept="image/jpeg,image/png,image/gif"
                   onchange="memberInfoUploadPhoto(this)" />
        </div>
        <div class="member-info-tabs">
            <button type="button" class="member-info-tab" data-tab="present" onclick="memberInfoDetailSwitch('present')">聚會紀錄</button>
            <button type="button" class="member-info-tab" data-tab="equip" onclick="memberInfoDetailSwitch('equip')">裝備紀錄</button>
        </div>
    </aside>

    <main class="member-info-main">
        <section class="member-info-fields">
            <div class="member-info-field">
                <div class="member-info-label">手機</div>
                <div class="member-info-value">@Model.Phone</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">信仰狀態</div>
                <div class="member-info-value">@Model.SpiritualIdentity</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">地址</div>
                <div class="member-info-value">@Model.Address</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">會員身分</div>
                <div class="member-info-value">@Model.MembershipStatus</div>
            </div>
            <div class="member-info-field member-info-relations">
                <div class="member-info-label">關係目標</div>
                <div class="member-info-value">
                    @if (Model.RelationGoals != null && Model.RelationGoals.Count > 0)
                    {
                        @string.Join("、", Model.RelationGoals.Select(r => string.IsNullOrWhiteSpace(r.Role) ? r.TargetName : $"{r.Role}: {r.TargetName}"))
                    }
                    else
                    {
                        <span>（無）</span>
                    }
                </div>
            </div>
        </section>

        <section id="member-subgrid-present-panel" class="member-info-subgrid">
            <div id="member-subgrid-present"></div>
        </section>
        <section id="member-subgrid-equip-panel" class="member-info-subgrid">
            <div id="member-subgrid-equip"></div>
        </section>
    </main>
</div>

<script>
    (function () {
        var contactId = '@Model.ContactId';
        window._memberInfoSubGridInit = { present: false, equip: false, contactId: contactId, scrolledTop: false };

        // ── 大頭照：拍照/選相片 → 立即上傳 ──
        window.memberInfoTriggerPhotoUpload = function () {
            var input = document.getElementById('memberInfoPhotoInput');
            if (input) { input.click(); }
        };

        // 上傳成功後，立即刷新「所有已知網格」中該會友的縮圖(會友資訊 + 小組回報的小組牧養/新人跟進關懷)。
        // 以不分大小寫比對 data-contact-id，並用各 img 自身的 id 重建網址，避免 GUID 大小寫差異造成比對不到。
        function memberInfoRefreshGridThumb(id, version) {
            try {
                var lid = String(id || '').toLowerCase();
                var v = version || Date.now();

                // 清掉前端影像快取(各頁面命名不同，且 key 大小寫可能不同)，否則關閉彈窗後仍會顯示舊圖。
                [window.memberInfoImageCache, window.contactImageCache].forEach(function (cache) {
                    if (!cache) { return; }
                    Object.keys(cache).forEach(function (k) {
                        if (String(k).toLowerCase() === lid) { delete cache[k]; }
                    });
                });

                function refreshAvatars(selector, endpoint) {
                    $(selector).each(function () {
                        var cid = this.dataset ? (this.dataset.contactId || '') : '';
                        if (cid && cid.toLowerCase() === lid) {
                            this.src = endpoint + '?contactId=' + encodeURIComponent(cid) + '&size=48&v=' + v;
                        }
                    });
                }

                // 會友資訊網格：縮圖來自 /MemberInfo/GetContactImage
                refreshAvatars('#MemberInfoGridContainer .member-info-avatar-img[data-contact-id]', '/MemberInfo/GetContactImage');
                // 小組回報頁(小組牧養/新人跟進關懷)網格：縮圖來自 /Personal/GetContactImage
                refreshAvatars('#SmallGroupgridContainer .contact-avatar-img[data-contact-id], #NewPersonGridContainer .contact-avatar-img[data-contact-id]', '/Personal/GetContactImage');
            } catch (e) { }
        }

        window.memberInfoUploadPhoto = function (input) {
            if (!input || !input.files || input.files.length === 0) { return; }

            var file = input.files[0];
            if (file.size > 5 * 1024 * 1024) {
                DevExpress.ui.notify('檔案過大，請選擇小於 5MB 的圖片', 'error', 3000);
                input.value = '';
                return;
            }
            if (['image/jpeg', 'image/png', 'image/gif'].indexOf(file.type) === -1) {
                DevExpress.ui.notify('只支援 JPG、PNG、GIF 格式', 'error', 3000);
                input.value = '';
                return;
            }

            var photo = document.getElementById('memberInfoDetailPhoto');
            var wrapper = photo ? photo.closest('.member-info-photo-wrapper') : null;

            // 即時預覽(不等伺服器)
            var reader = new FileReader();
            reader.onload = function (e) { if (photo) { photo.src = e.target.result; } };
            reader.readAsDataURL(file);

            if (wrapper) { wrapper.classList.add('member-info-photo-busy'); }
            DevExpress.ui.notify('上傳中...', 'info', 1500);

            var formData = new FormData();
            formData.append('contactId', contactId);
            formData.append('imageFile', file);

            $.ajax({
                url: '/MemberInfo/UploadContactImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (wrapper) { wrapper.classList.remove('member-info-photo-busy'); }
                    if (response && response.success) {
                        var version = response.imageVersion || Date.now();
                        if (photo) {
                            photo.src = '/MemberInfo/GetContactImage?contactId=' + encodeURIComponent(contactId) + '&size=256&v=' + version;
                        }
                        memberInfoRefreshGridThumb(contactId, version);
                        DevExpress.ui.notify(response.message || '大頭照上傳成功！', 'success', 2000);
                    } else {
                        DevExpress.ui.notify((response && response.message) || '上傳失敗', 'error', 4000);
                    }
                },
                error: function (xhr) {
                    if (wrapper) { wrapper.classList.remove('member-info-photo-busy'); }
                    var msg = (xhr && xhr.status === 403) ? '無權限變更此會友的大頭照' : '上傳失敗，請稍後再試';
                    DevExpress.ui.notify(msg, 'error', 4000);
                }
            });

            input.value = '';
        };
        var isMobile = window.innerWidth <= 720;
        // 手機使用原生水平捲動，外層 popup 內容則負責唯一的垂直捲動。
        // 避免 simulated scrolling 和外層 touch scroll 互相搶手勢。
        var gridScrollOptions = isMobile ? {
            mode: 'standard',
            scrollByContent: true,
            scrollByThumb: true,
            useNative: true,
            showScrollbar: 'always'
        } : {
            mode: 'standard',
            useNative: false,
            scrollByContent: true,
            scrollByThumb: true,
            showScrollbar: 'onHover'
        };

        function memberInfoGridReady(e) {
            var node = e && e.element && e.element.get ? e.element.get(0) : (e && e.element);
            // 網格與照片載入後，若使用者尚未操作，維持畫面在頂端先看到大頭照。
            if (window.memberInfoDetailRefreshScroll) {
                window.memberInfoDetailRefreshScroll(node);
            }
        }

        $('.member-info-photo').one('load', function () {
            if (window.memberInfoDetailRefreshScroll) {
                window.memberInfoDetailRefreshScroll(this);
            }
        });

        window.memberInfoDetailSwitch = function (tab) {
            $('.member-info-tab').removeClass('active');
            $('.member-info-tab[data-tab="' + tab + '"]').addClass('active');
            $('.member-info-subgrid').removeClass('active');
            $('#member-subgrid-' + tab + '-panel').addClass('active');
            initMemberInfoSubGrid(tab, contactId);
        };

        window.initMemberInfoSubGrid = function (tab, id) {
            if (tab === 'present' && !window._memberInfoSubGridInit.present) {
                window._memberInfoSubGridInit.present = true;
                $('#member-subgrid-present').dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: 'PresentRecordId',
                        loadUrl: '/MemberInfo/LoadContactPresentRecords',
                        loadParams: { contactId: id }
                    }),
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    wordWrapEnabled: true,
                    width: '100%',
                    columnAutoWidth: false,
                    focusStateEnabled: false,
                    focusedRowEnabled: false,
                    hoverStateEnabled: false,
                    autoNavigateToFocusedRow: false,
                    scrolling: gridScrollOptions,
                    noDataText: '沒有資料',
                    paging: { pageSize: 10 },
                    onContentReady: memberInfoGridReady,
                    columns: isMobile ? [
                        { dataField: 'FullName', caption: '姓名', width: 96 },
                        { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 122 },
                        { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 82 },
                        { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 92 },
                        { dataField: 'PrayItem', caption: '代禱', width: 320 }
                    ] : [
                        { dataField: 'FullName', caption: '姓名', width: 100 },
                        { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 120 },
                        { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 70 },
                        { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 70 },
                        { dataField: 'PrayItem', caption: '代禱', width: 460 }
                    ]
                });
            }

            if (tab === 'equip' && !window._memberInfoSubGridInit.equip) {
                window._memberInfoSubGridInit.equip = true;
                $('#member-subgrid-equip').dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: 'StorLessonsEntityId',
                        loadUrl: '/MemberInfo/LoadContactStorLessons',
                        loadParams: { contactId: id }
                    }),
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    wordWrapEnabled: true,
                    width: '100%',
                    columnAutoWidth: false,
                    focusStateEnabled: false,
                    focusedRowEnabled: false,
                    hoverStateEnabled: false,
                    autoNavigateToFocusedRow: false,
                    scrolling: gridScrollOptions,
                    noDataText: '沒有資料',
                    paging: { pageSize: 10 },
                    onContentReady: memberInfoGridReady,
                    columns: isMobile ? [
                        { dataField: 'DiscipleLessonsName', caption: '課程名稱', width: 240 },
                        { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 126 },
                        { dataField: 'StageName', caption: '階段', width: 140 },
                        { dataField: 'CurrentComplete', caption: '結業', dataType: 'boolean', width: 110 }
                    ] : [
                        { dataField: 'DiscipleLessonsName', caption: '課程名稱', width: 280 },
                        { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 130 },
                        { dataField: 'StageName', caption: '階段名稱', width: 140 },
                        { dataField: 'CurrentComplete', caption: '是否結業', dataType: 'boolean', width: 120 }
                    ]
                });
            }
        };

        setTimeout(function () {
            window.memberInfoDetailSwitch('present');
        }, 180);
    })();
</script>
