@model ChurchReport.ViewModels.MemberInfoDetailViewModel
@{
    // 先在伺服器端整理大頭照來源種類，讓前端只需依這個統一結果切換外觀與標籤，避免 JS 重複判斷。
    var detailAvatarSource = Model.AvatarSource == "primary" || Model.AvatarSource == "line" || Model.AvatarSource == "fallback"
        ? Model.AvatarSource
        : "fallback";
    // 右上角的小標籤僅用於提示圖片來源，未提供來源時保持空白，避免畫面出現多餘文字。
    var detailAvatarBadgeText = detailAvatarSource == "primary"
        ? "\u7167\u7247"
        : (detailAvatarSource == "line" ? "LINE" : string.Empty);
    // 滑鼠停留或輔助工具會讀到的標題字串，必須與來源種類一致，方便維護與除錯。
    var detailAvatarTitle = detailAvatarSource == "primary"
        ? "\u4e3b\u8981\u7167\u7247"
        : (detailAvatarSource == "line" ? "LINE \u7167\u7247" : "\u9810\u8a2d\u526a\u5f71");
}

<style>
    /* 主要容器採左右雙欄配置：左側放大頭照與切換按鈕，右側放可編輯欄位與資料表。 */
    .member-info-detail {
        display: grid;
        align-content: start;
        gap: 14px;
        grid-template-columns: 240px minmax(0, 1fr);
        min-height: 100%;
    }

    /* 左側邊欄以分隔線區分內容，讓照片區與資料區在視覺上更清楚。 */
    .member-info-side {
        border-right: 1px solid #e2e8f0;
        padding: 4px 12px 4px 4px;
    }

    /* 大頭照本體：限制最大尺寸、維持等比縮放，避免圖片過大撐破彈窗版面。 */
    .member-info-photo {
        width: auto;
        height: auto;
        max-width: 198px;
        max-height: 198px;
        border: 3px solid #dbe4ea;
        border-radius: 10px;
        display: block;
        margin: 0 auto 14px;
        object-fit: contain;
        background: #f8fafc;
    }

    /* 大頭照 + 右下角相機圖示(可拍照/選相片，選好即上傳) */
    .member-info-photo-wrapper {
        position: relative;
        width: fit-content;
        max-width: 198px;
        margin: 0 auto 14px;
    }

    .member-info-photo-wrapper.avatar-source-fallback {
        width: 198px;
    }

    .member-info-photo-wrapper.avatar-source-fallback .member-info-photo {
        width: 198px;
        height: 198px;
        max-width: none;
        max-height: none;
    }

    .member-info-photo-wrapper .member-info-photo {
        margin: 0;
        cursor: pointer;
    }

    .member-info-photo-camera {
        position: absolute;
        right: -6px;
        bottom: -6px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #16a34a;
        border: 2px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0, 0, 0, .3);
        transition: background .15s ease;
    }

    .member-info-photo-camera:hover {
        background: #15803d;
    }

    .member-info-photo-camera svg {
        width: 18px;
        height: 18px;
        fill: #fff;
    }

    /* 來源徽章只在主照片或 LINE 照片時顯示，讓使用者知道目前使用的是哪種影像。 */
    .member-info-photo-source-badge {
        position: absolute;
        top: 6px;
        right: 6px;
        display: none;
        min-width: 17px;
        height: 10px;
        padding: 0 2px;
        border: 1px solid #fff;
        border-radius: 2px;
        color: #fff;
        font-size: 6px;
        font-weight: 700;
        line-height: 9px;
        text-align: center;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .18);
        pointer-events: none;
        z-index: 2;
    }

    .member-info-photo-wrapper.avatar-source-primary .member-info-photo-source-badge,
    .member-info-photo-wrapper.avatar-source-line .member-info-photo-source-badge {
        display: block;
    }

    .member-info-photo-wrapper.avatar-source-primary .member-info-photo-source-badge {
        background: #16a34a;
    }

    .member-info-photo-wrapper.avatar-source-line .member-info-photo-source-badge {
        min-width: 18px;
        background: #2563eb;
    }

    /* 用 ID 選擇器確保蓋過全域 input[type=file] 樣式(與個人資料頁 #imageFileInput 同作法)；
       以程式 .click() 觸發，display:none 仍可開啟檔案選擇。 */
    #memberInfoPhotoInput {
        display: none !important;
    }

    .member-info-photo-busy {
        opacity: .6;
        pointer-events: none;
    }

    @@media (max-width: 720px) {
        .member-info-photo-wrapper {
            max-width: 156px;
        }
    }

    .member-info-tabs {
        display: grid;
        gap: 8px;
    }

    .member-info-tab {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        color: #334155;
        cursor: pointer;
        font-weight: 700;
        min-height: 38px;
    }

    .member-info-tab.active {
        border-color: #2563eb;
        background: #eaf2ff;
        color: #1d4ed8;
    }

    .member-info-main {
        min-width: 0;
    }

    /* 會員資料編輯區採兩欄排版，方便在桌面版同時檢視多個欄位。 */
    .member-info-fields {
        display: grid;
        gap: 8px 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 14px;
    }

    /* 單一欄位用底線與最小高度撐出一致的閱讀節奏。 */
    .member-info-field {
        border-bottom: 1px solid #edf2f7;
        min-height: 38px;
        padding-bottom: 6px;
    }

    /* 標籤以較淡的顏色呈現，讓使用者快速辨識欄位名稱而不搶走主要內容注意力。 */
    .member-info-label {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 2px;
    }

    /* 值欄位允許長文字換行，避免地址或關係資料在小螢幕時被截斷。 */
    .member-info-value {
        color: #1f2937;
        font-size: 1.1rem;
        overflow-wrap: anywhere;
    }

    /* 可編輯欄位(手機/地址輸入框、信仰狀態/會員身分下拉)。font-size:16px 防 iOS 點擊自動放大。 */
    .member-info-edit {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #93c5fd;
        border-radius: 6px;
        padding: 7px 9px;
        font-size: 16px;
        color: #1f2937;
        background: #f7fbff;
    }

    .member-info-edit:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 2px rgba(37, 99, 235, .15);
    }

    select.member-info-edit {
        appearance: auto;
        -webkit-appearance: auto;
    }

    .member-info-relations {
        grid-column: 1 / -1;
    }

    .member-info-subgrid {
        display: none;
    }

    .member-info-subgrid.active {
        display: block;
    }

    .member-info-subgrid .dx-datagrid {
        max-width: 100%;
    }

    @@media (max-width: 720px) {
        .member-info-detail {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        .member-info-subgrid {
            min-width: 0;
        }

        /* 手機：DataGrid 列區只保留水平溢出；垂直手勢交給外層原生捲動容器。 */
        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container {
            -ms-touch-action: pan-x pan-y;
            touch-action: pan-x pan-y;
            overflow-x: scroll;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }

        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container::-webkit-scrollbar {
            height: 12px;
            -webkit-appearance: none;
        }

        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container::-webkit-scrollbar-thumb {
            background: rgba(37, 99, 235, .65);
            border: 2px solid rgba(255, 255, 255, .7);
            border-radius: 7px;
        }

        .member-info-subgrid .dx-datagrid-rowsview .dx-scrollable-container::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, .1);
            border-radius: 7px;
        }

        .member-info-side {
            border-right: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 0 12px;
        }

        .member-info-photo {
            max-width: 156px;
            max-height: 156px;
        }

        .member-info-photo-wrapper.avatar-source-fallback,
        .member-info-photo-wrapper.avatar-source-fallback .member-info-photo {
            width: 156px;
            height: 156px;
        }

        .member-info-tabs {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .member-info-fields {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="member-info-detail" data-contact-id="@Model.ContactId">
    <!-- 左側區塊：大頭照、照片來源標籤、相機上傳入口與紀錄分頁按鈕。 -->
    <aside class="member-info-side">
        <div class="member-info-photo-wrapper avatar-source-@detailAvatarSource" data-avatar-source="@detailAvatarSource">
            <img id="memberInfoDetailPhoto"
                 class="member-info-photo"
                 src="/MemberInfo/GetContactImage?contactId=@Model.ContactId&size=0"
                 alt="大頭照"
                 loading="eager" decoding="async"
                 onclick="memberInfoTriggerPhotoUpload()" />
            <span class="member-info-photo-source-badge" title="@detailAvatarTitle">@detailAvatarBadgeText</span>
            <label class="member-info-photo-camera" title="拍照或選擇相片" onclick="memberInfoTriggerPhotoUpload()">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3 7.17 5H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3.17L15 3H9zm3 5a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
            </label>
            <input type="file" id="memberInfoPhotoInput" class="member-info-photo-input"
                   accept="image/jpeg,image/png,image/gif"
                   onchange="memberInfoUploadPhoto(this)" />
        </div>
        <div class="member-info-tabs">
            <button type="button" class="member-info-tab" data-tab="present" onclick="memberInfoDetailSwitch('present')">聚會紀錄</button>
            <button type="button" class="member-info-tab" data-tab="equip" onclick="memberInfoDetailSwitch('equip')">裝備紀錄</button>
        </div>
    </aside>

    <!-- 右側主內容：先顯示可編輯基本資料，再載入對應的資料表分頁內容。 -->
    <main class="member-info-main">
        <section class="member-info-fields">
            <div class="member-info-field">
                <div class="member-info-label">手機</div>
                <input type="text" id="memberInfoPhone" class="member-info-edit"
                       value="@Model.Phone" inputmode="tel" autocomplete="off" />
            </div>
            <div class="member-info-field">
                <div class="member-info-label">信仰狀態</div>
                <select id="memberInfoSpiritual" class="member-info-edit">
                    <option value="">（未設定）</option>
                    @foreach (var opt in Model.SpiritualIdentityOptions)
                    {
                        if (Model.SpiritualIdentityValue.HasValue && Model.SpiritualIdentityValue.Value == opt.Value)
                        {
                            <option value="@opt.Value" selected>@opt.Text</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">地址</div>
                <input type="text" id="memberInfoAddress" class="member-info-edit"
                       value="@Model.Address" autocomplete="off" />
            </div>
            <div class="member-info-field">
                <div class="member-info-label">會員身分</div>
                <select id="memberInfoMembership" class="member-info-edit">
                    <option value="">（未設定）</option>
                    @foreach (var opt in Model.MembershipStatusOptions)
                    {
                        if (Model.MembershipStatusValue.HasValue && Model.MembershipStatusValue.Value == opt.Value)
                        {
                            <option value="@opt.Value" selected>@opt.Text</option>
                        }
                        else
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="member-info-field member-info-relations">
                <div class="member-info-label">關係目標</div>
                <div class="member-info-value">
                    @if (Model.RelationGoals != null && Model.RelationGoals.Count > 0)
                    {
                        @string.Join("、", Model.RelationGoals.Select(r => string.IsNullOrWhiteSpace(r.Role) ? r.TargetName : $"{r.Role}: {r.TargetName}"))
                    }
                    else
                    {
                        <span>（無）</span>
                    }
                </div>
            </div>
        </section>

        <section id="member-subgrid-present-panel" class="member-info-subgrid">
            <div id="member-subgrid-present"></div>
        </section>
        <section id="member-subgrid-equip-panel" class="member-info-subgrid">
            <div id="member-subgrid-equip"></div>
        </section>
    </main>
</div>

<script>
    (function () {
        // 以立即執行函式包住所有細節邏輯，避免汙染全域命名空間，只保留必要的入口函式供彈窗 host 呼叫。
        var contactId = '@Model.ContactId';
        window._memberInfoSubGridInit = { present: false, equip: false, contactId: contactId, scrolledTop: false };

        // 依照片來源同步更新外層樣式與徽章文字，讓前端在換圖後不需要重繪整個區塊。
        function memberInfoSetDetailAvatarSource(source) {
            source = (source === 'primary' || source === 'line' || source === 'fallback') ? source : 'fallback';

            var wrapper = document.querySelector('.member-info-photo-wrapper');
            if (!wrapper) { return; }

            wrapper.classList.remove('avatar-source-primary', 'avatar-source-line', 'avatar-source-fallback');
            wrapper.classList.add('avatar-source-' + source);
            wrapper.dataset.avatarSource = source;

            var badge = wrapper.querySelector('.member-info-photo-source-badge');
            if (!badge) { return; }

            if (source === 'primary') {
                badge.textContent = '\u7167\u7247';
                badge.title = '\u4e3b\u8981\u7167\u7247';
            } else if (source === 'line') {
                badge.textContent = 'LINE';
                badge.title = 'LINE \u7167\u7247';
            } else {
                badge.textContent = '';
                badge.title = '\u9810\u8a2d\u526a\u5f71';
            }
        }

        // ── 大頭照：拍照/選相片 → 立即上傳 ──
        // 這個入口只負責打開檔案選擇器，真正的驗證與 AJAX 上傳在 memberInfoUploadPhoto 中處理。
        window.memberInfoTriggerPhotoUpload = function () {
            var input = document.getElementById('memberInfoPhotoInput');
            if (input) { input.click(); }
        };

        // ── 會友細節「上傳」鈕：把手機/地址/信仰狀態/會員身分一次存回後台 ──
        // 由共用彈窗 host 標題列左上的「上傳」鈕呼叫(全域函式)。以 DOM 的 data-contact-id 取得對象，
        // 故同一彈窗被不同頁面重用、或切換不同會友時也不會存錯人。
        window.memberInfoUploadFields = function () {
            // 先從目前彈窗根節點取出 contactId，確保更新的是當前正在瀏覽的會友。
            var root = document.querySelector('.member-info-detail[data-contact-id]');
            var cid = root ? root.getAttribute('data-contact-id') : '';
            if (!cid) { return; }

            var phoneEl = document.getElementById('memberInfoPhone');
            var addressEl = document.getElementById('memberInfoAddress');
            var membershipEl = document.getElementById('memberInfoMembership');
            var spiritualEl = document.getElementById('memberInfoSpiritual');

            var data = {
                contactId: cid,
                phone: phoneEl ? phoneEl.value : '',
                address: addressEl ? addressEl.value : ''
            };
            // 下拉留在「（未設定）」(空字串)時不送，後台即略過不動該 OptionSet。
            // 這樣可避免使用者只是查看畫面、沒有變更時，仍不小心把原值覆寫成空值。
            if (membershipEl && membershipEl.value !== '') { data.membershipStatusValue = membershipEl.value; }
            if (spiritualEl && spiritualEl.value !== '') { data.spiritualIdentityValue = spiritualEl.value; }

            DevExpress.ui.notify('上傳中...', 'info', 1200);
            $.ajax({
                url: '/MemberInfo/UpdateContactInfo',
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response && response.success) {
                        DevExpress.ui.notify(response.message || '已更新', 'success', 2000);
                    } else {
                        DevExpress.ui.notify((response && response.message) || '更新失敗', 'error', 4000);
                    }
                },
                error: function (xhr) {
                    var msg = (xhr && xhr.status === 403) ? '無權限變更此會友資料' : '更新失敗，請稍後再試';
                    DevExpress.ui.notify(msg, 'error', 4000);
                }
            });
        };

        // 上傳成功後，立即刷新「所有已知網格」中該會友的縮圖(會友資訊 + 小組回報的小組牧養/新人跟進關懷)。
        // 以不分大小寫比對 data-contact-id，並用各 img 自身的 id 重建網址，避免 GUID 大小寫差異造成比對不到。
        function memberInfoRefreshGridThumb(id, version) {
            try {
                // 先把快取清掉，再逐一重設 src，才能確保離開彈窗後看到的是最新大頭照。
                var lid = String(id || '').toLowerCase();
                var v = version || Date.now();

                // 清掉前端影像快取(各頁面命名不同，且 key 大小寫可能不同)，否則關閉彈窗後仍會顯示舊圖。
                [window.memberInfoImageCache, window.contactImageCache].forEach(function (cache) {
                    if (!cache) { return; }
                    Object.keys(cache).forEach(function (k) {
                        if (String(k).toLowerCase() === lid) { delete cache[k]; }
                    });
                });

                function refreshAvatars(selector, endpoint) {
                    $(selector).each(function () {
                        var cid = this.dataset ? (this.dataset.contactId || '') : '';
                        if (cid && cid.toLowerCase() === lid) {
                            this.src = endpoint + '?contactId=' + encodeURIComponent(cid) + '&size=48&v=' + v;
                        }
                    });
                }

                // 會友資訊網格：縮圖來自 /MemberInfo/GetContactImage
                refreshAvatars('#MemberInfoGridContainer .member-info-avatar-img[data-contact-id]', '/MemberInfo/GetContactImage');
                // 小組回報頁(小組牧養/新人跟進關懷)網格：縮圖來自 /Personal/GetContactImage
                refreshAvatars('#SmallGroupgridContainer .contact-avatar-img[data-contact-id], #NewPersonGridContainer .contact-avatar-img[data-contact-id]', '/Personal/GetContactImage');
            } catch (e) { }
        }

        // 檔案上傳流程：先做檔案大小與格式檢查，再立即預覽，最後呼叫後端儲存並同步更新各處縮圖。
        window.memberInfoUploadPhoto = function (input) {
            if (!input || !input.files || input.files.length === 0) { return; }

            var file = input.files[0];
            if (file.size > 5 * 1024 * 1024) {
                DevExpress.ui.notify('檔案過大，請選擇小於 5MB 的圖片', 'error', 3000);
                input.value = '';
                return;
            }
            if (['image/jpeg', 'image/png', 'image/gif'].indexOf(file.type) === -1) {
                DevExpress.ui.notify('只支援 JPG、PNG、GIF 格式', 'error', 3000);
                input.value = '';
                return;
            }

            var photo = document.getElementById('memberInfoDetailPhoto');
            var wrapper = photo ? photo.closest('.member-info-photo-wrapper') : null;

            // 即時預覽(不等伺服器)
            var reader = new FileReader();
            reader.onload = function (e) { if (photo) { photo.src = e.target.result; } };
            reader.readAsDataURL(file);

            if (wrapper) { wrapper.classList.add('member-info-photo-busy'); }
            DevExpress.ui.notify('上傳中...', 'info', 1500);

            var formData = new FormData();
            formData.append('contactId', contactId);
            formData.append('imageFile', file);

            $.ajax({
                url: '/MemberInfo/UploadContactImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (wrapper) { wrapper.classList.remove('member-info-photo-busy'); }
                    if (response && response.success) {
                        var version = response.imageVersion || Date.now();
                        if (photo) {
                            photo.src = '/MemberInfo/GetContactImage?contactId=' + encodeURIComponent(contactId) + '&size=0&v=' + version;
                            memberInfoSetDetailAvatarSource('primary');
                        }
                        memberInfoRefreshGridThumb(contactId, version);
                        DevExpress.ui.notify(response.message || '大頭照上傳成功！', 'success', 2000);
                    } else {
                        DevExpress.ui.notify((response && response.message) || '上傳失敗', 'error', 4000);
                    }
                },
                error: function (xhr) {
                    if (wrapper) { wrapper.classList.remove('member-info-photo-busy'); }
                    var msg = (xhr && xhr.status === 403) ? '無權限變更此會友的大頭照' : '上傳失敗，請稍後再試';
                    DevExpress.ui.notify(msg, 'error', 4000);
                }
            });

            input.value = '';
        };
        // 依螢幕寬度切換表格的捲動策略與欄位寬度，避免手機版看起來過擁擠。
        var isMobile = window.innerWidth <= 720;
        // 手機使用原生水平捲動，外層 popup 內容則負責唯一的垂直捲動。
        // 避免 simulated scrolling 和外層 touch scroll 互相搶手勢。
        var gridScrollOptions = isMobile ? {
            mode: 'standard',
            scrollByContent: true,
            scrollByThumb: true,
            useNative: true,
            showScrollbar: 'always'
        } : {
            mode: 'standard',
            useNative: false,
            scrollByContent: true,
            scrollByThumb: true,
            showScrollbar: 'onHover'
        };

        function memberInfoGridReady(e) {
            var node = e && e.element && e.element.get ? e.element.get(0) : (e && e.element);
            // 網格與照片載入後，若使用者尚未操作，維持畫面在頂端先看到大頭照。
            if (window.memberInfoDetailRefreshScroll) {
                window.memberInfoDetailRefreshScroll(node);
            }
        }

        $('.member-info-photo').one('load', function () {
            if (window.memberInfoDetailRefreshScroll) {
                window.memberInfoDetailRefreshScroll(this);
            }
        });

        // 分頁切換只在第一次點擊時初始化對應 DataGrid，減少初次開啟彈窗的負擔。
        window.memberInfoDetailSwitch = function (tab) {
            $('.member-info-tab').removeClass('active');
            $('.member-info-tab[data-tab="' + tab + '"]').addClass('active');
            $('.member-info-subgrid').removeClass('active');
            $('#member-subgrid-' + tab + '-panel').addClass('active');
            initMemberInfoSubGrid(tab, contactId);
        };

        // 依分頁類型分別初始化不同資料來源，並保留各自的初始化旗標避免重複建立 DataGrid。
        window.initMemberInfoSubGrid = function (tab, id) {
            if (tab === 'present' && !window._memberInfoSubGridInit.present) {
                window._memberInfoSubGridInit.present = true;
                $('#member-subgrid-present').dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: 'PresentRecordId',
                        loadUrl: '/MemberInfo/LoadContactPresentRecords',
                        loadParams: { contactId: id }
                    }),
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    wordWrapEnabled: true,
                    width: '100%',
                    columnAutoWidth: false,
                    focusStateEnabled: false,
                    focusedRowEnabled: false,
                    hoverStateEnabled: false,
                    autoNavigateToFocusedRow: false,
                    scrolling: gridScrollOptions,
                    noDataText: '沒有資料',
                    paging: { pageSize: 10 },
                    onContentReady: memberInfoGridReady,
                    columns: isMobile ? [
                        { dataField: 'FullName', caption: '姓名', width: 96 },
                        { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 122 },
                        { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 82 },
                        { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 92 },
                        { dataField: 'PrayItem', caption: '代禱', width: 320 }
                    ] : [
                        { dataField: 'FullName', caption: '姓名', width: 100 },
                        { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 120 },
                        { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 70 },
                        { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 70 },
                        { dataField: 'PrayItem', caption: '代禱', width: 460 }
                    ]
                });
            }

            if (tab === 'equip' && !window._memberInfoSubGridInit.equip) {
                window._memberInfoSubGridInit.equip = true;
                $('#member-subgrid-equip').dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: 'StorLessonsEntityId',
                        loadUrl: '/MemberInfo/LoadContactStorLessons',
                        loadParams: { contactId: id }
                    }),
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    wordWrapEnabled: true,
                    width: '100%',
                    columnAutoWidth: false,
                    focusStateEnabled: false,
                    focusedRowEnabled: false,
                    hoverStateEnabled: false,
                    autoNavigateToFocusedRow: false,
                    scrolling: gridScrollOptions,
                    noDataText: '沒有資料',
                    paging: { pageSize: 10 },
                    onContentReady: memberInfoGridReady,
                    columns: isMobile ? [
                        { dataField: 'DiscipleLessonsName', caption: '課程名稱', width: 240 },
                        { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 126 },
                        { dataField: 'StageName', caption: '階段', width: 140 },
                        { dataField: 'CurrentComplete', caption: '結業', dataType: 'boolean', width: 110 }
                    ] : [
                        { dataField: 'DiscipleLessonsName', caption: '課程名稱', width: 280 },
                        { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 130 },
                        { dataField: 'StageName', caption: '階段名稱', width: 140 },
                        { dataField: 'CurrentComplete', caption: '是否結業', dataType: 'boolean', width: 120 }
                    ]
                });
            }
        };

        // 預設先載入「聚會紀錄」，讓使用者打開彈窗時立刻看到最常用的資料內容。
        setTimeout(function () {
            window.memberInfoDetailSwitch('present');
        }, 180);
    })();
</script>
