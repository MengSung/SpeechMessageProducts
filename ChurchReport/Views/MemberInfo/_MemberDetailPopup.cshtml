@model ChurchReport.ViewModels.MemberInfoDetailViewModel

<style>
    .member-info-detail {
        display: grid;
        align-content: start;
        gap: 14px;
        grid-template-columns: 190px minmax(0, 1fr);
        min-height: 100%;
    }

    .member-info-side {
        border-right: 1px solid #e2e8f0;
        padding: 4px 12px 4px 4px;
    }

    .member-info-photo {
        width: 132px;
        height: 132px;
        border: 3px solid #dbe4ea;
        border-radius: 10px;
        display: block;
        margin: 0 auto 14px;
        object-fit: cover;
        background: #f8fafc;
    }

    .member-info-tabs {
        display: grid;
        gap: 8px;
    }

    .member-info-tab {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        color: #334155;
        cursor: pointer;
        font-weight: 700;
        min-height: 38px;
    }

    .member-info-tab.active {
        border-color: #2563eb;
        background: #eaf2ff;
        color: #1d4ed8;
    }

    .member-info-main {
        min-width: 0;
    }

    .member-info-fields {
        display: grid;
        gap: 8px 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 14px;
    }

    .member-info-field {
        border-bottom: 1px solid #edf2f7;
        min-height: 38px;
        padding-bottom: 6px;
    }

    .member-info-label {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 2px;
    }

    .member-info-value {
        color: #1f2937;
        font-size: 1.1rem;
        overflow-wrap: anywhere;
    }

    .member-info-relations {
        grid-column: 1 / -1;
    }

    .member-info-subgrid {
        display: none;
    }

    .member-info-subgrid.active {
        display: block;
    }

    .member-info-mobile-records {
        display: grid;
        gap: 8px;
    }

    .member-info-mobile-record {
        border: 1px solid #dbe4ea;
        border-radius: 8px;
        background: #fff;
        padding: 10px;
    }

    .member-info-mobile-record-header {
        align-items: center;
        display: flex;
        gap: 8px;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .member-info-mobile-record-title {
        color: #1f2937;
        font-weight: 700;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .member-info-mobile-record-date {
        color: #64748b;
        flex: 0 0 auto;
        font-size: .9rem;
    }

    .member-info-mobile-flags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 6px;
    }

    .member-info-mobile-flag {
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        color: #475569;
        font-size: .85rem;
        line-height: 1.4;
        padding: 2px 8px;
    }

    .member-info-mobile-flag.active {
        border-color: #2563eb;
        background: #eaf2ff;
        color: #1d4ed8;
        font-weight: 700;
    }

    .member-info-mobile-note {
        color: #334155;
        font-size: .95rem;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .member-info-mobile-state {
        border: 1px solid #dbe4ea;
        border-radius: 8px;
        color: #64748b;
        padding: 12px;
        text-align: center;
    }

    @@media (max-width: 720px) {
        .member-info-detail {
            grid-template-columns: 1fr;
            min-height: auto;
        }

        /* 手機：紀錄區改用原生 HTML 清單，不建立 DataGrid 內層捲軸。 */
        .member-info-subgrid {
            min-width: 0;
        }

        .member-info-side {
            border-right: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 0 12px;
        }

        .member-info-photo {
            width: 104px;
            height: 104px;
        }

        .member-info-tabs {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .member-info-fields {
            grid-template-columns: 1fr;
        }

        .member-info-mobile-record-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 2px;
        }
    }
</style>

<div class="member-info-detail" data-contact-id="@Model.ContactId">
    <aside class="member-info-side">
        <img class="member-info-photo"
             src="/MemberInfo/GetContactImage?contactId=@Model.ContactId&size=0"
             alt="大頭照"
             onerror="this.style.visibility='hidden';" />
        <div class="member-info-tabs">
            <button type="button" class="member-info-tab" data-tab="present" onclick="memberInfoDetailSwitch('present')">聚會紀錄</button>
            <button type="button" class="member-info-tab" data-tab="equip" onclick="memberInfoDetailSwitch('equip')">裝備紀錄</button>
        </div>
    </aside>

    <main class="member-info-main">
        <section class="member-info-fields">
            <div class="member-info-field">
                <div class="member-info-label">手機</div>
                <div class="member-info-value">@Model.Phone</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">信仰狀態</div>
                <div class="member-info-value">@Model.SpiritualIdentity</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">地址</div>
                <div class="member-info-value">@Model.Address</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">會員身分</div>
                <div class="member-info-value">@Model.MembershipStatus</div>
            </div>
            <div class="member-info-field member-info-relations">
                <div class="member-info-label">關係目標</div>
                <div class="member-info-value">
                    @if (Model.RelationGoals != null && Model.RelationGoals.Count > 0)
                    {
                        @string.Join("、", Model.RelationGoals.Select(r => string.IsNullOrWhiteSpace(r.Role) ? r.TargetName : $"{r.Role}: {r.TargetName}"))
                    }
                    else
                    {
                        <span>（無）</span>
                    }
                </div>
            </div>
        </section>

        <section id="member-subgrid-present-panel" class="member-info-subgrid">
            <div id="member-subgrid-present"></div>
        </section>
        <section id="member-subgrid-equip-panel" class="member-info-subgrid">
            <div id="member-subgrid-equip"></div>
        </section>
    </main>
</div>

<script>
    (function () {
        var contactId = '@Model.ContactId';
        window._memberInfoSubGridInit = { present: false, equip: false, contactId: contactId, scrolledTop: false };
        var isMobile = window.innerWidth <= 720;
        // 手機：原生捲動且不顯示捲軸（子網格已填滿寬度、無需自身捲動）；桌面：模擬捲軸恆顯示。
        var gridScrollOptions = isMobile
            ? { mode: 'standard', useNative: true, showScrollbar: 'never' }
            : { mode: 'standard', useNative: false, showScrollbar: 'always' };

        // 把彈窗整頁捲回頂端（先看到大頭照），避免子網格初始化時把內容捲到底部。
        function memberInfoScrollPopupTop(el) {
            var node = el && el.get ? el.get(0) : el;
            if (window.memberInfoResetDetailScrollSoon) {
                window.memberInfoResetDetailScrollSoon(node);
                return;
            }

            var pc = node && node.closest ? node.closest('.member-info-detail-scroll, .dx-popup-content') : null;
            if (pc) { pc.scrollTop = 0; }
        }

        function memberInfoEscapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function memberInfoNormalizeRows(response) {
            if ($.isArray(response)) {
                return response;
            }

            if (response && $.isArray(response.data)) {
                return response.data;
            }

            if (response && $.isArray(response.Data)) {
                return response.Data;
            }

            return [];
        }

        function memberInfoFormatDate(value) {
            if (!value) {
                return '';
            }

            if (typeof value === 'string') {
                var shortDate = value.substring(0, 10).replace(/-/g, '/');
                if (/^\d{4}\/\d{2}\/\d{2}$/.test(shortDate)) {
                    return shortDate;
                }
            }

            var date = new Date(value);
            if (isNaN(date.getTime())) {
                return memberInfoEscapeHtml(value);
            }

            var month = String(date.getMonth() + 1).padStart(2, '0');
            var day = String(date.getDate()).padStart(2, '0');
            return date.getFullYear() + '/' + month + '/' + day;
        }

        function memberInfoActiveFlag(label, active) {
            return '<span class="member-info-mobile-flag' + (active ? ' active' : '') + '">' +
                memberInfoEscapeHtml(label) +
                '</span>';
        }

        function memberInfoSetMobileState(targetSelector, text) {
            $(targetSelector).html('<div class="member-info-mobile-state">' + memberInfoEscapeHtml(text) + '</div>');
        }

        function memberInfoRenderMobilePresent(rows) {
            if (!rows.length) {
                memberInfoSetMobileState('#member-subgrid-present', '沒有資料');
                return;
            }

            var html = '<div class="member-info-mobile-records">';
            rows.forEach(function (row) {
                html += '<article class="member-info-mobile-record">' +
                    '<div class="member-info-mobile-record-header">' +
                    '<div class="member-info-mobile-record-title">' + memberInfoEscapeHtml(row.FullName || row.fullName || '') + '</div>' +
                    '<div class="member-info-mobile-record-date">' + memberInfoEscapeHtml(memberInfoFormatDate(row.SundayDate || row.sundayDate)) + '</div>' +
                    '</div>' +
                    '<div class="member-info-mobile-flags">' +
                    memberInfoActiveFlag('主日', !!(row.Sunday || row.sunday)) +
                    memberInfoActiveFlag('小組', !!(row.SmallGroup || row.smallGroup)) +
                    '</div>';

                var prayItem = row.PrayItem || row.prayItem || '';
                if (prayItem) {
                    html += '<div class="member-info-mobile-note">' + memberInfoEscapeHtml(prayItem) + '</div>';
                }

                html += '</article>';
            });
            html += '</div>';

            $('#member-subgrid-present').html(html);
        }

        function memberInfoRenderMobileEquip(rows) {
            if (!rows.length) {
                memberInfoSetMobileState('#member-subgrid-equip', '沒有資料');
                return;
            }

            var html = '<div class="member-info-mobile-records">';
            rows.forEach(function (row) {
                var lessonName = row.DiscipleLessonsName || row.discipleLessonsName || '';
                var stageName = row.StageName || row.stageName || '';
                var currentComplete = !!(row.CurrentComplete || row.currentComplete);

                html += '<article class="member-info-mobile-record">' +
                    '<div class="member-info-mobile-record-header">' +
                    '<div class="member-info-mobile-record-title">' + memberInfoEscapeHtml(lessonName) + '</div>' +
                    '<div class="member-info-mobile-record-date">' + memberInfoEscapeHtml(memberInfoFormatDate(row.DiscipleLessonsDateTime || row.discipleLessonsDateTime)) + '</div>' +
                    '</div>' +
                    '<div class="member-info-mobile-flags">' +
                    memberInfoActiveFlag(stageName || '階段', !!stageName) +
                    memberInfoActiveFlag('結業', currentComplete) +
                    '</div>' +
                    '</article>';
            });
            html += '</div>';

            $('#member-subgrid-equip').html(html);
        }

        function memberInfoLoadMobileRows(tab, id) {
            var targetSelector = tab === 'present' ? '#member-subgrid-present' : '#member-subgrid-equip';
            var loadUrl = tab === 'present'
                ? '/MemberInfo/LoadContactPresentRecords'
                : '/MemberInfo/LoadContactStorLessons';

            memberInfoSetMobileState(targetSelector, '載入中...');

            $.ajax({
                url: loadUrl,
                type: 'GET',
                data: { contactId: id, skip: 0, take: 50 },
                success: function (response) {
                    var rows = memberInfoNormalizeRows(response);
                    if (tab === 'present') {
                        memberInfoRenderMobilePresent(rows);
                    } else {
                        memberInfoRenderMobileEquip(rows);
                    }

                    if (!window._memberInfoSubGridInit.scrolledTop) {
                        window._memberInfoSubGridInit.scrolledTop = true;
                        memberInfoScrollPopupTop($(targetSelector).get(0));
                    }
                },
                error: function () {
                    memberInfoSetMobileState(targetSelector, '載入失敗');
                }
            });
        }

        window.memberInfoDetailSwitch = function (tab) {
            $('.member-info-tab').removeClass('active');
            $('.member-info-tab[data-tab="' + tab + '"]').addClass('active');
            $('.member-info-subgrid').removeClass('active');
            $('#member-subgrid-' + tab + '-panel').addClass('active');
            initMemberInfoSubGrid(tab, contactId);
        };

        window.initMemberInfoSubGrid = function (tab, id) {
            if (tab === 'present' && !window._memberInfoSubGridInit.present) {
                window._memberInfoSubGridInit.present = true;
                if (isMobile) {
                    memberInfoLoadMobileRows(tab, id);
                    return;
                }

                $('#member-subgrid-present').dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: 'PresentRecordId',
                        loadUrl: '/MemberInfo/LoadContactPresentRecords',
                        loadParams: { contactId: id }
                    }),
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    wordWrapEnabled: true,
                    width: '100%',
                    columnAutoWidth: false,
                    focusStateEnabled: false,
                    scrolling: gridScrollOptions,
                    noDataText: '沒有資料',
                    paging: { pageSize: 10 },
                    onContentReady: function (e) {
                        // 僅在首次載入時校正捲動位置（避免使用者翻頁時又被拉回頂端）
                        if (!window._memberInfoSubGridInit.scrolledTop) {
                            window._memberInfoSubGridInit.scrolledTop = true;
                            memberInfoScrollPopupTop(e.element);
                        }
                    },
                    columns: isMobile ? [
                        { dataField: 'FullName', caption: '姓名', width: 56 },
                        { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 90 },
                        { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 44 },
                        { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 44 },
                        { dataField: 'PrayItem', caption: '代禱', minWidth: 64 }
                    ] : [
                        { dataField: 'FullName', caption: '姓名', width: 100 },
                        { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 120 },
                        { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 70 },
                        { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 70 },
                        { dataField: 'PrayItem', caption: '代禱', width: 460 }
                    ]
                });
            }

            if (tab === 'equip' && !window._memberInfoSubGridInit.equip) {
                window._memberInfoSubGridInit.equip = true;
                if (isMobile) {
                    memberInfoLoadMobileRows(tab, id);
                    return;
                }

                $('#member-subgrid-equip').dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: 'StorLessonsEntityId',
                        loadUrl: '/MemberInfo/LoadContactStorLessons',
                        loadParams: { contactId: id }
                    }),
                    showBorders: true,
                    showRowLines: true,
                    showColumnLines: true,
                    wordWrapEnabled: true,
                    width: '100%',
                    columnAutoWidth: false,
                    focusStateEnabled: false,
                    scrolling: gridScrollOptions,
                    noDataText: '沒有資料',
                    paging: { pageSize: 10 },
                    columns: isMobile ? [
                        { dataField: 'DiscipleLessonsName', caption: '課程名稱', minWidth: 84 },
                        { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 90 },
                        { dataField: 'StageName', caption: '階段', width: 60 },
                        { dataField: 'CurrentComplete', caption: '結業', dataType: 'boolean', width: 52 }
                    ] : [
                        { dataField: 'DiscipleLessonsName', caption: '課程名稱', width: 280 },
                        { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 130 },
                        { dataField: 'StageName', caption: '階段名稱', width: 140 },
                        { dataField: 'CurrentComplete', caption: '是否結業', dataType: 'boolean', width: 120 }
                    ]
                });
            }
        };

        setTimeout(function () {
            window.memberInfoDetailSwitch('present');
        }, 0);
    })();
</script>
