@model ChurchReport.ViewModels.MemberInfoDetailViewModel

<style>
    .member-info-detail {
        display: grid;
        gap: 14px;
        grid-template-columns: 190px minmax(0, 1fr);
        min-height: 100%;
    }

    .member-info-side {
        border-right: 1px solid #e2e8f0;
        padding: 4px 12px 4px 4px;
    }

    .member-info-photo {
        width: 132px;
        height: 132px;
        border: 3px solid #dbe4ea;
        border-radius: 10px;
        display: block;
        margin: 0 auto 14px;
        object-fit: cover;
        background: #f8fafc;
    }

    .member-info-tabs {
        display: grid;
        gap: 8px;
    }

    .member-info-tab {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #fff;
        color: #334155;
        cursor: pointer;
        font-weight: 700;
        min-height: 38px;
    }

    .member-info-tab.active {
        border-color: #2563eb;
        background: #eaf2ff;
        color: #1d4ed8;
    }

    .member-info-main {
        min-width: 0;
    }

    .member-info-fields {
        display: grid;
        gap: 8px 18px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-bottom: 14px;
    }

    .member-info-field {
        border-bottom: 1px solid #edf2f7;
        min-height: 38px;
        padding-bottom: 6px;
    }

    .member-info-label {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 2px;
    }

    .member-info-value {
        color: #1f2937;
        font-size: 1.1rem;
        overflow-wrap: anywhere;
    }

    .member-info-relations {
        grid-column: 1 / -1;
    }

    .member-info-subgrid {
        display: none;
    }

    .member-info-subgrid.active {
        display: block;
    }

    /* 手機卡片式清單（取代網格，避免巢狀捲動卡頓） */
    .mi-cards { display: flex; flex-direction: column; gap: 8px; }
    .mi-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; background: #fff; box-shadow: 0 1px 2px rgba(15, 23, 42, .05); }
    .mi-card-head { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .mi-card-date { font-weight: 700; color: #1f2937; }
    .mi-card-title { font-weight: 700; color: #1f2937; margin-bottom: 4px; }
    .mi-card-meta { color: #475569; font-size: .9rem; margin-top: 2px; }
    .mi-card-body { color: #334155; margin-top: 6px; line-height: 1.5; word-break: break-word; }
    .mi-chip { font-size: .8rem; padding: 2px 8px; border-radius: 999px; border: 1px solid #cbd5e1; color: #94a3b8; }
    .mi-chip-on { background: #dcfce7; border-color: #86efac; color: #15803d; }
    .mi-chip-off { background: #f1f5f9; }
    .mi-cards-msg { padding: 16px; text-align: center; color: #94a3b8; }

    @@media (max-width: 720px) {
        .member-info-detail {
            grid-template-columns: 1fr;
        }

        .member-info-side {
            border-right: 0;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 0 12px;
        }

        .member-info-photo {
            width: 104px;
            height: 104px;
        }

        .member-info-tabs {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .member-info-fields {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="member-info-detail" data-contact-id="@Model.ContactId">
    <aside class="member-info-side">
        <img class="member-info-photo"
             src="/MemberInfo/GetContactImage?contactId=@Model.ContactId&size=0"
             alt="大頭照"
             onerror="this.style.visibility='hidden';" />
        <div class="member-info-tabs">
            <button type="button" class="member-info-tab" data-tab="present" onclick="memberInfoDetailSwitch('present')">聚會紀錄</button>
            <button type="button" class="member-info-tab" data-tab="equip" onclick="memberInfoDetailSwitch('equip')">裝備紀錄</button>
        </div>
    </aside>

    <main class="member-info-main">
        <section class="member-info-fields">
            <div class="member-info-field">
                <div class="member-info-label">手機</div>
                <div class="member-info-value">@Model.Phone</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">信仰狀態</div>
                <div class="member-info-value">@Model.SpiritualIdentity</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">地址</div>
                <div class="member-info-value">@Model.Address</div>
            </div>
            <div class="member-info-field">
                <div class="member-info-label">會員身分</div>
                <div class="member-info-value">@Model.MembershipStatus</div>
            </div>
            <div class="member-info-field member-info-relations">
                <div class="member-info-label">關係目標</div>
                <div class="member-info-value">
                    @if (Model.RelationGoals != null && Model.RelationGoals.Count > 0)
                    {
                        @string.Join("、", Model.RelationGoals.Select(r => string.IsNullOrWhiteSpace(r.Role) ? r.TargetName : $"{r.Role}: {r.TargetName}"))
                    }
                    else
                    {
                        <span>（無）</span>
                    }
                </div>
            </div>
        </section>

        <section id="member-subgrid-present-panel" class="member-info-subgrid">
            <div id="member-subgrid-present"></div>
        </section>
        <section id="member-subgrid-equip-panel" class="member-info-subgrid">
            <div id="member-subgrid-equip"></div>
        </section>
    </main>
</div>

<script>
    (function () {
        var contactId = '@Model.ContactId';
        window._memberInfoSubGridInit = { present: false, equip: false, contactId: contactId };
        // 手機用原生捲動（避免模擬捲軸攔截觸控、整頁卡死）；桌面用模擬捲軸（恆顯示）
        var isMobile = window.innerWidth <= 720;
        // 不設固定高度→網格依內容高度自適應，避免最後一筆與框底出現大空白；
        // 垂直以分頁(每頁10筆+頁碼)瀏覽，水平則因固定欄寬超出寬度而出現捲軸。
        var gridScrollOptions = { mode: 'standard', useNative: isMobile, showScrollbar: 'always' };

        window.memberInfoDetailSwitch = function (tab) {
            $('.member-info-tab').removeClass('active');
            $('.member-info-tab[data-tab="' + tab + '"]').addClass('active');
            $('.member-info-subgrid').removeClass('active');
            $('#member-subgrid-' + tab + '-panel').addClass('active');
            initMemberInfoSubGrid(tab, contactId);
        };

        function memberInfoFmtDate(v) {
            if (!v) return '';
            var d = new Date(v);
            if (isNaN(d.getTime()) || d.getFullYear() <= 1) return '';
            return d.getFullYear() + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + ('0' + d.getDate()).slice(-2);
        }
        function memberInfoEsc(s) {
            return (s == null ? '' : String(s)).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }
        function memberInfoChip(on, label) {
            return '<span class="mi-chip ' + (on ? 'mi-chip-on' : 'mi-chip-off') + '">' + label + (on ? ' ✓' : '') + '</span>';
        }
        // 手機：以 AJAX 取資料，渲染為卡片式清單（純垂直捲動、無巢狀橫向捲軸）
        function memberInfoRenderCards(selector, url, build) {
            var $c = $(selector);
            $c.html('<div class="mi-cards-msg">載入中...</div>');
            $.ajax({
                url: url, type: 'GET', data: { contactId: contactId }, dataType: 'json',
                success: function (resp) {
                    var rows = Array.isArray(resp) ? resp : (resp && resp.data ? resp.data : []);
                    if (!rows.length) { $c.html('<div class="mi-cards-msg">沒有資料</div>'); return; }
                    var html = '';
                    for (var i = 0; i < rows.length; i++) { html += build(rows[i]); }
                    $c.html('<div class="mi-cards">' + html + '</div>');
                },
                error: function () { $c.html('<div class="mi-cards-msg">載入失敗</div>'); }
            });
        }

        window.initMemberInfoSubGrid = function (tab, id) {
            if (tab === 'present' && !window._memberInfoSubGridInit.present) {
                window._memberInfoSubGridInit.present = true;
                if (isMobile) {
                    memberInfoRenderCards('#member-subgrid-present', '/MemberInfo/LoadContactPresentRecords', function (r) {
                        var pray = r.PrayItem ? '<div class="mi-card-body">代禱：' + memberInfoEsc(r.PrayItem) + '</div>' : '';
                        return '<div class="mi-card"><div class="mi-card-head">' +
                            '<span class="mi-card-date">' + memberInfoFmtDate(r.SundayDate) + '</span>' +
                            memberInfoChip(r.Sunday, '主日') + memberInfoChip(r.SmallGroup, '小組') +
                            '</div>' + pray + '</div>';
                    });
                } else {
                    $('#member-subgrid-present').dxDataGrid({
                        dataSource: DevExpress.data.AspNet.createStore({
                            key: 'PresentRecordId',
                            loadUrl: '/MemberInfo/LoadContactPresentRecords',
                            loadParams: { contactId: id }
                        }),
                        showBorders: true,
                        showRowLines: true,
                        showColumnLines: true,
                        wordWrapEnabled: true,
                        width: '100%',
                        columnAutoWidth: false,
                        scrolling: gridScrollOptions,
                        noDataText: '沒有資料',
                        paging: { pageSize: 10 },
                        columns: [
                            { dataField: 'FullName', caption: '姓名', width: 100 },
                            { dataField: 'SundayDate', caption: '主日日期', dataType: 'date', format: 'yyyy/MM/dd', width: 120 },
                            { dataField: 'Sunday', caption: '主日', dataType: 'boolean', width: 70 },
                            { dataField: 'SmallGroup', caption: '小組', dataType: 'boolean', width: 70 },
                            { dataField: 'PrayItem', caption: '代禱', width: 460 }
                        ]
                    });
                }
            }

            if (tab === 'equip' && !window._memberInfoSubGridInit.equip) {
                window._memberInfoSubGridInit.equip = true;
                if (isMobile) {
                    memberInfoRenderCards('#member-subgrid-equip', '/MemberInfo/LoadContactStorLessons', function (r) {
                        return '<div class="mi-card">' +
                            '<div class="mi-card-title">' + memberInfoEsc(r.DiscipleLessonsName) + '</div>' +
                            '<div class="mi-card-meta">日期：' + memberInfoFmtDate(r.DiscipleLessonsDateTime) + '</div>' +
                            '<div class="mi-card-meta">階段：' + memberInfoEsc(r.StageName || '—') + '　結業：' + (r.CurrentComplete ? '是' : '否') + '</div>' +
                            '</div>';
                    });
                } else {
                    $('#member-subgrid-equip').dxDataGrid({
                        dataSource: DevExpress.data.AspNet.createStore({
                            key: 'StorLessonsEntityId',
                            loadUrl: '/MemberInfo/LoadContactStorLessons',
                            loadParams: { contactId: id }
                        }),
                        showBorders: true,
                        showRowLines: true,
                        showColumnLines: true,
                        wordWrapEnabled: true,
                        width: '100%',
                        columnAutoWidth: false,
                        scrolling: gridScrollOptions,
                        noDataText: '沒有資料',
                        paging: { pageSize: 10 },
                        columns: [
                            { dataField: 'DiscipleLessonsName', caption: '課程名稱', width: 280 },
                            { dataField: 'DiscipleLessonsDateTime', caption: '日期', dataType: 'date', format: 'yyyy/MM/dd', width: 130 },
                            { dataField: 'StageName', caption: '階段名稱', width: 140 },
                            { dataField: 'CurrentComplete', caption: '是否結業', dataType: 'boolean', width: 120 }
                        ]
                    });
                }
            }
        };

        setTimeout(function () {
            window.memberInfoDetailSwitch('present');
        }, 0);
    })();
</script>
