@using ChurchReport.ViewModels

@{
    ViewBag.Title = "會友資訊";
}

<style>
    .member-info-page {
        padding: 10px 8px 20px;
    }

    .member-info-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .member-info-title {
        margin: 0;
        color: #1f2937;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .member-info-access {
        color: #64748b;
        font-size: .9rem;
        white-space: nowrap;
    }

    .member-info-grid-shell {
        background: #fff;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        padding: 10px;
        box-shadow: 0 8px 18px rgba(15, 23, 42, .06);
    }

    .member-info-photo-filter-btn {
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 6px;
        padding: 0 16px;
        height: 34px;
        line-height: 1;
        white-space: nowrap;
        font-size: .95rem;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: #16a34a; /* 預設：綠色「顯示照片」 */
        transition: background-color .15s ease;
    }

    /* 讓工具列(含按鈕)完整顯示、不被裁切，並與欄位標題列留一點間距 */
    #MemberInfoGridContainer .dx-datagrid-header-panel {
        overflow: visible;
        padding-bottom: 6px;
    }

    #MemberInfoGridContainer .dx-datagrid-header-panel .dx-toolbar,
    #MemberInfoGridContainer .dx-datagrid-header-panel .dx-toolbar-items-container,
    #MemberInfoGridContainer .dx-datagrid-header-panel .dx-toolbar-item {
        overflow: visible;
    }

    .member-info-photo-filter-btn.is-photo-only {
        background: #2563eb; /* 篩選中：藍色「顯示全部」 */
    }

    .member-info-photo-filter-btn:active {
        transform: translateY(1px);
    }

    #MemberInfoGridContainer .dx-datagrid-headers .dx-header-row td {
        background: #eef6f8;
        color: #1f2937;
        font-weight: 700;
    }

    #MemberInfoGridContainer .dx-datagrid-rowsview .dx-data-row:hover > td {
        background: #fff8db;
    }

    .member-info-name-link {
        color: #2563eb;
        cursor: pointer;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .member-info-avatar-img {
        width: 40px;
        height: 40px;
        border: 2px solid #dbe4ea;
        border-radius: 50%;
        display: block;
        margin: 0 auto;
        object-fit: cover;
        background: #f8fafc;
    }

    /* 大頭照外框：載入時在綠色剪影上疊一個旋轉等待圖示，照片到位後移除 is-loading 即停止旋轉。 */
    .member-info-avatar-wrap {
        position: relative;
        width: 40px;
        height: 40px;
        margin: 0 auto;
    }

    .member-info-avatar-wrap .member-info-avatar-img {
        margin: 0;
    }

    .member-info-avatar-wrap.avatar-source-primary .member-info-avatar-img {
        border-color: #16a34a;
    }

    .member-info-avatar-wrap.avatar-source-line .member-info-avatar-img {
        border-color: #2563eb;
    }

    .member-info-avatar-source-badge {
        position: absolute;
        right: -4px;
        bottom: 0;
        display: none;
        min-width: 13px;
        height: 9px;
        padding: 0 1px;
        border: 1px solid #fff;
        border-radius: 2px;
        color: #fff;
        font-size: 5px;
        font-weight: 700;
        line-height: 8px;
        text-align: center;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .18);
        pointer-events: none;
    }

    .member-info-avatar-wrap.avatar-source-primary .member-info-avatar-source-badge {
        display: block;
        min-width: 14px;
        background: #16a34a;
    }

    .member-info-avatar-wrap.avatar-source-line .member-info-avatar-source-badge {
        display: block;
        min-width: 15px;
        background: #2563eb;
    }

    .member-info-avatar-spinner {
        position: absolute;
        inset: 0;
        margin: auto;
        width: 22px;
        height: 22px;
        border: 3px solid rgba(255, 255, 255, .55);
        border-top-color: #15803d;
        border-radius: 50%;
        animation: member-info-avatar-spin .7s linear infinite;
        display: none;
        pointer-events: none;
    }

    .member-info-avatar-wrap.is-loading .member-info-avatar-spinner {
        display: block;
    }

    @@keyframes member-info-avatar-spin {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 640px) {
        .member-info-page {
            padding: 8px 4px 14px;
        }

        .member-info-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .member-info-grid-shell {
            padding: 6px;
        }
    }

    /* 防止 iOS 點擊輸入框自動放大整頁：輸入字級必須 >= 16px */
    #MemberInfoGridContainer .dx-texteditor-input,
    #memberInfoDetailPopup .dx-texteditor-input {
        font-size: 16px;
    }

    .member-info-detail-popup-content {
        box-sizing: border-box;
        height: 100%;
        min-height: 0;
        padding: 0 !important;
        position: relative;
        overflow: hidden !important;
        overscroll-behavior: contain;
        -ms-touch-action: pan-x;
        touch-action: pan-x;
    }

    /* One native vertical scroll container owns the mobile detail page. */
    .member-info-detail-scroll {
        box-sizing: border-box;
        height: 100%;
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
        position: relative;
        width: 100%;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
        scroll-behavior: auto;
        -ms-touch-action: pan-x;
        touch-action: pan-x;
    }

    .member-info-detail-scroll-inner {
        box-sizing: border-box;
        min-height: 100%;
        padding: 16px;
        -ms-touch-action: pan-x;
        touch-action: pan-x;
    }

    .member-info-detail-top-anchor {
        display: block;
        height: 1px;
        margin-bottom: -1px;
        overflow: hidden;
        pointer-events: none;
    }

    .member-info-detail-loading {
        padding: 16px;
    }

    /* Mobile keeps the same native popup-content scroll container. */
    @@media (max-width: 720px) {
        .member-info-detail-popup-content {
            min-height: 0;
        }

        .member-info-detail-scroll-inner {
            padding: 12px 10px calc(env(safe-area-inset-bottom, 0px) + 16px);
        }
    }
</style>

<div class="member-info-page">
    <div class="member-info-toolbar">
        <h4 class="member-info-title">會友資訊</h4>
        <div class="member-info-access">@ViewBag.MemberInfoAccess</div>
    </div>

    <div class="member-info-grid-shell">
        @(Html.DevExtreme().DataGrid<MemberInfoListRowViewModel>()
            .ID("MemberInfoGridContainer")
            .DataSource(d => d.Mvc()
                .Controller("MemberInfo")
                .LoadAction("LoadMemberInfoList")
                .Key("ContactId"))
            .ShowBorders(true)
            .ShowRowLines(true)
            .ShowColumnLines(true)
            .RowAlternationEnabled(true)
            .ColumnAutoWidth(true)
            .AllowColumnResizing(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnHidingEnabled(true)
            .RemoteOperations(ro => ro
                .Filtering(true)
                .Sorting(true)
                .Paging(true)
                .Grouping(false)
                .Summary(false))
            .SearchPanel(s => s.Visible(true).Placeholder("搜尋姓名、手機或會員身分"))
            .Paging(p => p.PageSize(50))
            .Pager(p => p
                .ShowPageSizeSelector(true)
                .AllowedPageSizes(new[] { 25, 50, 100 })
                .ShowInfo(true))
            .NoDataText("沒有資料")
            .LoadPanel(l => l.Enabled(true).Text("載入中..."))
            .Columns(columns =>
            {
                columns.Add()
                    .DataField("ContactId")
                    .Caption("照片")
                    .Width(58)
                    .MinWidth(58)
                    .AllowSorting(false)
                    .AllowFiltering(false)
                    .AllowEditing(false)
                    .Fixed(true)
                    .CellTemplate(new JS("memberInfoAvatarCellTemplate"));

                columns.AddFor(m => m.FullName)
                    .Caption("姓名")
                    .Width(140)
                    .MinWidth(100)
                    .Fixed(true)
                    .CellTemplate(new JS("memberInfoNameCellTemplate"));

                columns.AddFor(m => m.MembershipStatus)
                    .Caption("會員身分")
                    .Width(110)
                    .MinWidth(90);

                columns.AddFor(m => m.Phone)
                    .Caption("手機")
                    .Width(150)
                    .MinWidth(110);

                columns.AddFor(m => m.SmallGroupName)
                    .Caption("小組")
                    .MinWidth(160);
            })
            .OnContentReady("memberInfoPreloadImages")
            .OnToolbarPreparing("memberInfoGridToolbarPreparing"))
    </div>
</div>

@(Html.DevExtreme().Popup()
    .ID("memberInfoDetailPopup")
    .Width("90%")
    .Height("86%")
    .MaxWidth(980)
    .ShowTitle(true)
    .ShowCloseButton(true)
    .DragEnabled(false)
    .ResizeEnabled(true)
    .Shading(true)
    .OnShown("memberInfoDetailPopupShown")
    .OnHidden("memberInfoDetailPopupHidden"))

<script>
    var memberInfoImageCache = {};
    var memberInfoImageSourceCache = {};
    var memberInfoBatchPending = false;
    // 載入中的本地佔位圖：綠底白色「上半身剪影」(頭與身體相連)。轉圈停止後不可再保留綠底。
    var memberInfoLoadingAvatar = 'data:image/svg+xml;utf8,' + encodeURIComponent(
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='40' height='40'>" +
        "<defs><clipPath id='mig'><circle cx='32' cy='32' r='32'/></clipPath></defs>" +
        "<circle cx='32' cy='32' r='32' fill='#16a34a'/>" +
        "<g clip-path='url(#mig)' fill='#ffffff'>" +
        "<circle cx='32' cy='24.2' r='10.2'/>" +
        "<path d='M8 64c1.5-17.2 10.9-29.6 24-29.6S54.5 46.8 56 64H8z'/>" +
        "</g></svg>");
    var memberInfoFinalFallbackAvatar = 'data:image/svg+xml;utf8,' + encodeURIComponent(
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='40' height='40'>" +
        "<defs><clipPath id='migf'><circle cx='32' cy='32' r='32'/></clipPath></defs>" +
        "<circle cx='32' cy='32' r='32' fill='#aeb6bf'/>" +
        "<g clip-path='url(#migf)' fill='#ffffff'>" +
        "<circle cx='32' cy='24.2' r='10.2'/>" +
        "<path d='M8 64c1.5-17.2 10.9-29.6 24-29.6S54.5 46.8 56 64H8z'/>" +
        "</g></svg>");

    // ── 顯示照片 / 顯示全部 切換 ──
    // 預設：顯示全部(按鈕綠色、文字「顯示照片」)；按下後只顯示真正有照片者(按鈕變藍、文字「顯示全部」)，再按一次切回。
    var memberInfoPhotoOnly = false;
    // 僅「全教會」管理者顯示「重新同步LINE」按鈕（由伺服器端 ViewBag 決定）。
    var memberInfoCanResync = @(ViewBag.MemberInfoCanResync == true ? "true" : "false");

    function memberInfoNormalizeAvatarSource(source) {
        if (source === 'primary' || source === 'line' || source === 'fallback') {
            return source;
        }
        return '';
    }

    /*
    function memberInfoAvatarSourceText(source) {
        if (source === 'primary') { return '照'; }
        if (source === 'line') { return 'LINE'; }
        return '';
    }

    function memberInfoAvatarSourceTitle(source) {
        if (source === 'primary') { return '主要頭像'; }
        if (source === 'line') { return 'LINE 照片'; }
        if (source === 'fallback') { return '預設剪影'; }
        return '照片來源未標記';
    }

    */
    function memberInfoAvatarSourceText(source) {
        if (source === 'primary') { return '\u7167\u7247'; }
        if (source === 'line') { return 'LINE'; }
        return '';
    }

    function memberInfoAvatarSourceTitle(source) {
        if (source === 'primary') { return '\u4e3b\u8981\u7167\u7247'; }
        if (source === 'line') { return 'LINE \u7167\u7247'; }
        if (source === 'fallback') { return '\u9810\u8a2d\u526a\u5f71'; }
        return '\u7167\u7247\u4f86\u6e90\u672a\u6a19\u8a18';
    }

    function memberInfoApplyAvatarSource(wrap, img, source) {
        source = memberInfoNormalizeAvatarSource(source);
        if (!wrap) { return; }

        wrap.classList.remove('avatar-source-primary', 'avatar-source-line', 'avatar-source-fallback');
        if (source) {
            wrap.classList.add('avatar-source-' + source);
        }

        var badge = wrap.querySelector('.member-info-avatar-source-badge');
        if (badge) {
            badge.textContent = memberInfoAvatarSourceText(source);
        }

        if (img) {
            img.title = memberInfoAvatarSourceTitle(source);
            img.dataset.imageSource = source || '';
        }
    }

    window.memberInfoTogglePhotoFilter = function () {
        memberInfoPhotoOnly = !memberInfoPhotoOnly;

        var btn = document.getElementById('memberInfoPhotoFilterBtn');
        if (btn) {
            btn.classList.toggle('is-photo-only', memberInfoPhotoOnly);
            btn.textContent = memberInfoPhotoOnly ? '顯示全部' : '顯示照片';
        }

        var grid = $('#MemberInfoGridContainer').dxDataGrid('instance');
        if (!grid) { return; }

        // 換資料來源並帶入 photoOnly 參數；表格會自行保留並重新套用目前的排序/搜尋狀態。
        grid.option('dataSource', DevExpress.data.AspNet.createStore({
            key: 'ContactId',
            loadUrl: '/MemberInfo/LoadMemberInfoList',
            loadParams: { photoOnly: memberInfoPhotoOnly }
        }));
    };

    // ── 重新同步 LINE 資料 ──
    // 依 new_lineid 向 LINE Profile API 重新取得大頭貼/狀態/暱稱並覆寫(或清空)CRM 欄位。
    // 已換照/移除照片者其照片網址被清空後，下次載入即顯示性別預設剪影、不再有 LINE 標示。
    window.memberInfoResyncLineProfiles = function () {
        if (!window.confirm('將依 LINE ID 重新同步聯絡人的 LINE 大頭貼／狀態／暱稱（已換照或移除者會清空照片），可能需要一點時間，是否繼續？')) { return; }
        var btn = document.getElementById('memberInfoResyncBtn');
        if (btn) { btn.disabled = true; btn.textContent = '同步中…'; }
        $.ajax({
            url: '/MemberInfo/ResyncLineProfiles',
            type: 'POST',
            success: function (res) {
                if (res && res.success) {
                    alert('完成：掃描 ' + res.scanned + ' 人，更新 ' + res.updated + '、清空 ' + res.cleared + '、略過/失敗 ' + res.errors + '。');
                    // 清掉前端影像快取，讓網格重新批次帶回正確的來源(剪影/照片)。
                    memberInfoImageCache = {};
                    memberInfoImageSourceCache = {};
                    var grid = $('#MemberInfoGridContainer').dxDataGrid('instance');
                    if (grid) { grid.refresh(); }
                } else {
                    alert('未完成：' + ((res && res.message) || '未知錯誤'));
                }
            },
            error: function () { alert('同步要求失敗，請稍後再試。'); },
            complete: function () {
                if (btn) { btn.disabled = false; btn.textContent = '重新同步LINE'; }
            }
        });
    };

    // 把按鈕放進網格工具列(與搜尋框同一列、緊鄰網格上端)；onToolbarPreparing 確保工具列每次重建都依目前狀態正確呈現。
    window.memberInfoGridToolbarPreparing = function (e) {
        if (!e || !e.toolbarOptions || !e.toolbarOptions.items) { return; }
        e.toolbarOptions.items.unshift({
            location: 'before',
            locateInMenu: 'never',
            template: function () {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.id = 'memberInfoPhotoFilterBtn';
                btn.className = 'member-info-photo-filter-btn' + (memberInfoPhotoOnly ? ' is-photo-only' : '');
                btn.textContent = memberInfoPhotoOnly ? '顯示全部' : '顯示照片';
                btn.onclick = memberInfoTogglePhotoFilter;
                return btn;
            }
        });

        if (memberInfoCanResync) {
            // 插在「顯示照片」按鈕(index 0)之後，使其顯示在顯示照片的右邊。
            e.toolbarOptions.items.splice(1, 0, {
                location: 'before',
                locateInMenu: 'never',
                template: function () {
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.id = 'memberInfoResyncBtn';
                    btn.className = 'member-info-photo-filter-btn';
                    btn.style.background = '#0ea5e9';
                    btn.textContent = '重新同步LINE';
                    btn.onclick = memberInfoResyncLineProfiles;
                    return btn;
                }
            });
        }
    };

    window.memberInfoAvatarCellTemplate = function (container, options) {
        var data = options.data || {};
        var contactId = data.ContactId || data.contactId || options.value || '';
        var host = container && container.get ? container.get(0) : container;
        if (!host) return;
        host.textContent = '';

        var cached = contactId && memberInfoImageCache[contactId];
        var cachedSource = cached ? memberInfoImageSourceCache[contactId] : '';

        var wrap = document.createElement('div');
        wrap.className = 'member-info-avatar-wrap' + (cached ? '' : ' is-loading');

        var img = document.createElement('img');
        img.className = 'member-info-avatar-img';
        img.alt = '大頭照';
        // 必須 eager：照片欄位是 Fixed(true)，DevExtreme 會把欄位範本渲染在「絕對定位」的
        // 固定欄覆蓋層(.dx-datagrid-content-fixed)。瀏覽器原生 loading="lazy" 的
        // IntersectionObserver 在初次繪製時偵測不到絕對定位/被裁切容器內的圖片，
        // 導致照片必須滑動後才載入。改為 eager 可在網格初始化後第一時間就顯示照片。
        img.loading = 'eager';
        img.decoding = 'async';
        img.dataset.contactId = contactId;
        // 初始：已快取就直接放照片；否則放綠色剪影佔位 + 轉圈，等 memberInfoPreloadImages 批次一次帶回後再換上。
        // 不要在這裡指向 /MemberInfo/GetContactImage——否則每列各自發一支請求、各打一次 CRM，會拖慢甚至餓死唯一的批次請求。
        img.src = cached ? memberInfoImageCache[contactId] : memberInfoLoadingAvatar;
        img.onerror = function () {
            if (img.src !== memberInfoFinalFallbackAvatar) { img.src = memberInfoFinalFallbackAvatar; }
            memberInfoApplyAvatarSource(wrap, img, 'fallback');
            wrap.classList.remove('is-loading');
        };

        var spinner = document.createElement('span');
        spinner.className = 'member-info-avatar-spinner';

        var badge = document.createElement('span');
        badge.className = 'member-info-avatar-source-badge';

        wrap.appendChild(img);
        wrap.appendChild(badge);
        wrap.appendChild(spinner);
        memberInfoApplyAvatarSource(wrap, img, cachedSource);
        host.appendChild(wrap);
    };

    // 照片/剪影到位：換上圖並停止轉圈。載入失敗時退回非綠色的最終 fallback。
    function memberInfoSettleAvatar(img, src, source) {
        var wrap = img.closest('.member-info-avatar-wrap');
        img.onload = function () {
            if (wrap) {
                wrap.classList.remove('is-loading');
                memberInfoApplyAvatarSource(wrap, img, source);
            }
        };
        img.onerror = function () {
            if (img.src !== memberInfoFinalFallbackAvatar) { img.src = memberInfoFinalFallbackAvatar; }
            if (wrap) {
                wrap.classList.remove('is-loading');
                memberInfoApplyAvatarSource(wrap, img, 'fallback');
            }
        };
        img.src = src;
    }

    function memberInfoStopAvatarSpinner(img) {
        var wrap = img.closest('.member-info-avatar-wrap');
        if (img.getAttribute('src') === memberInfoLoadingAvatar) {
            img.src = memberInfoFinalFallbackAvatar;
            memberInfoApplyAvatarSource(wrap, img, 'fallback');
        }
        if (wrap) { wrap.classList.remove('is-loading'); }
    }

    window.memberInfoNameCellTemplate = function (container, options) {
        var data = options.data || {};
        var contactId = data.ContactId || data.contactId || '';
        var fullName = data.FullName || data.fullName || '';
        var host = container && container.get ? container.get(0) : container;
        if (!host) return;
        host.textContent = '';

        var link = document.createElement('a');
        link.href = 'javascript:void(0)';
        link.className = 'member-info-name-link';
        link.textContent = fullName;
        link.addEventListener('click', function (e) {
            e.preventDefault();
            openMemberInfoDetailPopup(contactId, fullName);
        });
        host.appendChild(link);
    };

    window.memberInfoPreloadImages = function (e) {
        if (memberInfoBatchPending || !e || !e.component) return;
        var items = e.component.getDataSource().items() || [];
        var ids = [];
        items.forEach(function (item) {
            var id = item.ContactId || item.contactId;
            if (id && !memberInfoImageCache[id]) {
                ids.push(id);
            }
        });
        if (ids.length === 0) return;

        memberInfoBatchPending = true;
        $.ajax({
            url: '/MemberInfo/GetContactImagesBatch',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ contactIds: ids, size: 48 }),
            success: function (response) {
                if (response && response.success && response.images) {
                    Object.keys(response.images).forEach(function (id) {
                        memberInfoImageCache[id] = response.images[id];
                        memberInfoImageSourceCache[id] = (response.sources && response.sources[id]) || 'fallback';
                    });
                }
                // 批次已回：有圖就換上並停轉；沒回傳該人(極少數，如無權檢視)也停轉，留綠色剪影。
                $('#MemberInfoGridContainer .member-info-avatar-img[data-contact-id]').each(function () {
                    var cid = this.dataset.contactId;
                    if (cid && memberInfoImageCache[cid]) {
                        memberInfoSettleAvatar(this, memberInfoImageCache[cid], memberInfoImageSourceCache[cid]);
                    } else {
                        memberInfoSettleAvatar(this, memberInfoFinalFallbackAvatar, 'fallback');
                    }
                });
            },
            error: function () {
                // 批次失敗 → 退回逐筆載入(舊行為)；載入完成(或失敗)即停轉，不會卡在轉圈。
                $('#MemberInfoGridContainer .member-info-avatar-img[data-contact-id]').each(function () {
                    var cid = this.dataset.contactId;
                    if (cid && !memberInfoImageCache[cid]) {
                        memberInfoSettleAvatar(this, '/MemberInfo/GetContactImage?contactId=' + encodeURIComponent(cid) + '&size=48', '');
                    } else {
                        memberInfoStopAvatarSpinner(this);
                    }
                });
            },
            complete: function () {
                memberInfoBatchPending = false;
            }
        });
    };

    function memberInfoFindDetailPopupContent(contentElement) {
        var $candidate = contentElement ? $(contentElement) : $();
        var $content = $candidate.hasClass('dx-popup-content')
            ? $candidate
            : $candidate.closest('.dx-popup-content');

        if (!$content.length) {
            var popup = $('#memberInfoDetailPopup').dxPopup('instance');
            if (popup && typeof popup.content === 'function') {
                $content = $(popup.content());
            }
        }

        if (!$content.length) {
            $content = $('.member-info-detail-popup-content').last();
        }

        return $content;
    }

    var memberInfoDetailScrollResetToken = 0;
    var memberInfoDetailUserInteracted = false;
    var memberInfoDetailOpenToken = 0;
    var memberInfoDetailScrollCleanup = null;
    var memberInfoSupportsPassiveEvents = false;

    try {
        var memberInfoPassiveProbe = Object.defineProperty({}, 'passive', {
            get: function () {
                memberInfoSupportsPassiveEvents = true;
                return true;
            }
        });
        var memberInfoPassiveNoop = function () { };
        window.addEventListener('memberInfoPassiveProbe', memberInfoPassiveNoop, memberInfoPassiveProbe);
        window.removeEventListener('memberInfoPassiveProbe', memberInfoPassiveNoop, memberInfoPassiveProbe);
    } catch (ex) {
        memberInfoSupportsPassiveEvents = false;
    }

    if (window.history && 'scrollRestoration' in window.history) {
        window.history.scrollRestoration = 'manual';
    }

    function memberInfoAddUniqueElement(list, element) {
        if (element && list.indexOf(element) < 0) {
            list.push(element);
        }
    }

    function memberInfoGetEventOptions(passive, capture) {
        return memberInfoSupportsPassiveEvents
            ? { passive: passive, capture: !!capture }
            : !!capture;
    }

    function memberInfoAddDetailListener(cleanups, element, type, handler, options) {
        if (!element || !element.addEventListener) {
            return;
        }

        element.addEventListener(type, handler, options);
        cleanups.push(function () {
            element.removeEventListener(type, handler, options);
        });
    }

    function memberInfoStopInitialScrollLock() {
        memberInfoDetailUserInteracted = true;
        memberInfoDetailScrollResetToken++;
    }

    function memberInfoGetDetailScrollTargets(contentElement) {
        var $content = memberInfoFindDetailPopupContent(contentElement);
        var targets = [];

        function addFromContent($root) {
            $root.each(function () {
                memberInfoAddUniqueElement(targets, this);
            });

            $root
                .find('.member-info-detail-scroll')
                .each(function () {
                    memberInfoAddUniqueElement(targets, this);
                });
        }

        if ($content.length) {
            addFromContent($content);
        }

        var popup = $('#memberInfoDetailPopup').dxPopup('instance');
        if (popup && typeof popup.content === 'function') {
            addFromContent($(popup.content()));
        }

        return targets;
    }

    function memberInfoBindDetailTouchHandling($content, scrollHost) {
        if (memberInfoDetailScrollCleanup) {
            memberInfoDetailScrollCleanup();
            memberInfoDetailScrollCleanup = null;
        }

        var cleanups = [];
        var unlock = function () {
            memberInfoStopInitialScrollLock();
        };

        $content.add($(scrollHost)).each(function () {
            memberInfoAddDetailListener(cleanups, this, 'touchstart', unlock, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, this, 'pointerdown', unlock, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, this, 'wheel', unlock, memberInfoGetEventOptions(true, true));
        });

        var detailPan = {
            tracking: false,
            lockedAxis: null,
            startX: 0,
            startY: 0,
            lastY: 0
        };

        function getTouchPoint(event) {
            if (event && event.touches && event.touches.length) {
                return event.touches[0];
            }

            if (event && typeof event.clientX === 'number' && typeof event.clientY === 'number') {
                return event;
            }

            return null;
        }

        function detailPanStart(event) {
            if (event && event.pointerType && event.pointerType !== 'touch') {
                return;
            }

            var point = getTouchPoint(event);
            if (!point) {
                return;
            }

            memberInfoStopInitialScrollLock();
            detailPan.tracking = true;
            detailPan.lockedAxis = null;
            detailPan.startX = point.clientX;
            detailPan.startY = point.clientY;
            detailPan.lastY = point.clientY;
        }

        function detailPanMove(event) {
            if (event && event.pointerType && event.pointerType !== 'touch') {
                return;
            }

            var point = getTouchPoint(event);
            if (!point || !detailPan.tracking || !scrollHost) {
                return;
            }

            var dx = point.clientX - detailPan.startX;
            var dy = point.clientY - detailPan.startY;
            var absX = Math.abs(dx);
            var absY = Math.abs(dy);

            if (!detailPan.lockedAxis && Math.max(absX, absY) > 3) {
                detailPan.lockedAxis = absY >= absX ? 'y' : 'x';
            }

            if (detailPan.lockedAxis !== 'y') {
                return;
            }

            var maxScrollTop = Math.max(0, scrollHost.scrollHeight - scrollHost.clientHeight);
            if (maxScrollTop <= 0) {
                return;
            }

            var deltaY = detailPan.lastY - point.clientY;
            if (deltaY === 0) {
                return;
            }

            var nextScrollTop = Math.max(0, Math.min(maxScrollTop, scrollHost.scrollTop + deltaY));
            scrollHost.scrollTop = nextScrollTop;
            detailPan.lastY = point.clientY;

            event.preventDefault();
            event.stopPropagation();
        }

        function detailPanEnd() {
            detailPan.tracking = false;
            detailPan.lockedAxis = null;
        }

        if (window.PointerEvent) {
            memberInfoAddDetailListener(cleanups, scrollHost, 'pointerdown', detailPanStart, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'pointermove', detailPanMove, memberInfoGetEventOptions(false, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'pointerup', detailPanEnd, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'pointercancel', detailPanEnd, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'pointerleave', detailPanEnd, memberInfoGetEventOptions(true, true));
        } else {
            memberInfoAddDetailListener(cleanups, scrollHost, 'touchstart', detailPanStart, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'touchmove', detailPanMove, memberInfoGetEventOptions(false, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'touchend', detailPanEnd, memberInfoGetEventOptions(true, true));
            memberInfoAddDetailListener(cleanups, scrollHost, 'touchcancel', detailPanEnd, memberInfoGetEventOptions(true, true));
        }

        memberInfoDetailScrollCleanup = function () {
            cleanups.forEach(function (cleanup) {
                cleanup();
            });
        };
    }

    function memberInfoGetDetailTopAnchor(contentElement) {
        var $content = memberInfoFindDetailPopupContent(contentElement);
        return $content
            .find('.member-info-detail-top-anchor, .member-info-side, .member-info-photo, .member-info-tabs')
            .filter(':visible')
            .first()
            .get(0);
    }

    function memberInfoIsDetailTopVisible(contentElement) {
        var $content = memberInfoFindDetailPopupContent(contentElement);
        var host = $content.find('.member-info-detail-scroll').get(0) || $content.get(0);
        var anchor = memberInfoGetDetailTopAnchor(contentElement);

        if (!host || !anchor || !host.getBoundingClientRect || !anchor.getBoundingClientRect) {
            return true;
        }

        var hostRect = host.getBoundingClientRect();
        var anchorRect = anchor.getBoundingClientRect();
        return anchorRect.top >= hostRect.top - 2 && anchorRect.top <= hostRect.top + 24;
    }

    window.memberInfoResetDetailScroll = function (contentElement) {
        var $content = memberInfoFindDetailPopupContent(contentElement);
        var scrollTargets = memberInfoGetDetailScrollTargets(contentElement);

        scrollTargets.forEach(function (target) {
            if (!target) {
                return;
            }

            target.scrollTop = 0;
            target.scrollLeft = 0;
        });

        $content.each(function () {
            this.scrollTop = 0;
            this.scrollLeft = 0;
        });

        var anchor = memberInfoGetDetailTopAnchor(contentElement);
        if (!scrollTargets.length && anchor && typeof anchor.scrollIntoView === 'function') {
            try {
                anchor.scrollIntoView({ block: 'start', inline: 'nearest' });
            } catch (ex) {
                anchor.scrollIntoView(true);
            }
        }
    };

    window.memberInfoResetDetailScrollSoon = function (contentElement) {
        var requestFrame = window.requestAnimationFrame || function (callback) {
            window.setTimeout(callback, 0);
        };
        var token = ++memberInfoDetailScrollResetToken;

        function resetIfCurrent() {
            if (token !== memberInfoDetailScrollResetToken || memberInfoDetailUserInteracted) {
                return;
            }

            window.memberInfoResetDetailScroll(contentElement);
        }

        resetIfCurrent();
        requestFrame(resetIfCurrent);
        window.setTimeout(resetIfCurrent, 40);
        window.setTimeout(resetIfCurrent, 120);
        window.setTimeout(resetIfCurrent, 260);
        window.setTimeout(resetIfCurrent, 520);
        window.setTimeout(resetIfCurrent, 900);
        window.setTimeout(resetIfCurrent, 1400);
        window.setTimeout(resetIfCurrent, 2100);
        window.setTimeout(function () {
            if (token === memberInfoDetailScrollResetToken && !memberInfoDetailUserInteracted && !memberInfoIsDetailTopVisible(contentElement)) {
                window.memberInfoResetDetailScroll(contentElement);
            }
        }, 2800);
    };

    // DataGrid can change layout after loading; keep the initial view at the top only before the user interacts.
    window.memberInfoDetailRefreshScroll = function (contentElement) {
        if (!memberInfoDetailUserInteracted) {
            window.memberInfoResetDetailScrollSoon(contentElement);
        }
    };

    window.memberInfoDetailPopupShown = function (e) {
        memberInfoDetailUserInteracted = false;
        window.memberInfoResetDetailScrollSoon(e && e.element);
    };

    window.memberInfoDetailPopupHidden = function (e) {
        memberInfoDetailOpenToken++;
        memberInfoDetailUserInteracted = false;
        if (memberInfoDetailScrollCleanup) {
            memberInfoDetailScrollCleanup();
            memberInfoDetailScrollCleanup = null;
        }
        window.memberInfoResetDetailScroll(e && e.element);
        memberInfoFindDetailPopupContent(e && e.element)
            .empty()
            .removeClass('member-info-detail-popup-content');
    };

    function memberInfoSetDetailPopupContent(contentElement, html) {
        var $content = $(contentElement);
        if (!$content.length) {
            return;
        }

        memberInfoDetailUserInteracted = false;
        $content
            .addClass('member-info-detail-popup-content')
            .empty();

        // Keep one native vertical scroll host; do not create a nested dxScrollView in the popup.
        var $scrollHost = $('<div class="member-info-detail-scroll"><div class="member-info-detail-scroll-inner"></div></div>');
        $content.append($scrollHost);
        $scrollHost.find('.member-info-detail-scroll-inner').html('<div class="member-info-detail-top-anchor" aria-hidden="true"></div>' + html);

        window.memberInfoResetDetailScroll($content);
        memberInfoBindDetailTouchHandling($content, $scrollHost.get(0));
        window.memberInfoResetDetailScrollSoon($content);
    }

    window.openMemberInfoDetailPopup = function (contactId, fullName) {
        if (!contactId) return;
        if (document.activeElement && document.activeElement.blur) {
            document.activeElement.blur();
        }

        var popup = $('#memberInfoDetailPopup').dxPopup('instance');
        var isMobile = window.innerWidth <= 720;
        popup.option({
            title: (fullName || '') + ' - 會友細節',
            fullScreen: isMobile,
            width: isMobile ? '100%' : '90%',
            height: isMobile ? '100%' : '86%',
            maxWidth: isMobile ? '100%' : 980,
            resizeEnabled: !isMobile
        });

        var openToken = ++memberInfoDetailOpenToken;
        memberInfoDetailUserInteracted = false;
        var loadingHtml = '<div class="member-info-detail-loading">載入中...</div>';
        var contentElement = popup.content && popup.content();

        memberInfoSetDetailPopupContent(contentElement, loadingHtml);
        popup.show();
        if (popup.repaint) {
            popup.repaint();
        }

        contentElement = popup.content && popup.content();
        memberInfoSetDetailPopupContent(contentElement, loadingHtml);
        window.memberInfoResetDetailScrollSoon(contentElement);

        $.ajax({
            url: '/MemberInfo/Detail',
            type: 'GET',
            data: { contactId: contactId },
            success: function (html) {
                if (openToken !== memberInfoDetailOpenToken) {
                    return;
                }

                var latestContent = popup.content && popup.content();
                memberInfoSetDetailPopupContent(latestContent, html);
                window.memberInfoResetDetailScrollSoon(latestContent);
            },
            error: function (xhr) {
                if (openToken !== memberInfoDetailOpenToken) {
                    return;
                }

                var text = xhr.status === 403 ? '無權檢視此連絡人' : '載入失敗';
                var latestContent = popup.content && popup.content();
                memberInfoSetDetailPopupContent(latestContent, '<div style="padding:16px;color:#b91c1c;">' + text + '</div>');
                window.memberInfoResetDetailScrollSoon(latestContent);
            }
        });
    };
</script>
