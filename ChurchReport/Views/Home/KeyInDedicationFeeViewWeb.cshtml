                               .DateBox()
                               .Width(135)
                               .Disabled(false)
                               .DisplayFormat("yyyy/M/d")
                               .Placeholder("輸入奉獻日期")
                               .FocusStateEnabled(true)
                          );

                     items.AddSimpleFor(m => m.DedicationNumber)
                            //.DataField("LastName")
                            .Label(l => l.Text("奉獻編號"))
                            .Editor(e => e
                                .TextBox()
                                .Width(120)
                                .Disabled(false)
                                .Placeholder("輸入奉獻編號")
                                .FocusStateEnabled(true)
