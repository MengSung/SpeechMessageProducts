@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h5 id="displaynamefield">奉獻管理</h5>
</div>

<div class="dx-field">
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

    </div>
    <div id="PopupContainer">
        @(Html.DevExtreme().Popup()
                .ID("popup")
                .Title("是否要新增新人?")
                .Visible(false)
                .Height(80)
                .Width(330)
                .MaxHeight(80)
                .MaxWidth(330)
                .Position(PositionAlignment.Center)
                .ResizeEnabled(true)
                //.ShadingColor("blue")
                .ShowCloseButton(true)
                .ContentTemplate(@<text>
                    @*<p>是否要新增新人?</p>*@
                    @(Html.DevExtreme().Button()
                        .Text("確定")
                        .OnClick("button_ok_click")
                    )
                    @*<br/>*@
                    @(Html.DevExtreme().Button()
                        .Text("取消")
                        .OnClick("button_cancel_click")
                    )
                </text>)
            )

        <script type="text/javascript">
            function button_ok_click(e) {
                //alert("我要新增新人!");
                $("#popup").dxPopup("instance").hide();

                // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("CreateContact", "Home")',
                            data:
                            {
                                FullName: $("#form1").dxForm("instance").getEditor('FullName').option('value'),
                            }, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (arg)
                                {
                                    if (arg.status == 1)
                                    {
                                        // 顯示上傳成功
                                        ShowToast(arg.message, "success", 2000);
                                    }
                                    else{
                                        ShowToast(arg.message, "error", 5000);
                                    }

                                    document.getElementById('resultfield').innerHTML = arg.message;
                                },

                            error: function (obj)
                                        {
                                        //alert('Something happened');
                                        }

                        }
                    );
                // AJAX 區塊

            }
            function button_cancel_click(e) {
                alert("我不要新增新人!");
                $("#popup").dxPopup("instance").hide();
            }
        </script>
    </div>
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

    </div>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveKeyInDedication" asp-controller="Home" method="post">
