@{
    String DataStatus = "上傳成功了!";
    String ReUpload = "請再按一次上傳鈕!";
}


@model ChurchReport.Models.SmallGroupData

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>林口靈糧堂</title>

</head>

@*<br />換行*@
<br />

<div class="dx-field">
    <div id="the whole thing" style="height:100%; width:100%; overflow: hidden;">
        <div id="buttonContainer" class="dx-button-icon" style="float: left; width:30%; text-align: left; background-color:white;">
            @(Html.DevExtreme().Button()
                .Text("上傳")
                .Type(ButtonType.Success)
                .ID("save-button")
                //.UseSubmitBehavior(true)

                .OnClick
                (@<text>
                function(arg)
                {
                    // 顯示旋轉鈕
                    $("#loadPanel").dxLoadPanel("instance").show();

                    var dataGrid = $("#gridContainer").dxDataGrid("instance");

                    var Flag = dataGrid.hasEditData();

                    if(Flag == false)
                    {
                            // AJAX 區塊
                            $.ajax
                            (
                                    {
                                        url: '@Url.Action("SavePersonInfomation", "Home")',
                                        data: { aResult: GetResult() }, // 整理回傳給 Server 的點名資料
                                        type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                                        success: function (arg)
                                        {
                                            // 隱藏旋轉鈕
                                            $("#loadPanel").dxLoadPanel("instance").hide();

                                            // 顯示上傳成功
                                            $("#toast").dxToast("instance").show();
                                        },

                                        error: function (obj)
                                        {
                                            //alert('Something happened');
                                        }
                                    }
                            );
                            // AJAX 區塊
                    }
                    else
                    {
                        // 隱藏旋轉鈕
                        $("#loadPanel").dxLoadPanel("instance").hide();

                        // 顯示再上傳一次
                        $("#ToastReUpload").dxToast("instance").show();
                    }

                }
                </text>)
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Offset(0, 50))
                .Message(DataStatus)
                .DisplayTime(2000)
                .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                .ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.4)")
                .Position(p => p.Of("#data-grid"))
                .Visible(false)
                .ShowIndicator(true)
                .ShowPane(true)
                .Shading(true)
                .CloseOnOutsideClick(false)
                .Message("更新資料中...")
                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                //.OnShown("loadPanel_shown")
                //.OnHidden("loadPanel_hidden")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                    .ID("ToastReUpload")
                    .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message(ReUpload)
                    .DisplayTime(5000)
                    .Type(ToastType.Error)
                    .MaxWidth(500)
            )
        </div>

    </div>
</div>

<hr />
<h3>維護基本資料</h3>

<div id="data-grid">
    @(Html.DevExtreme().DataGrid()
            .ID("gridContainer")
            .ShowBorders(true)
            //.ColumnAutoWidth(true)
            //.Paging(p => p.PageSize(10))
            //.Paging(paging => paging.Enabled(false))
            .AllowColumnResizing(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnFixing(c => c.Enabled(true))
            .LoadPanel(l => l.Text("更新資料中..."))
            .SearchPanel(s => s.Visible(true).Placeholder("搜尋.."))


            //.StateStoring(s => s
            //    .Enabled(true)
            //    .Type(StateStoringType.LocalStorage)
            //    .StorageKey("Id")
            //)

            //.OnRowUpdated("function () { alert('OnRowUpdated'); }")
            //.OnRowClick("function () { alert('OnRowClick'); }")
            //.OnSelectionChanged("function () { alert('OnSelectionChanged'); }" )
            //.OnCellClick("function () { alert('OnCellClick'); }")
            //.OnEditingStart("function () { alert('OnEditingStart'); }")
            //.OnEditorPrepared("function () { alert('OnEditorPrepared'); }")




            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ShowBorders(true)

            .TwoWayBindingEnabled(true)


            .Grouping
            (g => g
            .ContextMenuEnabled(true)
            .ExpandMode(GridGroupingExpandMode.RowClick)
            )

            .GroupPanel
            (p => p
            .EmptyPanelText("請把小組名稱拉到這裡")
            .Visible(false) // 讓使用者不能自己決定誰被Grouping起來
            .AllowColumnDragging(true)
            )

            //.GroupPanel(p => p.Visible(true))
            //.GroupPanel(p => p.AllowColumnDragging(false))
            //.GroupPanel(p => p.(false))
            //.Grouping(g => g.AutoExpandAll(true))


            .Editing(editing =>
            {
                //editing.Mode(GridEditMode.Batch);
                //editing.Mode(GridEditMode.Row);
                editing.Mode(GridEditMode.Cell);
                //editing.Mode(GridEditMode.Batch);
                //editing.Mode(GridEditMode.Form);
                //editing.Mode(GridEditMode.Popup);
                editing.AllowUpdating(true);
                //editing.AllowAdding(true);
                //editing.
                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更"));
                //editing.AllowDeleting(true);
            })

    .Columns(columns =>
    {
                @*columns.Add()
                    .DataField("Picture")
                    .Caption("照片")
                    .Width(60)
                    .AllowFiltering(false)
                    .AllowSorting(false)
                    .CellTemplate(@<text>
                    <div class="img-container">
                        <img src="<%= value %>" alt="" />
                    </div>
                    </text>        );*@


                @*columns.Add()
                    .Caption("測試")
                    //.DataField("Shepherd")
                    .Width(250)
                
                    .CellTemplate(@<text> @(Html.Partial("DropDownBox") )
                    </text>);*@

                @*columns.Add().DataField("SectionName").Caption("族系").GroupIndex(-1).MinWidth(10);*@
                columns.Add().DataField("SmallGroupName").Caption("小組").GroupIndex(0).MinWidth(10);

                columns.Add().DataField("FullName").Caption("姓名").Fixed(true).Width(80).MinWidth(20).Alignment(HorizontalAlignment.Left);
                columns.Add().DataField("Status").Caption("委身類型").Fixed(false).Width(80).MinWidth(20).Alignment(HorizontalAlignment.Center);

                columns.Add().DataField("Phone").Caption("行動電話").Fixed(false).Width(120).MinWidth(90).Alignment(HorizontalAlignment.Left);
                columns.Add().DataField("HomePhone").Caption("家裡電話").Fixed(false).Width(120).MinWidth(90).Alignment(HorizontalAlignment.Left);
                columns.Add().DataField("Industry").Caption("職業及專長").Fixed(false).Width(100).MinWidth(90).Alignment(HorizontalAlignment.Left);
                columns.Add().DataField("Address").Caption("地址").Fixed(false).Width(200).MinWidth(90).Alignment(HorizontalAlignment.Left);
                })
                //.DataSource(d => d.WebApi().Controller("SmallGroupReport").Key("Id"))
                .DataSource(Model.Members)
                //.DataSourceOptions(d => d.Filter("['Id', '<=' , 6]"))
    )
</div>


