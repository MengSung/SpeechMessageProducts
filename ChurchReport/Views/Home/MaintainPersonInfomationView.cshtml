<div class="dx-field">
    <div id="the whole thing" style="height:100%; width:100%; overflow: hidden;">
        <div id="buttonContainer" class="dx-button-icon" style="float: left; width:30%; text-align: left; background-color:white;">
            @(Html.DevExtreme().Button()
                .Text("上傳")
                .Type(ButtonType.Success)
                .ID("save-button")
                //.UseSubmitBehavior(true)

                .OnClick
                (@<text>
                function(arg)
                {
                    // 顯示旋轉鈕
                    $("#loadPanel").dxLoadPanel("instance").show();

                    var dataGrid = $("#gridContainer").dxDataGrid("instance");

                    var Flag = dataGrid.hasEditData();

                    if(Flag == false)
                    {
                            // AJAX 區塊
                            $.ajax
                            (
                                    {
                                        url: '@Url.Action("SavePersonInfomation", "Home")',
                                        data: { aResult: GetResult() }, // 整理回傳給 Server 的點名資料
                                        type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                                        success: function (arg)
                                        {
                                            // 隱藏旋轉鈕
                                            $("#loadPanel").dxLoadPanel("instance").hide();

                                            // 顯示上傳成功
                                            $("#toast").dxToast("instance").show();
                                        },

                                        error: function (obj)
                                        {
                                            //alert('Something happened');
                                        }
                                    }
                            );
                            // AJAX 區塊
                    }
                    else
                    {
                        // 隱藏旋轉鈕
                        $("#loadPanel").dxLoadPanel("instance").hide();

                        // 顯示再上傳一次
                        $("#ToastReUpload").dxToast("instance").show();
                    }

                }
                </text>)
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Offset(0, 50))
                .Message(DataStatus)
                .DisplayTime(2000)
                .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                .ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.4)")
                .Position(p => p.Of("#data-grid"))
                .Visible(false)
                .ShowIndicator(true)
                .ShowPane(true)
                .Shading(true)
                .CloseOnOutsideClick(false)
                .Message("更新資料中...")
                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                //.OnShown("loadPanel_shown")
                //.OnHidden("loadPanel_hidden")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                    .ID("ToastReUpload")
                    .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message(ReUpload)
                    .DisplayTime(5000)
                    .Type(ToastType.Error)
                    .MaxWidth(500)
            )
        </div>

    </div>
</div>

<hr />
