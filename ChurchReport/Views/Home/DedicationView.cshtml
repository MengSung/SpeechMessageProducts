@using ChurchReport.ViewModels
@model PersonFormViewModel

<div class="long-title"><h3>奉獻資訊</h3></div>

<div class="long-title"><h3 id="displaynamefield"></h3></div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveDedication" asp-controller="Home" method="post">
    <div class="dx-field">
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("上傳")
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                //.ValidationGroup()
                //.Width(60)

                .OnClick("SaveNewPerson")

                //.OnClick(@<text>
                //function(data) {
                //
                //        $.ajax({
                //            url: '@Url.Action("SaveNewPerson", "Home")',
                //            data: { aNewPerson: Model.FormData.Notes.Value },
                //            type: 'POST', //POST if you want to save, GET if you want to fetch data from server
                //            success: function (obj)
                //            {
                //                $("#toast").dxToast("instance").show();
                //            },
                //
                //            error: function (obj)
                //            {
                //                //alert('Something happened');
                //            }
                //
                //        });
                //}
                //</text>)
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                //.OnShown("loadPanel_shown")
                //.OnHidden("loadPanel_hidden")
            )

        </div>
    </div>
    <div id="form-container">
        @(Html.DevExtreme().Form<PersonFormViewModel>()
        .ID("form")
        .ColCount(3)
        .Items(items =>
        {
        items.AddSimpleFor(m=>m.LastName)
            //.DataField("LastName")
            .Label(l => l.Text("姓名"))
            .Editor(e => e
                .TextBox()
                .Disabled(false)
                .Placeholder("輸入姓名")
           );

        items.AddSimple()
            .DataField("Phone")
            .Label(l => l.Text("行動電話"))
            .Editor(e => e
                .TextBox()
                .Mask("+886 (X000) 000-000")
                .MaskRules(new { X = new JS("/[02-9]/") })
                .Placeholder("輸入手機號碼")
            );

        items.AddSimple()
            .DataField("BirthDate")
            .Label(l => l.Text("生日"))
            //.IsRequired(false)
            .Editor(e => e
                .DateBox()
                .Disabled(false)
                .Placeholder("生日")
            );

        items.AddSimple()
            .DataField("MerrageState")
            .Label(l => l.Text("婚姻狀態"))
            .Editor(e => e
                .SelectBox()
                .DataSource(new string[] {
                                        "未知",
                                        "已婚",
                                        "未婚",
                                        "離異",
                                        "喪偶",
                                        "單身",
                    }
                //.DisplayExpr("Name")
                )
                .Value("未知")
                );


    })
        .OnContentReady(@<text>
                function(e) {
                e.component.validate();
                }
        </text>)
.FormData(Model)
        )
    </div>

</form>

