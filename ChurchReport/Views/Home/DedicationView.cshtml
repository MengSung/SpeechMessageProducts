<script src="https://d.line-scdn.net/liff/1.0/sdk.js"></script>
<script src="~/js/liff-starter.js"></script>

<script>

        window.onload = function (e) {
            liff.init(function (data) {
                //debugger;
                //alert("測試001!");
                initializeApp(data);
            });
        };


        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";


        function initializeApp(data) {
            UserId = data.context.userId;
            GroupId = data.context.groupId;
            RoomId = data.context.roomId;
            ViewType = data.context.viewType;
            //document.getElementById('languagefield').textContent = data.language;
            //document.getElementById('viewtypefield').textContent = data.context.viewType;
            //document.getElementById('useridfield').textContent = data.context.userId;
            //document.getElementById('utouidfield').textContent = data.context.utouId;
            //document.getElementById('roomidfield').textContent = data.context.roomId;
            //document.getElementById('groupidfield').textContent = data.context.groupId;

            //debugger;
            //alert("測試002!" + data.context.userId);

            //getLoadPanelInstance().show();

            UpdateLineUserId(data.context.userId, data.context.groupId, data.context.roomId, data.context.viewType);

            //alert("測試003!" );

            liff.getProfile().then(function (profile) {

                document.getElementById('displaynamefield').innerHTML = profile.displayName + "奉獻";

                DisplayName = profile.displayName;

                //alert("測試004!" + profile.displayName);
            });
        }


        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SetupUserLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                //getLoadPanelInstance().hide();
                            },

                            error: function (obj)
                            {
                                //getLoadPanelInstance().hide();
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }


        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

</script>

