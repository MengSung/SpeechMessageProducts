@* 
    登入頁面(改版)：
    - 行動優先、響應式、基督教風格
    - Hero 區塊：背景 Gallery 疊加漸層、教會名稱與經文
    - 卡片式登入表單、載入面板與 Toast 提示
    - 保留既有 DevExtreme 表單與 AJAX 流程
*@

@{
    // 設定頁面不使用 Layout，獨立渲染
    Layout = null;
}

@model ChurchReport.ViewModel.GalleryViewModel

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <!-- 頁面基本資訊 -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="好牧人 登入" />
    <meta name="author" content="好牧人" />

    <title>好牧人｜登入</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- 載入 Login 頁面資源 -->
    @await Html.PartialAsync("_LoginResources")
</head>

<body class="bg-light">
    <!-- ===========================================
         Hero 區塊：背景 Gallery + 覆蓋層經文
         =========================================== -->
    <section class="hero-wrapper hero-gallery-shift" aria-label="歡迎區">
        <!-- DevExtreme Gallery 容器 -->
        <div class="position-absolute w-100 h-100" style="z-index:1;">
            @(Html.DevExtreme().Gallery()
                .ID("gallery")                    // Gallery 唯一識別碼
                .DataSource(Model.Images)         // 圖片資料來源
                .Height("100%")                   // 高度設定
                .StretchImages(false)             // 不拉伸圖片，保持比例
                .Loop(true)                       // 循環播放
                .SlideshowDelay(6000)             // 每張圖停留 6 秒
                .AnimationDuration(800)           // 過場動畫 800ms
                .ShowNavButtons(true)             // 顯示導航按鈕
                .ShowIndicator(true)              // 顯示指示器
            )
        </div>

        <!-- 覆蓋層：顯示教會資訊 -->
        <div class="hero-overlay" role="banner">
            <i class="fa-solid fa-dove logo-faith" aria-hidden="true"></i>
            <h1>好牧人</h1>
            <div class="sub">願恩惠、憐憫、平安從父神與主耶穌基督歸與你們。</div>
            <div class="verse">我們既因信稱義，就藉著我們的主耶穌基督得與神相和。<span>— 羅馬書 5:1</span></div>
        </div>
    </section>

    <!-- ===========================================
         主內容區：登入卡片
         =========================================== -->
    <main class="container main-section" role="main">
        <div class="row">
            <div class="col-12">
                <div class="login-card card-soft" aria-labelledby="loginHeader">
                    <!-- 載入 Login 頁面 Toast 組件 -->
                    @await Html.PartialAsync("_LoginToast")

                    <!-- 卡片標題 -->
                    <div class="card-soft-header" id="loginHeader">
                        <i class="fa-solid fa-right-to-bracket"></i><span>會員登入</span>
                    </div>

                    <!-- 卡片內容 -->
                    <div class="card-soft-body">
                        <!-- AJAX 登入表單 -->
                        <form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="ProcessLogin" asp-controller="Home" method="post" novalidate>
                            <!-- 表單容器 -->
                            <div id="form-container">
                                @(Html.DevExtreme().Form()
                                    .ID("form")                      // 表單唯一識別碼
                                    .Items(items =>
                                    {
                                        // 帳號欄位
                                        items.AddSimple()
                                            .DataField("Account")
                                            .Label(l => l.Text("帳號"))
                                            .Editor(e => e
                                                .TextBox()
                                                .Disabled(false)
                                                .Placeholder("請輸入帳號")
                                                .ShowClearButton(true)
                                            );
                                        // 密碼欄位
                                        items.AddSimple()
                                            .DataField("Password")
                                            .Label(l => l.Text("密碼"))
                                            .Editor(e => e
                                                .TextBox()
                                                .Mode(TextBoxMode.Password)
                                                .Disabled(false)
                                                .Placeholder("請輸入密碼")
                                                .ShowClearButton(true)
                                            );
                                    })
                                )
                            </div>

                            <!-- 載入 Login 頁面按鈕區域 -->
                            @await Html.PartialAsync("_LoginButtons")

                            <!-- 載入 Login 頁面載入面板 -->
                            @await Html.PartialAsync("_LoginLoadPanel")
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- 頁腳 -->
    <footer class="footer-note" role="contentinfo">Copyright © @DateTime.Now.Year 好牧人</footer>
</body>
</html>