    @* ================================================================================================
       區塊 4：會員詳細資料彈出視窗（點擊大頭照開啟）
       ================================================================================================ *@
    <div id="memberDetailPopup"></div>
</div>

@* ================================================================================================
   JavaScript 區塊：動態載入會員身分與信仰狀態清單
   ================================================================================================ *@
<script>
    var membershipStatusDataSource = [];
    var spiritualIdentityDataSource = [];
    var visitDataSource = [];
    var contactImageEndpoint = '@Url.Action("GetContactImage", "Personal")';
    var contactAvatarThumbSize = 48;
    var contactImageBatchEndpoint = '@Url.Action("GetContactImagesBatch", "Personal")';
    var contactImageCache = {};
    var _batchLoadPending = {};

    function getContactIdFromGridRow(options) {
        if (!options || !options.data) {
            return null;
        }

        return options.data.ContactId || options.data.contactId || options.value || null;
    }

    function renderContactAvatar(container, options) {
        var contactId = getContactIdFromGridRow(options);
        var fallbackSvg = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40"><circle cx="20" cy="20" r="20" fill="#e9ecef"/><text x="20" y="25" font-size="14" text-anchor="middle" fill="#6c757d">人</text></svg>');

        var host = container && container.get ? container.get(0) : container;
        if (!host) {
            return;
        }

        host.textContent = '';

        var img = document.createElement('img');

        // 優先使用批次預載入的快取 Data URL（零網路延遲）
        if (contactId && contactImageCache[contactId]) {
            img.src = contactImageCache[contactId];
        } else if (contactId) {
            img.src = contactImageEndpoint + '?contactId=' + encodeURIComponent(contactId) + '&size=' + contactAvatarThumbSize;
        } else {
            img.src = fallbackSvg;
        }

        img.alt = '大頭照';
        img.loading = 'lazy';           // 延遲載入：僅可視區域內的圖片才發送請求
        img.decoding = 'async';         // 非同步解碼：不阻塞主執行緒渲染
        img.dataset.contactId = contactId || '';
        img.onerror = function () {
            if (img.src !== fallbackSvg) {
                img.src = fallbackSvg;
            }
        };
        img.style.width = '40px';
        img.style.height = '40px';
        img.style.borderRadius = '50%';
        img.style.objectFit = 'cover';
        img.style.border = '2px solid #e0e0e0';
        img.style.display = 'block';
        img.style.margin = '0 auto';
        img.style.boxShadow = '0 1px 3px rgba(0,0,0,0.12)';
        img.style.backgroundColor = '#f8f9fa';
        img.className = 'contact-avatar-img';

        // 點擊大頭照開啟會員詳細資料彈出視窗（載入原圖 + 點名表單）
        img.style.cursor = 'pointer';
        img.addEventListener('click', function (e) {
            e.stopPropagation();
            e.preventDefault();
            if (!options || !options.data) return;
            var gridElId = '';
            try { gridElId = options.component.element().attr('id') || ''; } catch (ex) { }
            var gridType = (gridElId === 'NewPersonGridContainer') ? 'newPerson' : 'smallGroup';
            openMemberDetailPopup(options.data, gridType);
        });

        host.appendChild(img);
    }

    window.contactImageCellTemplate = function (container, options) {
        renderContactAvatar(container, options);
    };

    /**
     * 批次預載入聯絡人大頭照
     * 從 Grid DataSource 收集所有 ContactId，透過單一 POST 請求批次取得 Base64 Data URL，
     * 然後直接更新 DOM 中已渲染的 <img> 元素，避免 N+1 個別 HTTP 請求。
     */
    function preloadContactImages(gridComponent, gridId) {
        if (_batchLoadPending[gridId]) return;

        var items = gridComponent.getDataSource().items();
        if (!items || items.length === 0) return;

        var uncachedIds = [];
        items.forEach(function (item) {
            var id = item.ContactId || item.contactId;
            if (id && !contactImageCache[id]) {
                uncachedIds.push(id);
            }
        });

        if (uncachedIds.length === 0) return;

        _batchLoadPending[gridId] = true;

        $.ajax({
            url: contactImageBatchEndpoint,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ contactIds: uncachedIds, size: contactAvatarThumbSize }),
            success: function (response) {
                if (response.success && response.images) {
                    for (var id in response.images) {
                        contactImageCache[id] = response.images[id];
                    }
                    // 直接更新 DOM 中已渲染的 <img>，避免整頁 repaint
                    $('#' + gridId + ' .contact-avatar-img[data-contact-id]').each(function () {
                        var cid = this.dataset.contactId;
                        if (cid && contactImageCache[cid]) {
                            this.src = contactImageCache[cid];
                        }
                    });
                    console.log('✅ [preloadContactImages] ' + gridId + ' 批次載入完成，共 ' + Object.keys(response.images).length + ' 張');
                }
            },
            error: function () {
                console.warn('⚠️ [preloadContactImages] ' + gridId + ' 批次載入失敗，改用逐筆載入');
            },
            complete: function () {
                _batchLoadPending[gridId] = false;
            }
        });
    }

    // ================================================================================
    // 會員詳細資料彈出視窗相關函式
    // ================================================================================
    var _currentPopupData = null;
    var _currentPopupGridType = null;
    var _memberDetailPopupInstance = null;

    /**
     * 開啟會員詳細資料彈出視窗
     * 左上角顮示原圖大頭照（按需下載），其餘顮示出席點名及代禱欄位
     * @@param {Object} rowData - Grid 行資料（Member 物件）
     * @@param {string} gridType - 'smallGroup' 或 'newPerson'
     */
    function openMemberDetailPopup(rowData, gridType) {
        _currentPopupData = $.extend(true, {}, rowData);
        _currentPopupGridType = gridType;

        if (!_memberDetailPopupInstance) {
            // 首次建立彈窗實例
            $('#memberDetailPopup').dxPopup({
                showTitle: true,
                showCloseButton: true,
                dragEnabled: false,
                shading: true,
                shadingColor: 'rgba(0,0,0,0.4)',
                width: function () { return Math.min(520, $(window).width() * 0.95); },
                height: 'auto',
                maxHeight: function () { return $(window).height() * 0.92; },
                animation: {
                    show: { type: 'fadeIn', duration: 200 },
                    hide: { type: 'fadeOut', duration: 150 }
                },
                toolbarItems: [{
                    toolbar: 'bottom',
                    location: 'center',
                    widget: 'dxButton',
                    options: {
                        text: '💾 儲存點名、探訪與代禱',
                        type: 'success',
                        width: '100%',
                        onClick: saveMemberDetail
                    }
                }]
            });
            _memberDetailPopupInstance = $('#memberDetailPopup').dxPopup('instance');
        }

        // 更新標題
        _memberDetailPopupInstance.option('title', '會員點名 — ' + (rowData.FullName || ''));

        // 重建內容
        var $contentEl = _memberDetailPopupInstance.content();
        $contentEl.empty();
        buildPopupContent($contentEl, rowData, gridType);

        _memberDetailPopupInstance.show();

        // 等待 DOM 就緒後初始化 DevExtreme 表單元件
        setTimeout(function () { initPopupWidgets(rowData, gridType); }, 80);
    }

    /**
     * 建構彈出視窗內容 HTML
     * 上方：原圖大頭照 + 姓名/身分/狀態
     * 下方：出席點名勾選 + 代禱事項輸入
     */
    function buildPopupContent($container, rowData, gridType) {
        var contactId = rowData.ContactId || rowData.contactId || '';
        // 使用 size=0 取得原始圖片（僅在開啟彈窗時才下載）
        var fullImageUrl = contactId
            ? contactImageEndpoint + '?contactId=' + encodeURIComponent(contactId) + '&size=0'
            : '';
        var fallbackLarge = 'data:image/svg+xml;utf8,' + encodeURIComponent(
            '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120">'
            + '<circle cx="60" cy="60" r="58" fill="#e9ecef"/>'
            + '<text x="60" y="75" font-size="40" text-anchor="middle" fill="#6c757d">人</text></svg>');

        var html = '<div class="member-popup-body">';

        // ── 上方：照片 + 基本資訊 ──
        html += '<div class="member-popup-header">';
        html += '  <div class="member-popup-photo">';
        html += '    <img id="popupFullPhoto" src="' + (fullImageUrl || fallbackLarge) + '" alt="大頭照" />';
        html += '  </div>';
        html += '  <div class="member-popup-info">';
        html += '    <div class="member-popup-name">' + (rowData.FullName || '-') + '</div>';
        if (rowData.Status) {
            html += '    <div class="member-popup-tag"><span class="popup-label">會員身分</span>' + rowData.Status + '</div>';
        }
        if (gridType === 'smallGroup' && rowData.Visit) {
            html += '    <div class="member-popup-tag"><span class="popup-label">探訪</span>' + rowData.Visit + '</div>';
        }
        html += '  </div>';
        html += '</div>';

        // ── 出席點名 ──
        html += '<div class="member-popup-section">';
        html += '  <div class="member-popup-section-title">📋 出席點名</div>';
        html += '  <div class="member-popup-checks">';
        html += '    <div id="popupSundayCheck" class="member-popup-check-item"></div>';
        html += '    <div id="popupSmallGroupCheck" class="member-popup-check-item"></div>';
        html += '  </div>';
        html += '</div>';

        // ── 共用：信仰狀態下拉選項 ──
        html += '<div class="member-popup-section">';
        html += '  <div class="member-popup-section-title">✝️ 信仰狀態</div>';
        html += '  <div id="popupSpiritualIdentity"></div>';
        html += '</div>';

        // ── SmallGroup 獨有：探訪下拉選項 ──
        if (gridType === 'smallGroup') {
            html += '<div class="member-popup-section">';
            html += '  <div class="member-popup-section-title">👣 探訪</div>';
            html += '  <div id="popupVisit"></div>';
            html += '</div>';
        }

        // ── NewPerson 獨有：跟進欄位 ──
        if (gridType === 'newPerson') {
            html += '<div class="member-popup-section">';
            html += '  <div class="member-popup-section-title">📞 跟進方式</div>';
            html += '  <div id="popupFollowUpOption"></div>';
            html += '</div>';

            html += '<div class="member-popup-section">';
            html += '  <div class="member-popup-section-title">📌 跟進結果</div>';
            html += '  <div id="popupFollowUpResult"></div>';
            html += '</div>';

            html += '<div class="member-popup-section">';
            html += '  <div class="member-popup-section-title">➡️ 下一步驟</div>';
            html += '  <div id="popupFollowUpNextStep"></div>';
            html += '</div>';
        }

        // ── 代禱事項 ──
        var prayLabel = (gridType === 'newPerson') ? '跟進關懷說明' : '代禱事項';
        html += '<div class="member-popup-section">';
        html += '  <div class="member-popup-section-title">🙏 ' + prayLabel + '</div>';
        html += '  <div id="popupPrayItem"></div>';
        html += '</div>';

        // ── NewPerson 獨有：附註說明 ──
        if (gridType === 'newPerson') {
            html += '<div class="member-popup-section">';
            html += '  <div class="member-popup-section-title">📝 附註說明</div>';
            html += '  <div id="popupDescription"></div>';
            html += '</div>';
        }

        html += '</div>';
        $container.append(html);

        // 原圖載入失敗時顮示替代圖
        $('#popupFullPhoto').on('error', function () {
            if (this.src !== fallbackLarge) {
                this.src = fallbackLarge;
            }
        });
    }

    /**
     * 初始化彈出視窗內的 DevExtreme 元件
     */
    function initPopupWidgets(rowData, gridType) {
        $('#popupSundayCheck').dxCheckBox({
            text: '主日',
            value: !!rowData.Sunday
        });
        $('#popupSmallGroupCheck').dxCheckBox({
            text: '小組',
            value: !!rowData.SmallGroup
        });
        $('#popupSpiritualIdentity').dxSelectBox({
            dataSource: spiritualIdentityDataSource || [],
            value: rowData.SpiritualIdentity || null,
            placeholder: '請選擇信仰狀態',
            searchEnabled: true,
            showClearButton: true,
            noDataText: '無可用信仰狀態'
        });
        if (gridType === 'smallGroup') {
            $('#popupVisit').dxSelectBox({
                dataSource: visitDataSource || [],
                value: rowData.Visit || null,
                placeholder: '請選擇探訪',
                searchEnabled: true,
                showClearButton: true,
                noDataText: '無可用探訪項目'
            });
        }
        if (gridType === 'newPerson') {
            $('#popupFollowUpOption').dxSelectBox({
                dataSource: ["電話", "探訪", "Line/FB", "出遊/吃飯", "懷鄉/其他課程", "約談", "沒跟進", "其他"],
                value: rowData.FollowUpOption || null,
                placeholder: '請選擇跟進方式',
                searchEnabled: true,
                showClearButton: true,
                noDataText: '無可用選項'
            });

            $('#popupFollowUpResult').dxSelectBox({
                dataSource: ["未選擇", "熱情回應", "渴慕認識信仰", "沒聯絡上", "反應冷淡", "考慮中，繼續跟進", "入小組", "來主日", "其他"],
                value: rowData.FollowUpResult || null,
                placeholder: '請選擇跟進結果',
                searchEnabled: true,
                showClearButton: true,
                noDataText: '無可用選項'
            });

            $('#popupFollowUpNextStep').dxSelectBox({
                dataSource: ["未選擇", "繼續跟進", "轉介"],
                value: rowData.FollowUpNextStep || null,
                placeholder: '請選擇下一步驟',
                searchEnabled: true,
                showClearButton: true,
                noDataText: '無可用選項'
            });
        }
        var prayPlaceholder = (gridType === 'newPerson') ? '請輸入跟進關懷說明...' : '請輸入代禱事項...';
        $('#popupPrayItem').dxTextArea({
            value: rowData.PrayItem || '',
            placeholder: prayPlaceholder,
            height: 80,
            maxLength: 2000
        });
        if (gridType === 'newPerson') {
            $('#popupDescription').dxTextArea({
                value: rowData.Description || '',
                placeholder: '請輸入附註說明...',
                height: 80,
                maxLength: 2000
            });
        }
    }

    /**
     * 儲存點名、探訪與代禱至聚會出席記錄
     * 透過 Grid DataSource Store 的 update 方法，確保與 Grid 內建編輯行為一致
     */
    function saveMemberDetail() {
        if (!_currentPopupData || !_currentPopupData.PresentRecordId) {
            DevExpress.ui.notify('⚠️ 缺少記錄 ID，無法儲存', 'warning', 2500);
            return;
        }

        var sunday = $('#popupSundayCheck').dxCheckBox('instance').option('value');
        var smallGroup = $('#popupSmallGroupCheck').dxCheckBox('instance').option('value');
        var prayItem = $('#popupPrayItem').dxTextArea('instance').option('value');

        var updateValues = {
            Sunday: sunday,
            SmallGroup: smallGroup,
            PrayItem: prayItem
        };

        var spiritualIdentityInst = $('#popupSpiritualIdentity').dxSelectBox('instance');
        if (spiritualIdentityInst) {
            updateValues.SpiritualIdentity = spiritualIdentityInst.option('value');
        }

        if (_currentPopupGridType === 'smallGroup') {
            var visitInst = $('#popupVisit').dxSelectBox('instance');
            if (visitInst) {
                updateValues.Visit = visitInst.option('value');
            }
        }

        if (_currentPopupGridType === 'newPerson') {
            var followUpOptionInst = $('#popupFollowUpOption').dxSelectBox('instance');
            var followUpResultInst = $('#popupFollowUpResult').dxSelectBox('instance');
            var followUpNextStepInst = $('#popupFollowUpNextStep').dxSelectBox('instance');

            if (followUpOptionInst) {
                updateValues.FollowUpOption = followUpOptionInst.option('value');
            }
            if (followUpResultInst) {
                updateValues.FollowUpResult = followUpResultInst.option('value');
            }
            if (followUpNextStepInst) {
                updateValues.FollowUpNextStep = followUpNextStepInst.option('value');
            }

            var descInst = $('#popupDescription').dxTextArea('instance');
            if (descInst) {
                updateValues.Description = descInst.option('value');
            }
        }

        var key = _currentPopupData.PresentRecordId;
        var gridId = (_currentPopupGridType === 'smallGroup')
            ? 'SmallGroupgridContainer'
            : 'NewPersonGridContainer';

        var gridInstance = $('#' + gridId).dxDataGrid('instance');
        if (!gridInstance) {
            DevExpress.ui.notify('❌ 找不到資料網格', 'error', 2500);
            return;
        }

        // 使用 DataSource Store 的 update 方法送出 PUT 請求
        var store = gridInstance.getDataSource().store();
        store.update(key, updateValues)
            .done(function () {
                DevExpress.ui.notify('✅ 儲存成功', 'success', 2000);
                gridInstance.refresh();
                if (_memberDetailPopupInstance) {
                    _memberDetailPopupInstance.hide();
                }
            })
            .fail(function (error) {
                var msg = (error && error.message) ? error.message : '未知錯誤';
                DevExpress.ui.notify('❌ 儲存失敗: ' + msg, 'error', 3500);
                console.error('[saveMemberDetail] 錯誤:', error);
            });
    }

    $(document).ready(function () {
        // 載入會員身分清單
        $.ajax({
            url: '/Personal/Api/GetMembershipStatusList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    membershipStatusDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入會員身分清單:', membershipStatusDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入會員身分清單失敗:', error);
                membershipStatusDataSource = ["牧師師母", "區牧", "小區長", "小組長", "副小組長", "核心同工", "小組組員", "未入組", "新朋友", "外教會", "結案"];
            }
        });

        // 載入信仰狀態清單
        $.ajax({
            url: '/Personal/Api/GetSpiritualIdentityList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    spiritualIdentityDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入信仰狀態清單失敗:', error);
                spiritualIdentityDataSource = ["-未知-", "基督徒", "已決志", "慕道友", "未信主"];
            }
        });

        // 載入探訪清單
        $.ajax({
            url: '/Personal/Api/GetVisitList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    visitDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入探訪清單:', visitDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入探訪清單失敗:', error);
                visitDataSource = [];
            }
        });
    });
</script>

