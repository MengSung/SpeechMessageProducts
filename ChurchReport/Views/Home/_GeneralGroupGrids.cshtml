@*
    ====================================================================================================
    一般小組資料網格集合
    ----------------------------------------------------------------------------------------------------
    本檔案用途：
    1. 顯示「小組是否暫停」勾選框。
    2. 顯示「小組牧養」資料網格。
    3. 顯示「新人跟進關懷」資料網格。

    整理原則：
    - 僅整理排版、區塊層次與註解說明。
    - 不改變任何既有功能。
    - 不刪除任何既有邏輯。

    目前保留的既有行為：
    - 會員身分與信仰狀態選單由 API 動態載入。
    - 小組牧養 / 新人跟進關懷資料網格在沒有資料時自動隱藏。
    ====================================================================================================
*@
@using ChurchReport.Models
@model ChurchReport.Models.ListSmallGroupWeeklyReport

<div class="general-group-grids">
    @* ================================================================================================
       區塊 1：小組是否暫停
       ------------------------------------------------------------------------------------------------
       說明：
       - 使用 DevExtreme CheckBox。
       - 直接綁定 `Model.PauseCheckBox`。
       - 僅負責顯示目前是否勾選，不在此區塊另外加入其他邏輯。
       ================================================================================================ *@
    <div id="PauseOrNot" class="pause-option" style="display: flex; align-items: center; gap: 8px;">
        <div style="font-size:100%; color:#fff; background: linear-gradient(135deg, #667eea0%, #764ba2100%); text-align:left; font-weight:bold; border-radius:3px; display:inline-block;">
            <h5 style="margin:0; color:#667eea;">小組是否暫停</h5>
        </div>
        @(Html.DevExtreme()
            .CheckBox()
            .ID("CheckBoxId")
            .Value(Model.PauseCheckBox)
        )
    </div>

    @* ================================================================================================
       區塊 2：小組牧養資料網格
       ------------------------------------------------------------------------------------------------
       顯示條件：
       - 只有在 `Model.m_SmallGroupDataList.m_SmallGroupData.DisplayFlag == true` 時才輸出整個區塊。

       補充說明：
       - 即使區塊被輸出，仍會在 DataGrid `OnContentReady` 時再次判斷資料筆數。
       - 若資料筆數為 0，會自動隱藏整個區塊。
       ================================================================================================ *@
    @if (Model.m_SmallGroupDataList.m_SmallGroupData.DisplayFlag == true)
    {
        <div class="small-group-section" id="smallGroupSection">
            <div style="font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
                <h5>小組牧養:</h5>
            </div>

            <div id="smallgroup-grid">
                @(
                    Html.DevExtreme()
                        .DataGrid<Member>()
                        .ID("SmallGroupgridContainer")

                        @* -----------------------------
                           視覺與版面設定
                           ----------------------------- *@
                        .ShowBorders(true)
                        .ColumnAutoWidth(true)
                        .ColumnHidingEnabled(true)
                        .ShowColumnLines(true)
                        .ShowRowLines(true)
                        .RowAlternationEnabled(true)

                        @* -----------------------------
                           效能與操作體驗設定
                           說明：
                           - Filtering / Sorting / Paging / Grouping / Summary 改由前端處理。
                           - CRUD 相關操作仍依既有方式送回伺服器。
                           ----------------------------- *@
                        .RemoteOperations(ro => ro
                            .Filtering(false)
                            .Sorting(false)
                            .Paging(false)
                            .Grouping(false)
                            .Summary(false)
                        )
                        .RepaintChangesOnly(true)
                        .CacheEnabled(true)
                        .Scrolling(s => s
                            .Mode(GridScrollingMode.Virtual)
                            .RowRenderingMode(GridRowRenderingMode.Virtual)
                        )
                        .Paging(p => p.PageSize(100).Enabled(true))
                        .Sorting(s => s.Mode(GridSortingMode.Single))
                        .AllowColumnResizing(true)
                        .ColumnResizingMode(ColumnResizingMode.Widget)
                        .ColumnFixing(c => c.Enabled(true))
                        .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                        .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))

                        @* -----------------------------
                           分組設定
                           說明：
                           - 保留分組能力。
                           - 但 GroupPanel 不顯示，避免使用者自行拖曳欄位分組。
                           ----------------------------- *@
                        .Grouping(g => g
                            .ContextMenuEnabled(true)
                            .ExpandMode(GridGroupingExpandMode.RowClick)
                        )
                        .GroupPanel(p => p
                            .EmptyPanelText("請把小組名稱拉到這裡")
                            .Visible(false)
                            .AllowColumnDragging(true)
                        )

                        @* -----------------------------
                           編輯設定
                           說明：
                           - 採用 Cell 編輯模式。
                           - 允許修改。
                           - 不允許刪除。
                           ----------------------------- *@
                        .Editing(editing =>
                        {
                            editing.Mode(GridEditMode.Cell);
                            editing.AllowUpdating(true);
                            editing.AllowDeleting(false);
                            editing.Texts(a => a
                                .SaveAllChanges("上傳檔案")
                                .AddRow("新增")
                                .CancelAllChanges("取消變更")
                                .SaveRowChanges("儲存")
                                .CancelRowChanges("取消")
                                .EditRow("編輯")
                                .DeleteRow("刪除")
                            );
                            editing.RefreshMode(GridEditRefreshMode.Repaint);
                        })

                        @* -----------------------------
                           欄位定義
                           ----------------------------- *@
                        .Columns(columns =>
                        {
                            // 基本出席資訊
                            columns.AddFor(m => m.FullName)
                                .Caption("姓名")
                                .Fixed(true)
                                .Width(60)
                                .MinWidth(20)
                                .Alignment(HorizontalAlignment.Left)
                                .AllowSorting(false)
                                .AllowEditing(false);

                            columns.AddFor(m => m.Sunday)
                                .Caption("主日")
                                .Width(45)
                                .MinWidth(45)
                                .AllowSorting(false);

                            columns.AddFor(m => m.SmallGroup)
                                .Caption("小組")
                                .Width(45)
                                .MinWidth(45)
                                .AllowSorting(false);

                            // 會員身分：由前面 JavaScript 載入的動態 DataSource 提供選項
                            columns.Add()
                                .DataField("Status")
                                .Caption("會員身分")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(120)
                                .MinWidth(30)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("membershipStatusDataSource"))
                                );

                            // 信仰狀態：由前面 JavaScript 載入的動態 DataSource 提供選項
                            columns.AddFor(m => m.SpiritualIdentity)
                                .Caption("信仰狀態")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(110)
                                .MinWidth(100)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("spiritualIdentityDataSource"))
                                );

                            // 探訪：由動態 DataSource 提供選項
                            columns.AddFor(m => m.Visit)
                                .Caption("探訪")
                                .Width(120)
                                .MinWidth(80)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("visitDataSource"))
                                );

                            // 代禱事項：可自由輸入
                            columns.AddFor(m => m.PrayItem)
                                .Caption("代禱事項")
                                .MinWidth(90);

                            // 指派小組：使用後端傳入的 GroupArray，預設隱藏
                            columns.AddFor(m => m.AssignedGroup)
                                .Caption("指派小組")
                                .Visible(false)
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(Model.GroupArray)
                                );
                        })

                        @* -----------------------------
                           資料來源
                           說明：
                           - 透過 `SmallGroup` Controller 的 WebApi 端點載入與更新。
                           ----------------------------- *@
                        .DataSource(d => d
                            .WebApi()
                            .Controller("SmallGroup")
                            .LoadAction("LoadIntegrate")
                            .InsertAction("InsertPresentRecord")
                            .DeleteAction("DeletePresentRecord")
                            .UpdateAction("UpdateSmallGroupPresentRecord")
                            .Key("PresentRecordId")
                            .LoadParams(new { id = @ViewBag.ListId })
                        )

                        @* -----------------------------
                           前端事件
                           說明：
                           - `OnContentReady`：初始化完成後，移動編輯欄並判斷是否隱藏區塊。
                           - `OnCellPrepared`：沿用既有儲存格客製顯示。
                           ----------------------------- *@
                        .OnContentReady(@<text>
                            function(e) {
                                // 將編輯欄位移至左側，維持既有使用體驗
                                moveEditColumnToLeft(e.component);

                                // 檢查資料筆數，若無資料則隱藏整個小組牧養區塊
                                var dataSource = e.component.getDataSource();
                                var totalCount = dataSource.totalCount();

                                if (totalCount === 0) {
                                    $('#smallGroupSection').hide();
                                    console.log('✅ [SmallGroupGrid] 無資料，隱藏小組牧養區塊');
                                } else {
                                    $('#smallGroupSection').show();
                                    console.log('✅ [SmallGroupGrid] 資料筆數:', totalCount);
                                }
                            }
                        </text>)
                        .OnCellPrepared("cell_prepared")
                )
            </div>
        </div>
    }

    @* ================================================================================================
       區塊 3：新人跟進關懷資料網格
       ------------------------------------------------------------------------------------------------
       顯示條件：
       - 只有在 `Model.m_SmallGroupDataList.m_NewPersonFollowUpData.DisplayFlag == true` 時才輸出整個區塊。

       補充說明：
       - 區塊輸出後，仍會在 DataGrid `OnContentReady` 中再次檢查資料筆數。
       - 若資料為 0，前端會自動將整個區塊隱藏。
       ================================================================================================ *@
    @if (Model.m_SmallGroupDataList.m_NewPersonFollowUpData.DisplayFlag == true)
    {
        <div class="new-person-follow-up-section" id="newPersonFollowUpSection">
            <div style="font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
                <h5>新人跟進關懷:</h5>
            </div>

            <div id="newpersonal-data-grid">
                @(
                    Html.DevExtreme()
                        .DataGrid<Member>()
                        .ID("NewPersonGridContainer")

                        @* -----------------------------
                           視覺與版面設定
                           ----------------------------- *@
                        .ShowBorders(true)
                        .ShowColumnLines(true)
                        .ShowRowLines(true)
                        .RowAlternationEnabled(true)
                        .ColumnHidingEnabled(true)

                        @* -----------------------------
                           效能與操作體驗設定
                           說明：
                           - 過濾、排序、分頁、分組、匯總皆在前端處理。
                           - CRUD 仍維持既有伺服器端行為。
                           ----------------------------- *@
                        .RemoteOperations(ro => ro
                            .Filtering(false)
                            .Sorting(false)
                            .Paging(false)
                            .Grouping(false)
                            .Summary(false)
                        )
                        .RepaintChangesOnly(true)
                        .CacheEnabled(true)
                        .Scrolling(s => s
                            .Mode(GridScrollingMode.Virtual)
                            .RowRenderingMode(GridRowRenderingMode.Virtual)
                        )
                        .Paging(paging => paging.PageSize(10).Enabled(true))
                        .AllowColumnResizing(true)
                        .ColumnResizingMode(ColumnResizingMode.Widget)
                        .ColumnFixing(c => c.Enabled(true))
                        .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                        .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                        .Export(e => e.Enabled(false).AllowExportSelectedData(true))
                        .TwoWayBindingEnabled(true)
                        .Visible(Model.m_SmallGroupDataList.m_NewPersonFollowUpData.DisplayFlag)

                        @* -----------------------------
                           分組設定
                           ----------------------------- *@
                        .Grouping(g => g
                            .ContextMenuEnabled(true)
                            .ExpandMode(GridGroupingExpandMode.RowClick)
                        )
                        .GroupPanel(p => p
                            .EmptyPanelText("請把小組名稱拉到這裡")
                            .Visible(false)
                            .AllowColumnDragging(true)
                        )

                        @* -----------------------------
                           事件設定
                           說明：
                           - 保留既有列表互動事件。
                           ----------------------------- *@
                        .OnSelectionChanged("OnRowSelectionChanged")
                        .OnEditorPrepared("OnEditorPrepared")

                        @* -----------------------------
                           編輯設定
                           ----------------------------- *@
                        .Editing(editing =>
                        {
                            editing.Mode(GridEditMode.Cell);
                            editing.AllowUpdating(true);
                            editing.AllowDeleting(false);
                            editing.Texts(a => a
                                .SaveAllChanges("上傳檔案")
                                .AddRow("新增")
                                .CancelAllChanges("取消變更")
                                .SaveRowChanges("儲存")
                                .CancelRowChanges("取消")
                                .EditRow("編輯")
                                .DeleteRow("刪除")
                            );
                            editing.RefreshMode(GridEditRefreshMode.Repaint);
                        })

                        @* -----------------------------
                           欄位定義
                           ----------------------------- *@
                        .Columns(columns =>
                        {
                            // 基本資料
                            columns.AddFor(m => m.FullName)
                                .Caption("姓名")
                                .Fixed(true)
                                .Width(60)
                                .MinWidth(20)
                                .Alignment(HorizontalAlignment.Left)
                                .AllowEditing(false);

                            columns.AddFor(m => m.Sunday)
                                .Caption("主日")
                                .DataType(GridColumnDataType.Boolean)
                                .Width(45)
                                .MinWidth(45);

                            columns.AddFor(m => m.SmallGroup)
                                .Caption("小組")
                                .DataType(GridColumnDataType.Boolean)
                                .Width(45)
                                .MinWidth(45);

                            // 會員身分：由動態 DataSource 提供選項
                            columns.Add()
                                .DataField("Status")
                                .Caption("會員身分")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(70)
                                .MinWidth(30)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("membershipStatusDataSource"))
                                );

                            // 信仰狀態：由動態 DataSource 提供選項
                            columns.AddFor(m => m.SpiritualIdentity)
                                .Caption("信仰狀態")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(110)
                                .MinWidth(100)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("spiritualIdentityDataSource"))
                                );

                            // 跟進方式：使用既有固定選項
                            columns.AddFor(m => m.FollowUpOption)
                                .Caption("跟進方式")
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(new string[]
                                    {
                                        "電話",
                                        "探訪",
                                        "Line/FB",
                                        "出遊/吃飯",
                                        "懷鄉/其他課程",
                                        "約談",
                                        "沒跟進",
                                        "其他"
                                    })
                                );

                            // 跟進結果：使用既有固定選項
                            columns.Add()
                                .DataField("FollowUpResult")
                                .Caption("跟進結果")
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(new string[]
                                    {
                                        "未選擇",
                                        "熱情回應",
                                        "渴慕認識信仰",
                                        "沒聯絡上",
                                        "反應冷淡",
                                        "考慮中，繼續跟進",
                                        "入小組",
                                        "來主日",
                                        "其他"
                                    })
                                );

                            // 下一步驟：使用既有固定選項
                            columns.Add()
                                .DataField("FollowUpNextStep")
                                .Caption("下一步驟")
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(new string[]
                                    {
                                        "未選擇",
                                        "繼續跟進",
                                        "轉介"
                                    })
                                );

                            // 文字說明欄位
                            columns.AddFor(m => m.PrayItem)
                                .Caption("跟進關懷說明")
                                .MinWidth(150);

                            columns.AddFor(m => m.Description)
                                .Caption("附註說明")
                                .MinWidth(300);

                            // 指派小組：沿用後端傳入的 GroupArray，預設隱藏
                            columns.AddFor(m => m.AssignedGroup)
                                .Caption("指派小組")
                                .Visible(false)
                                .Width(150)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(Model.GroupArray)
                                );
                        })

                        @* -----------------------------
                           資料來源
                           說明：
                           - 透過 `NewPerson` Controller 的 WebApi 端點讀寫新人跟進資料。
                           ----------------------------- *@
                        .DataSource(d => d
                            .WebApi()
                            .Controller("NewPerson")
                            .LoadAction("LoadNewPersonFollowUp")
                            .InsertAction("InsertNewPresentRecord")
                            .DeleteAction("DeleteNewPresentRecord")
                            .UpdateAction("UpdateNewPresentRecord")
                            .Key("PresentRecordId")
                            .LoadParams(new { id = @ViewBag.ListId })
                        )

                        @* -----------------------------
                           前端事件
                           ----------------------------- *@
                        .OnContentReady(@<text>
                            function(e) {
                                // 將編輯欄位移至左側，維持既有使用體驗
                                moveEditColumnToLeft(e.component);

                                // 檢查資料筆數，若無資料則隱藏整個新人跟進關懷區塊
                                var dataSource = e.component.getDataSource();
                                var totalCount = dataSource.totalCount();

                                if (totalCount === 0) {
                                    $('#newPersonFollowUpSection').hide();
                                    console.log('✅ [NewPersonGrid] 無資料，隱藏新人跟進關懷區塊');
                                } else {
                                    $('#newPersonFollowUpSection').show();
                                    console.log('✅ [NewPersonGrid] 資料筆數:', totalCount);
                                }
                            }
                        </text>)
                        .OnCellPrepared("cell_prepared")
                )
            </div>
        </div>
    }
</div>

@* ================================================================================================
   JavaScript 區塊：動態載入會員身分與信仰狀態清單
   ------------------------------------------------------------------------------------------------
   說明：
   - 這兩個陣列提供給上方兩個 DataGrid 的 Lookup 欄位使用。
   - 頁面載入時先呼叫 API 取得選項。
   - 若 API 失敗，則使用原本的備用固定清單，避免功能中斷。
   - 這裡保留 `async: false`，因為原本邏輯是要確保 DataGrid 初始化前資料已準備完成。
   - 僅補充註解與排版，不更動行為。
   ================================================================================================ *@
<script>
    // 全域變數：提供給 DataGrid Lookup 使用的資料來源
    var membershipStatusDataSource = [];
    var spiritualIdentityDataSource = [];
    var visitDataSource = [];

    // 頁面載入完成後，先同步取得下拉選單資料，再讓 DataGrid 使用
    $(document).ready(function () {
        // --------------------------------------------------------------------------------------------
        // 1. 載入會員身分清單
        // --------------------------------------------------------------------------------------------
        $.ajax({
            url: '/Personal/Api/GetMembershipStatusList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    membershipStatusDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入會員身分清單:', membershipStatusDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入會員身分清單失敗:', error);
                // API 失敗時使用備用清單，避免 Lookup 無資料可用
                membershipStatusDataSource = ["牧師師母", "區牧", "小區長", "小組長", "副小組長", "核心同工", "小組組員", "未入組", "新朋友", "外教會", "結案"];
            }
        });

        // --------------------------------------------------------------------------------------------
        // 2. 載入信仰狀態清單
        // --------------------------------------------------------------------------------------------
        $.ajax({
            url: '/Personal/Api/GetSpiritualIdentityList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    spiritualIdentityDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入信仰狀態清單失敗:', error);
                // API 失敗時使用備用清單，避免 Lookup 無資料可用
                spiritualIdentityDataSource = ["-未知-", "基督徒", "已決志", "慕道友", "未信主"];
            }
        });

        // --------------------------------------------------------------------------------------------
        // 3. 載入探訪清單
        // --------------------------------------------------------------------------------------------
        $.ajax({
            url: '/Personal/Api/GetVisitList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    visitDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入探訪清單:', visitDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入探訪清單失敗:', error);
                visitDataSource = [];
            }
        });
    });
</script>