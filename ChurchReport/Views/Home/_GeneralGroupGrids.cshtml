@*
    ====================================================================================================
    一般小組資料網格集合 - 已增加聯絡人照片欄位
    ----------------------------------------------------------------------------------------------------
    本檔案用途:
    1. 顯示「小組是否暫停」勾選框。
    2. 顯示「小組牧養」資料網格（含大頭照）。
    3. 顯示「新人跟進關懷」資料網格（含大頭照）。

    更新記錄：
    - 在 SmallGroupgridContainer 和 NewPersonGridContainer 最左側加入聯絡人照片欄位
    - 照片來源：CRM contact.entityimage，透過 ContactId 動態載入
    ====================================================================================================
*@
@using ChurchReport.Models
@model ChurchReport.Models.ListSmallGroupWeeklyReport

<div class="general-group-grids">
    @* ================================================================================================
       區塊 1：小組是否暫停
       ================================================================================================ *@
    <div id="PauseOrNot" class="pause-option" style="display: flex; align-items: center; gap: 8px;">
        <div style="font-size:100%; color:#fff; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); text-align:left; font-weight:bold; border-radius:3px; display:inline-block; padding:5px 10px;">
            <h5 style="margin:0; color:#fff;">小組是否暫停</h5>
        </div>
        @(Html.DevExtreme()
            .CheckBox()
            .ID("CheckBoxId")
            .Value(Model.PauseCheckBox)
        )
    </div>

    @* ================================================================================================
       區塊 2：小組牧養資料網格（已加入大頭照欄位）
       ================================================================================================ *@
    @if (Model.m_SmallGroupDataList.m_SmallGroupData.DisplayFlag == true)
    {
        <div class="small-group-section" id="smallGroupSection">
            <div style="font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
                <h5>小組牧養:</h5>
            </div>

            <div id="smallgroup-grid">
                @(
                    Html.DevExtreme()
                        .DataGrid<Member>()
                        .ID("SmallGroupgridContainer")
                        .ShowBorders(true)
                        .ColumnAutoWidth(true)
                        .ColumnHidingEnabled(true)
                        .ShowColumnLines(true)
                        .ShowRowLines(true)
                        .RowAlternationEnabled(true)
                        .RemoteOperations(ro => ro
                            .Filtering(false)
                            .Sorting(false)
                            .Paging(false)
                            .Grouping(false)
                            .Summary(false)
                        )
                        .RepaintChangesOnly(true)
                        .CacheEnabled(true)
                        .Scrolling(s => s
                            .Mode(GridScrollingMode.Virtual)
                            .RowRenderingMode(GridRowRenderingMode.Virtual)
                        )
                        .Paging(p => p.PageSize(100).Enabled(true))
                        .Sorting(s => s.Mode(GridSortingMode.Single))
                        .AllowColumnResizing(true)
                        .ColumnResizingMode(ColumnResizingMode.Widget)
                        .ColumnFixing(c => c.Enabled(true))
                        .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                        .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                        .Grouping(g => g
                            .ContextMenuEnabled(true)
                            .ExpandMode(GridGroupingExpandMode.RowClick)
                        )
                        .GroupPanel(p => p
                            .EmptyPanelText("請把小組名稱拉到這裡")
                            .Visible(false)
                            .AllowColumnDragging(true)
                        )
                        .Editing(editing =>
                        {
                            editing.Mode(GridEditMode.Cell);
                            editing.AllowUpdating(true);
                            editing.AllowDeleting(false);
                            editing.Texts(a => a
                                .SaveAllChanges("上傳檔案")
                                .AddRow("新增")
                                .CancelAllChanges("取消變更")
                                .SaveRowChanges("儲存")
                                .CancelRowChanges("取消")
                                .EditRow("編輯")
                                .DeleteRow("刪除")
                            );
                            editing.RefreshMode(GridEditRefreshMode.Repaint);
                        })
                        .Columns(columns =>
                        {
                            // ✨ 聯絡人大頭照：顯示於最左側，固定欄位
                            columns.Add()
                                .DataField("ContactId")
                                .Caption("照片")
                                .Width(56)
                                .MinWidth(56)
                                .AllowEditing(false)
                                .AllowSorting(false)
                                .AllowFiltering(false)
                                .AllowResizing(false)
                                .Fixed(true)
                                .VisibleIndex(-1)
                                .CellTemplate(new JS("contactImageCellTemplate"));

                            // 基本出席資訊
                            columns.AddFor(m => m.FullName)
                                .Caption("姓名")
                                .Fixed(true)
                                .Width(60)
                                .MinWidth(20)
                                .Alignment(HorizontalAlignment.Left)
                                .AllowSorting(false)
                                .AllowEditing(false);

                            columns.AddFor(m => m.Sunday)
                                .Caption("主日")
                                .Width(45)
                                .MinWidth(45)
                                .AllowSorting(false);

                            columns.AddFor(m => m.SmallGroup)
                                .Caption("小組")
                                .Width(45)
                                .MinWidth(45)
                                .AllowSorting(false);

                            // 會員身分
                            columns.Add()
                                .DataField("Status")
                                .Caption("會員身分")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(120)
                                .MinWidth(30)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("membershipStatusDataSource"))
                                );

                            // 信仰狀態
                            columns.AddFor(m => m.SpiritualIdentity)
                                .Caption("信仰狀態")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(110)
                                .MinWidth(100)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("spiritualIdentityDataSource"))
                                );

                            // 探訪
                            columns.AddFor(m => m.Visit)
                                .Caption("探訪")
                                .Width(120)
                                .MinWidth(80)
                                .AllowResizing(false)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("visitDataSource"))
                                );

                            // 代禱事項
                            columns.AddFor(m => m.PrayItem)
                                .Caption("代禱事項")
                                .MinWidth(90);

                            // 指派小組
                            columns.AddFor(m => m.AssignedGroup)
                                .Caption("指派小組")
                                .Visible(false)
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(Model.GroupArray)
                                );
                        })
                        .DataSource(d => d
                            .WebApi()
                            .Controller("SmallGroup")
                            .LoadAction("LoadIntegrate")
                            .InsertAction("InsertPresentRecord")
                            .DeleteAction("DeletePresentRecord")
                            .UpdateAction("UpdateSmallGroupPresentRecord")
                            .Key("PresentRecordId")
                            .LoadParams(new { id = @ViewBag.ListId })
                        )
                        .OnContentReady(@<text>
                            function(e) {
                                moveEditColumnToLeft(e.component);
                                var dataSource = e.component.getDataSource();
                                var totalCount = dataSource.totalCount();
                                if (totalCount === 0) {
                                    $('#smallGroupSection').hide();
                                    console.log('✅ [SmallGroupGrid] 無資料，隱藏小組牧養區塊');
                                } else {
                                    $('#smallGroupSection').show();
                                    console.log('✅ [SmallGroupGrid] 資料筆數:', totalCount);
                                }
                            }
                        </text>)
                        .OnCellPrepared("cell_prepared")
                )
            </div>
        </div>
    }

    @* ================================================================================================
       區塊 3：新人跟進關懷資料網格（已加入大頭照欄位）
       ================================================================================================ *@
    @if (Model.m_SmallGroupDataList.m_NewPersonFollowUpData.DisplayFlag == true)
    {
        <div class="new-person-follow-up-section" id="newPersonFollowUpSection">
            <div style="font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
                <h5>新人跟進關懷:</h5>
            </div>

            <div id="newpersonal-data-grid">
                @(
                    Html.DevExtreme()
                        .DataGrid<Member>()
                        .ID("NewPersonGridContainer")
                        .ShowBorders(true)
                        .ShowColumnLines(true)
                        .ShowRowLines(true)
                        .RowAlternationEnabled(true)
                        .ColumnHidingEnabled(true)
                        .RemoteOperations(ro => ro
                            .Filtering(false)
                            .Sorting(false)
                            .Paging(false)
                            .Grouping(false)
                            .Summary(false)
                        )
                        .RepaintChangesOnly(true)
                        .CacheEnabled(true)
                        .Scrolling(s => s
                            .Mode(GridScrollingMode.Virtual)
                            .RowRenderingMode(GridRowRenderingMode.Virtual)
                        )
                        .Paging(paging => paging.PageSize(10).Enabled(true))
                        .AllowColumnResizing(true)
                        .ColumnResizingMode(ColumnResizingMode.Widget)
                        .ColumnFixing(c => c.Enabled(true))
                        .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                        .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                        .Export(e => e.Enabled(false).AllowExportSelectedData(true))
                        .TwoWayBindingEnabled(true)
                        .Visible(Model.m_SmallGroupDataList.m_NewPersonFollowUpData.DisplayFlag)
                        .Grouping(g => g
                            .ContextMenuEnabled(true)
                            .ExpandMode(GridGroupingExpandMode.RowClick)
                        )
                        .GroupPanel(p => p
                            .EmptyPanelText("請把小組名稱拉到這裡")
                            .Visible(false)
                            .AllowColumnDragging(true)
                        )
                        .OnSelectionChanged("OnRowSelectionChanged")
                        .OnEditorPrepared("OnEditorPrepared")
                        .Editing(editing =>
                        {
                            editing.Mode(GridEditMode.Cell);
                            editing.AllowUpdating(true);
                            editing.AllowDeleting(false);
                            editing.Texts(a => a
                                .SaveAllChanges("上傳檔案")
                                .AddRow("新增")
                                .CancelAllChanges("取消變更")
                                .SaveRowChanges("儲存")
                                .CancelRowChanges("取消")
                                .EditRow("編輯")
                                .DeleteRow("刪除")
                            );
                            editing.RefreshMode(GridEditRefreshMode.Repaint);
                        })
                        .Columns(columns =>
                        {
                            // ✨ 聯絡人大頭照：顯示於最左側，固定欄位
                            columns.Add()
                                .DataField("ContactId")
                                .Caption("照片")
                                .Width(56)
                                .MinWidth(56)
                                .AllowEditing(false)
                                .AllowSorting(false)
                                .AllowFiltering(false)
                                .AllowResizing(false)
                                .Fixed(true)
                                .VisibleIndex(-1)
                                .CellTemplate(new JS("contactImageCellTemplate"));

                            // 基本資料
                            columns.AddFor(m => m.FullName)
                                .Caption("姓名")
                                .Fixed(true)
                                .Width(60)
                                .MinWidth(20)
                                .Alignment(HorizontalAlignment.Left)
                                .AllowEditing(false);

                            columns.AddFor(m => m.Sunday)
                                .Caption("主日")
                                .DataType(GridColumnDataType.Boolean)
                                .Width(45)
                                .MinWidth(45);

                            columns.AddFor(m => m.SmallGroup)
                                .Caption("小組")
                                .DataType(GridColumnDataType.Boolean)
                                .Width(45)
                                .MinWidth(45);

                            // 會員身分
                            columns.Add()
                                .DataField("Status")
                                .Caption("會員身分")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(70)
                                .MinWidth(30)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("membershipStatusDataSource"))
                                );

                            // 信仰狀態
                            columns.AddFor(m => m.SpiritualIdentity)
                                .Caption("信仰狀態")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(110)
                                .MinWidth(100)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("spiritualIdentityDataSource"))
                                );

                            // 跟進方式
                            columns.AddFor(m => m.FollowUpOption)
                                .Caption("跟進方式")
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(new string[]
                                    {
                                        "電話", "探訪", "Line/FB", "出遊/吃飯",
                                        "懷鄉/其他課程", "約談", "沒跟進", "其他"
                                    })
                                );

                            // 跟進結果
                            columns.Add()
                                .DataField("FollowUpResult")
                                .Caption("跟進結果")
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(new string[]
                                    {
                                        "未選擇", "熱情回應", "渴慕認識信仰", "沒聯絡上",
                                        "反應冷淡", "考慮中，繼續跟進", "入小組", "來主日", "其他"
                                    })
                                );

                            // 下一步驟
                            columns.Add()
                                .DataField("FollowUpNextStep")
                                .Caption("下一步驟")
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(new string[] { "未選擇", "繼續跟進", "轉介" })
                                );

                            // 文字說明欄位
                            columns.AddFor(m => m.PrayItem)
                                .Caption("跟進關懷說明")
                                .MinWidth(150);

                            columns.AddFor(m => m.Description)
                                .Caption("附註說明")
                                .MinWidth(300);

                            // 指派小組
                            columns.AddFor(m => m.AssignedGroup)
                                .Caption("指派小組")
                                .Visible(false)
                                .Width(150)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(Model.GroupArray)
                                );
                        })
                        .DataSource(d => d
                            .WebApi()
                            .Controller("NewPerson")
                            .LoadAction("LoadNewPersonFollowUp")
                            .InsertAction("InsertNewPresentRecord")
                            .DeleteAction("DeleteNewPresentRecord")
                            .UpdateAction("UpdateNewPresentRecord")
                            .Key("PresentRecordId")
                            .LoadParams(new { id = @ViewBag.ListId })
                        )
                        .OnContentReady(@<text>
                            function(e) {
                                moveEditColumnToLeft(e.component);
                                var dataSource = e.component.getDataSource();
                                var totalCount = dataSource.totalCount();
                                if (totalCount === 0) {
                                    $('#newPersonFollowUpSection').hide();
                                    console.log('✅ [NewPersonGrid] 無資料，隱藏新人跟進關懷區塊');
                                } else {
                                    $('#newPersonFollowUpSection').show();
                                    console.log('✅ [NewPersonGrid] 資料筆數:', totalCount);
                                }
                            }
                        </text>)
                        .OnCellPrepared("cell_prepared")
                )
            </div>
        </div>
    }
</div>

@* ================================================================================================
   JavaScript 區塊：動態載入會員身分與信仰狀態清單
   ================================================================================================ *@
<script>
    var membershipStatusDataSource = [];
    var spiritualIdentityDataSource = [];
    var visitDataSource = [];
    var contactImageEndpoint = '@Url.Action("GetContactImage", "Personal")';

    function getContactIdFromGridRow(options) {
        if (!options || !options.data) {
            return null;
        }

        return options.data.ContactId || options.data.contactId || options.value || null;
    }

    function renderContactAvatar(container, options) {
        var contactId = getContactIdFromGridRow(options);
        var fallbackSvg = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40"><circle cx="20" cy="20" r="20" fill="#e9ecef"/><text x="20" y="25" font-size="14" text-anchor="middle" fill="#6c757d">人</text></svg>');
        var imageUrl = fallbackSvg;

        if (contactId) {
            imageUrl = contactImageEndpoint + '?contactId=' + encodeURIComponent(contactId) + '&timestamp=' + Date.now();
        }

        var host = container && container.get ? container.get(0) : container;
        if (!host) {
            return;
        }

        var img = document.createElement('img');
        img.src = imageUrl;
        img.alt = '大頭照';
        img.onerror = function () {
            if (img.src !== fallbackSvg) {
                img.src = fallbackSvg;
            }
        };
        img.style.width = '40px';
        img.style.height = '40px';
        img.style.borderRadius = '50%';
        img.style.objectFit = 'cover';
        img.style.border = '2px solid #e0e0e0';
        img.style.display = 'block';
        img.style.margin = '4px auto';
        img.style.boxShadow = '0 1px 3px rgba(0,0,0,0.12)';
        img.style.backgroundColor = '#f8f9fa';
        host.appendChild(img);
    }

    window.contactImageCellTemplate = function (container, options) {
        renderContactAvatar(container, options);
    };

    $(document).ready(function () {
        // 載入會員身分清單
        $.ajax({
            url: '/Personal/Api/GetMembershipStatusList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    membershipStatusDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入會員身分清單:', membershipStatusDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入會員身分清單失敗:', error);
                membershipStatusDataSource = ["牧師師母", "區牧", "小區長", "小組長", "副小組長", "核心同工", "小組組員", "未入組", "新朋友", "外教會", "結案"];
            }
        });

        // 載入信仰狀態清單
        $.ajax({
            url: '/Personal/Api/GetSpiritualIdentityList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    spiritualIdentityDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入信仰狀態清單失敗:', error);
                spiritualIdentityDataSource = ["-未知-", "基督徒", "已決志", "慕道友", "未信主"];
            }
        });

        // 載入探訪清單
        $.ajax({
            url: '/Personal/Api/GetVisitList',
            type: 'GET',
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.success && response.data) {
                    visitDataSource = response.data;
                    console.log('✅ [_GeneralGroupGrids] 成功載入探訪清單:', visitDataSource);
                }
            },
            error: function (xhr, status, error) {
                console.error('❌ [_GeneralGroupGrids] 載入探訪清單失敗:', error);
                visitDataSource = [];
            }
        });
    });
</script>

<style>
    /* 防止 iOS/行動瀏覽器在點擊輸入框時自動 zoom in */
    .dx-texteditor-input,
    .dx-selectbox-container input,
    .dx-dropdowneditor-input-wrapper input,
    .dx-checkbox-container,
    select {
        font-size: 16px !important;
    }
</style>
