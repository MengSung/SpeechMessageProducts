@*
    ====================================================================================================
    一般小組資料網格集合 - 已增加聯絡人照片欄位
    ----------------------------------------------------------------------------------------------------
    本檔案用途:
    1. 顯示「小組是否暫停」勾選框。
    2. 顯示「小組牧養」資料網格（含大頭照）。
    3. 顯示「新人跟進關懷」資料網格（含大頭照）。

    更新記錄：
    - 在 SmallGroupgridContainer 和 NewPersonGridContainer 最左側加入聯絡人照片欄位
    - 照片來源：CRM contact.entityimage，透過 ContactId 動態載入
    ====================================================================================================
*@
@using ChurchReport.Models
@model ChurchReport.Models.ListSmallGroupWeeklyReport

<style>
    /* 小組回報網格大頭照：載入時於綠色剪影上疊「轉圈等待」，照片到位後移除 is-loading 即停止旋轉。 */
    .contact-avatar-wrap {
        position: relative;
        width: 40px;
        height: 40px;
        margin: 0 auto;
    }

    .contact-avatar-wrap.avatar-source-primary .contact-avatar-img {
        border-color: #16a34a !important;
    }

    .contact-avatar-wrap.avatar-source-line .contact-avatar-img {
        border-color: #2563eb !important;
    }

    .contact-avatar-source-badge {
        position: absolute;
        right: -4px;
        bottom: 0;
        display: none;
        min-width: 13px;
        height: 9px;
        padding: 0 1px;
        border: 1px solid #fff;
        border-radius: 2px;
        color: #fff;
        font-size: 5px;
        font-weight: 700;
        line-height: 8px;
        text-align: center;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .18);
        pointer-events: none;
    }

    .contact-avatar-wrap.avatar-source-primary .contact-avatar-source-badge {
        display: block;
        min-width: 14px;
        background: #16a34a;
    }

    .contact-avatar-wrap.avatar-source-line .contact-avatar-source-badge {
        display: block;
        min-width: 15px;
        background: #2563eb;
    }

    .contact-avatar-spinner {
        position: absolute;
        inset: 0;
        margin: auto;
        width: 22px;
        height: 22px;
        border: 3px solid rgba(255, 255, 255, .55);
        border-top-color: #15803d;
        border-radius: 50%;
        animation: contact-avatar-spin .7s linear infinite;
        display: none;
        pointer-events: none;
    }

    .contact-avatar-wrap.is-loading .contact-avatar-spinner {
        display: block;
    }

    @@keyframes contact-avatar-spin {
        to { transform: rotate(360deg); }
    }
</style>

<div class="general-group-grids">
    @* ================================================================================================
       區塊 1：小組是否暫停
       ================================================================================================ *@
    <div id="PauseOrNot" class="pause-option">
        <div class="section-title-badge section-title-badge--pause">
            <h5>小組是否暫停</h5>
        </div>
        @(Html.DevExtreme()
            .CheckBox()
            .ID("CheckBoxId")
            .Value(Model.PauseCheckBox)
        )
    </div>

    @* ================================================================================================
       區塊 2：小組牧養資料網格（已加入大頭照欄位）
       ================================================================================================ *@
    @if (Model.m_SmallGroupDataList.m_SmallGroupData.DisplayFlag == true)
    {
        <div class="small-group-section grid-section-card" id="smallGroupSection">
            <div class="section-title-row">
                <h5>小組牧養</h5>
                <span class="section-hint">點擊照片可快速編輯點名與關懷</span>
            </div>

            <div id="smallgroup-grid" class="grid-shell">
                @(
                    Html.DevExtreme()
                        .DataGrid<Member>()
                        .ID("SmallGroupgridContainer")
                        .ShowBorders(true)
                        .ColumnAutoWidth(true)
                        .ColumnHidingEnabled(true)
                        .ShowColumnLines(true)
                        .ShowRowLines(true)
                        .RowAlternationEnabled(true)
                        .RemoteOperations(ro => ro
                            .Filtering(false)
                            .Sorting(false)
                            .Paging(false)
                            .Grouping(false)
                            .Summary(false)
                        )
                        .RepaintChangesOnly(true)
                        .CacheEnabled(true)
                        .Scrolling(s => s
                            .Mode(GridScrollingMode.Virtual)
                            .RowRenderingMode(GridRowRenderingMode.Virtual)
                        )
                        .Paging(p => p.PageSize(100).Enabled(true))
                        .Sorting(s => s.Mode(GridSortingMode.Single))
                        .AllowColumnResizing(true)
                        .ColumnResizingMode(ColumnResizingMode.Widget)
                        .ColumnFixing(c => c.Enabled(true))
                        .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                        .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                        .Grouping(g => g
                            .ContextMenuEnabled(true)
                            .ExpandMode(GridGroupingExpandMode.RowClick)
                        )
                        .GroupPanel(p => p
                            .EmptyPanelText("請把小組名稱拉到這裡")
                            .Visible(false)
                            .AllowColumnDragging(true)
                        )
                        .Editing(editing =>
                        {
                            editing.Mode(GridEditMode.Cell);
                            editing.AllowUpdating(true);
                            editing.AllowDeleting(false);
                            editing.Texts(a => a
                                .SaveAllChanges("上傳檔案")
                                .AddRow("新增")
                                .CancelAllChanges("取消變更")
                                .SaveRowChanges("儲存")
                                .CancelRowChanges("取消")
                                .EditRow("編輯")
                                .DeleteRow("刪除")
                            );
                            editing.RefreshMode(GridEditRefreshMode.Repaint);
                        })
                        .Columns(columns =>
                        {
                            // ✨ 聯絡人大頭照：顯示於最左側，固定欄位
                            columns.Add()
                                .DataField("ContactId")
                                .Caption("照片")
                                .Width(56)
                                .MinWidth(56)
                                .AllowEditing(false)
                                .AllowSorting(false)
                                .AllowFiltering(false)
                                .AllowResizing(false)
                                .Fixed(true)
                                .VisibleIndex(-1)
                                .CellTemplate(new JS("contactImageCellTemplate"));

                            // 基本出席資訊
                            columns.AddFor(m => m.FullName)
                                .Caption("姓名")
                                .Fixed(true)
                                .Width(60)
                                .MinWidth(20)
                                .Alignment(HorizontalAlignment.Left)
                                .AllowSorting(false)
                                .AllowEditing(false)
                                .CellTemplate(new JS("memberInfoDetailNameCellTemplate"));

                            columns.AddFor(m => m.Sunday)
                                .Caption("主日")
                                .Width(45)
                                .MinWidth(45)
                                .AllowSorting(false);

                            columns.AddFor(m => m.SmallGroup)
                                .Caption("小組")
                                .Width(45)
                                .MinWidth(45)
                                .AllowSorting(false);

                            // 會員身分
                            columns.Add()
                                .DataField("Status")
                                .Caption("會員身分")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(120)
                                .MinWidth(30)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("membershipStatusDataSource"))
                                );

                            // 信仰狀態
                            columns.AddFor(m => m.SpiritualIdentity)
                                .Caption("信仰狀態")
                                .Alignment(HorizontalAlignment.Center)
                                .AllowEditing(true)
                                .Width(110)
                                .MinWidth(100)
                                .DataType(GridColumnDataType.String)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("spiritualIdentityDataSource"))
                                );

                            // 探訪
                            columns.AddFor(m => m.Visit)
                                .Caption("探訪")
                                .Width(120)
                                .MinWidth(80)
                                .AllowResizing(false)
                                .Lookup(lookup => lookup
                                    .DataSource(new JS("visitDataSource"))
                                );

                            // 代禱事項
                            columns.AddFor(m => m.PrayItem)
                                .Caption("代禱事項")
                                .MinWidth(90);

                            // 指派小組
                            columns.AddFor(m => m.AssignedGroup)
                                .Caption("指派小組")
                                .Visible(false)
                                .Width(120)
                                .MinWidth(30)
                                .Lookup(lookup => lookup
                                    .DataSource(Model.GroupArray)
                                );
                        })
                        .DataSource(d => d
                            .WebApi()
                            .Controller("SmallGroup")
                            .LoadAction("LoadIntegrate")
                            .InsertAction("InsertPresentRecord")
                            .DeleteAction("DeletePresentRecord")
                            .UpdateAction("UpdateSmallGroupPresentRecord")
                            .Key("PresentRecordId")
                            .LoadParams(new { id = @ViewBag.ListId })
                        )
                        .OnContentReady(@<text>
                            function(e) {
                                moveEditColumnToLeft(e.component);
                                var dataSource = e.component.getDataSource();
                                var totalCount = dataSource.totalCount();
                                if (totalCount === 0) {
                                    $('#smallGroupSection').hide();
                                    console.log('✅ [SmallGroupGrid] 無資料，隱藏小組牧養區塊');
                                } else {
                                    $('#smallGroupSection').show();
                                    preloadContactImages(e.component, 'SmallGroupgridContainer');
                                    console.log('✅ [SmallGroupGrid] 資料筆數:', totalCount);
                                }
                            }
                        </text>)
                        .OnCellPrepared("cell_prepared")
                )
            </div>
        </div>
    }

