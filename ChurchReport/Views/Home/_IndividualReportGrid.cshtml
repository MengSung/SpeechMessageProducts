@*
    ===================================================================
    個人回報資料網格
    功能：個人使用者的出席回報網格
    ===================================================================
*@

@model ChurchReport.Models.ListSmallGroupWeeklyReport

<div class="individual-report-grid">
    <div id="individual-data-grid">
        @* 此處包含完整的個人回報 DataGrid 配置 *@
        <div class="grid-placeholder">
            <!-- 個人回報 DataGrid 配置將在此處 -->
            <!-- 包含姓名、主日、小組、會員身分、裝備狀態、代禱事項等欄位 -->
        </div>
    </div>
</div>

@* 注意：實際使用時需要將原始檔案中完整的個人回報 DataGrid 配置移入此處 *@