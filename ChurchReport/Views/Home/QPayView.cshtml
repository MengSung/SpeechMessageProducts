<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h4 id="displaynamefield">@Model.FullName 奉獻編號:@Model.DedicationNumber</h4>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveQPayDedication" asp-controller="Home" method="post">
    <div id="form-container">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form")
        .ColCount(1)
        .Items(items =>
        {

            items.AddSimpleFor
            (m => m.Category)
                .Label(l => l.Text("類別"))
                //.Name("Category")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .Width(200)
                    .DataSource(new string[]
                    {
                       "十一奉獻",
                       "感恩奉獻",
                       //"愛心奉獻",
                       "建堂奉獻",
                       "代收代轉",
                       "宣教奉獻",
                       "紓困奉獻",
                       "特別奉獻",
                       "其他奉獻",
                    }
                    //.DisplayExpr("Name")
                )
                //.Placeholder("請選擇奉獻類別")
                //.Value(Model.Category)
                .OnValueChanged("OnCategorySelectBoxValueChanged")
            );

            items.AddSimpleFor
                (m => m.Others)
                    .Label(l => l.Text("宣教對象"))
                    .Visible(false)
                    .Name("OtherDedicationSelectionBox")
                    .Editor
                    (
                        e => e
                        .SelectBox()
                        .Width(200)
                        .DataSource(Model.OtherCategoryArray)
                        .Placeholder("請選擇宣教對象")
                    //.Value("特別")
                    );

            items.AddSimpleFor
                    (m => m.Others)
                        .Label(l => l.Text("特別奉獻項目"))
                        .Visible(false)
                        .Name("SpecialDedicationSelectionBox")
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .Width(200)
                            .DataSource(Model.SpecialCategoryArray)
                            .Placeholder("請選擇特別奉獻項目")
                        //.Value("特別")
                        );

            items.AddSimpleFor
                (m => m.Others)
                    .Label(l => l.Text("代轉對象"))
                    .Visible(false)
                    .Name("OtherDedication")
                    .Editor
                    (
                        e => e
                        .Autocomplete()
                        .Width(200)
                        .DataSource(Model.OtherCategoryArray)
                        .Placeholder("請輸入代轉對象")
                    //.Value("特別")
                    );


            items.AddSimpleFor(m => m.Amount)
                    //.DataField("LastName")
                    .Label(l => l.Text("奉獻金額"))
                    .Name("DedicationAmount")
                    .Editor(e => e
                        .NumberBox()
                        .Disabled(false)
                        .Width(200)
                        .OnContentReady("OnAmountContentReady")
                        .Placeholder("輸入奉獻金額")
                    );

            items.AddSimpleFor
                    (m => m.PayWay)
                        .Label(l => l.Text("付款方式"))
                        .Name("PayWaySelectBox")
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .Width(200)
                            .DataSource(new string[]
                            {
                                "信用卡",
                                "ATM轉帳/匯款",
                                "信用卡定期定額(每個月)",
                                //"行動支付",
                                //"銀聯卡",
                            }
                            //.DisplayExpr("Name")
                        )
                        .OnValueChanged("OnPayWaySelectBoxValueChanged")
                    //.Value("信用卡")
                    );

            items.AddSimpleFor
                    (m => m.DeductTotalNumber)
                        //.Label(l => l.Text("定期定額總期數,每個月自動進行奉獻"))
                        .Label(l => l.Text("總期數"))
                        .Visible(false)
                        .Name("DeductTotalNumberSelectionBox")
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .Width(200)
                            .DataSource(new string[]
                            {
                                "3個月",
                                "6個月",
                                "12個月",
                                "18個月",
                                "24個月",
                            }
                            //.DisplayExpr("Name")
                        )
                    .Value("12個月")
                    );


            items.AddSimpleFor(m => m.SelectedCreditCard)
                    //.DataField("LastName")
                    .Label(l => l.Text("選取的信用卡").Visible(false))
                    .Editor(e => e
                        .TextBox()
                        .Width(120).Visible(false)
                        //.Disabled(true)
                        .Placeholder("選取的信用卡")
                   );


        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )

    </div>
    <div id="creditcardlistcontainer" style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
