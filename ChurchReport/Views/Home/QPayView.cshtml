            //    alert(e.value + "顯示 002");
            //    //$("#form").dxForm("instance").Option("Category", e.value);
            //    //$("#form").dxForm("instance").itemOption("Category", e.value);
            //}
        }
        else
        {
            //alert(e.value + "隱藏");
            //alert(e.value + "隱藏 000:" + GlobalCategory );
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', false);
            //e.component.option('value', e.value); 



            //if (GlobalCategory != e.value) {
            //    alert(e.value + "隱藏 001:" + GlobalCategory);

            //    GlobalCategory = e.value;
            //    alert(e.value + "隱藏 002:" + GlobalCategory);

            //    alert(e.value + "隱藏 003" + $("#form").dxForm("instance").getEditor("Category"));
            //    $("#form").dxForm("instance").getEditor("Category").option("value", e.value);
            //    alert(e.value + "隱藏 004");
            //    //$("#form").dxForm("instance").Option("Category", e.value);
            //    //$("#form").dxForm("instance").itemOption("Category", e.value);
            //}
        }
    }
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            }
            else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }

    }

    function onCreditCardGridContentReady(e) {
        var items = e.component.getDataSource().items();
        $("input[name='myHiddenInput']").val(JSON.stringify(items));
        //myHiddenInput - is the name of your hidden input  
    }  

</script>

<script type="text/javascript">
            function onBegin() {
            }

            function onSuccess(data) {

                getLoadPanelInstance().hide();

                if (data.status == 1) {
                    if (data.PayWay == "信用卡") {
                        //alert("成功 3");
                        ShowToast(data.message, "success", 2000);
                        window.location.href = data.DedicationResult;
                    }
                    else {
                        ShowToast(data.message, "success", 2000);
                        document.getElementById('atmfield').innerHTML = data.DedicationResult;
                    }
                }
                else
                {
                    ShowToast(data.message, "error", 3000);
                    document.getElementById('atmfield').innerHTML = data.message;
                }
            }

            function onComplete(data)
            {
                if (data.status == 1) {
                }
                else {
                }
            }
</script>

<script src="~/js/liff-starter.js"></script>
@*<script src="https://d.line-scdn.net/liff/1.0/sdk.js"></script>*@
<script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>
<script>

        window.onload = function (e) {
            //var message = '@TempData["Proponent"]';
            //window.alert( "耶和華" + message);
            liff.init(
                { liffId: '@TempData["Proponent"]' },
                function (data) {
                    //debugger;
                    //alert("測試 window.onload 001!");
                    initializeApp(data);
                    //alert("測試 window.onload 002!");
                }
            );
        };

        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";

        async function initializeApp(data) {

            await liff.getProfile().then(function (profile) {
                DisplayName = profile.displayName;
                UserId = profile.userId;
                //alert("測試 UserId =" + UserId);
                GroupId= profile.aGroupId;
                RoomId = profile.aRoomId;
                ViewType = profile.aViewType;
                //alert("測試004!" + DisplayName);
                // 取得 UserId 的Ajax
                UpdateLineUserId(UserId, GroupId, RoomId, ViewType);

                document.getElementById('displaynamefield').innerHTML = profile.displayName + "奉獻";

                DisplayName = profile.displayName;
            });
        }

        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SetupUserLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                document.getElementById('displaynamefield').innerHTML = data.FullName + "奉獻編號:" + data.DedicationNumber;
                            },

                            error: function (obj)
                            {
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }

</script>

