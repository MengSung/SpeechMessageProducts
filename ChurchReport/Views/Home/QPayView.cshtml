@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h5 id="displaynamefield"></h5>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveQPayDedication" asp-controller="Home" method="post">
    <div class="dx-field">
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("奉獻")
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

        </div>
    </div>
    <div id="form-container">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form")
        .ColCount(2)
        .Items(items =>
        {
            items.AddSimpleFor
            (m => m.Category)
                .Label(l => l.Text("類別"))
                //.Name("Category")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .DataSource(new string[]
                    {
                       "十一",
                       "感恩",
                       "建堂",
                       "宣教",
                       "急難救助",
                       "青年事工",
                       "萬軍",
                       "其他",
                    }
                //.DisplayExpr("Name")
                )
                .Placeholder("請選擇奉獻類別")
                //.Value(Model.Category)
                .OnValueChanged("OnCategorySelectBoxValueChanged")
            );

            items.AddSimpleFor
            (m => m.Others)
                .Label(l => l.Text("其他"))
                .Visible(false)
                .Name("OtherDedication")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .DataSource(Model.OtherCategoryArray)
                    .Placeholder("請選擇奉獻類別")
                    //.Value("特別")
                );

            items.AddSimpleFor(m => m.Amount)
                    //.DataField("LastName")
                    .Label(l => l.Text("奉獻金額"))
                    .Editor(e => e
                        .NumberBox().Value(null)
                        .Disabled(false)
                        .Placeholder("輸入奉獻金額")
                    );

            items.AddSimpleFor
                    (m => m.PayWay)
                        .Label(l => l.Text("付款方式"))
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .DataSource(new string[]
                            {
                                           "信用卡",
                                           "ATM轉帳/匯款",
                            }
                        //.DisplayExpr("Name")
                        )
                        .Value("信用卡")
                    );

            items.AddSimple().ColSpan(2)
               .Label(l => l.Text("信用卡清單").Location(FormLabelLocation.Top))
               .Template(@<text>
                            @(Html.DevExtreme().DataGrid<CreditCard>()
                            .ID("CreditCardGrid")
                            .ShowBorders(true)
                            //.ColumnAutoWidth(true)
                            //.Paging(p => p.PageSize(10))
                            .Paging(paging => paging.Enabled(false))
                            .AllowColumnResizing(true)
                            .ColumnResizingMode(ColumnResizingMode.Widget)
                            .ColumnFixing(c => c.Enabled(true))
                            .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                            .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                            .Export(e=>e.Enabled(false).AllowExportSelectedData(true))
                            .ShowColumnLines(true)
                            .ShowRowLines(true)
                            .RowAlternationEnabled(true)
                            .ShowBorders(true)
                            .RemoteOperations(true)
                            .TwoWayBindingEnabled(true)
                            .OnContentReady("onCreditCardGridContentReady")
                            .Editing(editing =>
                            {
                                //editing.Mode(GridEditMode.Batch);
                                //editing.Mode(GridEditMode.Row);
                                editing.Mode(GridEditMode.Cell);
                                //editing.Mode(GridEditMode.Batch);
                                //editing.Mode(GridEditMode.Form);
                                //editing.Mode(GridEditMode.Popup);
                                editing.AllowUpdating(true);
                                //editing.AllowAdding(true);
                                editing.AllowDeleting(true);
                                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除"));
                            })

                            .Columns(columns =>
                            {
                                columns.AddFor(m => m.CreditCardNumber).Caption("卡號").Width(180).MinWidth(180).Fixed(true);
                                columns.AddFor(m => m.ExpireDate).Caption("過期日").Width(100).MinWidth(100);
                            })
                            .DataSource
                            ( Model.CreditCardList)

                            .OnContentReady("onCreditCardGridContentReady")
                            // 此處設定是讓選項偏左邊一排
                            //.OnContentReady("moveEditColumnToLeft")
                            //此處設定是鉛筆形狀還是"編輯"字樣
                            //.OnCellPrepared("cell_prepared")
                            //.OnCellPrepared("cell_prepared_background_color")
                            )
                </text>);


        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )

    </div>

    <div id="buttonContainer2" class="dx-button-icon">
        @(Html.DevExtreme().Button()
                    .Text("奉獻")
                    .Type(ButtonType.Success)
                    .ID("save-button2")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
    </div>

    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="atmfield"></h5>
    </div>

</form>

<script>
