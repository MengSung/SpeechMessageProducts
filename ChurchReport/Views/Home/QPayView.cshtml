        {
            //alert(e.value + "顯示");
            //alert(e.value + "顯示 :" + GlobalCategory);
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', true);
            //e.component.option('value', e.value); 



            //if (GlobalCategory != e.value) {
            //    GlobalCategory = e.value;

            //    alert(e.value + "顯示 001");
            //    alert(e.value + "顯示 001" + $("#form").dxForm("instance").getEditor("Category"));
