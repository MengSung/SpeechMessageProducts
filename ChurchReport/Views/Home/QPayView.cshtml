                //.Export(e=>e.Enabled(false).AllowExportSelectedData(true))
                .ShowColumnLines(true)
                .ShowRowLines(true)
                //.RowAlternationEnabled(true)
                .ShowBorders(true)
                //.RemoteOperations(false)
                //.TwoWayBindingEnabled(true)
                .Selection(selection => selection.Mode(SelectionMode.Single))
                //.Selection(selection => selection.Mode(SelectionMode.Multiple))
                //.Selection(selection => selection.Mode(SelectionMode.None))
                //.OnRowClick("OnRowClick")
                .OnSelectionChanged("OnRowSelectionChanged")
                //.OnInitialized("DataGridOnInitialized")
                //.HoverStateEnabled(true)
                //.OnContentReady("onCreditCardGridContentReady")
                .Editing(editing =>
                {
                    //editing.Mode(GridEditMode.Batch);
                    //editing.Mode(GridEditMode.Row);
                    editing.Mode(GridEditMode.Cell);
                    //editing.Mode(GridEditMode.Batch);
                    //editing.Mode(GridEditMode.Form);
                    //editing.Mode(GridEditMode.Popup);
                    //editing.AllowUpdating(true);
                    //editing.AllowAdding(true);
                    editing.RefreshMode(GridEditRefreshMode.Reshape);
                    editing.AllowDeleting(true);
                    editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("選擇").DeleteRow("取消").ConfirmDeleteMessage("您是否確定取消這個定期定額?").ConfirmDeleteTitle("取消定期定額"));
                })

                .Columns(columns =>
                {
                    columns.AddFor(m => m.DedicationCategory).Caption("奉獻類別").Width(70).MinWidth(75).Alignment(HorizontalAlignment.Center).Fixed(true);
                    columns.AddFor(m => m.DedicationBookingStatus).Caption("狀態").Width(70).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.AmountPerStage).Caption("每期金額").Width(75).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.TotalStages).Caption("總期數").Width(70).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.DedicationAmount).Caption("應付總金額").Width(85).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.PaidPeriod).Caption("目前期數").Width(75).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.RollupPaidFee).Caption("已付金額").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.StartDate).Caption("開始日期").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    columns.AddFor(m => m.EndDate).Caption("結束日期").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                })
                .DataSource(d => d
                            .WebApi()
                            .Controller("Home")
                            .LoadAction("LoadDedicationBookingList")
                            //.InsertAction("InsertPresentRecord")
                            .DeleteAction("DeleteDedicationBooking")
                            //.UpdateAction("UpdatePresentRecord")
                            .Key("EntityId")
                            //.LoadParams(new { id = @ViewBag.ListId }))
                    )
                .SelectedRowKeys(new int[] { 1 })
                .OnContentReady("onDedicationBookingGridContentReady")
                //.OnRowPrepared("onDedicationBookingRowPrepared")
                // 此處設定是讓選項偏左邊一排
                //.OnContentReady("moveEditColumnToLeft")
                //此處設定是鉛筆形狀還是"編輯"字樣
                //.OnCellPrepared("cell_prepared")
                //.OnCellPrepared("cell_prepared_background_color")
                )
        <br />
    </div>

</form>
<div class="dx-field">
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

    </div>
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )
    </div>
</div>
