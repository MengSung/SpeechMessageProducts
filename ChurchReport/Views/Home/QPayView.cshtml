        @(Html.DevExtreme().DataGrid<DedicationBooking>()
                .ID("DedicationBookingGrid")
                //.Width("60%")
                .Width("auto")
                //.Width("inherit")
                //.ColumnAutoWidth(true)
                .ColumnWidth(5)
                //.Paging(p => p.PageSize(10))
