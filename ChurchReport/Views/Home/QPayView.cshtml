@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h5 id="displaynamefield">@Model.FullName 奉獻編號:@Model.DedicationNumber</h5>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveQPayDedication" asp-controller="Home" method="post">
    <div id="form-container">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form")
        .ColCount(1)
        .Items(items =>
        {

            items.AddSimpleFor
            (m => m.Category)
                .Label(l => l.Text("類別"))
                //.Name("Category")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .Width(200)
                    .DataSource(new string[]
                    {
                       "十一",
                       "宣教",
                    }
                    //.DisplayExpr("Name")
                )
                .Placeholder("請選擇奉獻類別")
                //.Value(Model.Category)
                .OnValueChanged("OnCategorySelectBoxValueChanged")
            );

            items.AddSimpleFor
            (m => m.Others)
                .Label(l => l.Text("其他"))
                .Visible(false)
                .Name("OtherDedication")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .Width(200)
                    .DataSource(Model.OtherCategoryArray)
                    .Placeholder("請選擇奉獻類別")
                    //.Value("特別")
                );

            items.AddSimpleFor(m => m.Amount)
                    //.DataField("LastName")
                    .Label(l => l.Text("奉獻金額"))
                    .Editor(e => e
                        .NumberBox()
                        .Disabled(false)
                        .Width(200)
                        .OnContentReady("OnAmountContentReady")
                        .Placeholder("輸入奉獻金額")
                    );

            items.AddSimpleFor
                    (m => m.PayWay)
                        .Label(l => l.Text("付款方式"))
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .Width(200)
                            .DataSource(new string[]
                            {
                                           "信用卡",
                                           "ATM轉帳/匯款",
                            }
                            //.DisplayExpr("Name")
                        )
                        .OnValueChanged("OnPayWaySelectBoxValueChanged")
                    //.Value("信用卡")
                    );


            items.AddSimpleFor(m => m.SelectedCreditCard)
                    //.DataField("LastName")
                    .Label(l => l.Text("選取的信用卡").Visible(false))
                    .Editor(e => e
                        .TextBox()
                        .Width(120).Visible(false)
                        //.Disabled(true)
                        .Placeholder("選取的信用卡")
                   );


        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )

    </div>
    <div id="creditcardlistcontainer" style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="creditcardlist">您可以刪除不想用的信用卡<br />請選擇這次要用哪張信用卡奉獻</h5>
        @(Html.DevExtreme().DataGrid<CreditCard>()
                .ID("CreditCardGrid")
                //.Width("50%")
                .Width("auto")
                //.Width("inherit")
                .ShowBorders(true)
                //.ColumnAutoWidth(true)
                .ColumnWidth(20)
                //.Paging(p => p.PageSize(10))
                .Paging(paging => paging.Enabled(false))
                .AllowColumnResizing(true)
                .ColumnResizingMode(ColumnResizingMode.Widget)
                .ColumnFixing(c => c.Enabled(true))
                .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                //.SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                //.Export(e=>e.Enabled(false).AllowExportSelectedData(true))
                .ShowColumnLines(true)
                .ShowRowLines(true)
                //.RowAlternationEnabled(true)
                .ShowBorders(true)
                //.RemoteOperations(false)
                //.TwoWayBindingEnabled(true)
                .Selection(selection => selection.Mode(SelectionMode.Single))
                //.Selection(selection => selection.Mode(SelectionMode.Multiple))
                //.Selection(selection => selection.Mode(SelectionMode.None))
                .OnRowClick("OnRowClick")
                .OnSelectionChanged("OnRowSelectionChanged")
                .OnInitialized("DataGridOnInitialized")
                .HoverStateEnabled(true)
                //.OnContentReady("onCreditCardGridContentReady")
                .Editing(editing =>
                {
                    //editing.Mode(GridEditMode.Batch);
                    //editing.Mode(GridEditMode.Row);
                    //editing.Mode(GridEditMode.Cell);
                    //editing.Mode(GridEditMode.Batch);
                    //editing.Mode(GridEditMode.Form);
                    //editing.Mode(GridEditMode.Popup);
                    //editing.AllowUpdating(true);
                    //editing.AllowAdding(true);
                    editing.AllowDeleting(true);
                    editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("選擇").DeleteRow("刪除"));
                })

                .Columns(columns =>
                {
                    columns.AddFor(m => m.CreditCardNumber).Caption("卡號").Width(120).MinWidth(80).Alignment(HorizontalAlignment.Center).Fixed(true);
                    columns.AddFor(m => m.ExpireDate).Caption("過期日").Width(50).MinWidth(50).Alignment(HorizontalAlignment.Center);
                })
                .DataSource(d => d
                            .WebApi()
                            .Controller("Home")
                            .LoadAction("LoadCreditCardList")
                            //.InsertAction("InsertPresentRecord")
                            .DeleteAction("DeleteCreditCard")
                            //.UpdateAction("UpdatePresentRecord")
                            .Key("CCToken")
                            //.LoadParams(new { id = @ViewBag.ListId }))
                    )
                .SelectedRowKeys(new int[] { 1 })
                .OnContentReady("onCreditCardGridContentReady")
                // 此處設定是讓選項偏左邊一排
                //.OnContentReady("moveEditColumnToLeft")
                //此處設定是鉛筆形狀還是"編輯"字樣
                //.OnCellPrepared("cell_prepared")
                //.OnCellPrepared("cell_prepared_background_color")
        )
        <br />
    </div>
    <div class="dx-field" style="text-align: left;">
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("用上面選擇的信用卡奉獻")
                    .Type(ButtonType.Success)
                    .ID("save-button2")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
            @(Html.DevExtreme().Button()
                    .Text("用其他信用卡奉獻")
                    .Type(ButtonType.Default)
                    //.Icon("fa fa-envelope-o")
                    //.Icon(Url.Content("~/images/button/weather.png"))
                    //.Icon("check")
                    .ID("save-button3")
                    .UseSubmitBehavior(true)
                    .StylingMode(ButtonStylingMode.Contained)
                    .OnClick("UseOtherCreditCard")
            )
        </div>
    </div>

    <div id="buttonContainer2" class="dx-button-icon">
    </div>

    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="atmfield"></h5>
    </div>
</form>

<div class="dx-field">
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

    </div>
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )
    </div>
</div>

<script>
    //網頁載入
    window.onload = function (e) {
        //document.getElementById("creditcardlistcontainer").style.display = "none";//隱藏
        //document.getElementById("creditcardlistcontainer").style.display = "";//顯示
    };
</script>
<script>
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }
    function ShowLoadPanel(arg) {
        getLoadPanelInstance().show();
    }
    function UseOtherCreditCard() {
        getLoadPanelInstance().show();

        $("#form").dxForm("instance").updateData('SelectedCreditCard', "");
    }

    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        //debugger;
        var ToastInstance = $("#toast").dxToast("instance");
        ToastInstance.option('message', LocalToastMessage);
        ToastInstance.option('type', Type);
        ToastInstance.option('displayTime', DisplayTime);
        ToastInstance.option('white-space', 'pre-line');
        ToastInstance.option('closeOnClick', true);
        ToastInstance.show();
    }
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            }
            else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }

    }
</script>
<script>
    // 觸發事件管理
    function OnCategorySelectBoxValueChanged(e) {
        if (e.value == "其他") {
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', true);
        }
        else {
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', false);
        }
    }
    function OnPayWaySelectBoxValueChanged(e) {
        if (e.value == "信用卡") {
            document.getElementById("creditcardlistcontainer").style.display = "";//顯示

            $("#save-button3").dxButton("instance").option("visible", true);
            $("#save-button2").dxButton("instance").option("text", "用上面選擇的信用卡奉獻");

            document.getElementById('atmfield').innerHTML = "";
        }
        else {
            document.getElementById("creditcardlistcontainer").style.display = "none";//隱藏
            //document.getElementById("creditcardlistcontainer").remove();//隱藏
            //var element = document.getElementById("creditcardlistcontainer");
            //element.parentNode.removeChild(element);

            $("#save-button3").dxButton("instance").option("visible", false);
            $("#save-button2").dxButton("instance").option("text", "奉獻");

            document.getElementById('atmfield').innerHTML = "";
        }
    }
    function OnAmountContentReady(e) {

        //debugger;
        //alert(e.component._options.value);
        //alert(e.component.option("value"));
        //if (e.component._options.value == 0)
        if (e.component.option("value") == 0) {
            e.component.option("value", "");
            //e.component._options.value = null;
            //alert(e.component._options.value);
        }
    }
    function DataGridOnInitialized(e)
    {
        e.component.columnOption("command:edit", "width", 50);
    }
    //var selectionChangedRaised = false;
    //var FirstLoad = true;
    function OnRowClick(selectedItems) {

        //alert("OnRowClick!001-0" + selectedItems);
        var data = selectedItems.selectedRowsData[0];
        if (data) {

            //alert("OnRowClick!信用卡:" + data.CCToken);
            $("#form").dxForm("instance").updateData('SelectedCreditCard', data.CCToken);
        }
    }
    function OnRowSelectionChanged(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) {
            $("#form").dxForm("instance").updateData('SelectedCreditCard', data.CCToken);
        }
    }
    function onCreditCardGridContentReady(e)
    {
        //debugger;
        var items = e.component.getDataSource().items();
        //alert(items.length);

        if (items.length > 0) {
            document.getElementById("creditcardlistcontainer").style.display = "";//顯示

            //alert('@(Model.SelectedCreditCard)');
            //用Key來選行，以下語法都是可以的
            e.component.selectRows( '@(Model.SelectedCreditCard)', true);
            //e.component.selectRows( ['@(Model.SelectedCreditCard)', '@(Model.SelectedCreditCard)'], true);
            //用Index來選行，以下語法都是可以的
            //e.component.selectRowsByIndexes(0);
            //e.component.selectRowsByIndexes( [0,1]);
        }
        else
        {
            document.getElementById("creditcardlistcontainer").style.display = "none";//隱藏
            //document.getElementById("creditcardlistcontainer").remove();//隱藏

            //var element = document.getElementById("creditcardlistcontainer");
            //element.parentNode.removeChild(element);

            $("#save-button3").dxButton("instance").option("visible", false);
            $("#save-button2").dxButton("instance").option("text", "奉獻");
        }
        //$("input[name='myHiddenInput']").val(JSON.stringify(items));
        //myHiddenInput - is the name of your hidden input
    }
</script>
<script type="text/javascript">
    // Ajax 區塊
    function onBegin() {
    }

    function onSuccess(data) {

        getLoadPanelInstance().hide();

        if (data.status == 1) {
            if (data.PayWay == "信用卡") {
                //alert("成功 3");
                ShowToast(data.message, "success", 2000);
                //window.open(data.DedicationResult);
                window.open(data.DedicationResult, "_blank");
                //window.location.href = data.DedicationResult;
            }
            else {
                ShowToast(data.message, "success", 2000);
                document.getElementById('atmfield').innerHTML = data.DedicationResult;
            }
        }
        else {
            ShowToast(data.message, "error", 3000);
            document.getElementById('atmfield').innerHTML = data.message;
        }
    }

    function onComplete(data) {
        if (data.status == 1) {
        }
        else {
        }
    }
</script>
<script>
    //中文化
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容", // 在這裡可以做最後的字典對應
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date",
            "dxDataGrid-editingConfirmDeleteMessage": "您確定要刪除這個信用卡嗎?",
        },
    };
    DevExpress.localization.loadMessages(dictionary);
    var formatMessage = DevExpress.localization.formatMessage;

    var locale = getLocale();
    //DevExpress.localization.locale(navigator.language || navigator.browserLanguage);
    DevExpress.localization.locale(locale);

    function changeLocale(data) {
        setLocale(data.value);
        document.location.reload();
    }

    function getLocale() {
        //debugger;
        //sessionStorage.setItem("locale", 'zh');
        sessionStorage.setItem("locale", 'zh-tw');
        var locale = sessionStorage.getItem("locale");
        return locale != null ? locale : "tw";
    }
</script>
