@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h5 id="displaynamefield"></h5>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveQPayDedication" asp-controller="Home" method="post">
    <div class="dx-field">
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("奉獻")
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

        </div>
    </div>
    <div id="form-container">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form")
        .ColCount(3)
        .Items(items =>
        {

            items.AddSimpleFor
            (m => m.Category)
                .Label(l => l.Text("類別"))
                .Editor
                (
                    e => e
                    .SelectBox()
                    .DataSource(new string[]
                    {
                       "十一",
                       "感恩",
                       "建堂",
                       "宣教",
                       "急難救助",
                       "青年事工",
                       "萬軍",
                       "其他",
                    }
                //.DisplayExpr("Name")
                )
                .Placeholder("奉獻類別")
                //.Value("十一")
                .OnValueChanged("OnCategorySelectBoxValueChanged")
            );

            items.AddSimpleFor
            (m => m.Others)
                .Label(l => l.Text("其他"))
                .Visible(false)
                .Name("OtherDedication")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .DataSource(new string[]
                    {
                       "特別",
                       "外教會",
                    }
                //.DisplayExpr("Name")
                )
                .Value("特別")
            );

            items.AddSimpleFor(m => m.Amount)
                    //.DataField("LastName")
                    .Label(l => l.Text("奉獻金額"))
                    .Editor(e => e
                        .NumberBox().Value(null)
                        .Disabled(false)
                        .Placeholder("輸入奉獻金額")
                    );

            items.AddSimpleFor
                    (m => m.PayWay)
                        .Label(l => l.Text("付款方式"))
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .DataSource(new string[]
                            {
                                           "信用卡",
                                           "ATM轉帳/匯款",
                            }
                        //.DisplayExpr("Name")
                        )
                        .Value("信用卡")
                    );

        })
        .OnContentReady(@<text>
                    function(e) {
                    e.component.validate();
                    }
        </text>)
.FormData(Model)
        )
    </div>

    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="atmfield"></h5>
    </div>

</form>

<script>
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }
    function ShowLoadPanel(arg) {

        //debugger;
        getLoadPanelInstance().show();
        //$("#toast").dxToast("instance").show();
        //alert("SaveNewPerson!!!");
        //alert("OnValueChanged : " + arg.value);

        //alert("OnValueChanged : " + arg.attribute('text'));
        //alert("OnValueChanged : " + text: arg.attribute("text"));

        //alert( getODataLocalDateFilter(arg.value) );
    }
    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        //debugger;
        var ToastInstance = $("#toast").dxToast("instance");
        ToastInstance.option('message', LocalToastMessage);
        ToastInstance.option('type', Type);
        ToastInstance.option('displayTime', DisplayTime);
        ToastInstance.option('white-space', 'pre-line');
        ToastInstance.option('closeOnClick', true);
        ToastInstance.show();
    }
    function OnCategorySelectBoxValueChanged(e) {
        if (e.value == "其他") {
            //alert(e.value + "顯示");
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', true);
        }
        else {
            //alert(e.value + "隱藏");
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', false);
        }
    }

</script>

<script type="text/javascript">
            function onBegin() {
            }

            function onSuccess(data) {

                getLoadPanelInstance().hide();

                if (data.PayWay =="信用卡") {
                    //alert("成功 3");
                    ShowToast(data.message, "success", 2000);
                    window.location.href = data.DedicationResult;
                }
                else
                {
                    document.getElementById('atmfield').innerHTML = data.DedicationResult;
                }
            }

            function onComplete(data) {
                alert("結束!");

                if (data.status == 1) {
                }
                else {
                }
            }
</script>

<script src="~/js/liff-starter.js"></script>
@*<script src="https://d.line-scdn.net/liff/1.0/sdk.js"></script>*@
<script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>
<script>

    window.onload = function (e) {
            //var message = '@TempData["Proponent"]';
            //window.alert( "耶和華" + message);
            liff.init(
                { liffId: '@TempData["Proponent"]' },
                function (data) {
                    //debugger;
                    //alert("測試 window.onload 001!");
                    initializeApp(data);
                    //alert("測試 window.onload 002!");
                }
            );
        };

        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";

        async function initializeApp(data) {

            await liff.getProfile().then(function (profile) {
                DisplayName = profile.displayName;
                UserId = profile.userId;
                //alert("測試 UserId =" + UserId);
                GroupId= profile.aGroupId;
                RoomId = profile.aRoomId;
                ViewType = profile.aViewType;
                //alert("測試004!" + DisplayName);
                // 取得 UserId 的Ajax
                UpdateLineUserId(UserId, GroupId, RoomId, ViewType);

                document.getElementById('displaynamefield').innerHTML = profile.displayName + "奉獻";

                DisplayName = profile.displayName;
            });
        }

        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SetupUserLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                document.getElementById('displaynamefield').innerHTML = data.FullName + "奉獻編號:" + data.DedicationNumber;
                            },

                            error: function (obj)
                            {
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }

</script>

<link href="~/css/Scheduler.css" rel="stylesheet" />
<link href="~/css/Site.css" rel="stylesheet" />

<script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
