<!-- JavaScript 區域 -->
<script>
    // 初始化與工具函數
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }

    function ShowLoadPanel() {
        getLoadPanelInstance().show();
    }

    function UseOtherCreditCard() {
        getLoadPanelInstance().show();
        $("#form").dxForm("instance").updateData('SelectedCreditCard', "");
    }

    function ShowToast(message, type, displayTime) {
        var toast = $("#toast").dxToast("instance");
        toast.option('message', message);
        toast.option('type', type);
        toast.option('displayTime', displayTime);
        toast.option('white-space', 'pre-line');
        toast.option('closeOnClick', true);
        toast.show();
    }

    // 表單事件處理
    function OnCategorySelectBoxValueChanged(e) {
        // 隱藏所有相關欄位
        $("#form").dxForm("instance").itemOption("OtherDedicationSelectionBox", 'visible', false);
        $("#form").dxForm("instance").itemOption("HolidayDedicationSelectionBox", 'visible', false);
        $("#form").dxForm("instance").itemOption("SpecialDedicationSelectionBox", 'visible', false);
        $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', false);

        // 根據選擇顯示對應欄位
        if (e.value == "節期獻金") {
            $("#form").dxForm("instance").itemOption("HolidayDedicationSelectionBox", 'visible', true);
        } else if (e.value == "特別獻金") {
            $("#form").dxForm("instance").itemOption("SpecialDedicationSelectionBox", 'visible', true);
        }

        // 設定金額欄位寬度
        $("#form").dxForm("instance").itemOption('DedicationAmount', {
            editorOptions: { width: 200 }
        });
    }

    function OnPayWaySelectBoxValueChanged(e) {
        // 重置介面
        resetPaymentUI();
        
        // 根據付款方式處理UI
        switch(e.value) {
            case "信用卡":
                handleCreditCardPayment();
                break;
            case "信用卡定期定額(每個月)":
                handleCreditCardSubscription();
                break;
            default:
                handleOtherPayment();
                break;
        }
    }
    
    function resetPaymentUI() {
        // 清空ATM欄位
        document.getElementById('atmfield').innerHTML = "";
        
        // 重設金額欄位
        $("#form").dxForm("instance").itemOption('DedicationAmount', {
            editorOptions: { width: 200 }
        });
        $("#form").dxForm("instance").itemOption("DedicationAmount", "label", { text: "奉獻金額" });
        $("#form").dxForm("instance").itemOption("DedicationAmount", "editorOptions", { placeholder: "輸入奉獻金額" });
        
        // 隱藏總期數
        $("#form").dxForm("instance").itemOption("DeductTotalNumberSelectionBox", 'visible', false);
    }
    
    function handleCreditCardPayment() {
        var creditcards = $("#CreditCardGrid").dxDataGrid("instance").getDataSource().items();
        if (creditcards.length > 0) {
            document.getElementById("creditcardlistcontainer").style.display = "";
            $("#CreditCardGrid").dxDataGrid("instance").selectRows('@(Model.SelectedCreditCard)', true);
            $("#save-button3").dxButton("instance").option("visible", true);
            $("#save-button2").dxButton("instance").option("text", "用上面選擇的信用卡奉獻");
        } else {
            document.getElementById("creditcardlistcontainer").style.display = "none";
            $("#save-button3").dxButton("instance").option("visible", false);
            $("#save-button2").dxButton("instance").option("text", "奉獻");
        }
        document.getElementById("dedicationbookinglistcontainer").style.display = "none";
    }
    
    function handleCreditCardSubscription() {
        handleCreditCardPayment();
        
        // 顯示定期定額列表
        var bookings = $("#DedicationBookingGrid").dxDataGrid("instance").getDataSource().items();
        if (bookings.length > 0) {
            document.getElementById("dedicationbookinglistcontainer").style.display = "";
        }
        
        // 設定為定期定額模式
        $("#form").dxForm("instance").itemOption("DeductTotalNumberSelectionBox", 'visible', true);
        $("#form").dxForm("instance").itemOption("DedicationAmount", "label", { text: "每月金額" });
        $("#form").dxForm("instance").itemOption("DedicationAmount", "editorOptions", { placeholder: "每月的奉獻金額" });
    }
    
    function handleOtherPayment() {
        document.getElementById("creditcardlistcontainer").style.display = "none";
        document.getElementById("dedicationbookinglistcontainer").style.display = "none";
        $("#save-button3").dxButton("instance").option("visible", false);
        $("#save-button2").dxButton("instance").option("text", "奉獻");
    }

    // 金額欄位處理
    function OnAmountContentReady(e) {
        if (e.component.option("value") == 0) {
            e.component.option("value", "");
        }
    }

    // 資料網格處理
    function DataGridOnInitialized(e) {
        e.component.columnOption("command:edit", "width", 50);
    }

    function OnRowClick(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) {
            $("#form").dxForm("instance").updateData('SelectedCreditCard', data.CCToken);
        }
    }

    function OnRowSelectionChanged(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) {
            $("#form").dxForm("instance").updateData('SelectedCreditCard', data.CCToken);
        }
    }

    function onCreditCardGridContentReady(e) {
        var items = e.component.getDataSource().items();
        if (items.length > 0) {
            document.getElementById("creditcardlistcontainer").style.display = "";
            document.getElementById("dedicationbookinglistcontainer").style.display = "none";
            e.component.selectRows('@(Model.SelectedCreditCard)', true);
        } else {
            document.getElementById("creditcardlistcontainer").style.display = "none";
            document.getElementById("dedicationbookinglistcontainer").style.display = "none";
            $("#save-button3").dxButton("instance").option("visible", false);
            $("#save-button2").dxButton("instance").option("text", "奉獻");
        }
    }

    function onDedicationBookingGridContentReady(e) {
        e.component.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }

    // AJAX回調處理
    function onBegin() {
        // 表單送出前處理
    }

    function onSuccess(data) {
        getLoadPanelInstance().hide();

        if (data.status == 1) {
            if (data.PayWay == "信用卡") {
                ShowToast(data.message, "success", 2000);
                window.location.href = data.DedicationResult;
            } else {
                ShowToast(data.message, "success", 2000);
                document.getElementById('atmfield').innerHTML = data.DedicationResult;
            }
        } else {
            ShowToast(data.message, "error", 3000);
            document.getElementById('atmfield').innerHTML = data.message;
        }
    }

    // DevExtreme本地化設定
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容",
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date",
            "dxDataGrid-editingConfirmDeleteMessage": "您確定要刪除這個信用卡嗎?",
        }
    };
    
    DevExpress.localization.loadMessages(dictionary);
    var locale = "zh-tw";
    sessionStorage.setItem("locale", locale);
    DevExpress.localization.locale(locale);
</script>

