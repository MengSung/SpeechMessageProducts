<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="UpdateDedicationFeeView" asp-controller="Home" method="post">

    <div id="StartLabel" class="dx-field-label" style="float: left; width:15%; background-color:white;">開始日期</div>
    <div id="StartDateBoxContainer" class="dx-field-value" style="float: left; width:55%; background-color:white;">
        @(Html.DevExtreme()
                    //.DateBox()
                    .DateBoxFor(m => m.QueryStartDate)
                    .Type(DateBoxType.Date)
                    .Value(Model.QueryStartDate)
                    .Width(50)
                    .DisplayFormat("yyyy/M/d")
                    .OnChange("OnDateboxChange")
                    .CalendarOptions( k=>k.FirstDayOfWeek(0))
                    .PickerType(DateBoxPickerType.Calendar)
                    //.DisplayFormat("yyyy/MM/dd")
                    //.OnValueChanged("OnValueChanged")
                    )
    </div>
    <div id="EndLabel" class="dx-field-label" style="float: left; width:15%; background-color:white;">結束日期</div>
    <div id="EndDateBoxContainer" class="dx-field-value" style="float: left; width:55%; background-color:white;">
        @(Html.DevExtreme()
                    //.DateBox()
                    .DateBoxFor(m => m.QueryEndDate)
                    .Type(DateBoxType.Date)
                    .Value(Model.QueryEndDate)
                    .Width(50)
                    .DisplayFormat("yyyy/M/d")
                    .OnChange("OnDateboxChange")
                    .CalendarOptions( k=>k.FirstDayOfWeek(0))
                    .PickerType(DateBoxPickerType.Calendar)
                    //.DisplayFormat("yyyy/MM/dd")
                    //.OnValueChanged("OnValueChanged")
                    )
    </div>

    <div id="buttonContainer" class="dx-button-icon" style="float: left; width:30%; text-align: left; background-color:white;">
        @(Html.DevExtreme().Button()
                        .Text("上傳").Height(50).Width(80).Icon("check")
                        .Type(ButtonType.Success)
                        .ID("save-button")
                        .UseSubmitBehavior(false)
                        .OnClick
                            (@<text>
                                        function(arg)
                                        {
                                        if( true )
                                        {
                                                // 顯示旋轉鈕
                                                $("#loadPanel").dxLoadPanel("instance").show();

                                                // 上傳按鈕反白
                                                ButtonContainer.option("disabled", true);

                                                // AJAX 區塊
                                                $.ajax
                                                (
                                                    {
                                                        url: '@Url.Action("UpdateDedicationFeeView", "Home")',
                                                        data: { WeeklyReportData: "" }, // 整理回傳給 Server 的點名資料
                                                        type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                                                        success: function (arg)
                                                        {
                                                            // 隱藏旋轉鈕
                                                            $("#loadPanel").dxLoadPanel("instance").hide();

                                                            // 上傳按鈕恢復可運作
                                                            ButtonContainer.option("disabled", false);

                                                            // 顯示上傳成功
                                                            if (arg.status == 1)
                                                            {
                                                                ShowToast(arg.message, "success", 2000);
                                                            }
                                                            else{
                                                                ShowToast(arg.message, "error", 5000);
                                                            }

                                                            //$("#toast").dxToast("instance").show();
                                                        },

                                                        error: function (obj)
                                                        {
                                                            //alert('Something happened');
                                                        }
                                                    }
                                                );
                                                // AJAX 區塊
                                            }
                                            else
                                            {

                                                    // 隱藏旋轉鈕
                                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                                    // 顯示再上傳一次
                                                    var IndividualGrid = $("#IndividualGridContainer").dxDataGrid("instance");
                                                    IndividualGrid.saveEditData();//是否還殘留尚未回傳的編輯資料
                                                    $("#ToastReUpload").dxToast("instance").show();

                                            }
                                        }
                            </text>)
            )
    </div>
    <div class="dx-field">
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
            .ID("loadPanel")
            .ShadingColor("rgba(0,0,0,0.4)")
            //.Position(p => p.Of("#data-grid").Of("#buttonContainer"))
            .Position(p => p.Of("#data-grid"))
            .Visible(false)
            .ShowIndicator(true)
            .ShowPane(true)
            .Shading(true)
            .CloseOnOutsideClick(false)
            .Message("更新資料中...")
            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            //.OnShown("loadPanel_shown")
            //.OnHidden("loadPanel_hidden")
        )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
            .ID("ToastReUpload")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message("有尚未更新好的資料，請再按一次上傳!")
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(500)
        )

        </div>
    </div>
    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="displaynamefield">@Model.FullName 奉獻編號:@Model.DedicationNumber</h5>
    </div>
    <div id="data-grid">
        @(Html.DevExtreme().DataGrid<DedicationFee>()
                .ID("DedicationFeeGrid")
                .ShowBorders(true)
                //.ColumnAutoWidth(true)
                //.Paging(p => p.PageSize(10))
                .Paging(paging => paging.Enabled(false))
                .AllowColumnResizing(true)
                .ColumnResizingMode(ColumnResizingMode.Widget)
                .ColumnFixing(c => c.Enabled(true))
                .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                .Export(e => e.Enabled(true).AllowExportSelectedData(true))
                .ShowColumnLines(true)
                .ShowRowLines(true)
                .RowAlternationEnabled(true)
                .ShowBorders(true)
                .RemoteOperations(false)
                .TwoWayBindingEnabled(true)
                .Editing(editing =>
                {
                    //editing.Mode(GridEditMode.Batch);
                    //editing.Mode(GridEditMode.Row);
                    editing.Mode(GridEditMode.Cell);
                    //editing.Mode(GridEditMode.Batch);
                    //editing.Mode(GridEditMode.Form);
                    //editing.Mode(GridEditMode.Popup);
                    //editing.AllowUpdating(true);
                    //editing.AllowAdding(true);
                    //editing.AllowDeleting(true);
                    editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除"));
                })

                .Columns(columns =>
                {
                    columns.AddFor(m => m.Category).Caption("奉獻類別").Width(50).MinWidth(50).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.DedicationDate).Caption("奉獻日期").Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("yyyy/M/d").Width(100).MinWidth(45).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.PayDate).Caption("付款日期").Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("yyyy/M/d").Width(100).MinWidth(45).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.PayWay).Caption("付款方式").Width(80).MinWidth(80).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.Amount).Caption("金額").Width(80).MinWidth(80).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.Others).Caption("奉獻細項").Width(60).MinWidth(60).AllowEditing(false).AllowSorting(true);
                })
                .DataSource
                (Model.DedicationFeeList)

                )
    </div>
    <div style="font-family:標楷體;font-size:100%; color:darkred; text-align:left;font-weight:bold">
        <h4 id="displaynamefield">總金額 = @Model.TotalAmount 元</h4>
    </div>
</form>

