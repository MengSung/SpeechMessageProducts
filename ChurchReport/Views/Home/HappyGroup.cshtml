.At(HorizontalAlignment.Center, VerticalAlignment.Center)
.Offset(0, 50))
.Message(ReUpload)
.DisplayTime(5000)
.Type(ToastType.Error)
.MaxWidth(500)
)
</div>
<div id="ToastContainerNoSelectDate">
