<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h5 id="displaynamefield"></h5>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SavePoll" asp-controller="Home" method="post">
    <div id="form-container">
        @(Html.DevExtreme().Form<PollModel> ()
        .ID("form")
        .ColCount(2)
        .Items(items =>
        {
            items.AddSimpleFor(m => m.WorshipPoll)
                //.DataField("LastName")
                .Label(l => l.Text("是否參加敬拜團"))
                .Editor(e => e
                    .CheckBox()
                    .Disabled(false)
                );

            items.AddSimpleFor(m => m.MusicDevice)
                //.DataField("LastName")
                .Label(l => l.Text("是否參加音控"))
                .Editor(e => e
                    .CheckBox()
                    .Disabled(false)
                );

            items.AddSimpleFor(m => m.DisplayPpt)
                //.DataField("LastName")
                .Label(l => l.Text("是否參加放印PPT"))
                .Editor(e => e
                    .CheckBox()
                    .Disabled(false)
                );

            items.AddSimpleFor(m => m.PollContent)
                //.DataField("LastName")
                .Label(l => l.Text("意見回饋調查"))
                .ColSpan(2)
                .Editor(e => e
                    .TextArea()
                    .Disabled(false)
                    .Width(200)
                    .Height(200)
                    .Placeholder("意見回饋調查")
                );

        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )

    </div>


    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="atmfield"></h5>
    </div>
</form>

