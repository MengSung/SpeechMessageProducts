<script>
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容", // 在這裡可以做最後的字典對應
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date"
        },
    };
    DevExpress.localization.loadMessages(dictionary);
    var formatMessage = DevExpress.localization.formatMessage;

    var locale = getLocale();
    //DevExpress.localization.locale(navigator.language || navigator.browserLanguage);
    DevExpress.localization.locale(locale);

    function changeLocale(data) {
        setLocale(data.value);
        document.location.reload();
    }

    function getLocale() {
        //debugger;
        //sessionStorage.setItem("locale", 'zh');
        sessionStorage.setItem("locale", 'zh-tw');
        var locale = sessionStorage.getItem("locale");
        return locale != null ? locale : "tw";
    }

</script>

<script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>

<script>


    window.onload = function (e) {
            //var message = '@TempData["Proponent"]';
            //window.alert( "耶和華" + message);
            liff.init(
                { liffId: '@TempData["Proponent"]' },
                function (data) {
                    //debugger;
                    //alert("測試 window.onload 001!");
                    initializeApp(data);
                    //alert("測試 window.onload 002!");
                }
            );
        };

        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";

        var ClassName = "";

    async function initializeApp(data) {
                //alert("測試 initializeApp-001 : " + data);
                //liff.scanCode();
           await liff.getProfile().then( function (profile) {
                DisplayName = profile.displayName;
                UserId = profile.userId;
                //alert("測試 UserId =" + UserId);
                GroupId= profile.aGroupId;
                RoomId = profile.aRoomId;
                ViewType = profile.aViewType;
                //alert("測試004!" + DisplayName);
                // 取得 UserId 的Ajax
                UpdateLineUserId( DisplayName, UserId, GroupId, RoomId, ViewType);

                document.getElementById('classnamefield').innerHTML = "正在處理中......" ;

            });

        }

    function UpdateLineUserId(aDisplayName, aUserLineId, aGroupId, aRoomId, aViewType)
    {
                    // AJAX 區塊
                    return $.ajax
                    (
                        {
                            url: '@Url.Action("PollQrCodeGetLineId", "Home")',
                            data: { DisplayName: aDisplayName, UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server
                            //async: false,
                            success: function (data)
                            {
                                if (data.result.includes("錯誤") != true) {
                                    // 正確掃描
                                    //document.getElementById('classnamefield').innerHTML = "課程名稱: " + data.classname;
                                    document.getElementById('displaynamefield').innerHTML = "請 " + data.username + " 完成服事意願及意見回饋調查" + "<br/>願神祝福" + data.username;
                                    //document.getElementById('classindexfield').innerHTML = "課堂資訊: " + data.classindex;
                                }
                                else
                                {
                                    document.getElementById('displaynamefield').innerHTML = data.result;
                                }
                            },

                            error: function (obj)
                            {
                                //getLoadPanelInstance().hide();
                                window.location.href = "/Home/Login";
                            }
                        }
                    );
                    // AJAX 區塊
        }

    function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

</script>

