@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h4 id="displaynamefield">@Model.FullName 奉獻編號:@Model.DedicationNumber</h4>
    <h4 id="displaynamefield">@Model.Ntbt</h4>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="UpdateDedicationFeeView" asp-controller="Home" method="post">
    <div class="dx-field">
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Visible(false)
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

        </div>
    </div>
    <div id="form-container">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form")
        .ColCount(1)
        .Items
        (items =>
        {
            items.AddSimpleFor
                (m => m.QueryStartDate)
                .Label(l => l.Text("開始日期"))
                .IsRequired(false)
                .Editor(e => e
                    .DateBox()
                    .Width(200)
                    .DisplayFormat("yyyy/M/d")
                    .Disabled(false)
                    .Placeholder("開始日期")
                    .PickerType(DateBoxPickerType.Calendar)
                );
            items.AddSimpleFor
                (m => m.QueryEndDate)
                .Label(l => l.Text("結束日期"))
                .IsRequired(false)
                .Editor(e => e
                    .DateBox()
                    .Width(200)
                    .DisplayFormat("yyyy/M/d")
                    .Disabled(false)
                    .Placeholder("結束日期")
                    .PickerType(DateBoxPickerType.Calendar)
                );

        }
        )
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )

    </div>
    <div id="form-container-query">
        @(Html.DevExtreme().Form<QpayModel>()
                 .ID("form1")
                 .ColCount(1)
                 .Items(items =>
                 {
                     items.AddSimpleFor(m => m.DedicationNumber)
                            //.DataField("LastName")
                            .Label(l => l.Text("奉獻編號"))
                            .Editor(e => e
                                .TextBox()
                                .Width(120)
                                .Disabled(false)
                                .Placeholder("輸入奉獻編號")
                                .FocusStateEnabled(true)
                           );

                     items.AddSimpleFor(m => m.NationId)
                           //.DataField("LastName")
                           .Label(l => l.Text("身份證字號"))
                           .Editor(e => e
                               .TextBox()
                               .Width(120)
                               .Disabled(false)
                               .Placeholder("輸入身份證字號")
                               .FocusStateEnabled(true)
                          );

                     items.AddSimpleFor(m=>m.FullName)
                        //.DataField("LastName")
                        .Label(l => l.Text("姓名"))
                        .Editor(e => e
                            .TextBox()
                            .Width(120)
                            .Disabled(false)
                            .Placeholder("輸入姓名")
                       );

                     items.AddSimpleFor(m => m.Mobile)
                            .Label(l => l.Text("電話號碼"))
                            .Editor(e => e
                                .TextBox()
                                .Width(120)
                                //.Mask("(X000) 000-000")
                                .MaskRules(new { X = new JS("/[02-9]/") })
                                .Placeholder("輸入電話號碼")
                            );

                     items.AddSimpleFor(m => m.LastSixDigit)
                            .Label(l => l.Text("帳戶後六碼"))
                            .Editor(e => e
                                .TextBox()
                                .Width(120)
                                //.Mask("(X000) 000-000")
                                .MaskRules(new { X = new JS("/[02-9]/") })
                                .Placeholder("輸入帳戶後六碼")
                            );


                 })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
                $("#form1").dxForm("instance").getEditor('DedicationNumber').focus();
            }
        </text>)

        .FormData(Model)
        )
    </div>

    <div id="buttonContainer3" class="dx-button-icon">
        @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Visible(true)
                    .Type(ButtonType.Success)
                    .ID("save-button3")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
    </div>

    <div id="form-container-upload">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form2")
        .ColCount(1)
        .Items(items =>
        {
            items.AddSimpleFor(m => m.ClickType)
                    //.DataField("LastName")
                    .Label(l => l.Text("查詢或上傳").Visible(false))
                    .Editor(e => e
                        .TextBox()
                        .Width(120).Visible(false)
                        //.Disabled(true)
                        .Placeholder("查詢或上傳")
                   );

        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )
    </div>

    <div id="samenamecontainer" style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="samenamefield">查詢結果</h5>

