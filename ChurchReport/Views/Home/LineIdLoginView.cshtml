            //UpdateLineUserId(data.context.userId, data.context.groupId, data.context.roomId, data.context.viewType);

            //alert("測試003!" );

            //liff.getProfile().then(function (profile) {
            //    //document.getElementById('useridprofilefield').textContent = profile.userId;
            //    //document.getElementById('displaynamefield').textContent = profile.displayName;

            //    document.getElementById('displaynamefield').innerHTML = profile.displayName + "的行事曆";

            //    //getSchedulerInstance().reload();
            //    //$("#scheduler").dxScheduler("getDataSource").reload()



