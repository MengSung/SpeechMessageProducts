<!DOCTYPE html>

@{
    Layout = null;
}
<html>

@model ChurchReport.ViewModel.LineBindingViewModel

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>迦南基督長老教會</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    @* JSZip for client side export *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

</head>

<body>

    <div class="widget-container" style="padding: 10px;">
        @(Html.DevExtreme().Gallery()
                        .ID("gallery")
                        .DataSource(Model.Images)
                        .Height("250px")
                        //.Width(600)
                        //.InitialItemWidth(250)
                        .StretchImages(true)
                        .Loop(true)
                        .SlideshowDelay(1200)
        )
    </div>

    <div class="long-title"><h3 id="displaynamefield"></h3></div>

    <div id="WidgetContainer">
        @(Html.DevExtreme().Toast()
                .ID("Toast")
                .Position(p => p
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Offset(0, 50))
                //.Shading(true)
                //.ShadingColor("red")
                .CloseOnOutsideClick(true)
                .DisplayTime(2000)
                .MaxWidth(200)
        )
        @(Html.DevExtreme().LoadPanel()
                                .ID("loadPanel")
                                .ShadingColor("rgba(0,0,0,0.4)")
                                .Position(p => p.Of("#LoadPanelField"))
                                .Visible(false)
                                .ShowIndicator(true)
                                .ShowPane(true)
                                .Shading(true)
                                .CloseOnOutsideClick(false)
                                .Message("登入中,約需5~10秒...")
                                .Delay(5000)
                                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                )

    </div>

    <div class="long-title"><h3 id="LoadPanelField"></h3></div>

    <script>
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        function loadPanel_show() {
            getLoadPanelInstance().show();
            //    setTimeout(function () {
            //        e.component.hide();
            //    }, 3000);
        }

        function loadPanel_hide() {
            getLoadPanelInstance().hide();
        }

        function Binding(arg) {
            //客製化
            window.location.href = "/Home/LineLiffView/1653819697-YkPyPkr6";
        }

        function Login(arg) {
            window.location.href = "/Home/Login";
        }

    </script>

    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <link href="~/css/Gallery.css" rel="stylesheet" />
    <link href="~/css/WeeklyReport.css" rel="stylesheet" />

    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <script>

        window.onload = function (e)
        {
            liff.init({ liffId:  '@TempData["Proponent"]' })
                .then(() =>
                {
                // 检查用户是否已登录
                  if (!liff.isLoggedIn())
                  {
                      document.getElementById('displaynamefield').innerHTML = "您還沒有登入LINE";

                      ShowToast("您還沒有登入LINE", "error", 5000);

                      liff.login();

                      return;
                  }
                  else
                  {
                      liff.permission.query("profile").then((permissionStatus) => {
                          if (permissionStatus.state === "granted") {
                              //使用者已授權
                              initializeApp();
                          }
                          else if (permissionStatus.state === "prompt") {
                              document.getElementById('displaynamefield').innerHTML = "您並未授權，請先完成授權程序!";
                              liff.permission.requestAll();
                          }
                          else {
                              document.getElementById('displaynamefield').innerHTML = "Liff Scope沒有設定，所以無法操作!";
                          }
                      });
                  }
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });
        };

        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";


        async function initializeApp() {
            await liff.getProfile()
                .then(function (profile) {
                    document.getElementById('displaynamefield').innerHTML = profile.displayName + "進行登入中<br/>約需5~15秒......";

                    DisplayName = profile.displayName;
                    UserId = profile.userId;
                    //alert("測試 UserId =" + UserId);
                    GroupId = profile.aGroupId;
                    RoomId = profile.aRoomId;
                    ViewType = profile.aViewType;
                    //alert("測試004!" + DisplayName);

                    // 取得 UserId 的Ajax
                    UpdateLineUserId(UserId, GroupId, RoomId, ViewType);
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });

        }


        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SaveUserLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                if (data.message != "尚未綁定") {
                                    if (data.DisplayViewType == "MultiGroupView") {
                                        // 小組長或是個人回報
                                        ShowToast(data.message, "success", 2000);

                                        //DevExpress.ui.notify(data.message, "success", 2000);

                                        //window.location.href = "/Home/IntegrateView/AccountPassword";
                                        window.location.href = "/Home/MultiGroupView/" + data.ActiveListId;
                                    }
                                    else if (data.DisplayViewType == "IntegrateView") {
                                        // 小組長或是個人回報
                                        ShowToast(data.message, "success", 2000);

                                        //DevExpress.ui.notify(data.message, "success", 2000);

                                        window.location.href = "/Home/IntegrateView/" + data.ActiveListId;
                                    }
                                    else if (data.DisplayViewType == "HappyGroupView") {
                                        // 單純幸福小組長回報
                                        ShowToast(data.message, "success", 2000);

                                        //DevExpress.ui.notify(data.message, "success", 2000);

                                        window.location.href = "/Home/HappyGroup";
                                    }
                                    else {
                                        ShowToast(data.message, "error", 5000);
                                        getLoadPanelInstance().hide();
                                        document.getElementById('displaynamefield').innerHTML = "登入錯誤!";
                                        //DevExpress.ui.notify(data.message, "error", 3000);
                                    }
                                }
                                else {
                                        ShowToast(data.message, "error", 2000);
                                        getLoadPanelInstance().hide();
                                        document.getElementById('displaynamefield').innerHTML = "登入錯誤!";
                                }
                            },

                            error: function (obj)
                            {
                                getLoadPanelInstance().hide();
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }


        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

    </script>
</body>

</html>