        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SaveUserLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                if (data.message != "尚未綁定") {
                                    if (data.DisplayViewType == "MultiGroupView") {
                                        // 小組長或是個人回報
                                        ShowToast(data.message, "success", 2000);

                                        //DevExpress.ui.notify(data.message, "success", 2000);

                                        //window.location.href = "/Home/IntegrateView/AccountPassword";
                                        window.location.href = "/Home/MultiGroupView/" + data.ActiveListId;
                                    }
                                    else if (data.DisplayViewType == "IntegrateView") {
                                        // 小組長或是個人回報
                                        ShowToast(data.message, "success", 2000);

                                        //DevExpress.ui.notify(data.message, "success", 2000);

                                        window.location.href = "/Home/IntegrateView/" + data.ActiveListId;
                                    }
                                    else if (data.DisplayViewType == "HappyGroupView") {
                                        // 單純幸福小組長回報
                                        ShowToast(data.message, "success", 2000);

                                        //DevExpress.ui.notify(data.message, "success", 2000);

                                        window.location.href = "/Home/HappyGroup";
                                    }
                                    else {
                                        ShowToast(data.message, "error", 5000);
                                        getLoadPanelInstance().hide();
                                        document.getElementById('displaynamefield').innerHTML = "登入錯誤!";
                                        //DevExpress.ui.notify(data.message, "error", 3000);
                                    }
                                }
                                else {
                                        ShowToast(data.message, "error", 2000);
                                        getLoadPanelInstance().hide();
                                        document.getElementById('displaynamefield').innerHTML = "您還沒有綁定，請選擇綁定或透過帳號密碼登入!";
                                        // 取得綁定的按鈕
                                        var BindingButton= $("#binding-button").dxButton("instance");
                                        BindingButton.option("visible", true);
                                        // 取得帳密登入的按鈕
                                        var LoginButton= $("#login-button").dxButton("instance");
                                        LoginButton.option("visible", true);

                                }
                            },

                            error: function (obj)
                            {
                                getLoadPanelInstance().hide();
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }


        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

    </script>
</body>

</html>