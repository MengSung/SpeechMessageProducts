@* 
    這個視圖用於 LINE ID 登入頁面 (改版)。
    改善：響應式、行動優先、基督教風格、Hero 區塊、卡片式資訊、圖示、語意化標籤。
*@
@{
    Layout = null;
}
@model ChurchReport.ViewModel.LineBindingViewModel
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="聖谷行道會 LINE 登入" />
    <meta name="author" content="聖谷行道會" />
    <title>聖谷行道會 LINE 登入</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <!-- Bootstrap / DevExtreme / FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/LineIdLoginView.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        /* Hero 橫幅與覆蓋層 */
        .hero-wrapper { position: relative; width:100%; height:320px; overflow:hidden; }
        .hero-overlay { position:absolute; inset:0; background: linear-gradient(135deg, rgba(0,0,0,0.55), rgba(0,0,0,0.2)); display:flex; flex-direction:column; justify-content:center; align-items:center; color:#fff; text-align:center; padding:1rem; }
        .hero-overlay h1 { font-size:2rem; letter-spacing:2px; font-weight:700; margin-bottom:.75rem; }
        .hero-overlay .verse { font-size:.95rem; line-height:1.4; max-width:620px; }
        .hero-overlay .verse span { display:block; margin-top:.35rem; font-size:.75rem; opacity:.8; }
        /* 名稱/提示區 */
        #displaynamefield { font-weight:600; min-height:48px; }
        .info-section { margin-top: -60px; }
        /* 卡片樣式 */
        .card-soft { border: none; border-radius: 18px; background: #ffffff; box-shadow: 0 6px 18px rgba(0,0,0,.08); overflow:hidden; }
        .card-soft-header { background: linear-gradient(135deg,#6b8ce3,#4864b8); color:#fff; padding:.75rem 1rem; font-weight:600; letter-spacing:1px; display:flex; align-items:center; gap:.5rem; }
        .contact-list { list-style:none; padding:0; margin:0; }
        .contact-list li { display:flex; gap:.75rem; padding:.55rem .35rem; align-items:flex-start; font-size:.95rem; border-bottom:1px dashed #e2e6f0; }
        .contact-list li:last-child { border-bottom:none; }
        .contact-icon { width:30px; text-align:center; font-size:1.05rem; color:#4864b8; }
        .contact-text { flex:1; line-height:1.35; }
        .action-buttons { display:flex; flex-wrap:wrap; gap:.75rem; margin-top:1.25rem; justify-content:center; }
        .action-buttons .btn { border-radius:30px; padding:.65rem 1.4rem; font-weight:600; letter-spacing:1px; box-shadow:0 4px 12px rgba(0,0,0,.12); transition:.25s; }
        .action-buttons .btn-primary { background:#4864b8; }
        .action-buttons .btn-outline-light { background:#fff; color:#4864b8; border:2px solid #4864b8; }
        .action-buttons .btn:hover { transform:translateY(-3px); }
        .footer-note { text-align:center; font-size:.75rem; color:#777; margin:2.5rem 0 .5rem; }
        .logo-faith { font-size:2.2rem; animation: pulse 3.5s infinite; }
        @@keyframes pulse {0%{transform:scale(1)}50%{transform:scale(1.1)}100%{transform:scale(1)}}
        /* Toast 排版修飾不在這裡, DevExtreme 自己處理 */
        @@media (max-width:575.98px){ .hero-overlay h1 { font-size:1.55rem; } .hero-wrapper{height:280px;} .card-soft-header{font-size:.95rem;} }
    </style>
    <!-- jQuery / Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <!-- DevExtreme Globalization -->
    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>
    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>
    <!-- DevExtreme Core -->
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
</head>
<body class="bg-light">
    <!-- Hero & Gallery -->
    <section class="hero-wrapper" aria-label="歡迎區">
        <div class="position-absolute w-100 h-100" style="z-index:1;">
            @(Html.DevExtreme().Gallery()
                .ID("gallery")
                .DataSource(Model.Images)
                .Height("100%")
                .StretchImages(true)
                .Loop(true)
                .SlideshowDelay(2500)
            )
        </div>
        <div class="hero-overlay" role="banner">
            <i class="fa-solid fa-dove logo-faith mb-2" aria-hidden="true"></i>
            <h1>聖谷行道會</h1>
            <div id="displaynamefield" class="mb-2"></div>
            <p class="verse">
                我們愛，因為神先愛我們。<span>— 約翰一書 4:19</span>
            </p>
            <div class="action-buttons">
                <button type="button" class="btn btn-primary" onclick="Binding()"><i class="fa-link fa-solid me-1"></i>綁定帳號</button>
                <button type="button" class="btn btn-outline-light" onclick="Login()"><i class="fa-right-to-bracket fa-solid me-1"></i>帳號登入</button>
            </div>
        </div>
    </section>
    <!-- 主內容 -->
    <main class="container info-section" role="main">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div id="ContactMessage" class="card-soft mb-4" aria-labelledby="contactHeader">
                    <div class="card-soft-header" id="contactHeader">
                        <i class="fa-solid fa-church"></i><span>聯絡資訊</span>
                    </div>
                    <div class="p-3 p-md-4">
                        <ul class="contact-list" aria-label="教會聯絡資訊">
                            <li><div class="contact-icon"><i class="fa-solid fa-location-dot"></i></div><div class="contact-text">新北市新店區安興路91巷5號</div></li>
                            <li><div class="contact-icon"><i class="fa-solid fa-phone"></i></div><div class="contact-text">02-2211-1556 (代表號)</div></li>
                            <li><div class="contact-icon"><i class="fa-solid fa-envelope"></i></div><div class="contact-text">sunnyvale.church@gmail.com</div></li>
                            <li><div class="contact-icon"><i class="fa-solid fa-file-invoice"></i></div><div class="contact-text">統一編號：20004335</div></li>
                        </ul>
                        <div class="small text-muted mt-3">
                            若您尚未完成 LINE 綁定，請點選「綁定帳號」；完成後將自動導向您的專屬頁面。
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- DevExtreme Widget Container (Toast & LoadPanel) -->
        <div id="WidgetContainer">
            @(Html.DevExtreme().Toast()
                .ID("Toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Top)
                    .Offset(0, 90))
                .CloseOnOutsideClick(true)
                .DisplayTime(2600)
                .MaxWidth(320)
            )
            @(Html.DevExtreme().LoadPanel()
                .ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.45)")
                .Position(p => p.Of("#ContactMessage"))
                .Visible(false)
                .ShowIndicator(true)
                .ShowPane(true)
                .Shading(true)
                .CloseOnOutsideClick(false)
                .Message("登入中，請稍候…")
                .Delay(600)
                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )
        </div>
    </main>
    <footer class="footer-note" role="contentinfo">Copyright © @DateTime.Now.Year 聖谷行道會</footer>
    <!-- JS Functions -->
    <script>
        function getLoadPanelInstance() { return $("#loadPanel").dxLoadPanel("instance"); }
        function loadPanel_show() { getLoadPanelInstance().show(); }
        function loadPanel_hide() { getLoadPanelInstance().hide(); }
        function Binding() { window.location.href = "/Home/LineLiffView/1653819697-YkPyPkr6"; }
        function Login() { window.location.href = "/Home/Login"; }
    </script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <script>
        window.onload = function () {
            liff.init({ liffId: '@TempData["Proponent"]' })
                .then(() => {
                    if (!liff.isLoggedIn()) {
                        document.getElementById('displaynamefield').innerHTML = "您尚未登入 LINE";
                        ShowToast("您尚未登入 LINE，將為您導向登入…", "error", 4000);
                        liff.login();
                        return;
                    } else {
                        liff.permission.query("profile").then((permissionStatus) => {
                            if (permissionStatus.state === "granted") {
                                initializeApp();
                            } else if (permissionStatus.state === "prompt") {
                                document.getElementById('displaynamefield').innerHTML = "請授權取得基本資料";
                                liff.permission.requestAll();
                            } else {
                                document.getElementById('displaynamefield').innerHTML = "Scope 未授權，無法操作";
                            }
                        });
                    }
                })
                .catch(error => {
                    document.getElementById('displaynamefield').innerHTML = "錯誤: " + error;
                });
        };
        var UserId = ""; var GroupId = ""; var RoomId = ""; var DisplayName = ""; var ViewType = "";
        async function initializeApp() {
            await liff.getProfile()
                .then(function (profile) {
                    document.getElementById('displaynamefield').innerHTML = profile.displayName + " 歡迎回來";
                    loadPanel_show();
                    DisplayName = profile.displayName; UserId = profile.userId; GroupId = profile.aGroupId; RoomId = profile.aRoomId; ViewType = profile.aViewType;
                    UpdateLineUserId(UserId, GroupId, RoomId, ViewType);
                })
                .catch(error => { document.getElementById('displaynamefield').innerHTML = "錯誤:" + error; });
        }
        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType) {
            $.ajax({
                url: '@Url.Action("SaveUserLineId", "Home")',
                data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType },
                type: 'POST',
                success: function (data) {
                    if (data.message != "尚未綁定") {
                        ShowToast(data.message, "success", 1600);
                        if (data.DisplayViewType == "MultiGroupView") {
                            window.location.href = "/Home/MultiGroupView/" + data.ActiveListId;
                        } else if (data.DisplayViewType == "IntegrateView") {
                            window.location.href = "/Home/IntegrateView/" + data.ActiveListId;
                        } else if (data.DisplayViewType == "HappyGroupView") {
                            window.location.href = "/Home/HappyGroup";
                        } else {
                            ShowToast("登入錯誤!", "error", 3000); loadPanel_hide(); document.getElementById('displaynamefield').innerHTML = "登入錯誤";
                        }
                    } else {
                        ShowToast(data.message, "error", 2200); loadPanel_hide(); document.getElementById('displaynamefield').innerHTML = "尚未綁定";
                    }
                },
                error: function () { loadPanel_hide(); window.location.href = "/Home/Login"; }
            });
        }
        function ShowLoadPanel(LocalLoadPanelMessage) { var lp = $("#loadPanel").dxLoadPanel("instance"); lp.option('message', LocalLoadPanelMessage); lp.show(); }
        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }
    </script>
</body>
</html>