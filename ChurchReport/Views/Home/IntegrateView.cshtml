@*
    ===================================================================
    聖谷行道會 - 綜合報表檢視頁面 (IntegrateView)
    功能說明：
    - 支援小組長和個人兩種登入模式
    - 一般小組和幸福小組的不同操作介面
    - 數據圖表展示、日期選擇、上傳功能
    - 新人跟進關懷管理
    最佳化：
    - UTF-8編碼支援
    - 模組化結構
    - 效能優化
    - 中文字型支援
    ===================================================================
*@

@{
    String DataStatus = "上傳成功了!";
    String ReUpload = "請再按一次上傳鈕!";
}

@using ChurchReport.Models
@model ChurchReport.Models.ListSmallGroupWeeklyReport

@* 顯示小組狀態標題 *@
<div class="group-status-header">
    @if (Model.SundayPrayers.Year != 2000)
    {
        <div class="status-title active">
            <h4>@(Model.ListEntityName)</h4>
        </div>
    }
    else
    {
        <div class="status-title inactive">
            <h4>@(Model.ListEntityName + "尚未回報")</h4>
        </div>
    }
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveIntegrate" asp-controller="Home" method="post">
    <div id="all-section" class="main-content-wrapper">

        @* ===== 小組長專用圖表區域 ===== *@
        @if (Model.LoginType == "小組長")
        {
            <div id="smallgroupchart" class="chart-section">
                @( Html.DevExtreme().Chart()
                    .ID("smallgroupchart")
                    .Export(e => e.Enabled(false))
                    .Size( s=>s.Height(220))
                    .CommonSeriesSettings(s => s
                        .ArgumentField("SundayDate")
                        .Type(SeriesType.Spline)
                        .HoverMode(ChartSeriesHoverMode.AllArgumentPoints)
                        .SelectionMode(ChartSeriesSelectionMode.AllArgumentPoints)
                        .Label(l => l
                            .Visible(true)
                            .Format(f => f
                                .Type(Format.FixedPoint)
                                .Precision(0)
                            )
                            .Font(v=>v.Size(10))
                        )
                    )
                    .Series(s => {
                        s.Add().ValueField("SundayNumber").Name("主日人數").Color("#e7d19a");
                        s.Add().ValueField("SmallNumber").Name("小組人數");
                    })
                    .ValueAxis(a => a
                        .Add()
                        .Title(t => t.Text("人數"))
                        .Position(Position.Left)
                    )
                    .Palette(VizPalette.Violet)
                    .Tooltip(t => t.Enabled(true))
                    .Title(t => t
                        .Text("聚會人數")
                        .Font(f => f
                            .Size(12)
                            .Weight(300)
                            .Color("darkblue")
                        )
                        .Margin(m => m
                            .Top(5)
                            .Bottom(5)
                        )
                    )
                    .Legend(l => l
                        .VerticalAlignment(VerticalEdge.Bottom)
                        .HorizontalAlignment(HorizontalAlignment.Center)
                    )
                    .OnPointClick(@<text>
                                function(e) {
                                e.target.select();
                                }
                    </text>)
                    .DataSource(d => d
                    .WebApi()
                    .Controller("Home")
                    .LoadAction("GetChartDataList")
                    .Key("WeeklyReportEntityId")
                    .LoadParams(new { WeeklyReportId = @ViewBag.ListId })
                    )
                )
            </div>
        }

        @* ===== 週期時間顯示 ===== *@
        <div class="period-display">
            @Model.SundayPeriod
        </div>

        @* ===== 日期選擇和上傳按鈕區域 ===== *@
        <div class="control-panel">
            <div class="control-wrapper">
                @* 日期選擇區 *@
                <div class="date-section">
                    <label class="date-label">小組日期</label>
                    <div class="date-input">
                        @(Html.DevExtreme()
                            .DateBoxFor(m => m.SundayPrayers)
                            .Type(DateBoxType.Date)
                            .Value(Model.SundayPrayers)
                            .Width(200)
                            .DisplayFormat("yyyy/M/d")
                            .OnChange("OnDateboxChange")
                            .CalendarOptions(k => k.FirstDayOfWeek(0))
                            .OnValueChanged(@<text>
                                function(arg) {
                                    $("#loadPanel").dxLoadPanel("instance").show();
                                    
                                    $.ajax({
                                        url: '@Url.Action("UpdateIntegrateDate", "Home")',
                                        data: { SelectedDate: getODataLocalDateFilter(arg.value) },
                                        type: 'GET',
                                        success: function (response) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                            window.location.href = "/Home/IntegrateView/" + response.ActiveListId;
                                        },
                                        error: function (xhr, status, error) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                            ShowToast("日期更新失敗: " + error, "error", 5000);
                                        }
                                    });
                                }
                            </text>)
                        )
                    </div>
                </div>

                @* ===== 上傳按鈕區域 ===== *@
                <div class="upload-section">
                    @if (Model.LoginType == "小組長")
                    {
                        @if (Model.GroupType == "一般小組")
                        {
                            @* 一般小組上傳按鈕 *@
                            <div class="upload-button-container">
                                @(Html.DevExtreme().Button()
                                    .Text("上傳").Height(50).Width(80).Icon("check")
                                    .Type(ButtonType.Success)
                                    .ID("save-button")
                                    .UseSubmitBehavior(false)
                                    .OnClick(@<text>
                                        function(arg) {
                                            var SmallGroupDataGrid = $("#SmallGroupgridContainer").dxDataGrid("instance");
                                            var NewPersonDataGrid = $("#NewPersonGridContainer").dxDataGrid("instance");
                                            var ButtonContainer = $("#save-button").dxButton("instance");

                                            $("#SmallGroupgridContainer").dxDataGrid("instance").saveEditData();
                                            $("#NewPersonGridContainer").dxDataGrid("instance").saveEditData();

                                            $("#loadPanel").dxLoadPanel("instance").show();
                                            ButtonContainer.option("disabled", true);

                                            $.ajax({
                                                url: '@Url.Action("SaveIntegrate", "Home")',
                                                data: {
                                                    WeeklyReportData: $("#WeeklyReportTextData").dxTextArea("instance").option('text'),
                                                    CheckBox: $("#CheckBoxId").dxCheckBox("instance").option("value")
                                                },
                                                type: 'POST',
                                                success: function (response) {
                                                    SmallGroupDataGrid.refresh();
                                                    NewPersonDataGrid.refresh();
                                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                                    ButtonContainer.option("disabled", false);

                                                    if (response.status == 1) {
                                                        ShowToast(response.message, "success", 2000);
                                                    } else {
                                                        ShowToast(response.message, "error", 5000);
                                                    }
                                                },
                                                error: function (xhr, status, error) {
                                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                                    ButtonContainer.option("disabled", false);
                                                    ShowToast("上傳失敗: " + error, "error", 5000);
                                                }
                                            });
                                        }
                                    </text>)
                                )
                            </div>
                        }
                        else
                        {
                            @* 幸福小組上傳按鈕 *@
                            <div class="upload-button-container">
                                @(Html.DevExtreme().Button()
                                    .Text("上傳").Height(50).Width(80).Icon("check")
                                    .Type(ButtonType.Success)
                                    .ID("save-button")
                                    .UseSubmitBehavior(false)
                                    .OnClick(@<text>
                                        function(arg) {
                                            var HappyGroupDataGrid = $("#HappyGroupGridContainer").dxDataGrid("instance");
                                            var ButtonContainer = $("#save-button").dxButton("instance");

                                            $("#HappyGroupGridContainer").dxDataGrid("instance").saveEditData();

                                            $("#loadPanel").dxLoadPanel("instance").show();
                                            ButtonContainer.option("disabled", true);

                                            $.ajax({
                                                url: '@Url.Action("SaveIntegrate", "Home")',
                                                data: {
                                                    WeeklyReportData: $("#WeeklyReportTextData").dxTextArea("instance").option('text'),
                                                    HappyWeekIndex: $("#HappyWeekIndex").dxSelectBox("instance").option('text'),
                                                    HappyWeekTopic: $("#HappyWeekTopic").dxSelectBox("instance").option('text')
                                                },
                                                type: 'POST',
                                                success: function (response) {
                                                    HappyGroupDataGrid.refresh();
                                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                                    ButtonContainer.option("disabled", false);

                                                    if (response.status == 1) {
                                                        ShowToast(response.message, "success", 2000);
                                                    } else {
                                                        ShowToast(response.message, "error", 5000);
                                                    }
                                                },
                                                error: function (xhr, status, error) {
                                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                                    ButtonContainer.option("disabled", false);
                                                    ShowToast("上傳失敗: " + error, "error", 5000);
                                                }
                                            });
                                        }
                                    </text>)
                                )
                            </div>
                        }
                    }
                    else
                    {
                        @* 個人報告上傳按鈕 *@
                        <div class="upload-button-container">
                            @(Html.DevExtreme().Button()
                                .Text("上傳").Height(50).Width(80).Icon("check")
                                .Type(ButtonType.Success)
                                .ID("save-button")
                                .UseSubmitBehavior(false)
                                .OnClick(@<text>
                                    function(arg) {
                                        var IndividualGrid = $("#IndividualGridContainer").dxDataGrid("instance");
                                        var ButtonContainer = $("#save-button").dxButton("instance");

                                        $("#IndividualGridContainer").dxDataGrid("instance").saveEditData();

                                        $("#loadPanel").dxLoadPanel("instance").show();
                                        ButtonContainer.option("disabled", true);

                                        $.ajax({
                                            url: '@Url.Action("SavePersonReport", "Home")',
                                            data: { WeeklyReportData: "" },
                                            type: 'POST',
                                            success: function (response) {
                                                $("#loadPanel").dxLoadPanel("instance").hide();
                                                ButtonContainer.option("disabled", false);

                                                if (response.status == 1) {
                                                    ShowToast(response.message, "success", 2000);
                                                } else {
                                                    ShowToast(response.message, "error", 5000);
                                                }
                                            },
                                            error: function (xhr, status, error) {
                                                $("#loadPanel").dxLoadPanel("instance").hide();
                                                ButtonContainer.option("disabled", false);
                                                ShowToast("上傳失敗: " + error, "error", 5000);
                                            }
                                        });
                                    }
                                </text>)
                            )
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ===== Toast 通知元件區域 ===== *@
        <div class="toast-components">
            @(Html.DevExtreme().Toast()
                .ID("Toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                .CloseOnOutsideClick(true)
                .DisplayTime(2000)
                .MaxWidth(300)
            )
            @(Html.DevExtreme().Toast()
                .ID("ToastReUpload")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                .Message(ReUpload)
                .DisplayTime(5000)
                .Type(ToastType.Error)
                .MaxWidth(500)
            )
            @(Html.DevExtreme().Toast()
                .ID("SelectDateToast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                .Message("日期格式錯誤，格式範例: 2018/6/5")
                .DisplayTime(5000)
                .Type(ToastType.Error)
                .MaxWidth(300)
            )
        </div>

        @* ===== 載入面板元件 ===== *@
        <div class="load-panel-component">
            @(Html.DevExtreme().LoadPanel()
                .ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.4)")
                .Position(p => p.Of("#all-section"))
                .Visible(false)
                .ShowIndicator(true)
                .ShowPane(true)
                .Shading(true)
                .CloseOnOutsideClick(false)
                .Message("更新資料中...")
                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )
        </div>

        @* ===== 幸福小組週次主題選擇區 ===== *@
        @if (Model.GroupType == "幸福小組")
        {
            <div class="happy-group-selection">
                <div class="section-title">
                    <h5>幸福小組週次及主題:</h5>
                </div>
                <div class="selection-wrapper">
                    <div class="week-index-selector">
                        @(Html.DevExtreme().SelectBox()
                            .ID("HappyWeekIndex")
                            .Value(Model.HappyWeekIndex)
                            .DataSource(new string[] {
                                "第一週", "第二週", "第三週", "第四週", "第五週",
                                "第六週", "第七週", "第八週", "第九週", "第十週"
                            })
                            .Width(150)
                            .OnValueChanged(@<text>
                                function(arg) {
                                    $("#loadPanel").dxLoadPanel("instance").show();
                                    $.ajax({
                                        url: '@Url.Action("UpdateHappyWeekIndex", "Home")',
                                        data: { HappyWeekIndex: arg.value },
                                        type: 'GET',
                                        success: function (response) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                        },
                                        error: function (xhr, status, error) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                            ShowToast("更新失敗: " + error, "error", 5000);
                                        }
                                    });
                                }
                            </text>)
                        )
                    </div>
                    <div class="topic-selector">
                        @(Html.DevExtreme().SelectBox()
                            .ID("HappyWeekTopic")
                            .Value(Model.HappyWeekTopic)
                            .DataSource(new string[] {
                                "", "預備週", "真幸福", "真相大白", "萬世巨星",
                                "幸福連線", "當上帝來敲門", "十字架的勝利", "釋放與自由", "幸福的教會"
                            })
                            .Width(150)
                            .OnValueChanged(@<text>
                                function(arg) {
                                    $("#loadPanel").dxLoadPanel("instance").show();
                                    $.ajax({
                                        url: '@Url.Action("UpdateHappyWeekTopic", "Home")',
                                        data: { HappyWeekTopic: arg.value },
                                        type: 'GET',
                                        success: function (response) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                        },
                                        error: function (xhr, status, error) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                            ShowToast("更新失敗: " + error, "error", 5000);
                                        }
                                    });
                                }
                            </text>)
                        )
                    </div>
                </div>
            </div>
        }

        @* ===== 資料網格區域 ===== *@
        <div class="data-grid-section">
            @if (Model.LoginType == "小組長")
            {
                @if (Model.GroupType == "一般小組")
                {
                    @* 一般小組網格 *@
                    @Html.Partial("_GeneralGroupGrids", Model)
                }
                else
                {
                    @* 幸福小組網格 *@
                    @Html.Partial("_HappyGroupGrid", Model)
                }
            }
            else
            {
                @* 個人回報網格 *@
                @Html.Partial("_IndividualReportGrid", Model)
            }
        </div>

        @* ===== 小組日誌區域 (僅小組長可見) ===== *@
        @if (Model.LoginType == "小組長")
        {
            <div class="journal-section">
                <div class="section-title">
                    <h5>小組日誌:</h5>
                </div>
                @(Html.DevExtreme().TextArea()
                    .ID("WeeklyReportTextData")
                    .Value(Model.WeeklyReportData)
                    .Height(200)
                )
                
                <div class="section-title">
                    <h5>小組出席紀錄:</h5>
                </div>
                @(Html.DevExtreme().TextArea()
                    .ID("WeeklyReportTextAnalysis")
                    .Value(Model.WeeklyReportAnalysis)
                    .Height(350)
                    .Disabled(true)
                )
            </div>
        }

    </div>
</form>

@* ===== JavaScript 函式區域 ===== *@
<script>
    // ===== DevExtreme DataGrid 相關函式 =====
    
    // 將編輯欄移到左側
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }
    
    // 自定義編輯按鈕圖標
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            } else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }

    // ===== 日期處理相關函式 =====
    
    // 日期格式驗證
    function OnDateboxChange(e) {
        if (e.component._$validationMessage == null) {
            UploadDateFormat = "格式正確";
        }
        else {
            UploadDateFormat = "格式錯誤";
            $("#SelectDateToast").dxToast("instance").show();
            return;
        }
    }

    // 日期過濾器
    function getODataLocalDateFilter(date) {
        if (date == null) {
            date = new Date();
        }

        var monthString;
        var rawMonth = (date.getMonth() + 1).toString();
        monthString = rawMonth.length == 1 ? "0" + rawMonth : rawMonth;

        var dateString;
        var rawDate = date.getDate().toString();
        dateString = rawDate.length == 1 ? "0" + rawDate : rawDate;

        return date.getFullYear() + "/" + rawMonth + "/" + rawDate;
    }

    // ===== 載入面板相關函式 =====
    
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }

    function button_click() {
        getLoadPanelInstance().show();
    }

    function loadPanel_shown(e) {
        // 可在此處添加載入面板顯示後的處理邏輯
    }

    function loadPanel_hidden() {
        // 可在此處添加載入面板隱藏後的處理邏輯
    }

    // ===== AJAX 相關函式 =====
    
    function SaveIntegrateWeeklyReport(arg) {
        getLoadPanelInstance().show();
    }

    // AJAX 開始事件處理
    function onBegin() {
        // 可在此處添加 AJAX 開始前的處理邏輯
    }

    // AJAX 成功事件處理
    function onSuccess(data) {
        getLoadPanelInstance().hide();

        if (data.status == 1) {
            DevExpress.ui.notify(data.message, "success", 2000);
        }
        else {
            DevExpress.ui.notify(data.message, "error", 5000);
        }
    }

    // AJAX 完成事件處理
    function onComplete(data) {
        // 可在此處添加 AJAX 完成後的處理邏輯
    }

    // ===== 通用工具函式 =====
    
    // 顯示 Toast 訊息
    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        var ToastInstance = $("#Toast").dxToast("instance");
        ToastInstance.option('message', LocalToastMessage);
        ToastInstance.option('type', Type);
        ToastInstance.option('displayTime', DisplayTime);
        ToastInstance.option('white-space', 'pre-line');
        ToastInstance.option('closeOnClick', true);
        ToastInstance.show();
    }

    // 選擇項目變更事件處理
    function OnRowSelectionChanged(selectedItems) {
        // 可在此處添加行選擇變更的處理邏輯
    }

    // 編輯器準備事件處理
    function OnEditorPrepared(options) {
        // 可在此處添加編輯器準備的處理邏輯
    }


</script>

