@* ===== DevExpress 本地化設定 ===== *@
<script>
    // 全域變數設定
    var DataUploadStatus = "尚未上傳喔!";
    var UploadDateFormat = "格式正確!";

    // DevExtreme 本地化字典
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容",
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date"
        },
    };
    
    DevExpress.localization.loadMessages(dictionary);
    var formatMessage = DevExpress.localization.formatMessage;

    var locale = getLocale();
    DevExpress.localization.locale(locale);

    function changeLocale(data) {
        setLocale(data.value);
        document.location.reload();
    }

    function getLocale() {
        sessionStorage.setItem("locale", 'zh-tw');
        var locale = sessionStorage.getItem("locale");
        return locale != null ? locale : "tw";
    }
</script>

@* ===== 樣式定義 ===== *@
<style>
    /* 狀態標題樣式 */
    .group-status-header {
        margin-bottom: 20px;
    }
    
    .status-title {
        padding: 10px;
        border-radius: 5px;
        text-align: center;
    }
    
    .status-title.active {
        color: cadetblue;
        font-weight: bold;
    }
    
    .status-title.inactive {
        color: cadetblue;
        background-color: powderblue;
        font-weight: bold;
    }

    /* 主要內容區域 */
    .main-content-wrapper {
        height: 100%;
        width: 100%;
        overflow: hidden;
    }

    /* 圖表區域 */
    .chart-section {
        margin-bottom: 20px;
    }

    /* 週期顯示樣式 */
    .period-display {
        font-size: 100%;
        color: crimson;
        text-align: left;
        background-color: powderblue;
        font-weight: bold;
        padding: 10px;
        margin: 10px 0;
        border-radius: 3px;
    }

    /* 控制面板樣式 */
    .control-panel {
        margin: 20px 0;
        padding: 15px;
        background: #f9f9f9;
        border-radius: 5px;
    }
    
    .control-wrapper {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    /* 日期選擇區域 */
    .date-section {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }
    
    .date-label {
        font-size: 100%;
        color: darkslateblue;
        font-weight: bold;
        white-space: nowrap;
        min-width: 80px;
    }
    
    .date-input {
        min-width: 200px;
    }

    /* 上傳按鈕區域 */
    .upload-section {
        flex: 0 0 auto;
    }

    .upload-button-container {
        text-align: center;
    }

    /* 幸福小組選擇區域 */
    .happy-group-selection {
        margin: 20px 0;
        padding: 15px;
        background: #f0f8ff;
        border-radius: 5px;
    }

    .selection-wrapper {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .week-index-selector,
    .topic-selector {
        flex: 1;
