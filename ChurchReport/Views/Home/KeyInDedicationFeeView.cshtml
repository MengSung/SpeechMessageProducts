                   );

        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )
    </div>
    <div id="buttonContainer3" class="dx-button-icon">
        @(Html.DevExtreme().Button()
                    .Text("上傳")
                    .Type(ButtonType.Success)
                    .ID("save-button3")
                    .UseSubmitBehavior(true)
                    .OnClick("OnClickUpdate")
            )
    </div>
</form>

<div id="samenamecontainer" style="font-family:標楷體;font-size:100%; color: darkslateblue; text-align:left;font-weight:bold">
    <h5 id="resultfield"></h5>


    <script>
        window.onload = function (e) {
            $("#form1").dxForm("instance").updateData('DedicationNumber', "");
            $("#form1").dxForm("instance").updateData('NationId', "");
            $("#form1").dxForm("instance").updateData('FullName', "");
            $("#form1").dxForm("instance").updateData('Mobile', "");
            $("#form2").dxForm("instance").updateData('Amount', "");
            $("#form1").dxForm("instance").getEditor('DedicationNumber').focus();

            document.getElementById("samenamecontainer").style.display = "none";//隱藏
        };

    </script>
    <script>
        // 觸發事件管理
        function OnClickQuery(arg) {
            //alert("查詢");
            $("#form2").dxForm("instance").getEditor("ClickType").option("value", '查詢');
            getLoadPanelInstance().show();
        }
        function OnClickUpdate(arg) {
            //alert("上傳");
            $("#form2").dxForm("instance").getEditor("ClickType").option("value", '上傳');
            getLoadPanelInstance().show();
        }
        function OnRowClick(selectedItems) {
            //alert("選了同名同姓");
            var data = selectedItems.selectedRowsData[0];
            if (data) {
                //alert("姓名:" + data.FullName + "，電話" + data.Mobile);
                $("#form1").dxForm("instance").updateData('DedicationNumber', data.DedicationNumber);
                $("#form1").dxForm("instance").updateData('NationId', data.NationId);
                $("#form1").dxForm("instance").updateData('FullName', data.FullName);
                $("#form1").dxForm("instance").updateData('Mobile', data.Mobile);
            }
        }
        function OnRowSelectionChanged(selectedItems) {
            //alert("更換同名同姓");
            var data = selectedItems.selectedRowsData[0];
            if (data) {
                //alert("姓名:" + data.FullName + "，電話" + data.Mobile);
                $("#form1").dxForm("instance").updateData('DedicationNumber', data.DedicationNumber);
                $("#form1").dxForm("instance").updateData('NationId', data.NationId);
                $("#form1").dxForm("instance").updateData('FullName', data.FullName);
                $("#form1").dxForm("instance").updateData('Mobile', data.Mobile);
            }
        }
    </script>
    <script>
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }
        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

        var GlobalCategory = "";

        function OnCategorySelectBoxValueChanged(e) {
            if (e.value == "其他") {
                $("#form2").dxForm("instance").itemOption("OtherDedication", 'visible', true);
            }
            else {
                $("#form2").dxForm("instance").itemOption("OtherDedication", 'visible', false);
            }
        }
        function moveEditColumnToLeft(dataGrid) {
            dataGrid.columnOption("command:edit", {
                visibleIndex: -1,
                width: 50
            });
        }
        function cell_prepared(e) {
            if (e.rowType === "data" && e.column.command === "edit") {
                var isEditing = e.row.isEditing,
                    $links = e.cellElement.find(".dx-link");

                $links.text("");

                if (isEditing) {
                    $links.filter(".dx-link-save").addClass("dx-icon-save");
                    $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
                }
                else {
                    $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                    $links.filter(".dx-link-delete").addClass("dx-icon-trash");
                }
            }

        }
    </script>
    <script type="text/javascript">
        function onBegin() {
        }

        function onSuccess(data) {

            getLoadPanelInstance().hide();

            if (data.status == 1) {
                if (data.clicktype == "上傳") {
                    // 按上傳
                    //ShowToast(data.message, "success", 2000);
                    $("#form1").dxForm("instance").updateData('DedicationNumber', "");
                    $("#form1").dxForm("instance").updateData('NationId', "");
                    $("#form1").dxForm("instance").updateData('FullName', "");
                    $("#form1").dxForm("instance").updateData('Mobile', "");
                    $("#form2").dxForm("instance").updateData('Amount', "");
                    $("#form1").dxForm("instance").getEditor('DedicationNumber').focus();
                    document.getElementById("samenamecontainer").style.display = "none";//隱藏

                    document.getElementById('resultfield').innerHTML = data.DedicationResult;
                }
                else {
                    // 按查詢
                    //return Json(new { status = "1", clicktype = "查詢", DedicationNumber = m_QpayModel.DedicationNumber, FullName = m_QpayModel.FullName, Mobile = m_QpayModel.Mobile, message = DedicationResult, DedicationResult = DedicationResult });
                    //debugger;

                    $("#form1").dxForm("instance").updateData('DedicationNumber', data.DedicationNumber);
                    $("#form1").dxForm("instance").updateData('NationId', data.NationId);
                    $("#form1").dxForm("instance").updateData('FullName', data.FullName);
                    $("#form1").dxForm("instance").updateData('Mobile', data.Mobile);

                    //$("#form1").dxForm("instance").getEditor('SameNameList').reload();
                    //$("#form1").dxForm("instance").getEditor('SameNameList').refresh();

                    document.getElementById("samenamecontainer").style.display = "none";//隱藏
                    //document.getElementById("samenamecontainer").style.display = "";//顯示
                    //document.getElementById("samenamefield").style.display = "none";//隱藏
                    //document.getElementById("samenamefield").style.display = "";//顯示

                    //$("#SameNameList").dxDataGrid("instance").reload();
                    //$("#SameNameList").dxDataGrid("instance").refresh();

                    //window.location.href = "/Home/KeyInDedicationFeeViewWeb/";
                }
            }
            else if (data.status == 2) {
                $("#form1").dxForm("instance").updateData('DedicationNumber', "");
                $("#form1").dxForm("instance").updateData('NationId', "");
                $("#form1").dxForm("instance").updateData('FullName', "");
                $("#form1").dxForm("instance").updateData('Mobile', "");
                $("#form2").dxForm("instance").updateData('Amount', "");
                $("#form1").dxForm("instance").getEditor('DedicationNumber').focus();

                //document.getElementById("samenamecontainer").style.display = "none";//隱藏
                document.getElementById("samenamecontainer").style.display = "";//顯示

                $("#SameNameList").dxDataGrid("instance").refresh();
            }
            else {
                ShowToast(data.message, "error", 3000);

                document.getElementById('resultfield').innerHTML = "<br/>" + data.DedicationResult;

            }
        }

        function onComplete(data) {
            if (data.status == 1) {
            }
            else {
            }
        }
    </script>
    <script>
        //中文化
        var dictionary = {
            "zh-tw": {
                "dxScheduler-switcherAgenda": "會議內容", // 在這裡可以做最後的字典對應
                "Month": "月",
                "Subject": "主題",
                "Company": "Company",
                "Amount": "Amount",
                "PaymentDate": "Payment Date",
                "dxDataGrid-editingConfirmDeleteMessage": "您確定要刪除這個連絡人嗎?",
            },
        };
        DevExpress.localization.loadMessages(dictionary);
        var formatMessage = DevExpress.localization.formatMessage;

        var locale = getLocale();
        //DevExpress.localization.locale(navigator.language || navigator.browserLanguage);
        DevExpress.localization.locale(locale);

        function changeLocale(data) {
            setLocale(data.value);
            document.location.reload();
        }

        function getLocale() {
            //debugger;
            //sessionStorage.setItem("locale", 'zh');
            sessionStorage.setItem("locale", 'zh-tw');
            var locale = sessionStorage.getItem("locale");
            return locale != null ? locale : "tw";
        }
    </script>

