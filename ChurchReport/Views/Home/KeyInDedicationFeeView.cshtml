@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h5 id="displaynamefield">行政人員奉獻管理</h5>
</div>

<div class="dx-field">
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

    </div>
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

    </div>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveKeyInDedication" asp-controller="Home" method="post">
    <div id="form-container-query">
        @(Html.DevExtreme().Form<QpayModel>()
     .ID("form1")
     .ColCount(1)
     .Items(items =>
     {
         items.AddSimpleFor(m => m.DedicationDate)
               //.DataField("LastName")
               .Label(l => l.Text("奉獻日期"))
               .Editor(e => e
                   .DateBox()
                   .Width(135)
                   .Disabled(false)
                   .DisplayFormat("yyyy/M/d")
                   .Placeholder("輸入奉獻日期")
                   .FocusStateEnabled(true)
              );

         items.AddSimpleFor(m => m.DedicationNumber)
                //.DataField("LastName")
                .Label(l => l.Text("奉獻編號"))
                .Editor(e => e
                    .TextBox()
                    .Width(100)
                    .Disabled(false)
                    .Placeholder("輸入奉獻編號")
                    .FocusStateEnabled(true)
               );

         items.AddSimpleFor(m => m.NationId)
                //.DataField("LastName")
                .Label(l => l.Text("身分證字號"))
                .Editor(e => e
                    .TextBox()
                    .Width(100)
                    .Disabled(false)
                    .Placeholder("輸入身分證字號")
                    .FocusStateEnabled(true)
               );


         items.AddSimpleFor(m=>m.FullName)
            //.DataField("LastName")
            .Label(l => l.Text("姓名"))
            .Editor(e => e
                .TextBox()
                .Width(100)
                .Disabled(false)
                .Placeholder("輸入姓名")
           );

         items.AddSimpleFor(m=>m.Mobile)
                .Label(l => l.Text("電話號碼"))
                .Editor(e => e
                    .TextBox()
                    .Width(100)
                    //.Mask("(X000) 000-000")
                    .MaskRules(new { X = new JS("/[02-9]/") })
                    .Placeholder("輸入電話號碼")
                );


     })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
                $("#form1").dxForm("instance").getEditor('DedicationNumber').focus();
            }
        </text>)

        .FormData(Model)
        )
    </div>

    <div id="samenamecontainer" style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="samenamefield">查詢結果</h5>

        @(Html.DevExtreme().DataGrid<SameNameElement>()
                            .ID("SameNameList")
                            .ShowBorders(true)
                            //.ColumnAutoWidth(true)
                            //.Paging(p => p.PageSize(10))
                            .Paging(paging => paging.Enabled(false))
                            .AllowColumnResizing(true)
                            .ColumnResizingMode(ColumnResizingMode.Widget)
                            .ColumnFixing(c => c.Enabled(true))
                            .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                            //.SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
                            //.Export(e=>e.Enabled(false).AllowExportSelectedData(true))
                            .ShowColumnLines(true)
                            .ShowRowLines(true)
                            //.RowAlternationEnabled(true)
                            .ShowBorders(true)
                            //.RemoteOperations(false)
                            //.TwoWayBindingEnabled(true)
                            .Selection(selection => selection.Mode(SelectionMode.Single))
                            //.Selection(selection => selection.Mode(SelectionMode.Multiple))
                            //.Selection(selection => selection.Mode(SelectionMode.None))
                            .OnRowClick("OnRowClick")
                            .OnSelectionChanged("OnRowSelectionChanged")
                            .HoverStateEnabled(true)
                            //.OnContentReady("onCreditCardGridContentReady")
                            .Editing(editing =>
                            {
                                //editing.Mode(GridEditMode.Batch);
                                //editing.Mode(GridEditMode.Row);
                                //editing.Mode(GridEditMode.Cell);
                                //editing.Mode(GridEditMode.Batch);
                                //editing.Mode(GridEditMode.Form);
                                //editing.Mode(GridEditMode.Popup);
                                //editing.AllowUpdating(true);
                                //editing.AllowAdding(true);
                                editing.AllowDeleting(true);
                                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("選擇").DeleteRow("刪除"));
                            })

                            .Columns(columns =>
                            {
                                columns.AddFor(m => m.DedicationNumber).Caption("奉獻編號").Width(100).MinWidth(100).Fixed(true);
                                columns.AddFor(m => m.NationId).Caption("身分證字號").Width(100).MinWidth(100).Fixed(true);
                                columns.AddFor(m => m.FullName).Caption("姓名").Width(100).MinWidth(100).Fixed(true);
                                columns.AddFor(m => m.Mobile).Caption("電話").Width(100).MinWidth(100);
                            })
                            .DataSource(d => d
                            .WebApi()
                            .Controller("Home")
                            .LoadAction("LoadSameNameList")
                            //.InsertAction("InsertPresentRecord")
                            .DeleteAction("DeleteSameNameContact")
                            //.UpdateAction("UpdatePresentRecord")
                            .Key("SameNameElementId")
                            //.LoadParams(new { id = @ViewBag.ListId }))
                            )

                            //.OnContentReady("onCreditCardGridContentReady")
