                            // 此處設定是讓選項偏左邊一排
                            .OnContentReady(
                            @<text>
                                function(e)
                                {
                                    //moveEditColumnToLeft(e.component);
                                    //ShowToast( ReMindMessage , 'warning' , 20000)
                                    @*$("#loadPanel").dxLoadPanel("instance").hide();*@
                                }
                            </text>
                            )
                            //此處設定是鉛筆形狀還是"編輯"字樣
                            .OnCellPrepared("cell_prepared")
                            //.OnCellPrepared("cell_prepared_background_color")
                            )
    </div>
    <div id="buttonContainer2" class="dx-button-icon">
        @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Type(ButtonType.Success)
                    .ID("save-button2")
                    .UseSubmitBehavior(true)
                    .OnClick("OnClickQuery")
            )
    </div>
    <div id="form-container-upload">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form2")
        .ColCount(1)
        .Items(items =>
        {

            items.AddSimpleFor
            (m => m.Category)
                .Label(l => l.Text("類別"))
                //.Name("Category")
                .Editor
                (
                    e => e
                    .SelectBox()
                    .Width(100)
                    .DataSource(new string[]
                    {
                       "十一",
                       "宣教",
                    }
                //.DisplayExpr("Name")
                )
                .Placeholder("請選擇奉獻類別")
                //.Value(Model.Category)
                .OnValueChanged("OnCategorySelectBoxValueChanged")
            );

            //items.AddSimpleFor
            //(m => m.Others)
            //    .Label(l => l.Text("其他"))
            //    .Visible(false)
            //    .Name("OtherDedication")
            //    .Editor
            //    (
            //        e => e
            //        .SelectBox()
            //        .Width(100)
            //        .DataSource(Model.OtherCategoryArray)
            //        .Placeholder("請選擇奉獻類別")
            //        //.Value("特別")
            //    );

            items.AddSimpleFor
                (m => m.Others)
                    .Label(l => l.Text("其他"))
                    .Visible(false)
                    .Name("OtherDedication")
                    .Editor
                    (
                        e => e
                        .Autocomplete()
                        .Width(100)
                        .DataSource(Model.OtherCategoryArray)
                        .Placeholder("請選擇奉獻類別")
                    //.Value("特別")
                    );

            items.AddSimpleFor(m => m.Amount)
                    //.DataField("LastName")
                    .Label(l => l.Text("奉獻金額"))
                    .Editor(e => e
                        .NumberBox().Value(null)
                        .Width(100)
                        .Disabled(false)
                        .Placeholder("輸入奉獻金額")
                    );

            items.AddSimpleFor
                    (m => m.PayWay)
                        .Label(l => l.Text("付款方式"))
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .Width(100)
                            .DataSource(new string[]
                            {
                                           "現金",
                                           "信用卡",
                                           "ATM轉帳/匯款",
                            }
                        //.DisplayExpr("Name")
                        )
                        .Value("現金")
