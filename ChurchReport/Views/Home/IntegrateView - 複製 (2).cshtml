<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveIntegrate" asp-controller="Home" method="post">

    <div class="dx-field">
        <div id="buttonContainer" class="dx-button-icon" style="float: left; width:30%; text-align: left; background-color:white;">
            @(Html.DevExtreme().Button()
            .Text("上傳")
            .Type(ButtonType.Success)
            .ID("save-button")
            //.UseSubmitBehavior(true)
            .UseSubmitBehavior(true)
            //.ValidationGroup()
            //.Width(60)

            .OnClick("SaveIntegrateWeeklyReport")

            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
            .ID("toast")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message(DataStatus)
            .DisplayTime(2000)
            .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
            .ID("loadPanel")
            .ShadingColor("rgba(0,0,0,0.4)")
            //.Position(p => p.Of("#data-grid").Of("#buttonContainer"))
            .Position(p => p.Of("#smallgroupchart").Of("#smallgroup-grid").Of("#newpersonal-data-grid").Of("#form-container").Of("#smallgroup-grid"))
            .Visible(false)
            .ShowIndicator(true)
            .ShowPane(true)
            .Shading(true)
            .CloseOnOutsideClick(false)
            .Message("更新資料中...")
            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            //.OnShown("loadPanel_shown")
            //.OnHidden("loadPanel_hidden")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
            .ID("ToastReUpload")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message(ReUpload)
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(500)
            )
        </div>
    </div>

    <div id="form-container">
        @(Html.DevExtreme().Form()
        .ID("form")
        .LabelLocation(FormLabelLocation.Top)
        .ColCount(1)
        .Items(items =>
        {
            items.AddSimple()
            .ColSpan(2)
            //.Label(l => l.Text("小組日誌001").Visible(true))
            .Label(l => l.Text("小組日誌").Visible(true))
            .DataField("WeeklyReportData")
            .Editor(e => e
            .TextArea()
            .Placeholder("請輸入小組日誌，離開或是切換網頁前記得按上傳鈕")
            .Height(250)
            );
            items.AddSimple()
            .ColSpan(2)
            .Label(l => l.Text("小組出席紀錄").Visible(true))
            .DataField("WeeklyReportAnalysis")
            .Editor(e => e
            .TextArea()
            .ReadOnly(true)
            .Disabled(false)
            .Height(350)
            );

        })
        .OnContentReady(@<text>
                    function(e)
                    {
                    e.component.validate();
                    }
        </text>)
.FormData(Model)
        )
    </div>
</form>





<script>
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }

    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            } else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }
