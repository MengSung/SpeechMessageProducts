            .CurrentView(SchedulerViewType.Month)
            .CurrentDate(new DateTime(2015, 5, 25))
            .TextExpr("Text")
            .StartDayHour(8)
            .EndDayHour(19)
            .CrossScrollingEnabled(true)
            .StartDateExpr("StartDate")
            .EndDateExpr("EndDate")
            .AllDayExpr("AllDay")
