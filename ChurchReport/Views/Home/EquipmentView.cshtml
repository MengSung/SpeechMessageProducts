@using ChurchReport.Models

@model ChurchReport.Models.EquipmenSmallGroup

@{
    // 頁面標題和基本資訊
    ViewBag.Title = "聖谷行道會 - 裝備狀態";
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <!-- 頁面基本資訊 -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="聖谷行道會裝備狀態管理頁面">
    <title>@ViewBag.Title</title>

    <!-- Bootstrap 和 DevExtreme CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <!-- jQuery 和 Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <!-- DevExtreme 全球化腳本 -->
    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>
    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    <!-- DevExtreme 核心腳本 -->
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
</head>

<body class="bg-light">
    <div class="container-fluid py-4">
        <!-- 頁面標題 -->
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="text-primary font-weight-bold" style="font-family: 標楷體; color: cadetblue;">
                    裝備狀態管理
                </h2>
                <p class="text-muted">查看和管理各小組的裝備狀態資訊</p>
            </div>
        </div>

        <!-- DataGrid 容器 -->
        <div class="row">
            <div class="col-12">
                <div id="data-grid" class="shadow-sm">
                    @(Html.DevExtreme().DataGrid<EquipmenSmallGroup>()
                        .ID("EquipmentGridContainer")
                        // 分組設定：自動展開所有分組
                        .Grouping(g => g.AutoExpandAll(true))
                        // 禁用欄位調整大小
                        .AllowColumnResizing(false)
                        // 欄位寬度設定：不自動調整寬度，最小寬度80px
                        .ColumnAutoWidth(false)
                        .ColumnMinWidth(80)
                        // 無資料時顯示的文字
                        .NoDataText("沒有資料")
                        // 顯示邊框、行線和欄線
                        .ShowBorders(true)
                        .ShowRowLines(true)
                        .ShowColumnLines(true)
                        // 排序設定：允許多欄位排序並顯示排序索引
                        .Sorting(sorting => sorting.Mode(GridSortingMode.Multiple).ShowSortIndexes(true))
                        // 行準備事件：用於自訂行樣式
                        .OnRowPrepared("OnRowPrepared")
                        // 資料來源：從 Home 控制器的 LoadEquipmentList 動作載入資料
                        .DataSource(d => d
                            .WebApi()
                            .Controller("Home")
                            .LoadAction("LoadEquipmentList")
                            .Key("SmallGroupListEntityId")
                        )
                        // 編輯設定：使用單元格編輯模式
                        .Editing(editing =>
                        {
                            editing.Mode(GridEditMode.Cell);
                            // 自訂編輯按鈕文字
                            editing.Texts(a => a
                                .SaveAllChanges("上傳檔案")
                                .AddRow("新增")
                                .CancelAllChanges("取消變更")
                                .SaveRowChanges("確定")
                                .CancelRowChanges("取消")
                                .EditRow("編輯")
                                .DeleteRow("刪除")
                                .ConfirmDeleteTitle("確定要刪除嗎?")
                                .ConfirmDeleteMessage("刪除幸福小組週報")
                            );
                        })
                        // 內容準備事件：移動編輯欄位到最左側
                        .OnContentReady(
                            @<text>
                                function(e) {
                                    moveEditColumnToLeft(e.component);
                                }
                            </text>
                        )
                        // 欄位定義
                        .Columns(columns =>
                        {
                            // 小組名稱欄位
                            columns.AddFor(m => m.SmallGroupName)
                                .Caption("小組")
                                .Width(800)
                                .MinWidth(10);
                        })
                        // 主從細節設定：展開顯示裝備聯絡資訊
                        .MasterDetail(md =>
                        {
                            md.Enabled(true);
                            md.AutoExpandAll(false);
                            // 使用部分視圖顯示詳細資訊
                            md.Template(@<text>
                                @(Html.Partial("EquipmentContactView"))
                            </text>);
                        })
                    )
                </div>
            </div>
        </div>
    </div>

    <!-- 命名模板：用於主從細節顯示 -->
    @using (Html.DevExtreme().NamedTemplate("EquipmentContact"))
    {
        @(Html.Partial("EquipmentContactView"))
    }

    <!-- JavaScript 函數 -->
    <script>
        /**
         * 移動編輯欄位到最左側
         * 參數: dataGrid - DataGrid 元件實例
         */
        function moveEditColumnToLeft(dataGrid) {
            dataGrid.columnOption("command:edit", {
                visibleIndex: -1,  // 設定為最左側
                width: 50  // 設定寬度
            });
        }

        /**
         * 單元格準備事件處理函數（目前未使用）
         * 參數: e - 事件參數
         */
        function cell_prepared(e) {
            if (e.rowType === "data" && e.column.command === "edit") {
                var isEditing = e.row.isEditing,
                    $links = e.cellElement.find(".dx-link");

                $links.text("");

                if (isEditing) {
                    $links.filter(".dx-link-save").addClass("dx-icon-save");
                    $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
                } else {
                    $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                    $links.filter(".dx-link-delete").addClass("dx-icon-trash");
                }
            }
        }

        /**
         * 行準備事件處理函數：設定行樣式和滑鼠事件
         * 參數: e - 事件參數
         */
        function OnRowPrepared(e) {
            // 設定行高、字型、大小、顏色和背景
            e.rowElement.css({
                height: 25,
                'font-size': '18px',
                'font-family': '標楷體',
                'color': 'rgb(0, 0, 255)',
                'background': 'rgb(255, 251, 255)'
            });

            if (e.rowType === 'data') {
                // 滑鼠移入事件：改變背景色
                e.rowElement[0].addEventListener("mouseover", function () {
                    e.rowElement.css({
                        'background': '#fff2a8',
                        "transition": "background-color 0.5s"
                    });
                });

                // 滑鼠移出事件：恢復原始背景
                e.rowElement[0].addEventListener("mouseleave", function () {
                    e.rowElement[0].style.background = "";
                });
            }
        }
    </script>

    <!-- 外部資源 -->
    <link href="~/css/MasterDetail.css" rel="stylesheet" />
    <script src="~/js/SelectTime.js"></script>
</body>
</html>