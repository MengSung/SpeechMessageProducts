@{
    String DataStatus = "上傳成功了!";
    //String ReUpload = "請再按上傳一次!";
    String ReUpload = "您有一些操作沒有完成，請檢查一下剛剛輸入的資料!";
}

@using ChurchReport.Models

@model ChurchReport.Models.RaceLeader

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>神住611靈糧堂</title>
    @*<title>神住611靈糧堂</title>*@

</head>

@*<h3>@ViewBag.HappyGroupName</h3>*@

<div class="dx-field">
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("toast")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 250))
            .Message(DataStatus)
            //.DisplayTime(2000)
            .MaxWidth(200)
            )
    </div>
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
            .ID("loadPanel")
            .ShadingColor("rgba(0,0,0,0.4)")
            //.Position(p => p.Of("#data-grid").Of("#buttonContainer"))
            .Position(p => p.Of("#data-grid"))
            .Visible(false)
            .ShowIndicator(true)
            .ShowPane(true)
            .Shading(true)
            .CloseOnOutsideClick(false)
            .Message("更新資料中...")
            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            //.OnShown("loadPanel_shown")
            //.OnHidden("loadPanel_hidden")
            )
    </div>
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("ToastReUpload")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message(ReUpload)
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(500)
            )
    </div>
    <div id="ToastContainerNoSelectDate">
        @(Html.DevExtreme().Toast()
            .ID("ToastNoSelectDate")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message("沒有選擇日期")
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(500)
            )
    </div>
</div>

<div id="data-grid-SmallGroup" class="internal-grid-container" style="color:#00FF00 ; height:100%; width:100%; overflow: hidden;">
    <p style="font-family:標楷體;font-size: 120%; color: darkcyan; text-align:right;background-color: lemonchiffon;font-weight: bold">請按+號新增族系族長</p>
    @(Html.DevExtreme().DataGrid<RaceLeader>()
        .ID(new JS("'grid_'+data.AreaLeaderEntityId"))
        .Grouping(g=>g.AutoExpandAll(true))
        .AllowColumnResizing(false)
        //.Width(800)
        //.Width("auto")
        .Width("inherit")
        //.Width("80%")
        //.AllowColumnReordering(true)
        .ColumnAutoWidth(true)
        .ColumnMinWidth(80)
        .ColumnFixing(c => c.Enabled(true))
        .NoDataText("沒有資料")
        .ShowBorders(true)
        .ShowRowLines(true)
        .ShowColumnLines(true)
        .OnRowPrepared("OnRowPrepared")
        //.SearchPanel(s => s.Visible(true).Placeholder("搜尋.."))
        .Sorting(sorting => sorting.Mode(GridSortingMode.Multiple))

        .DataSource(d => d
            .WebApi()
            .Controller("Home")
            .LoadAction("LoadListManagementList")
            .InsertAction("PostRacerListManagementMember")
            .DeleteAction("DeletRaceLeader")
            //.UpdateAction("UpdateListManagementMember")
            .Key("RaceLeaderEntityId")
            .LoadParams(new { id = new JS("data.AreaLeaderEntityId") })
        )

        .Editing(editing =>
        {

            //editing.Mode(GridEditMode.Row);
            editing.Mode(GridEditMode.Cell);
            //editing.Mode(GridEditMode.Batch);
            //editing.Mode(GridEditMode.Form);
            //editing.Mode(GridEditMode.Popup);
            editing.AllowUpdating(true);
            //editing.AllowDeleting(true);
            editing.AllowAdding(true);
            editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("確定").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除").ConfirmDeleteTitle("確定要刪除嗎?").ConfirmDeleteMessage("移除族系族長"));
            //editing.AllowDeleting(true);
        })


       // 此處設定是讓選項偏左邊一排
       .OnContentReady(
            @<text>
            function(e)
            {
                moveEditColumnToLeft(e.component);
            }
            </text> )
       //此處設定是鉛筆形狀還是"編輯"字樣
       .OnCellPrepared("cell_prepared")

       .OnInitNewRow(string.Format("function(e) {{ OnInitRaceLeaderRow(e, {0}); }}", new JS("data.RaceLeaderEntityId")))

       .OnRowInserted
       (
                @<text>
                  function(arg)
                  {
                        //debugger;
                        // AJAX 區塊
                        $.ajax
                        (
                            {
                                    url: '@Url.Action("AddRaceLeader", "Home")',
                                    data:
                                    {
                                        key:arg.key,
                                        values:arg.data.RaceLeaderName,
                                    }, // 整理回傳給 Server 的點名資料

                                    type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                                    success: function (arg)
                                    {
                                        if (arg.status == 1)
                                        {
                                            //debugger;
                                            // 先呼叫 InsertAction，但是回傳正確
                                            ShowToast(arg.message, "success", 3000);
                                        }
                                        if (arg.status == 2)
                                        {
                                            // 先呼叫 InsertAction，但是回傳錯誤
                                            //debugger;
                                            var RowIndex = $("#grid_" + arg.parentid).dxDataGrid("instance").getRowIndexByKey(arg.RaceEntityId);
                                            $("#grid_" + arg.parentid).dxDataGrid("instance").deleteRow(RowIndex);

                                            ShowToast(arg.message, "error", 5000);
                                        }
                                        else if( arg.status == 3)
                                        {
                                             //debugger;
                                             //先呼叫Ajax，但是回傳正確
                                             ShowToast(arg.message, "success", 3000);
                                        }
                                        else if( arg.status == 4)
                                        {
                                            //debugger;
                                            //先呼叫Ajax，但是回傳錯誤
                                            //var RowIndex = $("#grid_" + arg.parentid).dxDataGrid("instance").getRowIndexByKey(arg.RaceEntityId);
                                            //$("#grid_" + arg.parentid).dxDataGrid("instance").deleteRow(RowIndex);

                                            ShowToast(arg.message, "error", 5000);
                                        }
                                        else if( arg.status == 5)
                                        {
                                            //debugger;
                                            //先呼叫Ajax，但是回傳錯誤
                                            //var RowIndex = $("#grid_" + arg.parentid).dxDataGrid("instance").getRowIndexByKey(arg.RaceEntityId);
                                            //$("#grid_" + arg.parentid).dxDataGrid("instance").deleteRow(RowIndex);

                                            ShowToast(arg.message, "error", 5000);
                                        }
                                        else
                                        {
                                        }
                                    },

                                    error: function (obj)
                                    {
                                        //alert('Something happened');
                                    }

                            }
                        );
                        // AJAX 區塊

                    }
                </text>
       )


       .OnRowExpanded(
                @<text>
                function(e)
                {
                    var detailRowIndex = e.component.getRowIndexByKey(e.key) + 1,
                    $detailCell = e.component.getCellElement(detailRowIndex, 0).parent().find(".dx-master-detail-cell"),
                    dataGrid = $detailCell.find(".dx-datagrid").first().parent().dxDataGrid("instance");

                    dataGrid.refresh();

                    @*$("#grid_001-002-001").dxDataGrid("instance").refresh();
                    $("#grid_001-002-002").dxDataGrid("instance").refresh();
                    $("#grid_001-002-003").dxDataGrid("instance").refresh();*@

                    @*needRepaintDetailRow = e.component.getVisibleRows().some((row) => row.key === e.key && row.rowType === "detail");*@
                }
                </text>)

        .Columns(columns =>
        {
            columns.AddFor(m => m.RaceLeaderName)
            .AllowEditing(true)
            .Caption("族系族長")
            .MinWidth(10);
        })

        .MasterDetail
        (md =>
            {
                //md.Enabled(true);
                //md.Template(new TemplateName("DetailBestList"));


                md.Enabled(true);
                md.AutoExpandAll(true);
                md.Template(@<text>
                    @(Html.Partial("ListManagementDistrictPastor"))
                </text>);
            }
        )

    )
</div>

<script>
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }

    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            } else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }

    function OnRowPrepared(e) {
        e.rowElement.css({ height: 25 });
        e.rowElement.css('font-size', '16px');
        e.rowElement.css('font-family', '標楷體');
        //e.rowElement.css('background', 'rgb(253, 255, 255)');
        e.rowElement.css('background', '#FEFFF4');

        //e.rowElement.css('color', 'rgb(20,57,20)');
        //e.rowElement.css('color', '#254117');
        e.rowElement.css('color', '#330000');
        //e.rowElement.css('color', 'rgb(0, 0, 255)');
        //e.rowElement.css('color', 'rgb(0, 0, 128)');

        e.rowElement.addClass("indicatorClass");

        if (e.rowType == 'data') {
            //e.rowElement.css('background', '#fff2a8');
            //e.rowElement[0].addEventListener("mouseover", function () {
            //    e.rowElement.css('background', '#fff2a8');
            //    e.rowElement.css("transition", "background-color 0.5s");
            //});
            //e.rowElement[0].addEventListener("mouseleave", function () {
            //    e.rowElement[0].style.background = ""
            //});
        }
    }

    function OnInitRaceLeaderRow(e, ParentID) {
        //alert(ParentID);
        e.data.InsertType = "RaceLeader";
        e.data.MasterParentID = ParentID;
    }

    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        //debugger;
        var ToastInstance = $("#toast").dxToast("instance");
        ToastInstance.option('message', LocalToastMessage);
        ToastInstance.option('type', Type);
        ToastInstance.option('displayTime', DisplayTime);
        ToastInstance.option('white-space', 'pre-line');
        ToastInstance.option('closeOnClick', true);
        ToastInstance.show();
    }

</script>

<link href="~/css/MasterDetail.css" rel="stylesheet" />
