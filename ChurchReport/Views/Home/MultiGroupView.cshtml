@* 
    這個視圖用於多小組檢視頁面，顯示小組長的總覽，包括日期選擇、圓餅圖和資料網格。
*@

@{
    String DataStatus = "上傳成功了!";
    String ReUpload = "請再按一次上傳鈕!";
}

@using ChurchReport.Models

@model ChurchReport.Models.ListManager

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>好牧人</title>
</head>

<section class="multi-page-header card-surface">
    <div class="user-block">
        <div class="user-label">小組長</div>
        <h4 class="user-name">@(Model.LoginFullName)</h4>
    </div>

    <div class="date-block">
        <label id="SundayLabel" class="date-label" for="dateBoxContainer">小組日期</label>
        <div id="dateBoxContainer" class="date-value">
            @(Html.DevExtreme()
                .DateBoxFor(m => m.m_SelectDate)
                .Type(DateBoxType.Date)
                .Value(Model.m_SelectDate)
                .Width("100%")
                .DisplayFormat("yyyy/M/d")
                .OnChange("OnDateboxChange")
                .CalendarOptions(k => k.FirstDayOfWeek(0))
                .OnValueChanged(@<text>
                    function(arg) {
                        $("#loadPanel").dxLoadPanel("instance").show();
                        $.ajax({
                            url: '@Url.Action("UpdateDate", "SmallGroup")',
                            data: { SelectedDate: getODataLocalDateFilter(arg.value) },
                            type: 'GET',
                            success: function (result) {
                                if (result.success) {
                                    // 後端資料已更新，重新載入頁面以確保資料一致性
                                    window.location.reload();
                                } else {
                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                    $("#toast").dxToast("instance").option("message", result.message || "日期更新失敗");
                                    $("#toast").dxToast("instance").option("type", "error");
                                    $("#toast").dxToast("instance").show();
                                }
                            },
                            error: function (obj) {
                                $("#loadPanel").dxLoadPanel("instance").hide();
                                $("#toast").dxToast("instance").option("message", "日期更新失敗，請稍後再試");
                                $("#toast").dxToast("instance").option("type", "error");
                                $("#toast").dxToast("instance").show();
                            }
                        });
                    }
                </text>)
            )
        </div>
    </div>
</section>

<!-- 圓餅圖 -->
<section class="card-surface chart-card">
    <div class="card-title-row">
        <h5>多小組出席總覽</h5>
        <span class="card-hint">每個扇區代表各小組人數</span>
    </div>

    <div id="multigroupchart" class="chart-host">
        @(Html.DevExtreme().PieChart()
        .ID("multigroupchartWidget")
        .Palette(VizPalette.HarmonyLight)
        .Margin(m => m.Left(10).Right(10).Top(5))
        .AdaptiveLayout(a => a.Height(20).Width(20).KeepLabels(true))
        .Diameter(0.55)
        .Size(s => s.Height(220))
        .CommonSeriesSettings(s => s
            .ArgumentField("Name")
            .Label(l => l
                .Visible(true)
                .Format(f => f.Type(Format.FixedPoint).Precision(0))
            )
        )
        .Series(s => {
            s.Add().ValueField("Number").Name("人數")
                .Label(l => l
                    .Visible(true)
                    .Font(f => f.Size(12))
                    .Connector(c => c.Visible(true).Width(0.5))
                    .Position(PieChartLabelPosition.Outside)
                    .CustomizeText(@<text>
                        function(arg) {
                            return arg.argument + "=" + arg.valueText;
                        }
                    </text>)
                );
        })
        .Tooltip(t => t.Enabled(true))
        .Title(t => t
            .Text("")
            .Margin(m => m.Top(0).Bottom(0))
        )
        .Legend(l => l
            .VerticalAlignment(VerticalEdge.Bottom)
            .HorizontalAlignment(HorizontalAlignment.Center)
            .Orientation(Orientation.Horizontal)
            .ItemTextPosition(Position.Right)
            .Margin(m => m.Top(2).Bottom(0))
        )
        .Export(e => e.Enabled(false))
        .OnPointClick(@<text>
            function(e) {
                e.target.select();
            }
        </text>)
        .DataSource(d => d
            .WebApi()
            .Controller("SmallGroup")
            .LoadAction("GetMultiGroupChartDataList")
            .Key("ID")
            .LoadParams(new { WeeklyReportId = @ViewBag.ListId })
        )
    )
    </div>
</section>

<!-- 資料網格 -->
<section class="card-surface grid-card">
    <div class="card-title-row">
        <h5>小組出席明細</h5>
        <span class="card-hint">點擊「名稱」可開啟該小組詳細頁面</span>
    </div>

    <div id="smallgroup-grid" class="grid-host">
        @(
            Html.DevExtreme().DataGrid<WeeklyReportRecord>()
            .ID("SmallGroupgridContainer")
            .ShowBorders(true)
            .ColumnAutoWidth(true)
            .Visible(true)
            .Scrolling(s => s
                .Mode(GridScrollingMode.Virtual)
                .RowRenderingMode(GridRowRenderingMode.Virtual)
            )
            .Paging(paging => paging.PageSize(10).Enabled(true))
            .Sorting(sorting => sorting.Mode(GridSortingMode.None))
            .AllowColumnResizing(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnFixing(c => c.Enabled(true))
            .LoadPanel(l => l.Text("更新資料中..."))
            .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ShowBorders(true)
            .OnRowPrepared("OnRowPrepared")
            .OnCellPrepared("cell_prepared")
            .TwoWayBindingEnabled(true)
            .Grouping(g => g
                .ContextMenuEnabled(true)
                .ExpandMode(GridGroupingExpandMode.RowClick)
            )
            .GroupPanel(p => p
                .EmptyPanelText("請把小組名稱拉到這裡")
                .Visible(false)
                .AllowColumnDragging(true)
            )
            .Editing(editing =>
            {
                editing.Mode(GridEditMode.Cell);
                editing.AllowUpdating(true);
                editing.AllowDeleting(false);
                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除"));
            })
            .Columns(columns =>
            {
                columns.AddFor(m => m.ListEntityId).Caption("名稱").Fixed(true).Width(120).MinWidth(20).CellTemplate(new JS("cellTemplate"));
                columns.AddFor(m => m.TotalNumber).Caption("總人數").Fixed(false).Width(120).MinWidth(20).Alignment(HorizontalAlignment.Center).AllowSorting(false);
                columns.AddFor(m => m.SundayNumber).Caption("主日人數").Width(120).MinWidth(45).Alignment(HorizontalAlignment.Center).AllowSorting(false);
                columns.AddFor(m => m.SmallGroupNumber).Caption("小組人數").Width(120).MinWidth(45).Alignment(HorizontalAlignment.Center).AllowSorting(false);
                columns.AddFor(m => m.SundayRate).Caption("主日出席率").Width(120).MinWidth(80).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.SmallGroupRate).Caption("小組出席率").Width(120).MinWidth(120).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.ReportStatus).Caption("週報狀態").Width(120).MinWidth(120).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.ReportContent).Caption("日誌內容").Width(1200).MinWidth(1200).Alignment(HorizontalAlignment.Left);
            })
            .DataSource(d => d
                .WebApi()
                .Controller("SmallGroup")
                .LoadAction("AssignSmallGroupGet")
                .Key("ListEntityId")
                .LoadParams(new { id = @ViewBag.ListId })
            )
            .Summary(s => s.TotalItems(items =>
            {
                items.Add().Name("TotalNumber").ShowInColumn("ListEntityId").DisplayFormat("總人數:{0}").SummaryType(SummaryType.Custom);
                items.Add().Name("SundayNumber").ShowInColumn("ListEntityId").DisplayFormat("主日:{0}").SummaryType(SummaryType.Custom);
                items.Add().Name("SmallGroupNumber").ShowInColumn("ListEntityId").DisplayFormat("小組:{0}").SummaryType(SummaryType.Custom);
            })
            .CalculateCustomSummary(@<text>
                function (options) {
                    if (options.name === "TotalNumber") {
                        if (options.summaryProcess === "start") options.totalValue = 0;
                        if (options.summaryProcess === "calculate") options.totalValue += Number(options.value.TotalNumber);
                    }
                    else if (options.name === "SundayNumber") {
                        if (options.summaryProcess === "start") options.totalValue = 0;
                        if (options.summaryProcess === "calculate") options.totalValue += Number(options.value.SundayNumber);
                    }
                    else if (options.name === "SmallGroupNumber") {
                        if (options.summaryProcess === "start") options.totalValue = 0;
                        if (options.summaryProcess === "calculate") options.totalValue += Number(options.value.SmallGroupNumber);
                    }
                }
            </text>)
        )
        )
    </div>
</section>

<!-- 工具元件 -->
<div id="Tool" style="height:100%; width:100%; overflow: hidden;">
    <!-- Toast 通知 -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("toast")
            .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
            .Message(DataStatus)
            .Type(ToastType.Success)
            .DisplayTime(2000)
            .MaxWidth(200)
        )
    </div>

    <!-- 載入面板 -->
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
            .ID("loadPanel")
            .ShadingColor("rgba(0,0,0,0.4)")
            .Position(p => p.Of("#data-grid"))
            .Visible(false)
            .ShowIndicator(true)
            .ShowPane(true)
            .Shading(true)
            .CloseOnOutsideClick(false)
            .Message("更新資料中...")
            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
        )
    </div>

    <!-- 重新上傳 Toast -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("ToastReUpload")
            .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
            .Message(ReUpload)
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(500)
        )
    </div>

    <!-- 日期格式錯誤 Toast -->
    <div id="SelectDateToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("SelectDateToast")
            .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
            .Message("日期格式錯誤，格式範例: 2018/6/5")
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(300)
        )
    </div>
</div>

<style>
    .card-surface {
        --brand-main: #4f46e5;
        --brand-sub: #0f766e;
        --text-main: #1f2937;
        --text-sub: #6b7280;
        --line-soft: #e5e7eb;
        background: #fff;
        border: 1px solid var(--line-soft);
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        margin-bottom: 14px;
        padding: 12px;
    }

    .multi-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
    }

    .user-block {
        min-width: 180px;
    }

    .user-label {
        color: var(--text-sub);
        font-size: 12px;
        margin-bottom: 2px;
    }

    .user-name {
        margin: 0;
        color: #115e59;
        letter-spacing: 0.5px;
    }

    .date-block {
        flex: 1;
        max-width: 360px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .date-label {
        color: var(--text-main);
        font-weight: 700;
        font-size: 14px;
    }

    .card-title-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .card-title-row h5 {
        margin: 0;
        color: var(--brand-sub);
        font-size: 18px;
        font-weight: 700;
    }

    .card-hint {
        color: var(--text-sub);
        font-size: 12px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 999px;
        padding: 4px 10px;
        white-space: nowrap;
    }

    .chart-card {
        padding-top: 8px;
        padding-bottom: 8px;
    }

    .chart-card .card-title-row {
        margin-bottom: 4px;
    }

    .chart-host {
        display: flex;
        justify-content: center;
    }

    .grid-host {
        border-radius: 10px;
        overflow: hidden;
    }

    #SmallGroupgridContainer .dx-datagrid .dx-header-row > td {
        background: linear-gradient(180deg, var(--color-secondary, #4f8df1) 0%, var(--color-primary, #2f6fd6) 100%) !important;
        color: #fff !important;
        font-weight: 700;
        border-bottom: 1px solid var(--color-border, #c9daf8) !important;
    }

    #SmallGroupgridContainer .dx-datagrid-rowsview .dx-row > td {
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        vertical-align: middle !important;
        color: var(--text-main);
    }

    #SmallGroupgridContainer .dx-row.dx-data-row:hover > td {
        background: #f8fbff !important;
    }

    #SmallGroupgridContainer .dx-row.row-hovered-soft > td {
        transition: background-color 0.2s ease;
    }

    #SmallGroupgridContainer .dx-link {
        border-radius: 6px;
        padding: 2px 4px;
    }

    #SmallGroupgridContainer .dx-link:hover {
        background: #eef2ff;
    }

    /* 讓底部統計項目排成同一列 */
    #SmallGroupgridContainer .dx-datagrid-total-footer .dx-row > td:first-child {
        overflow: visible;
    }

    #SmallGroupgridContainer .dx-datagrid-total-footer .dx-datagrid-summary-item {
        display: inline-block;
        margin-right: 10px;
        white-space: nowrap;
        font-weight: 600;
        color: var(--brand-sub, #0f766e);
    }

    @@media (max-width: 768px) {
        .multi-page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .date-block {
            max-width: none;
        }

        .card-title-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }

        .card-hint {
            white-space: normal;
            line-height: 1.4;
        }

        /* 圓餅圖區塊在手機上縮減內距 */
        .chart-card {
            padding: 6px;
        }
    }

    @@media (max-width: 430px) {
        .card-surface {
            padding: 10px;
            border-radius: 12px;
        }

        .card-title-row h5 {
            font-size: 17px;
        }

        #SmallGroupgridContainer .dx-datagrid-rowsview .dx-row > td {
            padding-top: 9px !important;
            padding-bottom: 9px !important;
        }
    }
</style>

<!-- JavaScript 函數 -->
<script>
    // 日期格式轉換函數
    function getODataLocalDateFilter(date) {
        if (date == null) date = new Date();
        var month = (date.getMonth() + 1).toString();
        var day = date.getDate().toString();
        return date.getFullYear() + "/" + month + "/" + day;
    }

    // 移動編輯欄到左側
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }

    // 單元格準備
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            } else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }

    // 日期變更處理
    function OnDateboxChange(e) {
        if (e.component._$validationMessage == null) {
            UploadDateFormat = "格式正確";
        } else {
            UploadDateFormat = "格式錯誤";
            $("#SelectDateToast").dxToast("instance").show();
            return;
        }
    }

    // 獲取載入面板實例
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }

    // 按鈕點擊
    function button_click() {
        getLoadPanelInstance().show();
    }

    // 載入面板事件
    function loadPanel_shown(e) {
    }

    function loadPanel_hidden() {
    }

    // 儲存週報
    function SaveWeeklyReport(arg) {
        getLoadPanelInstance().show();
    }

    // 單元格模板
    function cellTemplate(cellElement, cellInfo) {
        $('<a/>')
            .attr({ href: '@Url.RouteUrl("default", new { action = "IntegrateView", controller = "SmallGroup" })/' + `${cellInfo.data.ListEntityId}` })
            .text(`${cellInfo.data.Name}`)
            .appendTo(cellElement);
    }

    // 行準備
    function OnRowPrepared(e) {
        e.rowElement.css({ height: 25 });
        e.rowElement.css('font-size', '16px');
        if (e.rowType == 'data') {
            e.rowElement.addClass('row-hovered-soft');
        }
    }
</script>

<!-- 本地中文化 -->
<script>
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容",
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date"
        },
    };
    DevExpress.localization.loadMessages(dictionary);
    var formatMessage = DevExpress.localization.formatMessage;

    var locale = getLocale();
    DevExpress.localization.locale(locale);

    function changeLocale(data) {
        setLocale(data.value);
        document.location.reload();
    }

    function getLocale() {
        sessionStorage.setItem("locale", 'zh-tw');
        var locale = sessionStorage.getItem("locale");
        return locale != null ? locale : "tw";
    }
</script>

