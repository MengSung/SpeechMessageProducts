<div class="dx-field">
    <div id="buttonContainer" class="dx-button-icon" style="float: left; width:30%; text-align: left; background-color:white;">
        @(Html.DevExtreme().Button()
            .Text("上傳").Height(50).Width(80).Icon("check")
            .Type(ButtonType.Success)
            .ID("save-button")
            .OnClick
            (@<text>
                function(arg)
                {
                    var dataGrid = $("#FeeGridContainer").dxDataGrid("instance");
                    var ButtonContainer = $("#save-button").dxButton("instance");

                    // ? 先儲存 DataGrid 的所有編輯變更到本地
                    $("#FeeGridContainer").dxDataGrid("instance").saveEditData();

                    // ? 檢查是否有待處理的變更
                    var pendingChangesCount = dataGrid.hasEditData();
                    
                    if (!pendingChangesCount) {
                        // 沒有待處理的變更，顯示提示
                        DevExpress.ui.notify("目前沒有需要上傳的資料變更", "info", 2000);
                        return;
                    }

                    // 顯示旋轉載入面板
                    $("#loadPanel").dxLoadPanel("instance").show();

                    // 禁用上傳按鈕
                    ButtonContainer.option("disabled", true);

                    // AJAX 請求批次上傳數據
                    $.ajax({
                        url: '@Url.Action("SaveBatch", "FeeManagement")',
                        data: { aResult: "" }, // aResult 參數保留以維持相容性
                        type: 'POST',
                        success: function (response) {
                            // 隱藏載入面板
                            $("#loadPanel").dxLoadPanel("instance").hide();

                            // 啟用上傳按鈕
                            ButtonContainer.option("disabled", false);

                            // 檢查回應狀態
                            if (response.status === "success") {
                                // 顯示成功提示，包含更新筆數
                                var message = response.count > 0 
                                    ? "上傳成功! 已更新 " + response.count + " 筆記錄" 
                                    : "上傳成功!";
                                
                                DevExpress.ui.notify(message, "success", 3000);
                                
                                // ? 清除待上傳修改記錄
                                clearPendingChanges();
                                
                                // ? 重新載入資料以確保與資料庫同步
                                dataGrid.refresh();
                            } else {
                                // 顯示錯誤提示
                                DevExpress.ui.notify("上傳失敗: " + response.message, "error", 5000);
                            }
                        },
                        error: function (xhr, status, error) {
                            // 隱藏載入面板
                            $("#loadPanel").dxLoadPanel("instance").hide();

                            // 啟用上傳按鈕
                            ButtonContainer.option("disabled", false);

                            // 顯示錯誤提示
                            var errorMessage = "上傳時發生錯誤";
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMessage += ": " + xhr.responseJSON.message;
                            }
                            DevExpress.ui.notify(errorMessage, "error", 5000);
                            
                            console.error("上傳錯誤:", error);
                        }
                    });
                }
            </text>)
        )
    </div>

    <!-- ? 待上傳修改數量提示 -->
    <div id="pendingChangesIndicator" style="float: left; margin-left: 10px; margin-top: 15px; display: none;">
        <span class="dx-icon dx-icon-warning" style="color: #ff9800; font-size: 20px;"></span>
        <span id="pendingChangesCount" style="color: #ff9800; font-weight: bold; margin-left: 5px;">0</span>
        <span style="color: #666; margin-left: 5px;">筆待上傳</span>
    </div>

    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("toast")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message("上傳成功!")
            .DisplayTime(2000)
            .MaxWidth(200)
        )

    </div>
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
            .ID("loadPanel")
            .ShadingColor("rgba(0,0,0,0.4)")
            //.Position(p => p.Of("#data-grid").Of("#buttonContainer"))
            .Position(p => p.Of("#data-grid"))
            .Visible(false)
            .ShowIndicator(true)
            .ShowPane(true)
            .Shading(true)
            .CloseOnOutsideClick(false)
            .Message("更新資料中...")
            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            //.OnShown("loadPanel_shown")
            //.OnHidden("loadPanel_hidden")
        )
    </div>
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("ToastReUpload")
            .Position(p => p
            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
            .Offset(0, 50))
            .Message("有尚未更新好的資料，請再按一次上傳!")
            .DisplayTime(5000)
            .Type(ToastType.Error)
            .MaxWidth(500)
        )

    </div>
