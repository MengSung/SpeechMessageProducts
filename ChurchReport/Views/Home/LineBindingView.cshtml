<!DOCTYPE html>

@{
    Layout = null;
}
@model ChurchReport.ViewModel.LineBindingViewModel

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>台北基督之家</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    @* JSZip for client side export *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

</head>

<body>

    <div class="widget-container" style="padding: 10px;">
        @(Html.DevExtreme().Gallery()
        .ID("gallery")
        .DataSource(Model.Images)
        .Height(100)
        //.Width(600)
        //.InitialItemWidth(250)
        .StretchImages(true)
        .Loop(true)
        .SlideshowDelay(1500)
        //.ShowNavButtons(true)
        //.ShowIndicator(true)
        )
    </div>

    <div class="long-title"><h3>@(Model.FullName + " 綁定")</h3></div>

    <form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="ProcessLineBinding" asp-controller="Home" method="post" style="text-align: center;">

        <div class="dx-field" style="text-align: center;">
            <div class="form-container-class" id="form-container" style="text-align: center;">
                @(Html.DevExtreme().Form()
                .ID("form")
                .Items(items =>
                {

                    items.AddSimple()
                        .DataField("FullName")
                        .Label(l => l.Text("姓名"))
                        .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Text)
                            .Disabled(false)
                            .Placeholder("輸入姓名")
                            .ShowClearButton(true)
                       //.Width(200)
                       );
                    items.AddSimple()
                        .DataField("Mobile")
                        .Label(l => l.Text("行動電話"))
                        .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Text)
                            .Disabled(false)
                            .Placeholder("輸入行動電話")
                            .ShowClearButton(true)
                       //.Width(200)
                       );
                    items.AddSimple()
                        .DataField("Account")
                        .Label(l => l.Text("帳號"))
                        .Editor(e => e
                            .TextBox()
                            .Disabled(false)
                            .Placeholder("輸入帳號")
                            .ShowClearButton(true)
                       //.Width(200)
                       );

                    items.AddSimple()
                        .DataField("Password")
                        .Label(l => l.Text("密碼"))
                        .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Password)
                            .Disabled(false)
                            .Placeholder("輸入密碼")
                            .ShowClearButton(true)
                       //.Width(200)
                       );
                    items.AddSimple()
                        .DataField("ConfirmPassword")
                        .Label(l => l.Text("確認密碼"))
                        .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Password)
                            .Disabled(false)
                            .Placeholder("輸入確認密碼")
                            .ShowClearButton(true)
                       //.Width(200)
                       );

                })
                )
            </div>
        </div>
        <div class="dx-field" style="text-align: center;">
            <div id="buttonContainer" class="dx-button-icon">
                @(Html.DevExtreme().Button()
            .Text("綁定")
            //.Type(ButtonType.Success)
            //.Type(ButtonType.Normal)
            .Type(ButtonType.Default)
            .ID("register-button")
            .UseSubmitBehavior(true)
            .OnClick("Register")
            .Width(100)
                )
            </div>
            <div id="LoadPanel">
                @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("綁定中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            //.OnShown("loadPanel_shown")
            //.OnHidden("loadPanel_hidden")
                )
            </div>
        </div>
    </form>

    <script>
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        function button_click() {
            getLoadPanelInstance().show();
        }

        function loadPanel_shown(e) {
            //    setTimeout(function () {
            //        e.component.hide();
            //    }, 3000);
        }

        function loadPanel_hidden() {
        }

        function Register(arg) {

            getLoadPanelInstance().show();
        }

    </script>

    <script type="text/javascript">
        function onBegin() {
        }

        function onSuccess(data) {

            getLoadPanelInstance().hide();

            if (data.status == 1) {
                DevExpress.ui.notify(data.message, "success", 2000);
                window.location.href = "/Home/Login";
                //window.location.href = "/Home/SmallGroupReportView/" + data.fullname + "," + data.account+ "," + data.password;

                //window.location.href = "/Home/SmallGroupReportView/" + data.fullname;
                //window.location.href = "/Home/InputReport/" + data.fullname;
            }
            else {
                DevExpress.ui.notify(data.message, "error", 3000);
                window.location.href = "/Home/Register";
            }
        }

        function onComplete(data) {
            if (data.status == 1) {
            }
            else {
            }
        }
    </script>

    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <link href="~/css/Gallery.css" rel="stylesheet" />
    <link href="~/css/WeeklyReport.css" rel="stylesheet" />

</body>

</html>