<div id="lessonlist-grid">
    @(
        Html.DevExtreme().DataGrid<Lesson>()
            .ID("SmallGroupgridContainer")
            .ShowBorders(true)
            .ColumnAutoWidth(true)
            //.Visible(Model.DisplayFlag)
            .Visible(true)
            //.RemoteOperations(true)
            .Scrolling(s => s
                .Mode(GridScrollingMode.Virtual)
                .RowRenderingMode(GridRowRenderingMode.Virtual)
             )
            .Paging(paging => paging.PageSize(10).Enabled(true))
            .Sorting(sorting => sorting.Mode(GridSortingMode.None))
            .AllowColumnResizing(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnFixing(c => c.Enabled(true))
            .LoadPanel(l => l.Text("更新資料中..."))
            .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ShowBorders(true)
            .OnRowPrepared("OnRowPrepared")

            .TwoWayBindingEnabled(true)

            .Grouping
            (g => g
            .ContextMenuEnabled(true)
            .ExpandMode(GridGroupingExpandMode.RowClick)
            )

            .GroupPanel
            (p => p
            .EmptyPanelText("請把小組名稱拉到這裡")
            .Visible(false) // 讓使用者不能自己決定誰被Grouping起來
            .AllowColumnDragging(true)
            )

            .Editing(editing =>
            {
                //editing.Mode(GridEditMode.Batch);
                //editing.Mode(GridEditMode.Row);
                editing.Mode(GridEditMode.Cell);
                //editing.Mode(GridEditMode.Batch);
                //editing.Mode(GridEditMode.Form);
                //editing.Mode(GridEditMode.Popup);
                editing.AllowUpdating(true);
                editing.AllowDeleting(false);
                //editing.AllowAdding(false);
                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除"));
                //editing.AllowDeleting(true);
            })

            .Columns(columns =>
            {
                columns.AddFor(m => m.DiscipleLessonsName).Caption("課程名稱").Fixed(true).Width(250).MinWidth(20).CellTemplate(new JS("cellTemplate")).AllowEditing(false);
                columns.AddFor(m => m.EnrolledNumber).Caption("報名人數").DataType(GridColumnDataType.Number).Width(80).MinWidth(45).AllowEditing(false).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.EnrollStartDate).Caption("報名開始日期").DataType(GridColumnDataType.Date).Width(120).MinWidth(45).AllowEditing(false).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.EnrollEndDate).Caption("報名結束日期").DataType(GridColumnDataType.Date).Width(120).MinWidth(45).AllowEditing(false).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.LessonStartDate).Caption("課程開始日期").DataType(GridColumnDataType.Date).Width(120).MinWidth(45).AllowEditing(false).Alignment(HorizontalAlignment.Center);
                columns.AddFor(m => m.LessonEndDate).Caption("課程結束日期").DataType(GridColumnDataType.Date).Width(120).MinWidth(45).AllowEditing(false).Alignment(HorizontalAlignment.Center);
            })
            .DataSource(d => d
            .WebApi()
            .Controller("Home")
            .LoadAction("LoadLessonList")
            //.InsertAction("InsertPresentRecord")
            //.DeleteAction("DeletePresentRecord")
            //.UpdateAction("UpdatePresentRecord")
            .Key("DiscipleLessonsId")
            .LoadParams(new { id = @ViewBag.ListId }))

    )
</div>

<div id="Tool" style="height:100%; width:100%; overflow: hidden;">
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
        .ID("loadPanel")
        .ShadingColor("rgba(0,0,0,0.4)")
        //.Position(p => p.Of("#data-grid").Of("#buttonContainer"))
        .Position(p => p.Of("#data-grid"))
        .Visible(false)
        .ShowIndicator(true)
        .ShowPane(true)
        .Shading(true)
        .CloseOnOutsideClick(false)
        .Message("更新資料中...")
        .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
        //.OnShown("loadPanel_shown")
        //.OnHidden("loadPanel_hidden")
        )
    </div>
</div>

