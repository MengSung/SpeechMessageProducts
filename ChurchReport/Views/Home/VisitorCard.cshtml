<!DOCTYPE html>

@{
    Layout = null;
}
<html>

@using ChurchReport.ViewModel

@model LineBindingViewModel

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>好牧人</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    @* JSZip for client side export *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

</head>

<body>

    <div class="widget-container" style="padding: 10px;">
        @(Html.DevExtreme().Gallery()
                        .ID("gallery")
                        .DataSource(Model.Images)
                        .Height(250)
                        //.Width(600)
                        //.InitialItemWidth(250)
                        .StretchImages(true)
                        .Loop(true)
                        .SlideshowDelay(1500)
        )
    </div>

    <div class="long-title"><h3 id="displaynamefield">請稍待幾秒，正在讀取資料中......</h3></div>
    <div class="long-title"><h3 id="remind">請輸入真實中文姓名</h3></div>

    <form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="ProcessVisitorCard" asp-controller="Home" method="post" style="text-align: center;">

        <div class="dx-field" style="text-align: center;">
            <div class="form-container-class" id="form-container" style="text-align: center;">
                @(Html.DevExtreme().Form<LineBindingViewModel>
                    ()
                    .ID("form")
                    .Items(items =>
                    {
                        items.AddSimpleFor(m => m.FullName)
                            .Label(l => l.Text("姓名"))
                            .IsRequired(true)
                            .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Text)
                            .Disabled(false)
                            .Placeholder("輸入姓名")
                            .ShowClearButton(true)
                            //.Width(200)
                            );

                        items.AddSimpleFor(m => m.Mobile)
                            .Label(l => l.Text("行動電話"))
                            .IsRequired(true)
                            .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Text)
                            .Disabled(false)
                            .Placeholder("輸入行動電話")
                            .ShowClearButton(true)
                            //.Width(200)
                            );

                        items.AddSimpleFor(m => m.Gender)
                            //.DataField("Gender")
                            .Label(l => l.Text("性別"))
                            .Editor(e => e
                            .SelectBox()
                            .Placeholder("選擇性別...")
                            .DataSource(new string[] {
                                "未知",
                                "男性",
                                "女性",
                            }
                            //.DisplayExpr("Name")
                            )
                            //.Value("未知")
                            );

                        items.AddSimple()
                            .DataField("Status")
                            .Label(l => l.Text("信仰狀態"))
                            .Editor(e => e
                            .SelectBox()
                            .ID("spiritualIdentitySelectBox") // ✅ 新增 ID 以便 JavaScript 控制
                            .Placeholder("選擇信仰狀態...")
                            .DataSource(new string[] { "-未知-" }) // ✅ 預設值
                            //.OnValueChanged("OnSelectStatusBoxValueChanged")
                            );

                        items.AddSimpleFor(m => m.BirthDate)
                            //.DataField("BirthDate")
                            .Label(l => l.Text("生日"))
                            .IsRequired(false)
                            .Editor(e => e
                            .DateBox()
                            .DisplayFormat("yyyy/M/d")
                            .Disabled(false)
                            .Placeholder("生日")
                            .PickerType(DateBoxPickerType.Calendar)
                            );

                        items.AddSimpleFor(m => m.LineUserId)
                            .DataField("LineUserId")
                            .Label(l => l.Text("Line Id").Visible(false))
                            .Editor(e => e
                            .TextBox()
                            .Mode(TextBoxMode.Text)
                            .Disabled(false)
                            .Placeholder("輸入行動電話")
                            .ShowClearButton(true)
                            .Value(Model.LineUserId)
                            .Visible(false)
                            //.Width(200)
                            );



                    })
                    )
            </div>
        </div>
        <div class="dx-field" style="text-align: center;">
            <div id="buttonContainer" class="dx-button-icon">

                <div id="LineButton" style="display:none;">
                    <!-- 轉換為LINE加入好友的連結 -->
                    <a href="https://lin.ee/YK9MjHj"><img src="https://scdn.line-apps.com/n/line_add_friends/btn/zh-Hant.png" alt="加入好友" height="36" border="0"></a>
                </div>
                @(Html.DevExtreme().Button()
                            .Text("註冊")
                            //.Type(ButtonType.Success)
                            //.Type(ButtonType.Normal)
                            .Type(ButtonType.Default)
                            .ID("register-button")
                            .UseSubmitBehavior(true)
                            .OnClick("Register")
                            .Width(100)
                )
            </div>
            <div id="LoadPanel">
                @(Html.DevExtreme().LoadPanel()
                                .ID("loadPanel")
                                .ShadingColor("rgba(0,0,0,0.4)")
                                .Position(p => p.Of("#form-container"))
                                .Visible(false)
                                .ShowIndicator(true)
                                .ShowPane(true)
                                .Shading(true)
                                .CloseOnOutsideClick(false)
                                .Message("註冊中...")
                                .Delay(5000)
                                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                )
            </div>
        </div>

    </form>

    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                            .ID("Toast")
                            .Position(p => p
                            .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                            .Offset(0, 50))
                            //.Shading(true)
                            //.ShadingColor("red")
                            .CloseOnOutsideClick(true)
                            .DisplayTime(2000)
                            .MaxWidth(200)
            )

    </div>

    <script src="~/js/liff-starter.js"></script>

    <script>
        // ✅ 全域變數：信仰狀態 DataSource
        var spiritualIdentityDataSource = ["-未知-", "基督徒", "已決志", "慕道友", "未信主"]; // 預設值

        // ✅ 頁面載入後，動態載入信仰狀態清單
        $(document).ready(function() {
            console.log('========================================');
            console.log('✅ [VisitorCard] Script 已載入');
            console.log('========================================');
            
            // 載入信仰狀態清單
            loadSpiritualIdentityList();
        });

        // ✅ 載入信仰狀態清單的函數
        function loadSpiritualIdentityList() {
            console.log('✅ [VisitorCard] 開始載入信仰狀態清單');
            
            $.ajax({
                url: '/Personal/Api/GetSpiritualIdentityList',
                type: 'GET',
                dataType: 'json',
                timeout: 10000, // 10秒超時
                success: function(response) {
                    console.log('✅ [VisitorCard] API 回應:', response);
                    
                    if (response && response.success && response.data && response.data.length > 0) {
                        spiritualIdentityDataSource = response.data;
                        console.log('✅ [VisitorCard] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                        
                        // ✅ 動態更新 SelectBox 的 DataSource
                        updateSpiritualIdentitySelectBox();
                    } else {
                        console.warn('⚠️ [VisitorCard] API 回應格式異常，使用預設清單');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ [VisitorCard] 載入信仰狀態清單失敗:', error);
                    console.error('❌ [VisitorCard] 使用預設清單');
                }
            });
        }

        // ✅ 更新 SelectBox 的函數
        function updateSpiritualIdentitySelectBox() {
            try {
                var selectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
                
                if (selectBox) {
                    console.log('✅ [VisitorCard] 找到 SelectBox 實例');
                    selectBox.option("dataSource", spiritualIdentityDataSource);
                    console.log('✅ [VisitorCard] 成功更新 SelectBox DataSource');
                } else {
                    console.warn('⚠️ [VisitorCard] 找不到 SelectBox 實例，嘗試延遲更新...');
                    
                    // 延遲 500ms 後重試
                    setTimeout(function() {
                        var retrySelectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
                        if (retrySelectBox) {
                            console.log('✅ [VisitorCard] 重試成功');
                            retrySelectBox.option("dataSource", spiritualIdentityDataSource);
                        } else {
                            console.error('❌ [VisitorCard] 重試後仍找不到 SelectBox 實例');
                        }
                    }, 500);
                }
            } catch (ex) {
                console.error('❌ [VisitorCard] 更新 SelectBox 失敗:', ex);
            }
        }

        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        function button_click() {
            getLoadPanelInstance().show();
        }

        function loadPanel_shown(e) {
            //    setTimeout(function () {
            //        e.component.hide();
            //    }, 3000);
        }

        function loadPanel_hidden() {
        }

        function Register(arg) {

            // 顯示旋轉鈕
            getLoadPanelInstance().show();

            // 取得註冊的按鈕
            var ButtonContainer = $("#register-button").dxButton("instance");

            // 註冊按鈕反白
            ButtonContainer.option("disabled", true);

            ShowToast("正在處理中，請稍待...", "info", 3000);

            DevExpress.ui.notify({
                displayTime: 3000,
                closeOnClick: true,
                message: "正在處理中，請稍待喔...",
                type: 'info',
            });

            // 顯示旋轉鈕
            getLoadPanelInstance().show();
        }

    </script>

    <script type="text/javascript">
        function onBegin()
        {
            // 顯示旋轉鈕
            getLoadPanelInstance().show();

            //// 取得註冊的按鈕
            //var ButtonContainer = $("#register-button").dxButton("instance");

            //// 註冊按鈕反白
            //ButtonContainer.option("disabled", true);

            //ShowToast("正在處理中，請稍待...", "success", 3000);

            //DevExpress.ui.notify({
            //    displayTime: 3000,
            //    closeOnClick: true,
            //    message: "正在處理中，請稍待喔...",
            //    type: 'success',
            //});

            // 顯示旋轉鈕
            //getLoadPanelInstance().show();
        }

        function onSuccess(data) {

            getLoadPanelInstance().hide();

            // 取得註冊的按鈕
            var ButtonContainer = $("#register-button").dxButton("instance");

            // 註冊按鈕反白
            ButtonContainer.option("disabled", false);

            if (data.status == 1) {

                //DevExpress.ui.notify( data.message, "success", 15000 );

                DevExpress.ui.notify({
                    displayTime: 15000,
                    closeOnClick: true,
                    message: data.message,
                    type: 'success',
                });

                //$("#toast").dxToast("show");

                //window.location.href = "/Home/LineBindingView/" + '@Model.EncodeUrl';
                //window.location.href = "/Home/BindingResultView/" + data.message;

                //ShowToast(data.message, "success", 3000);
                //getLoadPanelInstance().hide();

                // 隱藏註冊按鈕
                $("#register-button").dxButton("instance").option("visible", false);

                document.getElementById("LineButton").style.display = "";//顯示LINE加入好友
                //document.getElementById("LineButton").style.visibility = "hidden";//隱藏LINE加入好友
                document.getElementById("LineButton").style.visibility = "visible";//顯示LINE加入好友


                document.getElementById('displaynamefield').innerHTML = data.message;

                document.getElementById('remind').innerHTML = "請點擊下面加入好友按鈕";

            }
            else {
                DevExpress.ui.notify(data.message, "error", 5000);
                //window.location.href = "/Home/LineBindingView/" + '@Model.EncodeUrl';
                //window.location.href = "/Home/BindingResultView/" + data.message;

                document.getElementById('displaynamefield').innerHTML = data.message;
            }
        }

        function onComplete(data) {
            if (data.status == 1) {
            }
            else {
            }
        }
    </script>

    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <link href="~/css/Gallery.css" rel="stylesheet" />
    <link href="~/css/WeeklyReport.css" rel="stylesheet" />

    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

    <script>

        window.onload = function (e)
        {
            liff.init({ liffId:  '@TempData["Proponent"]' })
                .then(() =>
                {
                // 检查用户是否已登录
                  if (!liff.isLoggedIn())
                  {
                      document.getElementById('displaynamefield').innerHTML = "您還沒有登入LINE";

                      ShowToast("您還沒有登入LINE", "error", 5000);

                      liff.login();

                      return;
                  }
                  else
                  {
                      liff.permission.query("profile").then((permissionStatus) => {
                          if (permissionStatus.state === "granted") {
                              //使用者已授權
                              initializeApp();
                          }
                          else if (permissionStatus.state === "prompt") {
                              document.getElementById('displaynamefield').innerHTML = "您並未授權，請先完成授權程序!";
                              liff.permission.requestAll();
                          }
                          else {
                              document.getElementById('displaynamefield').innerHTML = "Liff Scope沒有設定，所以無法操作!";
                          }
                      });
                  }
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });
        };

        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";

        var PictureUrl = "";
        var StatusMessage = "";

        async function initializeApp() {
            await liff.getProfile()
                .then(function (profile) {
                    document.getElementById('displaynamefield').innerHTML = profile.displayName + "註冊";
                    DisplayName = profile.displayName;
                    UserId = profile.userId;
                    //alert("測試 UserId =" + UserId);
                    GroupId = profile.aGroupId;
                    RoomId = profile.aRoomId;
                    ViewType = profile.aViewType;
                    //alert("測試004!" + DisplayName);

                    PictureUrl = profile.pictureUrl;
                    StatusMessage = profile.statusMessage;

                    // 取得 UserId 的Ajax
                    UpdateLineUserId(UserId, GroupId, RoomId, ViewType, DisplayName, PictureUrl, StatusMessage);
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });

        }

        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType, aDisplayName, aPictureUrl, aStatusMessage) {
               // AJAX 區塊
               $.ajax
               (
                   {
                       url: '@Url.Action("SaveUserId", "Home")',
                       data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType, DisplayName: aDisplayName, PictureUrl: aPictureUrl, StatusMessage: aStatusMessage}, // 整理回傳給 Server 的點名資料
                       type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                       success: function (data)
                       {
                           if (data.status == 1) {
                               // 顯示上傳成功
                               ShowToast(data.message, "success", 2000);
                           }
                           else {
                               ShowToast(data.message + "，您不需要註冊了", "error", 5000);
                               document.getElementById('displaynamefield').innerHTML = data.message + "，您不需要註冊了";
                               document.getElementById('remind').innerHTML = "願神與您同在!";
                               document.getElementById("form-container").style.display = "none";//隱藏輸入欄位
                               document.getElementById("buttonContainer").style.display = "none";//隱藏輸入欄位
                               $("#register-button").dxButton("instance").option("visible", false);
                           }
                       },

                       error: function (obj)
                       {
                       }

                   }
               );
               // AJAX 區塊
        }

        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

    </script>
</body>

</html>