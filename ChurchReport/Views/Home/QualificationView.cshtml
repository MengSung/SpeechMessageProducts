<!DOCTYPE html>

@{
    Layout = null;
}
<html>

@model ChurchReport.ViewModel.LineBindingViewModel

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>好牧人</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    @* JSZip for client side export *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

</head>

<body>

    <div class="widget-container" style="padding: 10px;">
        @(Html.DevExtreme().Gallery()
                                .ID("gallery")
                                .DataSource(Model.Images)
                                .Height("250px")
                                //.Width(600)
                                //.InitialItemWidth(250)
                                .StretchImages(true)
                                .Loop(true)
                                .SlideshowDelay(1500)
        )
    </div>

    @*<div class="long-title"><h3 id="displaynamefield"></h3></div>*@
    @*<p id="demo2">測試</p>*@
    @*<p id="displaynamefield"></p>*@

    <div class="long-title"><h3 id="displaynamefield"></h3></div>

    <form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveQualificationData" asp-controller="Home" method="post" style="text-align: center;">

        <div class="dx-field" style="text-align: center;">
            <div class="form-container-class" id="form-container" style="text-align: center;">
                @(Html.DevExtreme().Form()
                                       .ID("form")
                                       .Items(items =>
                                       {

                                           items.AddSimple()
                                                .DataField("FaithStatus")
                                                .Label(l => l.Text("信仰狀態"))
                                                .Editor(e => e
                                                    .SelectBox()
                                                    .ID("spiritualIdentitySelectBox") // ✅ 新增 ID 以便 JavaScript 控制
                                                    .DataSource(new string[] {
                                                        "-未知-",
                                                    }) // ✅ 預設值
                                                    .Value("未信主")
                                                    );

                                           items.AddSimple()
                                                .DataField("GenderCode")
                                                .Label(l => l.Text("性別"))
                                                .Editor(e => e
                                                    .SelectBox()
                                                    .DataSource(new string[] {
                                                        "未知",
                                                        "男性",
                                                        "女性",
                                                    }

                                                    )
                                                    .Value("未知")
                                                    );


                                           items.AddSimple()
                                                .DataField("BirthDate")
                                                .Label(l => l.Text("生日"))
                                                .IsRequired(false)
                                                .Editor(e => e
                                                    .DateBox()
                                                    .Disabled(false)
                                                    .OnValueChanged
                                                    (@<text>
                                                                function(e)
                                                                {
                                                                //debugger;
                                                                //if( e.value != null )
                                                                //{
                                                                //debugger;

                                                                //var PayDate = ParsingDate( e.value != null );
                                                                var DateValue = e.component.option("value");

                                                                if(DateValue != undefined)
                                                                {
                                                                var ParsedDateValue = ParsingDate(e.component.option("value"))
                                                                //alert( "001: " + ParsedDateValue);
                                                                //alert( "002: " + ParsedDateValue.getFullYear());
                                                                if( ParsedDateValue.getFullYear() == 1901 )
                                                                {
                                                                //return null;
                                                                //alert( "002: ");
                                                                e.component.option("value", null);
                                                                //return DateValue;
                                                                }
                                                                else
                                                                {
                                                                //alert( "003: ");

                                                                //return e.value;
                                                                }
                                                                }
                                                                //}
                                                                //else
                                                                //{return null;}
                                                                }
                                                    </text>)
                                       .ShowClearButton(true)
                                       .Placeholder("請填寫生日")
                                   );



                           items.AddSimple()
                           .DataField("PersonalId")
                           .Label(l => l.Text("身分證字號"))
                           .Editor(e => e
                               .TextBox().Placeholder("請填寫身分證字號")
                               );

                   })
                )
            </div>
        </div>
        <div class="dx-field" style="text-align: center;">
            <div id="buttonContainer" class="dx-button-icon">
                @(Html.DevExtreme().Button()
                                        .Text("儲存")
                                        //.Type(ButtonType.Success)
                                        //.Type(ButtonType.Normal)
                                        .Type(ButtonType.Default)
                                        .ID("register-button")
                                        .UseSubmitBehavior(true)
                                        .OnClick("Register")
                                        .Width(100)
                )
            </div>
            <div id="LoadPanel">
                @(Html.DevExtreme().LoadPanel()
                                        .ID("loadPanel")
                                        .ShadingColor("rgba(0,0,0,0.4)")
                                        .Position(p => p.Of("#form-container"))
                                        .Visible(false)
                                        .ShowIndicator(true)
                                        .ShowPane(true)
                                        .Shading(true)
                                        .CloseOnOutsideClick(false)
                                        .Message("儲存中...")
                                        .Delay(5000)
                                        .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                )
            </div>
        </div>

    </form>

    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                                .ID("Toast")
                                .Position(p => p
                                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                                .Offset(0, 50))
                                .Message("以利亞")
                                .DisplayTime(2000)
                                .MaxWidth(200)
        )

    </div>


    <script>
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        function button_click() {
            getLoadPanelInstance().show();
        }

        function loadPanel_shown(e) {
            //    setTimeout(function () {
            //        e.component.hide();
            //    }, 3000);
        }

        function loadPanel_hidden() {
        }

        function Register(arg) {

            getLoadPanelInstance().show();
        }

    </script>

    <script type="text/javascript">
        function onBegin() {
        }

        function onSuccess(data) {

            getLoadPanelInstance().hide();

            if (data.status == 1) {

                //DevExpress.ui.notify( data.message, "success", 15000 );

                DevExpress.ui.notify({
                    displayTime: 5000,
                    closeOnClick: true,
                    message: data.message,
                    type: 'success',
                });

                //$("#toast").dxToast("show");

                //window.location.href = "/Home/LineBindingView/" + '@Model.EncodeUrl';
                //window.location.href = "/Home/BindingResultView/" + data.message;

                //ShowToast(data.message, "success", 3000);
                //getLoadPanelInstance().hide();
                document.getElementById('displaynamefield').innerHTML = data.message;
            }
            else {
                DevExpress.ui.notify(data.message, "error", 5000);
                //window.location.href = "/Home/LineBindingView/" + '@Model.EncodeUrl';
                //window.location.href = "/Home/BindingResultView/" + data.message;

                document.getElementById('displaynamefield').innerHTML = data.message;
            }
        }

        function onComplete(data) {
            if (data.status == 1) {
            }
            else {
            }
        }
    </script>

    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <link href="~/css/Gallery.css" rel="stylesheet" />
    <link href="~/css/WeeklyReport.css" rel="stylesheet" />
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <script src="~/js/liff-starter.js"></script>
    <script>
        // ✅ 全域變數：信仰狀態 DataSource
        var spiritualIdentityDataSource = ["-未知-", "基督徒", "已決志", "慕道友", "未信主"]; // 預設值

        // ✅ 頁面載入後，動態載入信仰狀態清單
        $(document).ready(function() {
            console.log('========================================');
            console.log('✅ [QualificationView] Script 已載入');
            console.log('========================================');
            
            // 載入信仰狀態清單
            loadSpiritualIdentityList();
        });

        // ✅ 載入信仰狀態清單的函數
        function loadSpiritualIdentityList() {
            console.log('✅ [QualificationView] 開始載入信仰狀態清單');
            
            $.ajax({
                url: '/Personal/Api/GetSpiritualIdentityList',
                type: 'GET',
                dataType: 'json',
                timeout: 10000, // 10秒超時
                success: function(response) {
                    console.log('✅ [QualificationView] API 回應:', response);
                    
                    if (response && response.success && response.data && response.data.length > 0) {
                        spiritualIdentityDataSource = response.data;
                        console.log('✅ [QualificationView] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                        
                        // ✅ 動態更新 SelectBox 的 DataSource
                        updateSpiritualIdentitySelectBox();
                    } else {
                        console.warn('⚠️ [QualificationView] API 回應格式異常，使用預設清單');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ [QualificationView] 載入信仰狀態清單失敗:', error);
                    console.error('❌ [QualificationView] 使用預設清單');
                }
            });
        }

        // ✅ 更新 SelectBox 的函數
        function updateSpiritualIdentitySelectBox() {
            try {
                var selectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
                
                if (selectBox) {
                    console.log('✅ [QualificationView] 找到 SelectBox 實例');
                    selectBox.option("dataSource", spiritualIdentityDataSource);
                    console.log('✅ [QualificationView] 成功更新 SelectBox DataSource');
                } else {
                    console.warn('⚠️ [QualificationView] 找不到 SelectBox 實例，嘗試延遲更新...');
                    
                    // 延遲 500ms 後重試
                    setTimeout(function() {
                        var retrySelectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
                        if (retrySelectBox) {
                            console.log('✅ [QualificationView] 重試成功');
                            retrySelectBox.option("dataSource", spiritualIdentityDataSource);
                        } else {
                            console.error('❌ [QualificationView] 重試後仍找不到 SelectBox 實例');
                        }
                    }, 500);
                }
            } catch (ex) {
                console.error('❌ [QualificationView] 更新 SelectBox 失敗:', ex);
            }
        }

        window.onload = function (e)
        {
            liff.init({ liffId:  '@TempData["Proponent"]' })
                .then(() =>
                {
                // 检查用户是否已登录
                  if (!liff.isLoggedIn())
                  {
                      document.getElementById('displaynamefield').innerHTML = "您還沒有登入LINE";

                      ShowToast("您還沒有登入LINE", "error", 5000);

                      liff.login();

                      return;
                  }
                  else
                  {
                      liff.permission.query("profile").then((permissionStatus) => {
                          if (permissionStatus.state === "granted") {
                              //使用者已授權
                              initializeApp();
                          }
                          else if (permissionStatus.state === "prompt") {
                              document.getElementById('displaynamefield').innerHTML = "您並未授權，請先完成授權程序!";
                              liff.permission.requestAll();
                          }
                          else {
                              document.getElementById('displaynamefield').innerHTML = "Liff Scope沒有設定，所以無法操作!";
                          }
                      });
                  }
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });
        };


        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";


        async function initializeApp() {
            await liff.getProfile()
                .then(function (profile) {
                    document.getElementById('displaynamefield').innerHTML = profile.displayName + "基本資料";
                    DisplayName = profile.displayName;
                    UserId = profile.userId;
                    //alert("測試 UserId =" + UserId);
                    GroupId = profile.aGroupId;
                    RoomId = profile.aRoomId;
                    ViewType = profile.aViewType;
                    //alert("測試004!" + DisplayName);

                    // 取得 UserId 的Ajax
                    GetQualificationData(UserId, GroupId, RoomId, ViewType);
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });

        }



        function GetQualificationData(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("GetQualificationData", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                //debugger;
                                //alert("取得使用者ID" + data.message);

                                //alert("信仰 : " + data.faithStatus);
                                // formInstance.updateData('YourDataField', YourNewValue);

                                $("#form").dxForm("instance").updateData('FaithStatus', data. faithStatus);
                                $("#form").dxForm("instance").updateData('GenderCode', data.genderCode);
                                $("#form").dxForm("instance").updateData('BirthDate', data.birthDate);
                                $("#form").dxForm("instance").updateData('PersonalId', data.personalId);

                                getLoadPanelInstance().hide();
                            },

                            error: function (obj)
                            {
                            }

                        }
                    );
                    // AJAX 區塊
        }
        function UpdateQualificationData(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SaveQualificationData", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                //debugger;
                                //alert("取得使用者ID" + data.message);

                                //alert("信仰 : " + data.faithStatus);
                                // formInstance.updateData('YourDataField', YourNewValue);
                                $("#form").dxForm("instance").updateData('FaithStatus', data. faithStatus);
                                $("#form").dxForm("instance").updateData('GenderCode', data.genderCode);
                                $("#form").dxForm("instance").updateData('BirthDate', data.birthDate);
                                $("#form").dxForm("instance").updateData('PersonalId', data.personalId);

                            },

                            error: function (obj)
                            {
                            }

                        }
                    );
                    // AJAX 區塊
        }

        function ParsingDate(input) {

            debugger;
            if (typeof (input) === 'string') {
                //alert("ParseDate 001 : " + input);
                var parts = input.split('-');

                var DaySplitedArray = parts[2].split('T');
                //var ParsedDate = new Date(parts[0], parts[1] - 1, DaySplitedArray[0]);
                var ParsedDate = new Date(parts[0], parts[1], DaySplitedArray[0]);
                //var ParsedDate = new Date(parts[0], parts[1], parts[2]);
                //var ParsedDate = new Date(parts[0], parts[1], DaySplitedArray[0]);

                //alert("ParseDate 002 : " + ParsedDate);

                return ParsedDate;
            }
            else {
                return getLocalDateFilter(input);
            }
        }
        function getLocalDateFilter(date) {

            debugger;

            //alert("getODataLocalDateFilter !" + date);
            //alert("HELLO 我愛嘟嘟妞妞 006!" + date);

            //-- Description: For converting the date object to local time format
            //-- You can also convert this to UTC Date format
            //-- UTC Usage: getUTCMonth(), getUTCFullYear(), getUTCHours() ...

            var monthString;
            var rawMonth = (date.getMonth() + 1).toString();
            if (rawMonth.length == 1) {
                monthString = "0" + rawMonth;
            }
            else { monthString = rawMonth; }

            var dateString;
            //var rawDate = date.getUTCDate().toString();
            var rawDate = date.getDate().toString();
            if (rawDate.length == 1) {
                dateString = "0" + rawDate;
            }
            else { dateString = rawDate; }


            var DateFilter = "";
            //DateFilter += date.getFullYear() + "-";
            //DateFilter += monthString + "-";
            //DateFilter += dateString;
            //DateFilter += " T" + date.getHours() + ":";
            //DateFilter += date.getMinutes() + ":";
            //DateFilter += date.getSeconds() + ":";
            //DateFilter += date.getMilliseconds();

            //return DateFilter;

            //return date.getFullYear() + "/" + rawMonth + "/" + rawDate;

            return new Date(date.getFullYear(), rawMonth, rawDate);
        }

        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

    </script>
</body>

</html></html>