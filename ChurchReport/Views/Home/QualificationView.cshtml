        function GetQualificationData(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("GetQualificationData", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                //debugger;
                                //alert("取得使用者ID" + data.message);

                                //alert("信仰 : " + data.faithStatus);
                                // formInstance.updateData('YourDataField', YourNewValue);

                                $("#form").dxForm("instance").updateData('FaithStatus', data. faithStatus);
                                $("#form").dxForm("instance").updateData('GenderCode', data.genderCode);
                                $("#form").dxForm("instance").updateData('BirthDate', data.birthDate);

                                getLoadPanelInstance().hide();
                            },

                            error: function (obj)
                            {
                            }

                        }
                    );
                    // AJAX 區塊
        }
        function UpdateQualificationData(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SaveQualificationData", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                //debugger;
                                //alert("取得使用者ID" + data.message);

                                //alert("信仰 : " + data.faithStatus);
                                // formInstance.updateData('YourDataField', YourNewValue);
                                $("#form").dxForm("instance").updateData('FaithStatus', data. faithStatus);
                                $("#form").dxForm("instance").updateData('GenderCode', data.genderCode);
                                $("#form").dxForm("instance").updateData('BirthDate', data.birthDate);
                            },

                            error: function (obj)
                            {
                            }

                        }
                    );
                    // AJAX 區塊
        }

        function ParsingDate(input) {

            debugger;
            if (typeof (input) === 'string') {
                //alert("ParseDate 001 : " + input);
                var parts = input.split('-');

                var DaySplitedArray = parts[2].split('T');
                //var ParsedDate = new Date(parts[0], parts[1] - 1, DaySplitedArray[0]);
                var ParsedDate = new Date(parts[0], parts[1], DaySplitedArray[0]);
                //var ParsedDate = new Date(parts[0], parts[1], parts[2]);
                //var ParsedDate = new Date(parts[0], parts[1], DaySplitedArray[0]);

                //alert("ParseDate 002 : " + ParsedDate);

                return ParsedDate;
            }
            else {
                return getLocalDateFilter(input);
            }
        }
        function getLocalDateFilter(date) {

            debugger;

            //alert("getODataLocalDateFilter !" + date);
            //alert("HELLO 我愛嘟嘟妞妞 006!" + date);

            //-- Description: For converting the date object to local time format
            //-- You can also convert this to UTC Date format
            //-- UTC Usage: getUTCMonth(), getUTCFullYear(), getUTCHours() ...

            var monthString;
            var rawMonth = (date.getMonth() + 1).toString();
            if (rawMonth.length == 1) {
                monthString = "0" + rawMonth;
            }
            else { monthString = rawMonth; }

            var dateString;
            //var rawDate = date.getUTCDate().toString();
            var rawDate = date.getDate().toString();
            if (rawDate.length == 1) {
                dateString = "0" + rawDate;
            }
            else { dateString = rawDate; }


            var DateFilter = "";
            //DateFilter += date.getFullYear() + "-";
            //DateFilter += monthString + "-";
            //DateFilter += dateString;
            //DateFilter += " T" + date.getHours() + ":";
            //DateFilter += date.getMinutes() + ":";
            //DateFilter += date.getSeconds() + ":";
            //DateFilter += date.getMilliseconds();

            //return DateFilter;

            //return date.getFullYear() + "/" + rawMonth + "/" + rawDate;

            return new Date(date.getFullYear(), rawMonth, rawDate);
        }

    </script>
