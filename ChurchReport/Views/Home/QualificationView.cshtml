        //    UserProfile = liff.getProfile();
        //    alert("測試003!" + UserProfile);
        //    alert("測試004!" + UserProfile.displayName);

        //    return UserProfile.displayName;
        //}

        //document.getElementById("displaynamefield").innerHTML = GetDisplayName();


        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";


