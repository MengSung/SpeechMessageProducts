<script>
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容", // 在這裡可以做最後的字典對應
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date"
        },
    };
    DevExpress.localization.loadMessages(dictionary);
    var formatMessage = DevExpress.localization.formatMessage;

    var locale = getLocale();
    //DevExpress.localization.locale(navigator.language || navigator.browserLanguage);
    DevExpress.localization.locale(locale);

    function changeLocale(data) {
        setLocale(data.value);
        document.location.reload();
    }

    function getLocale() {
        //debugger;
        //sessionStorage.setItem("locale", 'zh');
        sessionStorage.setItem("locale", 'zh-tw');
        var locale = sessionStorage.getItem("locale");
        return locale != null ? locale : "tw";
    }

    function OnOptionChanged(e)
    {
        //debugger;
        //if (e.name == 'currentDate'|| e.name == "currentView")
        //{
        //    alert( "001:" + e.name + ': ' + e.value);
        //}
        if (e.fullName == "currentDate" || e.fullName == "currentView")
        {

            $.ajax({
                url: '@Url.Action("NavigateAppointmentDate", "Home")',
                data: { SelectedDate: e.value },
                type: 'GET', //POST if you want to save, GET if you want to fetch data from server

                success: function (arg) {

                },

                error: function (obj) {
                    //alert('Something happened');
                }

            });

        }

    }

</script>


<script src="https://d.line-scdn.net/liff/1.0/sdk.js"></script>
<script src="~/js/liff-starter.js"></script>

<script>

        window.onload = function (e) {
            liff.init(function (data) {
                //debugger;
                //alert("測試001!");
                initializeApp(data);
            });
        };


        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";


        function initializeApp(data) {
            UserId = data.context.userId;
            GroupId = data.context.groupId;
            RoomId = data.context.roomId;
            ViewType = data.context.viewType;
            //document.getElementById('languagefield').textContent = data.language;
            //document.getElementById('viewtypefield').textContent = data.context.viewType;
            //document.getElementById('useridfield').textContent = data.context.userId;
            //document.getElementById('utouidfield').textContent = data.context.utouId;
            //document.getElementById('roomidfield').textContent = data.context.roomId;
            //document.getElementById('groupidfield').textContent = data.context.groupId;

            //debugger;
            //alert("測試002!" + data.context.userId);

            //getLoadPanelInstance().show();

            UpdateLineUserId(data.context.userId, data.context.groupId, data.context.roomId, data.context.viewType);

            //alert("測試003!" );

            liff.getProfile().then(function (profile) {
                //document.getElementById('useridprofilefield').textContent = profile.userId;
                //document.getElementById('displaynamefield').textContent = profile.displayName;

                document.getElementById('displaynamefield').innerHTML = profile.displayName + "的行事曆";

                //getSchedulerInstance().reload();
                //$("#scheduler").dxScheduler("getDataSource").reload()



                //var schedulerInstance = getSchedulerInstance();  
                //schedulerInstance.getDataSource().reload();

                DisplayName = profile.displayName;

                //alert("測試004!" + profile.displayName);
            });
        }


        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("LoadAppointmentByLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                //getLoadPanelInstance().hide();
                                var schedulerInstance = getSchedulerInstance();  
                                schedulerInstance.getDataSource().reload();
                                schedulerInstance.repaint();

                                //window.location.href = "/Home/SchedulerView"
                            },

                            error: function (obj)
                            {
                                //getLoadPanelInstance().hide();
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }


        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }

</script>

