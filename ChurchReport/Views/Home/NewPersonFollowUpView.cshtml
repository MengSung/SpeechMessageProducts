@{
    String DataStatus = "上傳成功了!";
    String ReUpload = "您的代禱事項尚未儲存，請再上傳一次!";
}


@model ChurchReport.Models.SmallGroupData

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>神助611靈糧堂</title>

</head>

<h3>@(Model.SmallGroupLeaderFullName + "新人關懷")</h3>

<div class="dx-field">
    <div id="the whole thing" style="height:100%; width:100%; overflow: hidden;">
        <div id="SundayLabel" class="dx-field-label" style="float: left; width:15%; background-color:white;">小組日期</div>
        <div id="dateBoxContainer" class="dx-field-value" style="float: left; width:55%; background-color:white;">

            @(Html.DevExtreme()
                        //.DateBox()
                        .DateBoxFor(m => m.SundayPrayers)
                        .Type(DateBoxType.Date)
                        .Value(Model.SundayPrayers)
                        .Width(50)
                        .DisplayFormat("yyyy/M/d")
                        .CalendarOptions( k=>k.FirstDayOfWeek(0))
                        //.OnValueChanged("OnValueChanged")


                        .OnValueChanged(@<text>
                            function(arg) {

                            $("#loadPanel").dxLoadPanel("instance").show();

                            $.ajax({
                            url: '@Url.Action("UpdateDate", "Home")',
                            data: { SelectedDate: getODataLocalDateFilter(arg.value) },
                            type: 'GET', //POST if you want to save, GET if you want to fetch data from server

                            success: function (arg)
                            {
                            //alert("001");
                            $("#loadPanel").dxLoadPanel("instance").hide();

                            //var dataGridInstance = $("#gridContainer").dxDataGrid("instance");
                            //dataGridInstance.refresh();
                            //alert("002");

                            window.location.href = "/Home/SmallGroupReportView/AccountPassword"
                            //alert("003");

                            },

                            error: function (obj) {
                            //alert('Something happened');
                            }

                            });
                            }
                        </text>
                                        )

            )
        </div>
        <div id="buttonContainer" class="dx-button-icon" style="float: left; width:30%; text-align: left; background-color:white;">
            @(Html.DevExtreme().Button()
                        .Text("上傳").Height(50).Width(80).Icon("check")
                        .Type(ButtonType.Success)
                        .ID("save-button")
                        //.UseSubmitBehavior(true)

                        .OnClick
                        (@<text>
                            function(arg)
                            {
                            // 顯示旋轉鈕
                            $("#loadPanel").dxLoadPanel("instance").show();

                            var dataGrid = $("#gridContainer").dxDataGrid("instance");

                            //debugger;
                            var Flag = dataGrid.hasEditData();

                            if(Flag == false)
                            {
                            // AJAX 區塊
                            $.ajax
                            (
                            {
                            url: '@Url.Action("SaveNewPersonFollowUp", "Home")',
                            data: { aResult: GetResult() }, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (arg)
                            {
                            // 隱藏旋轉鈕
                            $("#loadPanel").dxLoadPanel("instance").hide();

                            // 顯示上傳成功
                            $("#toast").dxToast("instance").show();
                            },

                            error: function (obj)
                            {
                            //alert('Something happened');
                            }

                            }
                            );
                            // AJAX 區塊
                            }
                            else
                            {
                            // 隱藏旋轉鈕
                            $("#loadPanel").dxLoadPanel("instance").hide();

                            // 顯示再上傳一次
                            $("#ToastReUpload").dxToast("instance").show();
                            }
                            }
                        </text>)
            )
        </div>

        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                        .ID("toast")
                        .Position(p => p
                        .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                        .Offset(0, 50))
                        .Message(DataStatus)
                        .DisplayTime(2000)
                        .MaxWidth(200)
            )

        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                        .ID("ToastReUpload")
                        .Position(p => p
                        .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                        .Offset(0, 50))
                        .Message(ReUpload)
                        .DisplayTime(5000)
                        .Type(ToastType.Error)
                        .MaxWidth(500)
            )

        </div>

        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                        .ID("loadPanel")
                        .ShadingColor("rgba(0,0,0,0.4)")
                        .Position(p => p.Of("#data-grid"))
                        .Visible(false)
                        .ShowIndicator(true)
                        .ShowPane(true)
                        .Shading(true)
                        .CloseOnOutsideClick(false)
                        .Message("更新資料中...")
                        .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                    //.OnShown("loadPanel_shown")
                    //.OnHidden("loadPanel_hidden")
            )
        </div>
    </div>
</div>

<hr />
