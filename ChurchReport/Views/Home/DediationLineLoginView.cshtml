<!DOCTYPE html>

@{
    Layout = null;
}
<html>

@model ChurchReport.ViewModel.LineBindingViewModel

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>聖谷行道會</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    @* JSZip for client side export *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

    <style>
        /* Elegant, subtle background */
        body.elegant-bg {
            min-height: 100vh;
            background: linear-gradient(135deg, #f7f8fc 0%, #eef3ff 100%);
            color: #2d3748;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji", sans-serif;
        }

        .hero {
            padding: 32px 0 16px 0;
            text-align: center;
        }

        .hero-title {
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #1a202c;
            margin-bottom: 6px;
        }

        .hero-sub {
            color: #718096;
            font-size: 14px;
            margin-bottom: 16px;
        }

        .gallery-wrap {
            padding: 0 16px 8px 16px;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(30, 41, 59, 0.08);
            backdrop-filter: saturate(140%) blur(6px);
            -webkit-backdrop-filter: saturate(140%) blur(6px);
            overflow: hidden;
        }

        .card-body-soft {
            padding: 24px;
        }

        .info-list {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

        .info-list li {
            display: flex;
            align-items: baseline;
            padding: 6px 0;
            border-bottom: 1px dashed #e2e8f0;
        }

        .info-list li:last-child {
            border-bottom: 0;
        }

        .info-label {
            min-width: 72px;
            color: #4a5568;
            font-weight: 600;
            margin-right: 8px;
        }

        .info-value { color: #2d3748; }

        .hint { color: #718096; font-size: 13px; margin-top: 12px; }

        .status-line {
            margin: 8px 0 0 0;
            font-size: 14px;
            color: #2b6cb0;
            font-weight: 600;
            text-align: center;
        }

        .footer-note { font-size: 12px; color: #a0aec0; text-align: center; padding: 16px 0 8px; }

        @@media (min-width: 768px) {
            .card-body-soft { padding: 28px 32px; }
        }
    </style>

</head>

<body class="elegant-bg">

    <div class="hero">
        <h2 class="hero-title">聖谷行道會</h2>
        <div id="displaynamefield" class="status-line"></div>
    </div>

    <div class="gallery-wrap">
        <div class="glass-card">
            @(Html.DevExtreme().Gallery()
                .ID("gallery")
                .DataSource(Model.Images)
                .Height("250px")
                .StretchImages(true)
                .Loop(true)
                .SlideshowDelay(500)
            )
        </div>
    </div>

    <div class="container" style="max-width: 880px; padding: 16px;">
        <div class="glass-card">
            <div class="card-body-soft">
                <div class="row">
                    <div class="col-md-7">
                        <h5 style="font-weight:600; margin-bottom: 12px;">聯絡資訊</h5>
                        <ul class="info-list">
                            <li>
                                <span class="info-label">地址</span>
                                <span class="info-value">新北市新店區安興路91巷5號</span>
                            </li>
                            <li>
                                <span class="info-label">電話</span>
                                <span class="info-value">02-2211-1556 (代表號)</span>
                            </li>
                            <li>
                                <span class="info-label">信箱</span>
                                <span class="info-value">sunnyvale.church@gmail.com</span>
                            </li>
                            <li>
                                <span class="info-label">統編</span>
                                <span class="info-value">20004335</span>
                            </li>
                        </ul>
                        <div class="hint">若有任何奉獻相關問題，請洽曾淑芬姊妹，謝謝您。</div>
                    </div>
                    <div class="col-md-5">
                        <h5 style="font-weight:600; margin-bottom: 12px;">奉獻登入</h5>
                        <p style="color:#4a5568; font-size:14px;">請使用 LINE 登入並完成授權後，系統將自動導向奉獻頁面。</p>
                        <div id="LoadPanelSection"></div>
                        <div class="hint">登入過程中請勿關閉視窗。</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-note">Copyright © @DateTime.Now.Year 聖谷行道會</div>
    </div>

    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
            .ID("Toast")
            .Position(p => p
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Offset(0, 50))
            .Message("上傳成功了!")
            .DisplayTime(20000)
            .MaxWidth(220)
        )
    </div>

    <script>
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        function button_click() {
            getLoadPanelInstance().show();
        }

        function loadPanel_shown(e) {
            getLoadPanelInstance().show();
            //    setTimeout(function () {
            //        e.component.hide();
            //    }, 3000);
        }

        function loadPanel_hidden() {
            getLoadPanelInstance().hide();
        }

        function Binding(arg) {
            //客製化
            window.location.href = "/Home/LineLiffView/1653819697-YkPyPkr6";
        }

        function Login(arg) {
            window.location.href = "/Home/Login";
        }

    </script>

    <script>

        window.onload = function (e)
        {
            liff.init({ liffId:  '@TempData["Proponent"]' })
                .then(() =>
                {
                // 检查用户是否已登录
                  if (!liff.isLoggedIn())
                  {
                      document.getElementById('displaynamefield').innerHTML = "您還沒有登入LINE";

                      ShowToast("您還沒有登入LINE", "error", 5000);

                      liff.login();

                      return;
                  }
                  else
                  {
                      liff.permission.query("profile").then((permissionStatus) => {
                          if (permissionStatus.state === "granted") {
                              //使用者已授權
                              initializeApp();
                          }
                          else if (permissionStatus.state === "prompt") {
                              document.getElementById('displaynamefield').innerHTML = "您並未授權，請先完成授權程序!";
                              liff.permission.requestAll();
                          }
                          else {
                              document.getElementById('displaynamefield').innerHTML = "Liff Scope沒有設定，所以無法操作!";
                          }
                      });
                  }
                })
                .catch(error => {
                    // 錯誤處理 Liff LLogin
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });
        };

        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";



        async function initializeApp()
        {
            await liff.getProfile()
            .then(function (profile) {
                document.getElementById('displaynamefield').innerHTML = profile.displayName + "<br/> 登入奉獻中，請稍待......";

                DisplayName = profile.displayName;
                UserId = profile.userId;
                //alert("測試 UserId =" + UserId);
                GroupId = profile.aGroupId;
                RoomId = profile.aRoomId;
                ViewType = profile.aViewType;
                //alert("測試004!" + DisplayName);

                // 取得 UserId 的Ajax
                UpdateLineUserId(UserId, GroupId, RoomId, ViewType);
            })
            .catch(error => {
                // 錯誤處理 Liff LLogin
                document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
            });

        }

        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType ) {
                    // AJAX 區塊
                    $.ajax
                    (
                        {
                            url: '@Url.Action("SetupUserLineId", "Home")',
                            data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType}, // 整理回傳給 Server 的點名資料
                            type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                            success: function (data)
                            {
                                // 客製化
                                // 為了能夠符合Apple Pay所以iPhone要能夠在Safari 瀏覽器開啟
                                //liff.openWindow({
                                //    url: "https://apbolc.speechmessage.com.tw:392/Home/QPayView/" + aUserLineId, // URL for another LIFF app
                                //    external: true
                                //});

                                //window.close();

                                // 用Line自己的網頁瀏覽器，比較快，但是Apple Pay不成功
                                window.location.href = "/Home/QPayView/" + aUserLineId;
                            },

                            error: function (obj)
                            {
                                getLoadPanelInstance().hide();
                                window.location.href = "/Home/Login";
                            }

                        }
                    );
                    // AJAX 區塊
        }


        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            //debugger;
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }
    </script>
    <link href="~/css/Gallery.css" rel="stylesheet" />
    <link href="~/css/WeeklyReport.css" rel="stylesheet" />
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
</body>

</html>