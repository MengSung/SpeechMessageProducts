                // 延遲 1 秒後重試
                setTimeout(function() {
                    var retrySelectBox = $("#familyStatusSelectBox").dxSelectBox("instance");
                    if (retrySelectBox) {
                        console.log('✅ [NewPerson] 重試成功，找到婚姻狀態 SelectBox 實例');
