                    } else {
                        console.error('❌ [NewPerson] 重試後仍找不到婚姻狀態 SelectBox 實例');
                    }
                }, 1000);
            }
        } catch (ex) {
            console.error('❌ [NewPerson] 更新婚姻狀態 SelectBox 失敗:', ex);
            console.error('❌ [NewPerson] 錯誤堆疊:', ex.stack);
