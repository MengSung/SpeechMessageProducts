                } else {
                    console.warn('⚠️ [NewPerson] 婚姻狀態 API 回應格式異常，使用預設清單');
                }
            },
            error: function(xhr, status, error) {
                console.log('========================================');
                console.error('❌ [NewPerson] 婚姻狀態 AJAX Error!');
                console.error('❌ [NewPerson] Status:', status);
                console.error('❌ [NewPerson] Error:', error);
