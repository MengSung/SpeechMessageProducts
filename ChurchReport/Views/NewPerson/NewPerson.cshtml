    var familyStatusDataSource = ["未知", "已婚", "未婚", "離異", "喪偶", "單身", "單親", "失婚", "婚姻", "離婚"]; // 預設值
    
    // ✅ 全域變數：委身類型 DataSource
    var customerTypeCodeDataSource = ["新朋友", "小組組員"]; // 預設值

    // ✅ 立即執行測試
    console.log('========================================');
    console.log('✅ [NewPerson] Script 已載入');
    console.log('✅ [NewPerson] jQuery 版本:', $.fn.jquery);
    console.log('========================================');

    // ✅ 頁面載入後，立即測試 API
    $(document).ready(function() {
        console.log('========================================');
        console.log('✅ [NewPerson] $(document).ready 被觸發');
        console.log('✅ [NewPerson] 當前 URL:', window.location.href);
        console.log('========================================');
        
        // 載入信仰狀態清單
        loadSpiritualIdentityList();
        
        // ✅ 載入婚姻狀態清單
        loadFamilyStatusList();
        
        // ✅ 載入委身類型清單
        loadCustomerTypeCodeList();
    });

    // ✅ 載入信仰狀態清單的函數
    function loadSpiritualIdentityList() {
        console.log('========================================');
        console.log('✅ [NewPerson] loadSpiritualIdentityList 被呼叫');
        console.log('✅ [NewPerson] 準備發送 AJAX 請求到: /Personal/Api/GetSpiritualIdentityList');
        console.log('========================================');
        
        $.ajax({
            url: '/Personal/Api/GetSpiritualIdentityList',
            type: 'GET',
            dataType: 'json',
            timeout: 10000, // 10秒超時
            beforeSend: function() {
                console.log('✅ [NewPerson] AJAX beforeSend - 請求即將發送');
            },
            success: function(response) {
                console.log('========================================');
                console.log('✅ [NewPerson] AJAX Success!');
                console.log('✅ [NewPerson] API 回應:', response);
                console.log('✅ [NewPerson] 回應類型:', typeof response);
                console.log('========================================');
                
                if (response && response.success && response.data && response.data.length > 0) {
                    spiritualIdentityDataSource = response.data;
                    console.log('✅ [NewPerson] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                    console.log('✅ [NewPerson] 清單長度:', spiritualIdentityDataSource.length);
                    
                    // ✅ 動態更新 SelectBox 的 DataSource
                    updateSelectBox();
                } else {
                    console.warn('⚠️ [NewPerson] API 回應格式異常');
                    console.warn('⚠️ [NewPerson] response.success:', response ? response.success : 'undefined');
                    console.warn('⚠️ [NewPerson] response.data:', response ? response.data : 'undefined');
                }
            },
            error: function(xhr, status, error) {
                console.log('========================================');
                console.error('❌ [NewPerson] AJAX Error!');
                console.error('❌ [NewPerson] Status:', status);
                console.error('❌ [NewPerson] Error:', error);
                console.error('❌ [NewPerson] XHR Status:', xhr.status);
                console.error('❌ [NewPerson] XHR StatusText:', xhr.statusText);
                if (xhr && xhr.responseText) {
                    console.error('❌ [NewPerson] Response Text:', xhr.responseText);
                }
                console.log('========================================');
            },
            complete: function() {
                console.log('✅ [NewPerson] AJAX Complete - 請求已完成（無論成功或失敗）');
            }
        });
    }

    // ✅ 更新 SelectBox 的函數
    function updateSelectBox() {
        console.log('========================================');
        console.log('✅ [NewPerson] updateSelectBox 被呼叫');
        console.log('========================================');
        
        try {
            var selectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
            
            if (selectBox) {
                console.log('✅ [NewPerson] 找到 SelectBox 實例');
                selectBox.option("dataSource", spiritualIdentityDataSource);
                console.log('✅ [NewPerson] 成功更新 SelectBox DataSource');
                console.log('✅ [NewPerson] 新 DataSource:', selectBox.option("dataSource"));
            } else {
                console.warn('⚠️ [NewPerson] 找不到 SelectBox 實例，嘗試再次查找...');
                
                // 延遲 1 秒後重試
                setTimeout(function() {
                    var retrySelectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
                    if (retrySelectBox) {
                        console.log('✅ [NewPerson] 重試成功，找到 SelectBox 實例');
                        retrySelectBox.option("dataSource", spiritualIdentityDataSource);
                        console.log('✅ [NewPerson] 成功更新 SelectBox DataSource (重試)');
                    } else {
                        console.error('❌ [NewPerson] 重試後仍找不到 SelectBox 實例');
                    }
                }, 1000);
            }
        } catch (ex) {
            console.error('❌ [NewPerson] 更新 SelectBox 失敗:', ex);
            console.error('❌ [NewPerson] 藏誤堆疊:', ex.stack);
        }
    }

