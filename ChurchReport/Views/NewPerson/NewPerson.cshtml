        console.log('✅ [NewPerson] 準備發送 AJAX 請求到: /Personal/Api/GetMembershipStatusList');
        console.log('========================================');
        
        $.ajax({
            url: '/Personal/Api/GetMembershipStatusList',
            type: 'GET',
            dataType: 'json',
            timeout: 10000, // 10秒超時
            beforeSend: function() {
                console.log('✅ [NewPerson] AJAX beforeSend - 委身類型請求即將發送');
            },
            success: function(response) {
                console.log('========================================');
                console.log('✅ [NewPerson] 委身類型 AJAX Success!');
                console.log('✅ [NewPerson] API 回應:', response);
                console.log('========================================');
                
                if (response && response.success && response.data && response.data.length > 0) {
                    customerTypeCodeDataSource = response.data;
                    console.log('✅ [NewPerson] 成功載入委身類型清單:', customerTypeCodeDataSource);
                    console.log('✅ [NewPerson] 清單長度:', customerTypeCodeDataSource.length);
                    
                    // ✅ 動態更新 SelectBox 的 DataSource
                    updateCustomerTypeCodeSelectBox();
                } else {
                    console.warn('⚠️ [NewPerson] 委身類型 API 回應格式異常，使用預設清單');
                }
            },
            error: function(xhr, status, error) {
                console.log('========================================');
                console.error('❌ [NewPerson] 委身類型 AJAX Error!');
                console.error('❌ [NewPerson] Status:', status);
                console.error('❌ [NewPerson] Error:', error);
                console.error('❌ [NewPerson] 使用預設清單');
                console.log('========================================');
            },
            complete: function() {
                console.log('✅ [NewPerson] 委身類型 AJAX Complete');
            }
        });
    }

    // ✅ 更新委身類型 SelectBox 的函數
    function updateCustomerTypeCodeSelectBox() {
        console.log('========================================');
        console.log('✅ [NewPerson] updateCustomerTypeCodeSelectBox 被呼叫');
        console.log('========================================');
        
        try {
            var selectBox = $("#customerTypeCodeSelectBox").dxSelectBox("instance");
            
            if (selectBox) {
                console.log('✅ [NewPerson] 找到委身類型 SelectBox 實例');
                selectBox.option("dataSource", customerTypeCodeDataSource);
                
                // ✅ 設定預設值為包含"新朋友"的選項（對應 OptionSet 值 100000000）
                // 從動態載入的清單中尋找包含"新朋友"的選項（支援"08. 新朋友"或"新朋友"）
                var defaultValue = null;
                for (var i = 0; i < customerTypeCodeDataSource.length; i++) {
                    if (customerTypeCodeDataSource[i].includes("新朋友")) {
                        defaultValue = customerTypeCodeDataSource[i];
                        break;
                    }
                }
                
                if (defaultValue) {
                    selectBox.option("value", defaultValue);
                    console.log('✅ [NewPerson] 成功設定委身類型預設值為:', defaultValue);
                } else if (customerTypeCodeDataSource.length > 0) {
                    // 如果找不到包含"新朋友"的選項，使用第一個選項
                    selectBox.option("value", customerTypeCodeDataSource[0]);
                    console.log('⚠️ [NewPerson] 找不到"新朋友"，使用第一個選項:', customerTypeCodeDataSource[0]);
                }
                
                console.log('✅ [NewPerson] 成功更新委身類型 SelectBox DataSource');
                console.log('✅ [NewPerson] 新 DataSource:', selectBox.option("dataSource"));
                console.log('✅ [NewPerson] 當前值:', selectBox.option("value"));
            } else {
                console.warn('⚠️ [NewPerson] 找不到委身類型 SelectBox 實例，嘗試再次查找...');
                
                // 延遲 1 秒後重試
                setTimeout(function() {
                    var retrySelectBox = $("#customerTypeCodeSelectBox").dxSelectBox("instance");
                    if (retrySelectBox) {
                        console.log('✅ [NewPerson] 重試成功，找到委身類型 SelectBox 實例');
                        retrySelectBox.option("dataSource", customerTypeCodeDataSource);
                        
                        // ✅ 設定預設值為包含"新朋友"的選項
                        var defaultValue = null;
                        for (var i = 0; i < customerTypeCodeDataSource.length; i++) {
                            if (customerTypeCodeDataSource[i].includes("新朋友")) {
                                defaultValue = customerTypeCodeDataSource[i];
                                break;
                            }
                        }
                        
                        if (defaultValue) {
                            retrySelectBox.option("value", defaultValue);
                            console.log('✅ [NewPerson] (重試) 成功設定委身類型預設值為:', defaultValue);
                        } else if (customerTypeCodeDataSource.length > 0) {
                            retrySelectBox.option("value", customerTypeCodeDataSource[0]);
                            console.log('⚠️ [NewPerson] (重試) 找不到"新朋友"，使用第一個選項:', customerTypeCodeDataSource[0]);
                        }
                        
                        console.log('✅ [NewPerson] 成功更新委身類型 SelectBox DataSource (重試)');
                    } else {
                        console.error('❌ [NewPerson] 重試後仍找不到委身類型 SelectBox 實例');
                    }
                }, 1000);
            }
        } catch (ex) {
            console.error('❌ [NewPerson] 更新委身類型 SelectBox 失敗:', ex);
            console.error('❌ [NewPerson] 錯誤堆疊:', ex.stack);
        }
    }

