        console.log('✅ [NewPerson] loadSpiritualIdentityList 被呼叫');
        console.log('✅ [NewPerson] 準備發送 AJAX 請求到: /Personal/Api/GetSpiritualIdentityList');
        console.log('========================================');
        
        $.ajax({
            url: '/Personal/Api/GetSpiritualIdentityList',
            type: 'GET',
            dataType: 'json',
            timeout: 10000, // 10秒超時
            beforeSend: function() {
                console.log('✅ [NewPerson] AJAX beforeSend - 請求即將發送');
            },
            success: function(response) {
                console.log('========================================');
                console.log('✅ [NewPerson] AJAX Success!');
                console.log('✅ [NewPerson] API 回應:', response);
                console.log('✅ [NewPerson] 回應類型:', typeof response);
                console.log('========================================');
                
                if (response && response.success && response.data && response.data.length > 0) {
                    spiritualIdentityDataSource = response.data;
                    console.log('✅ [NewPerson] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                    console.log('✅ [NewPerson] 清單長度:', spiritualIdentityDataSource.length);
                    
                    // ✅ 動態更新 SelectBox 的 DataSource
                    updateSelectBox();
                } else {
                    console.warn('⚠️ [NewPerson] API 回應格式異常');
                    console.warn('⚠️ [NewPerson] response.success:', response ? response.success : 'undefined');
                    console.warn('⚠️ [NewPerson] response.data:', response ? response.data : 'undefined');
                }
            },
            error: function(xhr, status, error) {
                console.log('========================================');
                console.error('❌ [NewPerson] AJAX Error!');
                console.error('❌ [NewPerson] Status:', status);
                console.error('❌ [NewPerson] Error:', error);
                console.error('❌ [NewPerson] XHR Status:', xhr.status);
                console.error('❌ [NewPerson] XHR StatusText:', xhr.statusText);
                if (xhr && xhr.responseText) {
                    console.error('❌ [NewPerson] Response Text:', xhr.responseText);
                }
                console.log('========================================');
            },
            complete: function() {
                console.log('✅ [NewPerson] AJAX Complete - 請求已完成（無論成功或失敗）');
            }
        });
    }

    // ✅ 更新 SelectBox 的函數
    function updateSelectBox() {
        console.log('========================================');
        console.log('✅ [NewPerson] updateSelectBox 被呼叫');
        console.log('========================================');
        
        try {
            var selectBox = $("#spiritualIdentitySelectBox").dxSelectBox("instance");
            
