<script>
    function uploadImage(input) {
        if (!input.files || input.files.length === 0) {
            return;
        }

        var file = input.files[0];
        var maxSize = 5 * 1024 * 1024;
        if (file.size > maxSize) {
            showImageUploadToast('檔案過大，請選擇小於 5MB 的圖片', 'error');
            input.value = '';
            return;
        }

        var allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
        if (allowedTypes.indexOf(file.type) === -1) {
            showImageUploadToast('只支援 JPG、PNG、GIF 格式', 'error');
            input.value = '';
            return;
        }

        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('profileImage').src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function showImageUploadToast(message, type) {
        var toast = $('#imageUploadToast').dxToast('instance');
        toast.option('message', message);
        toast.option('type', type);
        toast.show();
    }

    function uploadNewPersonImage() {
        var input = document.getElementById('imageFileInput');
        if (!input || !input.files || input.files.length === 0) {
            console.log('[uploadNewPersonImage] 沒有選擇檔案');
            return;
        }

        var formData = new FormData();
        formData.append('imageFile', input.files[0]);

        console.log('[uploadNewPersonImage] 開始上傳新人照片...');
        getLoadPanelInstance().show();

        $.ajax({
            url: '@Url.Action("UploadNewPersonImage", "NewPerson")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                console.log('[uploadNewPersonImage] 上傳成功:', response);
                getLoadPanelInstance().hide();

                if (response && response.success) {
                    showImageUploadToast(response.message, 'success');
                    // ✅ 上傳成功後重置圖片預覽為預設圖片
                    document.getElementById('profileImage').src = '~/assets/images/ChurchLogo.png';
                } else {
                    showImageUploadToast(response && response.message ? response.message : '上傳失敗', 'error');
                }

                input.value = '';
            },
            error: function(xhr, status, error) {
                console.error('[uploadNewPersonImage] 上傳失敗:', error);
                getLoadPanelInstance().hide();
                showImageUploadToast('上傳失敗，請稍後再試', 'error');
                input.value = '';
            }
        });
    }

