                        retrySelectBox.option("dataSource", spiritualIdentityDataSource);
                        console.log('✅ [NewPerson] 成功更新 SelectBox DataSource (重試)');
                    } else {
                        console.error('❌ [NewPerson] 重試後仍找不到 SelectBox 實例');
