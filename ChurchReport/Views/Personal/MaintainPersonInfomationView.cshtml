@* 
    這個視圖用於維護個人資訊，顯示地圖、資料網格，並允許上傳更新。
    根據登入類型（小組長或個人）顯示不同的資料網格。
*@

@{
    String DataStatus = "上傳成功了!";
    String ReUpload = "請再按一次上傳鈕!";
}

@model ChurchReport.Models.SmallGroupData

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>聖谷行道會</title>
</head>

@*<br />換行*@
<br />

<div class="dx-field" style="height:100%; width:100%; overflow: auto;">
    <!-- Toast 通知容器 -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                .Offset(0, 50))
                .Message(DataStatus)
                .DisplayTime(2000)
                .MaxWidth(200)
            )
    </div>

    <!-- 載入面板 -->
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                .ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.4)")
                .Position(p => p.Of("#data-grid"))
                .Visible(false)
                .ShowIndicator(true)
                .ShowPane(true)
                .Shading(true)
                .CloseOnOutsideClick(false)
                .Message("更新資料中...")
                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )
    </div>

    <!-- 重新上傳 Toast -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                    .ID("ToastReUpload")
                    .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message(ReUpload)
                    .DisplayTime(5000)
                    .Type(ToastType.Error)
                    .MaxWidth(500)
            )
    </div>

    <hr />

    <!-- 個人資料標題 -->
    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h4>個人資料</h4>
    </div>

    <!-- 地圖容器 -->
    <div id="multigroupchart">
        @(Html.DevExtreme().Map()
        .ID("map")
        .Provider(GeoMapProvider.Google)
        .Center("台南市")
        .Zoom(11)
        .Visible(false)
        .Width("50%")
        .Height(200)
        .Controls(true)
        .Type(GeoMapType.Roadmap)
        .ApiKey(k => k
        .Google("AIzaSyBNogx0Ziqd3OIEW5b6b9BTJHXHW_YKDlM")
        )
        .MarkerIconSrc(new JS("markerUrl"))
        .OnReady("onReady")
        )
    </div>

    <br />

    <!-- 上傳按鈕 -->
    <div id="buttonContainer" class="dx-button-icon">
        @(Html.DevExtreme().Button()
            .Text("上傳").Height(50).Width(80).Icon("check")
            .Type(ButtonType.Success)
            .ID("save-button")
            .OnClick
            (@<text>
                        function(arg)
                        {
                        var GroupDataGrid = $("#gridContainer").dxDataGrid("instance");
                        var ButtonContainer = $("#save-button").dxButton("instance");
                        var GroupDataGridFlag = GroupDataGrid.hasEditData();

                        if (!GroupDataGridFlag)
                        {
                            $("#loadPanel").dxLoadPanel("instance").show();
                            ButtonContainer.option("disabled", true);

                            $.ajax({
                                url: '@Url.Action("SaveMaintainPersonInfomation", "Personal")',
                                data: { aResult: GetResult() },
                                type: 'POST',
                                success: function (response) {
                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                    ButtonContainer.option("disabled", false);
                                    
                                    if (response.status === "1") {
                                        ShowToast(response.message || "上傳成功！", "success", 3000);
                                    } else {
                                        ShowToast(response.message || "上傳失敗", "error", 5000);
                                    }
                                },
                                error: function (xhr, status, error) {
                                    $("#loadPanel").dxLoadPanel("instance").hide();
                                    ButtonContainer.option("disabled", false);
                                    var errorMessage = "上傳失敗";
                                    if (xhr.status === 404) {
                                        errorMessage = "找不到上傳功能 (404)";
                                    } else if (xhr.responseText) {
                                        try {
                                            var errorResponse = JSON.parse(xhr.responseText);
                                            errorMessage = errorResponse.message || errorMessage;
                                        } catch (e) {
                                            errorMessage += ": " + xhr.responseText.substring(0, 100);
                                        }
                                    } else if (error) {
                                        errorMessage += ": " + error;
                                    }
                                    ShowToast(errorMessage, "error", 5000);
                                }
                            });
                        }
                        else
                        {
                            $("#loadPanel").dxLoadPanel("instance").hide();
                            ShowToast("請先儲存未提交的編輯資料", "warning", 3000);
                        }
                        }
            </text>)
        )
    </div>

    <!-- 資料網格 -->
    <div id="data-grid">
        @(Html.DevExtreme().DataGrid()
        .ID("gridContainer")
        .ShowBorders(true)
        .Paging(paging => paging.Enabled(false))
        .AllowColumnResizing(true)
        .ColumnResizingMode(ColumnResizingMode.Widget)
        .ColumnFixing(c => c.Enabled(true))
        .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
        .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
        .Export(e => e.Enabled(false).AllowExportSelectedData(true))
        .ShowColumnLines(true)
        .ShowRowLines(true)
        .RowAlternationEnabled(true)
        .ShowBorders(true)
        .RemoteOperations(false)
        .Grouping(g => g
            .ContextMenuEnabled(true)
            .ExpandMode(GridGroupingExpandMode.RowClick)
        )
        .GroupPanel(p => p
            .EmptyPanelText("請把小組名稱拉到這裡")
            .Visible(false)
            .AllowColumnDragging(true)
        )
        .Editing(editing =>
        {
            editing.Mode(GridEditMode.Cell);
            editing.AllowUpdating(true);
            editing.AllowAdding(false);
            editing.AllowDeleting(false);
            editing.RefreshMode(GridEditRefreshMode.Repaint);
            editing.Texts(a => a.SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯"));
        })
        .Columns(columns =>
        {
            columns.Add().DataField("SmallGroupName").Caption("小組").GroupIndex(0).MinWidth(10).AllowEditing(false);
            columns.Add().DataField("FullName").Caption("姓名").AllowEditing(false).Fixed(true).Width(80).MinWidth(20).Alignment(HorizontalAlignment.Left);
            columns.Add().DataField("Status")
                .Caption("會員身分").Alignment(HorizontalAlignment.Center)
                .AllowEditing(false)
                .Width(70).MinWidth(30).DataType(GridColumnDataType.String);
            columns.Add().DataField("EquipmentStatus").Caption("裝備狀態").Alignment(HorizontalAlignment.Center).Fixed(false).Width(60).MinWidth(90).AllowEditing(false);
            columns.Add().DataField("SpiritualIdentity")
                .Caption("信仰狀態").Alignment(HorizontalAlignment.Center)
                .AllowEditing(false)
                .Width(110).MinWidth(100).DataType(GridColumnDataType.String);
            columns.Add().DataField("Phone").Caption("行動電話").Fixed(false).Width(120).MinWidth(90).Alignment(HorizontalAlignment.Left).AllowEditing(true);
            columns.Add().DataField("BirthDate").Caption("生日").DataType(GridColumnDataType.Date)
                .Format("yyyy/M/d").Alignment(HorizontalAlignment.Center).Fixed(false).Width(100).MinWidth(80).AllowEditing(true);
            columns.Add().DataField("Address").Caption("地址").Fixed(false).Width(200).MinWidth(90).Alignment(HorizontalAlignment.Left).AllowEditing(true);
        })
        .DataSource(d => d
            .WebApi()
            .Controller("Personal")
            .LoadAction("LoadMaintainPersonInfomation")
            .UpdateAction("UpdateMaintainPersonInfomation")
            .Key("ContactId")
            .LoadParams(new { id = @ViewBag.ListId })
            .OnBeforeSend("dataSource_onBeforeSend")
        )
        .OnRowUpdating("onRowUpdating")
        .OnRowUpdated("onRowUpdated")
        .OnEditingStart("onEditingStart")
        .OnInitialized("onDataGridInitialized")
        .OnContentReady(@<text>
                        function(e)
                        {
                            moveEditColumnToLeft(e.component);
                        }
                    </text>)
        .OnCellPrepared("cell_prepared")
        )
    </div>
</div>

<script>
    var markerUrl = "https://js.devexpress.com/Demos/RealtorApp/images/map-marker.png";
    var DataUploadStatus = "尚未上傳喔!";
    var dataGridInstance = null;

    // DataGrid 初始化完成
    function onDataGridInitialized(e) {
        dataGridInstance = e.component;
        console.log("[onDataGridInitialized] DataGrid 已初始化");
    }

    // DataSource 發送請求前
    function dataSource_onBeforeSend(method, ajaxOptions) {
        console.log("[dataSource_onBeforeSend] Method:", method);
        console.log("[dataSource_onBeforeSend] URL:", ajaxOptions.url);
    }

    // 開始編輯
    function onEditingStart(e) {
        console.log("[onEditingStart] 開始編輯");
        console.log("[onEditingStart] Key:", e.key);
        console.log("[onEditingStart] Column:", e.column.dataField);
        console.log("[onEditingStart] Current Value:", e.data[e.column.dataField]);
    }

    // 正在更新列
    function onRowUpdating(e) {
        console.log("[onRowUpdating] 開始更新列資料");
        console.log("[onRowUpdating] Key:", e.key);
        console.log("[onRowUpdating] Old Data:", e.oldData);
        console.log("[onRowUpdating] New Data:", e.newData);
        
        // 確保新資料不為空
        if (!e.newData || Object.keys(e.newData).length === 0) {
            console.warn("[onRowUpdating] 沒有變更的資料");
            e.cancel = true;
            return;
        }
    }

    // 列更新完成
    function onRowUpdated(e) {
        console.log("[onRowUpdated] 列資料已更新");
        console.log("[onRowUpdated] Key:", e.key);
        console.log("[onRowUpdated] Updated Data:", e.data);
        
        // 顯示成功訊息
        ShowToast("資料已儲存", "success", 2000);
    }

    // 收集 DataGrid 資料
    function GetResult() {
        try {
            console.log("[GetResult] 開始收集資料...");
            
            if (!dataGridInstance) {
                dataGridInstance = $("#gridContainer").dxDataGrid("instance");
            }
            
            if (!dataGridInstance) {
                console.error("[GetResult] DataGrid instance not found");
                return "[]";
            }

            console.log("[GetResult] DataGrid instance found");

            var dataSource = dataGridInstance.getDataSource();
            if (!dataSource) {
                console.error("[GetResult] DataSource not found");
                return "[]";
            }

            console.log("[GetResult] DataSource found");

            var items = dataSource.items();
            if (!items || items.length === 0) {
                console.warn("[GetResult] No items in DataSource");
                return "[]";
            }

            console.log("[GetResult] Found " + items.length + " items");
            
            // 記錄第一筆資料的結構
            if (items.length > 0) {
                console.log("[GetResult] 第一筆資料範例:", items[0]);
            }
            
            // 使用 JSON.stringify 確保正確的 JSON 格式
            var jsonString = JSON.stringify(items);
            console.log("[GetResult] JSON 長度:", jsonString.length);
            
            return jsonString;
        }
        catch (error) {
            console.error("[GetResult] 發生錯誤:", error);
            console.error("[GetResult] 錯誤堆疊:", error.stack);
            return "[]";
        }
    }

    // 顯示 Toast 通知
    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        var ToastInstance = $("#ToastReUpload").dxToast("instance");
        if (!ToastInstance) {
            console.error("Toast instance not found");
            return;
        }
        
        ToastInstance.option('message', LocalToastMessage);
        ToastInstance.option('type', Type);
        ToastInstance.option('displayTime', DisplayTime);
        ToastInstance.option('white-space', 'pre-line');
        ToastInstance.option('closeOnClick', true);
        ToastInstance.show();
    }

    // 解析日期
    function ParsingDate(input) {
        if (typeof (input) === 'string') {
            var parts = input.split('-');
            if (parts.length < 3) {
                return new Date();
            }
            var DaySplitedArray = parts[2].split('T');
            var ParsedDate = new Date(parts[0], parts[1] - 1, DaySplitedArray[0]);
            return ParsedDate;
        }
        else if (input instanceof Date) {
            return getLocalDateFilter(input);
        }
        else {
            return new Date();
        }
    }

    // 獲取本地日期過濾器
    function getLocalDateFilter(date) {
        var rawMonth = (date.getMonth()).toString();
        var monthString = rawMonth.length == 1 ? "0" + rawMonth : rawMonth;
        var rawDate = date.getDate().toString();
        var dateString = rawDate.length == 1 ? "0" + rawDate : rawDate;
        return new Date(date.getFullYear(), rawMonth, rawDate);
    }

    // 地圖準備就緒
    function onReady(e) {
        $.ajax({
            url: '@Url.Action("GetMarkers", "Home")',
            type: "POST",
            dataType: "json",
            success: function (data) {
                $("#map").dxMap("instance").option("markers", data);
            },
            error: function(xhr, status, error) {
                console.error("Failed to load map markers:", error);
            }
        });
    }

    // 移動編輯欄到左側
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }

    // 單元格準備
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            }
            else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }
</script>

<!-- 本地中文化 -->
<script>
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容",
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date"
        },
    };
    DevExpress.localization.loadMessages(dictionary);
    var formatMessage = DevExpress.localization.formatMessage;

    var locale = getLocale();
    DevExpress.localization.locale(locale);

    function changeLocale(data) {
        setLocale(data.value);
        document.location.reload();
    }

    function getLocale() {
        sessionStorage.setItem("locale", 'zh-tw');
        var locale = sessionStorage.getItem("locale");
        return locale != null ? locale : "tw";
    }
</script>

<!-- 外部腳本和樣式 -->
<script src="~/js/devextreme/devextreme-intl.min.js"></script>
<script src="~/js/devextreme/localization/dx.messages.zh-tw.js"></script>
<script src="~/js/DataGridAjax.js"></script>
<script src="~/js/DropDownBox.js"></script>
<script src="~/js/LoadPanel.js"></script>
<link href="~/css/SmallGroupReportController.css" rel="stylesheet" />
