@* 
    這個視圖用於維護個人資訊，顯示地圖、資料網格，並允許上傳更新。
*@

@{
    String DataStatus = "上傳成功了!";
    String ReUpload = "請再按一次上傳鈕!";
}

@model ChurchReport.Models.SmallGroupData

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <title>聖谷行道會</title>
</head>

<br />

<div class="dx-field" style="height:100%; width:100%; overflow: auto;">
    <!-- Toast 通知容器 -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                .Message(DataStatus)
                .DisplayTime(2000)
                .MaxWidth(200)
            )
    </div>

    <!-- 載入面板 -->
    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                .ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.4)")
                .Position(p => p.Of("#data-grid"))
                .Visible(false)
                .ShowIndicator(true)
                .ShowPane(true)
                .Shading(true)
                .CloseOnOutsideClick(false)
                .Message("更新資料中...")
            )
    </div>

    <!-- 重新上傳 Toast -->
    <div id="ToastReUploadContainer">
        @(Html.DevExtreme().Toast()
                    .ID("ToastReUpload")
                    .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                    .Message(ReUpload)
                    .DisplayTime(5000)
                    .Type(ToastType.Error)
                    .MaxWidth(500)
            )
    </div>

    <hr />

    <!-- 個人資料標題 -->
    <div style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h4>個人資料</h4>
    </div>

    <!-- 地圖容器 -->
    <div id="multigroupchart">
        @(Html.DevExtreme().Map()
        .ID("map")
        .Provider(GeoMapProvider.Google)
        .Center("台南市")
        .Zoom(11)
        .Visible(false)
        .Width("50%")
        .Height(200)
        .Controls(true)
        .Type(GeoMapType.Roadmap)
        .ApiKey(k => k.Google("AIzaSyBNogx0Ziqd3OIEW5b6b9BTJHXHW_YKDlM"))
        .MarkerIconSrc(new JS("markerUrl"))
        .OnReady("onReady")
        )
    </div>

    <br />

    <!-- 上傳按鈕 -->
    <div id="buttonContainer" class="dx-button-icon">
        @(Html.DevExtreme().Button()
            .Text("上傳").Height(50).Width(80).Icon("check")
            .Type(ButtonType.Success)
            .ID("save-button")
            .OnClick
            (@<text>
                        function(arg)
                        {
                            var grid = $("#gridContainer").dxDataGrid("instance");
                            var btn  = $("#save-button").dxButton("instance");
                            var lp   = $("#loadPanel").dxLoadPanel("instance");

                            if (modifiedRecords.size === 0) {
                                ShowToast("沒有需要上傳的資料", "warning", 2000);
                                return;
                            }

                            try { grid.closeEditCell(); } catch(e) { /* ignore */ }
                            var savePromise = grid.saveEditData();

                            lp.show();
                            btn.option("disabled", true);

                            savePromise.done(function(){
                                var payload = GetResult();
                                var modifiedCount = modifiedRecords.size;

                                console.log("[Upload] 準備上傳", modifiedCount, "筆已修改的資料");

                                $.ajax({
                                    url: '@Url.Action("SaveMaintainPersonInfomation", "Personal")',
                                    type: 'POST',
                                    data: { aResult: payload },
                                    timeout: 3000,
                                    success: function (response) {
                                        lp.hide();
                                        btn.option("disabled", false);

                                        if (response.status === "1") {
                                            ShowToast(response.message || "資料已送出，正在背景上傳中...", "success", 3000);
                                            modifiedRecords.clear();
                                            updateUploadButtonText(0);
                                            try { grid.repaint(); } catch(e) { console.warn("[Upload] Grid repaint error:", e); }
                                            console.log("[Upload] 資料已送出，保留當前編輯內容");
                                        } else {
                                            ShowToast(response.message || "上傳失敗", "error", 5000);
                                        }
                                    },
                                    error: function (xhr, status, error) {
                                        lp.hide();
                                        btn.option("disabled", false);

                                        if (status === "timeout") {
                                            ShowToast("資料已送出，正在背景上傳中...", "info", 3000);
                                            modifiedRecords.clear();
                                            updateUploadButtonText(0);
                                            try { grid.repaint(); } catch(e) { console.warn("[Upload] Grid repaint error:", e); }
                                        } else {
                                            var errorMessage = "上傳失敗";
                                            if (xhr.status === 404) errorMessage = "找不到上傳功能 (404)";
                                            else if (xhr.responseJSON && xhr.responseJSON.message) errorMessage = xhr.responseJSON.message;
                                            ShowToast(errorMessage, "error", 5000);
                                        }
                                    }
                                });
                            }).fail(function(){
                                lp.hide();
                                btn.option("disabled", false);
                                ShowToast("請先修正編輯欄位的錯誤後再上傳", "warning", 4000);
                            });
                        }
            </text>)
        )
    </div>

    <!-- 資料網格 -->
    <div id="gridContainer"></div>

</div>

<script>
    // ? 立即執行的測試日誌
    console.log("========================================");
    console.log("[Script] JavaScript 檔案已載入");
    console.log("[Script] jQuery 版本:", typeof $ !== 'undefined' ? $.fn.jquery : "未載入");
    console.log("[Script] DevExpress 版本:", typeof DevExpress !== 'undefined' ? "已載入" : "未載入");
    console.log("========================================");

    var markerUrl = "https://js.devexpress.com/Demos/RealtorApp/images/map-marker.png";
    var dataGridInstance = null;
    var modifiedRecords = new Set();
    var cachedData = []; // ? 移到全域作用域

    $(function() {
        console.log("[PageLoad] ? jQuery document.ready 已觸發");
        console.log("[PageLoad] 開始載入頁面");
        console.log("[PageLoad] ViewBag.ListId:", '@ViewBag.ListId');
        
        // ? 先載入資料
        $.ajax({
            url: '@Url.Action("LoadMaintainPersonInfomation", "Personal")',
            type: 'GET',
            data: { id: '@ViewBag.ListId' },
            dataType: 'json',
            beforeSend: function() {
                console.log("[DataLoad] 開始載入資料...");
                console.log("[DataLoad] URL:", '@Url.Action("LoadMaintainPersonInfomation", "Personal")');
                console.log("[DataLoad] ListId:", '@ViewBag.ListId');
            },
            success: function(data) {
                console.log("[DataLoad] ? 載入成功");
                console.log("[DataLoad] 資料類型:", typeof data);
                console.log("[DataLoad] 是否為陣列:", Array.isArray(data));
                console.log("[DataLoad] 完整資料:", data);
                
                // ? DevExtreme DataSourceLoader 返回的格式：{ data: [...], totalCount: N }
                var actualData = [];
                
                if (Array.isArray(data)) {
                    // 如果直接是陣列
                    actualData = data;
                } else if (data && Array.isArray(data.data)) {
                    // 如果是 DevExtreme 格式：{ data: [...] }
                    actualData = data.data;
                    console.log("[DataLoad] 從 data.data 取得資料");
                } else {
                    console.warn("[DataLoad] ?? 未知的資料格式");
                }
                
                console.log("[DataLoad] 實際資料筆數:", actualData.length);
                
                if (actualData.length > 0) {
                    console.log("[DataLoad] 第一筆資料:", actualData[0]);
                    cachedData = actualData;
                    initializeGrid();
                } else {
                    console.warn("[DataLoad] ?? 資料為空");
                    cachedData = [];
                    initializeGrid();
                }
            },
            error: function(xhr, status, error) {
                console.error("[DataLoad] ? 載入失敗");
                console.error("[DataLoad] Status:", status);
                console.error("[DataLoad] Error:", error);
                console.error("[DataLoad] Response:", xhr.responseText);
                console.error("[DataLoad] Status Code:", xhr.status);
                
                cachedData = [];
                initializeGrid();
                
                ShowToast("資料載入失敗: " + error, "error", 5000);
            }
        });
    });
    
    function initializeGrid() {
        console.log("[InitGrid] 開始初始化，資料數:", cachedData.length);
        
        // ? 使用 CustomStore 管理本地資料
        $("#gridContainer").dxDataGrid({
            dataSource: new DevExpress.data.CustomStore({
                key: "ContactId",
                load: function() {
                    console.log("[CustomStore] Load - 返回", cachedData.length, "筆資料");
                    return cachedData;
                },
                update: function(key, values) {
                    console.log("[CustomStore] Update - Key:", key, "Values:", values);
                    
                    // ? 更新本地快取資料
                    var index = cachedData.findIndex(function(item) { 
                        return item.ContactId === key; 
                    });
                    
                    if (index >= 0) {
                        // ? 合併新值到現有資料
                        for (var prop in values) {
                            cachedData[index][prop] = values[prop];
                        }
                        console.log("[CustomStore] 已更新本地資料:", cachedData[index]);
                    }
                    
                    return $.Deferred().resolve().promise();
                }
            }),
            showBorders: true,
            allowColumnResizing: true,
            columnResizingMode: "widget",
            columnFixing: { enabled: true },
            loadPanel: { enabled: false },
            showColumnLines: true,
            showRowLines: true,
            rowAlternationEnabled: true,
            remoteOperations: false,
            grouping: {
                contextMenuEnabled: true,
                expandMode: "rowClick"
            },
            groupPanel: {
                emptyPanelText: "請把小組名稱拉到這裡",
                visible: false,
                allowColumnDragging: true
            },
            editing: {
                mode: "cell",
                allowUpdating: true,
                allowAdding: false,
                allowDeleting: false
            },
            columns: [
                { dataField: "SmallGroupName", caption: "小組", groupIndex: 0, allowEditing: false },
                { dataField: "FullName", caption: "姓名", allowEditing: false, fixed: true, width: 80, alignment: "left" },
                { dataField: "Status", caption: "會員身分", alignment: "center", allowEditing: false, width: 70 },
                { dataField: "EquipmentStatus", caption: "裝備狀態", alignment: "center", allowEditing: false, width: 60 },
                { dataField: "SpiritualIdentity", caption: "信仰狀態", alignment: "center", allowEditing: false, width: 110 },
                { dataField: "Phone", caption: "行動電話", width: 120, alignment: "left", allowEditing: true },
                { dataField: "BirthDate", caption: "生日", dataType: "date", format: "yyyy/M/d", alignment: "center", width: 100, allowEditing: true },
                { dataField: "Address", caption: "地址", width: 200, alignment: "left", allowEditing: true }
            ],
            onInitialized: function(e) {
                dataGridInstance = e.component;
                modifiedRecords.clear();
                console.log("[DataGrid] 已初始化");
            },
            onRowUpdating: function(e) {
                console.log("[DataGrid] 更新中 - Key:", e.key, "NewData:", e.newData);
                if (e.key && e.newData && Object.keys(e.newData).length > 0) {
                    modifiedRecords.add(e.key);
                    console.log("[DataGrid] 已記錄修改，總共", modifiedRecords.size, "筆");
                }
            },
            onRowUpdated: function(e) {
                console.log("[DataGrid] 已更新 - Key:", e.key, "Data:", e.data);
                var modifiedCount = modifiedRecords.size;
                updateUploadButtonText(modifiedCount);
                ShowToast("資料已暫存（" + modifiedCount + " 筆待上傳）", "info", 2000);
            },
            onCellPrepared: function(e) {
                if (e.rowType === "data" && e.data && e.data.ContactId) {
                    if (modifiedRecords.has(e.data.ContactId)) {
                        e.cellElement.css("background-color", "#fff8dc");
                    }
                }
            },
            onEditingStart: function(e) {
                console.log("[DataGrid] 開始編輯 - Column:", e.column.dataField, "Key:", e.key, "Current:", e.data[e.column.dataField]);
            }
        });
    }

    function updateUploadButtonText(count) {
        try {
            var btn = $("#save-button").dxButton("instance");
            if (btn) {
                btn.option("text", count > 0 ? "上傳 (" + count + ")" : "上傳");
                btn.option("type", count > 0 ? "default" : "success");
            }
        } catch(e) {}
    }

    function GetResult() {
        try {
            var grid = dataGridInstance || $("#gridContainer").dxDataGrid("instance");
            if (!grid) return "[]";

            try { grid.closeEditCell(); } catch(e) {}

            var rows = grid.getVisibleRows() || [];
            var items = [];
            
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                if (r && r.rowType === "data" && r.data) {
                    items.push(r.data);
                }
            }

            return JSON.stringify(items);
        } catch (err) {
            return "[]";
        }
    }

    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        try {
            var ToastInstance = $("#ToastReUpload").dxToast("instance");
            if (ToastInstance) {
                ToastInstance.option('message', LocalToastMessage);
                ToastInstance.option('type', Type);
                ToastInstance.option('displayTime', DisplayTime);
                ToastInstance.show();
            }
        } catch(e) {}
    }

    function onReady(e) {
        $.ajax({
            url: '@Url.Action("GetMarkers", "Home")',
            type: "POST",
            dataType: "json",
            success: function (data) {
                $("#map").dxMap("instance").option("markers", data);
            }
        });
    }
</script>

<!-- 本地中文化 -->
<script>
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容",
            "Month": "月",
            "Subject": "主題"
        },
    };
    DevExpress.localization.loadMessages(dictionary);
    DevExpress.localization.locale('zh-tw');
</script>

<!-- 外部腳本和樣式 -->
<script src="~/js/devextreme/devextreme-intl.min.js"></script>
<script src="~/js/devextreme/localization/dx.messages.zh-tw.js"></script>
<link href="~/css/SmallGroupReportController.css" rel="stylesheet" />
