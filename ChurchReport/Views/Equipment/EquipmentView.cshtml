@using ChurchReport.Models

@model ChurchReport.Models.EquipmenSmallGroup

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>行道會聖谷教會</title>
    @*<title>行道會聖谷教會</title>*@

</head>

<style>
    .equipment-page {
        --theme-primary: #0f766e;
        --theme-border: #d9e6f2;
        --theme-surface: #ffffff;
        --theme-muted: #64748b;
        --theme-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        padding: 10px 8px 20px;
    }

    .equipment-card {
        background: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 16px;
        box-shadow: var(--theme-shadow);
        padding: 14px 16px;
        margin-bottom: 12px;
    }

    .equipment-header-card {
        background: linear-gradient(145deg, #f0fdfa 0%, #f8fafc 60%, #ecfeff 100%);
    }

    .equipment-title {
        margin: 0;
        color: var(--theme-primary);
        font-size: 1.1rem;
        font-weight: 700;
    }

    .equipment-tip {
        margin-top: 7px;
        color: var(--theme-muted);
        font-size: .9rem;
    }

    #EquipmentGridContainer .dx-datagrid-headers {
        border-radius: 10px;
        overflow: hidden;
    }

    #EquipmentGridContainer .dx-datagrid-headers .dx-header-row td {
        background: #e6f6f4;
        color: #0f172a;
        font-size: .92rem;
        font-weight: 700;
        padding-top: 11px;
        padding-bottom: 11px;
    }

    #EquipmentGridContainer .dx-datagrid-rowsview .dx-row > td {
        padding-top: 10px;
        padding-bottom: 10px;
        vertical-align: middle;
    }

    #EquipmentGridContainer .dx-datagrid-rowsview .dx-data-row:hover > td {
        background-color: #fff6cc;
    }

    #EquipmentGridContainer .dx-selection > td,
    #EquipmentGridContainer .dx-row-focused > td {
        background-color: #d1fae5 !important;
    }

    @@media (max-width: 430px) {
        .equipment-page {
            padding: 8px 4px 14px;
        }

        .equipment-card {
            border-radius: 12px;
            padding: 10px;
        }

        .equipment-title {
            font-size: 1rem;
        }

        #EquipmentGridContainer .dx-datagrid-headers .dx-header-row td,
        #EquipmentGridContainer .dx-datagrid-rowsview .dx-row > td {
            font-size: .86rem;
            padding-top: 8px;
            padding-bottom: 8px;
        }
    }
</style>

@*<h3>@ViewBag.HappyGroupName</h3>*@

<div class="equipment-page">
<div class="equipment-card equipment-header-card" style="font-family:標楷體;font-size:100%; color:cadetblue; text-align:left;font-weight:bold">
    <h4 class="equipment-title">裝備狀態</h4>
    <div class="equipment-tip">點擊小組列可展開明細，快速查看各小組裝備資訊。</div>
</div>



<div id="data-grid" class="equipment-card">
    @(Html.DevExtreme().DataGrid<EquipmenSmallGroup>()
        .ID("EquipmentGridContainer")
        .Grouping(g=>g.AutoExpandAll(true))
        .AllowColumnResizing(false)
        //.Width(1500)
        //.AllowColumnReordering(true)
        .ColumnAutoWidth(false)
        .ColumnMinWidth(80)
        //.ColumnFixing(c => c.Enabled(true))
        .NoDataText("沒有資料")
        .ShowBorders(true)
        .ShowRowLines(true)
        .ShowColumnLines(true)

        .Sorting(sorting => sorting.Mode(GridSortingMode.Multiple).ShowSortIndexes(true) )
        .OnRowPrepared("OnRowPrepared")

        .DataSource(d => d
            .WebApi()
            .Controller("Equipment")
            .LoadAction("LoadEquipmentList")
            //.InsertAction("PostBest")
            //.DeleteAction("DeleteBest")
            //.UpdateAction("PutBest")
            .Key("SmallGroupListEntityId")
        )

        .Editing(editing =>
        {
            //editing.Mode(GridEditMode.Row);
            editing.Mode(GridEditMode.Cell);
            //editing.Mode(GridEditMode.Batch);
            //editing.Mode(GridEditMode.Form);
            //editing.Mode(GridEditMode.Popup);
            //editing.AllowUpdating(true);
            //editing.AllowDeleting(true);
            //editing.AllowAdding(true);
            editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("確定").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除").ConfirmDeleteTitle("確定要刪除嗎?").ConfirmDeleteMessage("刪除幸福小組週報"));
            //editing.AllowDeleting(true);
        })


        .OnContentReady(
                @<text>
                    function(e)
                    {
                        moveEditColumnToLeft(e.component);
                    }
                    </text>
                )

        .Columns(columns =>
        {
            columns.AddFor(m => m.SmallGroupName)
            .Caption("小組")
            .Width(800)
            .MinWidth(10);
        })
        .MasterDetail(md =>
        {
            md.Enabled(true);
            md.AutoExpandAll(false); // 修改: 預設展開所有小組
            md.Template(@<text>
                @(Html.Partial("EquipmentContactView"))
            </text>);
        })
    )
</div>

@using (Html.DevExtreme().NamedTemplate("EquipmentContact"))
{
    @(Html.Partial("EquipmentContactView"))
}

<script>
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }

    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            } else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }

    function OnRowPrepared(e) {
        if (e.rowType == 'data') {
            e.rowElement.css({ height: 42 });
            e.rowElement.css('font-size', '16px');
            e.rowElement.css('font-family', '標楷體');
            e.rowElement.css('color', '#1e3a8a');
            e.rowElement.css('background', '#ffffff');
            //e.rowElement.css('background', '#fff2a8');
            e.rowElement[0].addEventListener("mouseover", function () {
                e.rowElement.css('background', '#fff6cc');
                e.rowElement.css("transition", "background-color 0.25s");
            });
            e.rowElement[0].addEventListener("mouseleave", function () {
                e.rowElement[0].style.background = ""
            });
        }
    }

</script>

<link href="~/css/MasterDetail.css" rel="stylesheet" />
<script src="~/js/SelectTime.js"></script>