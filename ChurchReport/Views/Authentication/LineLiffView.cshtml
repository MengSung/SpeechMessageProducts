<!DOCTYPE html>

@* 
    這個視圖用於 LINE LIFF 身分綁定註冊頁面。
    使用者可以輸入個人資訊並綁定 LINE 帳號。
*@

@{
    Layout = null;
}

@using ChurchReport.ViewModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@model LineBindingViewModel

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>行道會聖谷教會</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Bootstrap 和 DevExtreme CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/LineLiffView.css" rel="stylesheet" />

    <!-- jQuery 和 Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <!-- DevExtreme 全球化腳本 -->
    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

    @* JSZip for client side export (註釋掉) *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <!-- DevExtreme 核心腳本 -->
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

    <style>
        /* Hero 橫幅與覆蓋層 */
        .hero-wrapper { position: relative; width:100%; height: 300px; overflow:hidden; }
        .hero-overlay { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; color:#fff; padding:1rem; background: linear-gradient(135deg, rgba(0,0,0,.55), rgba(0,0,0,.25)); }
        .hero-overlay h1 { font-size:1.9rem; letter-spacing:2px; font-weight:700; margin-bottom:.35rem; }
        .hero-overlay .sub { font-size:.95rem; opacity:.95; margin-bottom:.5rem; }
        .hero-overlay .verse { font-size:.95rem; line-height:1.4; max-width:680px; }
        .hero-overlay .verse span { display:block; margin-top:.25rem; font-size:.78rem; opacity:.85; }
        .logo-faith { font-size:2.2rem; margin-bottom:.35rem; color:#fff; animation: pulse 3.5s infinite; }
        @@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }

        /* 表單卡片樣式 */
        .cr-card { border-radius: 18px; overflow:hidden; max-width:760px; width:100%; margin:0 auto; }
        .cr-card .card-body { padding:1.25rem 1rem 1.5rem; }
        #displaynamefield { font-weight:600; font-size:1.8rem; color:#35507d; }
        #remind { color:#6b7280; }

        /* Toast 置頂顯示 */
        .dx-toast-content { border-radius: 10px; }

        /* 聯絡資訊字型放大 1.3 倍 */
        .card-body-soft h5 { font-size:1.625rem; }
        .info-list { list-style:none; padding:0; margin:0; }
        .info-list li { margin-bottom:.5rem; }
        .info-label, .info-value { font-size:1.3rem; line-height:1.4; }

        @@media (max-width: 575.98px) {
            .hero-wrapper { height: 260px; }
            .hero-overlay h1 { font-size:1.6rem; }
        }
    </style>
</head>

<body class="bg-light">
    <!-- Hero：背景 Gallery 疊加經文 -->
    <section class="hero-wrapper" aria-label="歡迎區">
        <div class="position-absolute w-100 h-100" style="z-index:1;">
            @(Html.DevExtreme().Gallery()
                .ID("gallery")
                .DataSource(Model.Images)
                .Height("100%")
                .StretchImages(true)
                .Loop(true)
                .SlideshowDelay(1800)
                .ShowNavButtons(true)
                .ShowIndicator(true)
            )
        </div>
        <div class="hero-overlay" role="banner">
            <i class="fa-solid fa-dove logo-faith" aria-hidden="true"></i>
            <h1>行道會聖谷教會</h1>
            <div class="sub">LINE 身分綁定註冊</div>
            <div class="verse">你要專心仰賴耶和華，不可倚靠自己的聰明。<span>— 箴言 3:5</span></div>
        </div>
    </section>

    <!-- 主要內容 -->
    <main class="container d-flex justify-content-center pb-5">
        <div class="cr-card card shadow-lg border-0 w-100">
            <!-- 註冊表單 -->
            <div class="card-body">
                <h5 id="displaynamefield" class="text-center mb-2"></h5>
                <p id="remind" class="text-center cr-subtext mb-4">請輸入真實姓名</p>

                <form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="ProcessLineBinding" asp-controller="Home" method="post" class="text-center-important">
                    <div class="dx-field">
                        <div class="form-container-class" id="form-container">
                            @(Html.DevExtreme().Form<LineBindingViewModel>()
                                           .ID("form")
                                           .Items(items =>
                                           {
                                               // 主要姓名欄位
                                               items.AddSimpleFor(m => m.FullName)
                                                   .Label(l => l.Text("主要姓名"))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入姓名(必填)")
                                                       .ShowClearButton(true)
                                                  )
                                                    .ValidationRules(r => r
                                                            .AddRequired()
                                                            .Message("主要姓名必填")
                                                        );

                                               // 其他姓名欄位
                                               items.AddSimpleFor(m => m.OtherName)
                                                   .Label(l => l.Text("其他姓名"))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入其他姓名(選填)")
                                                       .ShowClearButton(true)
                                                  );

                                               // 行動電話欄位
                                               items.AddSimpleFor(m => m.Mobile)
                                                   .Label(l => l.Text("行動電話"))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入行動電話(必填)")
                                                       .ShowClearButton(true)
                                                  )
                                                  .ValidationRules(r => r
                                                            .AddRequired()
                                                            .Message("行動電話必填")
                                                        );

                                               // Line UserId 欄位 (隱藏)
                                               items.AddSimpleFor(m => m.LineUserId)
                                                   .Label(l => l.Text("Line Id").Visible(false))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入行動電話")
                                                       .ShowClearButton(true)
                                                       .Value(Model.LineUserId)
                                                       .Visible(false)
                                                  );




                                                            // DisplayName 欄位 (隱藏)
                                                            items.AddSimpleFor(m => m.DisplayName)
                                                            .Label(l => l.Text("Display Name").Visible(false))
                                                            .Editor(e => e
                                                            .TextBox()
                                                            .Mode(TextBoxMode.Text)
                                                            .Disabled(false)
                                                            .Visible(false)
                                                            );

                                                            // PictureUrl 欄位 (隱藏)
                                                            items.AddSimpleFor(m => m.PictureUrl)
                                                            .Label(l => l.Text("Picture Url").Visible(false))
                                                            .Editor(e => e
                                                            .TextBox()
                                                            .Mode(TextBoxMode.Text)
                                                            .Disabled(false)
                                                            .Visible(false)
                                                            );

                                                            // StatusMessage 欄位 (隱藏)
                                                            items.AddSimpleFor(m => m.StatusMessage)
                                                            .Label(l => l.Text("Status Message").Visible(false))
                                                            .Editor(e => e
                                                            .TextBox()
                                                            .Mode(TextBoxMode.Text)
                                                            .Disabled(false)
                                                            .Visible(false)
                                                            );

                                           })
                            )
                        </div>
                    </div>

                    <!-- 按鈕和載入面板 -->
                    <div class="dx-field">
                        <div id="buttonContainer" class="dx-button-icon mb-3 d-flex justify-content-center">
                            @(Html.DevExtreme().Button()
                                            .Text("註冊")
                                            .Type(ButtonType.Default)
                                            .ID("register-button")
                                            .UseSubmitBehavior(true)
                                            .OnClick("Register")
                                            .Width(140)
                            )
                        </div>
                        <div id="LoadPanel">
                            @(Html.DevExtreme().LoadPanel()
                                            .ID("loadPanel")
                                            .ShadingColor("rgba(0,0,0,0.4)")
                                            .Position(p => p.Of("#form-container"))
                                            .Visible(false)
                                            .ShowIndicator(true)
                                            .ShowPane(true)
                                            .Shading(true)
                                            .CloseOnOutsideClick(false)
                                            .Message("註冊中...")
                                            .Delay(5000)
                                            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                            )
                        </div>
                    </div>
                </form>
            </div>

            <!-- 聯絡資訊 -->
            <div class="card-body-soft">
                <div class="row">
                    <div class="col-md-7">
                        <h5 style="font-weight:600; margin-bottom: 12px;">
                            <i class="fa-solid fa-church me-1"></i>聯絡資訊
                        </h5>
                        <ul class="info-list">
                            <li>
                                <span class="info-label">地址</span>
                                <span class="info-value">@Configuration["ChurchInfo:Address"]</span>
                            </li>
                            <li>
                                <span class="info-label">電話</span>
                                <span class="info-value">@Configuration["ChurchInfo:Phone"]</span>
                            </li>
                            <li>
                                <span class="info-label">信箱</span>
                                <span class="info-value">@Configuration["ChurchInfo:Email"]</span>
                            </li>
                            <li>
                                <span class="info-label">統編</span>
                                <span class="info-value">@Configuration["ChurchInfo:TaxId"]</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 版權 -->
            <div class="footer-note">Copyright © @DateTime.Now.Year 行道會聖谷教會</div>
        </div>
    </main>

    <!-- Toast 通知 -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                        .ID("Toast")
                        .Position(p => p
                            .At(HorizontalAlignment.Center, VerticalAlignment.Top)
                            .Offset(0, 80))
                        .DisplayTime(2200)
                        .MaxWidth(260)
                        .CloseOnOutsideClick(true)
        )
    </div>

    <!-- 外部腳本 -->
    <script src="~/js/liff-starter.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

    <!-- JavaScript 函數 -->
    <script>
        // 獲取載入面板實例
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        // 按鈕點擊事件 (未使用)
        function button_click() {
            getLoadPanelInstance().show();
        }

        // 載入面板顯示事件 (未實現)
        function loadPanel_shown(e) {
        }

        // 載入面板隱藏事件 (未實現)
        function loadPanel_hidden() {
        }

        // 註冊按鈕點擊事件
        function Register(arg) {
            var ButtonContainer = $("#register-button").dxButton("instance");
            ButtonContainer.option("disabled", true);
            ShowToast("正在處理中，請稍待...", "success", 3000);
            DevExpress.ui.notify({
                displayTime: 3000,
                closeOnClick: true,
                message: "正在處理中，請稍待喔...",
                type: 'success',
            });
            getLoadPanelInstance().show();
        }
    </script>

    <!-- AJAX 相關腳本 -->
    <script type="text/javascript">
        // AJAX 開始事件
        function onBegin() {
            var ButtonContainer = $("#register-button").dxButton("instance");
            ButtonContainer.option("disabled", true);
            getLoadPanelInstance().show();
        }

        // AJAX 成功事件
        function onSuccess(data) {
            var ButtonContainer = $("#register-button").dxButton("instance");
            ButtonContainer.option("disabled", false);
            getLoadPanelInstance().hide();

            if (data.status == 1) {
                DevExpress.ui.notify({
                    displayTime: 15000,
                    closeOnClick: true,
                    message: data.message,
                    type: 'success',
                });
                document.getElementById('displaynamefield').innerHTML = data.message;
            }
            else {
                DevExpress.ui.notify(data.message, "error", 5000);
                document.getElementById('displaynamefield').innerHTML = data.message;
            }
        }

        // AJAX 完成事件 (未實現)
        function onComplete(data) {
        }
    </script>

    <!-- LINE LIFF 腳本 -->
    <script>
        // ========================================
        // ✅ P0: 電腦版 LINE 綁定方案（Server-side OAuth 2.0 + LIFF SDK）
        // ========================================
        // 目的：解決電腦版 LINE 內建瀏覽器無法使用 LIFF SDK 的問題
        // 策略：根據環境選擇最佳綁定方式
        //   1. 手機版 LINE / 外部瀏覽器 → 使用 LIFF SDK（原有邏輯）
        //   2. 電腦版 LINE 內建瀏覽器 → 使用 Server-side OAuth 2.0（新增）
        // 
        // 架構師註解：
        //   - 遵循 SOLID 原則中的 Open-Closed Principle（開放封閉原則）
        //   - 原有 LIFF SDK 邏輯保持不變，新增環境偵測與 OAuth fallback
        //   - 確保向後相容性，不影響現有手機版用戶體驗
        // ========================================

        var urlParams = new URLSearchParams(window.location.search);
        var cleanUrl = window.location.href.split('?')[0];

        // ========================================
        // 頁面載入初始化 LIFF（優化版）
        // ========================================
        // 改進：
        //   1. 增加環境偵測邏輯
        //   2. 電腦版 LINE 自動使用 Server-side OAuth
        //   3. 保留原有 LIFF SDK 邏輯（向後相容）
        //   4. 增加詳細的日誌輸出（便於除錯）
        //   5. ✅ 檢查 Server-side OAuth 回傳的 LINE UserId
        // ========================================
        window.onload = function (e) {
            console.log('[LineLiffView] ========== 開始初始化 LINE 綁定流程 ==========');
            console.log('[LineLiffView] URL:', window.location.href);
            console.log('[LineLiffView] LIFF ID:', '@TempData["Proponent"]');

            // ========================================
            // ✅ P0: 檢查是否從 Server-side OAuth 返回
            // ========================================
            // 如果 TempData 中有 _PendingLineUserId，表示是從 OAuth 返回
            // 直接使用此 UserId 進行綁定檢查
            // ========================================
            var pendingLineUserId = '@TempData["_PendingLineUserId"]';
            if (pendingLineUserId && pendingLineUserId !== '') {
                console.log('[LineLiffView] ✅ 偵測到 Server-side OAuth 返回，LINE UserId:', pendingLineUserId);
                document.getElementById('displaynamefield').innerHTML = '正在檢查綁定狀態...';
                
                // 直接呼叫 UpdateLineUserId 檢查綁定狀態
                // 不需要再使用 LIFF SDK
                UpdateLineUserId(pendingLineUserId, "", "", "", "", "", "");
                return;
            }

            // ✅ 方案 A：一律使用 Server-side OAuth（最穩定，推薦用於生產環境）
            // useServerSideOAuth();

            // ✅ 方案 B：根據環境智能選擇（推薦，兼顧用戶體驗與相容性）
            detectEnvironmentAndChooseMethod();
        };

        // ========================================
        // 方案 A：使用 Server-side OAuth（推薦用於生產環境）
        // ========================================
        // 優點：
        //   - 100% 可靠，不受瀏覽器限制
        //   - 統一流程，易於維護
        //   - 完整的後端控制與審計
        // 缺點：
        //   - 需要額外的 OAuth 頁面跳轉
        //   - 用戶體驗稍微複雜一點
        // 
        // 特殊處理：
        //   - ✅ 綁定頁面需要在 OAuth 完成後回到綁定頁面本身
        //   - ✅ 使用特殊的 returnUrl 標記為綁定流程
        // ========================================
        function useServerSideOAuth() {
            console.log('[LineLiffView] 使用 Server-side OAuth 2.0 綁定流程');
            document.getElementById('displaynamefield').innerHTML = '正在導向 LINE 授權頁面...';
            ShowToast('正在導向 LINE 授權頁面...', 'info', 2000);

            setTimeout(function () {
                // ========================================
                // ✅ P0: 綁定頁面專用處理
                // ========================================
                // 重要：加入 returnUrl 參數，標記為綁定流程
                // 使用特殊值 "_BINDING_" 表示這是綁定頁面
                // 後端會識別此標記，完成後回到綁定頁面
                // ========================================
                console.log('[LineLiffView] 導向 LineLoginStart，returnUrl=_BINDING_');
                
                // 使用特殊的 returnUrl 值 "_BINDING_" 表示綁定流程
                window.location.href = '/Authentication/LineLoginStart?returnUrl=_BINDING_';
            }, 500);
        }

        // ========================================
        // 方案 B：根據環境智能選擇（推薦）
        // ========================================
        // 策略：
        //   - 手機版 LINE → 使用 LIFF SDK（最佳用戶體驗）
        //   - 電腦版 LINE → 使用 Server-side OAuth（避免 LIFF 限制）
        //   - 外部瀏覽器 → 優先使用 LIFF SDK，失敗時 fallback 到 OAuth
        // 
        // 技術細節：
        //   - liff.getOS() 返回值：'ios', 'android', 'web'
        //   - liff.isInClient() 判斷是否在 LINE 應用內
        //   - 電腦版 LINE 通常是 os='web' && isInClient=true
        // ========================================
        function detectEnvironmentAndChooseMethod() {
            liff
                .init({ liffId: '@TempData["Proponent"]' })
                .then(async () => {
                    var os = '';
                    var isInClient = false;

                    try { os = liff.getOS(); } catch (e) { console.warn('[LIFF] 無法取得 OS:', e); }
                    try { isInClient = liff.isInClient(); } catch (e) { console.warn('[LIFF] 無法判斷 isInClient:', e); }

                    console.log('[LineLiffView] 環境偵測結果:', { os: os, isInClient: isInClient });

                    // ========================================
                    // ✅ P0: 環境判斷邏輯
                    // ========================================
                    // 判斷規則：
                    //   1. os === 'web' → 可能是電腦版 LINE 或桌面瀏覽器
                    //   2. !isInClient → 外部瀏覽器（Chrome, Safari 等）
                    //   3. 電腦版 LINE：os='web' && isInClient=true
                    // 
                    // 決策：
                    //   - 電腦版 LINE 或外部瀏覽器 → 使用 Server-side OAuth
                    //   - 手機版 LINE (ios/android) → 使用 LIFF SDK
                    // ========================================
                    if (os === 'web' || !isInClient) {
                        console.log('[LineLiffView] ✅ 偵測到電腦版 LINE 或外部瀏覽器環境');
                        console.log('[LineLiffView] 使用 Server-side OAuth 2.0 綁定流程');
                        useServerSideOAuth();
                    } else {
                        console.log('[LineLiffView] ✅ 偵測到手機版 LINE 環境');
                        console.log('[LineLiffView] 使用原有 LIFF SDK 綁定流程');
                        useLiffSdk();
                    }
                })
                .catch(function (error) {
                    console.error('[LineLiffView] ❌ LIFF 初始化失敗:', error);
                    console.error('[LineLiffView] 錯誤訊息:', error.message);
                    console.error('[LineLiffView] 錯誤堆疊:', error.stack);

                    // ========================================
                    // ✅ P0: LIFF 初始化失敗處理
                    // ========================================
                    // 原因：
                    //   - LIFF ID 錯誤
                    //   - 網路問題
                    //   - LINE Platform 服務中斷
                    // 
                    // 處理策略：
                    //   - 使用 Server-side OAuth 作為 fallback
                    //   - 顯示友善的錯誤訊息
                    //   - 記錄詳細的錯誤日誌（便於除錯）
                    // ========================================
                    document.getElementById('displaynamefield').innerHTML = 'LIFF 初始化失敗';
                    ShowToast('LIFF 初始化失敗，將使用替代綁定方式', 'warning', 3000);

                    // LIFF 初始化失敗，使用 Server-side OAuth 作為 fallback
                    setTimeout(function () {
                        useServerSideOAuth();
                    }, 3000);
                });
        }

        // ========================================
        // LIFF SDK 流程（手機版 LINE 專用）
        // ========================================
        // 這是原有的邏輯，完全保留不變
        // 僅增加詳細的註解與日誌輸出
        // ========================================
        function useLiffSdk() {
            console.log('[LineLiffView] ========== 開始 LIFF SDK 綁定流程 ==========');

            // ========================================
            // ✅ Step 1: 檢查登入狀態
            // ========================================
            if (!liff.isLoggedIn()) {
                console.log('[LineLiffView] ⚠️ 用戶尚未登入 LINE');
                document.getElementById('displaynamefield').innerHTML = "您還沒有登入LINE";
                ShowToast("您還沒有登入LINE，將為您導向登入頁面", "warning", 3000);

                // 導向 LINE 登入頁面
                setTimeout(function () {
                    try {
                        console.log('[LineLiffView] 導向 LINE 登入頁面...');
                        liff.login({ redirectUri: cleanUrl });
                    } catch (e) {
                        console.error('[LineLiffView] ❌ liff.login() 失敗:', e);
                        // 如果 LIFF login 失敗，改用 Server-side OAuth
                        useServerSideOAuth();
                    }
                }, 1000);
                return;
            }

            // ========================================
            // ✅ Step 2: 檢查權限授權
            // ========================================
            console.log('[LineLiffView] ✅ 用戶已登入 LINE');
            console.log('[LineLiffView] 檢查 profile 權限...');

            liff.permission.query("profile")
                .then((permissionStatus) => {
                    console.log('[LineLiffView] 權限狀態:', permissionStatus.state);

                    if (permissionStatus.state === "granted") {
                        // ✅ 已授權，繼續綁定流程
                        console.log('[LineLiffView] ✅ profile 權限已授權');
                        initializeApp();
                    }
                    else if (permissionStatus.state === "prompt") {
                        // ⚠️ 需要用戶授權
                        console.log('[LineLiffView] ⚠️ 需要用戶授權 profile 權限');
                        document.getElementById('displaynamefield').innerHTML = "您並未授權，請先完成授權程序!";
                        document.getElementById('remind').innerHTML = "";
                        ShowToast("請授權取得基本資料", "warning", 3000);

                        // 請求權限
                        try {
                            liff.permission.requestAll();
                        } catch (e) {
                            console.error('[LineLiffView] ❌ requestAll() 失敗:', e);
                        }
                    }
                    else {
                        // ❌ 權限未設定或被拒絕
                        console.error('[LineLiffView] ❌ Liff Scope 沒有設定或被拒絕');
                        document.getElementById('displaynamefield').innerHTML = "Liff Scope沒有設定，所以無法操作!";
                        ShowToast("Liff Scope 未設定，請聯繫管理員", "error", 5000);
                    }
                })
                .catch((error) => {
                    console.error('[LineLiffView] ❌ 權限檢查失敗:', error);
                    // 權限檢查失敗，直接嘗試取得 profile
                    console.log('[LineLiffView] 嘗試直接取得 profile...');
                    initializeApp();
                });
        }

        // ========================================
        // 全域變數（保持不變）
        // ========================================
        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";
        var PictureUrl = "";
        var StatusMessage = "";

        // ========================================
        // 初始化應用程式，獲取用戶資訊（原有邏輯，僅增加日誌）
        // ========================================
        // 功能：
        //   1. 使用 liff.getProfile() 取得用戶資訊
        //   2. 填充表單隱藏欄位（LineUserId, DisplayName 等）
        //   3. 呼叫 UpdateLineUserId 檢查是否已綁定
        // 
        // 架構師註解：
        //   - 此函數為核心業務邏輯，不應修改
        //   - 僅增加日誌輸出，便於追蹤與除錯
        // ========================================
        async function initializeApp() {
            console.log('[LineLiffView] ========== 開始取得 LINE Profile ==========');

            await liff.getProfile()
                .then(function (profile) {
                    console.log('[LineLiffView] ✅ 成功取得 LINE Profile');
                    console.log('[LineLiffView] Profile:', {
                        displayName: profile.displayName,
                        userId: profile.userId,
                        pictureUrl: profile.pictureUrl,
                        statusMessage: profile.statusMessage
                    });

                    // 更新頁面顯示
                    document.getElementById('displaynamefield').innerHTML = profile.displayName + "註冊";

                    // 儲存用戶資訊
                    DisplayName = profile.displayName;
                    UserId = profile.userId;
                    GroupId = profile.aGroupId;
                    RoomId = profile.aRoomId;
                    ViewType = profile.aViewType;
                    PictureUrl = profile.pictureUrl || "";
                    StatusMessage = profile.statusMessage || "";

                    // 將 LINE Profile 資料填入隱藏欄位
                    var formInstance = $("#form").dxForm("instance");
                    formInstance.updateData("LineUserId", UserId);
                    formInstance.updateData("DisplayName", DisplayName);
                    formInstance.updateData("PictureUrl", PictureUrl);
                    formInstance.updateData("StatusMessage", StatusMessage);

                    console.log("[LineLiffView] 表單已更新，準備檢查綁定狀態...");

                    // 檢查用戶是否已綁定
                    UpdateLineUserId(UserId, GroupId, RoomId, ViewType, DisplayName, PictureUrl, StatusMessage);
                })
                .catch(error => {
                    console.error('[LineLiffView] ❌ 取得 Profile 失敗:', error);
                    console.error('[LineLiffView] 錯誤訊息:', error.message);
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error.message;
                    ShowToast("取得用戶資料失敗: " + error.message, "error", 5000);
                });
        }

        // ========================================
        // 更新 LINE UserId 到伺服器（原有邏輯，僅增加日誌）
        // ========================================
        // 功能：
        //   1. 將 LINE UserId 傳送到後端
        //   2. 後端檢查此 LINE ID 是否已綁定
        //   3. 如果已綁定，隱藏註冊表單
        // 
        // 架構師註解：
        //   - 此函數為關鍵 API 呼叫，不應修改
        //   - 僅增加日誌輸出與錯誤處理
        // ========================================
        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType, aDisplayName, aPictureUrl, aStatusMessage) {
            console.log('[LineLiffView] ========== 檢查綁定狀態 ==========');
            console.log('[LineLiffView] 參數:', {
                UserLineId: aUserLineId,
                GroupId: aGroupId,
                RoomId: aRoomId,
                ViewType: aViewType,
                DisplayName: aDisplayName
            });

            $.ajax({
                url: '@Url.Action("SaveUserId", "Home")',
                data: {
                    UserLineId: aUserLineId,
                    GroupId: aGroupId,
                    RoomId: aRoomId,
                    ViewType: aViewType,
                    DisplayName: aDisplayName,
                    PictureUrl: aPictureUrl,
                    StatusMessage: aStatusMessage
                },
                type: 'POST',
                success: function (data) {
                    console.log('[LineLiffView] ✅ AJAX Success:', data);

                    if (data.status == 1) {
                        // ✅ 尚未綁定，顯示註冊表單
                        console.log('[LineLiffView] ✅ LINE ID 尚未綁定，顯示註冊表單');
                        ShowToast(data.message, "success", 2000);
                    }
                    else {
                        // ⚠️ 已綁定，隱藏註冊表單
                        console.log('[LineLiffView] ⚠️ LINE ID 已綁定，無需註冊');
                        ShowToast(data.message + "，您不需要註冊了", "info", 5000);
                        document.getElementById('displaynamefield').innerHTML = data.message + "，您不需要註冊了";
                        document.getElementById('remind').innerHTML = "願神與您同在!";
                        document.getElementById("form-container").style.display = "none";
                        document.getElementById("buttonContainer").style.display = "none";
                        $("#register-button").dxButton("instance").option("visible", false);
                    }
                },
                error: function (xhr, status, error) {
                    console.error('[LineLiffView] ❌ AJAX Error:', {
                        status: status,
                        error: error,
                        statusCode: xhr.status,
                        responseText: xhr.responseText
                    });

                    ShowToast("檢查綁定狀態失敗，請稍後再試", "error", 3000);
                }
            });
        }

        // ========================================
        // 顯示 Toast 通知（原有邏輯，保持不變）
        // ========================================
        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }
    </script>
</body>
</html>