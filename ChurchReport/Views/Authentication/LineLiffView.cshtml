<!DOCTYPE html>

@* 
    這個視圖用於 LINE LIFF 身分綁定註冊頁面。
    使用者可以輸入個人資訊並綁定 LINE 帳號。
*@

@{
    Layout = null;
}

@using ChurchReport.ViewModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@model LineBindingViewModel

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>新莊靈糧堂</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Bootstrap 和 DevExtreme CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/LineLiffView.css" rel="stylesheet" />

    <!-- jQuery 和 Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <!-- DevExtreme 全球化腳本 -->
    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>

    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>

    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

    @* JSZip for client side export (註釋掉) *@
    @*<script src="~/js/devextreme/jszip.js"></script>*@

    <!-- DevExtreme 核心腳本 -->
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>

    <style>
        /* Hero 橫幅與覆蓋層 */
        .hero-wrapper { position: relative; width:100%; height: 300px; overflow:hidden; }
        .hero-overlay { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; color:#fff; padding:1rem; background: linear-gradient(135deg, rgba(0,0,0,.55), rgba(0,0,0,.25)); }
        .hero-overlay h1 { font-size:1.9rem; letter-spacing:2px; font-weight:700; margin-bottom:.35rem; }
        .hero-overlay .sub { font-size:.95rem; opacity:.95; margin-bottom:.5rem; }
        .hero-overlay .verse { font-size:.95rem; line-height:1.4; max-width:680px; }
        .hero-overlay .verse span { display:block; margin-top:.25rem; font-size:.78rem; opacity:.85; }
        .logo-faith { font-size:2.2rem; margin-bottom:.35rem; color:#fff; animation: pulse 3.5s infinite; }
        @@keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }

        /* 表單卡片樣式 */
        .cr-card { border-radius: 18px; overflow:hidden; max-width:760px; width:100%; margin:0 auto; }
        .cr-card .card-body { padding:1.25rem 1rem 1.5rem; }
        #displaynamefield { font-weight:600; font-size:1.8rem; color:#35507d; }
        #remind { color:#6b7280; }

        /* Toast 置頂顯示 */
        .dx-toast-content { border-radius: 10px; }

        /* 聯絡資訊字型放大 1.3 倍 */
        .card-body-soft h5 { font-size:1.625rem; }
        .info-list { list-style:none; padding:0; margin:0; }
        .info-list li { margin-bottom:.5rem; }
        .info-label, .info-value { font-size:1.3rem; line-height:1.4; }

        @@media (max-width: 575.98px) {
            .hero-wrapper { height: 260px; }
            .hero-overlay h1 { font-size:1.6rem; }
        }
    </style>
</head>

<body class="bg-light">
    <!-- Hero：背景 Gallery 疊加經文 -->
    <section class="hero-wrapper" aria-label="歡迎區">
        <div class="position-absolute w-100 h-100" style="z-index:1;">
            @(Html.DevExtreme().Gallery()
                .ID("gallery")
                .DataSource(Model.Images)
                .Height("100%")
                .StretchImages(true)
                .Loop(true)
                .SlideshowDelay(1800)
                .ShowNavButtons(true)
                .ShowIndicator(true)
            )
        </div>
        <div class="hero-overlay" role="banner">
            <i class="fa-solid fa-dove logo-faith" aria-hidden="true"></i>
            <h1>新莊靈糧堂</h1>
            <div class="sub">LINE 身分綁定註冊</div>
            <div class="verse">你要專心仰賴耶和華，不可倚靠自己的聰明。<span>— 箴言 3:5</span></div>
        </div>
    </section>

    <!-- 主要內容 -->
    <main class="container d-flex justify-content-center pb-5">
        <div class="cr-card card shadow-lg border-0 w-100">
            <!-- 註冊表單 -->
            <div class="card-body">
                <h5 id="displaynamefield" class="text-center mb-2"></h5>
                <p id="remind" class="text-center cr-subtext mb-4">請輸入真實姓名</p>

                <form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="ProcessLineBinding" asp-controller="Home" method="post" class="text-center-important">
                    <div class="dx-field">
                        <div class="form-container-class" id="form-container">
                            @(Html.DevExtreme().Form<LineBindingViewModel>()
                                           .ID("form")
                                           .Items(items =>
                                           {
                                               // 主要姓名欄位
                                               items.AddSimpleFor(m => m.FullName)
                                                   .Label(l => l.Text("主要姓名"))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入姓名(必填)")
                                                       .ShowClearButton(true)
                                                  )
                                                    .ValidationRules(r => r
                                                            .AddRequired()
                                                            .Message("主要姓名必填")
                                                        );

                                               // 其他姓名欄位
                                               items.AddSimpleFor(m => m.OtherName)
                                                   .Label(l => l.Text("其他姓名"))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入其他姓名(選填)")
                                                       .ShowClearButton(true)
                                                  );

                                               // 行動電話欄位
                                               items.AddSimpleFor(m => m.Mobile)
                                                   .Label(l => l.Text("行動電話"))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入行動電話(必填)")
                                                       .ShowClearButton(true)
                                                  )
                                                  .ValidationRules(r => r
                                                            .AddRequired()
                                                            .Message("行動電話必填")
                                                        );

                                               // Line UserId 欄位 (隱藏)
                                               items.AddSimpleFor(m => m.LineUserId)
                                                   .Label(l => l.Text("Line Id").Visible(false))
                                                   .Editor(e => e
                                                       .TextBox()
                                                       .Mode(TextBoxMode.Text)
                                                       .Disabled(false)
                                                       .Placeholder("輸入行動電話")
                                                       .ShowClearButton(true)
                                                       .Value(Model.LineUserId)
                                                       .Visible(false)
                                                  );




                                                            // DisplayName 欄位 (隱藏)
                                                            items.AddSimpleFor(m => m.DisplayName)
                                                            .Label(l => l.Text("Display Name").Visible(false))
                                                            .Editor(e => e
                                                            .TextBox()
                                                            .Mode(TextBoxMode.Text)
                                                            .Disabled(false)
                                                            .Visible(false)
                                                            );

                                                            // PictureUrl 欄位 (隱藏)
                                                            items.AddSimpleFor(m => m.PictureUrl)
                                                            .Label(l => l.Text("Picture Url").Visible(false))
                                                            .Editor(e => e
                                                            .TextBox()
                                                            .Mode(TextBoxMode.Text)
                                                            .Disabled(false)
                                                            .Visible(false)
                                                            );

                                                            // StatusMessage 欄位 (隱藏)
                                                            items.AddSimpleFor(m => m.StatusMessage)
                                                            .Label(l => l.Text("Status Message").Visible(false))
                                                            .Editor(e => e
                                                            .TextBox()
                                                            .Mode(TextBoxMode.Text)
                                                            .Disabled(false)
                                                            .Visible(false)
                                                            );

                                           })
                            )
                        </div>
                    </div>

                    <!-- 按鈕和載入面板 -->
                    <div class="dx-field">
                        <div id="buttonContainer" class="dx-button-icon mb-3 d-flex justify-content-center">
                            @(Html.DevExtreme().Button()
                                            .Text("註冊")
                                            .Type(ButtonType.Default)
                                            .ID("register-button")
                                            .UseSubmitBehavior(true)
                                            .OnClick("Register")
                                            .Width(140)
                            )
                        </div>
                        <div id="LoadPanel">
                            @(Html.DevExtreme().LoadPanel()
                                            .ID("loadPanel")
                                            .ShadingColor("rgba(0,0,0,0.4)")
                                            .Position(p => p.Of("#form-container"))
                                            .Visible(false)
                                            .ShowIndicator(true)
                                            .ShowPane(true)
                                            .Shading(true)
                                            .CloseOnOutsideClick(false)
                                            .Message("註冊中...")
                                            .Delay(5000)
                                            .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                            )
                        </div>
                    </div>
                </form>
            </div>

            <!-- 聯絡資訊 -->
            <div class="card-body-soft">
                <div class="row">
                    <div class="col-md-7">
                        <h5 style="font-weight:600; margin-bottom: 12px;">
                            <i class="fa-solid fa-church me-1"></i>聯絡資訊
                        </h5>
                        <ul class="info-list">
                            <li>
                                <span class="info-label">地址</span>
                                <span class="info-value">@Configuration["ChurchInfo:Address"]</span>
                            </li>
                            <li>
                                <span class="info-label">電話</span>
                                <span class="info-value">@Configuration["ChurchInfo:Phone"]</span>
                            </li>
                            <li>
                                <span class="info-label">信箱</span>
                                <span class="info-value">@Configuration["ChurchInfo:Email"]</span>
                            </li>
                            <li>
                                <span class="info-label">統編</span>
                                <span class="info-value">@Configuration["ChurchInfo:TaxId"]</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 版權 -->
            <div class="footer-note">Copyright © @DateTime.Now.Year 新莊靈糧堂</div>
        </div>
    </main>

    <!-- Toast 通知 -->
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                        .ID("Toast")
                        .Position(p => p
                            .At(HorizontalAlignment.Center, VerticalAlignment.Top)
                            .Offset(0, 80))
                        .DisplayTime(2200)
                        .MaxWidth(260)
                        .CloseOnOutsideClick(true)
        )
    </div>

    <!-- 外部腳本 -->
    <script src="~/js/liff-starter.js"></script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

    <!-- JavaScript 函數 -->
    <script>
        // 獲取載入面板實例
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }

        // 按鈕點擊事件 (未使用)
        function button_click() {
            getLoadPanelInstance().show();
        }

        // 載入面板顯示事件 (未實現)
        function loadPanel_shown(e) {
        }

        // 載入面板隱藏事件 (未實現)
        function loadPanel_hidden() {
        }

        // 註冊按鈕點擊事件
        function Register(arg) {
            var ButtonContainer = $("#register-button").dxButton("instance");
            ButtonContainer.option("disabled", true);
            ShowToast("正在處理中，請稍待...", "success", 3000);
            DevExpress.ui.notify({
                displayTime: 3000,
                closeOnClick: true,
                message: "正在處理中，請稍待喔...",
                type: 'success',
            });
            getLoadPanelInstance().show();
        }
    </script>

    <!-- AJAX 相關腳本 -->
    <script type="text/javascript">
        // AJAX 開始事件
        function onBegin() {
            var ButtonContainer = $("#register-button").dxButton("instance");
            ButtonContainer.option("disabled", true);
            getLoadPanelInstance().show();
        }

        // AJAX 成功事件
        function onSuccess(data) {
            var ButtonContainer = $("#register-button").dxButton("instance");
            ButtonContainer.option("disabled", false);
            getLoadPanelInstance().hide();

            if (data.status == 1) {
                DevExpress.ui.notify({
                    displayTime: 15000,
                    closeOnClick: true,
                    message: data.message,
                    type: 'success',
                });
                document.getElementById('displaynamefield').innerHTML = data.message;
            }
            else {
                DevExpress.ui.notify(data.message, "error", 5000);
                document.getElementById('displaynamefield').innerHTML = data.message;
            }
        }

        // AJAX 完成事件 (未實現)
        function onComplete(data) {
        }
    </script>

    <!-- LINE LIFF 腳本 -->
    <script>
        // 頁面載入初始化 LIFF
        window.onload = function (e) {
            liff
                .init({ liffId: '@TempData["Proponent"]' })
                .then(() => {
                    if (!liff.isLoggedIn()) {
                        document.getElementById('displaynamefield').innerHTML = "您還沒有登入LINE";
                        ShowToast("您還沒有登入LINE", "error", 5000);
                        liff.login();
                        return;
                    }
                    else {
                        liff.permission.query("profile").then((permissionStatus) => {
                            if (permissionStatus.state === "granted") {
                                initializeApp();
                            }
                            else if (permissionStatus.state === "prompt") {
                                document.getElementById('displaynamefield').innerHTML = "您並未授權，請先完成授權程序!";
                                document.getElementById('remind').innerHTML = "";
                                liff.permission.requestAll();
                            }
                            else {
                                document.getElementById('displaynamefield').innerHTML = "Liff Scope沒有設定，所以無法操作!";
                            }
                        });
                    }
                })
                .catch(error => {
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });
        };

        // 全域變數
        var UserId = "";
        var GroupId = "";
        var RoomId = "";
        var DisplayName = "";
        var ViewType = "";
        var PictureUrl = "";
        var StatusMessage = "";

        // 初始化應用程式，獲取用戶資訊
        async function initializeApp() {
            await liff.getProfile()
                .then(function (profile) {
                    document.getElementById('displaynamefield').innerHTML = profile.displayName + "註冊";
                    DisplayName = profile.displayName;
                    UserId = profile.userId;
                    GroupId = profile.aGroupId;
                    RoomId = profile.aRoomId;
                    ViewType = profile.aViewType;
                    PictureUrl = profile.pictureUrl || "";
                    StatusMessage = profile.statusMessage || "";

                    // 將 LINE Profile 資料填入隱藏欄位
                    var formInstance = $("#form").dxForm("instance");
                    formInstance.updateData("LineUserId", UserId);
                    formInstance.updateData("DisplayName", DisplayName);
                    formInstance.updateData("PictureUrl", PictureUrl);
                    formInstance.updateData("StatusMessage", StatusMessage);

                    console.log("[LIFF Profile] DisplayName:", DisplayName);
                    console.log("[LIFF Profile] UserId:", UserId);
                    console.log("[LIFF Profile] PictureUrl:", PictureUrl);
                    console.log("[LIFF Profile] StatusMessage:", StatusMessage);

                    UpdateLineUserId(UserId, GroupId, RoomId, ViewType, DisplayName, PictureUrl, StatusMessage);
                })
                .catch(error => {
                    document.getElementById('displaynamefield').innerHTML = "錯誤:" + error;
                });
        }

        // 更新 LINE UserId 到伺服器
        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType, aDisplayName, aPictureUrl, aStatusMessage) {
            $.ajax({
                url: '@Url.Action("SaveUserId", "Home")',
                data: { UserLineId: aUserLineId, GroupId: aGroupId, RoomId: aRoomId, ViewType: aViewType, DisplayName: aDisplayName, PictureUrl: aPictureUrl, StatusMessage: aStatusMessage },
                type: 'POST',
                success: function (data) {
                    if (data.status == 1) {
                        ShowToast(data.message, "success", 2000);
                    }
                    else {
                        ShowToast(data.message + "，您不需要註冊了", "error", 5000);
                        document.getElementById('displaynamefield').innerHTML = data.message + "，您不需要註冊了";
                        document.getElementById('remind').innerHTML = "願神與您同在!";
                        document.getElementById("form-container").style.display = "none";
                        document.getElementById("buttonContainer").style.display = "none";
                        $("#register-button").dxButton("instance").option("visible", false);
                    }
                },
                error: function (obj) {
                }
            });
        }

        // 顯示 Toast 通知
        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('white-space', 'pre-line');
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }
    </script>
</body>
</html>