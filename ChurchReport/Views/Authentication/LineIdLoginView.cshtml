@* 
    這個視圖用於 LINE ID 登入頁面 (改版)。
    改善：響應式、行動優先、基督教風格、Hero 區塊、卡片式資訊、圖示、語意化標籤。
*@
@{
    Layout = null;
}
@model ChurchReport.ViewModel.LineBindingViewModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="好牧人 LINE 登入" />
    <meta name="author" content="好牧人" />
    <title>好牧人 LINE 登入</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <!-- Bootstrap / DevExtreme / FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/css/LineIdLoginView.css" rel="stylesheet" />
    <!-- ✅ LINE Mini App Safe Area 適配 CSS -->
    <link href="~/css/mini-app-safe-area.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- jQuery / Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <!-- DevExtreme Globalization -->
    <script src="~/js/devextreme/cldr.js"></script>
    <script src="~/js/devextreme/cldr/event.js"></script>
    <script src="~/js/devextreme/cldr/supplemental.js"></script>
    <script src="~/js/devextreme/cldr/unresolved.js"></script>
    <script src="~/js/devextreme/globalize.js"></script>
    <script src="~/js/devextreme/globalize/message.js"></script>
    <script src="~/js/devextreme/globalize/number.js"></script>
    <script src="~/js/devextreme/globalize/currency.js"></script>
    <script src="~/js/devextreme/globalize/date.js"></script>
    <!-- DevExtreme Core -->
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/vectormap-data/world.js"></script>
    <script src="~/lib/devextreme-aspnet-data/js/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
</head>
<body class="bg-light">
    <!-- Hero & Gallery -->
    <section class="hero-wrapper" aria-label="歡迎區">
        <div class="position-absolute w-100 h-100" style="z-index:1;">
            @(Html.DevExtreme().Gallery()
                        .ID("gallery")
                        .DataSource(Model.Images)
                        .Height("100%")
                        .StretchImages(true)
                        .Loop(true)
                        .SlideshowDelay(2500)
                        )
        </div>
        <div class="hero-overlay" role="banner">
            <i class="fa-solid fa-dove logo-faith mb-2" aria-hidden="true"></i>
            <h1>好牧人</h1>
            @*             <div id="displaynamefield" class="mb-2"></div>
 *@            <p class="verse">
                我們愛，因為神先愛我們。<span>— 約翰一書 4:19</span>
            </p>
            @*             <div class="action-buttons">
                <button type="button" class="btn btn-primary" onclick="Binding()"><i class="fa-link fa-solid me-1"></i>綁定帳號</button>
                <button type="button" class="btn btn-outline-light" onclick="Login()"><i class="fa-right-to-bracket fa-solid me-1"></i>帳號登入</button>
            </div>
 *@        </div>
    </section>

    <div id="displaynamefield" class="mb-5"></div>

    <!-- 主內容 -->
    <main class="container info-section mx-auto" role="main" style="max-width: 960px;">
        <div class="row justify-content-center">
            <div class="col-12">
                <div id="ContactMessage" class="card-soft mb-4 mx-auto" aria-labelledby="contactHeader" style="max-width: 880px;">
                    <div class="card-soft-header" id="contactHeader">
                        <i class="fa-solid fa-church"></i><span>聯絡資訊</span>
                    </div>
                    <div class="p-3 p-md-4">
                        <ul class="contact-list" aria-label="教會聯絡資訊">
                            <li><div class="contact-icon"><i class="fa-solid fa-location-dot"></i></div><div class="contact-text">@Configuration["ChurchInfo:Address"]</div></li>
                            <li><div class="contact-icon"><i class="fa-solid fa-phone"></i></div><div class="contact-text">@Configuration["ChurchInfo:Phone"]</div></li>
                            <li><div class="contact-icon"><i class="fa-solid fa-envelope"></i></div><div class="contact-text">@Configuration["ChurchInfo:Email"]</div></li>
                            <li><div class="contact-icon"><i class="fa-solid fa-file-invoice"></i></div><div class="contact-text">統一編號：@Configuration["ChurchInfo:TaxId"]</div></li>
                        </ul>
                        @*                         <div class="small text-muted mt-3">
                            若您尚未完成 LINE 綁定，請點選「綁定帳號」；完成後將自動導向您的專屬頁面。
                        </div>
 *@                    </div>
                </div>
            </div>
        </div>
        <!-- DevExtreme Widget Container (Toast & LoadPanel) -->
        <div id="WidgetContainer">
            @(Html.DevExtreme().Toast()
                        .ID("Toast")
                        .Position(p => p
                        .At(HorizontalAlignment.Center, VerticalAlignment.Top)
                        .Offset(0, 90))
                        .CloseOnOutsideClick(true)
                        .DisplayTime(2600)
                        .MaxWidth(320)
                        )
            @(Html.DevExtreme().LoadPanel()
                        .ID("loadPanel")
                        .ShadingColor("rgba(0,0,0,0.45)")
                        .Position(p => p.Of("#ContactMessage"))
                        .Visible(false)
                        .ShowIndicator(true)
                        .ShowPane(true)
                        .Shading(true)
                        .CloseOnOutsideClick(false)
                        .Message("登入中，請稍候…")
                        .Delay(600)
                        .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                        )
        </div>
    </main>
    <footer class="footer-note" role="contentinfo">Copyright © @DateTime.Now.Year 好牧人</footer>
    <!-- JS Functions -->
    <script>
        function getLoadPanelInstance() { return $("#loadPanel").dxLoadPanel("instance"); }
        function loadPanel_show() { getLoadPanelInstance().show(); }
        function loadPanel_hide() { getLoadPanelInstance().hide(); }
        function Binding() { window.location.href = "/Authentication/LineLiffView/1653819697-YkPyPkr6"; }
        function Login() { window.location.href = "/Authentication/Login"; }
    </script>
    <script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
    <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
    <script>
        // ========================================
        // LINE ID 登入流程
        // ========================================
        // 此頁固定走 LIFF SDK，避免切到 callback URL 不相符的 OAuth 流程。

        var urlParams = new URLSearchParams(window.location.search);
        var bindingPageUrl = '/Authentication/LineLiffView/@(Configuration["Liff:BindingLiffId"] ?? "1653819697-YkPyPkr6")';

        window.onload = function() {
            var initialError = urlParams.get('error');

            if (initialError) {
                document.getElementById('displaynamefield').innerHTML = initialError;
                ShowToast(initialError, 'error', 4000);
            } else {
                document.getElementById('displaynamefield').innerHTML = '正在準備 LINE 登入...';
            }

            detectEnvironmentAndChooseMethod();
        };

        // ========================================
        // 初始化 LIFF 登入
        // ========================================
        function detectEnvironmentAndChooseMethod() {
            // 優先取 ViewBag.LiffId（Server 端 render，最可靠），備援從 URL path 最後一段取得
            var liffId = '@ViewBag.LiffId';
            if (!liffId || liffId.trim() === '') {
                var pathParts = window.location.pathname.split('/');
                liffId = pathParts[pathParts.length - 1] || '';
            }
            console.log('[LINE Login] detectEnvironmentAndChooseMethod, liffId =', liffId);

            // 先嘗試 liff.init()
            liff.init({ liffId: liffId })
                .then(function() {
                    // 不論在 LINE App 內或外部瀏覽器，一律走 LIFF SDK 登入。
                    // 這個 LINE ID 頁面不再退回 /Authentication/LineLoginStart，
                    // 避免 OAuth callback URL 與 LINE Channel 設定不一致時出現 400。
                    useLiffSdk();
                })
                .catch(function(error) {
                    console.error('[LIFF Init Error]', error);
                    document.getElementById('displaynamefield').innerHTML = 'LINE 初始化失敗：' + error;
                    ShowToast('LINE 初始化失敗', 'error', 4000);
                });
        }

        // ========================================
        // LIFF SDK 流程（手機版 LINE 用）
        // ========================================
        function useLiffSdk() {
            var isLoggedIn = false;
            var token = null;

            try { isLoggedIn = liff.isLoggedIn(); } catch (e) { }
            try { token = liff.getAccessToken(); } catch (e) { token = null; }

            if (isLoggedIn || token) {
                ensureProfilePermissionAndRun();
                return;
            }

            // 未登入，導向 LINE Login
            document.getElementById('displaynamefield').innerHTML = '您尚未登入 LINE';
            ShowToast('您尚未登入 LINE，將為您導向登入…', 'warning', 2500);

            setTimeout(function() {
                try {
                    // 不要自己帶 redirectUri！比照 VisitorCard.cshtml 的做法呼叫 liff.login()。
                    // 帶 redirectUri 會把該網址當成 redirect_uri 送給 LINE，若與 Console 登錄的
                    // LIFF Endpoint URL 不一致（例：送出 /Authentication/... 但登錄的是 /home/...），
                    // LINE 會回 400「invalid url ... redirect_uri」。不帶參數時 LINE 用預設值，必定被接受。
                    liff.login();
                } catch (e) {
                    console.error('[LIFF Login Error]', e);
                    document.getElementById('displaynamefield').innerHTML = 'LINE 登入失敗：' + e;
                }
            }, 600);
        }

        async function ensureProfilePermissionAndRun() {
            try {
                var permissionStatus = await liff.permission.query('profile');
                if (permissionStatus && permissionStatus.state === 'granted') {
                    initializeApp();
                    return;
                }
                if (permissionStatus && permissionStatus.state === 'prompt') {
                    document.getElementById('displaynamefield').innerHTML = '請授權取得基本資料';
                    try { liff.permission.requestAll(); } catch (e) { }
                    setTimeout(function() { initializeApp(); }, 800);
                    return;
                }
            } catch (e) {
                // 權限 API 不可用，直接嘗試
            }

            initializeApp();
        }

        var UserId = ""; var GroupId = ""; var RoomId = ""; var DisplayName = ""; var ViewType = "";

        async function initializeApp() {
            try {
                const profile = await liff.getProfile();

                document.getElementById('displaynamefield').innerHTML =
                    "歡迎 " + profile.displayName + " 登入<br/>" +
                    "願神永遠祝福 " + profile.displayName + "<br/>" +
                    "約需10~15秒，感謝您的耐心等候!";

                loadPanel_show();

                DisplayName = profile.displayName;
                UserId = profile.userId;
                GroupId = profile.aGroupId || "";
                RoomId = profile.aRoomId || "";
                ViewType = profile.aViewType || "";

                console.log('[LINE Profile]', { DisplayName, UserId, GroupId, RoomId, ViewType });

                UpdateLineUserId(UserId, GroupId, RoomId, ViewType);
            } catch (error) {
                console.error('[Get Profile Error]', error);
                document.getElementById('displaynamefield').innerHTML = "取得個人資料錯誤: " + error.message;
                ShowToast("取得個人資料失敗", "error", 3000);
                loadPanel_hide();
            }
        }

        function UpdateLineUserId(aUserLineId, aGroupId, aRoomId, aViewType) {
            console.log('[UpdateLineUserId] 開始更新 LINE ID', {
                UserLineId: aUserLineId,
                GroupId: aGroupId,
                RoomId: aRoomId,
                ViewType: aViewType
            });

            $.ajax({
                // ✅ 使用正確的 Controller 路徑
                url: '@Url.Action("SaveUserLineId", "Authentication")',
                data: {
                    UserLineId: aUserLineId,
                    GroupId: aGroupId,
                    RoomId: aRoomId,
                    ViewType: aViewType
                },
                type: 'POST',
                dataType: 'json',
                timeout: 30000, // 30 秒超時
                success: function(data) {
                    console.log('[AJAX Success]', data);

                    // ✅ 重要修正: 使用 PascalCase (因為 Startup.cs 使用 DefaultContractResolver)
                    // C# 回傳: DisplayViewType, ActiveListId (大寫開頭)
                    // JavaScript 存取: data.DisplayViewType, data.ActiveListId (大寫開頭)

                    if (data.message != "尚未綁定") {
                        ShowToast(data.message, "success", 1600);

                        // ✅ 使用 PascalCase 存取屬性
                        if (data.DisplayViewType == "MultiGroupView") {
                            console.log('[導向] MultiGroupView:', data.ActiveListId);
                            window.location.href = "/SmallGroup/MultiGroupView/" + data.ActiveListId;
                        } else if (data.DisplayViewType == "IntegrateView") {
                            console.log('[導向] IntegrateView:', data.ActiveListId);
                            window.location.href = "/SmallGroup/IntegrateView/" + data.ActiveListId;
                        } else if (data.DisplayViewType == "HappyGroupView") {
                            console.log('[導向] HappyGroupView');
                            window.location.href = "/SmallGroup/HappyGroup";
                        } else {
                            console.error('[導向錯誤] 未知的視圖類型:', data.DisplayViewType);
                            ShowToast("登入錯誤: 未知的視圖類型", "error", 3000);
                            loadPanel_hide();
                            document.getElementById('displaynamefield').innerHTML = "登入錯誤: 未知的視圖類型<br/><small>DisplayViewType=" + data.DisplayViewType + "</small>";
                        }
                    } else {
                        console.warn('[未綁定]', data.message);
                        console.warn('[未綁定] LIFF userId:', UserId);

                        // ========================================
                        // ✅ 未綁定就導向綁定頁，不從 LINE ID 登入頁切到 OAuth
                        // ========================================
                        // LIFF userId 沒有找到 CRM 綁定時，維持 LIFF 流程語意：
                        // 帶使用者進入綁定頁，而不是改用 callback URL 不同的 OAuth 流程。
                        // ========================================
                        console.log('[LINE Login] LINE ID 尚未綁定，導向綁定頁面');
                        ShowToast(data.message, "warning", 2200);
                        loadPanel_hide();
                        document.getElementById('displaynamefield').innerHTML = "尚未綁定帳號<br/>請先完成綁定程序";

                        setTimeout(function() {
                            window.location.href = bindingPageUrl;
                        }, 3000);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[AJAX Error]', {
                        status: status,
                        error: error,
                        statusCode: xhr.status,
                        responseText: xhr.responseText,
                        readyState: xhr.readyState
                    });

                    loadPanel_hide();

                    var errorMessage = "登入失敗";

                    if (xhr.status === 0) {
                        errorMessage = "網路連線失敗，請檢查網路設定";
                    } else if (xhr.status === 404) {
                        errorMessage = "找不到登入頁面 (404)";
                    } else if (xhr.status === 500) {
                        errorMessage = "伺服器錯誤 (500)";
                    } else if (status === 'timeout') {
                        errorMessage = "連線逾時，請稍後再試";
                    } else if (xhr.responseText) {
                        try {
                            var errorData = JSON.parse(xhr.responseText);
                            errorMessage = errorData.message || errorMessage;
                        } catch (e) {
                            errorMessage = "伺服器回應錯誤";
                        }
                    }

                    ShowToast(errorMessage, "error", 4000);
                    document.getElementById('displaynamefield').innerHTML =
                        errorMessage + "<br/><small>錯誤代碼: " + xhr.status + "</small>";

                    // 5 秒後導向登入頁
                    setTimeout(function() {
                        window.location.href = "/Authentication/Login";
                    }, 5000);
                }
            });
        }

        function ShowLoadPanel(LocalLoadPanelMessage) {
            var lp = $("#loadPanel").dxLoadPanel("instance");
            lp.option('message', LocalLoadPanelMessage);
            lp.show();
        }

        function ShowToast(LocalToastMessage, Type, DisplayTime) {
            var ToastInstance = $("#Toast").dxToast("instance");
            ToastInstance.option('message', LocalToastMessage);
            ToastInstance.option('type', Type);
            ToastInstance.option('displayTime', DisplayTime);
            ToastInstance.option('closeOnClick', true);
            ToastInstance.show();
        }
    </script>
</body>
</html>
