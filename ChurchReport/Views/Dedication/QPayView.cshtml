@using ChurchReport.Models
@model QpayModel

@{
    ViewBag.Title = "線上奉獻 - 聖谷行道會";
}

<!-- ==================== 頁面頭部 ==================== -->
<head>
    <meta charset="UTF-8">
@*     <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1">
 *@    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link rel="shortcut icon" href="~/assets/images/logo4.png" type="image/x-icon">
    
    <!-- 外部 CSS 庫（只保留不影響 navbar 的 icon） -->
    <link rel="stylesheet" href="~/assets/web/assets/mobirise-icons/mobirise-icons.css">
    
    <!-- DevExtreme & 自定義 CSS -->
    <link href="~/css/devextreme/dx.generic.custom-scheme.css" rel="stylesheet">
    <link href="~/css/Gallery.css" rel="stylesheet">
    <link href="~/css/WeeklyReport.css" rel="stylesheet">
    <link href="~/css/Scheduler.css" rel="stylesheet">
    <link href="~/css/Site.css" rel="stylesheet">
    
    <!-- QPayView 專屬樣式 -->
    <link href="~/css/QPayView.css?v=20251024" rel="stylesheet">
</head>

<style>
  /* 放大 ATM 資訊區域字體 */
  #atmfield { font-size: 150%; }
</style>

<!-- ==================== 頁面主容器 ==================== -->
<div class="qpay-page">
    <div class="qpay-container">
        <!-- ==================== 奉獻者資訊 ==================== -->
        <div class="dedication-header">
            <h4 id="displaynamefield">
                <i class="mbri-user" style="margin-right: 10px;"></i>
                @Model.FullName 
                <span style="margin: 0 15px;">|</span> 
                <i class="mbri-numbered-list" style="margin-right: 10px;"></i>
                奉獻編號: @Model.DedicationNumber
            </h4>
        </div>

        <!-- ==================== 奉獻表單 ==================== -->
        <form data-ajax="true" 
              data-ajax-begin="onBegin" 
              data-ajax-success="onSuccess" 
              asp-action="SaveQPayDedication" 
              asp-controller="Dedication" 
              method="post">
            
            <div id="form-container">
                <h5 style="color: #20b2aa; margin-bottom: 25px; font-weight: 600; font-size: 1.3rem;">
                    <i class="mbri-edit" style="margin-right: 10px;"></i>奉獻資訊
                </h5>
                
                @(Html.DevExtreme().Form<QpayModel>()
                    .ID("form")
                    .ColCount(1)
                    .FormData(Model)
                    .OnContentReady(@<text>
                        function(e) {
                            e.component.validate();
                        }
                    </text>)
                    .Items(items =>
                    {
                        // 奉獻類別
                        items.AddSimpleFor(m => m.Category)
                            .Label(l => l.Text("奉獻類別"))
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(new string[] {
                                    "主日奉獻", "十一奉獻", "感恩奉獻", "建堂奉獻",
                                    "宣教奉獻", "愛心奉獻", "特別獻金"
                                })
                                .OnValueChanged("OnCategorySelectBoxValueChanged")
                            );

                        // 宣教對象
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("宣教對象"))
                            .Visible(false)
                            .Name("OtherDedicationSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(Model.OtherCategoryArray)
                                .Placeholder("請選擇宣教對象")
                            );

                        // 特別獻金項目
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("特別獻金項目"))
                            .Visible(false)
                            .Name("SpecialDedicationSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(Model.SpecialCategoryArray)
                                .Placeholder("請選擇特別獻金項目")
                            );

                        // 其他奉獻內容
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("其他奉獻內容"))
                            .Visible(false)
                            .Name("OtherDedication")
                            .Editor(e => e
                                .Autocomplete()
                                .Width(200)
                                .DataSource(Model.OtherCategoryArray)
                                .Placeholder("請輸入其他奉獻內容")
                            );

                        // 節期選項
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("節期"))
                            .Visible(false)
                            .Name("HolidayDedicationSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(250)
                                .DataSource(new string[] {
                                    "元旦", "新春", "清明節", "復活節", "母親節",
                                    "父親節", "重陽節", "感恩節", "聖誕節"
                                })
                                .Placeholder("請選擇節期")
                            );

                        // 奉獻金額
                        items.AddSimpleFor(m => m.Amount)
                            .Label(l => l.Text("奉獻金額"))
                            .Name("DedicationAmount")
                            .Editor(e => e
                                .NumberBox()
                                .Width(200)
                                .OnContentReady("OnAmountContentReady")
                                .Placeholder("請輸入奉獻金額")
                            );

                        // 付款方式
                        items.AddSimpleFor(m => m.PayWay)
                            .Label(l => l.Text("付款方式"))
                            .Name("PayWaySelectBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(new string[] { "信用卡","ATM轉帳/匯款", "信用卡定期定額(每個月)","LinePay" })
                                .OnValueChanged("OnPayWaySelectBoxValueChanged")
                            );

                        // 定期定額總期數
                        items.AddSimpleFor(m => m.DeductTotalNumber)
                            .Label(l => l.Text("總期數"))
                            .Visible(false)
                            .Name("DeductTotalNumberSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(new string[] {
                                    "3個月", "6個月", "12個月", "18個月", "24個月"
                                })
                                .Value("12個月")
                            );

                        // 選取的信用卡（隱藏欄位）
                        items.AddSimpleFor(m => m.SelectedCreditCard)
                            .Label(l => l.Text("選取的信用卡").Visible(false))
                            .Editor(e => e
                                .TextBox()
                                .Width(120)
                                .Visible(false)
                                .Placeholder("選取的信用卡")
                            );

                        // 附註
                        items.AddSimpleFor(m => m.Explain)
                            .Label(l => l.Text("備註說明"))
                            .Editor(e => e
                                .TextArea()
                                .Width(200)
                                .Height(60)
                                .Placeholder("您可以在此輸入特別說明或留言")
                            );
                    })
                )
            </div>

            <!-- ==================== 信用卡列表 ==================== -->
            <div id="creditcardlistcontainer" class="card-list">
                <h5>
                    <i class="mbri-credit-card" style="margin-right: 10px;"></i>
                    我的信用卡
                </h5>
                <p style="color: #666; margin-bottom: 20px; font-size: 0.95rem;">
                    <i class="mbri-info" style="margin-right: 5px;"></i>
                    您可以刪除不想使用的信用卡，並選擇本次要使用的信用卡進行奉獻
                </p>
                
                @(Html.DevExtreme().DataGrid<CreditCard>()
                    .ID("CreditCardGrid")
                    .Width("auto")
                    .ShowBorders(true)
                    .ColumnWidth(20)
                    .Paging(paging => paging.Enabled(false))
                    .AllowColumnResizing(true)
                    .ColumnResizingMode(ColumnResizingMode.Widget)
                    .ColumnFixing(c => c.Enabled(true))
                    .LoadPanel(l => l.Text("Loading...").Enabled(false))
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .ShowBorders(true)
                    .Selection(selection => selection.Mode(SelectionMode.Single))
                    .OnRowClick("OnRowClick")
                    .OnSelectionChanged("OnRowSelectionChanged")
                    .OnInitialized("DataGridOnInitialized")
                    .OnContentReady("onCreditCardGridContentReady")
                    .HoverStateEnabled(true)
                    .Editing(editing => {
                        editing.AllowDeleting(true);
                        editing.Texts(a => a
                            .DeleteRow("Delete")
                            .ConfirmDeleteMessage("Are you sure to delete this card?")
                        );
                    })
                    .Columns(columns => {
                        columns.AddFor(m => m.CreditCardNumber)
                            .Caption("信用卡號")
                            .Width(150)
                            .MinWidth(80)
                            .Alignment(HorizontalAlignment.Center)
                            .Fixed(true);
                        columns.AddFor(m => m.ExpireDate)
                            .Caption("到期日")
                            .Width(80)
                            .MinWidth(50)
                            .Alignment(HorizontalAlignment.Center);
                    })
                    .DataSource(d => d
                        .WebApi()
                        .Controller("Dedication")
                        .LoadAction("LoadCreditCardList")
                        .DeleteAction("DeleteCreditCard")
                        .Key("CCToken")
                    )
                    .SelectedRowKeys(new int[] { 1 })
                )
            </div>

            <!-- ==================== 按鈕區域 ==================== -->
            <div class="button-area dx-field">
                <div id="buttonContainer" style="display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: flex-start; gap:10px;">
                    @(Html.DevExtreme().Button()
                        .Text("確認奉獻")
                        .Icon("check")
                        .Type(ButtonType.Success)
                        .ID("save-button2")
                        .Width(180)
                        .UseSubmitBehavior(true)
                        .OnClick("ShowLoadPanel")
                    )
                    @(Html.DevExtreme().Button()
                        .Text("使用其他信用卡")
                        .Icon("fa-solid fa-shield-halved")
                        .Type(ButtonType.Default)
                        .ID("save-button3")
                        .Width(240)
                        .UseSubmitBehavior(true)
                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("UseOtherCreditCard")
                    )
                </div>
            </div>
            
            <!-- ==================== ATM資訊區域 ==================== -->
            <div id="atm-info" class="atm-info" style="display: none;">
                <h5 id="atmfield"></h5>
            </div>

                        <!-- ==================== 定期定額清單 ==================== -->
            <div id="dedicationbookinglistcontainer" class="booking-list">
                <h5>
                    <i class="mbri-timer" style="margin-right: 10px;"></i>
                    定期定額奉獻清單
                </h5>
                <p style="color: #666; margin-bottom: 20px; font-size: 0.95rem;">
                    <i class="mbri-info" style="margin-right: 5px;"></i>
                    您可以在此查看和管理您的定期定額奉獻項目
                </p>
                
                @(Html.DevExtreme().DataGrid<DedicationBooking>()
                    .ID("DedicationBookingGrid")
                    .Width("auto")
                    .ColumnWidth(5)
                    .LoadPanel(l => l.Text("Loading...").Enabled(false))
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .ShowBorders(true)
                    .Selection(selection => selection.Mode(SelectionMode.Single))
                    .OnSelectionChanged("OnRowSelectionChanged")
                    .OnContentReady("onDedicationBookingGridContentReady")
                    .Editing(editing => {
                        editing.Mode(GridEditMode.Cell);
                        editing.RefreshMode(GridEditRefreshMode.Reshape);
                        editing.AllowDeleting(true);
                        editing.Texts(a => a
                            .DeleteRow("Cancel")
                            .ConfirmDeleteMessage("Are you sure to cancel this subscription?")
                            .ConfirmDeleteTitle("Cancel Subscription")
                        );
                    })
                    .Columns(columns => {
                        columns.AddFor(m => m.DedicationCategory).Caption("奉獻類別").Width(70).MinWidth(75).Alignment(HorizontalAlignment.Center).Fixed(true);
                        columns.AddFor(m => m.DedicationBookingStatus).Caption("狀態").Width(70).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.AmountPerStage).Caption("每期金額").Width(75).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.TotalStages).Caption("總期數").Width(70).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.DedicationAmount).Caption("應付總金額").Width(85).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.PaidPeriod).Caption("目前期數").Width(75).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.RollupPaidFee).Caption("已付金額").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.StartDate).Caption("開始日期").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.EndDate).Caption("結束日期").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    })
                    .DataSource(d => d
                        .WebApi()
                        .Controller("Dedication")
                        .LoadAction("LoadDedicationBookingList")
                        .DeleteAction("DeleteDedicationBooking")
                        .Key("EntityId")
                    )
                    .SelectedRowKeys(new int[] { 1 })
                )
            </div>

            <!-- ==================== 教會資訊與奉獻說明 ==================== -->
            <section class="church-info" id="church-info">
                <div class="container">
                    <div class="info-grid">
                        <!-- 聯絡資訊卡 -->
                        <div class="info-card contact-card">
                            <h5><i class="fas fa-church" aria-hidden="true"></i> 教會聯絡資訊</h5>
                            <ul class="contact-list">
                                <li><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span>地址：231 新北市新店區安興路91 巷5 號4 樓</span></li>
                                <li><i class="fas fa-phone" aria-hidden="true"></i><span>電話：02-2211-1556</span></li>
                                <li><i class="fas fa-envelope" aria-hidden="true"></i><span>信箱：sunnyvale.church@gmail.com</span></li>
                                <li><i class="fas fa-id-card" aria-hidden="true"></i><span>統編：20004335</span></li>
                                <li><i class="fas fa-info-circle" aria-hidden="true"></i><span>若有任何奉獻問題，請洽詢曾淑芬姊妹</span></li>
                            </ul>
                        </div>

                        <!-- 奉獻說明卡（原生手風琴） -->
                        <div class="info-card">
                            <h5><i class="fas fa-hand-holding-heart" aria-hidden="true"></i> 奉獻說明</h5>
                            <div class="accordion-clean">
                                <details>
                                    <summary>
                                        <span><i class="fas fa-seedling"></i> 十一奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            十一奉獻是基督徒應盡的責任和義務。
                                            所以上帝挑戰我們，當我們願意將十分之一奉獻給上帝時，
                                            上帝將會傾倒更大的祝福在我們的身上。

                                            萬軍之耶和華說：你們要將當納的十分之一全然送入倉庫，使我家有糧，
                                            以此試試我，是否為你們敞開天上的窗戶，傾福與你們，甚至無處可容。
                                            ─ 瑪拉基書3:10
                                        </p>
                                    </div>
                                </details>

                                <details>
                                    <summary>
                                        <span><i class="fas fa-building"></i> 建堂奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            因著神的憐憫，「聖谷行道會」從恩典到奇蹟的這段旅程，讓我們著實看見神奇妙又信實的作為。
                                            為了滿足場地以及相關軟硬體等財務需求，邀請聖谷行道會的弟兄姊妹們，透過「建堂奉獻」一起支持、建造神國的家。
                                        </p>
                                    </div>
                                </details>

                                <details>
                                    <summary>
                                        <span><i class="fas fa-heart"></i> 感恩奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            上帝的祝福讓我們學習凡事謝恩，而獻上財物則是我們感謝上帝的一種方式。
                                            我們鼓勵每個人都應該照自己心裡所願來奉獻，不猶豫、不勉強，因為上帝喜愛樂意奉獻的人。
                                        </p>
                                    </div>
                                </details>

                                <details>
                                    <summary>
                                        <span><i class="fas fa-globe-asia"></i> 宣教奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            「使萬民成為主的門徒」是上帝的心意，也是託付給教會的大使命。
                                            根據統計，目前全球仍有31億、約41%的未得之民（缺乏基督教會、宣教士、聖經等信仰資源，而從未接觸福音者），宣教的需要永遠都是刻不容緩！
                                            也許不是每個人都會被上帝呼召成為「宣教士」，但每個人都可以透過奉獻來做「宣教事」。
                                        </p>
                                    </div>
                                </details>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>

        <!-- ==================== 通知元件 ==================== -->
        <div class="notification-area dx-field">
            <div id="ToastContainer">
                @(Html.DevExtreme().Toast()
                    .ID("toast")
                    .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                    .Message("Upload success")
                    .DisplayTime(20000)
                    .MaxWidth(200)
                )
            </div>
            
            <div id="LoadPanel">
                @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("Processing...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                )
            </div>
        </div>

        
    </div>
</div>

<!-- ==================== 外部腳本 ==================== -->
<script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
<script src="~/js/devextreme/devextreme-intl.min.js"></script>
<script src="~/js/devextreme/localization/dx.messages.zh-tw.js"></script>
<!-- 移除會與全域 Bootstrap 衝突的外部 JS：Popper/Tether/Bootstrap/Mobirise -->

<!-- ==================== QPayView 自定義腳本 ==================== -->
<script>
    // ==================== 工具函數 ====================
    // 獲取 LoadPanel 實例
    function getLoadPanelInstance() { 
        return $("#loadPanel").dxLoadPanel("instance"); 
    }
    
    // 獲取 Form 實例
    function getFormInstance() { 
        return $("#form").dxForm("instance"); 
    }
    
    // 獲取 Toast 實例
    function getToastInstance() { 
        return $("#toast").dxToast("instance"); 
    }
    
    // 顯示 LoadPanel
    function ShowLoadPanel() { 
        getLoadPanelInstance().show(); 
    }
    
    // 使用其他信用卡
    function UseOtherCreditCard() { 
        ShowLoadPanel(); 
        getFormInstance().updateData('SelectedCreditCard', ""); 
    }
    
    // 顯示 Toast 通知
    function ShowToast(message, type, displayTime) {
        var toast = getToastInstance();
        toast.option({ message: message, type: type, displayTime: displayTime, 'white-space': 'pre-line', closeOnClick: true });
        toast.show();
    }

    // ==================== 表單欄位處理 ====================
    // 隱藏所有奉獻欄位
    function hideAllDedicationFields() {
        var form = getFormInstance();
        form.itemOption("OtherDedicationSelectionBox", 'visible', false);
        form.itemOption("HolidayDedicationSelectionBox", 'visible', false);
        form.itemOption("SpecialDedicationSelectionBox", 'visible', false);
        form.itemOption("OtherDedication", 'visible', false);
    }

    // 奉獻類別選擇變更事件
    function OnCategorySelectBoxValueChanged(e) {
        hideAllDedicationFields();
        var form = getFormInstance();
        if (e.value == "節期獻金") {
            form.itemOption("HolidayDedicationSelectionBox", 'visible', true);
        } else if (e.value == "特別獻金") {
            form.itemOption("SpecialDedicationSelectionBox", 'visible', true);
        }
        form.itemOption('DedicationAmount', { editorOptions: { width: 200 } });
    }

    // 奉獻金額內容準備事件
    function OnAmountContentReady(e) {
        if (e.component.option("value") == 0) {
            e.component.option("value", "");
        }
    }

    // ==================== 付款方式處理 ====================
    // 重置付款 UI
    function resetPaymentUI() {
        var form = getFormInstance();
        document.getElementById('atmfield').innerHTML = "";
        document.getElementById('atm-info').style.display = 'none';  // 隱藏 ATM 資訊
        form.itemOption('DedicationAmount', { editorOptions: { width: 200 } });
        form.itemOption("DedicationAmount", "label", { text: "奉獻金額" });
        form.itemOption("DedicationAmount", "editorOptions", { placeholder: "請輸入奉獻金額" });
        form.itemOption("DeductTotalNumberSelectionBox", 'visible', false);
    }
    
    // 處理信用卡付款
    function handleCreditCardPayment() {
        var creditcards = $("#CreditCardGrid").dxDataGrid("instance").getDataSource().items();
        var creditCardContainer = document.getElementById("creditcardlistcontainer");
        var bookingContainer = document.getElementById("dedicationbookinglistcontainer");
        
        if (creditcards.length > 0) {
            creditCardContainer.style.display = "";
            $("#CreditCardGrid").dxDataGrid("instance").selectRows('@(Model.SelectedCreditCard)', true);
            $("#save-button3").dxButton("instance").option("visible", true);
            $("#save-button2").dxButton("instance").option("text", "確認奉獻");
        } else {
            creditCardContainer.style.display = "none";
            $("#save-button3").dxButton("instance").option("visible", false);
            $("#save-button2").dxButton("instance").option("text", "確認奉獻");
        }
        bookingContainer.style.display = "none";
    }
    
    // 處理信用卡定期定額
    function handleCreditCardSubscription() {
        handleCreditCardPayment();
        var form = getFormInstance();
        var bookings = $("#DedicationBookingGrid").dxDataGrid("instance").getDataSource().items();
        if (bookings.length > 0) {
            document.getElementById("dedicationbookinglistcontainer").style.display = "";
        }
        form.itemOption("DeductTotalNumberSelectionBox", 'visible', true);
        form.itemOption("DedicationAmount", "label", { text: "每月金額" });
        form.itemOption("DedicationAmount", "editorOptions", { placeholder: "請輸入每月的奉獻金額" });
    }
    
    // 處理其他付款方式
    function handleOtherPayment() {
        document.getElementById("creditcardlistcontainer").style.display = "none";
        document.getElementById("dedicationbookinglistcontainer").style.display = "none";
        $("#save-button3").dxButton("instance").option("visible", false);
        $("#save-button2").dxButton("instance").option("text", "確認奉獻");
    }

    // 付款方式選擇變更事件
    function OnPayWaySelectBoxValueChanged(e) {
        resetPaymentUI();
        switch(e.value) {
            case "信用卡": 
                handleCreditCardPayment(); 
                break;
            case "信用卡定期定額(每個月)": 
                handleCreditCardSubscription(); 
                break;
            default: 
                handleOtherPayment(); 
                break;
        }
    }

    // ==================== 資料網格事件處理 ====================
    // 資料網格初始化事件
    function DataGridOnInitialized(e) { 
        e.component.columnOption("command:edit", "width", 50); 
    }
    
    // 行點擊事件
    function OnRowClick(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) { 
            getFormInstance().updateData('SelectedCreditCard', data.CCToken); 
        }
    }
    
    // 行選擇變更事件
    function OnRowSelectionChanged(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) { 
            getFormInstance().updateData('SelectedCreditCard', data.CCToken); 
        }
    }

    // 信用卡網格內容準備事件
    function onCreditCardGridContentReady(e) {
        var items = e.component.getDataSource().items();
        var creditCardContainer = document.getElementById("creditcardlistcontainer");
        var bookingContainer = document.getElementById("dedicationbookinglistcontainer");
        
        if (items.length > 0) {
            creditCardContainer.style.display = "";
            bookingContainer.style.display = "none";
            e.component.selectRows('@(Model.SelectedCreditCard)', true);
        } else {
            creditCardContainer.style.display = "none";
            bookingContainer.style.display = "none";
            $("#save-button3").dxButton("instance").option("visible", false);
            $("#save-button2").dxButton("instance").option("text", "確認奉獻");
        }
    }

    // 奉獻預訂網格內容準備事件
    function onDedicationBookingGridContentReady(e) {
        e.component.columnOption("command:edit", { visibleIndex: -1, width: 50 });
    }

    // ==================== AJAX 回調處理 ====================
    // AJAX 開始事件
    function onBegin() {}
    
    // AJAX 成功事件
    function onSuccess(data) {
        getLoadPanelInstance().hide();
        if (data.status == 1) {
            if (data.PayWay == "信用卡") {
                ShowToast(data.message, "success", 2000);
                window.location.href = data.DedicationResult;
            } else {
                ShowToast(data.message, "success", 2000);
                document.getElementById('atmfield').innerHTML = data.DedicationResult;
                document.getElementById('atm-info').style.display = 'block';  // 顯示 ATM 資訊
            }
        } else {
            ShowToast(data.message, "error", 3000);
            document.getElementById('atmfield').innerHTML = data.message;
            document.getElementById('atm-info').style.display = 'block';  // 顯示錯誤訊息
        }
    }

    // ==================== DevExtreme 本地化設定 ====================
    // 初始化本地化
    (function initializeLocalization() {
        var dictionary = {
            "zh-tw": {
                "dxScheduler-switcherAgenda": "會議內容",
                "Month": "月",
                "Subject": "主題",
                "Company": "Company",
                "Amount": "Amount",
                "PaymentDate": "Payment Date",
                "dxDataGrid-editingConfirmDeleteMessage": "您確定要刪除這張信用卡嗎?",
            }
        };
        DevExpress.localization.loadMessages(dictionary);
        var locale = "zh-tw";
        sessionStorage.setItem("locale", locale);
        DevExpress.localization.locale(locale);
    })();
</script>

