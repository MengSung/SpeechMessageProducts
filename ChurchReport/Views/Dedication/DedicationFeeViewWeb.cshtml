@using ChurchReport.Models
@model QpayModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<style>
    .dedication-page {
        --theme-primary: #0f766e;
        --theme-primary-soft: #ecfdf5;
        --theme-border: #d9e6f2;
        --theme-text: #0f172a;
        --theme-muted: #64748b;
        --theme-surface: #ffffff;
        --theme-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
        color: var(--theme-text);
        padding: 12px 10px 20px;
    }

    .dedication-card {
        background: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 16px;
        box-shadow: var(--theme-shadow);
        padding: 14px 16px;
        margin-bottom: 12px;
    }

    .dedication-header-card {
        background: linear-gradient(145deg, #f0fdfa 0%, #f8fafc 58%, #ecfeff 100%);
    }

    .dedication-title {
        margin: 0;
        color: var(--theme-primary);
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.5;
        letter-spacing: 0.02em;
    }

    .dedication-subtitle {
        margin: 4px 0 0;
        color: #0f766e;
        font-size: 1rem;
        font-weight: 600;
    }

    .dedication-hint {
        margin-top: 8px;
        color: var(--theme-muted);
        font-size: 0.9rem;
    }

    .dedication-filter-card .dx-field-item-label-text,
    .dedication-grid-card .dx-datagrid-text-content {
        font-weight: 600;
    }

    .dedication-action-bar {
        display: flex;
        justify-content: flex-start;
        margin: 6px 0 12px;
    }

    #buttonContainer3 .dx-button {
        min-width: 140px;
        border-radius: 999px;
        box-shadow: 0 8px 18px rgba(15, 118, 110, 0.3);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    #buttonContainer3 .dx-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(15, 118, 110, 0.35);
    }

    .section-title {
        margin-bottom: 10px;
        color: var(--theme-primary);
        font-size: 1rem;
        font-weight: 700;
    }

    #DedicationFeeGrid .dx-datagrid-headers {
        border-radius: 10px;
        overflow: hidden;
    }

    #DedicationFeeGrid .dx-datagrid-headers .dx-header-row td {
        background: #e6f6f4;
        color: #0f172a;
        font-size: .92rem;
        font-weight: 700;
        padding-top: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #b7ddd9;
    }

    #DedicationFeeGrid .dx-datagrid-rowsview .dx-row>td {
        padding-top: 11px;
        padding-bottom: 11px;
        vertical-align: middle;
    }

    #DedicationFeeGrid .dx-datagrid-rowsview .dx-data-row.dx-row-alt {
        background-color: #f8fafc;
    }

    #DedicationFeeGrid .dx-datagrid-rowsview .dx-data-row:hover>td {
        background-color: #e6f6f4;
    }

    #DedicationFeeGrid .dx-selection>td,
    #DedicationFeeGrid .dx-row-focused>td {
        background-color: #d1fae5 !important;
        color: #0f172a;
    }

    .dedication-total-card {
        margin: 4px 0 2px;
        color: #b91c1c;
        font-size: 1.6rem;
        font-weight: 700;
        text-align: left;
        padding: 10px 4px 2px;
    }

    .dedication-total-card h4 {
        margin: 0;
        font-size: 1.6rem;
    }

    .dedication-page .dx-texteditor.dx-state-focused,
    .dedication-page .dx-texteditor.dx-state-hover {
        box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.15);
        border-radius: 8px;
    }

    #ToastContainer .dx-toast-message {
        border-radius: 10px;
        font-size: .92rem;
    }

    @@media (max-width: 430px) {
        .dedication-page {
            padding: 8px 4px 14px;
        }

        .dedication-card {
            border-radius: 12px;
            padding: 10px;
        }

        .dedication-title {
            font-size: 1.02rem;
        }

        .dedication-subtitle,
        .dedication-total-card h4 {
            font-size: .94rem;
        }

        .dedication-action-bar {
            position: sticky;
            bottom: 8px;
            z-index: 5;
            justify-content: center;
            margin-bottom: 10px;
        }

        #buttonContainer3 {
            width: 100%;
        }

        #buttonContainer3 .dx-button {
            width: 100%;
            min-height: 48px;
        }

        #buttonContainer3 .dx-button .dx-button-text {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 2px;
        }

        #DedicationFeeGrid .dx-datagrid-headers .dx-header-row td,
        #DedicationFeeGrid .dx-datagrid-rowsview .dx-row>td {
            padding-top: 9px;
            padding-bottom: 9px;
            font-size: .86rem;
        }

        /* 手機版表單：標籤置於輸入框上方（JS 切換 labelLocation: top），輸入框滿版 16px */
        .dedication-page .dx-field-item-label {
            font-size: 15px;
            font-weight: 600;
        }

        .dedication-page .dx-field-item-label-location-top {
            padding-bottom: 2px;
        }

        .dedication-page .dx-texteditor {
            width: 100% !important;
        }

        .dedication-page .dx-texteditor-input {
            font-size: 16px;
            padding: 11px 10px;
        }

        .dedication-page .dx-placeholder {
            font-size: 16px;
            display: flex;
            align-items: center;
        }

        .dedication-page .dx-placeholder::before {
            padding-top: 0;
            padding-bottom: 0;
        }
    }
</style>

<div class="dedication-page">
<div class="dedication-card dedication-header-card">
    <h4 class="dedication-title">@Model.FullName 奉獻編號：@Model.DedicationNumber</h4>
    <h4 class="dedication-subtitle">@Model.Ntbt</h4>
    <div class="dedication-hint">請先選擇日期區間，再按「查詢」更新奉獻紀錄。</div>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="UpdateDedicationFeeView" asp-controller="Dedication" method="post" class="dedication-form">
    <div class="dx-field">
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Visible(false)
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

        </div>
    </div>
    <div id="form-container" class="dedication-card dedication-filter-card">
        @(Html.DevExtreme().Form<QpayModel>()
        .ID("form")
        .ColCount(1)
        .Items
        (items =>
        {
            items.AddSimpleFor
                (m => m.QueryStartDate)
                .Label(l => l.Text("開始日期"))
                .IsRequired(false)
                .Editor(e => e
                    .DateBox()
                    .Width(200)
                    .DisplayFormat("yyyy/M/d")
                    .Disabled(false)
                    .Placeholder("開始日期")
                    .PickerType(DateBoxPickerType.Calendar)
                );
            items.AddSimpleFor
                (m => m.QueryEndDate)
                .Label(l => l.Text("結束日期"))
                .IsRequired(false)
                .Editor(e => e
                    .DateBox()
                    .Width(200)
                    .DisplayFormat("yyyy/M/d")
                    .Disabled(false)
                    .Placeholder("結束日期")
                    .PickerType(DateBoxPickerType.Calendar)
                );

        }
        )
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )

    </div>
    <div class="dedication-action-bar">
        <div id="buttonContainer3" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                        .Text("查詢")
                        .Visible(true)
                        .Type(ButtonType.Success)
                        .ID("save-button3")
                        .UseSubmitBehavior(true)
                        .OnClick("ShowLoadPanel")
                )
        </div>
    </div>

    <div class="dedication-card dedication-grid-card">
        <div class="section-title">奉獻紀錄</div>
        <div id="data-grid">
            @(Html.DevExtreme().DataGrid<DedicationFee>()
            .ID("DedicationFeeGrid")
            .ShowBorders(true)
            //.ColumnAutoWidth(true)
            //.Paging(p => p.PageSize(10))
            .Paging(paging => paging.Enabled(false))
            .AllowColumnResizing(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnFixing(c => c.Enabled(true))
            .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
            .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
            .Export(e => e.Enabled(true).AllowExportSelectedData(true))
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ShowBorders(true)
            .RemoteOperations(ro => ro.Filtering(false)    // 客戶端過濾
                .Sorting(false)   // 客戶端排序
                .Paging(false)    // 客戶端分頁
                .Grouping(false)  // 客戶端分組
                .Summary(false)   // 客戶端匯總
                // CRUD 操作默認為 true，會發送到服務器 ✅ ) 取代
            )

            .TwoWayBindingEnabled(true)
            .Editing(editing =>
            {
                //editing.Mode(GridEditMode.Batch);
                //editing.Mode(GridEditMode.Row);
                editing.Mode(GridEditMode.Cell);
                //editing.Mode(GridEditMode.Batch);
                //editing.Mode(GridEditMode.Form);
                //editing.Mode(GridEditMode.Popup);
                editing.AllowUpdating(true);
                //editing.AllowAdding(true);
                //editing.AllowDeleting(true);
                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除"));
            })

            .Columns(columns =>
            {
                columns.AddFor(m => m.Category).Caption("奉獻類別").Width(50).MinWidth(80).AllowEditing(false).AllowSorting(true);
                columns.AddFor(m => m.DedicationDate).Caption("奉獻日期").Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("yyyy/M/d").Width(100).MinWidth(45).AllowEditing(false).AllowSorting(true).Visible(false)
                            .CalculateCellValue(@<text>
                                        function(row)
                                        {
                                            if( row.DedicationDate != null )
                                            {
                                                var ParsedDate = ParsingDate( row.DedicationDate );
                                                if( ParsedDate.getFullYear() == 1901 )
                                                {
                                                    return null;
                                                }
                                                else
                                                {
                                                    return ParsedDate;
                                                }
                                            }
                                            else
                                            {return null;}
                                        }
                             </text> );
                columns.AddFor(m => m.PayDate).Caption("付款日期").Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("yyyy/M/d").Width(100).MinWidth(45).AllowEditing(false).AllowSorting(true)
                                .CalculateCellValue(@<text>
                                        function(row)
                                        {
                                            if( row.PayDate != null )
                                            {
                                                var ParsedDate = ParsingDate( row.PayDate );
                                                if( ParsedDate.getFullYear() == 1901 )
                                                {
                                                    return null;
                                                }
                                                else
                                                {
                                                    return ParsedDate;
                                                }
                                            }
                                            else
                                            {return null;}
                                        }
                             </text> );

                columns.AddFor(m => m.PayWay).Caption("付款方式").Alignment(HorizontalAlignment.Center).Width(80).MinWidth(80).AllowEditing(false).AllowSorting(true);
                columns.AddFor(m => m.Amount).Caption("金額").Width(80).MinWidth(80).AllowEditing(false).AllowSorting(true);
                columns.AddFor(m => m.PaidPeriod).Caption("定期定額期數").Alignment(HorizontalAlignment.Center).Width(100).MinWidth(80).AllowEditing(false).AllowSorting(true);
                columns.AddFor(m => m.Others).Caption("奉獻細項").Alignment(HorizontalAlignment.Left).Width(180).MinWidth(180).AllowEditing(false).AllowSorting(true);
            })
            .DataSource
            (Model.DedicationFeeList)

            )
        </div>
    </div>

    <div class="dedication-total-card">
        <h4>總金額 = @Model.TotalAmount 元</h4>
    </div>

    <div id="buttonContainer2" class="dx-button-icon">
        @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Visible(false)
                    .Type(ButtonType.Success)
                    .ID("save-button2")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
    </div>

</form>
</div>

<script>
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }
    function ShowLoadPanel(arg) {

        //debugger;
        getLoadPanelInstance().show();
        //$("#toast").dxToast("instance").show();
        //alert("SaveNewPerson!!!");
        //alert("OnValueChanged : " + arg.value);

        //alert("OnValueChanged : " + arg.attribute('text'));
        //alert("OnValueChanged : " + text: arg.attribute("text"));

        //alert( getODataLocalDateFilter(arg.value) );
    }
    function ShowToast(LocalToastMessage, Type, DisplayTime) {
        //debugger;
        var ToastInstance = $("#toast").dxToast("instance");
        ToastInstance.option('message', LocalToastMessage);
        ToastInstance.option('type', Type);
        ToastInstance.option('displayTime', DisplayTime);
        ToastInstance.option('white-space', 'pre-line');
        ToastInstance.option('closeOnClick', true);
        ToastInstance.show();
    }

    var GlobalCategory = "";

    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", {
            visibleIndex: -1,
            width: 50
        });
    }
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing,
                $links = e.cellElement.find(".dx-link");

            $links.text("");

            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            }
            else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }

    }
    function ParsingDate(input) {

        var ParsedDate = new Date(input);
        return ParsedDate;
    }

</script>

<script type="text/javascript">
    function onBegin() {
    }

    function onSuccess(data) {

        getLoadPanelInstance().hide();

        if (data.status == 1) {
            window.location.href = "/Home/DedicationFeeViewWeb/";
            //ShowToast(data.message, "success", 2000);
        }
        else {
            ShowToast(data.message, "error", 3000);
        }
    }

    function onComplete(data) {
        if (data.status == 1) {
        }
        else {
        }
    }
</script>

<script>
    // 手機窄螢幕：表單標籤改置於輸入框上方，避免左右欄位互相擠壓變形
    $(function () {
        if (window.matchMedia && window.matchMedia('(max-width: 430px)').matches) {
            var inst = $('#form').length ? $('#form').dxForm('instance') : null;
            if (inst) { inst.option('labelLocation', 'top'); }
        }
    });
</script>

<link href="~/css/Scheduler.css" rel="stylesheet" />
<link href="~/css/Site.css" rel="stylesheet" />

<script src="~/lib/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.js"></script>
<link href="~/css/Gallery.css" rel="stylesheet" />
<link href="~/css/WeeklyReport.css" rel="stylesheet" />

<script src="~/js/devextreme/devextreme-intl.min.js"></script>
<script src="~/js/devextreme/localization/dx.messages.zh-tw.js"></script>
