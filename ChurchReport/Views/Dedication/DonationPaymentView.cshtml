<!-- 移除會與全域 Bootstrap 衝突的外部 JS：Popper/Tether/Bootstrap/Mobirise -->

<!-- ==================== DonationPaymentView 自定義腳本 ==================== -->
<script>
    // ==================== 工具函數 ====================
    // 獲取 LoadPanel 實例
    function getLoadPanelInstance() { 
        return $("#loadPanel").dxLoadPanel("instance"); 
    }
    
    // 獲取 Form 實例
    function getFormInstance() { 
        return $("#form").dxForm("instance"); 
    }
    
    // 獲取 Toast 實例
    function getToastInstance() { 
        return $("#toast").dxToast("instance"); 
    }
    
    // 顯示 LoadPanel
    function ShowLoadPanel() { 
        getLoadPanelInstance().show(); 
    }
    
    // 使用其他信用卡
    function UseOtherCreditCard() { 
        ShowLoadPanel(); 
        getFormInstance().updateData('SelectedCreditCard', ""); 
    }
    
    // 顯示 Toast 通知
    function ShowToast(message, type, displayTime) {
        var toast = getToastInstance();
        toast.option({ message: message, type: type, displayTime: displayTime, 'white-space': 'pre-line', closeOnClick: true });
        toast.show();
    }

    // ==================== 表單欄位處理 ====================
    // 隱藏所有奉獻欄位
    function hideAllDedicationFields() {
        var form = getFormInstance();
        form.itemOption("OtherDedicationSelectionBox", 'visible', false);
        form.itemOption("HolidayDedicationSelectionBox", 'visible', false);
        form.itemOption("SpecialDedicationSelectionBox", 'visible', false);
        form.itemOption("OtherDedication", 'visible', false);
    }

    // 奉獻類別選擇變更事件
    function OnCategorySelectBoxValueChanged(e) {
        hideAllDedicationFields();
        var form = getFormInstance();
        if (e.value == "節期獻金") {
            form.itemOption("HolidayDedicationSelectionBox", 'visible', true);
        } else if (e.value == "特別奉獻") {
            form.itemOption("SpecialDedicationSelectionBox", 'visible', true);
        }
        form.itemOption('DedicationAmount', { editorOptions: { width: 200 } });
    }

    // 奉獻金額內容準備事件
    function OnAmountContentReady(e) {
        if (e.component.option("value") == 0) {
            e.component.option("value", "");
        }
    }

    // ==================== 付款方式處理 ====================
    // 重置付款 UI
    function resetPaymentUI() {
        var form = getFormInstance();
        document.getElementById('atmfield').innerHTML = "";
        document.getElementById('atm-info').style.display = 'none';  // 隱藏 ATM 資訊
        setAtmCopyButtonVisible(false);
        form.itemOption('DedicationAmount', { editorOptions: { width: 200 } });
        form.itemOption("DedicationAmount", "label", { text: "奉獻金額" });
        form.itemOption("DedicationAmount", "editorOptions", { placeholder: "請輸入奉獻金額" });
        form.itemOption("DeductTotalNumberSelectionBox", 'visible', false);
    }
    
    // 更新 save-button2 文字，根據是否有信用卡決定顯示內容
    function updateSaveButtonTextForCardAvailability() {
        try {
            var grid = $("#CreditCardGrid").dxDataGrid("instance");
            var hasCards = false;
            if (grid && grid.getDataSource) {
                var items = grid.getDataSource().items();
                hasCards = items && items.length > 0;
            }
            if (hasCards) {
                try { $("#save-button2").dxButton("instance").option("text", "透過選擇的信用卡奉獻"); } catch(e) {}
            } else {
                try { $("#save-button2").dxButton("instance").option("text", "奉獻"); } catch(e) {}
            }
        } catch (ex) {
            // fallback
            try { $("#save-button2").dxButton("instance").option("text", "奉獻"); } catch(e) {}
        }
    }

    // 處理信用卡付款
    function handleCreditCardPayment() {
        var creditcards = $("#CreditCardGrid").dxDataGrid("instance").getDataSource().items();
        var creditCardContainer = document.getElementById("creditcardlistcontainer");
        var bookingContainer = document.getElementById("dedicationbookinglistcontainer");
        
        if (creditcards.length > 0) {
            creditCardContainer.style.display = "";
            $("#CreditCardGrid").dxDataGrid("instance").selectRows('@(Model.SelectedCreditCard)', true);
            $("#save-button3").dxButton("instance").option("visible", true);
        } else {
            creditCardContainer.style.display = "none";
            $("#save-button3").dxButton("instance").option("visible", false);
        }
        // 更新按鈕文字（有信用卡則顯示透過選擇的信用卡奉獻，否則顯示奉獻）
        updateSaveButtonTextForCardAvailability();
        bookingContainer.style.display = "none";
    }
    
    // 處理信用卡定期定額
    function handleCreditCardSubscription() {
        // 對於定期定額，按鈕文字與信用卡相同規則
        handleCreditCardPayment();
        var form = getFormInstance();
        var bookings = $("#DedicationBookingGrid").dxDataGrid("instance").getDataSource().items();
        if (bookings.length > 0) {
            document.getElementById("dedicationbookinglistcontainer").style.display = "";
        }
        form.itemOption("DeductTotalNumberSelectionBox", 'visible', true);
        form.itemOption("DedicationAmount", "label", { text: "每月金額" });
        form.itemOption("DedicationAmount", "editorOptions", { placeholder: "請輸入每月的奉獻金額" });
    }
    
    // 處理其他付款方式
    function handleOtherPayment() {
        document.getElementById("creditcardlistcontainer").style.display = "none";
        document.getElementById("dedicationbookinglistcontainer").style.display = "none";
        $("#save-button3").dxButton("instance").option("visible", false);
        // 非信用卡付款一律顯示「奉獻」
        try { $("#save-button2").dxButton("instance").option("text", "奉獻"); } catch(e) {}
    }

    // 付款方式選擇變更事件
    function OnPayWaySelectBoxValueChanged(e) {
        resetPaymentUI();
        switch(e.value) {
            case "信用卡": 
                handleCreditCardPayment(); 
                break;
            case "信用卡定期定額(每個月)": 
                handleCreditCardSubscription(); 
                break;
            default: 
                handleOtherPayment(); 
                break;
        }
    }

    // 頁面載入時，根據表單目前的付款方式初始化按鈕文字
    $(function(){
        try {
            var form = getFormInstance();
            if (form) {
                var formData = form.option('formData') || {};
                var payWayVal = formData.PayWay;
                // 如果 editor 已初始化，使用 editor 值以保證一致
                try {
                    var editor = form.getEditor('PayWay');
                    if (editor) payWayVal = editor.option('value');
                } catch(ex) {}

                OnPayWaySelectBoxValueChanged({ value: payWayVal });
            }
        } catch(err) {}
    });
    
    // ==================== 資料網格事件處理 ====================
    // 資料網格初始化事件
    function DataGridOnInitialized(e) { 
        e.component.columnOption("command:edit", {
            width: 80,
            minWidth: 70,
            caption: "操作",
            alignment: "center"
        }); 
    }
    
    // 行點擊事件
    function OnRowClick(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) { 
            getFormInstance().updateData('SelectedCreditCard', data.CCToken); 
        }
    }
    
    // 行選擇變更事件
    function OnRowSelectionChanged(selectedItems) {
        var data = selectedItems.selectedRowsData[0];
        if (data) { 
            getFormInstance().updateData('SelectedCreditCard', data.CCToken); 
        }
    }

    // 信用卡網格內容準備事件
    function onCreditCardGridContentReady(e) {
        var items = e.component.getDataSource().items();
        var creditCardContainer = document.getElementById("creditcardlistcontainer");
        var bookingContainer = document.getElementById("dedicationbookinglistcontainer");
        
        if (items.length > 0) {
            creditCardContainer.style.display = "";
            bookingContainer.style.display = "none";
            e.component.selectRows('@(Model.SelectedCreditCard)', true);
            try { $("#save-button3").dxButton("instance").option("visible", true); } catch(e) {}
        } else {
            creditCardContainer.style.display = "none";
            bookingContainer.style.display = "none";
            try { $("#save-button3").dxButton("instance").option("visible", false); } catch(e) {}
        }
        // 更新按鈕文字，適用於信用卡或定期定額情境
        updateSaveButtonTextForCardAvailability();
    }

    // 奉獻預訂網格內容準備事件
    function onDedicationBookingGridContentReady(e) {
        e.component.columnOption("command:edit", { visibleIndex: -1, width: 50 });
    }

    // 刪除信用卡時顯示/隱藏 LoadPanel
    function onCreditCardRowRemoving(e) {
        // 開始刪除時顯示載入面板
        ShowLoadPanel();
    }
    function onCreditCardRowRemoved(e) {
        // 刪除完成後隱藏載入面板
        getLoadPanelInstance().hide();
        ShowToast("已刪除信用卡", "success", 1500);
    }
    function onCreditCardDataError(e) {
        // 發生錯誤時隱藏載入面板並提示
        getLoadPanelInstance().hide();
        ShowToast("刪除信用卡發生錯誤: " + (e.error && e.error.message ? e.error.message : ''), "error", 3000);
    }

    // ==================== AJAX 回調處理 ====================
    // AJAX 開始事件
    function onBegin() {}
    
    // AJAX 成功事件
    function onSuccess(data) {
        getLoadPanelInstance().hide();
        if (data.status == 1) {
            var payWay = data.PayWay || data.payWay || "";
            var paymentUrl = getPaymentRedirectUrl(data, payWay == "信用卡");
            if (paymentUrl) {
                ShowToast(data.message, "success", 2000);
                window.location.href = paymentUrl;
            } else if (payWay == "信用卡") {
                ShowToast("金流未回傳信用卡付款頁，請稍後再試或聯絡教會同工。", "error", 3000);
                document.getElementById('atmfield').innerHTML = data.message || "金流未回傳信用卡付款頁";
                document.getElementById('atm-info').style.display = 'block';
                setAtmCopyButtonVisible(false);
            } else {
                ShowToast(data.message, "success", 2000);
                document.getElementById('atmfield').innerHTML = data.DedicationResult;
                document.getElementById('atm-info').style.display = 'block';  // 顯示 ATM 資訊
                setAtmCopyButtonVisible(payWay == "ATM轉帳/匯款" || payWay == "虛擬帳號");
            }
        } else {
            ShowToast(data.message, "error", 3000);
            document.getElementById('atmfield').innerHTML = data.message;
            document.getElementById('atm-info').style.display = 'block';  // 顯示錯誤訊息
            setAtmCopyButtonVisible(false);
        }
    }

    function setAtmCopyButtonVisible(visible) {
        // 集中管理按鈕顯示狀態，避免 reset、成功分支、錯誤分支各自操作造成狀態殘留。
        var button = document.getElementById('atm-copy-button');
        if (button) {
            button.style.display = visible ? 'inline-flex' : 'none';
        }
    }

    function CopyAtmPaymentInfo() {
        // 從畫面上的 ATM 資訊區直接取文字，確保複製內容與使用者看到的付款資訊一致。
        var atmField = document.getElementById('atmfield');
        if (!atmField) {
            ShowToast("找不到 ATM/匯款資訊，無法複製。", "error", 2500);
            return;
        }

        var text = (atmField.innerText || atmField.textContent || "").trim();
        // LINE 發送結果是狀態提示，不是匯款必要資訊；複製給奉獻者時只保留付款資訊本體。
        var lineResultIndex = text.indexOf("LINE 發送結果");
        if (lineResultIndex >= 0) {
            text = text.substring(0, lineResultIndex).trim();
        }

        if (!text) {
            ShowToast("ATM/匯款資訊是空白，無法複製。", "error", 2500);
            return;
        }

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text)
                .then(function () {
                    ShowToast("已複製 ATM/匯款資訊。", "success", 1800);
                })
                .catch(function (error) {
                    fallbackCopyAtmPaymentInfo(text, error);
                });
            return;
        }

        fallbackCopyAtmPaymentInfo(text);
    }

    function fallbackCopyAtmPaymentInfo(text, originalError) {
        // 非 HTTPS 或舊版 WebView 可能沒有 navigator.clipboard；
        // 使用隱藏 textarea 保留舊瀏覽器與內嵌瀏覽器的複製能力。
        var textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.setAttribute('readonly', '');
        textArea.style.position = 'fixed';
        textArea.style.left = '-9999px';
        textArea.style.top = '0';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();

        try {
            var copied = document.execCommand('copy');
            ShowToast(copied ? "已複製 ATM/匯款資訊。" : "複製失敗，請手動選取 ATM/匯款資訊。", copied ? "success" : "error", 2500);
        } catch (error) {
            var message = originalError && originalError.message ? originalError.message : error.message;
            ShowToast("複製失敗：" + message, "error", 3000);
        } finally {
            document.body.removeChild(textArea);
        }
    }

    function getPaymentRedirectUrl(data, allowLegacyDedicationResult) {
        if (!data) {
            return "";
        }

        var candidate = data.PaymentPageUrl ||
            data.paymentPageUrl ||
            data.RedirectUrl ||
            data.redirectUrl ||
            "";
        if (!candidate && allowLegacyDedicationResult) {
            candidate = data.DedicationResult ||
                data.dedicationResult ||
                "";
        }
        if (typeof candidate !== "string") {
            return "";
        }

        candidate = candidate.trim();
        return /^https?:\/\//i.test(candidate) ? candidate : "";
    }

    // ==================== DevExtreme 本地化設定 ====================
    // 初始化本地化
    (function initializeLocalization() {
        var dictionary = {
            "zh-tw": {
                "dxScheduler-switcherAgenda": "會議內容",
                "Month": "月",
                "Subject": "主題",
                "Company": "Company",
                "Amount": "Amount",
                "PaymentDate": "Payment Date",
                "dxDataGrid-editingConfirmDeleteMessage": "您確定要刪除這張信用卡嗎?",
            }
        };
        DevExpress.localization.loadMessages(dictionary);
        var locale = "zh-tw";
        sessionStorage.setItem("locale", locale);
        DevExpress.localization.locale(locale);
    })();
</script>

