@using ChurchReport.Models
@using DevExtreme.AspNet.Mvc
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model DonationPaymentFormModel

@{
    ViewBag.Title = "線上奉獻 - 好牧人";
    
    // 讀取金流提供商設定
    var payProvider = Configuration["PAY_PROVIDER"] ?? "永豐金流";
    
    // 判斷是否為高鉅金流（高鉅金流時隱藏付款方式選項）
    var isMyPay = payProvider == "高鉅金流";
    
    // 根據金流提供商設定不同的付款方式選項
    string[] payWayOptions;
    if (isMyPay)
    {
        // 高鉅金流只支援信用卡
        payWayOptions = new string[] { "信用卡" };
    }
    else
    {
        // 永豐金流或其他金流支援的付款方式（包含信用卡定期定額）
        payWayOptions = new string[] { "信用卡", "ATM轉帳/匯款", "信用卡定期定額(每個月)", "LinePay", "行動支付" };
    }

    // 讀取教會聯絡資訊（來自 appsettings.json: ChurchInfo）
    var churchAddress = Configuration["ChurchInfo:Address"] ?? "桃園市楊梅區三民路二段157號";
    var churchPhone = Configuration["ChurchInfo:Phone"] ?? "03-4316679";
    var churchEmail = Configuration["ChurchInfo:Email"] ?? "mengsunghu@gmail.com";
    var churchTaxId = Configuration["ChurchInfo:TaxId"] ?? "13054485";
    var churchContactPerson = Configuration["ChurchInfo:ContactPerson"] ?? "胡夢嵩弟兄";
}

<!-- ==================== 頁面頭部 ==================== -->
<head>
    <meta charset="UTF-8">
     @*<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1">*@
     <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link rel="shortcut icon" href="~/assets/images/logo4.png" type="image/x-icon">
    
    <!-- 外部 CSS 庫（只保留不影響 navbar 的 icon） -->
    <link rel="stylesheet" href="~/assets/web-assets/mobirise-icons/mobirise-icons.css">
    
    <!-- DevExtreme & 自定義 CSS -->
    <link href="~/css/devextreme/dx.generic.custom-scheme.css" rel="stylesheet">
    <link href="~/css/Gallery.css" rel="stylesheet">
    <link href="~/css/WeeklyReport.css" rel="stylesheet">
    <link href="~/css/Scheduler.css" rel="stylesheet">
    <link href="~/css/Site.css" rel="stylesheet">
    
<!-- DonationPaymentView 專屬樣式 -->
<link href="~/css/DonationPaymentView.css?v=20251024" rel="stylesheet">
</head>

<style>
.donation-payment-page {
    --theme-primary: #0f766e;
    --theme-border: #d9e6f2;
    --theme-surface: #ffffff;
    --theme-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

.donation-payment-container {
    max-width: 1024px;
    margin: 0 auto;
  }

.donation-payment-card {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: 16px;
    box-shadow: var(--theme-shadow);
    padding: 14px 16px;
    margin-bottom: 12px;
  }

  .section-title {
    color: var(--theme-primary);
    margin: 0 0 14px;
    font-weight: 700;
    font-size: 1.12rem;
  }

  .section-subtitle {
    color: #64748b;
    margin: 0 0 14px;
    font-size: .92rem;
    line-height: 1.5;
  }

.donation-payment-page .dx-texteditor.dx-state-focused,
.donation-payment-page .dx-texteditor.dx-state-hover {
    box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.14);
    border-radius: 8px;
  }

  /* 放大 ATM 資訊區域字體 */
  #atmfield { font-size: 150%; }

  /* ATM/匯款資訊複製按鈕：維持醒目對比，方便奉獻者在手機上直接複製虛擬帳號資訊。 */
  .atm-copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: #c2410c;
    color: #ffffff;
    cursor: pointer;
    font-weight: 700;
    margin-top: 10px;
    padding: 8px 14px;
  }

  .atm-copy-button:hover {
    background: #9a3412;
  }

  .atm-copy-button:focus-visible {
    outline: 3px solid #fdba74;
    outline-offset: 2px;
  }
  
  /* 信用卡列表區域重新設計 */
  .card-list {
    background: #ffffff;
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    padding: 18px 20px;
    margin-top: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  
  .card-list h5 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px 0;
    font-weight: 600;
    color: #2f4f4f;
  }
  
  .card-list .section-subtitle {
    color: #666;
    margin: 0 0 16px 0;
    font-size: 0.95rem;
  }
  
  .card-list .grid-wrapper {
    border: 1px solid #eee;
    border-radius: 10px;
    padding: 8px;
    background: #fafafa;
  }
  
  /* DevExtreme Grid 視覺優化 - 響應式設計 */
  #CreditCardGrid.dx-datagrid {
    --row-height: 48px;
    border-radius: 8px;
    overflow: hidden;
    width: 100% !important;
    max-width: 100%;
  }
  
  /* 確保 Grid 容器不會溢出 */
  #CreditCardGrid .dx-datagrid-rowsview {
    overflow-x: auto !important;
  }
  
  #CreditCardGrid .dx-data-row > td {
    padding: 12px 16px;
    vertical-align: middle;
    white-space: nowrap;
  }
  
  #CreditCardGrid .dx-datagrid-headers {
    background: #e6f6f4;
    font-weight: 600;
  }
  
  #CreditCardGrid .dx-header-row > td {
    padding: 12px 16px;
    border-bottom: 2px solid #dee2e6;
    white-space: nowrap;
  }
  
  /* 信用卡號欄位樣式 - 響應式字體 */
  #CreditCardGrid .card-number-column {
    font-family: 'Courier New', monospace;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    letter-spacing: 0.8px;
    color: #2c3e50;
  }
  
  /* 到期日欄位樣式 - 響應式字體 */
  #CreditCardGrid .expire-date-column {
    font-family: 'Courier New', monospace;
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    font-weight: 600;
    color: #2c3e50;
  }
  
  /* 刪除按鈕樣式優化 */
  #CreditCardGrid .dx-link-delete {
    color: #dc3545;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 4px;
    transition: all 0.2s ease;
    font-size: clamp(0.85rem, 1.8vw, 1rem);
  }
  
  #CreditCardGrid .dx-link-delete:hover {
    background-color: #dc3545;
    color: white;
  }
  
  /* 選中行的樣式 */
  #CreditCardGrid .dx-selection.dx-row {
    background-color: #e3f2fd;
  }
  
  #CreditCardGrid .dx-row:hover {
    background-color: #f5f5f5;
    cursor: pointer;
  }

  #DedicationBookingGrid .dx-datagrid-headers .dx-header-row td {
    background: #e6f6f4;
    font-weight: 700;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  #DedicationBookingGrid .dx-datagrid-rowsview .dx-row > td {
    padding-top: 9px;
    padding-bottom: 9px;
    vertical-align: middle;
  }

  #DedicationBookingGrid .dx-datagrid-rowsview .dx-data-row:hover > td {
    background-color: #f0fdf4;
  }

  .atm-info {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 12px;
    padding: 12px;
    margin-top: 10px;
  }

  .booking-list {
    border: 1px solid #e8eef6;
    border-radius: 12px;
    padding: 12px;
    background: #fcfdff;
  }

  .church-info .info-card {
    border-radius: 14px;
    border: 1px solid #dbe7f4;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
  }
  
  /* 響應式設計 - 平板尺寸 (768px) */
  @@media (max-width: 768px) {
    .card-list {
      padding: 12px 15px;
    }
    
    #CreditCardGrid .dx-data-row > td,
    #CreditCardGrid .dx-header-row > td {
      padding: 10px 12px;
    }
    
    #CreditCardGrid .card-number-column {
      font-size: clamp(1rem, 3vw, 1.25rem);
      font-weight: 600;
      letter-spacing: 0.6px;
    }
    
    #CreditCardGrid .expire-date-column {
      font-size: clamp(0.95rem, 2.8vw, 1.15rem);
      font-weight: 600;
    }
    
    #CreditCardGrid .dx-link-delete {
      padding: 5px 10px;
      font-size: clamp(0.8rem, 2vw, 0.95rem);
    }
  }
  
  /* 響應式設計 - 手機尺寸 (576px) */
  @@media (max-width: 576px) {
    #CreditCardGrid .dx-data-row > td,
    #CreditCardGrid .dx-header-row > td {
      padding: 8px 8px;
    }
    
    #CreditCardGrid .card-number-column {
      font-size: clamp(0.9rem, 3.5vw, 1.15rem);
      font-weight: 600;
      letter-spacing: 0.4px;
    }
    
    #CreditCardGrid .expire-date-column {
      font-size: clamp(0.85rem, 3.2vw, 1.05rem);
      font-weight: 600;
    }
    
    #CreditCardGrid .dx-link-delete {
      padding: 4px 8px;
      font-size: clamp(0.75rem, 2.5vw, 0.9rem);
    }
    
    /* 減少表格高度以適應小螢幕 */
    #CreditCardGrid.dx-datagrid {
      --row-height: 42px;
    }

.donation-payment-card,
    .card-list,
    .booking-list {
      border-radius: 12px;
      padding: 10px;
    }

    .button-area {
      position: static;
      margin-top: 10px;
      z-index: auto;
    }

    #creditcardlistcontainer,
    #dedicationbookinglistcontainer {
      padding-bottom: 6px;
    }
  }
  
  /* 響應式設計 - 極小螢幕 (400px) */
  @@media (max-width: 400px) {
    #CreditCardGrid .dx-data-row > td,
    #CreditCardGrid .dx-header-row > td {
      padding: 6px 6px;
    }
    
    #CreditCardGrid .card-number-column {
      font-size: clamp(0.8rem, 4vw, 1rem);
      font-weight: 600;
      letter-spacing: 0.3px;
    }
    
    #CreditCardGrid .expire-date-column {
      font-size: clamp(0.75rem, 3.8vw, 0.95rem);
      font-weight: 600;
    }
    
    #CreditCardGrid .dx-link-delete {
      padding: 3px 6px;
      font-size: clamp(0.7rem, 3vw, 0.85rem);
    }
    
    #CreditCardGrid.dx-datagrid {
      --row-height: 38px;
    }

    .section-title {
      font-size: 1rem;
    }
  }

  @@media (max-width: 430px) {
.donation-payment-page {
      padding-left: 4px;
      padding-right: 4px;
    }

    #save-button3, #save-button2 {
      min-height: 44px;
    }
  }

  /* Button responsive fixes for mobile */
  /* Make the button container wrap and stack buttons on small screens */
  #buttonContainer {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
  }

  @@media (max-width: 576px) {
    /* Stack buttons vertically and ensure full width */
    #buttonContainer {
      flex-direction: column !important;
      align-items: center !important;
      gap: 8px;
    }
    /* DevExtreme buttons render inside elements with the given ID; reduce width to 70% and center */
    #save-button3, #save-button2 {
      width: 70% !important;
      min-width: 0 !important;
      margin: 0 auto !important;
    }
    /* Ensure the button text wraps and doesn't overflow */
    #save-button3 .dx-button-content, #save-button2 .dx-button-content {
      white-space: normal !important;
      overflow: visible !important;
    }
  }

  /* Button corner rounding for save buttons */
#save-button2 .dx-button-content,
#save-button3 .dx-button-content,
#save-button2 .dx-button,
#save-button3 .dx-button,
#save-button2,
#save-button3 {
  border-radius: 10px !important;
}

/* Ensure inner clickable area follows rounded corners */
#save-button2 .dx-button-content,
#save-button3 .dx-button-content {
  overflow: hidden;
  border-radius: 10px !important;
}

/* Slight shadow to match visual style */
#save-button2 .dx-button,
#save-button3 .dx-button {
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}

/* Maintain roundedness on small screens */
@@media (max-width: 576px) {
  #save-button2, #save-button3 {
    border-radius: 10px !important;
  }
  #save-button2 .dx-button-content, #save-button3 .dx-button-content {
    border-radius: 10px !important;
  }
}
</style>

<!-- ==================== 頁面主容器 ==================== -->
<div class="donation-payment-page">
    <div class="donation-payment-container">
        <!-- ==================== 奉獻者資訊 ==================== -->
        <div class="dedication-header">
            <h4 id="displaynamefield">
                <i class="mbri-user" style="margin-right: 10px;"></i>
                @Model.FullName 
                <span style="margin: 0 15px;">|</span> 
                <i class="mbri-numbered-list" style="margin-right: 10px;"></i>
                奉獻編號: @Model.DedicationNumber
            </h4>
        </div>

        <!-- ==================== 奉獻表單 ==================== -->
        <form data-ajax="true" 
              data-ajax-begin="onBegin" 
              data-ajax-success="onSuccess" 
                  asp-action="SaveDonationPaymentDedication"
              asp-controller="Dedication" 
              method="post">
            
            <div id="form-container" class="donation-payment-card">
                <h5 class="section-title">
                    <i class="mbri-edit" style="margin-right: 10px;"></i>奉獻資訊
                </h5>
                
                @(Html.DevExtreme().Form<DonationPaymentFormModel>()
                    .ID("form")
                    .ColCount(1)
                    .FormData(Model)
                    .OnContentReady(@<text>
                        function(e) {
                            e.component.validate();
                        }
                    </text>)
                    .Items(items =>
                    {
                        // 奉獻類別
                        items.AddSimpleFor(m => m.Category)
                            .Label(l => l.Text("奉獻類別"))
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(Model.DedicationCategoryList) // ✅ 改為使用動態清單
                                .OnValueChanged("OnCategorySelectBoxValueChanged")
                            );

                        // 宣教對象
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("宣教對象"))
                            .Visible(false)
                            .Name("OtherDedicationSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(Model.OtherCategoryArray)
                                .Placeholder("請選擇宣教對象")
                            );

                        // 特別奉獻項目
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("特別奉獻項目"))
                            .Visible(false)
                            .Name("SpecialDedicationSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(Model.SpecialCategoryArray)
                                .Placeholder("請選擇特別奉獻項目")
                            );

                        // 其他奉獻內容
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("其他奉獻內容"))
                            .Visible(false)
                            .Name("OtherDedication")
                            .Editor(e => e
                                .Autocomplete()
                                .Width(200)
                                .DataSource(Model.OtherCategoryArray)
                                .Placeholder("請輸入其他奉獻內容")
                            );

                        // 節期選項
                        items.AddSimpleFor(m => m.Others)
                            .Label(l => l.Text("節期"))
                            .Visible(false)
                            .Name("HolidayDedicationSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(250)
                                .DataSource(new string[] {
                                    "元旦", "新春", "清明節", "復活節", "母親節",
                                    "父親節", "重陽節", "感恩節", "聖誕節"
                                })
                                .Placeholder("請選擇節期")
                            );

                        // 奉獻金額
                        items.AddSimpleFor(m => m.Amount)
                            .Label(l => l.Text("奉獻金額"))
                            .Name("DedicationAmount")
                            .Editor(e => e
                                .NumberBox()
                                .Width(200)
                                .OnContentReady("OnAmountContentReady")
                                .Placeholder("請輸入奉獻金額")
                            );

                        // 付款方式 - 高鉅金流時隱藏此欄位
                        items.AddSimpleFor(m => m.PayWay)
                            .Label(l => l.Text("付款方式"))
                            .Name("PayWaySelectBox")
                            .Visible(!isMyPay)
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(payWayOptions)
                                .OnValueChanged("OnPayWaySelectBoxValueChanged")
                            );

                        // 定期定額總期數 - 高鉅金流時隱藏此欄位
                        items.AddSimpleFor(m => m.DeductTotalNumber)
                            .Label(l => l.Text("總期數"))
                            .Visible(false)
                            .Name("DeductTotalNumberSelectionBox")
                            .Editor(e => e
                                .SelectBox()
                                .Width(200)
                                .DataSource(new string[] {
                                    "3個月", "6個月", "12個月", "18個月", "24個月"
                                })
                                .Value("12個月")
                            );

                        // 選取的信用卡（隱藏欄位）
                        items.AddSimpleFor(m => m.SelectedCreditCard)
                            .Label(l => l.Text("選取的信用卡").Visible(false))
                            .Editor(e => e
                                .TextBox()
                                .Width(120)
                                .Visible(false)
                                .Placeholder("選取的信用卡")
                            );

                        // 附註
                        items.AddSimpleFor(m => m.Explain)
                            .Label(l => l.Text("備註說明"))
                            .Editor(e => e
                                .TextArea()
                                .Width(200)
                                .Height(60)
                                .Placeholder("您可以在此輸入特別說明或留言")
                            );
                    })
                )
            </div>

            <!-- ==================== 信用卡列表 ==================== -->
        <div id="creditcardlistcontainer" class="card-list donation-payment-card">
                <h4 class="section-title">
                    <i class="mbri-credit-card" style="margin-right: 15px;"></i>
                    我的信用卡
                </h4>
                <p class="section-subtitle" style="font-size: 1rem;">
                    <i class="mbri-info" style="margin-right: 5px;"></i>
                    您可以刪除不想使用的信用卡，並選擇本次要使用的信用卡進行奉獻
                </p>
                
                @(Html.DevExtreme().DataGrid<CreditCard>()
                    .ID("CreditCardGrid")
                    .Width("100%")
                    .ShowBorders(true)
                    .ColumnAutoWidth(false)
                    .Paging(paging => paging.Enabled(false))
                    .AllowColumnResizing(true)
                    .ColumnResizingMode(ColumnResizingMode.Widget)
                    .ColumnFixing(c => c.Enabled(false))
                    .LoadPanel(l => l.Text("Loading...").Enabled(false))
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .ShowBorders(true)
                    .Selection(selection => selection.Mode(SelectionMode.Single))
                    .OnRowClick("OnRowClick")
                    .OnSelectionChanged("OnRowSelectionChanged")
                    .OnInitialized("DataGridOnInitialized")
                    .OnContentReady("onCreditCardGridContentReady")
                    .OnRowRemoving("onCreditCardRowRemoving")
                    .OnRowRemoved("onCreditCardRowRemoved")
                    .OnDataErrorOccurred("onCreditCardDataError")
                    .HoverStateEnabled(true)
                    .Editing(editing => {
                        editing.AllowDeleting(true);
                        editing.Texts(a => a
                            .DeleteRow("刪除")
                            .ConfirmDeleteMessage("您是否確定要刪除此信用卡?")
                        );
                    })
                    .Columns(columns => {
                        columns.AddFor(m => m.CreditCardNumber)
                            .Caption("信用卡號")
                            .Width("60%")
                            .Alignment(HorizontalAlignment.Left)
                            .CssClass("card-number-column");
                        columns.AddFor(m => m.ExpireDate)
                            .Caption("到期日")
                            .Width("25%")
                            .Alignment(HorizontalAlignment.Center)
                            .CssClass("expire-date-column");
                    })
                    .DataSource(d => d
                        .WebApi()
                        .Controller("Dedication")
                        .LoadAction("LoadCreditCardList")
                        .DeleteAction("DeleteCreditCard")
                        .Key("CCToken")
                    )
                    .SelectedRowKeys(new int[] { 1 })
                )
            </div>

            <!-- ==================== 按鈕區域 ==================== -->
            <div class="button-area dx-field">
                <div id="buttonContainer" style="display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: flex-start; gap:10px;">
                    @(Html.DevExtreme().Button()
                        .Text("確認奉獻")
                        .Icon("check")
                        .Type(ButtonType.Success)
                        .ID("save-button2")
                        .Width(180)
                        .UseSubmitBehavior(true)
                        .OnClick("ShowLoadPanel")
                    )
                    @(Html.DevExtreme().Button()
                        .Text("使用其他信用卡")
                        .Icon("fa-solid fa-shield-halved")
                        .Type(ButtonType.Default)
                        .ID("save-button3")
                        .Width(240)
                        .UseSubmitBehavior(true)
                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("UseOtherCreditCard")
                    )
                </div>
            </div>
            
            <!-- ==================== ATM資訊區域 ==================== -->
            <div id="atm-info" class="atm-info" style="display: none;">
                <h5 id="atmfield"></h5>
                @* 此按鈕只在 ATM/匯款或後端回傳「虛擬帳號」結果時顯示，避免信用卡錯誤訊息出現無關複製操作。 *@
                <button id="atm-copy-button" class="atm-copy-button" type="button" style="display: none;" onclick="CopyAtmPaymentInfo()">
                    複製 ATM/匯款資訊
                </button>
            </div>

                        <!-- ==================== 定期定額清單 ==================== -->
        <div id="dedicationbookinglistcontainer" class="booking-list donation-payment-card">
                <h5 class="section-title">
                    <i class="mbri-timer" style="margin-right: 10px;"></i>
                    定期定額奉獻清單
                </h5>
                <p class="section-subtitle" style="margin-bottom: 16px;">
                    <i class="mbri-info" style="margin-right: 5px;"></i>
                    您可以在此查看和管理您的定期定額奉獻項目
                </p>
                
                @(Html.DevExtreme().DataGrid<DedicationBooking>()
                    .ID("DedicationBookingGrid")
                    .Width("auto")
                    .ColumnWidth(5)
                    .LoadPanel(l => l.Text("Loading...").Enabled(false))
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .ShowBorders(true)
                    .Selection(selection => selection.Mode(SelectionMode.Single))
                    .OnSelectionChanged("OnRowSelectionChanged")
                    .OnContentReady("onDedicationBookingGridContentReady")
                    .Editing(editing => {
                        editing.Mode(GridEditMode.Cell);
                        editing.RefreshMode(GridEditRefreshMode.Reshape);
                        editing.AllowDeleting(true);
                        editing.Texts(a => a
                            .DeleteRow("Cancel")
                            .ConfirmDeleteMessage("Are you sure to cancel this subscription?")
                            .ConfirmDeleteTitle("Cancel Subscription")
                        );
                    })
                    .Columns(columns => {
                        columns.AddFor(m => m.DedicationCategory).Caption("奉獻類別").Width(70).MinWidth(75).Alignment(HorizontalAlignment.Center).Fixed(true);
                        columns.AddFor(m => m.DedicationBookingStatus).Caption("狀態").Width(70).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.AmountPerStage).Caption("每期金額").Width(75).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.TotalStages).Caption("總期數").Width(70).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.DedicationAmount).Caption("應付總金額").Width(85).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.PaidPeriod).Caption("目前期數").Width(75).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.RollupPaidFee).Caption("已付金額").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.StartDate).Caption("開始日期").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                        columns.AddFor(m => m.EndDate).Caption("結束日期").Width(80).MinWidth(50).Alignment(HorizontalAlignment.Center);
                    })
                    .DataSource(d => d
                        .WebApi()
                        .Controller("Dedication")
                        .LoadAction("LoadDedicationBookingList")
                        .DeleteAction("DeleteDedicationBooking")
                        .Key("EntityId")
                    )
                    .SelectedRowKeys(new int[] { 1 })
                )
            </div>

            <!-- ==================== 教會資訊與奉獻說明 ==================== -->
            <section class="church-info" id="church-info">
                <div class="container">
                    <div class="info-grid">
                        <!-- 聯絡資訊卡 -->
                        <div class="info-card contact-card">
                            <h5><i class="fas fa-church" aria-hidden="true"></i> 教會聯絡資訊</h5>
                            <ul class="contact-list">
                                <li><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span>地址：@churchAddress</span></li>
                                <li><i class="fas fa-phone" aria-hidden="true"></i><span>電話：@churchPhone</span></li>
                                <li><i class="fas fa-envelope" aria-hidden="true"></i><span>信箱：@churchEmail</span></li>
                                <li><i class="fas fa-id-card" aria-hidden="true"></i><span>統編：@churchTaxId</span></li>
                                <li><i class="fas fa-info-circle" aria-hidden="true"></i><span>若有任何奉獻問題，請洽詢 @churchContactPerson</span></li>
                            </ul>
                        </div>

                        <!-- 奉獻說明卡（原生手風琴） -->
                        <div class="info-card">
                            <h5><i class="fas fa-hand-holding-heart" aria-hidden="true"></i> 奉獻說明</h5>
                            <div class="accordion-clean">
                                <details>
                                    <summary>
                                        <span><i class="fas fa-seedling"></i> 十一奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            十一奉獻是基督徒應盡的責任和義務。
                                            所以上帝挑戰我們，當我們願意將十分之一奉獻給上帝時，
                                            上帝將會傾倒更大的祝福在我們的身上。

                                            萬軍之耶和華說：你們要將當納的十分之一全然送入倉庫，使我家有糧，
                                            以此試試我，是否為你們敞開天上的窗戶，傾福與你們，甚至無處可容。
                                            ─ 瑪拉基書3:10
                                        </p>
                                    </div>
                                </details>

                                <details>
                                    <summary>
                                        <span><i class="fas fa-building"></i> 建堂奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            因著神的憐憫，「好牧人」從恩典到奇蹟的這段旅程，讓我們著實看見神奇妙又信實的作為。
                                            為了滿足場地以及相關軟硬體等財務需求，邀請好牧人的弟兄姊妹們，透過「建堂奉獻」一起支持、建造神國的家。
                                        </p>
                                    </div>
                                </details>

                                <details>
                                    <summary>
                                        <span><i class="fas fa-heart"></i> 感恩奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            上帝的祝福讓我們學習凡事謝恩，而獻上財物則是我們感謝上帝的一種方式。
                                            我們鼓勵每個人都應該照自己心裡所願來奉獻，不猶豫、不勉強，因為上帝喜愛樂意奉獻的人。
                                        </p>
                                    </div>
                                </details>

                                <details>
                                    <summary>
                                        <span><i class="fas fa-globe-asia"></i> 宣教奉獻</span>
                                        <i class="fas fa-chevron-down chevron" aria-hidden="true"></i>
                                    </summary>
                                    <div class="content">
                                        <p>
                                            「使萬民成為主的門徒」是上帝的心意，也是託付給教會的大使命。
                                            根據統計，目前全球仍有31億、約41%的未得之民（缺乏基督教會、宣教士、聖經等信仰資源，而從未接觸福音者），宣教的需要永遠都是刻不容緩！
                                            也許不是每個人都會被上帝呼召成為「宣教士」，但每個人都可以透過奉獻來做「宣教事」。
                                        </p>
                                    </div>
                                </details>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>

        <!-- ==================== 通知元件 ==================== -->
        <div class="notification-area dx-field">
            <div id="ToastContainer">
                @(Html.DevExtreme().Toast()
                    .ID("toast")
                    .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                    .Message("Upload success")
                    .DisplayTime(20000)
                    .MaxWidth(200)
                )
            </div>
            
            <div id="LoadPanel">
                @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("Processing...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                )
            </div>
        </div>

        
    </div>
</div>

