@using ChurchReport.Models
@model DonationPaymentFormModel
@*<div class="long-title"><h3>奉獻資訊</h3></div>*@

<style>
    .dedication-keyin-page {
        --action-button-height: 40px;
        --theme-primary: #0f766e;
        --theme-border: #d9e6f2;
        --theme-surface: #ffffff;
        --theme-text: #0f172a;
        --theme-muted: #64748b;
        --theme-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        color: var(--theme-text);
        padding: 12px 10px 20px;
    }

    .dedication-keyin-card {
        background: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 16px;
        box-shadow: var(--theme-shadow);
        padding: 14px 16px;
        margin-bottom: 12px;
    }

    .dedication-keyin-header {
        background: linear-gradient(145deg, #f0fdfa 0%, #f8fafc 60%, #ecfeff 100%);
    }

    .dedication-keyin-header h5 {
        margin: 0;
        color: var(--theme-primary);
        font-size: 1.08rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .dedication-keyin-tip {
        margin-top: 7px;
        color: var(--theme-muted);
        font-size: .9rem;
    }

    #form-container-query,
    #form-container-upload,
    #samenamecontainer,
    #uploadresultcontainer {
        border-radius: 14px;
    }

    #form-container-query .dx-field-item-label-text,
    #form-container-upload .dx-field-item-label-text,
    #samenamecontainer .dx-datagrid-text-content {
        font-weight: 600;
    }

    #form-container-query .dx-texteditor,
    #form-container-upload .dx-texteditor {
        border-radius: 10px;
    }

    .dedication-keyin-page .dx-texteditor.dx-state-focused,
    .dedication-keyin-page .dx-texteditor.dx-state-hover {
        box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.14);
    }

    #buttonContainer2,
    #buttonContainer3 {
        margin: 8px 0 14px;
        display: flex;
        justify-content: flex-start;
    }

    #buttonContainer2 .dx-button,
    #buttonContainer3 .dx-button {
        min-width: 100px;
        height: var(--action-button-height);
        border-radius: 999px;
        display: inline-flex;
        align-items: stretch;
        padding: 0;
        box-sizing: border-box;
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.22);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    #buttonContainer2 .dx-button-content,
    #buttonContainer3 .dx-button-content {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex: 1 1 auto;
        height: 100% !important;
        padding: 0 20px !important;
        box-sizing: border-box;
    }

    #save-button2 .dx-button-content,
    #save-button3 .dx-button-content {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        height: 100% !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    #save-button2 .dx-button-content::after,
    #save-button3 .dx-button-content::after {
        display: none !important;
    }

    #buttonContainer2 .dx-button-text,
    #buttonContainer3 .dx-button-text,
    #save-button2 .dx-button-text,
    #save-button3 .dx-button-text {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 1px;
        display: inline !important;
        height: auto !important;
        line-height: normal !important;
        margin: 0 !important;
        vertical-align: middle !important;
        transform: none !important;
    }

    #buttonContainer2 .dx-button:hover,
    #buttonContainer3 .dx-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(15, 118, 110, 0.32);
    }

    #SameNameList .dx-datagrid-headers {
        border-radius: 10px;
        overflow: hidden;
    }

    #SameNameList .dx-datagrid-headers .dx-header-row td {
        background: #e6f6f4;
        color: #0f172a;
        font-weight: 700;
        padding-top: 11px;
        padding-bottom: 11px;
    }

    #SameNameList .dx-datagrid-rowsview .dx-row > td {
        padding-top: 10px;
        padding-bottom: 10px;
        vertical-align: middle;
    }

    #SameNameList .dx-datagrid-rowsview .dx-data-row:hover > td,
    #SameNameList .dx-selection > td,
    #SameNameList .dx-row-focused > td {
        background-color: #d1fae5 !important;
    }

    #ToastContainer .dx-toast-message {
        border-radius: 10px;
        font-size: .92rem;
    }

    #popup .dx-popup-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    #popup .dx-popup-title {
        color: var(--theme-primary);
        font-weight: 700;
    }

    #resultfield {
        margin: 0;
        color: #4338ca;
        font-size: .96rem;
        line-height: 1.55;
        white-space: pre-line;
    }

    @@media (max-width: 430px) {
        .dedication-keyin-page {
            padding: 8px 4px 14px;
        }

        .dedication-keyin-card {
            border-radius: 12px;
            padding: 10px;
        }

        .dedication-keyin-header h5 {
            font-size: .98rem;
        }

        .keyin-btn-container {
            text-align: left !important;
            float: none !important;
            margin-bottom: 10px;
        }

        .keyin-btn-container .dx-button {
            height: var(--action-button-height);
            min-height: 44px;
            width: auto !important;
            min-width: 0 !important;
            float: none !important;
            display: inline-flex;
            align-items: stretch;
            padding: 0;
        }

        .keyin-btn-container .dx-button .dx-button-content {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex: 1 1 auto;
            height: 100% !important;
            padding: 0 20px !important;
        }

        .keyin-btn-container .dx-button .dx-button-text {
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 1px;
            display: inline !important;
            height: auto !important;
            line-height: normal !important;
            margin: 0 !important;
            vertical-align: middle !important;
            transform: none !important;
        }

        /* 手機版表單：標籤獨立一行置於輸入框上方（純 CSS 堆疊，蓋掉 JS 量好的左欄寬） */
        .dedication-keyin-page .dx-layout-manager .dx-label-h-align.dx-flex-layout {
            flex-direction: column;
            align-items: stretch;
        }

        .dedication-keyin-page .dx-layout-manager .dx-label-h-align .dx-field-item-label,
        .dedication-keyin-page .dx-layout-manager .dx-label-h-align .dx-field-item-content {
            display: block;
            width: auto !important;
        }

        .dedication-keyin-page .dx-field-item-label {
            font-size: 15px;
            font-weight: 600;
            padding-bottom: 4px;
        }

        .dedication-keyin-page .dx-texteditor {
            width: 100% !important;
        }

        .dedication-keyin-page .dx-texteditor-input {
            font-size: 16px;
            padding: 8px 10px;
        }

        .dedication-keyin-page .dx-placeholder {
            font-size: 16px;
            display: flex;
            align-items: center;
        }

        .dedication-keyin-page .dx-placeholder::before {
            padding-top: 0;
            padding-bottom: 0;
        }

        #SameNameList .dx-datagrid-headers .dx-header-row td,
        #SameNameList .dx-datagrid-rowsview .dx-row > td {
            font-size: .86rem;
            padding-top: 8px;
            padding-bottom: 8px;
        }

        #popup {
            max-width: 92vw;
        }
    }
</style>

<script src="~/js/ActionButtonCentering.js"></script>

<div class="dedication-keyin-page">
<div class="dedication-keyin-card dedication-keyin-header">
    <h5 id="displaynamefield">輸入人員：@(Model.FullName)</h5>
    <div class="dedication-keyin-tip">先按「查詢」確認資料，再輸入奉獻內容按「上傳」。</div>
</div>

<div class="dx-field">
    <div id="ToastContainer">
        @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )
    </div>

    <div id="PopupContainer">
        @(Html.DevExtreme().Popup()
                .ID("popup")
                .Title("是否要新增新人?")
                .Visible(false)
                .Height(80)
                .Width(330)
                .MaxHeight(80)
                .MaxWidth(330)
                .Position(PositionAlignment.Center)
                .ResizeEnabled(true)
                //.ShadingColor("blue")
                .ShowCloseButton(true)
                .ContentTemplate(@<text>
                    @*<p>是否要新增新人?</p>*@
                    @(Html.DevExtreme().Button()
                        .Text("確定")
                        .OnClick("button_ok_click")
                    )
                    @*<br/>*@
                    @(Html.DevExtreme().Button()
                        .Text("取消")
                        .OnClick("button_cancel_click")
                    )
                </text>)
            )

        <script type="text/javascript">
            function button_ok_click(e) {
                //alert("我要新增新人!");
                $("#popup").dxPopup("instance").hide();

                // AJAX 區塊
                $.ajax
                (
                    {
                        url: '@Url.Action("CreateContact", "Dedication")',  // ✅ 修正：改為 Dedication 控制器
                        data:
                        {
                            FullName: $("#form1").dxForm("instance").getEditor('FullName').option('value'),
                        }, // 整理回傳給 Server 的點名資料
                        type: 'POST', //POST if you want to save, GET if you want to fetch data from server

                        success: function (arg)
                            {
                                if (arg.status == 1)
                                {
                                    // 顯示上傳成功
                                    ShowToast(arg.message, "success", 2000);
                                }
                                else{
                                    ShowToast(arg.message, "error", 5000);
                                }

                                document.getElementById('resultfield').innerHTML = arg.message;
                            },

                        error: function (obj)
                                    {
                                        // 顯示錯誤訊息
                                        var errorMsg = obj.responseText || '新增失敗，請稍後再試';
                                        ShowToast(errorMsg, "error", 5000);
                                        console.error('CreateContact Error:', obj);
                                    }

                    }
                );
                // AJAX 區塊

            }
            function button_cancel_click(e) {
                alert("我不要新增新人!");
                $("#popup").dxPopup("instance").hide();
            }
        </script>
    </div>

    <div id="LoadPanel">
        @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )

    </div>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" data-ajax-failure="onFailure" asp-action="SaveKeyInDedication" asp-controller="Dedication" method="post">
    <div id="form-container-query" class="dedication-keyin-card">
        @(Html.DevExtreme().Form<DonationPaymentFormModel>()
     .ID("form1")
     .ColCount(1)
     .Items(items =>
     {
         items.AddSimpleFor(m => m.DedicationDate)
               //.DataField("LastName")
               .Label(l => l.Text("奉獻日期"))
               .Editor(e => e
                   .DateBox()
                   .Width(135)
                   .Disabled(false)
                   .DisplayFormat("yyyy/M/d")
                   .Placeholder("輸入奉獻日期")
                   .FocusStateEnabled(true)
              );

         items.AddSimpleFor(m => m.DedicationNumber)
                //.DataField("LastName")
                .Label(l => l.Text("奉獻編號"))
                .Editor(e => e
                    .TextBox()
                    .Width(120)
                    .Disabled(false)
                    .Placeholder("輸入奉獻編號")
                    .FocusStateEnabled(true)
               );

         items.AddSimpleFor(m => m.NationId)
               //.DataField("LastName")
               .Label(l => l.Text("身份證字號"))
               .Editor(e => e
                   .TextBox()
                   .Width(120)
                   .Disabled(false)
                   .Placeholder("輸入身份證字號")
                   .FocusStateEnabled(true)
              );

         items.AddSimpleFor(m=>m.FullName)
            //.DataField("LastName")
            .Label(l => l.Text("姓名"))
            .Editor(e => e
                .TextBox()
                .Width(120)
                .Disabled(false)
                .Placeholder("輸入姓名")
           );

         items.AddSimpleFor(m=>m.Mobile)
                .Label(l => l.Text("電話號碼"))
                .Editor(e => e
                    .TextBox()
                    .Width(120)
                    //.Mask("(X000) 000-000")
                    .MaskRules(new { X = new JS("/[02-9]/") })
                    .Placeholder("輸入電話號碼")
                );
         items.AddSimpleFor(m => m.LastSixDigit)
                .Label(l => l.Text("帳戶後六碼"))
                .Editor(e => e
                    .TextBox()
                    .Width(120)
                    //.Mask("(X000) 000-000")
                    .MaskRules(new { X = new JS("/[02-9]/") })
                    .Placeholder("輸入帳戶後六碼")
                );

         items.AddSimpleFor(m => m.ChurchName)
               .Label(l => l.Text("所屬教會"))
               .Visible(false)
               .Editor(e => e
                   .TextBox()
                   .Width(120)
                   .Placeholder("所屬教會")
                   .Disabled(true)
         );

         // 隱藏欄位：儲存從同名清單選取的 CRM Contact GUID
         // 上傳時後端用此 GUID 直接取得 contact，跳過模糊查詢避免卡住
         items.AddSimpleFor(m => m.SelectedContactId)
               .Label(l => l.Text("SelectedContactId"))
               .Visible(false)
               .Editor(e => e
                   .TextBox()
                   .Width(120)
         );

     })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
                $("#form1").dxForm("instance").getEditor('DedicationNumber').focus();
            }
        </text>)

        .FormData(Model)
        )
    </div>
