                    .Name("OtherDedication")
                    .Editor
                    (
                        e => e
                        .Autocomplete()
                        .Width(120)
                        .DataSource(Model.OtherCategoryArray)
                        .Placeholder("請輸入其他奉獻內容")
                    //.Value("特別")
                    );
            items.AddSimpleFor(m => m.Amount)
                    //.DataField("LastName")
                    .Label(l => l.Text("奉獻金額"))
                    .Editor(e => e
                        .NumberBox().Value(null)
                        .Width(120)
                        .Disabled(false)
                        .Placeholder("輸入奉獻金額")
                    );

            items.AddSimpleFor
                    (m => m.PayWay)
                        .Label(l => l.Text("付款方式"))
                        .Editor
                        (
                            e => e
                            .SelectBox()
                            .Width(120)
                            .DataSource(new string[]
                            {
                                "現金",
                                "信用卡",
                                "銀行轉帳",
                                //"郵政劃撥",
                                //"其它",
                            }
                        //.DisplayExpr("Name")
                        )
                        .Value("現金")
                    );
            items.AddSimpleFor(m => m.Explain)
                //.DataField("LastName")
                .Label(l => l.Text("備註").Visible(true))
                .Editor(e => e
                    .TextBox()
                    .Width(150).Visible(true)
                    //.Disabled(true)
                    .Placeholder("請輸入備註")
               );
            items.AddSimpleFor(m => m.WeeklyNote)
                //.DataField("LastName")
                .Label(l => l.Text("週報專用備註").Visible(true))
                .Editor(e => e
                .TextBox()
                .Width(150).Visible(true)
                //.Disabled(true)
                .Placeholder("請輸入週報專用備註")
                );

            items.AddSimpleFor(m => m.ClickType)
                    //.DataField("LastName")
                    .Label(l => l.Text("查詢或上傳").Visible(false))
                    .Editor(e => e
                        .TextBox()
                        .Width(120).Visible(false)
                        //.Disabled(true)
                        .Placeholder("查詢或上傳")
                   );

        })
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)

        .FormData(Model)
        )
    </div>
    <div id="buttonContainer3" class="keyin-btn-container">
        @(Html.DevExtreme().Button()
                    .Text("上傳")
                    .Type(ButtonType.Success)
                .Height(40)
                    .ID("save-button3")
                    .OnInitialized("onActionButtonInitialized")
                    .UseSubmitBehavior(true)
                    .OnClick("OnClickUpdate")
            )
    </div>
</form>

