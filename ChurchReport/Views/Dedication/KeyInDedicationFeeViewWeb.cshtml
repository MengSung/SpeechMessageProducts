                $("#form1").dxForm("instance").updateData('Mobile', data.Mobile);
                $("#form1").dxForm("instance").updateData('ChurchName', data.ChurchName);
                $("#form1").dxForm("instance").updateData('LastSixDigit', data.LastSixDigit);
                // 儲存選定的 CRM Contact GUID，上傳時後端可直接取得 contact，跳過多筆模糊查詢
                $("#form1").dxForm("instance").updateData('SelectedContactId', data.SameNameElementId);

                $("#SameNameList").dxDataGrid("instance").deselectAll();
            }
        }
