@{
    ViewData["Title"] = "付款結果";
    Layout = null;
}

@{
    string message = "";
    bool isSuccess = false;
    string fullName = ViewBag.FullName ?? "會友";
    string dedicationCategory = ViewBag.DedicationCategory ?? "奉獻";
    string amount = ViewBag.Amount ?? "0";
    string paymentTime = ViewBag.PaymentTime ?? DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");
    string orderId = ViewBag.OrderId ?? "";
    string transactionId = ViewBag.TransactionId ?? "";

    if (ViewBag.Message != null)
    {
        message = ViewBag.Message.ToString();
        isSuccess = ViewBag.IsSuccess != null ? (bool)ViewBag.IsSuccess : false;
    }
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>付款結果</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px 0;
        }
        .result-card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border: none;
        }
        .success-icon {
            font-size: 4rem;
            color: #28a745;
            animation: scaleIn 0.5s ease-in-out;
        }
        .failure-icon {
            font-size: 4rem;
            color: #dc3545;
            animation: shake 0.5s ease-in-out;
        }
        @@keyframes scaleIn {
            0% { transform: scale(0); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
        .info-row {
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #666;
            width: 120px;
            display: inline-block;
        }
        .info-value {
            color: #333;
        }
        .btn-custom {
            border-radius: 25px;
            padding: 10px 30px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card result-card">
                <div class="card-header text-center">
                    <h3><i class="fas fa-heart"></i> 付款結果</h3>
                </div>
                <div class="card-body">
                    <!-- 結果圖示與訊息 -->
                    <div class="text-center mb-4">
                        @if (isSuccess)
                        {
                            <i class="fas fa-check-circle success-icon"></i>
                            <h4 class="mt-3 text-success">付款成功！</h4>
                            <p class="text-muted">@message</p>
                        }
                        else
                        {
                            <i class="fas fa-times-circle failure-icon"></i>
                            <h4 class="mt-3 text-danger">付款失敗</h4>
                            <p class="text-muted">@message</p>
                        }
                    </div>

                    @if (isSuccess)
                    {
                        <!-- 奉獻資訊 -->
                        <div class="card mb-3">
                            <div class="card-header bg-primary text-white">
                                <i class="fas fa-gift"></i> 奉獻資訊
                            </div>
                            <div class="card-body">
                                <div class="info-row">
                                    <span class="info-label"><i class="fas fa-user"></i> 姓名：</span>
                                    <span class="info-value">@fullName</span>
                                </div>
                                <div class="info-row">
                                    <span class="info-label"><i class="fas fa-heart"></i> 奉獻類別：</span>
                                    <span class="info-value">@dedicationCategory</span>
                                </div>
                                <div class="info-row">
                                    <span class="info-label"><i class="fas fa-dollar-sign"></i> 奉獻金額：</span>
                                    <span class="info-value text-primary font-weight-bold">NT$ @amount</span>
                                </div>
                                <div class="info-row">
                                    <span class="info-label"><i class="fas fa-calendar-alt"></i> 奉獻時間：</span>
                                    <span class="info-value">@paymentTime</span>
                                </div>
                                <div class="info-row">
                                    <span class="info-label"><i class="fas fa-credit-card"></i> 付款方式：</span>
                                    <span class="info-value">信用卡</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(orderId))
                                {
                                    <div class="info-row">
                                        <span class="info-label"><i class="fas fa-receipt"></i> 訂單編號：</span>
                                        <span class="info-value"><small>@orderId</small></span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(transactionId))
                                {
                                    <div class="info-row">
                                        <span class="info-label"><i class="fas fa-barcode"></i> 交易編號：</span>
                                        <span class="info-value"><small>@transactionId</small></span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 溫馨提醒 -->
                        <div class="alert alert-info" role="alert">
                            <h5 class="alert-heading">
                                <i class="fas fa-info-circle"></i> 溫馨提醒
                            </h5>
                            <hr>
                            <p class="mb-0">
                                <i class="fas fa-check"></i> 您的奉獻已經成功完成，相關收據將透過 LINE 通知您。<br>
                                <i class="fas fa-check"></i> 如需紙本收據，請聯繫教會辦公室。<br>
                                <i class="fas fa-check"></i> 感謝您對教會事工的支持與奉獻！<br>
                                <i class="fas fa-praying-hands"></i> 願上帝賜福與您！
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- 失敗提醒 -->
                        <div class="alert alert-warning" role="alert">
                            <h5 class="alert-heading">
                                <i class="fas fa-exclamation-triangle"></i> 需要協助？
                            </h5>
                            <hr>
                            <p class="mb-0">
                                如果多次嘗試仍無法完成付款，請聯繫教會辦公室。<br>
                                您也可以選擇其他付款方式完成奉獻。<br>
                                教會辦公室將協助您解決付款問題。
                            </p>
                        </div>
                    }

                    <!-- 操作按鈕 -->
                    <div class="text-center mt-4">
                        @if (isSuccess)
                        {
                            <a href="@Url.Action("QPayView/網頁登入", "Home")" class="btn btn-primary btn-custom">
                                <i class="fas fa-home"></i> 回奉獻頁面
                            </a>
                            <a href="@Url.Action("DedicationFeeView", "Home")" class="btn btn-success btn-custom ml-2">
                                <i class="fas fa-list"></i> 定期定額
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("QPayView/網頁登入", "Home")" class="btn btn-primary btn-custom">
                                <i class="fas fa-redo"></i> 重新付款
                            </a>
                            <a href="@Url.Action("ChurchRoot", "Home")" class="btn btn-outline-secondary btn-custom ml-2">
                                <i class="fas fa-home"></i> 回首頁
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- 聯絡資訊 -->
            <div class="text-center mt-3">
                <p class="text-white">
                    <small>
                        <i class="fas fa-phone"></i> 如有問題請聯繫教會辦公室<br>
                        願上帝賜福與您！
                    </small>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS and dependencies -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>