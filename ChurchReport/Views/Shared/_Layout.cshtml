    <!-- 自定義 Navbar 樣式 -->
    <style>
        /* Navbar 主體樣式 - 漸層背景和陰影 */
        .navbar-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); /* 紫色到藍色的漸層 */
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* 輕微陰影效果 */
        }

        /* Navbar 品牌區域 - LOGO 和文字 */
        .navbar-custom .navbar-brand {
            color: #fff; /* 白色文字 */
            font-weight: bold; /* 粗體 */
            font-size: 1.5em; /* 放大字體 */
            padding: 8px 15px; /* 內邊距 */
            display: flex; /* Flexbox 布局 */
            align-items: center; /* 垂直居中 */
            gap: 12px; /* LOGO 與文字間距 */
        }

        /* LOGO 圖片樣式 */
        .navbar-custom .navbar-brand img {
            height: 40px; /* LOGO 高度 */
            max-width: 100%; /* 最大寬度 */
            object-fit: contain; /* 保持寬高比 */
        }

        /* 菜單項目基本樣式 */
        .navbar-custom .navbar-nav > li > a {
            color: #fff; /* 白色文字 */
            transition: background-color 0.3s ease; /* 背景色過渡效果 */
        }

        /* 菜單項目懸停和聚焦樣式 */
        .navbar-custom .navbar-nav > li > a:hover,
        .navbar-custom .navbar-nav > li > a:focus {
            background-color: rgba(255, 255, 255, 0.1); /* 半透明白色背景 */
            color: #fff; /* 保持白色文字 */
        }

        /* Navbar 圖示樣式 */
        .navbar-custom .navbar-nav > li > a i {
            margin-right: 8px; /* 圖示右邊距 */
            width: 20px; /* 圖示寬度 */
            text-align: center; /* 居中對齊 */
        }

        /* 行動化切換按鈕樣式 */
        .navbar-custom .navbar-toggle {
            border-color: rgba(255, 255, 255, 0.5); /* 半透明白色邊框 */
        }

        .navbar-custom .navbar-toggle .icon-bar {
            background-color: #fff; /* 白色條紋 */
        }

        /* Navbar 折疊區域樣式 */
        .navbar-custom .navbar-collapse {
            border-top: none; /* 移除頂部邊框 */
        }

        /* 行動化媒體查詢 - 小螢幕適應 */
        @@media (max-width: 767px) {
            .navbar-custom .navbar-nav {
                background-color: rgba(0, 0, 0, 0.1); /* 半透明黑色背景 */
                margin: 0; /* 移除邊距 */
            }
            .navbar-custom .navbar-nav > li > a {
                padding: 15px 20px; /* 增加內邊距 */
                border-bottom: 1px solid rgba(255, 255, 255, 0.1); /* 底部邊框 */
            }
        }
    </style>

