                    .Label(l => l.Text("社區福音行動(益人學苑)").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.CommunityFlower)
                    //.DataField("LastName")
                    .Label(l => l.Text("社區福音行動(恩朵協會)").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.IncubateCampaign)
                    //.DataField("LastName")
                    .Label(l => l.Text("培育營會行政同工").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

