                    .Label(l => l.Text("主日敬拜團(人聲)").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.WorshipInstrument)
