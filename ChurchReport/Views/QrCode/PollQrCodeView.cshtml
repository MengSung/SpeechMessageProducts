                   .Label(l => l.Text("週六兒主服事同工"))
                   .Editor(e => e
                       .CheckBox()
                       .Disabled(false)
                   );

                groupItems.AddSimpleFor(m => m.SundaydayChild)
                    //.DataField("LastName")
                    .Label(l => l.Text("主日兒主同工"))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.SundayNewFriend)
                    //.DataField("LastName")
                    .Label(l => l.Text("主日新人接待同工").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.DisplayPpt)
                    //.DataField("LastName")
                    .Label(l => l.Text("主日控台同工").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.WorshipVocal)
