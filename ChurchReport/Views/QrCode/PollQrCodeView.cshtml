                    .Label(l => l.Text("主日敬拜團(樂器)").Location(FormLabelLocation.Left))
                    .Editor(e => e
                        .CheckBox()
                        .Disabled(false)
                    );

                groupItems.AddSimpleFor(m => m.Instrument)
                    //.DataField("LastName")
