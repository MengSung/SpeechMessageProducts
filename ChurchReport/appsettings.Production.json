{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "MemoryLimits": {
    "MaxMemoryMB": 2048,
    "WarningMemoryMB": 1536,
    "MemoryCacheSizeMB": 512,
    "CompactionPercentage": 0.25
  },
  
  "ConnectionPool": {
    "MinPoolSize": 5,
    "MaxPoolSize": 30,
    "ConnectionTimeoutSeconds": 30,
    "IdleTimeoutMinutes": 10
  },
  
  "Session": {
    "IdleTimeoutMinutes": 30,
    "IOTimeoutSeconds": 30
  },
  
  "HealthCheck": {
    "IntervalSeconds": 60
  },
  
  "GCSettings": {
    "EnableGCMonitoring": true,
    "MonitoringIntervalMinutes": 10,
    "MaxGen2CollectionsPerHour": 5
  }
}
