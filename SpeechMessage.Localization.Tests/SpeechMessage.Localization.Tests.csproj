<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- 文件設定須早於 targets；命名例外由三條件集中規則處理，不加個別 NoWarn。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- 只複製已釘選的公共 CLDR，讓兩宿主以獨立 XML oracle 核對完整生成映射。 -->
    <None Include="../tools/I18nCheck/data/windowsZones.xml" Link="Fixtures/windowsZones.xml" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <ProjectReference Include="../SpeechMessage.Localization/SpeechMessage.Localization.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- R4 原始碼共用；Framework 測試宿主不啟動 MSBuild 子程序。 -->
    <Compile Include="../tests-shared/ArchitectureTests/*.cs" Link="ArchitectureTests/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
