<!--
檔案整體說明

目的與定位：定義自動化測試與契約驗證的MSBuild專案邊界，集中target、套件及專案參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net48；條件評估後的實際輸出以MSBuild為準。
專案參考包含Plugins與Workflows；後者使用Workflows別名避免原始碼連結的internal型別歧義；不能新增反向相依或將主機狀態引入純核心。
課程連結、設備、進階、收費與訊息情境嵌入Core測試的同份JSON，確保外殼逐欄比對不另建寬鬆期望。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <ProjectReference Include="../SpeechMessage.Dynamics.Plugins/SpeechMessage.Dynamics.Plugins.csproj" />
    <ProjectReference Include="../tools/LegacyGolden/PluginHarness/PluginHarness.csproj" />
    <PackageReference Include="Newtonsoft.Json" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Activities" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" PrivateAssets="all" />
    <ProjectReference Include="../SpeechMessage.Dynamics.Workflows/SpeechMessage.Dynamics.Workflows.csproj" Aliases="Workflows" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/messaging/*.json"
                      Link="Golden/messaging/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/fees/*.json"
                      Link="Golden/fees/%(Filename)%(Extension)" />
    <Compile Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/FeesGoldenFixture.cs"
             Link="FeesGoldenFixture.cs" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/weeklyreports/*.json"
                      Link="Golden/weeklyreports/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/attendance/*.json"
                      Link="Golden/attendance/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/lessonsequipment/*.json"
                      Link="Golden/lessonsequipment/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/lessonslink/*.json"
                      Link="Golden/lessonslink/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/lessonsprogression/*.json"
                      Link="Golden/lessonsprogression/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/Golden/Legacy/appointments/*.json"
                      Link="Golden/appointments/%(Filename)%(Extension)" />
    <Compile Include="../SpeechMessageProducts.GoodShepherd.Core.Tests/LessonLinkGoldenFixture.cs"
             Link="LessonLinkGoldenFixture.cs" />
  </ItemGroup>
</Project>
