<!--
檔案整體說明

目的與定位：定義 net10 主機共用層的 MSBuild 邊界，集中啟動守門、例外診斷註冊與
唯一診斷owner與相容轉接器的編譯設定。本基礎層只向Localization／Tenancy依賴，供主機與既有ToolUtility消費，不能反向參考產品主機、
Plugin 或金流產品。

主要功能與流程：
本檔只宣告套用至 SpeechMessage.Hosting 的目標框架、中央套件及專案參考。實際的
服務註冊、啟動驗證與 owner 生命週期由本專案的 C# 原始碼負責；組態值、request、
Session、tenant、credential 與外部連線不由此 MSBuild 檔保存或產生。

使用邊界與維護：
修改前須核對 SpeechMessage.Hosting.Tests、ChurchReport 組合根及方案架構測試。
套件版本由 Directory.Packages.props 管理；不得在此檔加入秘密、使用者輸入或會讓
net462／Plugin 反向取得 net10 主機能力的參考。建置與測試由方案 Release 驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpeechMessage.Hosting</RootNamespace>
    <AssemblyName>SpeechMessage.Hosting</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpeechMessage.Localization\SpeechMessage.Localization.csproj" />
    <ProjectReference Include="..\SpeechMessage.Tenancy\SpeechMessage.Tenancy.csproj" />
  </ItemGroup>
</Project>
