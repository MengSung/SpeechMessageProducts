<!--
檔案整體說明

目的與定位：定義net10主機的CRM連線、生命週期及相容外觀的MSBuild專案邊界，集中target、套件及專案參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net10.0；條件評估後的實際輸出以MSBuild為準。
例外診斷實作已抽至SpeechMessage.Hosting，舊型別以TypeForwardedTo保持組件相容；不得讓Hosting反向參考本工具。
專案參考包含SpeechMessage.Hosting.csproj、ToolUtility.Core.csproj、Line.Messaging.csproj、PowerPlatform.Dataverse.Client.csproj；不能新增反向相依或將主機狀態引入純核心。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ToolUtility</RootNamespace>
    <AssemblyName>ToolUtility</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA2200;CS0162;CS0169;CS8073</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Power Platform Dataverse Client -->
    
    <!-- Microsoft Extensions -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
    
    <!-- Microsoft Identity -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
    
    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" />
    
    <!-- System Libraries -->
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- 舊 SDK 的 Permissions 6 與 DirectoryServices 9 所需的組件版本衝突；明確統一至中央版本。 -->
    <PackageReference Include="System.Security.Permissions" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.ServiceModel.Primitives" />
    
    <!-- Windows-specific libraries -->
    <PackageReference Include="System.DirectoryServices" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Text.Encoding.CodePages" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeechMessage.Hosting\SpeechMessage.Hosting.csproj" />
    <ProjectReference Include="..\ToolUtility.Core\ToolUtility.Core.csproj" />
    <ProjectReference Include="..\Line.Messaging\Line.Messaging.csproj" />    
    <ProjectReference Include="..\PowerPlatform.Dataverse.Client\PowerPlatform.Dataverse.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ?????????? markdown ???A???O?d?b????? -->
    <None Include="???\**\*.md" />
  </ItemGroup>

</Project>
