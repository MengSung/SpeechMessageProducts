{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DynamicsControlPlane": "Server=localhost;Database=SpeechMessageDynamicsControlPlane;Integrated Security=true;Encrypt=true;TrustServerCertificate=true;Pooling=true;Min Pool Size=0;Max Pool Size=32;Load Balance Timeout=300;Connect Timeout=5;Application Name=SpeechMessage.Dynamics.Gateway"
  },
  "DynamicsHostCoordinator": {
    "CommandTimeoutSeconds": 5,
    "QuarantineSeconds": 180
  },
  "DynamicsGateway": {
    "WorkloadMappings": {
      "IIS APPPOOL\\ChurchReport": "church-report-service"
    }
  },
  "DynamicsWebApi": {
    // 對齊 ChurchReport CrmConnection 雲端機房（Organization=jesus）
    // 注意：這裡是 Web API root，不是 Organization.svc SOAP 端點。
    // 密碼請用環境變數 / 秘密庫參考，不要寫明文。
    "OrganizationBaseUri": "https://jesus.speechmessage.com.tw/",
    "OrganizationWebApiBaseUri": "https://jesus.speechmessage.com.tw/api/data/v8.2/",
    "CeVersion": "8.2",
    "AuthMode": "AdfsOAuth",
    "CredentialSource": "SecretReference",
    "SecretReference": "dynamics-jesus-prod-credential",
    "UserNameSecretName": "DYNAMICS_JESUS_PROD_USERNAME",
    "PasswordSecretName": "DYNAMICS_JESUS_PROD_PASSWORD",
    "DomainSecretName": "DYNAMICS_JESUS_PROD_DOMAIN",
    "AuthorityUri": "https://speechmessagests.speechmessage.com.tw/adfs",
    "ResourceUri": "https://jesus.speechmessage.com.tw/",
    "ClientId": "2ad88395-b77d-4561-9441-d0e40824f9bc",
    "AllowLocalDevPasswordGrant": false,
    "TimeoutSeconds": 30,
    "MaxConnectionsPerServer": 4,
    "MaxResponseBytes": 2097152,
    "Admission": {
      "ExpectedOrganizationId": "11111111-1111-1111-1111-111111111111",
      "AggregateMaxInFlight": 24,
      "MaximumRuntimeHosts": 6,
      "LocalQueueCapacity": 48,
      "MaxDispatchEnvelopeBytes": 65536,
      "QueueAdmissionTimeoutSeconds": 15,
      "MaxInFlightAndQueuedPerWorkload": 8,
      "AdmissionNamespaceId": "gateway-jesus-admission",
      "LeaseNamespaceId": "gateway-jesus-host-lease",
      "AdmissionEpoch": 1,
      "RuntimeHostSlotLeaseTtlSeconds": 120,
      "RuntimeHostSlotRenewalIntervalSeconds": 30,
      "RuntimeHostSlotExpiryFenceSeconds": 10,
      "MaximumOutboundWorkLifetimeSeconds": 35,
      "ShutdownDrainTimeoutSeconds": 45,
      "RequireDurableHostCoordinator": true
    }
  }
}
