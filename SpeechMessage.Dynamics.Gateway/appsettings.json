{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DynamicsWebApi": {
    // 對齊 ChurchReport CrmConnection 雲端機房（Organization=jesus）
    // 注意：這裡是 Web API root，不是 Organization.svc SOAP 端點。
    // 密碼請用環境變數 / 秘密庫參考，不要寫明文。
    "OrganizationBaseUri": "https://jesus.speechmessage.com.tw/",
    "OrganizationWebApiBaseUri": "https://jesus.speechmessage.com.tw/api/data/v9.1/",
    "CeVersion": "9.1",
    "AuthMode": "Windows",
    "CredentialSource": "HostIdentity",
    "SecretReference": "dynamics-jesus-prod-credential",
    "UserNameSecretName": "DYNAMICS_JESUS_PROD_USERNAME",
    "PasswordSecretName": "DYNAMICS_JESUS_PROD_PASSWORD",
    "DomainSecretName": "DYNAMICS_JESUS_PROD_DOMAIN",
    "TimeoutSeconds": 30,
    "MaxConnectionsPerServer": 4,
    "Admission": {
      "ExpectedOrganizationId": "11111111-1111-1111-1111-111111111111",
      "AggregateMaxInFlight": 24,
      "MaximumRuntimeHosts": 6,
      "LocalQueueCapacity": 48,
      "MaxDispatchEnvelopeBytes": 65536,
      "QueueAdmissionTimeoutSeconds": 15,
      "MaxInFlightAndQueuedPerWorkload": 8,
      "AdmissionNamespaceId": "gateway-jesus-admission",
      "LeaseNamespaceId": "gateway-jesus-host-lease",
      "RequireDurableHostCoordinator": false
    }
  }
}