<Project ToolsVersion="15.0" Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- ✅ 效能：本專案未註冊 AddRazorRuntimeCompilation，不需要保留編譯期中繼資料參考。
         設為 false 可讓 publish 不再輸出 refs\ 目錄與龐大的 .deps.json 編譯區段，
         縮短發佈時間與冷啟動時的相依解析成本。 -->
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <AssemblyName>SpeechMessageProducts.ChurchReport</AssemblyName>
    <RootNamespace>ChurchReport</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- ✅ 效能：移除 BuildInParallel=false，恢復 MSBuild 平行建置相依專案。
         本專案有 9 個 ProjectReference，序列化建置會浪費多核心資源。 -->
    <!-- 移除 RuntimeIdentifier，.NET 10 不支援 win7-x86 -->
    
    <!-- ✅ Phase 5.1: GC 優化設定 -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    
    <!-- 允許套件降級警告不影響建置 -->
    <NoWarn>$(NoWarn);NU1605;ASPDEPR005;CA1416;CA2200;CS0105;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0472;CS0618;CS0649;CS8073;CS8632;CS8981;CS1717;CS4014;MVC1000;SYSLIB0014;SYSLIB0021</NoWarn>
    
    <!-- ✅ Phase 5: .NET 10 效能優化設定 -->
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>
    <EnableAVX>true</EnableAVX>
    
    <!-- ✅ 啟用 Ready to Run 編譯，加速冷啟動 -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*;Views\**\*;Areas\**\Views;appsettings.json;appsettings.Production.json;web.config">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Compile Remove="文件\佈署規劃\**" />
    <EmbeddedResource Remove="文件\佈署規劃\**" />
    <None Remove="文件\佈署規劃\**" />
    <None Remove="Views\Home\BindingResultView.cshtml" />
    <None Remove="Views\Home\DedicationFeeAuditViewLine.cshtml" />
    <None Remove="Views\Home\DedicationInofView.cshtml" />
    <None Remove="Views\Home\DedicationView.cshtml" />
    <None Remove="Views\Home\DisplayErrorView.cshtml" />
    <None Remove="Views\Home\FeeManagerView.cshtml" />
    <None Remove="Views\Home\FeeView.cshtml" />
    <None Remove="Views\Home\HappyGroupWeeklyReport.cshtml" />
    <None Remove="Views\Home\IntegrateView.cshtml" />
    <None Remove="Views\Home\MultiGroupView.cshtml" />
    <None Remove="Views\Home\QualificationView.cshtml" />
    <None Remove="Views\Home\SchedulerView.cshtml" />
    <None Remove="Views\Home\VisitorCard.cshtml" />
    <None Remove="wwwroot\assets\images\永和堂牧養系統web_banner-01.jpg" />
    <None Remove="wwwroot\css\MasterDetail.css" />
    <None Remove="wwwroot\css\Site - 複製.css" />
    <None Remove="wwwroot\js\devextreme\devextreme-intl.min.js" />
    <None Remove="wwwroot\js\devextreme\localization\dx.messages.zh-tw.js" />
    <None Remove="wwwroot\js\FeeDataGridAjax.js" />
    <Content Include="bower.json" />
    <Content Include="Properties\launchSettings.json" />
  </ItemGroup>

  <!-- ============================================================================
       ✅ 效能：把從未被引用的靜態資產排除在建置與發佈輸出之外
       ============================================================================
       wwwroot 目前共約 202 MB，其中有 123 MB 是不會被任何頁面載入的檔案：

         *.bak       142 個檔案，約 73 MB
                     DevExtreme 主題 CSS 的備份副本（dx.carmine.css.bak 之類）。
                     沒有任何 View 或 CSS 引用它們。

         *.debug.js   6 個檔案，約 50 MB
                     DevExtreme 的未壓縮偵錯版（dx.all.debug.js 就有 16.8 MB）。
                     所有 View 引用的都是壓縮版 dx.all.js，沒有任何地方載入 debug 版。

       把這些排除可同時改善三件事：
         1. 發佈時間：dotnet publish 少複製 123 MB
         2. 佈署體積：上傳與磁碟佔用同步下降
         3. 靜態檔案中介層：目錄監看與檔案探查的項目數大幅減少

       ⚠️ 這只影響「輸出」，檔案仍然保留在原始碼與版本控制中。
       若日後真的需要偵錯版 DevExtreme，把對應的 Remove 註解掉即可。
       ============================================================================ -->
  <ItemGroup>
    <Content Remove="wwwroot\**\*.bak" />
    <Content Remove="wwwroot\**\*.debug.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExtreme.AspNet.Core" Version="23.1.5" />
    <PackageReference Include="DevExtreme.AspNet.Data" Version="5.1.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <!-- ✅ SixLabors.ImageSharp - 用於處理圖片 EXIF Orientation，修正直拍照片旋轉問題 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- .NET 10 使用框架引用，不需要明確的 AspNetCore 套件 -->
    <!--
    <PackageReference Include="Microsoft.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Routing" Version="2.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.Server.IIS" Version="2.2.6" />
    <PackageReference Include="Microsoft.AspNetCore.Server.IISIntegration" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Server.Kestrel" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0" />
    -->
    <!-- BrowserLink 在新版本中已不推薦使用 -->
    <!-- <PackageReference Include="Microsoft.VisualStudio.Web.BrowserLink.Loader" Version="14.1.0" /> -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <!-- DotNetCliToolReference 在 .NET Core 3.0+ 已被移除 -->
  <!--
  <ItemGroup>
    <DotNetCliToolReference Include="BundlerMinifier.Core">
      <Version>2.2.301</Version>
    </DotNetCliToolReference>
  </ItemGroup>
  -->
  <ItemGroup>
    <ProjectReference Include="..\Line.Messaging\Line.Messaging.csproj" />
    <ProjectReference Include="..\LineMessagingProcessor\LineMessagingProcessor.csproj" />
    <ProjectReference Include="..\LineMessagingProcessor.AspNetCore\LineMessagingProcessor.AspNetCore.csproj" />
    <ProjectReference Include="..\LineMessagingProcessor.Workflows\LineMessagingProcessor.Workflows.csproj" />
    <ProjectReference Include="..\ToolUtility\ToolUtility.csproj" />
    <ProjectReference Include="..\SpeechMessage.Payments\SpeechMessage.Payments.csproj" />
    <ProjectReference Include="..\SpeechMessage.Payments.AspNetCore\SpeechMessage.Payments.AspNetCore.csproj" />
    <ProjectReference Include="..\SpeechMessage.Payments.Workflows\SpeechMessage.Payments.Workflows.csproj" />
    <ProjectReference Include="..\LineMessagingProcessor.RichMenus\LineMessagingProcessor.RichMenus.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ToolUtility.Dataverse.Tests" />
    <InternalsVisibleTo Include="ChurchReport.MemberInfo.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Views\Dedication\" />
    <Folder Include="文件\中華採購協會\" />
    <Folder Include="文件\修正官網奉獻網頁\" />
  </ItemGroup>
  <!-- ✅ 已移除硬編碼絕對路徑的 <Reference Include="DevExtreme.AspNet.Core">。
       同一組件已由上方的 <PackageReference Include="DevExtreme.AspNet.Core" Version="23.1.5" /> 解析，
       原本的 HintPath 指向特定機器的 NuGet 全域快取，會造成：
         1. 組件被解析兩次（PackageReference + 直接 Reference），增加還原與編譯的解析成本
         2. 專案綁死單一開發機，其他機器或 CI 上路徑不存在
       DevExtreme.AspNet.Core 23.1.5 的 lib/net6.0 與 net10.0 相容，PackageReference 可正常解析。 -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>
  <Target Name="PostpublishScript" AfterTargets="Publish" Condition=" '$(IsCrossTargetingBuild)' != 'true' " />
  <ProjectExtensions>
    <VisualStudio>
      <UserProperties DismissedDevExtremeVersion="" />
    </VisualStudio>
  </ProjectExtensions>
</Project>
