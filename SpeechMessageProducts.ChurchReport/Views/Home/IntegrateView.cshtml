@*
    ===================================================================
    好牧人 - 綜合報表檢視頁面 (IntegrateView)
    ===================================================================
    資料發布與生命週期：Controller 只傳入 detached 週報；Grid 使用資料庫 PresentRecordId
    作 row key。日期請求與 Grid refresh 必須由有界 coordinator 管理，舊 response callback
    不得導向或改寫新世代；pagehide 時必須 abort transport 並釋放 callback／DOM closure。
    本頁不得保存跨 Session、跨使用者或跨租戶的 mutable response data。
*@
@using ChurchReport.Models
@using Microsoft.Extensions.Configuration
@model ChurchReport.Models.ListSmallGroupWeeklyReport
@inject IConfiguration Configuration
@{
    // DevExtreme 圖表以 SVG 屬性 (stroke/fill) 套色，無法解析 CSS 變數 var(--color-secondary)，
    // 會造成曲線 (spline) 與資料點完全不顯示。因此在伺服器端依目前主題解析出實際色碼
    // (與 Views/Authentication/Login.cshtml 相同作法)，讓圖表仍可隨主題變色又能正常繪製。
    var chartThemeName = Configuration["Theme:Current"]?.Trim();
    var chartSecondaryColor = Configuration[$"Theme:Presets:{chartThemeName}:Secondary"] ?? "#4f8df1";
    var chartTextColor = Configuration[$"Theme:Presets:{chartThemeName}:Text"] ?? "#1d2a44";
}

@* 必須在 DateBox 與 Grid 事件可能觸發前載入；模組不保存 rows、Session 或 credential。 *@
<script src="~/js/collection-load-coordinator.js"></script>
<script>
    // 此 coordinator 只屬於目前完整頁面。日期切換完成會導向新頁，pagehide 會先 dispose；
    // 不放入 sessionStorage/localStorage，也不在跨頁 static collection 保存使用者或回應資料。
    var integrateDateLoadCoordinator = window.CollectionLoadCoordinator
        .createCollectionLoadCoordinator();

    /**
     * 以單一 active request 與 generation token 執行日期切換。
     * 新操作會 abort 舊 jqXHR；即使舊 success/error 晚到，只有最新世代可導向或顯示錯誤。
     */
    function requestIntegrateDateChange(selectedDate) {
        var loadPanel = $("#loadPanel").dxLoadPanel("instance");
        if (loadPanel) {
            loadPanel.show();
        }

        integrateDateLoadCoordinator.runLoad(function sendCurrentDateRequest() {
            return $.ajax({
                url: '@Url.Action("UpdateIntegrateDate", "SmallGroup")',
                data: { SelectedDate: getODataLocalDateFilter(selectedDate) },
                type: 'GET'
            });
        }).then(function publishCurrentDateResponse(response) {
            if (loadPanel) {
                loadPanel.hide();
            }
            if (response.success) {
                window.location.href = "/SmallGroup/IntegrateView/" + response.ActiveListId;
            } else {
                ShowToast(response.message || "日期更新失敗", "error", 5000);
            }
        }).catch(function handleCurrentDateFailure(error) {
            // 過期世代屬預期取消，不得隱藏新世代 load panel 或顯示舊錯誤。
            if (error && error.isStaleGeneration) {
                return;
            }
            if (loadPanel) {
                loadPanel.hide();
            }
            ShowToast("日期更新失敗: " + (error && error.message ? error.message : "網路錯誤"), "error", 5000);
        });
    }

    /**
     * 頁面離開時確定釋放日期 transport 與 pending callback；once 避免 handler 重複執行。
     */
    function disposeIntegratePageLoadCoordinator() {
        if (integrateDateLoadCoordinator) {
            integrateDateLoadCoordinator.dispose();
            integrateDateLoadCoordinator = null;
        }
    }
    window.addEventListener('pagehide', disposeIntegratePageLoadCoordinator, { once: true });
</script>

@* 小組狀態標題 *@
<div class="group-status-header">
    <div class="status-title @(Model.SundayPrayers.Year != 2000 ? "active" : "inactive")">
        <h4>@(Model.ListEntityName + (Model.SundayPrayers.Year == 2000 ? "尚未回報" : ""))</h4>
    </div>
</div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveIntegrate" asp-controller="SmallGroup" method="post">
    <div id="all-section" class="main-content-wrapper">

        @* 小組長專用圖表 *@
        @if (Model.LoginType == "小組長")
        {
            <div id="smallgroupchart" class="chart-section">
                @(Html.DevExtreme().Chart()
                    .ID("smallgroupchart")
                    .Export(e => e.Enabled(false))
                    .Size(s => s.Height(220))
                    .CommonSeriesSettings(s => s
                        .ArgumentField("SundayDate")
                        .Type(SeriesType.Spline)
                        .HoverMode(ChartSeriesHoverMode.AllArgumentPoints)
                        .SelectionMode(ChartSeriesSelectionMode.AllArgumentPoints)
                        .Label(l => l.Visible(true).Format(f => f.Type(Format.FixedPoint).Precision(0)).Font(v => v.Size(10)))
                    )
                    .Series(s => {
                        s.Add().ValueField("SundayNumber").Name("主日人數").Color(chartSecondaryColor);
                        s.Add().ValueField("SmallNumber").Name("小組人數").Color("#d4a017");
                    })
                    .ValueAxis(a => a.Add().Title(t => t.Text("人數")).Position(Position.Left))
                    .Tooltip(t => t.Enabled(true))
                    .Title(t => t.Text("聚會人數").Font(f => f.Size(12).Weight(300).Color(chartTextColor)).Margin(m => m.Top(5).Bottom(5)))
                    .Legend(l => l.VerticalAlignment(VerticalEdge.Bottom).HorizontalAlignment(HorizontalAlignment.Center))
                    .OnPointClick(@<text>function(e) { e.target.select(); }</text>)
                    .DataSource(d => d.WebApi().Controller("SmallGroup").LoadAction("GetChartDataList").Key("WeeklyReportEntityId").LoadParams(new { WeeklyReportId = @ViewBag.ListId }))
                )
            </div>
        }

        @* 週期時間 *@  
        <div class="period-display">@Model.SundayPeriod</div>

        @* 控制面板 *@
        <div class="control-panel">
            <div class="control-wrapper">
                @* 日期選擇 *@
                <div class="date-section">
                    <label class="date-label">小組日期</label>
                    <div class="date-input">
                        @(Html.DevExtreme().DateBoxFor(m => m.SundayPrayers)
                            .Type(DateBoxType.Date)
                            .Value(Model.SundayPrayers)
                            .Width(200)
                            .DisplayFormat("yyyy/M/d")
                            .OnChange("OnDateboxChange")
                            .CalendarOptions(k => k.FirstDayOfWeek(0))
                            .OnValueChanged(@<text>
                                function(arg) {
                                    requestIntegrateDateChange(arg.value);
                                }
                            </text>)
                        )

                    </div>
                </div>

                @* 上傳按鈕 *@
                <div class="upload-section">
                    <div class="upload-button-container">
                        @if (Model.LoginType == "小組長")
                        {
                            @(Html.DevExtreme().Button()
                                .Text("上傳").Height(40).Width(78).Icon("check")
                                .Type(ButtonType.Success)
                                .ID("save-button")
                                .UseSubmitBehavior(false)
                                .OnClick(@<text>
                                    function() {
                                        // ✅ 儲存所有 Grid 的編輯資料
                                        var grids = {
                                            small: $("#SmallGroupgridContainer").length ? $("#SmallGroupgridContainer").dxDataGrid("instance") : null,
                                            newPerson: $("#NewPersonGridContainer").length ? $("#NewPersonGridContainer").dxDataGrid("instance") : null
                                        };
                                        var button = $("#save-button").dxButton("instance");

                                        // ✅ 顯示載入面板（短暫）
                                        $("#loadPanel").dxLoadPanel("instance").show();
                                        button.option("disabled", true);

                                        var saveTasks = Object.values(grids)
                                            .filter(function(grid) { return grid && grid.saveEditData; })
                                            .map(function(grid) { return Promise.resolve(grid.saveEditData()); });

                                        Promise.all(saveTasks)
                                            .then(function() {
                                                // ✅ 等待所有 Grid 編輯真正送回伺服器後，再發送總上傳請求
                                                $.ajax({
                                                    url: '@Url.Action("SaveIntegrate", "SmallGroup")',
                                                    data: {
                                                        WeeklyReportData: $("#WeeklyReportTextData").dxTextArea("instance").option('text'),
                                                        CheckBox: $("#CheckBoxId").length ? $("#CheckBoxId").dxCheckBox("instance").option("value") : false
                                                    },
                                                    type: 'POST',
                                                    timeout: 3000, // ✅ 設定 3 秒超時，不讓使用者等太久
                                                    success: function(response) {
                                                        $("#loadPanel").dxLoadPanel("instance").hide();
                                                        button.option("disabled", false);
                                                        ShowToast(response.message || "資料已開始上傳，將在背景處理", "success", 3000);

                                                        Object.values(grids).forEach(function(grid) {
                                                            if (grid && grid.refresh) {
                                                                if (typeof requestWeeklyReportGridRefresh === 'function') {
                                                                    requestWeeklyReportGridRefresh(grid);
                                                                } else {
                                                                    grid.refresh();
                                                                }
                                                            }
                                                        });
                                                    },
                                                    error: function(xhr, status, error) {
                                                        $("#loadPanel").dxLoadPanel("instance").hide();
                                                        button.option("disabled", false);

                                                        if (status === "timeout") {
                                                            ShowToast("資料已送出，正在背景上傳中...", "info", 3000);

                                                            Object.values(grids).forEach(function(grid) {
                                                                if (grid && grid.refresh) {
                                                                    if (typeof requestWeeklyReportGridRefresh === 'function') {
                                                                        requestWeeklyReportGridRefresh(grid);
                                                                    } else {
                                                                        grid.refresh();
                                                                    }
                                                                }
                                                            });
                                                        } else {
                                                            var errorMsg = "上傳失敗";
                                                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                                                errorMsg = xhr.responseJSON.message;
                                                            } else if (error) {
                                                                errorMsg += ": " + error;
                                                            }
                                                            ShowToast(errorMsg, "error", 5000);
                                                        }
                                                    }
                                                });
                                            })
                                            .catch(function(error) {
                                                $("#loadPanel").dxLoadPanel("instance").hide();
                                                button.option("disabled", false);
                                                ShowToast("請先完成表格儲存後再上傳", "error", 5000);
                                                console.error("❌ [IntegrateView] Grid 儲存失敗:", error);
                                            });
                                    }
                                </text>)
                            )
                        }
                        else
                        {
                            @(Html.DevExtreme().Button()
                                .Text("上傳").Height(40).Width(78).Icon("check")
                                .Type(ButtonType.Success)
                                .ID("save-button")
                                .UseSubmitBehavior(false)
                                .OnClick(@<text>
                                    function() {
                                        var grid = $("#IndividualGridContainer").length ? $("#IndividualGridContainer").dxDataGrid("instance") : null;
                                        var button = $("#save-button").dxButton("instance");

                                        if (grid && grid.saveEditData) grid.saveEditData();

                                        $("#loadPanel").dxLoadPanel("instance").show();
                                        button.option("disabled", true);

                                        $.ajax({
                                            url: '@Url.Action("SavePersonReport", "Personal")',
                                            data: { WeeklyReportData: "" },
                                            type: 'POST',
                                            timeout: 3000,
                                            success: function(response) {
                                                $("#loadPanel").dxLoadPanel("instance").hide();
                                                button.option("disabled", false);
                                                ShowToast(response.message || "資料已開始上傳", response.status == 1 ? "success" : "error", response.status == 1 ? 2000 : 5000);
                                            },
                                            error: function(xhr, status, error) {
                                                $("#loadPanel").dxLoadPanel("instance").hide();
                                                button.option("disabled", false);
                                                
                                                if (status === "timeout") {
                                                    ShowToast("資料已送出，正在背景上傳中...", "info", 3000);
                                                } else {
                                                    ShowToast("上傳失敗: " + error, "error", 5000);
                                                }
                                            }
                                        });
                                    }
                                </text>)
                            )
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Toast 通知元件 *@
        <div class="toast-components">
            @(Html.DevExtreme().Toast().ID("Toast")
                .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                .CloseOnOutsideClick(true).DisplayTime(2000).MaxWidth(300))
            @(Html.DevExtreme().Toast().ID("ToastReUpload")
                .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                .Message("請再按一次上傳鈕!").DisplayTime(5000).Type(ToastType.Error).MaxWidth(500))
            @(Html.DevExtreme().Toast().ID("SelectDateToast")
                .Position(p => p.At(HorizontalAlignment.Center, VerticalAlignment.Center).Offset(0, 50))
                .Message("日期格式錯誤，格式範例: 2018/6/5").DisplayTime(5000).Type(ToastType.Error).MaxWidth(300))
        </div>

        @* 載入面板 *@
        <div class="load-panel-component">
            @(Html.DevExtreme().LoadPanel().ID("loadPanel")
                .ShadingColor("rgba(0,0,0,0.4)")
                .Position(p => p.Of("#all-section"))
                .Visible(false).ShowIndicator(true).ShowPane(true).Shading(true)
                .CloseOnOutsideClick(false).Message("更新資料中...")
                .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing))))
        </div>

        @* 幸福小組週次主題選擇 *@
        @if (Model.GroupType == "幸福小組")
        {
            <div class="happy-group-selection">
                <div class="section-title"><h5>幸福小組週次及主題:</h5></div>
                <div class="selection-wrapper">
                    <div class="week-index-selector">
                        @(Html.DevExtreme().SelectBox().ID("HappyWeekIndex").Value(Model.HappyWeekIndex)
                            .DataSource(new string[] { "第一週", "第二週", "第三週", "第四週", "第五週", "第六週", "第七週", "第八週", "第九週", "第十週" })
                            .Width(150)
                            .OnValueChanged(@<text>
                                function(arg) {
                                    $("#loadPanel").dxLoadPanel("instance").show();
                                    $.ajax({
                                        url: '@Url.Action("UpdateHappyWeekIndex", "SmallGroup")',
                                        data: { HappyWeekIndex: arg.value },
                                        type: 'GET',
                                        success: function() { $("#loadPanel").dxLoadPanel("instance").hide(); },
                                        error: function(xhr, status, error) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                            ShowToast("更新失敗: " + error, "error", 5000);
                                        }
                                    });
                                }
                            </text>))
                    </div>
                    <div class="topic-selector">
                        @(Html.DevExtreme().SelectBox().ID("HappyWeekTopic").Value(Model.HappyWeekTopic)
                            .DataSource(new string[] { "", "預備週", "真幸福", "真相大白", "萬世巨星", "幸福連線", "當上帝來敲門", "十字架的勝利", "釋放與自由", "幸福的教會" })
                            .Width(150)
                            .OnValueChanged(@<text>
                                function(arg) {
                                    $("#loadPanel").dxLoadPanel("instance").show();
                                    $.ajax({
                                        url: '@Url.Action("UpdateHappyWeekTopic", "SmallGroup")',
                                        data: { HappyWeekTopic: arg.value },
                                        type: 'GET',
                                        success: function() { $("#loadPanel").dxLoadPanel("instance").hide(); },
                                        error: function(xhr, status, error) {
                                            $("#loadPanel").dxLoadPanel("instance").hide();
                                            ShowToast("更新失敗: " + error, "error", 5000);
                                        }
                                    });
                                }
                            </text>))
                    </div>
                </div>
            </div>
        }

        @* 資料網格 *@
        <div class="data-grid-section">
            @if (Model.LoginType == "小組長")
            {
                if (Model.GroupType == "一般小組")
                {
                    @Html.Partial("~/Views/Home/_GeneralGroupGrids.cshtml", Model)
                }
                else
                {
                    @Html.Partial("~/Views/Home/_HappyGroupGrid.cshtml", Model)
                }
            }
            else
            {
                @Html.Partial("~/Views/Home/_IndividualReportGrid.cshtml", Model)
            }
        </div>

        @* 小組日誌 (僅小組長) *@
        @if (Model.LoginType == "小組長")
        {
            <div class="journal-section">
                <div class="section-title"><h5>小組日誌:</h5></div>
                @(Html.DevExtreme().TextArea().ID("WeeklyReportTextData").Value(Model.WeeklyReportData).Height(200))
                
                <div class="section-title"><h5>小組出席紀錄:</h5></div>
                @(Html.DevExtreme().TextArea().ID("WeeklyReportTextAnalysis").Value(Model.WeeklyReportAnalysis).Height(350).Disabled(true))
            </div>
        }

    </div>
</form>

@* JavaScript 函式 *@
<script>
    // DevExtreme DataGrid 函式
    function moveEditColumnToLeft(dataGrid) {
        dataGrid.columnOption("command:edit", { visibleIndex: -1, width: 50 });
    }
    
    function cell_prepared(e) {
        if (e.rowType === "data" && e.column.command === "edit") {
            var isEditing = e.row.isEditing, $links = e.cellElement.find(".dx-link");
            $links.text("");
            if (isEditing) {
                $links.filter(".dx-link-save").addClass("dx-icon-save");
                $links.filter(".dx-link-cancel").addClass("dx-icon-revert");
            } else {
                $links.filter(".dx-link-edit").addClass("dx-icon-edit");
                $links.filter(".dx-link-delete").addClass("dx-icon-trash");
            }
        }
    }

    // 日期處理函式
    function OnDateboxChange(e) {
        if (e.component._$validationMessage == null) {
            UploadDateFormat = "格式正確";
        } else {
            UploadDateFormat = "格式錯誤";
            $("#SelectDateToast").dxToast("instance").show();
        }
    }

    function getODataLocalDateFilter(date) {
        if (date == null) date = new Date();
        var month = (date.getMonth() + 1).toString();
        var day = date.getDate().toString();
        return date.getFullYear() + "/" + month + "/" + day;
    }

    // 載入面板函式
    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }

    function button_click() { getLoadPanelInstance().show(); }
    function loadPanel_shown(e) { }
    function loadPanel_hidden() { }

    // AJAX 事件處理
    function SaveIntegrateWeeklyReport(arg) { getLoadPanelInstance().show(); }
    function onBegin() { }
    function onSuccess(data) {
        getLoadPanelInstance().hide();
        DevExpress.ui.notify(data.message, data.status == 1 ? "success" : "error", data.status == 1 ? 2000 : 5000);
    }
    function onComplete(data) { }

    // 工具函式
    function ShowToast(message, type, displayTime) {
        var toast = $("#Toast").dxToast("instance");
        toast.option({ message: message, type: type, displayTime: displayTime, 'white-space': 'pre-line', closeOnClick: true });
        toast.show();
    }

    function OnRowSelectionChanged(selectedItems) { }
    function OnEditorPrepared(options) { }

    // 全域變數
    var DataUploadStatus = "尚未上傳喔!";
    var UploadDateFormat = "格式正確!";

    // DevExtreme 本地化
    var dictionary = {
        "zh-tw": {
            "dxScheduler-switcherAgenda": "會議內容",
            "Month": "月",
            "Subject": "主題",
            "Company": "Company",
            "Amount": "Amount",
            "PaymentDate": "Payment Date"
        }
    };
    
    DevExpress.localization.loadMessages(dictionary);
    DevExpress.localization.locale(getLocale());

    function changeLocale(data) {
        sessionStorage.setItem("locale", data.value);
        document.location.reload();
    }

    function getLocale() {
        sessionStorage.setItem("locale", 'zh-tw');
        return sessionStorage.getItem("locale") || "tw";
    }
</script>

