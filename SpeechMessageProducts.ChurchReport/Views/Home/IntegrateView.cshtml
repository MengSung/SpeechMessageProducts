@* 樣式 *@
<style>
    /* ===== 基本樣式 ===== */
  /* 小組狀態標題 */
    .group-status-header { margin-bottom: 20px; }
    .status-title { 
        padding: 10px; 
   border-radius: 5px; 
        text-align: center; 
    }
    .status-title.active {
        color: var(--color-primary);
     font-weight: bold; 
    }
    .status-title.inactive { 
        color: var(--color-primary);
        background-color: var(--color-row-hover);
        font-weight: bold; 
    }

    /* 主容器 */
    .main-content-wrapper { 
        height: 100%; 
        width: 100%; 
        overflow: hidden; 
    }

    /* 圖表區域 */
    .chart-section { margin-bottom: 20px; }

    /* 週期時間顯示 - 響應式設計 */
    .period-display {
        font-size: 100%; 
        color: #fff; 
        text-align: left; 
        background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-secondary) 100%);
        font-weight: bold; 
        padding: 10px; 
    margin: 10px 0; 
        border-radius: 3px; 
        width: 100%;
        box-sizing: border-box;
        word-wrap: break-word;
      overflow-wrap: break-word;
    }

    /* ===== 控制面板 ===== */
    /* 控制面板容器 */
    .control-panel {
        margin: 20px 0; 
        padding: 15px; 
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 5px;
        box-sizing: border-box;
    }
    /* 永遠保持同一排，不換行 */
    .control-wrapper { 
        display: flex; 
        align-items: center; 
        gap: 8px; 
        flex-wrap: nowrap;
        width: 100%;
        box-sizing: border-box;
    }

    /* 日期選擇區域 - 可縮小以讓上傳按鈕保持可見 */
    .date-section { 
        display: flex; 
        align-items: center; 
        gap: 6px; 
        flex: 1 1 0;
        min-width: 0;
        overflow: hidden;
    }
    /* 標籤固定不縮小 */
    .date-label {
        font-size: 100%; 
        color: #fff; 
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
        font-weight: bold; 
        white-space: nowrap;
        flex-shrink: 0;
        padding: 5px 10px; 
        border-radius: 3px; 
    }
    /* 日期輸入框自動佔滿剩餘空間並可縮小 */
    .date-input { 
        flex: 1 1 0;
        min-width: 0;
        overflow: hidden;
    }
    /* 覆蓋 DevExtreme 產生的固定寬度 inline style，使日期框可伸縮 */
    .date-input .dx-datebox,
    .date-input .dx-widget { 
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
    }

    /* 上傳按鈕區域 - 固定大小，永不被擠壓 */
    .upload-section { 
        flex: 0 0 auto;
        flex-shrink: 0;
    }
    .upload-button-container { text-align: center; }
    .upload-button-container #save-button.dx-button.dx-button-success {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
        border-color: var(--color-primary);
        color: #fff;
        border-radius: 6px;
    }
    .upload-button-container #save-button.dx-button.dx-button-success:hover,
