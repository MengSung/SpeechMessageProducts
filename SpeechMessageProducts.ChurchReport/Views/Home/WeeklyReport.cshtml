@*
    檔案整體說明

    目的與定位：呈現週報資料與分析內容，依WeeklyReportViewModel決定可見區塊及操作。

    主要功能與流程：
    畫面輸入採用 ChurchReport.ViewModels.WeeklyReportViewModel，欄位語意須與控制器組裝的模型一致。
    本頁引用的控制器／動作包含 SaveWeeklyReport；實際網址及參數以頁內設定為準。
    元件事件交給 SaveWeeklyReport、loadPanel_shown、loadPanel_hidden，維護時須一併核對宣告、載入順序與元件ID。

    使用邊界與維護：畫面僅呈現目前請求取得的資料；使用者輸入與元件傳回值仍須在伺服器驗證。
    修改模型、元素ID、路由或callback時，須同步檢查引用此頁的父頁／控制器；非同步回應不能覆寫較新畫面狀態。
    本段使用Razor註解，編譯後不會將維護說明或內部路徑傳到瀏覽器。
*@
@model ChurchReport.ViewModels.WeeklyReportViewModel

<div class="long-title"><h3>小組日誌</h3></div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SaveWeeklyReport" asp-controller="Home" method="post">
    <div class="dx-field">

        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("上傳").Height(50).Width(80).Icon("check")
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                //.ValidationGroup()
                //.Width(60)

                .OnClick("SaveWeeklyReport")

                //.OnClick(@<text>
                //function(data) {
                //
                //        $.ajax({
                //            url: '@Url.Action("SaveNewPerson", "Home")',
                //            data: { aNewPerson: Model.FormData.Notes.Value },
                //            type: 'POST', //POST if you want to save, GET if you want to fetch data from server
                //            success: function (obj)
                //            {
                //                $("#toast").dxToast("instance").show();
                //            },
                //
                //            error: function (obj)
                //            {
                //                //alert('Something happened');
                //            }
                //
                //        });
                //}
                //</text>)
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            //.OnShown("loadPanel_shown")
            //.OnHidden("loadPanel_hidden")
            )

        </div>

    </div>
    <div id="form-container">
        @(Html.DevExtreme().Form()
        .ID("form")
        .LabelLocation(FormLabelLocation.Top)
        .ColCount(1)
        .Items(items =>
        {
            items.AddSimple()
                .ColSpan(2)
                //.Label(l => l.Text("小組日誌001").Visible(true))
                .Label(l => l.Text("小組日誌").Visible(true))
                .DataField("WeeklyReportData")
                .Editor(e => e
                    .TextArea()
                    .Placeholder("請輸入小組日誌，離開或是切換網頁前記得按上傳鈕")
                    .Height(250)
                );
            items.AddSimple()
                .ColSpan(2)
                .Label(l => l.Text("小組日誌002").Visible(true))
                .DataField("WeeklyReportData")
                .Visible(Model.DisplayFlag)
                .Editor(e => e
                    .TextArea()
                    .Placeholder("請輸入小組日誌，離開或是切換網頁前記得按上傳鈕")
                    .Height(250)
                );
            items.AddSimple()
                .ColSpan(2)
                .Label(l => l.Text("小組日誌003").Visible(true))
                .DataField("WeeklyReportData")
                .Visible(Model.DisplayFlag)
                .Editor(e => e
                    .TextArea()
                    .Placeholder("請輸入小組日誌，離開或是切換網頁前記得按上傳鈕")
                    .Height(250)
                );
            items.AddSimple()
                .ColSpan(2)
                .Label(l => l.Text("小組出席紀錄").Visible(true))
                .DataField("WeeklyReportAnalysis")
                .Editor(e => e
                    .TextArea()
                    .ReadOnly(true)
                    .Disabled(false)
                    .Height(350)
                );

        })
        .OnContentReady(@<text>
        function(e) {
        e.component.validate();
        }
        </text>)
        .FormData(Model)
        )
    </div>
</form>
