@using System.Linq
@using ChurchReport.Models
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model DonationPaymentFormModel

@{
    ViewBag.Title = "線上奉獻 - 好牧人";

    // 金流提供商：高鉅金流只支援信用卡，沒有記憶卡片與定期定額。
    var payProvider = Configuration["PAY_PROVIDER"] ?? "永豐金流";
    var isMyPay = payProvider == "高鉅金流";
    string[] payWayOptions = isMyPay
        ? new[] { "信用卡" }
        : new[] { "信用卡", "ATM轉帳/匯款", "信用卡定期定額(每個月)", "LinePay", "行動支付" };

    // 教會聯絡資訊（appsettings.json: ChurchInfo）
    var churchAddress = Configuration["ChurchInfo:Address"] ?? "桃園市楊梅區三民路二段157號";
    var churchPhone = Configuration["ChurchInfo:Phone"] ?? "03-4316679";
    var churchEmail = Configuration["ChurchInfo:Email"] ?? "mengsunghu@gmail.com";
    var churchTaxId = Configuration["ChurchInfo:TaxId"] ?? "13054485";
    var churchContactPerson = Configuration["ChurchInfo:ContactPerson"] ?? "胡夢嵩弟兄";

    var savedCards = isMyPay ? new List<CreditCard>() : (Model.CreditCardList ?? new List<CreditCard>());
    var recurringBookings = isMyPay ? new List<DedicationBooking>() : (Model.DedicationBookingList ?? new List<DedicationBooking>());

    // 前端需要的資料一次序列化成 JSON；Json.Serialize 會跳脫 HTML 特殊字元，可安全放進 script。
    var pageData = new
    {
        categories = Model.DedicationCategoryList ?? new List<string>(),
        specialItems = Model.SpecialCategoryArray ?? new List<string>(),
        missionTargets = Model.OtherCategoryArray ?? new List<string>(),
        payWays = payWayOptions,
        isMyPay = isMyPay,
        // 一次最多幾個類別：與伺服器驗證相同（永豐 Param1 最多放 7 張收費單 Id）。
        maxLines = ChurchReport.Services.DonationLineItemNormalizer.MaxLines,
        cards = savedCards.Select(card => new
        {
            token = card.CCToken ?? "",
            number = card.CreditCardNumber ?? "",
            expire = card.ExpireDate ?? ""
        }).ToList(),
        selectedCard = Model.SelectedCreditCard ?? "",
        bookings = recurringBookings.Select(booking => new
        {
            id = booking.EntityId ?? "",
            category = booking.DedicationCategory ?? "",
            status = booking.DedicationBookingStatus ?? "",
            amount = booking.AmountPerStage ?? "",
            totalStages = booking.TotalStages ?? "",
            paidPeriod = booking.PaidPeriod ?? "",
            start = booking.StartDate ?? "",
            end = booking.EndDate ?? ""
        }).ToList(),
        yearStart = new DateTime(DateTime.Today.Year, 1, 1).ToString("yyyy-MM-dd"),
        today = DateTime.Today.ToString("yyyy-MM-dd")
    };
}

<!-- ==================== 頁面頭部 ==================== -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link rel="shortcut icon" href="~/assets/images/logo4.png" type="image/x-icon">
    <link href="~/css/devextreme/dx.generic.custom-scheme.css" rel="stylesheet">
    <link href="~/css/Gallery.css" rel="stylesheet">
    <link href="~/css/WeeklyReport.css" rel="stylesheet">
    <link href="~/css/Scheduler.css" rel="stylesheet">
    <link href="~/css/Site.css" rel="stylesheet">
    <!-- 奉獻頁字型：Manrope（數字與拉丁字）＋ Noto Sans TC（中文）；載入失敗時退回系統字型 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght%40500;600;700;800&amp;family=Noto+Sans+TC:wght%40400;500;700&amp;display=swap">
</head>

<style>
  /* ==================== 奉獻頁設計系統（gv-*） ====================
     版面依 2026-09-14 奉獻流程原型：奉獻者標題列 → 我要奉獻／奉獻清單分頁 →
     1 奉獻內容（常用優先／完整清單／逐筆新增）→ 2 付款方式 → 3 確認與送出 → 參考資訊。
     一律使用 gv- 前綴，避免與 Bootstrap（.row、.card、.btn）或站台樣式互相覆蓋。
     對話框與提示會在載入時移到 body 底下，所以設計變數同時定義在 .gv-layer。 */
  .gv-page,
  .gv-layer {
    --gv-ground: #f4f3f9;
    --gv-card: #ffffff;
    --gv-card-2: #f7f6fb;
    --gv-ink: #22243a;
    --gv-ink-2: #5b5d75;
    --gv-muted: #8a8ba3;
    --gv-line: #e4e3ee;
    --gv-line-2: #cfcde0;
    --gv-brand: #6b4fc9;
    --gv-brand-soft: #efeafc;
    --gv-teal: #159a8b;
    --gv-teal-soft: #e2f4f1;
    --gv-teal-ink: #0f7a6e;
    --gv-go: #25a35f;
    --gv-go-ink: #ffffff;
    --gv-warn: #b8501a;
    --gv-warn-soft: #fdeee6;
    --gv-danger: #c73b3b;
    --gv-focus: #6b4fc9;
    --gv-shadow: 0 1px 2px rgba(34, 36, 58, 0.06), 0 8px 24px rgba(34, 36, 58, 0.07);
    --gv-donor-grad: linear-gradient(100deg, #12a294, #3aafc4);
    font-family: "Manrope", "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: var(--gv-ink);
    -webkit-font-smoothing: antialiased;
  }

  .gv-page {
    background: var(--gv-ground);
    margin-left: -20px;
    margin-right: -20px;
    padding: 12px 20px 36px;
    min-height: 100vh;
  }

  .gv { max-width: 980px; margin: 0 auto; }

  .gv-page *, .gv-page *::before, .gv-page *::after,
  .gv-layer, .gv-layer *, .gv-layer *::before, .gv-layer *::after { box-sizing: border-box; }
  /* 基礎重設用 :where() 讓特異度只有一個 class，後面的元件樣式（.gv-add、.gv-cta、.gv-sub…）才能正常覆蓋顏色與間距；
     同時仍高於 Bootstrap reboot 的元素選擇器。 */
  .gv-page :where(button, input, select, textarea),
  .gv-layer :where(button, input, select, textarea) { font: inherit; color: inherit; letter-spacing: normal; }
  .gv-page :where(button), .gv-layer :where(button) { cursor: pointer; }
  .gv-page :focus-visible, .gv-layer :focus-visible { outline: 2px solid var(--gv-focus); outline-offset: 2px; }
  .gv-page [hidden], .gv-layer[hidden], .gv-layer [hidden] { display: none !important; }
  .gv-page :where(h2, h3, h4), .gv-layer :where(h2, h3, h4) { margin: 0; color: inherit; font-family: inherit; text-wrap: balance; }
  .gv-page :where(p, ul), .gv-layer :where(p, ul) { margin: 0; }
  .gv-page :where(label), .gv-layer :where(label) { margin: 0; }
  html.gv-lock, html.gv-lock body { overflow: hidden; }

  .gv-num { font-variant-numeric: tabular-nums; }
  .gv-ico { width: 18px; height: 18px; flex: none; color: var(--gv-teal); fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .gv-ico--w { color: #fff; opacity: 0.9; }

  /* ---------- 奉獻者標題列 ---------- */
  .gv-donor { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: var(--gv-donor-grad); color: #fff; border-radius: 14px; padding: 14px 18px; margin-bottom: 12px; font-weight: 700; font-size: 15px; box-shadow: var(--gv-shadow); }
  .gv-donor__sep { opacity: 0.55; font-weight: 400; }

  /* ---------- 分段切換 ---------- */
  .gv-seg { display: flex; gap: 4px; background: var(--gv-card-2); border: 1px solid var(--gv-line); padding: 4px; border-radius: 12px; flex-wrap: wrap; }
  .gv-seg button { border: 0; background: transparent; padding: 8px 12px; border-radius: 9px; font-weight: 700; font-size: 13px; color: var(--gv-ink-2); line-height: 1.4; }
  .gv-seg button.is-on { background: var(--gv-card); color: var(--gv-ink); box-shadow: var(--gv-shadow); }
  .gv-seg--view { width: 100%; margin-bottom: 14px; }
  .gv-seg--view button { flex: 1; padding: 10px 12px; font-size: 14px; }
  .gv-seg--sm { padding: 3px; }
  .gv-seg--sm button { padding: 6px 10px; font-size: 13px; }

  /* ---------- 卡片 ---------- */
  .gv-card { background: var(--gv-card); border-radius: 14px; padding: 16px; box-shadow: var(--gv-shadow); }
  .gv-card + .gv-card { margin-top: 16px; }
  .gv-card__head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .gv-step { width: 24px; height: 24px; border-radius: 50%; background: var(--gv-ink); color: var(--gv-card); display: grid; place-items: center; font-weight: 800; font-size: 12px; flex: none; }
  .gv-card__head h2 { font-size: 16px; font-weight: 700; line-height: 1.4; }
  .gv-hint { margin-left: auto; font-size: 12px; color: var(--gv-muted); text-align: right; }
  .gv-subhint { font-size: 12px; color: var(--gv-muted); margin: 0 0 12px !important; }
  .gv-mode { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 2px 0 10px; }
  .gv-mode__label { font-size: 12px; color: var(--gv-muted); letter-spacing: 0.06em; flex: none; }

  /* ---------- 同上次奉獻 ---------- */
  .gv-repeat { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--gv-brand); background: var(--gv-brand-soft); color: var(--gv-brand); border-radius: 12px; padding: 12px; margin-bottom: 12px; font-weight: 700; font-size: 15px; }
  .gv-repeat:hover { background: var(--gv-card); }
  .gv-repeat .gv-ico { color: currentColor; width: 17px; height: 17px; }

  /* ---------- 奉獻明細列 ---------- */
  .gv-row { border: 1px solid var(--gv-line); border-radius: 12px; padding: 10px 12px; background: var(--gv-card); transition: border-color 0.15s, background 0.15s; }
  .gv-row + .gv-row { margin-top: 8px; }
  .gv-row.is-active { border-color: var(--gv-teal); background: var(--gv-teal-soft); }
  .gv-row__main { display: flex; align-items: center; gap: 10px; }
  .gv-row__name { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .gv-row__nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gv-tag { font-size: 11px; font-weight: 700; color: var(--gv-teal-ink); background: var(--gv-card); border: 1px solid var(--gv-teal); border-radius: 999px; padding: 0 7px; letter-spacing: 0.04em; flex: none; line-height: 1.6; }
  .gv-amt { display: flex; align-items: center; gap: 6px; background: var(--gv-card); border: 1px solid var(--gv-line-2); border-radius: 10px; padding: 0 10px; height: 42px; width: 148px; flex: none; margin: 0; cursor: text; }
  .gv-amt:focus-within { border-color: var(--gv-brand); box-shadow: 0 0 0 3px rgba(107, 79, 201, 0.22); }
  .gv-amt__cur { font-size: 12px; font-weight: 700; color: var(--gv-muted); }
  .gv-amt__input { border: 0; background: transparent; width: 100%; text-align: right; font-weight: 700; font-size: 17px; font-variant-numeric: tabular-nums; min-width: 0; outline: none; padding: 0; height: auto; box-shadow: none; }
  .gv-amt__input::placeholder { color: var(--gv-line-2); }
  .gv-row__x { border: 0; background: transparent; color: var(--gv-muted); font-size: 20px; line-height: 1; width: 32px; height: 32px; border-radius: 8px; flex: none; padding: 0; }
  .gv-row__x:hover { background: var(--gv-card-2); color: var(--gv-danger); }
  .gv-chips { display: none; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
  .gv-row.is-focused .gv-chips { display: flex; }
  .gv-chip { border: 1px solid var(--gv-line-2); background: var(--gv-card); border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--gv-ink-2); line-height: 1.4; }
  .gv-chip:hover { border-color: var(--gv-teal); color: var(--gv-teal-ink); }
  .gv-sub { display: none; margin: 8px 0 0; align-items: center; gap: 8px; font-size: 13px; }
  .gv-row.is-active .gv-sub { display: flex; }
  .gv-sub span { color: var(--gv-ink-2); flex: none; }
  .gv-sub select, .gv-sub input { flex: 1; min-width: 0; height: 36px; border: 1px solid var(--gv-line-2); border-radius: 8px; background: var(--gv-card); padding: 0 10px; color: var(--gv-ink); }
  .gv-sub__empty { font-style: normal; color: var(--gv-muted); font-size: 12px; }
  .gv-catsel { flex: 1; min-width: 0; height: 42px; border: 1px solid var(--gv-line-2); border-radius: 10px; background: var(--gv-card); padding: 0 8px; font-weight: 600; color: var(--gv-ink); }

  .gv-add { width: 100%; margin-top: 10px; border: 1px dashed var(--gv-line-2); background: transparent; border-radius: 12px; padding: 12px; font-weight: 700; color: var(--gv-brand); }
  .gv-add:hover { background: var(--gv-brand-soft); border-color: var(--gv-brand); }
  .gv-add:disabled { color: var(--gv-muted); cursor: not-allowed; background: transparent; border-color: var(--gv-line); }
  .gv-field { margin-top: 14px; display: grid; gap: 4px; }
  .gv-field label { font-size: 12px; color: var(--gv-ink-2); }
  .gv-field input { height: 40px; border: 1px solid var(--gv-line-2); border-radius: 10px; background: var(--gv-card); padding: 0 12px; color: var(--gv-ink); }

  /* ---------- 付款方式 ---------- */
  .gv-fieldrow { display: flex; align-items: center; gap: 12px; }
  .gv-fieldrow label { flex: none; font-size: 14px; font-weight: 600; color: var(--gv-ink-2); }
  .gv-select { flex: 1; min-width: 0; max-width: 360px; height: 42px; border: 1px solid var(--gv-line-2); border-radius: 10px; background: var(--gv-card); padding: 0 10px; font-weight: 600; color: var(--gv-ink); }
  .gv-select:disabled { opacity: 1; background: var(--gv-card-2); }
  .gv-paydetail { margin-top: 12px; }
  .gv-paydetail:empty { display: none; }
  .gv-paydetail .gv-fieldrow { margin-bottom: 12px; }
  .gv-cards { display: grid; gap: 6px; }
  .gv-cardopt { display: flex; align-items: center; gap: 10px; border: 1px solid var(--gv-line); border-radius: 10px; padding: 10px 12px; cursor: pointer; background: var(--gv-card); }
  .gv-cardopt input { accent-color: var(--gv-teal); margin: 0; }
  .gv-cardopt.is-on { border-color: var(--gv-teal); background: var(--gv-teal-soft); }
  .gv-cardopt__exp { margin-left: auto; font-size: 12px; color: var(--gv-muted); font-variant-numeric: tabular-nums; flex: none; }
  .gv-cardopt__del { border: 0; background: transparent; color: var(--gv-muted); font-size: 12px; padding: 2px 4px; border-radius: 6px; flex: none; text-decoration: underline; }
  .gv-cardopt__del:hover { color: var(--gv-danger); }
  .gv-brandmark { font-size: 10px; font-weight: 800; letter-spacing: 0.06em; border: 1px solid var(--gv-line-2); border-radius: 4px; padding: 1px 5px; color: var(--gv-ink-2); flex: none; }
  .gv-info { font-size: 13px; color: var(--gv-ink-2); background: var(--gv-card-2); border-radius: 10px; padding: 10px 12px; }
  .gv-notice { display: flex; gap: 10px; align-items: center; background: var(--gv-warn-soft); color: var(--gv-warn); border-radius: 10px; padding: 10px 12px; font-size: 13px; margin-top: 10px; flex-wrap: wrap; }
  .gv-notice span { flex: 1; min-width: 200px; }
  .gv-notice button { flex: none; border: 1px solid currentColor; background: transparent; border-radius: 8px; padding: 5px 10px; font-weight: 700; font-size: 12px; color: inherit; }
  .gv-bookings { margin-top: 14px; }
  .gv-bookings h4 { font-size: 11px; letter-spacing: 0.08em; color: var(--gv-muted); font-weight: 700; margin-bottom: 6px; }
  .gv-booking { display: flex; align-items: center; gap: 10px; border: 1px solid var(--gv-line); border-radius: 10px; padding: 10px 12px; font-size: 13px; }
  .gv-booking + .gv-booking { margin-top: 6px; }
  .gv-booking__main { flex: 1; min-width: 0; }
  .gv-booking__main b { display: block; font-size: 14px; }
  .gv-booking__main small { color: var(--gv-muted); }
  .gv-booking__cancel { flex: none; border: 1px solid var(--gv-line-2); background: var(--gv-card); border-radius: 8px; padding: 5px 10px; font-size: 12px; font-weight: 700; color: var(--gv-ink-2); }
  .gv-booking__cancel:hover { border-color: var(--gv-danger); color: var(--gv-danger); }

  /* ---------- 確認與送出 ---------- */
  .gv-checkout { display: flex; flex-direction: column; align-items: stretch; }
  .gv-sumlines { list-style: none; padding: 0; }
  .gv-sumlines li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--gv-line); font-size: 14px; }
  .gv-sumlines li span:last-child { font-variant-numeric: tabular-nums; font-weight: 700; flex: none; }
  .gv-sumlines li small { display: block; color: var(--gv-muted); font-size: 12px; font-weight: 400; }
  .gv-sumlines li.is-empty { color: var(--gv-muted); font-size: 13px; border: 0; justify-content: flex-start; }
  .gv-sumpay { margin-top: 10px; font-size: 13px; color: var(--gv-ink-2); }
  .gv-total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 10px; padding-top: 12px; border-top: 2px solid var(--gv-ink); }
  .gv-total__lbl { font-size: 13px; color: var(--gv-ink-2); flex: none; }
  .gv-total__num { font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .gv-sumcnt { font-size: 12px; color: var(--gv-muted); text-align: right; margin-top: 2px; min-height: 18px; }
  .gv-warn { margin-top: 10px; font-size: 13px; color: var(--gv-warn); background: var(--gv-warn-soft); border-radius: 8px; padding: 8px 12px; }
  .gv-cta { margin-top: 16px; width: 100%; border: 0; background: var(--gv-go); color: var(--gv-go-ink); border-radius: 12px; padding: 0 24px; height: 52px; font-weight: 800; font-size: 17px; }
  .gv-cta:disabled { background: var(--gv-line-2); color: var(--gv-muted); cursor: not-allowed; }

  /* ---------- 參考資訊 ---------- */
  .gv-divider { display: flex; align-items: center; gap: 10px; margin: 24px 0 14px; color: var(--gv-muted); font-size: 11px; letter-spacing: 0.1em; font-weight: 700; }
  .gv-divider::after { content: ""; flex: 1; height: 1px; background: var(--gv-line-2); }
  .gv-infogrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; align-items: start; }
  .gv-infogrid .gv-card { margin: 0; }
  .gv-infotitle { display: flex; align-items: center; gap: 8px; color: var(--gv-teal-ink); font-weight: 700; font-size: 14px; margin: 0 0 14px !important; }
  .gv-contact { list-style: none; padding: 0; display: grid; gap: 12px; }
  .gv-contact li { display: flex; align-items: center; gap: 12px; color: var(--gv-ink-2); font-size: 14px; }
  .gv-contact li span { min-width: 0; overflow-wrap: anywhere; }
  .gv-acclist { display: grid; gap: 10px; }
  .gv-acc { border: 1px solid var(--gv-line); border-radius: 12px; background: var(--gv-card); padding: 0 14px; }
  .gv-acc summary { list-style: none; display: flex; align-items: center; gap: 10px; padding: 14px 0; font-weight: 700; cursor: pointer; }
  .gv-acc summary::-webkit-details-marker { display: none; }
  .gv-acc summary:focus-visible { outline: 2px solid var(--gv-focus); outline-offset: 2px; border-radius: 8px; }
  .gv-acc .gv-chev { margin-left: auto; color: var(--gv-muted); transition: transform 0.2s; }
  .gv-acc[open] .gv-chev { transform: rotate(180deg); }
  .gv-acc p { margin: 0 0 14px; font-size: 13px; color: var(--gv-ink-2); line-height: 1.7; }

  /* ---------- 奉獻清單 ---------- */
  .gv-query { display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  .gv-query__fld { display: grid; gap: 4px; flex: 1; min-width: 132px; }
  .gv-query label { font-size: 12px; color: var(--gv-muted); }
  .gv-query input { height: 42px; border: 1px solid var(--gv-line-2); border-radius: 10px; background: var(--gv-card); padding: 0 10px; color: var(--gv-ink); font-variant-numeric: tabular-nums; width: 100%; }
  .gv-query button { flex: none; height: 42px; border: 0; border-radius: 10px; background: var(--gv-brand); color: #fff; font-weight: 700; padding: 0 20px; }
  .gv-query button:disabled { opacity: 0.6; cursor: wait; }
  .gv-tablewrap { overflow-x: auto; border: 1px solid var(--gv-line); border-radius: 12px; }
  .gv-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 460px; margin: 0; }
  .gv-table th { text-align: left; font-size: 12px; letter-spacing: 0.04em; color: var(--gv-muted); font-weight: 700; padding: 10px 12px; background: var(--gv-card-2); white-space: nowrap; border: 0; }
  .gv-table td { padding: 11px 12px; border: 0; border-top: 1px solid var(--gv-line); vertical-align: top; color: var(--gv-ink); }
  .gv-table .gv-amtcell { text-align: right; font-weight: 700; white-space: nowrap; }
  .gv-table th.gv-amtcell { font-weight: 700; }
  .gv-table .gv-date { white-space: nowrap; color: var(--gv-ink-2); }
  .gv-table small { display: block; color: var(--gv-muted); font-size: 12px; }
  .gv-table tbody tr:hover td { background: var(--gv-card-2); }
  .gv-pill { display: inline-block; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 2px 9px; white-space: nowrap; background: var(--gv-teal-soft); color: var(--gv-teal-ink); border: 1px solid var(--gv-teal); }
  .gv-empty { padding: 28px 12px !important; text-align: center; color: var(--gv-muted) !important; font-size: 14px; }
  .gv-empty.is-error { color: var(--gv-warn) !important; }
  .gv-feefoot { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 2px 0; font-size: 14px; color: var(--gv-ink-2); flex-wrap: wrap; }
  .gv-feefoot b { font-size: 20px; color: var(--gv-ink); font-variant-numeric: tabular-nums; }

  /* ---------- 對話框（加入類別／確認／完成） ---------- */
  .gv-sheet { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 2000; background: rgba(20, 20, 40, 0.48); display: grid; align-items: end; justify-items: center; }
  .gv-sheet__panel { width: 100%; max-width: 560px; max-height: 88vh; overflow: auto; background: var(--gv-card); border-radius: 20px 20px 0 0; padding: 16px 16px calc(16px + env(safe-area-inset-bottom)); box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.25); animation: gv-up 0.22s ease-out; }
  @@keyframes gv-up { from { transform: translateY(24px); opacity: 0.6; } to { transform: none; opacity: 1; } }
  .gv-sheet__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; gap: 10px; }
  .gv-sheet__head h3 { font-size: 17px; font-weight: 700; }
  .gv-iconbtn { border: 0; background: var(--gv-card-2); width: 34px; height: 34px; border-radius: 50%; font-size: 16px; flex: none; padding: 0; }
  .gv-search { width: 100%; height: 44px; border: 1px solid var(--gv-line-2); border-radius: 12px; padding: 0 14px; background: var(--gv-card-2); margin-bottom: 6px; color: var(--gv-ink); }
  .gv-pnote { font-size: 12px; color: var(--gv-warn); min-height: 18px; margin-bottom: 4px; }
  .gv-pgroup { margin-top: 10px; }
  .gv-pgroup h4 { margin: 0 0 6px; font-size: 11px; letter-spacing: 0.08em; color: var(--gv-muted); font-weight: 700; }
  .gv-plist { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; }
  .gv-pitem { border: 1px solid var(--gv-line); background: var(--gv-card); border-radius: 10px; padding: 10px 12px; text-align: left; display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; min-height: 44px; }
  .gv-pitem:hover { border-color: var(--gv-teal); }
  .gv-pitem:disabled { opacity: 0.55; cursor: not-allowed; }
  .gv-pitem__added { margin-left: auto; font-size: 11px; color: var(--gv-teal-ink); font-weight: 700; flex: none; }
  .gv-pempty { color: var(--gv-muted); padding: 12px 0; font-size: 13px; }
  .gv-conflines { list-style: none; padding: 0; }
  .gv-conflines li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--gv-line); font-size: 15px; }
  .gv-conflines li span:last-child { font-variant-numeric: tabular-nums; font-weight: 700; flex: none; }
  .gv-conflines li small { display: block; color: var(--gv-muted); font-size: 12px; }
  .gv-confmeta { display: grid; gap: 6px; margin-top: 10px; font-size: 13px; }
  .gv-confmeta div { display: flex; justify-content: space-between; gap: 12px; }
  .gv-confmeta span { color: var(--gv-ink-2); flex: none; }
  .gv-confmeta b { text-align: right; overflow-wrap: anywhere; }
  .gv-conftotal { display: flex; justify-content: space-between; align-items: baseline; margin-top: 12px; padding-top: 12px; border-top: 2px solid var(--gv-ink); }
  .gv-conftotal b { font-size: 24px; font-variant-numeric: tabular-nums; }
  .gv-btnrow { display: flex; gap: 8px; margin-top: 14px; }
  .gv-btn { flex: 1; height: 48px; border-radius: 12px; font-weight: 700; border: 1px solid var(--gv-line-2); background: var(--gv-card); color: var(--gv-ink); }
  .gv-btn--go { background: var(--gv-go); color: var(--gv-go-ink); border-color: transparent; }
  .gv-btn:disabled { opacity: 0.6; cursor: wait; }
  .gv-done { text-align: center; }
  .gv-done > div > h3 { margin: 0 0 4px; font-size: 18px; }
  .gv-done > div > p { color: var(--gv-ink-2); font-size: 13px; margin: 0 0 14px; }
  .gv-done__mark { width: 56px; height: 56px; border-radius: 50%; background: var(--gv-teal-soft); display: grid; place-items: center; margin: 4px auto 10px; color: var(--gv-teal-ink); font-size: 26px; font-weight: 800; }
  .gv-done #atm-info { text-align: left; margin-bottom: 12px; }
  .gv-spinner { width: 40px; height: 40px; border-radius: 50%; border: 3px solid var(--gv-line); border-top-color: var(--gv-teal); margin: 12px auto 14px; animation: gv-spin 0.8s linear infinite; }
  @@keyframes gv-spin { to { transform: rotate(360deg); } }
  .gv-lineresult { font-size: 13px; color: var(--gv-warn); background: var(--gv-warn-soft); border-radius: 10px; padding: 8px 12px; text-align: left; }
  .gv-lineresult.is-ok { color: var(--gv-teal-ink); background: var(--gv-teal-soft); }

  .gv-toast { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom)); transform: translateX(-50%); background: var(--gv-ink); color: var(--gv-card); padding: 10px 14px; border-radius: 10px; font-size: 13px; z-index: 2100; opacity: 0; transition: opacity 0.2s; pointer-events: none; max-width: 90%; text-align: center; }
  .gv-toast.is-show { opacity: 1; }

  @@media (max-width: 430px) {
    .gv-amt { width: 112px; padding: 0 8px; }
    .gv-amt__input { font-size: 16px; }
    .gv-tag { display: none; }
    .gv-row__main { gap: 6px; }
    .gv-row__name { gap: 6px; }
    .gv-row__x { width: 26px; }
    .gv-row { padding: 10px; }
    .gv-cardopt__exp { display: none; }
  }

  @@media (min-width: 560px) {
    .gv-cta { width: auto; min-width: 240px; align-self: flex-start; }
  }

  @@media (min-width: 700px) {
    .gv-sheet { align-items: center; padding: 24px; }
    .gv-sheet__panel { border-radius: 20px; }
  }

  @@media (prefers-reduced-motion: reduce) {
    .gv-page *, .gv-layer, .gv-layer * { animation: none !important; transition: none !important; }
  }

  /* ==================== ATM 轉帳資訊卡（沿用既有設計，範圍為 #atm-info，放在完成對話框內也能套用） ==================== */
  /* ==================== ATM 轉帳資訊卡 ==================== */
  #atm-info {
    --atm-ink: #12302d;
    --atm-teal: #0f766e;
    --atm-teal-deep: #115e59;
    --atm-teal-soft: #eaf6f3;
    --atm-line: #d6e9e4;
    --atm-muted: #58706c;
    --atm-amber: #9a4a06;
    --atm-amber-soft: #fff1dc;
    --atm-ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: #fcfefd;
    border: 1px solid var(--atm-line);
    border-radius: 18px;
    box-shadow: 0 14px 34px rgba(18, 48, 45, 0.08);
    padding: 0;
    min-height: 0;
    margin: 0 0 32px;
    overflow: hidden;
    scroll-margin: 16px;
    transition: box-shadow 220ms ease;
  }

  #atm-info.is-revealed {
    animation: atm-panel-in 440ms var(--atm-ease) both;
  }

  /* 錯誤或無法解析時的純文字訊息 */
  #atm-info #atmfield {
    margin: 0;
    padding: 18px 24px;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--atm-ink) !important;
    white-space: pre-line;
  }

  #atm-info #atmfield.is-error {
    background: #fdf0ee;
    color: #9b1c1c !important;
  }

  .atm-card {
    color: var(--atm-ink);
  }

  /* 虛擬帳號主視覺：帳號與複製按鈕置頂 */
  .atm-hero {
    position: relative;
    overflow: hidden;
    padding: 20px 24px 22px;
    background: var(--atm-teal-soft);
    border-bottom: 1px solid var(--atm-line);
  }

  .atm-hero::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: linear-gradient(105deg, transparent 38%, rgba(255, 255, 255, 0.7) 50%, transparent 62%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  .atm-hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 14px;
  }

  .atm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--atm-teal-deep);
  }

  .atm-deadline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--atm-amber-soft);
    color: var(--atm-amber);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .atm-hero__label {
    margin-bottom: 2px;
    font-size: 0.86rem;
    color: var(--atm-muted);
  }

  .atm-hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
  }

  .atm-account {
    display: block;
    margin-left: -6px;
    padding: 2px 6px;
    border-radius: 10px;
    font-size: clamp(1.75rem, 5vw, 2.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--atm-ink);
    transition: background-color 700ms var(--atm-ease);
  }

  .atm-account__group {
    display: inline-block;
  }

  .atm-account__group:not(:last-child) {
    margin-right: 0.42em;
  }

  .atm-account.is-flash {
    background-color: rgba(15, 118, 110, 0.16);
    transition-duration: 120ms;
  }

  #copy-atm-account {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 22px;
    border: 0;
    border-radius: 12px;
    background: var(--atm-teal);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(15, 118, 110, 0.28);
    transition: transform 140ms var(--atm-ease), background-color 220ms ease, box-shadow 220ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  #copy-atm-account:active {
    transform: scale(0.97);
  }

  #copy-atm-account:focus-visible {
    outline: 3px solid #5eead4;
    outline-offset: 3px;
  }

  #copy-atm-account.is-copied {
    background: #15803d;
    box-shadow: 0 6px 16px rgba(21, 128, 61, 0.28);
  }

  .atm-copy__icon {
    display: inline-grid;
    place-items: center;
    width: 1.1em;
    height: 1.1em;
  }

  .atm-copy__icon i {
    grid-area: 1 / 1;
    transition: opacity 180ms ease, transform 280ms var(--atm-ease);
  }

  .atm-copy__icon .fa-check,
  #copy-atm-account.is-copied .fa-copy {
    opacity: 0;
    transform: scale(0.4) rotate(-25deg);
  }

  #copy-atm-account.is-copied .fa-check {
    opacity: 1;
    transform: none;
  }

  /* 到 ATM 操作時最需要的三項資訊 */
  .atm-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-bottom: 1px solid var(--atm-line);
  }

  .atm-fact {
    min-width: 0;
    padding: 16px 24px;
  }

  .atm-fact + .atm-fact {
    border-left: 1px solid var(--atm-line);
  }

  .atm-card dt {
    margin: 0;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--atm-muted);
  }

  .atm-card dd {
    margin: 0;
    color: var(--atm-ink);
    overflow-wrap: anywhere;
  }

  .atm-fact dd {
    margin-top: 4px;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .atm-fact__sub {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--atm-muted);
  }

  .atm-fact--amount dd {
    color: var(--atm-teal-deep);
  }

  /* 奉獻明細 */
  .atm-details {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 8px 20px;
    margin: 0;
    padding: 16px 24px 4px;
    font-size: 1rem;
  }

  .atm-details dt {
    font-size: 0.92rem;
  }

  .atm-details dd {
    font-weight: 600;
  }

  .atm-note {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    padding: 12px 24px 18px;
    font-size: 0.9rem;
    color: var(--atm-muted);
  }

  /* 進場動畫：卡片滑入 → 各區塊依序浮現 → 帳號逐組出現 → 光澤掃過 */
  #atm-info.is-revealed .atm-reveal {
    animation: atm-rise 460ms var(--atm-ease) both;
    animation-delay: calc(var(--d, 0) * 1ms);
  }

  #atm-info.is-revealed .atm-account__group {
    animation: atm-rise 420ms var(--atm-ease) both;
    animation-delay: calc(200ms + var(--i, 0) * 70ms);
  }

  #atm-info.is-revealed .atm-hero::after {
    animation: atm-shine 1200ms 700ms var(--atm-ease) both;
  }

  @@keyframes atm-panel-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @@keyframes atm-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @@keyframes atm-shine {
    from { transform: translateX(-100%); }
    to { transform: translateX(100%); }
  }

  @@media (hover: hover) {
    #copy-atm-account:hover {
      background: var(--atm-teal-deep);
      box-shadow: 0 10px 22px rgba(15, 118, 110, 0.32);
      transform: translateY(-1px);
    }

    #copy-atm-account.is-copied:hover {
      background: #166534;
    }
  }

  /* 輕量互動僅限定於 ATM 卡片，不移動帳號或金額；純 CSS 隨元素隱藏／移除停止，無計時器或事件訂閱。
     成功回饋沿用既有 is-copied 狀態；後方 reduced-motion 規則統一停用動畫與轉場。 */
  #atm-info .atm-fact { transition: background-color 240ms ease; }
  #copy-atm-account .atm-copy__icon { transition: transform 240ms var(--atm-ease); }
  #copy-atm-account:focus-visible .atm-copy__icon { transform: translateY(-2px) rotate(-8deg); }
  #copy-atm-account.is-copied .atm-copy__icon { animation: atm-copy-pop 420ms var(--atm-ease); }
  @@keyframes atm-copy-pop {
    0%, 100% { transform: none; }
    45% { transform: translateY(-3px) scale(1.18); }
    75% { transform: translateY(1px) scale(0.96); }
  }
  @@keyframes atm-hover-shine {
    from { transform: translateX(-100%); opacity: 0; }
    20%, 70% { opacity: 0.45; }
    to { transform: translateX(100%); opacity: 0; }
  }
  @@media (hover: hover) and (pointer: fine) {
    #atm-info .atm-fact:hover { background-color: var(--atm-teal-soft); }
    #copy-atm-account:not(.is-copied):hover .atm-copy__icon { transform: translateY(-2px) rotate(-8deg); }
    /* 每次滑入僅掃光一次，保留閱讀穩定性；離開後可再次觸發，不持續佔用繪製資源。 */
    #atm-info.is-revealed .atm-hero:hover::after { animation: atm-hover-shine 1100ms ease-out both; }
  }

  @@media (max-width: 576px) {
    .atm-hero {
      padding: 16px 16px 18px;
    }

    .atm-hero__row {
      flex-direction: column;
      align-items: stretch;
    }

    #copy-atm-account {
      width: 100%;
      min-height: 52px;
    }

    .atm-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .atm-fact {
      padding: 14px 16px;
    }

    .atm-fact--amount {
      grid-column: 1 / -1;
      border-top: 1px solid var(--atm-line);
      border-left: 0 !important;
    }

    .atm-details {
      gap: 6px 14px;
      padding: 14px 16px 2px;
    }

    .atm-note {
      padding: 10px 16px 16px;
    }

    #atm-info #atmfield {
      padding: 16px;
    }
  }

  @@media (prefers-reduced-motion: reduce) {
    #atm-info,
    #atm-info *,
    #atm-info *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script type="application/json" id="gvData">@Json.Serialize(pageData)</script>

<!-- ==================== 奉獻頁 ==================== -->
<div class="gv-page">
    <div class="gv" id="gv">
        <div class="gv-donor">
            <svg class="gv-ico gv-ico--w" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
            <span>@Model.FullName</span>
            <span class="gv-donor__sep" aria-hidden="true">|</span>
            <svg class="gv-ico gv-ico--w" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
            <span>奉獻編號：<span class="gv-num">@Model.DedicationNumber</span></span>
        </div>

        <div class="gv-seg gv-seg--view" id="gvViewSeg" role="tablist" aria-label="切換畫面">
            <button type="button" role="tab" data-view="give" class="is-on" aria-selected="true">我要奉獻</button>
            <button type="button" role="tab" data-view="list" aria-selected="false">奉獻清單</button>
        </div>

        <!-- ==================== 我要奉獻 ==================== -->
        <main id="gvViewGive">
            <section class="gv-card" aria-labelledby="gvItemsTitle">
                <div class="gv-card__head">
                    <span class="gv-step" aria-hidden="true">1</span>
                    <h2 id="gvItemsTitle">奉獻內容</h2>
                    <span class="gv-hint" id="gvItemsHint"></span>
                </div>
                <div class="gv-mode">
                    <span class="gv-mode__label">輸入方式</span>
                    <div class="gv-seg gv-seg--sm" id="gvModeSeg" role="radiogroup" aria-label="輸入方式">
                        <button type="button" role="radio" data-mode="A">常用優先</button>
                        <button type="button" role="radio" data-mode="B">完整清單</button>
                        <button type="button" role="radio" data-mode="C">逐筆新增</button>
                    </div>
                </div>
                <p class="gv-subhint" id="gvItemsSubHint"></p>
                <button type="button" class="gv-repeat" id="gvRepeat" hidden>
                    <svg class="gv-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16M3 21v-5h5" /></svg>
                    同上次奉獻 <span class="gv-num" id="gvRepeatTotal"></span>
                </button>
                <div id="gvRows"></div>
                <button type="button" class="gv-add" id="gvAdd">＋ 加入其他類別</button>
                <div class="gv-field">
                    <label for="gvNote">備註（選填）</label>
                    <input id="gvNote" autocomplete="off" placeholder="例：為父親手術感恩">
                </div>
            </section>

            <section class="gv-card" aria-labelledby="gvPayTitle">
                <div class="gv-card__head">
                    <span class="gv-step" aria-hidden="true">2</span>
                    <h2 id="gvPayTitle">付款方式</h2>
                </div>
                <div class="gv-fieldrow">
                    <label for="gvPay">付款方式</label>
                    <select id="gvPay" class="gv-select"></select>
                </div>
                <div class="gv-paydetail" id="gvPayDetail"></div>
            </section>

            <section class="gv-card gv-checkout" aria-labelledby="gvCheckoutTitle">
