<!-- ==================== 奉獻頁腳本 ==================== -->
<script>
(function () {
    'use strict';

    // ==================== 資料與常數 ====================
    var DATA = {};
    try {
        DATA = JSON.parse(document.getElementById('gvData').textContent || '{}') || {};
    } catch (e) {
        DATA = {};
    }

    var CATEGORIES = (DATA.categories || []).filter(function (c) { return typeof c === 'string' && c.trim().length > 0; });
    var PAY_WAYS = DATA.payWays && DATA.payWays.length ? DATA.payWays : ['信用卡'];
    var HOLIDAYS = ['元旦', '新春', '清明節', '復活節', '母親節', '父親節', '重陽節', '感恩節', '聖誕節'];
    var REGULAR = ['主日奉獻', '十一奉獻', '感恩奉獻', '愛心奉獻', '建堂奉獻', '宣教奉獻'];
    var GROUPS = ['常規奉獻', '事工與專案', '特別與其他'];
    var DEFAULT_PINNED = ['十一奉獻', '感恩奉獻', '建堂奉獻', '宣教奉獻'];
    var MAX = DATA.maxLines > 0 ? DATA.maxLines : 7;
    var PINNED_COUNT = 4;
    var CARD = '信用卡';
    var ATM = 'ATM轉帳/匯款';
    var RECURRING = '信用卡定期定額(每個月)';
    var PERIODS = [3, 6, 12, 18, 24];
    var CHIPS = [500, 1000, 2000, 3000, 5000];
    var PAY_LABEL = { '信用卡': '信用卡', 'ATM轉帳/匯款': 'ATM 轉帳／匯款', '信用卡定期定額(每個月)': '信用卡定期定額（每月）', 'LinePay': 'LINE Pay', '行動支付': '行動支付' };
    var PAY_INFO = {
        'ATM轉帳/匯款': '送出後會產生一組專屬虛擬帳號，請於 10 天內完成轉帳。',
        'LinePay': '送出後開啟 LINE Pay 付款頁，完成後自動返回。',
        '行動支付': '送出後前往行動支付付款頁，完成後自動返回。'
    };
    var LAST_PAY_MAP = { '信用卡': CARD, 'ATM轉帳': ATM, 'LinePay': 'LinePay', '行動支付': '行動支付' };
    var MODES = {
        A: { name: '常用優先', hint: '常用類別依你近 12 個月的奉獻紀錄排在最上面；直接填寫金額即可，其他類別用「加入其他類別」搜尋加入。' },
        B: { name: '完整清單', hint: '所有類別一次列出，直接填寫金額即可。' },
        C: { name: '逐筆新增', hint: '一筆一筆選類別、填金額。' }
    };
    var MODE_KEY = 'gv-donation-input-mode';
    var AJAX_HEADERS = { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' };
    var SHEETS = ['gvPicker', 'gvConfirm', 'gvDone'];

    // ==================== 小工具 ====================
    function byId(id) { return document.getElementById(id); }
    function fmt(n) { return Number(n || 0).toLocaleString('zh-TW'); }
    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function hasCat(name) { return CATEGORIES.indexOf(name) >= 0; }
    function loadMode() {
        try { var v = window.localStorage.getItem(MODE_KEY); return MODES[v] ? v : null; } catch (e) { return null; }
    }
    function saveMode(v) {
        try { window.localStorage.setItem(MODE_KEY, v); } catch (e) { }
    }
    function readJson(response) {
        return response.text().then(function (text) {
            var data = null;
            try { data = text ? JSON.parse(text) : null; } catch (e) { data = null; }
            return { ok: response.ok, status: response.status, data: data };
        });
    }

    var toastTimer = null;
    function toast(message, ms) {
        var t = byId('gvToast');
        t.textContent = message;
        t.classList.add('is-show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { t.classList.remove('is-show'); }, ms || 2400);
    }

    // ==================== 類別規則 ====================
    function groupFor(name) {
        if (REGULAR.indexOf(name) >= 0) return '常規奉獻';
        if (/特別|節期|其他|代收|代轉/.test(name)) return '特別與其他';
        return '事工與專案';
    }
    function subFor(name) {
        if (name === '節期獻金') return { type: 'select', label: '節期', required: true, options: HOLIDAYS };
        if (name === '特別奉獻') return { type: 'select', label: '特別奉獻項目', required: true, options: DATA.specialItems || [] };
        if (name === '宣教奉獻' && (DATA.missionTargets || []).length) return { type: 'select', label: '宣教對象', required: false, options: DATA.missionTargets };
        if (name === '其他奉獻') return { type: 'text', label: '其他奉獻內容', required: false, placeholder: '請說明用途' };
        return null;
    }
    function defaultPinned() {
        var list = DEFAULT_PINNED.filter(hasCat);
        CATEGORIES.forEach(function (c) { if (list.length < PINNED_COUNT && list.indexOf(c) < 0) list.push(c); });
        return list;
    }

    // ==================== 狀態 ====================
    var keySeq = 1;
    function mk(cat, extra) {
        var line = { key: keySeq++, cat: cat, amount: 0, sub: '', pinned: false };
        if (extra) { for (var k in extra) { if (Object.prototype.hasOwnProperty.call(extra, k)) line[k] = extra[k]; } }
        return line;
    }

    var state = {
        variant: loadMode() || 'A',
        pinned: defaultPinned(),
        lines: [],
        pay: PAY_WAYS[0],
        cards: (DATA.cards || []).slice(),
        card: 'new',
        period: 12,
        note: '',
        lastGift: null,
        bookings: (DATA.bookings || []).slice(),
        pending: false,
        redirecting: false,
        historyLoaded: false
    };
    state.card = (function () {
        var tokens = state.cards.map(function (c) { return c.token; });
        if (DATA.selectedCard && tokens.indexOf(DATA.selectedCard) >= 0) return DATA.selectedCard;
        return tokens.length ? tokens[0] : 'new';
    })();

    function freshLines(v) {
        if (v === 'A') return state.pinned.map(function (c) { return mk(c, { pinned: true }); });
        if (v === 'B') return CATEGORIES.map(function (c) { return mk(c); });
        return [mk(CATEGORIES[0] || '')];
    }
    // 切換輸入方式或帶入「同上次」時，以類別→金額對照表重建明細，已輸入的金額與子項目會保留。
    function linesFromMap(map, v, order) {
        function take(c) { return map[c] ? { amount: map[c].amount, sub: map[c].sub } : {}; }
        if (v === 'A') {
            var lines = state.pinned.map(function (c) { var t = take(c); t.pinned = true; return mk(c, t); });
            order.forEach(function (c) { if (state.pinned.indexOf(c) < 0) lines.push(mk(c, take(c))); });
            return lines;
        }
        if (v === 'B') return CATEGORIES.map(function (c) { return mk(c, take(c)); });
        return order.length ? order.map(function (c) { return mk(c, take(c)); }) : [mk(CATEGORIES[0] || '')];
    }
    function currentMap() {
        var map = {}, order = [];
        state.lines.forEach(function (l) {
            if (l.amount > 0 && !map[l.cat]) { map[l.cat] = { amount: l.amount, sub: l.sub }; order.push(l.cat); }
        });
        return { map: map, order: order };
    }
    function activeLines() { return state.lines.filter(function (l) { return l.amount > 0; }); }
    function total() { return activeLines().reduce(function (s, l) { return s + l.amount; }, 0); }
    function isRecurring() { return state.pay === RECURRING; }
    function usesCard() { return state.pay === CARD || isRecurring(); }
    function findLine(key) { key = Number(key); return state.lines.filter(function (l) { return l.key === key; })[0]; }
    function issues() {
        var act = activeLines(), out = [];
        if (!act.length) out.push('請至少輸入一個類別的金額');
        if (act.length > MAX) out.push('一次最多 ' + MAX + ' 個類別');
        act.forEach(function (l) {
            var s = subFor(l.cat);
            if (s && s.required && !l.sub) out.push('「' + l.cat + '」請選擇' + s.label);
        });
        if (isRecurring() && act.length > 1) out.push('定期定額一次只能設定一個類別');
        return out;
    }

    // ==================== 奉獻內容 ====================
    function subHtml(l) {
        var s = subFor(l.cat);
        if (!s) return '';
        var optional = s.required ? '' : '（選填）';
        if (s.type === 'select') {
            if (!s.options.length) {
                return '<div class="gv-sub"><span>' + esc(s.label) + '</span><em class="gv-sub__empty">目前沒有開放的項目</em></div>';
            }
            return '<label class="gv-sub"><span>' + esc(s.label) + optional + '</span><select data-sub="' + l.key + '">' +
                '<option value="">' + (s.required ? '請選擇' : '不指定') + '</option>' +
                s.options.map(function (o) { return '<option value="' + esc(o) + '"' + (l.sub === o ? ' selected' : '') + '>' + esc(o) + '</option>'; }).join('') +
                '</select></label>';
        }
        return '<label class="gv-sub"><span>' + esc(s.label) + optional + '</span><input data-sub="' + l.key + '" autocomplete="off" value="' + esc(l.sub) + '" placeholder="' + esc(s.placeholder || '') + '"></label>';
    }
    function chipsHtml(key) {
        return '<div class="gv-chips" aria-hidden="true">' + CHIPS.map(function (n) {
            return '<button type="button" class="gv-chip" data-chip="' + n + '" data-key="' + key + '" tabindex="-1">' + fmt(n) + '</button>';
        }).join('') + '</div>';
    }
    function amtHtml(l) {
        return '<label class="gv-amt"><span class="gv-amt__cur">NT$</span><input class="gv-amt__input" data-key="' + l.key + '" inputmode="numeric" autocomplete="off" placeholder="0" value="' +
            (l.amount ? fmt(l.amount) : '') + '" aria-label="' + esc(l.cat) + '金額"></label>';
    }
    // 常用與完整清單直接以金額決定是否計入；不另存勾選狀態，避免清空後仍送出舊金額。
    function rowA(l) {
        var on = l.amount > 0;
        return '<div class="gv-row' + (on ? ' is-active' : '') + '" data-key="' + l.key + '"><div class="gv-row__main">' +
            '<div class="gv-row__name"><span class="gv-row__nm">' + esc(l.cat) + '</span>' + (l.pinned ? '<span class="gv-tag">常用</span>' : '') + '</div>' +
            amtHtml(l) +
            '<button type="button" class="gv-row__x" data-act="' + (l.pinned ? 'clear' : 'remove') + '" data-key="' + l.key + '" aria-label="' + (l.pinned ? '清除金額' : '移除此類別') + '"' + (l.pinned && !on ? ' hidden' : '') + '>×</button>' +
            '</div>' + chipsHtml(l.key) + subHtml(l) + '</div>';
    }
    function rowB(l) {
        var on = l.amount > 0;
        return '<div class="gv-row' + (on ? ' is-active' : '') + '" data-key="' + l.key + '"><div class="gv-row__main">' +
            '<div class="gv-row__name"><span class="gv-row__nm">' + esc(l.cat) + '</span></div>' + amtHtml(l) +
            '</div>' + subHtml(l) + '</div>';
    }
    function rowC(l, index) {
        var on = l.amount > 0;
        var used = state.lines.filter(function (x) { return x !== l; }).map(function (x) { return x.cat; });
        var options = GROUPS.map(function (g) {
            var items = CATEGORIES.filter(function (c) { return groupFor(c) === g; });
            if (!items.length) return '';
            return '<optgroup label="' + g + '">' + items.map(function (c) {
                return '<option value="' + esc(c) + '"' + (c === l.cat ? ' selected' : '') + (used.indexOf(c) >= 0 ? ' disabled' : '') + '>' + esc(c) + '</option>';
            }).join('') + '</optgroup>';
        }).join('');
        return '<div class="gv-row' + (on ? ' is-active' : '') + '" data-key="' + l.key + '"><div class="gv-row__main">' +
            '<select class="gv-catsel" data-key="' + l.key + '" aria-label="第 ' + (index + 1) + ' 筆類別">' + options + '</select>' + amtHtml(l) +
            '<button type="button" class="gv-row__x" data-act="remove" data-key="' + l.key + '" aria-label="移除此筆"' + (state.lines.length === 1 ? ' hidden' : '') + '>×</button>' +
            '</div>' + chipsHtml(l.key) + subHtml(l) + '</div>';
    }
    function renderRows() {
        var v = state.variant;
        byId('gvRows').innerHTML = state.lines.map(function (l, i) {
            return v === 'A' ? rowA(l) : v === 'B' ? rowB(l) : rowC(l, i);
        }).join('');
        var add = byId('gvAdd');
        add.hidden = v === 'B';
        add.textContent = v === 'A' ? '＋ 加入其他類別' : '＋ 再加一筆';
        add.disabled = v === 'C' && (state.lines.length >= MAX || state.lines.length >= CATEGORIES.length);
        byId('gvItemsHint').textContent = v === 'B' ? CATEGORIES.length + ' 個類別全部列出' : '一次最多 ' + MAX + ' 個類別';
        byId('gvItemsSubHint').textContent = MODES[v].hint;
        renderRepeat();
    }
    function renderRepeat() {
        var gift = state.lastGift;
        byId('gvRepeat').hidden = !gift;
        if (gift) byId('gvRepeatTotal').textContent = 'NT$ ' + fmt(gift.total);
    }

    // ==================== 付款方式 ====================
    function cardDigits(card) { return String(card.number || '').replace(/\D/g, ''); }
    function cardBrand(digits) {
        if (/^4/.test(digits)) return 'VISA';
        if (/^(5[1-5]|2[2-7])/.test(digits)) return 'MC';
        if (/^35/.test(digits)) return 'JCB';
        if (/^3[47]/.test(digits)) return 'AMEX';
        if (/^62/.test(digits)) return '銀聯';
        return '卡片';
    }
    function cardText(card) {
        var last4 = cardDigits(card).slice(-4);
        return '•••• ' + (last4 || '----');
    }
    function cardsHtml() {
        if (!state.cards.length) {
            return '<div class="gv-info">送出後前往刷卡頁面輸入卡號。</div>';
        }
        return '<div class="gv-cards" role="radiogroup" aria-label="選擇信用卡">' + state.cards.map(function (c) {
            var on = state.card === c.token;
            return '<label class="gv-cardopt' + (on ? ' is-on' : '') + '">' +
                '<input type="radio" name="gvCard" value="' + esc(c.token) + '"' + (on ? ' checked' : '') + '>' +
                '<span class="gv-brandmark">' + esc(cardBrand(cardDigits(c))) + '</span>' +
                '<span class="gv-num">' + esc(cardText(c)) + '</span>' +
                '<span class="gv-cardopt__exp">到期 ' + esc(c.expire) + '</span>' +
                '<button type="button" class="gv-cardopt__del" data-del-card="' + esc(c.token) + '" aria-label="刪除卡號結尾 ' + esc(cardDigits(c).slice(-4)) + ' 的信用卡">刪除</button>' +
                '</label>';
        }).join('') +
            '<label class="gv-cardopt' + (state.card === 'new' ? ' is-on' : '') + '"><input type="radio" name="gvCard" value="new"' + (state.card === 'new' ? ' checked' : '') + '><span>＋ 使用其他信用卡</span></label>' +
            '</div>';
    }
    function bookingsHtml() {
        if (!state.bookings.length) return '';
        return '<div class="gv-bookings"><h4>目前的定期定額</h4>' + state.bookings.map(function (b) {
            var detail = [b.status, b.paidPeriod ? '已扣 ' + b.paidPeriod + ' 期' : '', b.totalStages ? '共 ' + b.totalStages : '', b.start && b.end ? b.start + '～' + b.end : '']
                .filter(function (x) { return x; }).map(esc).join(' · ');
            return '<div class="gv-booking"><div class="gv-booking__main"><b>' + esc(b.category) + (b.amount ? '　每期 NT$ ' + esc(b.amount) : '') + '</b><small>' + detail + '</small></div>' +
                '<button type="button" class="gv-booking__cancel" data-cancel-booking="' + esc(b.id) + '">取消扣款</button></div>';
        }).join('') + '</div>';
    }
    function renderPay() {
        var select = byId('gvPay');
        if (!select.options.length) {
            select.innerHTML = PAY_WAYS.map(function (p) { return '<option value="' + esc(p) + '">' + esc(PAY_LABEL[p] || p) + '</option>'; }).join('');
            select.disabled = PAY_WAYS.length === 1;
        }
        select.value = state.pay;
        var detail = byId('gvPayDetail'), act = activeLines();
        if (state.pay === CARD) {
            detail.innerHTML = cardsHtml();
        } else if (isRecurring()) {
            var periods = '<div class="gv-fieldrow"><label for="gvPeriod">扣款期數</label><select id="gvPeriod" class="gv-select">' +
                PERIODS.map(function (n) { return '<option value="' + n + '"' + (state.period === n ? ' selected' : '') + '>' + n + ' 個月</option>'; }).join('') +
                '</select></div>';
            var notice = act.length > 1
                ? '<div class="gv-notice"><span>定期定額一次只能設定一個類別；多類別請用單次奉獻，或分別建立定期定額。</span><button type="button" data-act="keepFirst">只保留「' + esc(act[0].cat) + '」</button></div>'
                : '';
            detail.innerHTML = periods + cardsHtml() + notice + bookingsHtml();
        } else {
            detail.innerHTML = '<div class="gv-info">' + esc(PAY_INFO[state.pay] || '') + '</div>';
        }
    }
    function payText() {
        var name = PAY_LABEL[state.pay] || state.pay;
        if (!usesCard()) return name;
        if (!state.cards.length || state.card === 'new') return name + '（其他信用卡）';
        var card = state.cards.filter(function (c) { return c.token === state.card; })[0];
        return card ? name + ' ' + cardText(card) : name;
    }

    // ==================== 確認與送出 ====================
    function renderSummary() {
        var act = activeLines(), sum = total(), list = issues(), rec = isRecurring();
        byId('gvSumLines').innerHTML = act.length
            ? act.map(function (l) {
                return '<li><span>' + esc(l.cat) + (l.sub ? '<small>' + esc(l.sub) + '</small>' : '') + '</span><span>' + fmt(l.amount) + '</span></li>';
            }).join('')
            : '<li class="is-empty">尚未輸入金額</li>';
        byId('gvSumPay').textContent = '付款：' + payText() + (rec ? ' · ' + state.period + ' 期' : '');
        byId('gvSumLbl').textContent = rec ? '每月總計' : '總計';
        byId('gvSumNum').textContent = 'NT$ ' + fmt(sum);
        byId('gvSumCnt').textContent = act.length
            ? act.length + ' 個類別' + (rec ? ' · ' + state.period + ' 期共 NT$ ' + fmt(sum * state.period) : '')
            : '';
        var warn = byId('gvSumWarn'), show = list.length > 0 && act.length > 0;
        warn.hidden = !show;
        warn.textContent = show ? list[0] : '';
        byId('gvCta').disabled = list.length > 0 || state.pending;
    }
    function renderChrome() {
        [].forEach.call(document.querySelectorAll('#gvModeSeg button'), function (b) {
            var on = b.getAttribute('data-mode') === state.variant;
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-checked', on ? 'true' : 'false');
        });
        byId('gvNote').value = state.note;
    }
    function renderAll() { renderChrome(); renderRows(); renderPay(); renderSummary(); }

    // 金額僅更新本頁 state；沿用既有上限與驗證，不新增跨使用者狀態或事件訂閱。
    function setAmount(key, value, sourceInput) {
        var l = findLine(key);
        if (!l) return;
        l.amount = Math.max(0, Math.min(Number(value) || 0, 99999999));
        var row = byId('gvRows').querySelector('.gv-row[data-key="' + l.key + '"]');
        if (row) {
            row.classList.toggle('is-active', l.amount > 0);
            var clear = row.querySelector('.gv-row__x[data-act="clear"]');
            if (clear) clear.hidden = l.amount === 0;
            var input = row.querySelector('.gv-amt__input');
            if (input && input !== sourceInput) {
                input.value = l.amount ? (document.activeElement === input ? String(l.amount) : fmt(l.amount)) : '';
            }
        }
        renderSummary();
        if (isRecurring()) renderPay();
    }
    function addLine(cat) {
        var line = mk(cat);
        state.lines.push(line);
        renderRows();
        renderSummary();
        var input = byId('gvRows').querySelector('.gv-amt__input[data-key="' + line.key + '"]');
        if (input) input.focus();
        toast('已加入「' + cat + '」，請輸入金額');
    }
    function removeLine(key) {
        key = Number(key);
        state.lines = state.lines.filter(function (l) { return l.key !== key; });
        if (!state.lines.length) state.lines = freshLines(state.variant);
        renderRows();
        renderSummary();
        if (isRecurring()) renderPay();
    }
    function applyLast() {
        var gift = state.lastGift;
        if (!gift) return;
        var map = {}, order = [];
        (gift.lines || []).forEach(function (l) {
            if (!hasCat(l.category) || !(l.amount > 0) || map[l.category] || order.length >= MAX) return;
            var s = subFor(l.category), sub = l.others || '';
            if (s && s.type === 'select' && s.options.indexOf(sub) < 0) sub = '';
            map[l.category] = { amount: l.amount, sub: sub };
            order.push(l.category);
        });
        if (!order.length) return;
        state.lines = linesFromMap(map, state.variant, order);
        var mapped = LAST_PAY_MAP[gift.payWay];
        if (mapped && PAY_WAYS.indexOf(mapped) >= 0) state.pay = mapped;
        renderAll();
        toast('已帶入：' + order.map(function (c) { return c + ' ' + fmt(map[c].amount); }).join('、') + '，可直接修改');
    }

    // ==================== 對話框 ====================
    var lastFocus = null;
    function openSheet(id) {
        if (SHEETS.every(function (x) { return byId(x).hidden; })) lastFocus = document.activeElement;
        byId(id).hidden = false;
        document.documentElement.classList.add('gv-lock');
    }
    function closeSheet(id) {
        byId(id).hidden = true;
        if (SHEETS.some(function (x) { return !byId(x).hidden; })) return;
        document.documentElement.classList.remove('gv-lock');
        if (lastFocus && document.body.contains(lastFocus) && typeof lastFocus.focus === 'function') {
            try { lastFocus.focus({ preventScroll: true }); } catch (e) { }
        }
        lastFocus = null;
    }

    function openPicker() {
        byId('gvPickerSearch').value = '';
        renderPicker('');
        openSheet('gvPicker');
        setTimeout(function () { byId('gvPickerSearch').focus(); }, 60);
    }
    function renderPicker(query) {
        query = (query || '').trim();
        var present = state.lines.map(function (l) { return l.cat; });
        var full = activeLines().length >= MAX;
        var html = '';
        GROUPS.forEach(function (g) {
            var items = CATEGORIES.filter(function (c) { return groupFor(c) === g && (!query || c.indexOf(query) >= 0); });
            if (!items.length) return;
            html += '<div class="gv-pgroup"><h4>' + g + '</h4><div class="gv-plist">' + items.map(function (c) {
                var has = present.indexOf(c) >= 0;
                return '<button type="button" class="gv-pitem" data-pick="' + esc(c) + '"' + (has || full ? ' disabled' : '') + '><span>' + esc(c) + '</span>' +
                    (has ? '<span class="gv-pitem__added">已在清單</span>' : '') + '</button>';
            }).join('') + '</div></div>';
        });
        byId('gvPickerNote').textContent = full ? '已達 ' + MAX + ' 個類別上限，請先清除一個再加入。' : '';
        byId('gvPickerList').innerHTML = html ||
            '<div class="gv-pempty">找不到「' + esc(query) + '」。' + (hasCat('其他奉獻') ? '試試其他關鍵字，或選「其他奉獻」並說明用途。' : '試試其他關鍵字。') + '</div>';
    }

    function confirmLabel() {
        if (state.pay === ATM) return '確認送出，取得虛擬帳號';
        if (isRecurring()) return '確認建立定期定額';
        return '確認送出並前往付款';
    }
    function openConfirm() {
        if (issues().length) { renderSummary(); return; }
        var rec = isRecurring();
        byId('gvConfLines').innerHTML = activeLines().map(function (l) {
            return '<li><span>' + esc(l.cat) + (l.sub ? '<small>' + esc(l.sub) + '</small>' : '') + '</span><span>NT$ ' + fmt(l.amount) + '</span></li>';
        }).join('');
        byId('gvConfMeta').innerHTML = '<div><span>付款方式</span><b>' + esc(payText()) + '</b></div>' +
            (rec ? '<div><span>期數</span><b>' + state.period + ' 期，每月扣款</b></div>' : '') +
            (state.note ? '<div><span>備註</span><b>' + esc(state.note) + '</b></div>' : '');
        byId('gvConfTotal').innerHTML = '<span>' + (rec ? '每月總計' : '總計') + '</span><b>NT$ ' + fmt(total()) + '</b>';
        byId('gvConfirmError').hidden = true;
        var go = byId('gvConfirmGo');
        go.disabled = false;
        go.textContent = confirmLabel();
        openSheet('gvConfirm');
    }

    function paymentUrl(data) {
        var candidate = data.PaymentPageUrl || data.paymentPageUrl || data.RedirectUrl || data.redirectUrl || data.DedicationResult || data.dedicationResult || '';
        if (typeof candidate !== 'string') return '';
        candidate = candidate.trim();
        return /^https?:\/\//i.test(candidate) ? candidate : '';
    }
    function showSubmitError(message) {
        var box = byId('gvConfirmError');
        box.textContent = message;
        box.hidden = false;
        if (byId('gvConfirm').hidden) openSheet('gvConfirm');
        toast(message, 3200);
    }
    function showRedirect() {
        state.redirecting = true;
        closeSheet('gvConfirm');
        byId('gvAtmResult').hidden = true;
        byId('gvRedirect').hidden = false;
        openSheet('gvDone');
    }
    function showAtmResult(html) {
        closeSheet('gvConfirm');
        byId('gvRedirect').hidden = true;
        byId('gvAtmResult').hidden = false;
        openSheet('gvDone');
        var parsed = showAtmPaymentInfo(html);
        byId('gvDoneTitle').textContent = parsed ? '虛擬帳號已產生' : '付款資訊';
        // 收費單已建立：清空已送出的金額，避免重複送出同一筆奉獻。
        var mode = state.variant;
        state.lines = freshLines(mode);
        state.note = '';
        renderAll();
    }
    function handleSubmitResult(res) {
        var data = res.data || {};
        if (res.status === 409 && data.redirectUrl) { window.location.href = data.redirectUrl; return; }
        if (res.status === 401) { showSubmitError('登入已逾時，請重新登入後再奉獻。'); return; }
        if (!res.ok || !res.data) { showSubmitError(data.message || '系統發生錯誤，請稍後再試。'); return; }
        if (String(data.status) !== '1') { showSubmitError(data.message || '送出失敗，請稍後再試。'); return; }
        var payWay = data.PayWay || data.payWay || '';
        var url = paymentUrl(data);
        if (url) { showRedirect(); window.location.href = url; return; }
        if (payWay === CARD) { showSubmitError('金流未回傳信用卡付款頁，請稍後再試或聯絡教會同工。'); return; }
        showAtmResult(data.DedicationResult || data.dedicationResult || '');
    }
    function submitDonation() {
        if (state.pending || issues().length) return;
        state.pending = true;
        var go = byId('gvConfirmGo'), back = byId('gvConfirmBack');
        go.disabled = true;
        back.disabled = true;
        go.textContent = '送出中…';
        byId('gvConfirmError').hidden = true;

        // 欄位名稱是 DonationPaymentFormModel 的 MVC 繫結契約（Lines[i].*、PayWay、SelectedCreditCard、DeductTotalNumber、Explain）。
        var body = new URLSearchParams();
        activeLines().forEach(function (l, i) {
            body.append('Lines[' + i + '].Category', l.cat);
            body.append('Lines[' + i + '].Amount', String(l.amount));
            body.append('Lines[' + i + '].Others', l.sub || '');
        });
        body.append('PayWay', state.pay);
        body.append('SelectedCreditCard', state.card && state.card !== 'new' ? state.card : '');
        body.append('DeductTotalNumber', state.period + '個月');
        body.append('Explain', state.note || '');

        fetch('/Dedication/SaveDonationPaymentDedication', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: body.toString()
        })
            .then(readJson)
            .then(handleSubmitResult)
            .catch(function () { showSubmitError('網路連線失敗，請確認網路後再試一次。'); })
            .then(function () {
                state.pending = false;
                if (state.redirecting) return;
                go.disabled = false;
                back.disabled = false;
                go.textContent = confirmLabel();
                renderSummary();
            });
    }

    // ==================== 信用卡與定期定額管理 ====================
    function deleteCard(token) {
        if (!window.confirm('確定要刪除這張信用卡嗎？')) return;
        fetch('/Dedication/DeleteCreditCard', {
            method: 'DELETE',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'key=' + encodeURIComponent(token)
        })
            .then(function (r) {
                if (!r.ok) throw new Error('delete failed');
                state.cards = state.cards.filter(function (c) { return c.token !== token; });
                if (state.card === token) state.card = state.cards.length ? state.cards[0].token : 'new';
                renderPay();
                renderSummary();
                toast('已刪除信用卡');
            })
            .catch(function () { toast('刪除信用卡失敗，請稍後再試'); });
    }
    function cancelBooking(id) {
        if (!window.confirm('確定要取消這筆定期定額扣款嗎？取消後將不再自動扣款。')) return;
        fetch('/Dedication/DeleteDedicationBooking', {
            method: 'DELETE',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'key=' + encodeURIComponent(id)
        })
            .then(function (r) {
                if (!r.ok) throw new Error('cancel failed');
                state.bookings = state.bookings.filter(function (b) { return b.id !== id; });
                renderPay();
                toast('已送出取消定期定額');
            })
            .catch(function () { toast('取消定期定額失敗，請稍後再試'); });
    }

    // ==================== ATM 轉帳資訊（沿用既有卡片與複製按鈕） ====================
    var atmAccountNumber = '';
    var atmCopyResetTimer = null;

    // 將後端回傳的 HTML 字串依 <br/> 拆行並轉為純文字，避免直接以 innerHTML 插入頁面
    function htmlToPlainLines(html) {
        return String(html || '').split(/<br\s*\/?>/i).map(function (line) {
            return new DOMParser().parseFromString(line, 'text/html').body.textContent || '';
        });
    }
    // 解析「標籤 : 值」格式的 ATM 付款資訊（標籤內空白會移除，例如「帳號     」→「帳號」）
    function parseAtmPaymentInfo(html) {
        var fields = {};
        htmlToPlainLines(html).forEach(function (line) {
            var match = line.trim().match(/^([^:：]+?)\s*[:：]\s*(.+)$/);
            if (match) fields[match[1].replace(/\s+/g, '')] = match[2].trim();
        });
        return fields;
    }
    // 「807 永豐商業銀行」→ { code: "807", name: "永豐商業銀行" }
    function splitCodeAndName(value) {
        var match = String(value || '').match(/^(\d+)\s*(.*)$/);
        return match ? { code: match[1], name: match[2] } : { code: value || '', name: '' };
    }
    // 「1000元」→「1,000 元」；非數字格式則原樣顯示
    function formatAtmAmount(value) {
        var number = String(value || '').replace(/[,\s元]/g, '');
        return /^\d+(\.\d+)?$/.test(number) ? Number(number).toLocaleString('zh-TW') + ' 元' : (value || '');
    }
    function setAtmField(name, value) {
        var element = document.querySelector('#atm-card [data-atm-field="' + name + '"]');
        if (element) element.textContent = value || '';
    }
    // 帳號每 4 碼一組顯示，方便在 ATM 前核對
    function renderAtmAccountNumber(account) {
        var container = byId('atm-account-number');
        container.textContent = '';
        (account.match(/\d{1,4}/g) || []).forEach(function (group, index) {
            var span = document.createElement('span');
            span.className = 'atm-account__group';
            span.style.setProperty('--i', index);
            span.textContent = group;
            container.appendChild(span);
        });
    }
    function revealAtmPanel() {
        var panel = byId('atm-info');
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        panel.style.display = 'block';
        panel.classList.remove('is-revealed');
        void panel.offsetWidth;
        panel.classList.add('is-revealed');
        panel.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
    }
    // LINE 發送結果附在付款資訊之後；只顯示狀態與原因，不影響虛擬帳號解析。
    function renderLineResult(html) {
        var box = byId('gvLineResult');
        var lines = htmlToPlainLines(html).map(function (l) { return l.trim(); }).filter(function (l) { return l.length > 0; });
        box.hidden = true;
        for (var i = 0; i < lines.length; i++) {
            if (lines[i].indexOf('LINE 發送結果') === 0) {
                var status = lines[i].replace(/^LINE 發送結果\s*[:：]\s*/, '');
                box.textContent = 'LINE 通知：' + status + (lines[i + 1] ? '。' + lines[i + 1] : '');
                box.classList.toggle('is-ok', status.indexOf('成功') >= 0);
                box.hidden = false;
                return;
            }
        }
    }
    // 取得虛擬帳號時以結構化卡片呈現；解析不到帳號則退回純文字顯示
    function showAtmPaymentInfo(html) {
        renderLineResult(html);
        var fields = parseAtmPaymentInfo(html);
        var account = (fields['帳號'] || '').replace(/\D/g, '');
        if (!account) {
            showAtmMessage(html, false);
            return false;
        }
        var bank = splitCodeAndName(fields['銀行代碼']);
        var branch = splitCodeAndName(fields['分行代號']);
        atmAccountNumber = account;
        renderAtmAccountNumber(account);
        setAtmField('deadline', fields['付款到期日']);
        setAtmField('bank-code', bank.code);
        setAtmField('bank-name', bank.name);
        setAtmField('branch-code', branch.code);
        setAtmField('branch-name', branch.name);
        setAtmField('amount', formatAtmAmount(fields['金額']));
        setAtmField('account-name', fields['戶名']);
        setAtmField('donor', fields['姓名']);
        setAtmField('category', fields['名稱']);
        document.querySelector('#atm-card .atm-deadline').style.display = fields['付款到期日'] ? '' : 'none';
        resetCopyButton();
        byId('atmfield').style.display = 'none';
        byId('atm-card').style.display = '';
        revealAtmPanel();
        return true;
    }
    // 顯示錯誤或無法解析的訊息（純文字）
    function showAtmMessage(html, isError) {
        var field = byId('atmfield');
        atmAccountNumber = '';
        byId('atm-card').style.display = 'none';
        field.textContent = htmlToPlainLines(html).join('\n');
        field.classList.toggle('is-error', !!isError);
        field.style.display = '';
        revealAtmPanel();
    }
    function copyAtmAccount() {
        if (!atmAccountNumber) {
            toast('找不到可複製的虛擬帳號', 2500);
            return;
        }
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(atmAccountNumber).then(onAtmAccountCopied, function () {
                copyAtmAccountWithFallback(atmAccountNumber);
            });
        } else {
            copyAtmAccountWithFallback(atmAccountNumber);
        }
    }
    // 支援未啟用 Clipboard API 的瀏覽器與舊版手機瀏覽器
    function copyAtmAccountWithFallback(account) {
        var textArea = document.createElement('textarea');
        textArea.value = account;
        textArea.setAttribute('readonly', '');
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.select();
        var copied = false;
        try { copied = document.execCommand('copy'); } catch (e) { copied = false; } finally { document.body.removeChild(textArea); }
        if (copied) onAtmAccountCopied();
        else toast('無法複製虛擬帳號，請長按帳號後手動複製', 3000);
    }
    // 複製成功回饋：按鈕切換為「已複製」、帳號短暫亮起
    function onAtmAccountCopied() {
        var button = byId('copy-atm-account');
        var number = byId('atm-account-number');
        clearTimeout(atmCopyResetTimer);
        button.classList.add('is-copied');
        button.querySelector('.atm-copy__label').textContent = '已複製';
        number.classList.add('is-flash');
        setTimeout(function () { number.classList.remove('is-flash'); }, 450);
        atmCopyResetTimer = setTimeout(resetCopyButton, 2200);
        toast('虛擬帳號已複製', 2000);
    }
    function resetCopyButton() {
        clearTimeout(atmCopyResetTimer);
        var button = byId('copy-atm-account');
        button.classList.remove('is-copied');
        button.querySelector('.atm-copy__label').textContent = '複製虛擬帳號';
        byId('atm-account-number').classList.remove('is-flash');
    }

    // ==================== 奉獻清單 ====================
    function setView(view) {
        var give = view === 'give';
        byId('gvViewGive').hidden = !give;
        byId('gvViewList').hidden = give;
        [].forEach.call(document.querySelectorAll('#gvViewSeg button'), function (b) {
            var on = b.getAttribute('data-view') === view;
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        if (!give && !state.historyLoaded) loadHistory();
    }
    function renderHistory(data) {
        var rows = data.rows || [];
        byId('gvFeeBody').innerHTML = rows.length
            ? rows.map(function (r) {
                var detail = [];
                if (r.others) detail.push(esc(r.others));
                if (r.period) detail.push(/^\d+$/.test(r.period) ? '定期定額第 ' + esc(r.period) + ' 期' : '定期定額 ' + esc(r.period));
                return '<tr><td class="gv-date gv-num">' + esc(r.date) + '</td>' +
                    '<td>' + esc(r.category) + (detail.length ? '<small>' + detail.join(' · ') + '</small>' : '') + '</td>' +
                    '<td>' + esc(r.payWay) + '</td>' +
                    '<td class="gv-amtcell gv-num">' + fmt(r.amount) + '</td>' +
                    '<td><span class="gv-pill">已完成</span></td></tr>';
            }).join('')
            : '<tr><td colspan="5" class="gv-empty">這段期間沒有奉獻紀錄。</td></tr>';
        byId('gvFeeCount').textContent = rows.length + ' 筆';
        byId('gvFeeRange').textContent = (data.start || '') + ' ～ ' + (data.end || '');
        byId('gvFeeTotal').textContent = 'NT$ ' + fmt(data.total);
    }
    function loadHistory() {
        var start = byId('gvQStart').value, end = byId('gvQEnd').value;
        if (start && end && start > end) { toast('開始日期不能晚於結束日期'); return; }
        state.historyLoaded = true;
        var button = byId('gvQBtn');
        button.disabled = true;
        byId('gvFeeBody').innerHTML = '<tr><td colspan="5" class="gv-empty">查詢中…</td></tr>';
        fetch('/Dedication/GivingHistory?start=' + encodeURIComponent(start) + '&end=' + encodeURIComponent(end), {
            credentials: 'same-origin',
            headers: AJAX_HEADERS
        })
            .then(readJson)
            .then(function (res) {
                if (!res.ok || !res.data || !res.data.ok) throw new Error('history failed');
                renderHistory(res.data);
            })
            .catch(function () {
                state.historyLoaded = false;
                byId('gvFeeBody').innerHTML = '<tr><td colspan="5" class="gv-empty is-error">查詢失敗，請稍後再試。</td></tr>';
                byId('gvFeeCount').textContent = '';
                byId('gvFeeRange').textContent = '';
                byId('gvFeeTotal').textContent = 'NT$ 0';
            })
            .then(function () { button.disabled = false; });
    }

    // ==================== 常用類別與同上次（非同步載入，不影響奉獻操作） ====================
    function loadSummary() {
        fetch('/Dedication/GivingSummary', { credentials: 'same-origin', headers: AJAX_HEADERS })
            .then(readJson)
            .then(function (res) {
                var d = res.data;
                if (!res.ok || !d) return;
                var pinned = (d.pinned || []).filter(hasCat).slice(0, PINNED_COUNT);
                if (pinned.length && pinned.join('|') !== state.pinned.join('|')) {
                    state.pinned = pinned;
                    var typing = byId('gvRows').contains(document.activeElement);
                    if (state.variant === 'A' && !activeLines().length && !typing) {
                        state.lines = freshLines('A');
                        renderRows();
                        renderSummary();
                    }
                }
                var gift = d.lastGift;
                if (gift && (gift.lines || []).some(function (l) { return hasCat(l.category) && l.amount > 0; })) {
                    state.lastGift = gift;
                    renderRepeat();
                }
            })
            .catch(function () { });
    }

    // ==================== 事件 ====================
    function bind() {
        byId('gvViewSeg').addEventListener('click', function (e) {
            var b = e.target.closest('button[data-view]');
            if (b) setView(b.getAttribute('data-view'));
        });

        byId('gvModeSeg').addEventListener('click', function (e) {
            var b = e.target.closest('button[data-mode]');
            if (!b) return;
            var mode = b.getAttribute('data-mode');
            if (mode === state.variant) return;
            var current = currentMap();
            state.variant = mode;
            state.lines = linesFromMap(current.map, mode, current.order);
            saveMode(mode);
            renderAll();
            toast('輸入方式已改為「' + MODES[mode].name + '」，下次進來會記住');
        });

        byId('gvNote').addEventListener('input', function (e) { state.note = e.target.value; });
        byId('gvRepeat').addEventListener('click', applyLast);
        byId('gvAdd').addEventListener('click', function () {
            if (state.variant === 'A') { openPicker(); return; }
            var used = state.lines.map(function (l) { return l.cat; });
            var next = CATEGORIES.filter(function (c) { return used.indexOf(c) < 0; })[0];
            if (next && state.lines.length < MAX) addLine(next);
        });

        var rows = byId('gvRows');
        rows.addEventListener('input', function (e) {
            var t = e.target;
            if (t.classList.contains('gv-amt__input')) {
                var digits = t.value.replace(/\D/g, '').slice(0, 8);
                t.value = digits;
                setAmount(t.getAttribute('data-key'), Number(digits) || 0, t);
            } else if (t.hasAttribute('data-sub')) {
                var line = findLine(t.getAttribute('data-sub'));
                if (line) { line.sub = t.value; renderSummary(); }
            }
        });
        rows.addEventListener('change', function (e) {
            var t = e.target, line;
            if (t.classList.contains('gv-catsel')) {
                line = findLine(t.getAttribute('data-key'));
                if (!line) return;
                line.cat = t.value;
                line.sub = '';
                renderRows();
                renderSummary();
                if (isRecurring()) renderPay();
            } else if (t.hasAttribute('data-sub')) {
                line = findLine(t.getAttribute('data-sub'));
                if (line) { line.sub = t.value; renderSummary(); }
            }
        });
        rows.addEventListener('focusin', function (e) {
            var t = e.target;
            if (!t.classList.contains('gv-amt__input')) return;
            var line = findLine(t.getAttribute('data-key'));
            t.value = line && line.amount ? String(line.amount) : '';
            var row = t.closest('.gv-row');
            if (row) row.classList.add('is-focused');
            setTimeout(function () { try { t.select(); } catch (err) { } }, 0);
        });

        // 指標按住期間不收合快速金額列：收合會讓下方按鈕在 mousedown 與 mouseup 之間位移，造成要點兩次。
        var pointerHeld = false, deferredCollapse = null;
        function releasePointer() {
            pointerHeld = false;
            if (deferredCollapse) { var fn = deferredCollapse; deferredCollapse = null; fn(); }
        }
        document.addEventListener('pointerdown', function () { pointerHeld = true; }, true);
        document.addEventListener('pointerup', function () { setTimeout(releasePointer, 0); }, true);
        document.addEventListener('pointercancel', function () { setTimeout(releasePointer, 0); }, true);

        rows.addEventListener('focusout', function (e) {
            var t = e.target;
            if (!t.classList.contains('gv-amt__input')) return;
            var line = findLine(t.getAttribute('data-key'));
            t.value = line && line.amount ? fmt(line.amount) : '';
            var row = t.closest('.gv-row');
            var collapse = function () { if (row) row.classList.remove('is-focused'); };
            if (pointerHeld) deferredCollapse = collapse; else collapse();
        });
        rows.addEventListener('mousedown', function (e) { if (e.target.closest('.gv-chip')) e.preventDefault(); });
        rows.addEventListener('click', function (e) {
            var chip = e.target.closest('.gv-chip');
            if (chip) {
                var line = findLine(chip.getAttribute('data-key'));
                if (line && line.amount === 0 && activeLines().length >= MAX) { toast('一次最多 ' + MAX + ' 個類別'); return; }
                setAmount(chip.getAttribute('data-key'), Number(chip.getAttribute('data-chip')));
                return;
            }
            var x = e.target.closest('.gv-row__x');
            if (!x) return;
            if (x.getAttribute('data-act') === 'clear') setAmount(x.getAttribute('data-key'), 0);
            else removeLine(x.getAttribute('data-key'));
        });

        byId('gvPay').addEventListener('change', function (e) {
            state.pay = e.target.value;
            renderPay();
            renderSummary();
        });
        var detail = byId('gvPayDetail');
        detail.addEventListener('change', function (e) {
            var t = e.target;
            if (t.name === 'gvCard') { state.card = t.value; renderPay(); renderSummary(); }
            else if (t.id === 'gvPeriod') { state.period = Number(t.value) || 12; renderSummary(); }
        });
        detail.addEventListener('click', function (e) {
            var del = e.target.closest('[data-del-card]');
            if (del) { e.preventDefault(); e.stopPropagation(); deleteCard(del.getAttribute('data-del-card')); return; }
            var cancel = e.target.closest('[data-cancel-booking]');
            if (cancel) { e.preventDefault(); cancelBooking(cancel.getAttribute('data-cancel-booking')); return; }
            if (e.target.closest('[data-act="keepFirst"]')) {
                activeLines().slice(1).forEach(function (l) { l.amount = 0; });
                renderRows();
                renderPay();
                renderSummary();
            }
        });

        byId('gvCta').addEventListener('click', openConfirm);
        byId('gvConfirmBack').addEventListener('click', function () { if (!state.pending) closeSheet('gvConfirm'); });
        byId('gvConfirmGo').addEventListener('click', submitDonation);
        byId('gvDoneClose').addEventListener('click', function () { closeSheet('gvDone'); });
        byId('copy-atm-account').addEventListener('click', copyAtmAccount);

        byId('gvPickerSearch').addEventListener('input', function (e) { renderPicker(e.target.value); });
        byId('gvPickerList').addEventListener('click', function (e) {
            var b = e.target.closest('.gv-pitem');
            if (!b || b.disabled) return;
            closeSheet('gvPicker');
            addLine(b.getAttribute('data-pick'));
        });
        ['gvPicker', 'gvConfirm'].forEach(function (id) {
            byId(id).addEventListener('click', function (e) {
                if (state.pending) return;
                if (e.target === byId(id) || e.target.closest('[data-close]')) closeSheet(id);
            });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape' || state.pending || state.redirecting) return;
            ['gvPicker', 'gvConfirm'].forEach(function (id) { if (!byId(id).hidden) closeSheet(id); });
        });

        byId('gvQBtn').addEventListener('click', loadHistory);
    }

    // ==================== 啟動 ====================
    // 對話框與提示移到 body 底下，避免任何祖先元素的 transform／overflow 影響固定定位。
    ['gvPicker', 'gvConfirm', 'gvDone', 'gvToast'].forEach(function (id) {
        var el = byId(id);
        if (el) document.body.appendChild(el);
    });
    byId('gvQStart').value = DATA.yearStart || '';
    byId('gvQEnd').value = DATA.today || '';
    state.lines = freshLines(state.variant);
    bind();
    renderAll();
    loadSummary();
})();
</script>
