@*
    檔案整體說明

    目的與定位：顯示所選小組學員的裝備狀態與詳細上課資料入口，保留學員及小組正式ID的關聯。

    主要功能與流程：
    本頁引用的控制器／動作包含 Equipment、LoadEquipmentContact；實際網址及參數以頁內設定為準。
    元件事件交給 OnRowPrepared，維護時須一併核對宣告、載入順序與元件ID。

    使用邊界與維護：畫面僅呈現目前請求取得的資料；使用者輸入與元件傳回值仍須在伺服器驗證。
    修改模型、元素ID、路由或callback時，須同步檢查引用此頁的父頁／控制器；非同步回應不能覆寫較新畫面狀態。
    本段使用Razor註解，編譯後不會將維護說明或內部路徑傳到瀏覽器。
*@
@{
    String DataStatus = "上傳成功了!";
    //String ReUpload = "請再按上傳一次!";
    String ReUpload = "您有一些操作沒有完成，請檢查一下剛剛輸入的資料!";
}

@using ChurchReport.Models

<head>
    <!-- Site made with Mobirise Website Builder v4.0.16, https://mobirise.com -->
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="generator" content="Mobirise v4.0.16, mobirise.com">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <meta name="description" content="">
    <title>好牧人</title>
    @*<title>好牧人</title>*@

</head>

<div id="data-grid">
    @(Html.DevExtreme().DataGrid<EquipmentContact>()
            //.ID("ContactContainer")
            //.AllowColumnResizing(true)
            //.AllowColumnReordering(true)
            //.ColumnAutoWidth(true)
            .ColumnAutoWidth(true)
            .ColumnFixing(c => c.Enabled(true))
            .NoDataText("沒有資料")
            .ShowBorders(true)
            .ShowRowLines(true)
            .ShowColumnLines(true)
            //.ColumnMinWidth(80)
            //.Grouping( d=>d.AutoExpandAll(true))

            .Sorting(sorting => sorting.Mode(GridSortingMode.Multiple).ShowSortIndexes(true))
            .OnRowPrepared("OnRowPrepared")

            .DataSource(d => d
                .Mvc()
                .Controller("Equipment")
                .LoadAction("LoadEquipmentContact")
                .Key("EquipmentContactId")
                .LoadParams(new { id = new JS("data.SmallGroupListEntityId") })
        )

        .Editing(editing =>
        {
            //editing.Mode(GridEditMode.Row);
            //editing.Mode(GridEditMode.Cell);
            //editing.Mode(GridEditMode.Batch);
            //editing.Mode(GridEditMode.Form);
            //editing.Mode(GridEditMode.Popup);
            //editing.AllowUpdating(true);
            //editing.AllowDeleting(true);
            //editing.AllowAdding(true);
            //editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("確定").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除").ConfirmDeleteTitle("確定要刪除嗎?").ConfirmDeleteMessage("刪除幸福小組週報"));
            //editing.AllowDeleting(true);
        })


        .Columns(columns =>
        {
            columns.AddFor(m => m.ContactFullName)
            .Caption("姓名")
            .Width(100)
            .MinWidth(30);

            columns.AddFor(m => m.EquipmentStatus)
            .Caption("裝備狀態")
            .Width(400)
            .MinWidth(50);
        })

        .MasterDetail(md =>
        {
                md.Enabled(true);
                md.AutoExpandAll(true); // 修改: 預設展開所有聯絡人的課程記錄
                md.Template(@<text>
                @(Html.Partial("EquipmentStorLessonsView"))
                </text>);

            })
    )
</div>

<script>
    function OnRowPrepared(e) {
        e.rowElement.css({ height: 25 });
        e.rowElement.css('font-size', '17px');
        e.rowElement.css('font-family', '標楷體');
        e.rowElement.css('color', 'rgb(20,57,20)');

        if (e.rowType == 'data') {
            //e.rowElement.css('background', '#fff2a8');
            e.rowElement[0].addEventListener("mouseover", function () {
                e.rowElement.css('background', '#fff2a8');
                e.rowElement.css("transition", "background-color 0.5s");
            });
            e.rowElement[0].addEventListener("mouseleave", function () {
                e.rowElement[0].style.background = ""
            });
        }
    }
</script>
