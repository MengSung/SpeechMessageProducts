@using ChurchReport.Models
@model DonationPaymentFormModel

@{
    // 頁面標題：奉獻稽核頁面
    ViewData["Title"] = "奉獻稽核";
}

<style>
    .dedication-audit-page {
        --action-button-height: 48px;
        --theme-primary: #0f766e;
        --theme-border: #d9e6f2;
        --theme-surface: #ffffff;
        --theme-text: #0f172a;
        --theme-muted: #64748b;
        --theme-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        color: var(--theme-text);
        padding: 12px 10px 20px;
    }

    .dedication-audit-card {
        background: var(--theme-surface);
        border: 1px solid var(--theme-border);
        border-radius: 16px;
        box-shadow: var(--theme-shadow);
        padding: 14px 16px;
        margin-bottom: 12px;
    }

    .dedication-audit-header {
        background: linear-gradient(145deg, #f0fdfa 0%, #f8fafc 58%, #ecfeff 100%);
    }

    .dedication-audit-title {
        margin: 0;
        color: var(--theme-primary);
        font-size: 1.12rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .dedication-audit-tip {
        margin-top: 8px;
        color: var(--theme-muted);
        font-size: .9rem;
    }

    #form-container_Date .dx-field-item-label-text,
    #samenamecontainer .dx-datagrid-text-content,
    #data-grid .dx-datagrid-text-content {
        font-weight: 600;
    }

    #form-container_Date .dx-field-item-label {
        padding-right: 10px;
    }

    #form-container_Date .dx-field-item-label-text {
        line-height: 1.35;
    }

    .dedication-audit-page .dx-texteditor.dx-state-focused,
    .dedication-audit-page .dx-texteditor.dx-state-hover {
        box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.14);
        border-radius: 8px;
    }

    #buttonContainer3 {
        display: flex;
        justify-content: flex-start;
        margin: 8px 0 14px;
    }

    #buttonContainer3 .dx-button,
    #save-button3.dx-button {
        min-width: 136px;
        height: var(--action-button-height);
        border-radius: 999px;
        display: inline-flex;
        align-items: stretch;
        padding: 0;
        box-sizing: border-box;
        box-shadow: 0 8px 18px rgba(15, 118, 110, 0.3);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    #buttonContainer3 .dx-button-content,
    #save-button3 .dx-button-content {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex: 1 1 auto;
        height: 100% !important;
        padding: 0 24px !important;
        box-sizing: border-box;
    }

    #buttonContainer3 .dx-button-content::after,
    #save-button3 .dx-button-content::after {
        display: none !important;
    }

    #buttonContainer3 .dx-button-text,
    #save-button3 .dx-button-text {
        display: inline !important;
        height: auto !important;
        line-height: normal !important;
        margin: 0 !important;
        transform: none !important;
        vertical-align: middle !important;
    }

    #buttonContainer3 .dx-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(15, 118, 110, 0.34);
    }

    #SameNameList .dx-datagrid-headers,
    #DedicationFeeGrid .dx-datagrid-headers {
        border-radius: 10px;
        overflow: hidden;
    }

    #SameNameList .dx-datagrid-headers .dx-header-row td,
    #DedicationFeeGrid .dx-datagrid-headers .dx-header-row td {
        background: #e6f6f4;
        color: #0f172a;
        font-weight: 700;
        padding-top: 11px;
        padding-bottom: 11px;
    }

    #SameNameList .dx-datagrid-rowsview .dx-row > td,
    #DedicationFeeGrid .dx-datagrid-rowsview .dx-row > td {
        padding-top: 10px;
        padding-bottom: 10px;
        vertical-align: middle;
    }

    #SameNameList .dx-datagrid-rowsview .dx-data-row:hover > td,
    #DedicationFeeGrid .dx-datagrid-rowsview .dx-data-row:hover > td {
        background-color: #e6f6f4;
    }

    #SameNameList .dx-selection > td,
    #SameNameList .dx-row-focused > td,
    #DedicationFeeGrid .dx-selection > td,
    #DedicationFeeGrid .dx-row-focused > td {
        background-color: #d1fae5 !important;
    }

    #DedicationFeeGrid .dx-datagrid-rowsview .dx-data-row.dx-row-alt {
        background-color: #f8fafc;
    }

    .section-title {
        margin: 0 0 10px;
        color: var(--theme-primary);
        font-size: 1rem;
        font-weight: 700;
    }

    #displayamountfield {
        margin: 0;
        color: #b91c1c;
        font-size: 1.6rem;
        font-weight: 700;
        text-align: left;
    }

    #ToastContainer .dx-toast-message {
        border-radius: 10px;
        font-size: .92rem;
    }

    @@media (max-width: 430px) {
        .dedication-audit-page {
            padding: 8px 4px 14px;
        }

        .dedication-audit-card {
            border-radius: 12px;
            padding: 10px;
        }

        .dedication-audit-title {
            font-size: 1rem;
        }

        #buttonContainer3 {
            position: static;
            justify-content: flex-start;
            margin-bottom: 10px;
        }

        #buttonContainer3 .dx-button,
        #save-button3.dx-button {
            width: auto;
            min-width: 96px;
            height: var(--action-button-height);
            min-height: var(--action-button-height);
        }

        #buttonContainer3 {
            width: auto;
        }

        #buttonContainer3 .dx-button-content,
        #save-button3 .dx-button-content {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex: 1 1 auto;
            height: 100% !important;
            padding: 0 28px !important;
        }

        #buttonContainer3 .dx-button-content::after,
        #save-button3 .dx-button-content::after {
            display: none !important;
        }

        #buttonContainer3 .dx-button .dx-button-text,
        #save-button3 .dx-button-text {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 2px;
            display: inline !important;
            height: auto !important;
            line-height: normal !important;
            margin: 0 !important;
            transform: none !important;
            vertical-align: middle !important;
        }

        #SameNameList .dx-datagrid-headers .dx-header-row td,
        #DedicationFeeGrid .dx-datagrid-headers .dx-header-row td,
        #SameNameList .dx-datagrid-rowsview .dx-row > td,
        #DedicationFeeGrid .dx-datagrid-rowsview .dx-row > td {
            font-size: .86rem;
            padding-top: 8px;
            padding-bottom: 8px;
        }

        /* 手機版表單：標籤置於輸入框上方（JS 切換 labelLocation: top），輸入框滿版 16px */
        .dedication-audit-page .dx-layout-manager .dx-label-h-align.dx-flex-layout {
            flex-direction: column;
            align-items: stretch;
        }

        .dedication-audit-page .dx-layout-manager .dx-label-h-align .dx-field-item-label,
        .dedication-audit-page .dx-layout-manager .dx-label-h-align .dx-field-item-content {
            display: block;
            width: auto !important;
        }

        .dedication-audit-page .dx-field-item-label {
            font-size: 15px;
            font-weight: 600;
            padding-right: 12px;
            padding-bottom: 4px;
        }

        .dedication-audit-page .dx-field-item-label-location-top {
            padding-bottom: 2px;
        }

        .dedication-audit-page #form-container_Date .dx-field-item-content {
            padding-left: 4px;
        }

        .dedication-audit-page .dx-texteditor {
            width: 100% !important;
        }

        .dedication-audit-page .dx-texteditor-input {
            font-size: 16px;
            padding: 11px 10px;
        }

        .dedication-audit-page .dx-placeholder {
            font-size: 16px;
            display: flex;
            align-items: center;
        }

        .dedication-audit-page .dx-placeholder::before {
            padding-top: 0;
            padding-bottom: 0;
        }
    }
</style>

<script src="~/js/ActionButtonCentering.js"></script>

<div class="dedication-audit-page">

<!-- 頁面標題區域 -->
<div class="dedication-audit-card dedication-audit-header" style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
    <h4 id="displaynamefield" class="dedication-audit-title">奉獻稽核</h4>
    <div class="dedication-audit-tip">可用日期或個人資料查詢，快速檢視奉獻與總額。</div>
</div>

<!-- 主表單：處理奉獻稽核查詢 -->
<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="AuditQueryDedication" asp-controller="DedicationAudit" method="post">
    <!-- 隱藏按鈕與UI元件容器 -->
    <div class="dx-field">
        <!-- 隱藏查詢按鈕（由JavaScript觸發） -->
        <div id="buttonContainer" class="dx-button-icon">
            @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Visible(false)
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                    .OnClick("ShowLoadPanel")
            )
        </div>

        <!-- Toast通知元件：顯示成功/錯誤訊息 -->
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )
        </div>

        <!-- 載入面板：顯示載入狀態 -->
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container_Date"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
            )
        </div>
    </div>

    <!-- 表單容器：包含查詢條件輸入欄位 -->
    <div id="form-container_Date" class="dedication-audit-card">
        @(Html.DevExtreme().Form<DonationPaymentFormModel>()
        .ID("form")
        .ColCount(1)
        .Items
        (items =>
        {
            // 開始日期選擇器
            items.AddSimpleFor
                (m => m.QueryStartDate)
                .Label(l => l.Text("開始日期"))
                .IsRequired(false)
                .Editor(e => e
                    .DateBox()
                    .Width(200)
                    .DisplayFormat("yyyy/M/d")
                    .Disabled(false)
                    .Placeholder("開始日期")
                    .PickerType(DateBoxPickerType.Calendar)
                );

            // 結束日期選擇器
            items.AddSimpleFor
                (m => m.QueryEndDate)
                .Label(l => l.Text("結束日期"))
                .IsRequired(false)
                .Editor(e => e
                    .DateBox()
                    .Width(200)
                    .DisplayFormat("yyyy/M/d")
                    .Disabled(false)
                    .Placeholder("結束日期")
                    .PickerType(DateBoxPickerType.Calendar)
                );

            // 奉獻編號輸入框
            items.AddSimpleFor(m => m.DedicationNumber)
                 .Label(l => l.Text("奉獻編號"))
                 .Editor(e => e
                     .TextBox()
                     .Width(120)
                     .Disabled(false)
                     .Placeholder("輸入奉獻編號")
                     .FocusStateEnabled(true)
                );

            // 身份證字號輸入框
            items.AddSimpleFor(m => m.NationId)
                  .Label(l => l.Text("身份證字號"))
                  .Editor(e => e
                      .TextBox()
                      .Width(120)
                      .Disabled(false)
                      .Placeholder("輸入身份證字號")
                      .FocusStateEnabled(true)
                 );

            // 姓名輸入框
            items.AddSimpleFor(m => m.FullName)
                 .Label(l => l.Text("姓名"))
                 .Editor(e => e
                     .TextBox()
                     .Width(120)
                     .Disabled(false)
                     .Placeholder("輸入姓名")
                  );

            // 電話號碼輸入框（含遮罩驗證）
            items.AddSimpleFor(m => m.Mobile)
                   .Label(l => l.Text("電話號碼"))
                   .Editor(e => e
                       .TextBox()
                       .Width(120)
                       .MaskRules(new { X = new JS("/[02-9]/") })
                       .Placeholder("輸入電話號碼")
                   );

            // 帳戶後六碼輸入框（含遮罩驗證）
            items.AddSimpleFor(m => m.LastSixDigit)
                   .Label(l => l.Text("帳戶後六碼"))
                   .Editor(e => e
                       .TextBox()
                       .Width(120)
                       .MaskRules(new { X = new JS("/[02-9]/") })
                       .Placeholder("輸入帳戶後六碼")
                   );

            // 隱藏的點擊類型欄位（用於區分查詢或上傳）
            items.AddSimpleFor(m => m.ClickType)
               .Label(l => l.Text("查詢或上傳").Visible(false))
               .Editor(e => e
                   .TextBox()
                   .Width(120).Visible(false)
                   .Placeholder("查詢或上傳")
              );
        })
        // 表單內容準備完成後驗證
        .OnContentReady
        (@<text>
            function(e)
            {
                e.component.validate();
            }
        </text>)
        // 綁定模型資料
        .FormData(Model)
        )
    </div>

    <!-- 查詢按鈕 -->
    <div id="buttonContainer3" class="dx-button-icon">
        @(Html.DevExtreme().Button()
                    .Text("查詢")
                    .Visible(true)
                    .Type(ButtonType.Success)
                    .ID("save-button3")
                .OnInitialized("onActionButtonInitialized")
                    .UseSubmitBehavior(true)
                    .OnClick("OnClickQuery")
            )
    </div>

    <!-- 同名連絡人清單容器 -->
    <div id="samenamecontainer" class="dedication-audit-card" style="font-family:標楷體;font-size:100%; color:darkcyan; text-align:left;font-weight:bold">
        <h5 id="samenamefield">查詢結果</h5>

        @(Html.DevExtreme().DataGrid<SameNameElement>()
                            .ID("SameNameList")
                            .ShowBorders(true)
                            .Paging(paging => paging.Enabled(false))
                            .AllowColumnResizing(true)
                            .ColumnResizingMode(ColumnResizingMode.Widget)
                            .ColumnFixing(c => c.Enabled(true))
                            .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
                            .ShowColumnLines(true)
                            .ShowRowLines(true)
                            .ShowBorders(true)
                            .Selection(selection => selection.Mode(SelectionMode.Single))
                            .OnRowClick("OnRowClick")
                            .OnSelectionChanged("OnRowSelectionChanged")
                            .HoverStateEnabled(true)
                            .Editing(editing =>
                            {
                                editing.AllowDeleting(true);
                                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("選擇").DeleteRow("刪除"));
                            })
                            .Columns(columns =>
                            {
                                columns.AddFor(m => m.DedicationNumber).Caption("奉獻編號").Width(100).MinWidth(100).Fixed(true);
                                columns.AddFor(m => m.NationId).Caption("身分證字號").Width(100).MinWidth(100).Fixed(true);
                                columns.AddFor(m => m.FullName).Caption("姓名").Width(100).MinWidth(100).Fixed(true);
                                columns.AddFor(m => m.Mobile).Caption("電話").Width(100).MinWidth(100);
                                columns.AddFor(m => m.SmallGroupName).Caption("所屬小組").Width(100).MinWidth(100);
                            })
                            .DataSource(d => d
                            .WebApi()
                            .Controller("DedicationAudit")
                            .LoadAction("LoadSameNameList")
                            .DeleteAction("DeleteSameNameContact")
                            .Key("SameNameElementId")
                            )
                            .OnContentReady(
                            @<text>
                                function(e)
                                {
                                    // 編輯欄位移至左側（若需要）
                                }
                            </text>
                            )
                            .OnCellPrepared("cell_prepared")
                            )
    </div>

    <!-- 奉獻清單顯示容器 -->
    <div id="data-grid" class="dedication-audit-card">
        <div class="section-title">奉獻清單</div>
        @(Html.DevExtreme().DataGrid<DedicationFee>()
            .ID("DedicationFeeGrid")
            .ShowBorders(true)
            .Paging(paging => paging.Enabled(false))
            .AllowColumnResizing(true)
            .ColumnResizingMode(ColumnResizingMode.Widget)
            .ColumnFixing(c => c.Enabled(true))
            .LoadPanel(l => l.Text("更新資料中...").Enabled(false))
            .SearchPanel(s => s.Visible(false).Placeholder("搜尋.."))
            .Export(e => e.Enabled(true).AllowExportSelectedData(true))
            .ShowColumnLines(true)
            .ShowRowLines(true)
            .RowAlternationEnabled(true)
            .ShowBorders(true)
            .RemoteOperations(ro => ro.Filtering(false)    // 客戶端過濾
                .Sorting(false)   // 客戶端排序
                .Paging(false)    // 客戶端分頁
                .Grouping(false)  // 客戶端分組
                .Summary(false)   // 客戶端匯總
                // CRUD 操作默認為 true，會發送到服務器 ✅ ) 取代
             )
             .TwoWayBindingEnabled(true)
            .Editing(editing =>
            {
                editing.Mode(GridEditMode.Cell);
                editing.AllowUpdating(true);
                editing.Texts(a => a.SaveAllChanges("上傳檔案").AddRow("新增").CancelAllChanges("取消變更").SaveRowChanges("儲存").CancelRowChanges("取消").EditRow("編輯").DeleteRow("刪除"));
            })
            .Columns(columns =>
            {
                columns.AddFor(m => m.Category).Caption("奉獻類別").Width(50).MinWidth(80).AllowEditing(false).AllowSorting(true);
                columns.AddFor(m => m.DedicationDate).Caption("奉獻日期").Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("yyyy/M/d").Width(100).MinWidth(45).AllowEditing(false).AllowSorting(true).Visible(false)
                            .CalculateCellValue(@<text>
                                        function(row)
                                        {
                                            if( row.DedicationDate != null )
                                            {
                                                var ParsedDate = ParsingDate( row.DedicationDate );
                                                if( ParsedDate.getFullYear() == 1901 )
                                                {
                                                    return null;
                                                }
                                                else
                                                {
                                                    return ParsedDate;
                                                }
                                            }
                                            else
                                            {return null;}
                                        }
                             </text> );
                columns.AddFor(m => m.PayDate).Caption("付款日期").Alignment(HorizontalAlignment.Center).DataType(GridColumnDataType.Date).Format("yyyy/M/d").Width(100).MinWidth(45).AllowEditing(false).AllowSorting(true)
                                .CalculateCellValue(@<text>
                                        function(row)
                                        {
                                            if( row.PayDate != null )
                                            {
                                                var ParsedDate = ParsingDate( row.PayDate );
                                                if( ParsedDate.getFullYear() == 1901 )
                                                {
                                                    return null;
                                                }
                                                else
                                                {
                                                    return ParsedDate;
                                                }
                                            }
                                            else
                                            {return null;}
                                        }
                             </text> );

                    columns.AddFor(m => m.PayWay).Caption("付款方式").Alignment(HorizontalAlignment.Center).Width(80).MinWidth(80).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.Amount).Caption("金額").Width(80).MinWidth(80).AllowEditing(false).AllowSorting(true);
                    columns.AddFor(m => m.Others).Caption("奉獻細項").Alignment(HorizontalAlignment.Left).Width(180).MinWidth(180).AllowEditing(false).AllowSorting(true);
            })
                            .DataSource(d => d
                            .WebApi()
                            .Controller("DedicationAudit")
                            .LoadAction("LoadDedicationFeeList")
                            )
            )
    </div>

    <!-- 總金額顯示區域（按查詢後才顯示） -->
    <div id="amountcontainer" class="dedication-audit-card" style="font-family:標楷體;font-size:100%; color:darkred; text-align:left;font-weight:bold; display:none;">
        <h4 id="displayamountfield"></h4>
    </div>
</form>

<!-- 腳本區域 -->
<div id="samenamecontainer_script" style="font-family:標楷體;font-size:100%; color: darkslateblue; text-align:left;font-weight:bold">
    <h5 id="resultfield"></h5>

    <!-- 頁面初始化腳本 -->
    <script>
        // 頁面載入完成後初始化
        window.onload = function (e) {
            // 清空表單欄位並聚焦到奉獻編號
            $("#form").dxForm("instance").updateData('DedicationNumber', "");
            $("#form").dxForm("instance").updateData('NationId', "");
            $("#form").dxForm("instance").updateData('FullName', "");
            $("#form").dxForm("instance").updateData('Mobile', "");
            $("#form").dxForm("instance").updateData('LastSixDigit', "");
            $("#form").dxForm("instance").getEditor('DedicationNumber').focus();

            // 隱藏同名清單與奉獻清單
            document.getElementById("samenamecontainer").style.display = "none";
            document.getElementById("data-grid").style.display = "none";
            document.getElementById("amountcontainer").style.display = "none";

            scheduleCenterActionButtons(["save-button3"]);
        };

        // 手機窄螢幕：表單標籤改置於輸入框上方，避免左右欄位互相擠壓變形
        $(function () {
            if (window.matchMedia && window.matchMedia('(max-width: 430px)').matches) {
                var inst = $('#form').length ? $('#form').dxForm('instance') : null;
                if (inst) { inst.option('labelLocation', 'top'); }
            }

            scheduleCenterActionButtons(["save-button3"]);
            setTimeout(function () { scheduleCenterActionButtons(["save-button3"]); }, 120);
            setTimeout(function () { scheduleCenterActionButtons(["save-button3"]); }, 300);
        });
    </script>

    <!-- 共用函式與事件處理 -->
    <script>
        // ========== 共用函式與設定 (已加註解，勿刪功能) ==========
        // 快取常用 DOM 與 DevExtreme 實例，減少重複查詢以提升效能
        var $formSelector = "#form";
        var $sameNameGridSelector = "#SameNameList";
        var $feeGridSelector = "#DedicationFeeGrid";
        var $loadPanelSelector = "#loadPanel";
        var $toastSelector = "#toast";

        // 取得 LoadPanel 實例（短函式以方便使用）
        function getLoadPanelInstance() {
            return $($loadPanelSelector).dxLoadPanel("instance");
        }

        // 簡化 Toast 顯示：接收訊息、類型與顯示時間
        function ShowToast(message, type, displayTime) {
            var toast = $($toastSelector).dxToast("instance");
            if (!toast) return;
            toast.option({
                message: message,
                type: type,
                displayTime: displayTime || 3000,
                closeOnClick: true
            });
            toast.show();
        }

        // 將伺服器可能回傳的日期格式統一解析為 JS Date
        function parseServerDate(value) {
            if (!value) return null;
            if (value instanceof Date) return value;
            if (typeof value === 'number') return new Date(value);
            var msDateMatch = /\/Date\((\d+)(?:[+-]\d+)?\)\//.exec(value);
            if (msDateMatch) {
                return new Date(parseInt(msDateMatch[1], 10));
            }
            var d = new Date(value);
            if (!isNaN(d.getTime())) return d;
            var n = parseInt(value, 10);
            if (!isNaN(n)) return new Date(n);
            return null;
        }

        // 清空表單基本欄位（呼叫於顯示完 DedicationFeeGrid 之後）
        function clearFormBasicFields() {
            var form = $($formSelector).dxForm("instance");
            if (!form) return;
            try {
                // 明確列出要清空的欄位，避免不必要影響其他欄位
                form.updateData('DedicationNumber', '');
                form.updateData('NationId', '');
                form.updateData('FullName', '');
                form.updateData('Mobile', '');
                form.updateData('LastSixDigit', '');
                form.updateData('ClickType', '');
                // 將焦點放回奉獻編號，提高使用者操作效率
                try { form.getEditor('DedicationNumber').focus(); } catch (e) { }
            } catch (e) {
                console.warn('clearFormBasicFields error', e);
            }
        }

        // 更新 DedicationFeeGrid 的資料與顯示，接收已解析過日期的陣列
        function updateFeeGrid(fees) {
            var grid = $($feeGridSelector).dxDataGrid("instance");
            if (!grid) {
                console.warn('DedicationFeeGrid instance not found');
                return;
            }

            try {
                // 直接設定 dataSource 為陣列，DevExtreme 會自動處理
                grid.option('dataSource', fees || []);

                // 嘗試刷新與 repaint，確保 UI 更新
                try { grid.refresh(); } catch (e) { console.warn('grid.refresh() failed', e); }
                try { grid.repaint(); } catch (e) { console.warn('grid.repaint() failed', e); }
            } catch (e) {
                console.error('updateFeeGrid error', e);
                ShowToast('更新清單失敗，請查看 console', 'error', 5000);
            }
        }

        // 從後端取得指定 contact 的奉獻清單（回傳 Promise）
        function fetchFeesByContactId(contactId) {
            return $.ajax({
                url: '/DedicationAudit/GetFeesByContactId',
                method: 'GET',
                data: { id: contactId },
                dataType: 'json'
            });
        }

        // 共用：處理使用者在同名清單選擇一筆後的流程
        function handleSameNameSelection(data) {
            if (!data) return;

            // 先在表單顯示選中的欄位（短暫顯示，之後會被 clearFormBasicFields 清空）
            var form = $($formSelector).dxForm("instance");
            if (form) {
                form.updateData('DedicationNumber', data.DedicationNumber || "");
                form.updateData('NationId', data.NationId || "");
                form.updateData('FullName', data.FullName || "");
                form.updateData('Mobile', data.Mobile || "");
            }

            // 取消 SameNameList 選取，以免 UI 卡住
            try { $($sameNameGridSelector).dxDataGrid("instance").deselectAll(); } catch (e) { }

            // 顯示載入訊息
            ShowToast('正在載入 ' + (data.FullName || '') + ' 的奉獻記錄...', 'info', 2000);
            getLoadPanelInstance().show();

            var contactId = data.SameNameElementId;
            if (!contactId) {
                getLoadPanelInstance().hide();
                ShowToast('缺少聯絡人 Id', 'error', 3000);
                return;
            }

            // 取得清單，並在成功後顯示於 grid，最後清空表單欄位（依使用者要求）
            fetchFeesByContactId(contactId).done(function (resp) {
                getLoadPanelInstance().hide();
                if (!resp || String(resp.status) !== '1' || !Array.isArray(resp.DedicationFeeList)) {
                    ShowToast('未找到奉獻清單', 'warning', 3000);
                    return;
                }

                // 將伺服器返回的日期欄位解析成 JS Date，避免格式化問題
                var fees = resp.DedicationFeeList.map(function(item) {
                    var copy = Object.assign({}, item);
                    try { copy.DedicationDate = parseServerDate(copy.DedicationDate); } catch(e) { copy.DedicationDate = null; }
                    try { copy.PayDate = parseServerDate(copy.PayDate); } catch(e) { copy.PayDate = null; }
                    return copy;
                });

                // 更新 grid 與 UI 顯示
                updateFeeGrid(fees);

                // 顯示總金額（如果後端有提供）
                try { document.getElementById('displayamountfield').innerHTML = (data.FullName || '') + ' 總金額 = ' + (resp.TotalAmount != null ? resp.TotalAmount : 0) + ' 元'; } catch(e) { }
                document.getElementById('samenamecontainer').style.display = 'none';
                document.getElementById('data-grid').style.display = '';
                document.getElementById('amountcontainer').style.display = '';

                // 根據需求：在顯示完清單後清空表單基本欄位
                clearFormBasicFields();

            }).fail(function (err) {
                getLoadPanelInstance().hide();
                console.error('fetchFeesByContactId error', err);
                ShowToast('載入失敗，請查看 console', 'error', 5000);
            });
        }

        // ========== 事件處理器（保留既有行為，但呼叫共用函式） ==========
        function OnClickQuery(arg) {
            // 標記使用者動作並顯示載入
            try { $($formSelector).dxForm("instance").getEditor('ClickType').option('value', '查詢'); } catch(e) { }
            getLoadPanelInstance().show();
        }

        function OnRowClick(selectedItems) {
            var data = selectedItems && selectedItems.selectedRowsData ? selectedItems.selectedRowsData[0] : null;
            if (!data) return;
            handleSameNameSelection(data);
        }

        function OnRowSelectionChanged(selectedItems) {
            var data = selectedItems && selectedItems.selectedRowsData ? selectedItems.selectedRowsData[0] : null;
            if (!data) return;
            handleSameNameSelection(data);
        }

        // ========== Ajax 回呼 onSuccess（整理與註解） ==========
        function onBegin() {
            // Ajax 開始前可以加入驗證或預處理，保留空實作以免影響現有流程
        }

        function onSuccess(data) {
            // 隱藏載入面板（若有）
            try { getLoadPanelInstance().hide(); } catch (e) { }

            // 記錄回應以利除錯：不會在生產環境大量 log
            console.log('AuditQueryDedication onSuccess:', data);

            var status = (data && data.status !== undefined) ? String(data.status) : null;

            if (status === '1') {
                // 查詢成功：清空搜尋欄位並顯示奉獻清單（若後端直接回傳 DedicationFeeList）
                var form = $($formSelector).dxForm("instance");
                if (form) {
                    form.updateData('DedicationNumber', '');
                    form.updateData('NationId', '');
                    form.updateData('FullName', '');
                    form.updateData('Mobile', '');
                    form.updateData('LastSixDigit', '');
                    try { form.getEditor('DedicationNumber').focus(); } catch(e) {}
                }

                document.getElementById('samenamecontainer').style.display = 'none';
                document.getElementById('data-grid').style.display = '';
                document.getElementById('amountcontainer').style.display = '';
                try { document.getElementById('displayamountfield').innerHTML = (data.FullName || '') + ' 總金額 = ' + (data.TotalAmount != null ? data.TotalAmount : 0) + ' 元'; } catch(e) {}

                // 若後端回傳奉獻清單，直接顯示；否則讓原本的 WebApi LoadAction 繼續運作
                if (data.DedicationFeeList && Array.isArray(data.DedicationFeeList)) {
                    var normalized = data.DedicationFeeList.map(function(item) {
                        var copy = Object.assign({}, item);
                        try { copy.DedicationDate = parseServerDate(copy.DedicationDate); } catch(e) { copy.DedicationDate = null; }
                        try { copy.PayDate = parseServerDate(copy.PayDate); } catch(e) { copy.PayDate = null; }
                        return copy;
                    });
                    updateFeeGrid(normalized);
                } else {
                    // 保留舊有行為：觸發 grid refresh 以讓 WebApi LoadAction 取得資料
                    try { $($feeGridSelector).dxDataGrid('instance').refresh(); } catch (e) { }
                }

            } else if (status === '2') {
                // 多筆同名：顯示同名清單並隱藏奉獻清單
                var form = $($formSelector).dxForm("instance");
                if (form) {
                    form.updateData('DedicationNumber', '');
                    form.updateData('NationId', '');
                    form.updateData('FullName', '');
                    form.updateData('Mobile', '');
                    try { form.getEditor('DedicationNumber').focus(); } catch(e) {}
                }
                document.getElementById('samenamecontainer').style.display = '';
                document.getElementById('data-grid').style.display = 'none';
                document.getElementById('amountcontainer').style.display = 'none';
                try { $($sameNameGridSelector).dxDataGrid('instance').refresh(); } catch(e) {}
            } else {
                // 查無結果或發生錯誤
                if (data && data.message === '沒找到這個連絡人') {
                    ShowToast('沒找到"' + (data.fullname || '') + '"!', 'error', 3000);
                    if (data.clicktype === '查詢') {
                        var PopupInstance = $('#popup') && $('#popup').dxPopup ? $('#popup').dxPopup('instance') : null;
                        if (PopupInstance) { PopupInstance.option('title', '沒找到"' + (data.fullname || '') + '"，是否要新增?'); PopupInstance.show(); }
                    }
                }
                document.getElementById('samenamecontainer').style.display = 'none';
                document.getElementById('data-grid').style.display = 'none';
                document.getElementById('amountcontainer').style.display = 'none';
                try { document.getElementById('resultfield').innerHTML = data.DedicationResult || data.message; } catch(e) {}
            }
        }

        function onComplete(data) {
            // Ajax 完成後可做的清理工作，保留空實作
        }
    </script>

