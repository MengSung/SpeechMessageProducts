@{
    var priorities = new[] { "Low", "Normal", "Urgent", "High" };
}

@using ChurchReport.ViewModels
@model PersonalInfomationViewModel

<div class="personal-info-page">
    <div class="long-title page-title-card">
        <h4>@Model.FullName 個人相關資料</h4>
        <span class="page-subtitle">請確認資料正確後再上傳，系統將自動儲存更新內容。</span>
    </div>

<form data-ajax="true" data-ajax-begin="onBegin" data-ajax-success="onSuccess" asp-action="SavePersonalInfomation" asp-controller="Personal" method="post">
    <div class="dx-field">
        <div id="buttonContainerTop" class="dx-button-icon action-button-row">
            @(Html.DevExtreme().Button()
                    //.Text("上傳").Height(50).Width(80).Icon("check")
                    .Text("上傳").Icon("check")
                    .Type(ButtonType.Success)
                    .ID("save-button")
                    .UseSubmitBehavior(true)
                //.ValidationGroup()
                //.Width(60)

                .OnClick("SaveNewPerson")

                //.OnClick(@<text>
                //function(data) {
                //
                //        $.ajax({
                //            url: '@Url.Action("SaveNewPerson", "Home")',
                //            data: { aNewPerson: Model.FormData.Notes.Value },
                //            type: 'POST', //POST if you want to save, GET if you want to fetch data from server
                //            success: function (obj)
                //            {
                //                $("#toast").dxToast("instance").show();
                //            },
                //
                //            error: function (obj)
                //            {
                //                //alert('Something happened');
                //            }
                //
                //        });
                //}
                //</text>)
            )
        </div>
        <div id="ToastContainer">
            @(Html.DevExtreme().Toast()
                .ID("toast")
                .Position(p => p
                    .At(HorizontalAlignment.Center, VerticalAlignment.Center)
                    .Offset(0, 50))
                    .Message("上傳成功了!")
                    .DisplayTime(20000)
                    .MaxWidth(200)
            )

        </div>
        <div id="LoadPanel">
            @(Html.DevExtreme().LoadPanel()
                    .ID("loadPanel")
                    .ShadingColor("rgba(0,0,0,0.4)")
                    .Position(p => p.Of("#form-container"))
                    .Visible(false)
                    .ShowIndicator(true)
                    .ShowPane(true)
                    .Shading(true)
                    .CloseOnOutsideClick(false)
                    .Message("上傳資料中...")
                    .Animation(l => l.Show(k => k.Easing(AnimationEasing.Swing)))
                //.OnShown("loadPanel_shown")
                //.OnHidden("loadPanel_hidden")
            )

        </div>
    </div>
    <div id="form-container" class="form-card">

        <div class="form-intro">
            <span class="form-intro-title">基本資料</span>
            <span class="form-intro-hint">星號欄位為建議優先確認欄位</span>
        </div>

