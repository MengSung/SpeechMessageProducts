<style>
    .personal-info-page {
        --brand-primary: #4f46e5;
        --brand-secondary: #0f766e;
        --text-main: #1f2937;
        --text-muted: #6b7280;
        --line-soft: #e5e7eb;
        --card-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    }

    .page-title-card {
        background: linear-gradient(120deg, #f8fbff 0%, #eef2ff 100%);
        border: 1px solid #dbeafe;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 12px;
        box-shadow: var(--card-shadow);
    }

    .page-title-card h4 {
        margin: 0;
        color: var(--brand-secondary);
        font-weight: 700;
    }

    .page-subtitle {
        margin-top: 6px;
        display: inline-block;
        font-size: 13px;
        color: var(--text-muted);
    }

    .action-button-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 10px;
    }

    .action-button-row .dx-button {
        border-radius: 10px;
        overflow: hidden;
    }

    .action-button-row .dx-button-success {
        background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
        border-color: transparent;
        font-weight: 700;
        min-width: 92px;
    }

    .form-card {
        background: #fff;
        border: 1px solid var(--line-soft);
        border-radius: 14px;
        padding: 12px;
        box-shadow: var(--card-shadow);
    }

    .form-intro {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        border-bottom: 1px dashed #d1d5db;
        padding-bottom: 8px;
    }

    .form-intro-title {
        color: var(--text-main);
        font-weight: 700;
        font-size: 15px;
    }

    .form-intro-hint {
        color: var(--text-muted);
        font-size: 12px;
    }

    #form .dx-texteditor,
    #form .dx-dropdowneditor {
        border-radius: 10px;
    }

    #form .dx-texteditor.dx-state-focused,
    #form .dx-dropdowneditor.dx-state-focused {
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }

    #form .dx-field-item-label-text {
        color: #1f2937;
        font-weight: 600;
    }

    #form .dx-layout-manager .dx-field-item {
        padding-top: 6px;
        padding-bottom: 6px;
    }

    .action-button-row-bottom {
        margin-top: 12px;
        margin-bottom: 2px;
    }

    @@media (max-width: 768px) {
        .page-title-card,
        .form-card {
            border-radius: 12px;
            padding: 10px;
        }

        .form-intro {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        .action-button-row {
            justify-content: stretch;
        }

        .action-button-row .dx-button {
            width: 100%;
        }
    }

    @@media (max-width: 430px) {
        .page-title-card h4 {
            font-size: 18px;
        }

        .page-subtitle {
            font-size: 12px;
            line-height: 1.45;
        }
    }
</style>

<script>
    // ✅ 全域變數：信仰狀態 DataSource
    var spiritualIdentityDataSource = [];
    
    // ✅ 全域變數：婚姻狀態 DataSource
    var familyStatusDataSource = [];

    // ✅ 頁面載入時從 API 取得信仰狀態清單
    $(document).ready(function() {
        console.log('========================================');
        console.log('✅ [PersonalInfomationView] 頁面載入');
        console.log('✅ [PersonalInfomationView] Model.Status:', '@Model.Status');
        console.log('✅ [PersonalInfomationView] Model.MerrageState:', '@Model.MerrageState');
        console.log('========================================');
        
        // ✅ 載入信仰狀態清單
        $.ajax({
            url: '/Personal/Api/GetSpiritualIdentityList',
            type: 'GET',
            dataType: 'json',
            async: false, // 同步載入確保 Form 初始化前完成
            success: function(response) {
                if (response.success && response.data) {
                    spiritualIdentityDataSource = response.data;
                    console.log('✅ [PersonalInfomationView] 成功載入信仰狀態清單:', spiritualIdentityDataSource);
                }
            },
            error: function(xhr, status, error) {
                console.error('❌ [PersonalInfomationView] 載入信仰狀態清單失敗:', error);
                // 使用備用清單
                spiritualIdentityDataSource = ["-未知-"];
            }
        });

        // ✅ 載入婚姻狀態清單
        $.ajax({
            url: '/Personal/Api/GetFamilyStatusList',
            type: 'GET',
            dataType: 'json',
            async: false, // 同步載入確保 Form 初始化前完成
            success: function(response) {
                if (response.success && response.data) {
                    familyStatusDataSource = response.data;
                    console.log('✅ [PersonalInfomationView] 成功載入婚姻狀態清單:', familyStatusDataSource);
                }
            },
            error: function(xhr, status, error) {
                console.error('❌ [PersonalInfomationView] 載入婚姻狀態清單失敗:', error);
                // 使用備用清單
                familyStatusDataSource = ["未知"];
            }
        });
    });

    function getLoadPanelInstance() {
        return $("#loadPanel").dxLoadPanel("instance");
    }

    function button_click() {
        getLoadPanelInstance().show();
    }

    function loadPanel_shown(e) {
        //    setTimeout(function () {
        //        e.component.hide();
        //    }, 3000);
    }

    function loadPanel_hidden() {
    }

    function SaveNewPerson(arg) {

        //debugger;
        getLoadPanelInstance().show();
        //$("#toast").dxToast("instance").show();
        //alert("SaveNewPerson!!!");
        //alert("OnValueChanged : " + arg.value);

        //alert("OnValueChanged : " + arg.attribute('text'));
        //alert("OnValueChanged : " + text: arg.attribute("text"));

        //alert( getODataLocalDateFilter(arg.value) );
    }

    //var initialUpdate = true;

    function OnSelectStatusBoxValueChanged(e) {
        //if (initialUpdate) {
        //    initialUpdate = false;
        //    return;
        //}

        //initialUpdate = true;
        //$("#formRapports").dxForm("instance").itemOption("Filtre.TESTDATE", 'visible', true);
        if (e.value == "未信主") {
            //alert(e.value + "HIDE" );
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', false);
        }
        else {
            //alert(e.value + "DISPLAY");
            $("#form").dxForm("instance").itemOption("OtherDedication", 'visible', true);
        }
    }

</script>

