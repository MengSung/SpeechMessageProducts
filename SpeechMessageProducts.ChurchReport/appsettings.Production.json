{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "jesus.speechmessage.com.tw;jesusback.speechmessage.com.tw",

  "Profiling": {
    "Enabled": false
  },

  "EnableTrace": false,

  "PaymentDebugLog": {
    "Enabled": false,
    "Directory": "Logs/PaymentDebug",
    "FilePrefix": "QPay_Dedication_CreditCard",
    "MaskSensitiveData": true
  },

  "SessionBleeding": {
    "EnableResponseCaching": false
  },
  
  "MemoryLimits": {
    "MaxMemoryMB": 2048,
    "WarningMemoryMB": 1536,
    "MemoryCacheSizeMB": 512,
    "CompactionPercentage": 0.25
  },
  
  "Dataverse": {
    "Pool": {
      "MinSize": 5,
      "MaxN": 30,
      "AcquireTimeout": "00:00:30",
      "IdleTimeout": "00:10:00",
      "HealthInterval": "00:05:00"
    }
  },
  
  "Session": {
    "IdleTimeoutMinutes": 30,
    "IOTimeoutSeconds": 30
  },
  
  "HealthCheck": {
    "IntervalSeconds": 60
  },
  
  "GCSettings": {
    "EnableGCMonitoring": false,
    "MonitoringIntervalMinutes": 10,
    "MaxGen2CollectionsPerHour": 5
  }
}
