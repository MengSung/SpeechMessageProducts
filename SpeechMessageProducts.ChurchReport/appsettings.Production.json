{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "jesus.speechmessage.com.tw;jesusback.speechmessage.com.tw",

  "Profiling": {
    "Enabled": false
  },

  "EnableTrace": false,

  "PaymentDebugLog": {
    "Enabled": false,
    "Directory": "Logs/PaymentDebug",
    "FilePrefix": "QPay_Dedication_CreditCard",
    "MaskSensitiveData": true
  },

  "SessionBleeding": {
    "EnableResponseCaching": false
  },
  
  "MemoryLimits": {
    "MaxMemoryMB": 2048,
    "WarningMemoryMB": 1536,
    "MemoryCacheSizeMB": 512,
    "CompactionPercentage": 0.25
  },
  
  "ConnectionPool": {
    "MinPoolSize": 5,
    "MaxPoolSize": 30,
    "ConnectionTimeoutSeconds": 30,
    "IdleTimeoutMinutes": 10
  },
  
  "Session": {
    "IdleTimeoutMinutes": 30,
    "IOTimeoutSeconds": 30
  },
  
  "HealthCheck": {
    "IntervalSeconds": 60
  },
  
  "GCSettings": {
    "EnableGCMonitoring": false,
    "MonitoringIntervalMinutes": 10,
    "MaxGen2CollectionsPerHour": 5
  },
  "Security": {
    "EnforceGlobalAuthorization": "true",
    "AllowSessionIdentityFallback": "false"
  },
  "LinePay": {
    "IsSandbox": "false"
  },
  "Cash_Environment": "正式環境",
  "PAY_PROVIDER": "高鉅金流",
  "Payment": {
    "DefaultProfile": "MyPayProduction",
    "Profiles": {
      "MyPayProduction": {
        "Environment": "Production"
      }
    }
  },
  "TSPG": {
    "TestMode": "false"
  }
}
