{
  "DynamicsAccess": {
    // Visual Studio Development 以 Embedded 省略產品→Gateway 的 HTTP hop；產品設定仍只保存已核准的 ProfileAlias，
    // 不保存 CE 版本、OrganizationId、CRM endpoint、ConnectorKind、credential 或 token。完整 Guard→Resolver→
    // Admission→Router→Data8 Pool 路徑由 Embedded composition root 擁有，不能由 request 或此 JSON 覆寫。
    // Package01 與 P7.2 consumer 旗標都維持 false，因此既有收費清單與會員更新仍不切流量。
    // P4 啟動時仍會以固定 Profile
    // 執行一次受控 WhoAmI，驗證 Guard→Resolver→Admission→Router→Data8 Pool；它不讀取 Gateway endpoint，
    // 不啟用收費讀取切換，也不建立第二個 provider、HTTP handler 或背景工作。
    "Package01FeeReadsEnabled": false,
    "Package01FeeEditorReadEnabled": false,
    "Package02ContactBasicInfoUpdatesEnabled": false,
    "Package02ContactProfileOperationsEnabled": false,
    // ORG-CALL-00024 的本機 DTO-only candidate 尚無 capacity/parity/rollback enablement 證據；開發設定也必須
    // 維持 false，避免 Embedded 啟動因設定存在而自動建立 consumer typed flow 或切換任何 CE 流量。
    "Package02UngroupedCommitmentReadEnabled": false,
    // Package03 圖片 DTO-only route 尚未完成本機以外的證據；開發環境亦必須預設關閉。
    "Package03SpecialResourcesEnabled": false,
    "ConnectionMode": "Embedded",
    "ProfileAlias": "sunnyvalechback",
    "Gateway": {
      "Endpoint": "https://localhost:7244/",
      "ApiPrefix": "/v1",
      "RequestTimeoutSeconds": 35,
      "MaxResponseBytes": 65536
    }
  },
  "Profiling": {
    "Enabled": false
  }
}
