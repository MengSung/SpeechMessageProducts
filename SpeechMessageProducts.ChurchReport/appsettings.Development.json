{
  "DynamicsAccess": {
    // Visual Studio Development 明確選擇獨立程序的 Local Gateway；Central Gateway 仍是正式環境目標，Embedded 只保留為延後選項。
    // 此設定只對齊 hosting/profile 契約。Package01 旗標必須維持 false，讓 ChurchReport 不解析 client、不建立 HTTP pool/token cache，
    // 也不送出 WhoAmI 或資料 operation；待 Local Gateway、AD FS、CE 8.2/9.1、瀏覽器與 soak gate 全部通過後才能另行啟用單一 workflow。
    "Package01FeeReadsEnabled": false,
    "ExecutionMode": "Gateway",
    "ProfileAlias": "crm82",
    "CeVersion": "8.2",
    "Gateway": {
      // Local Gateway 只允許 HTTPS loopback listener；產品端不保存 CRM endpoint、credential、token 或實體 pool 設定。
      "Endpoint": "https://localhost:7244/",
      "ApiPrefix": "/v1"
    }
  },
  "Profiling": {
    "Enabled": false
  }
}
