    // 讓現有網站不建立 Gateway client、socket pool、timer 或背景工作，也不因設定存在而送出任何 Dynamics operation。
    "Package01FeeReadsEnabled": false,
    "Package01FeeEditorReadEnabled": false,
    "Package02ContactBasicInfoUpdatesEnabled": false,
    "Package02ContactProfileOperationsEnabled": false,
    // 未分組承諾 aggregate count 是獨立 P7.4 DTO-only candidate；base/sub-gate、capacity、parity 與 rollback
    // 證據未齊前必須維持 false，不建立 typed client／process host／Data8 pool 或改變既有網站流量。
    "Package02UngroupedCommitmentReadEnabled": false,
    // Package03 圖片 DTO-only route 是 P7.4 本機候選，未完成 CE／capacity／parity／rollback 證據前必須維持 false。
    "Package03SpecialResourcesEnabled": false,
    // ORG-CALL-00040 承諾類型 metadata 是獨立 Package03 consumer sub-gate；即使 base gate 日後另有用途，
    // 未完成 locale/parity/capacity/rollback 證據前也不得建立 typed metadata 路徑或改變 MemberInfo 網站流量。
    "Package03MemberInfoCommitmentMetadataReadEnabled": false,
