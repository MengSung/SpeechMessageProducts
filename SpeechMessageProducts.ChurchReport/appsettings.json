{
  // ==============================================
  // 日誌設定 (Logging Configuration) - 簡化版本以避免版本衝突
  // ==============================================
  "Logging": {
    "LogLevel": {
      "Default": "Information", // 改為 Information 以記錄 LogInformation
      "Microsoft": "Warning", // Microsoft 相關保持 Warning
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // DEBUG 診斷端點的部署操作員清單；預設空集合會 fail closed。只接受登入 cookie 內伺服器簽發的聯絡人 GUID，
  // 實際值應由環境變數／部署設定注入，不得填入使用者名稱、Session ID、token、端點或憑證。
  "Diagnostics": {
    "OperatorContactIds": []
  },

  // ==============================================
  // ✅ Phase 6: Kestrel HTTP/2 設定
  // ==============================================
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "MaxRequestBodySize": 30000000,
      "MinRequestBodyDataRate": {
        "BytesPerSecond": 100,
        "GracePeriod": "00:00:10"
      }
    }
  },

  // ==============================================
  // Trace 日誌啟用設定 (Enable Trace Logging)
  // ==============================================
  "EnableTrace": false, // 正式/預設環境停用 TraceLoggerProvider，需診斷時再由環境設定覆蓋

  // ==============================================
  // 信用卡奉獻金流 Debug Log 設定
  // ==============================================
  // Enabled: true 會在付款回呼時寫入獨立 LOG；問題排除後可改為 false
  // Directory: 相對於網站執行目錄，例如正式站會在網站根目錄底下建立 Logs/PaymentDebug
  // FilePrefix: 檔名會是 QPay_Dedication_CreditCard_yyyyMMdd.log，方便辨識奉獻信用卡金流
  // MaskSensitiveData: true 會遮蔽 PayToken、LINE ID、信用卡 Token 等敏感資訊
  "PaymentDebugLog": {
    "Enabled": false,
    "Directory": "Logs/PaymentDebug",
    "FilePrefix": "QPay_Dedication_CreditCard",
    "MaskSensitiveData": true
  },

  // ==============================================
  // 每週排程設定 (Weekly Schedule Configuration)
  // ==============================================
  // 「主日」永遠固定是星期日，但系統要依據這裡設定的「每週第一日」
  // 來判斷某一天屬於哪一個週區間，進而算出該週所屬的主日日期。
  // 星期一、星期六、星期日
  "WeeklySchedule": {
    "每週的第一日": "星期六"
  },

  // ==============================================
  // ✅ Session Bleeding 防護 - 預設行為 (避免環境差異造成誤解)
  // ==============================================
  // - EnableResponseCaching: 正式/預設環境維持 false，避免登入後動態頁面被快取
  // - TrustAllProxies: 預設關閉，避免 X-Forwarded-For 被偽造導致審計與判斷失真
  "SessionBleeding": {
    "EnableResponseCaching": false
  },

  "Security": {
    "EnforceGlobalAuthorization": false,
    "AllowSessionIdentityFallback": true
  },

