<!--
檔案整體說明
目的與定位：F8跨產品權限與修改紀錄的net10共用引擎專案，使用既有中央套件，不反向依賴產品、ToolUtility或部署工具。
主要功能與流程：SDK透過組合根提供的短命租約查詢即時權限，Hosting提供唯一安全例外入口；專案建立當步加入SpeechMessageProducts.sln，Debug與Release均須納入建置及測試。
使用邊界與維護：此檔只宣告建置契約，不載入User Secrets、不發起實機呼叫；SDK租約由每次操作確定歸還，診斷owner由Host借用。離線合成證據不得當成D365部署結果，文件與位元組守門必須維持零失敗。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <ProjectReference Include="..\SpeechMessage.Hosting\SpeechMessage.Hosting.csproj" />
  </ItemGroup>
</Project>
