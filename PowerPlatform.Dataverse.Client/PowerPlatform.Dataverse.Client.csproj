<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>MarkMpn,Data8 Ltd</Authors>
    <Copyright>Copyright © 2021 Data8 Limited</Copyright>
    <RepositoryUrl>https://github.com/Data8/DataverseClient</RepositoryUrl>
    <PackageReleaseNotes>Updated to support .NET 10 with latest WCF packages</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Data8/DataverseClient</PackageProjectUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <Description>Provides a WS-Trust compatible client for connecting to on-premise IFD instances of Dynamics 365 from .NET 10.

This package builds on top of Microsoft.PowerPlatform.Dataverse.Client and offers an alternative IOrganizationService implementation using WS-Trust.
This allows you to connect using the URL of the organization service, username and password without any additional
configuration.

Because this OnPremiseClient implements the same IOrganizationService as the standard ServiceClient implementation
your code can work with either as shown in the sample code below.

using Data8.PowerPlatform.Dataverse.Client;
using Microsoft.PowerPlatform.Dataverse.Client;
using Microsoft.Xrm.Sdk;

var onPrem = new OnPremiseClient("https://org.crm.contoso.com/XRMServices/2011/Organization.svc", "AD\\username", "password!");
var online = new ServiceClient("AuthType=ClientSecret;Url=https://contoso.crm.dynamics.com;ClientId=637C79F7-AE71-4E9A-BD5B-1EC5EC9F397A;ClientSecret=p1UiydoIWwUH5AdMbiVBOrEYn8t4RXud");

CreateRecord(onPrem);
CreateRecord(online);

void CreateRecord(IOrganizationService svc)
{
  var entity = new Entity("account")
  {
    ["name"] = "Data8"
  };
  
  entity.Id = svc.Create(entity);
}
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS0618;CS0672;CS1591;SYSLIB0004;SYSLIB0014;SYSLIB0051</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Dynamics;CommonDataService;CDS;PowerApps;PowerPlatform;CdsServiceClient;Dataverse;OnPrem;OnPremise;AD;IFD</PackageTags>
    <PackageIcon>Data8.png</PackageIcon>
  </PropertyGroup>

  <!-- AI-修正註解（對齊上游 Data8 commit e58a0ad「Updated DVSC package and target frameworks」，2025-02-20）：
       上游在該次改動中把 NSspi 原始碼的 <Compile Include> 條件由「net462 或 net6.0」收斂為「僅 net462」。
       原因是 System.Net.Security.NegotiateAuthentication 依 Microsoft Learn 的 Applies-to 僅存在於 .NET 7 以上
       （moniker：net-7.0 / net-8.0 / net-9.0 / net-10.0 / net-11.0，沒有 net-6.0）。上游先前必須為 net6.0 保留
       NSspi 這條 P/Invoke 後備路徑；一旦把 net6.0／net7.0 併為 net8.0，該後備路徑對所有 .NET 目標就成為死碼。

       本專案唯一目標為 net10.0，NET7_0_OR_GREATER 恆為真，因此 ADAuthClient 的 #else（NSspi）分支永不編譯，
       但 NSspi 底下 37 個檔案仍會被 SDK 預設 glob 全部編入輸出組件——其中 NativeMethods.cs、
       ContextNativeMethods.cs、CredentialNativeMethods.cs 是對 secur32.dll 的非受管 P/Invoke 宣告。
       這些型別永遠不會被呼叫，卻實際存在於交付組件中，屬於沒有必要的未使用非受管介面面積。

       以 Remove 形式排除（而非上游的 Include 形式），是因為本 repo 的 NSspi 原始碼實體位於專案資料夾內，
       會被預設 glob 自動納入；條件保留 net462 判斷，日後若真的重新加回 net462 目標，後備路徑會自動恢復編譯。 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net462'">
    <Compile Remove="NSspi\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.WsTrust" Version="6.8.0" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.1.32" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="System.ServiceModel.Federation" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Data8.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
