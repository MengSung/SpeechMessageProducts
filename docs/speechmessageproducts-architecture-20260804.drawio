        <mxCell id="t" value="Dynamics 官方 NuGet Worker · 每個模組在做什麼" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="一句話：舊框架的官方 CRM SDK 被關進 net48 獨立進程，用具名管道跟 net10 主機講話。產品永遠是 net10，永遠碰不到 SDK。" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1200" height="18" as="geometry" /></mxCell>

        <mxCell id="abs" value="Abstractions · 10 檔（net10 · 零相依）&#10;&#10;【它是什麼】&#10;整個 Dynamics 存取層的「共同語言」。&#10;所有其他模組都參考它，它不參考任何人。&#10;&#10;【裡面有什麼】&#10;IDynamicsOperationExecutor&#10;　唯一的執行抽象。不論走 Gateway 還是&#10;　Embedded，產品看到的都是這個介面。&#10;&#10;OperationDefinition / OperationIds&#10;Package01OperationRegistry&#10;　可執行操作的白名單。沒登記的操作&#10;　一律拒絕，產品無法自由下指令。&#10;&#10;OperationExecutionRequest / Result&#10;OperationResponseData&#10;　請求與回應的資料形狀&#10;&#10;ProductDynamicsOptions&#10;　產品端的設定形狀（模式、別名、端點）&#10;&#10;DynamicsErrorCodes / DynamicsExecutionMode&#10;&#10;【為什麼重要】&#10;三次架構轉向，這一層都沒被打掉重寫。&#10;它就是可以換掉底層實作的原因。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="300" height="500" as="geometry" /></mxCell>

        <mxCell id="rem" value="殘留與已清除&#10;&#10;Embedded · 1 檔&#10;　只剩 DI 進入點空殼。&#10;　產品已不參考，只有測試專案還連著。&#10;&#10;【08-02 已刪除】&#10;✔ WebApi · 41 檔（v1 的無 SDK OData 連線器）&#10;✔ SmokeTests · 2 檔&#10;✔ Invoke-DynamicsLiveSmoke.ps1&#10;✔ Get-DynamicsCrmWebIfdDiagnostics.ps1&#10;&#10;其中約 26 檔（容量與世代管理）在刪除前&#10;已先搬進 ControlPlane 保留下來。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="300" height="255" as="geometry" /></mxCell>

        <mxCell id="prod" value="ChurchReport（產品 · net10）　只參考 Abstractions + ProductClient　★ 有邊界測試禁止它直接碰底層" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="1140" height="46" as="geometry" /></mxCell>

        <mxCell id="pc" value="ProductClient · 8 檔（net10）　【產品唯一入口】把業務需求翻譯成 Gateway 請求" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="158" width="1140" height="128" as="geometry" /></mxCell>
        <mxCell id="pc1" value="Package01FeeReadClient&#10;IPackage01FeeReadClient&#10;產品呼叫的業務方法：依聯絡人 /&#10;日期查奉獻費用、課程紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="14" y="34" width="268" height="74" as="geometry" /></mxCell>
        <mxCell id="pc2" value="GatewayDynamicsOperationExecutor&#10;把 Operation ID + 具名參數打包成&#10;HTTP POST 送去 Gateway。&#10;產品不能送 FetchXML / URL / SQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="294" y="34" width="268" height="74" as="geometry" /></mxCell>
        <mxCell id="pc3" value="GatewayProductClientLimits&#10;GatewayProductDynamicsOptionsValidator&#10;連線池、逾時、回應大小上限；&#10;啟動時驗證產品設定是否合法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="574" y="34" width="268" height="74" as="geometry" /></mxCell>
        <mxCell id="pc4" value="FeeRecordDto&#10;StorLessonRecordDto&#10;純資料模型。裡面沒有任何 CRM 概念&#10;（沒有 Entity、沒有 GUID 欄位語意）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="854" y="34" width="272" height="74" as="geometry" /></mxCell>

        <mxCell id="gw" value="Gateway · 8 檔（net10）　【信任邊界】唯一對外的 HTTP 端點" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="315" width="1140" height="128" as="geometry" /></mxCell>
        <mxCell id="gw1" value="Program.cs&#10;POST /v1/organizations/{alias}&#10;　　/operations/{capabilityOperationId}&#10;Windows Negotiate 驗證&#10;→ 未驗證即 401（在讀 body 之前）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="14" y="34" width="360" height="80" as="geometry" /></mxCell>
        <mxCell id="gw2" value="Security/&#10;ConfigurationGatewayOperationAuthorizer&#10;GatewayWorkloadBinding&#10;把 Windows 身分對應到「可用哪些 alias、&#10;可執行哪些 operation」→ 否則 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="386" y="34" width="360" height="80" as="geometry" /></mxCell>
        <mxCell id="gw3" value="OfficialWorkerDeploymentConfiguration&#10;綁定 worker 執行檔路徑與 SHA-256 雜湊&#10;（防止被掉包）&#10;RequestLimits/ 請求大小上限&#10;DynamicsGatewayReadinessService 就緒檢查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="758" y="34" width="368" height="80" as="geometry" /></mxCell>

        <mxCell id="cp" value="ControlPlane · 26 檔（net10）　【交通管制】決定「誰能跑、跑幾個、用哪一代連線」" style="swimlane;html=1;startSize=28;fillColor=#cfe2f3;strokeColor=#3d6ea5;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="472" width="1140" height="185" as="geometry" /></mxCell>
        <mxCell id="cp1" value="Capacity/　12 檔　【容量准入】&#10;OrganizationAdmissionManager&#10;　有界佇列 + 併發號誌 + 每工作負載上限&#10;　封包大小檢查 + 期限檢查&#10;CapacityKeys　三種 key 型別，避免環境標籤&#10;　意外變成獨立的容量預算&#10;OrganizationAdmissionPlan&#10;　LocalMaxInFlight = floor(總量 / 主機數)&#10;InMemory / Sql RuntimeHostSlotCoordinator&#10;　✔ SQL 版 8 項 live 測試已通過（我實跑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="14" y="34" width="552" height="140" as="geometry" /></mxCell>
        <mxCell id="cp2" value="Runtime/　13 檔　【世代管理】&#10;DynamicsProfileRuntimeManager&#10;　每個 alias 同時最多「1 個 Active + 1 個&#10;　Draining」世代。換設定時原子發布新世代，&#10;　舊世代停止接新工作但等既有工作做完&#10;ControlledOperationExecutor&#10;　只接受註冊過的 operation&#10;ProfileRoutedOperationExecutor&#10;　依 alias 路由到 crm82 或 crm91&#10;OperationDispatchPreparer / PreparedDispatch&#10;　把請求準備成可派工的封包" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="578" y="34" width="548" height="140" as="geometry" /></mxCell>

        <mxCell id="sup" value="WorkerSupervisor · 11 檔（net10）　【工頭】挑 worker、派工、盯資源、決定何時換人" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="686" width="1140" height="200" as="geometry" /></mxCell>
        <mxCell id="sp1" value="OfficialWorkerProfileExecutor&#10;依 profile 決定用 8.2 還是 9.1 worker，&#10;啟動 / 重用進程並把工作送進去" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sup">
          <mxGeometry x="14" y="34" width="360" height="66" as="geometry" /></mxCell>
        <mxCell id="sp2" value="OfficialWorkerRecyclePolicy + Options&#10;OfficialWorkerRecycleReason&#10;什麼時候該把 worker 進程殺掉重開：&#10;完成次數上限 / 資源超標 / 存活時間到" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sup">
          <mxGeometry x="386" y="34" width="360" height="66" as="geometry" /></mxCell>
        <mxCell id="sp3" value="OfficialWorkerResourceObservation&#10;持續觀測 worker 進程的&#10;privateBytes / handles / threads / p95 延遲&#10;→ 這是 soak 測試抓洩漏的資料來源" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sup">
          <mxGeometry x="758" y="34" width="368" height="66" as="geometry" /></mxCell>
        <mxCell id="sp4" value="OfficialWorkerProcessEnvironment&#10;子行程的環境變數隔離：&#10;worker 不會繼承主機的敏感環境變數" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sup">
          <mxGeometry x="14" y="110" width="360" height="66" as="geometry" /></mxCell>
        <mxCell id="sp5" value="Package01FeeWorkerResponseProjector&#10;把 worker 回來的原始資料投影成產品 DTO&#10;★ 這裡負責濾掉 CRM 內部位址與識別碼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sup">
          <mxGeometry x="386" y="110" width="360" height="66" as="geometry" /></mxCell>
        <mxCell id="sp6" value="OfficialWorkerLifecycleSnapshot / Version&#10;OfficialWorkerStartupException / ProfileOptions&#10;可觀測狀態、執行檔版本綁定、&#10;啟動失敗分類（避免無限重試）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sup">
          <mxGeometry x="758" y="110" width="368" height="66" as="geometry" /></mxCell>

        <mxCell id="br" value="跨框架橋接層【netstandard2.0】　★ 這是整個設計的關鍵樞紐" style="swimlane;html=1;startSize=28;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="916" width="1140" height="230" as="geometry" /></mxCell>
        <mxCell id="br0" value="為什麼需要這一層：net48（舊框架，官方 CRM SDK 只能跑這裡）和 net10（新框架，產品跑這裡）不能互相參考。&#10;netstandard2.0 是唯一兩邊都能參考的目標框架，所以「溝通契約」必須放在這裡，兩端才會用同一份定義。" style="text;html=1;fontSize=11;fontColor=#2d6b3f;align=left;" vertex="1" parent="br">
          <mxGeometry x="14" y="32" width="1110" height="34" as="geometry" /></mxCell>
        <mxCell id="br1" value="WorkerProtocol · 19 檔　【IPC 契約 · 純資料 + 驗證 · 零 SDK 相依】&#10;WorkerRequestV1 / WorkerResponseV1&#10;WorkerReadyV1 / WorkerDrainV1　　四種封包型別&#10;WorkerFrameCodec / WorkerEnvelopeCodec　　編解碼&#10;WorkerEnvelopeValidator / WorkerRequestValidator　　收到就先驗&#10;WorkerProtocolLimits / Version　　大小上限與版本協商&#10;WorkerValue / WorkerValueKind　　型別安全的參數值&#10;Package01FeeWorkerContract　　業務操作的線上格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="br">
          <mxGeometry x="14" y="74" width="552" height="142" as="geometry" /></mxCell>
        <mxCell id="br2" value="WorkerHost · 19 檔　【進程宿主與傳輸】&#10;NamedPipeOfficialWorkerConnector　　具名管道連線&#10;OfficialWorkerProcessHost / Session / ExitCode　　進程生命週期&#10;IOfficialCrmClient / IOfficialCrmClientFactory&#10;　　★ 介面在這裡、實作在 worker，所以本層不含任何 CRM SDK&#10;WindowsCredentialManagerProvider + NativeApi&#10;　　★ 憑證從 Windows 認證管理員（DPAPI）取得，不讀設定檔&#10;OfficialCrmIdentityValidator / AuthenticationMode / Credential&#10;XmlWorkerProfileStore / WorkerProfileSettings　　profile 讀取&#10;OfficialWorkerResultLimitExceededException　　結果大小上限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="br">
          <mxGeometry x="578" y="74" width="548" height="142" as="geometry" /></mxCell>

        <mxCell id="w82" value="Crm82Worker · 4 檔　＋　Tests · 3 檔　【net48 獨立進程】" style="swimlane;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="1176" width="560" height="290" as="geometry" /></mxCell>
        <mxCell id="w82a" value="Program.cs&#10;　進程進入點，連上具名管道等待工作&#10;OfficialCrmServiceClientFactory&#10;　用憑證建立官方 CrmServiceClient&#10;OfficialCrmServiceClientAdapter&#10;　包成 IOfficialCrmClient 介面&#10;Package01FeeQueryOperation&#10;　★ 真正的業務查詢：組 FetchXML、&#10;　　呼叫 IOrganizationService、整理結果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="w82">
          <mxGeometry x="14" y="34" width="530" height="124" as="geometry" /></mxCell>
        <mxCell id="w82b" value="微軟官方 NuGet（版本鎖定在 8.2）&#10;Microsoft.CrmSdk.XrmTooling.CoreAssembly 8.2.0.5&#10;Microsoft.CrmSdk.CoreAssemblies 8.2.0.2&#10;Microsoft.CrmSdk.Deployment / Workflow 8.2.0.2&#10;Microsoft.IdentityModel.Clients.ActiveDirectory 2.29.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="w82">
          <mxGeometry x="14" y="168" width="530" height="80" as="geometry" /></mxCell>
        <mxCell id="w82c" value="Tests：FakeCrm82SdkClient · AdapterTests · Package01FeeQueryOperationTests　→ 15 項通過" style="text;html=1;fontSize=10;fontColor=#8a6d00;align=left;" vertex="1" parent="w82">
          <mxGeometry x="14" y="254" width="530" height="28" as="geometry" /></mxCell>

        <mxCell id="w91" value="Crm91Worker · 4 檔　＋　Tests · 3 檔　【net48 獨立進程】" style="swimlane;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="1176" width="560" height="290" as="geometry" /></mxCell>
        <mxCell id="w91a" value="Program.cs&#10;OfficialCrmServiceClientFactory&#10;OfficialCrmServiceClientAdapter&#10;Package01FeeQueryOperation&#10;&#10;結構與 8.2 完全相同，但&#10;是獨立編譯、獨立進程、獨立版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="w91">
          <mxGeometry x="14" y="34" width="530" height="124" as="geometry" /></mxCell>
        <mxCell id="w91b" value="微軟官方 NuGet（版本鎖定在 9.1）&#10;Microsoft.CrmSdk.XrmTooling.CoreAssembly 9.1.1.65&#10;Microsoft.CrmSdk.CoreAssemblies 9.0.2.60&#10;&#10;★ 為什麼要分兩個進程：組件版本不同，&#10;　 同一進程會有 assembly binding 衝突；&#10;　 而且 8.2 與 9.1 的權杖狀態不能混用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="w91">
          <mxGeometry x="14" y="168" width="530" height="80" as="geometry" /></mxCell>
        <mxCell id="w91c" value="Tests：FakeCrm91SdkClient · AdapterTests · Package01FeeQueryOperationTests　→ 15 項通過" style="text;html=1;fontSize=10;fontColor=#8a6d00;align=left;" vertex="1" parent="w91">
          <mxGeometry x="14" y="254" width="530" height="28" as="geometry" /></mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="prod" target="pc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="pc" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#3d6ea5;" edge="1" parent="1" source="gw" target="cp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#3d6ea5;" edge="1" parent="1" source="cp" target="sup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="sup" target="br"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" value="具名管道 IPC" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#d6b656;fontSize=11;fontStyle=1;" edge="1" parent="1" source="br" target="w82"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" value="具名管道 IPC" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#d6b656;fontSize=11;fontStyle=1;" edge="1" parent="1" source="br" target="w91"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="pc" target="abs"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3 · 一次請求的完整旅程" id="p3">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="一次「查詢奉獻費用」的完整旅程" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="綠 = 已由 411 項通過測試涵蓋　｜　黃 = 已實作但未經真實 CRM 驗證　｜　紅 = 產品目前實際走的路" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1000" height="18" as="geometry" /></mxCell>

        <mxCell id="f1" value="① 使用者在 ChurchReport 點開「奉獻收費清單」" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="84" width="460" height="44" as="geometry" /></mxCell>
        <mxCell id="fg" value="Package01FeeReadsEnabled ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="156" width="300" height="72" as="geometry" /></mxCell>
        <mxCell id="fl" value="false ← 目前的值&#10;走 ToolUtility → Data8 → WS-Trust/SOAP → CE 8.2&#10;★ 這條才是現在真正在跑的路徑&#10;整個右邊的新架構目前是旁路" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="400" height="84" as="geometry" /></mxCell>

        <mxCell id="f2" value="② ProductClient 組請求&#10;只放 Operation ID + 具名參數（contactId、起訖日）。不能放 FetchXML、URL、CRM 動作名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="258" width="500" height="52" as="geometry" /></mxCell>
        <mxCell id="f3" value="③ HTTPS POST → Gateway&#10;/v1/organizations/{alias}/operations/{capabilityOperationId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="336" width="500" height="48" as="geometry" /></mxCell>
        <mxCell id="f4" value="④ Windows Negotiate 驗證&#10;未通過 → 401。這一關在讀請求 body 之前就擋掉，避免無謂的解析成本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="410" width="500" height="52" as="geometry" /></mxCell>
        <mxCell id="f5" value="⑤ WorkloadBindingSet 授權&#10;這個 Windows 身分能不能用這個 alias、能不能跑這個 operation → 否則 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="488" width="500" height="52" as="geometry" /></mxCell>
        <mxCell id="f6" value="⑥ ControlPlane 容量准入&#10;排隊等 Permit。佇列滿 / 封包超標 / 等太久 → 直接拒絕&#10;★ 排隊期間刻意不持有任何連線物件，這樣舊世代才能正常收斂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="566" width="540" height="62" as="geometry" /></mxCell>
        <mxCell id="f7" value="⑦ 取得 Host Slot 租約&#10;確保「所有主機加總」不超過該組織的總併發上限&#10;✔ SQL 持久化版本 8 項 live 測試已通過" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="654" width="500" height="58" as="geometry" /></mxCell>
        <mxCell id="f8" value="⑧ 解析「當下」的 Active Profile 世代 → 取得 Execution Lease&#10;注意是排隊完才解析，所以換設定期間排隊的工作會用到新世代" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="738" width="500" height="52" as="geometry" /></mxCell>
        <mxCell id="f9" value="⑨ WorkerSupervisor 挑 worker&#10;依 profile 選 8.2 或 9.1；同時檢查回收政策：這個 worker 是不是該退休了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="816" width="500" height="52" as="geometry" /></mxCell>
        <mxCell id="f10" value="⑩ 序列化 → 具名管道送出&#10;Package01FeeWorkerContract → WorkerRequestV1&#10;WorkerEnvelopeValidator 檢查大小 / 版本 / 型別後才送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="894" width="540" height="58" as="geometry" /></mxCell>

        <mxCell id="f11" value="⑪ 進程邊界&#10;（net10 → net48）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="985" width="260" height="76" as="geometry" /></mxCell>
        <mxCell id="f12a" value="Crm82Worker（net48 進程）&#10;Package01FeeQueryOperation 組查詢&#10;→ 官方 CrmServiceClient 8.2.0.5&#10;→ IOrganizationService&#10;→ D365 CE 8.2 IFD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="1105" width="330" height="96" as="geometry" /></mxCell>
        <mxCell id="f12b" value="Crm91Worker（net48 進程）&#10;Package01FeeQueryOperation 組查詢&#10;→ 官方 CrmServiceClient 9.1.1.65&#10;→ IOrganizationService&#10;→ D365 CE 9.1 IFD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="1105" width="330" height="96" as="geometry" /></mxCell>
        <mxCell id="f12c" value="worker 進程的三道保護&#10;· 憑證來自 Windows 認證管理員（DPAPI）&#10;· 環境變數由 ProcessEnvironment 隔離&#10;· 結果超過上限 → ResultLimitExceeded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="1105" width="400" height="80" as="geometry" /></mxCell>

        <mxCell id="f13" value="⑫ WorkerResponseV1 回傳&#10;Package01FeeWorkerResponseProjector 投影成產品 DTO&#10;★ 這一步負責濾掉 CRM 真實 hostname、endpoint、內部識別碼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="1245" width="540" height="62" as="geometry" /></mxCell>
        <mxCell id="f14" value="⑬ 釋放 Execution Lease → 釋放 Admission Permit&#10;⑭ 依回收政策決定 worker 進程是否重啟&#10;★ 中途出例外時兩者各自獨立清理，錯誤一起彙總回報（不會互相遮蔽）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="1340" width="540" height="70" as="geometry" /></mxCell>
        <mxCell id="f15" value="✔ Soak 測試（6 世代 × 16 請求）在這一段監控 privateBytes / handles / threads 趨勢。&#10;　 08-03 曾抓到世代內記憶體單調成長，目前已修復。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="1430" width="540" height="52" as="geometry" /></mxCell>

        <mxCell id="q1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f1" target="fg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" value="false" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" edge="1" parent="1" source="fg" target="fl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" value="true" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="fg" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f10" target="f11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q13" value="crm82" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="f11" target="f12a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q14" value="crm91" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="f11" target="f12b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q15" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f12a" target="f13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q16" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f12b" target="f13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q17" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f13" target="f14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q18" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="f14" target="f15"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4 · 部署與維運" id="p4">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="部署與維運 · Worker 怎麼被產出、驗證與信任" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="核心問題：Gateway 怎麼確定「它啟動的那個 worker 執行檔」就是你當初編譯出來的那一個，沒有被掉包？答案是 SHA-256 雜湊綁定。" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1200" height="18" as="geometry" /></mxCell>

        <mxCell id="s1" value="① 產出 Worker 執行檔&#10;&#10;docs/scripts/Publish-DynamicsOfficialWorkers.ps1&#10;&#10;把 Crm82Worker 與 Crm91Worker 各自 publish 成&#10;獨立的 net48 執行檔，並計算 SHA-256。&#10;&#10;★ 刻意不把 worker-profile.xml 包進輸出，&#10;　 避免設定跟著執行檔一起散佈。&#10;&#10;有對應測試：Publish-DynamicsOfficialWorkers.Tests.ps1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="420" height="200" as="geometry" /></mxCell>

        <mxCell id="s2" value="② 產生部署 Manifest&#10;&#10;docs/scripts/New-DynamicsOfficialWorkerDeployment.ps1&#10;&#10;把「哪個 worker、哪個 CE 版本、套件版本鎖、&#10;世代、組織識別、執行檔 SHA-256」寫成 manifest。&#10;&#10;Gateway 啟動時讀這份 manifest，只信任雜湊相符的&#10;執行檔。雜湊對不上就 fail closed，不啟動。&#10;&#10;有對應測試：New-DynamicsOfficialWorkerDeployment.Tests.ps1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="90" width="440" height="200" as="geometry" /></mxCell>

        <mxCell id="s3" value="③ 相容性驗證 Harness&#10;&#10;docs/scripts/Invoke-DynamicsOfficialWorkerCompatibility.ps1&#10;&#10;兩種模式：&#10;&#10;ValidateOnly（不連網）&#10;　只讀有上限的 manifest / overlay / profile XML，&#10;　驗證 worker kind、CE 版本、套件鎖、世代、&#10;　組織識別與執行檔雜湊。不建立任何連線。&#10;&#10;Live（受控連網）&#10;　只允許固定的 runtime.health.whoami 操作。&#10;　無 cookie / 無 proxy / 無 redirect / 無解壓縮。&#10;&#10;★ 08-03 修掉一個 fail-open 缺口：&#10;　 ValidateOnly 先前沒驗證 Gateway 必須是 HTTPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="90" width="400" height="290" as="geometry" /></mxCell>

        <mxCell id="s4" value="④ 控制平面佈建&#10;&#10;Provision-DynamicsControlPlaneLocalDb.ps1&#10;　開發環境：在 LocalDB 建立&#10;　SpeechMessageDynamicsControlPlane 資料庫&#10;&#10;Provision-DynamicsControlPlaneOnD365App.ps1&#10;　正式環境：在 D365 應用主機上佈建&#10;&#10;★ Gateway 啟動時只驗證 schema 是否已由操作者&#10;　 佈建好；它不會自己建資料庫，也不會在失敗時&#10;　 退回記憶體版協調器（fail closed）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="420" height="230" as="geometry" /></mxCell>

        <mxCell id="s5" value="⑤ 邊界檢查（CI 護欄）&#10;&#10;eng/Verify-DynamicsWorkerBoundary.ps1&#10;　檢查 worker 的原始碼與專案邊界&#10;　→ 08-03 執行結果：0 findings&#10;&#10;確保：&#10;· net10 這一側不含任何 CRM SDK 型別&#10;· 產品不直接參考底層專案&#10;· worker 專案不參考 net10-only 的東西" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="320" width="440" height="230" as="geometry" /></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="gate" value="Phase 4C 的驗收結果（2026-08-03 Codex 記錄 · 我抽驗過測試部分）" style="swimlane;html=1;startSize=30;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1320" height="290" as="geometry" /></mxCell>
        <mxCell id="g1" value="✔ Harness regression（涵蓋非 HTTPS target、重複 JSON 屬性、artifact 竄改、worker kind / 套件鎖漂移、無 opt-in 模式）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="gate">
          <mxGeometry x="20" y="40" width="1280" height="28" as="geometry" /></mxCell>
        <mxCell id="g2" value="✔ Worker publication：CE 8.2 / 9.1 兩個執行檔的 SHA-256 與新 manifest 相符" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="gate">
          <mxGeometry x="20" y="74" width="1280" height="28" as="geometry" /></mxCell>
        <mxCell id="g3" value="✔ SQL 持久化協調器 live gate：8 通過 / 0 失敗（★ 我於 08-04 自行設定 LocalDB 連線重跑，同樣 8 通過 / 53 秒）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="gate">
          <mxGeometry x="20" y="108" width="1280" height="28" as="geometry" /></mxCell>
        <mxCell id="g4" value="✔ Dynamics 主測試套件：411 通過 / 0 失敗 / 7 略過（★ 我於 08-04 實跑確認）　　✔ CE 8.2 worker 15 通過　✔ CE 9.1 worker 15 通過" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="gate">
          <mxGeometry x="20" y="142" width="1280" height="28" as="geometry" /></mxCell>
        <mxCell id="g5" value="✔ Release 方案建置：0 warnings / 0 errors　　✔ Worker 邊界掃描：0 findings　　✔ ChurchReport 開機 GET /Login 200（含 no-store 快取標頭）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="gate">
          <mxGeometry x="20" y="176" width="1280" height="28" as="geometry" /></mxCell>
        <mxCell id="g6" value="⚠ 但 Phase 4C 文件本身明確聲明：不宣告 Phase 4C / 4 / 5 / 6 已完成。Package01FeeReadsEnabled 維持 false；Data8、Embedded、&#10;　 PowerPlatform.Dataverse.Client 均未移除。真實 CRM 連線（真機 WhoAmI、Operation Matrix、rollback）仍然是 0%。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="gate">
          <mxGeometry x="20" y="212" width="1280" height="52" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
