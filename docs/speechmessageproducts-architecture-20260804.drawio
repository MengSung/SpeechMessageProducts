  <diagram name="2 · Dynamics 模組詳解" id="p2">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1500" math="0" shadow="0">
