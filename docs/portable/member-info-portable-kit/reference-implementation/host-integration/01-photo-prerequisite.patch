+    function memberInfoAvatarSourceText(source) {
+        if (source === 'primary') { return '照'; }
+        if (source === 'line') { return 'LINE'; }
+        return '';
+    }
+
+    function memberInfoAvatarSourceTitle(source) {
+        if (source === 'primary') { return '主要頭像'; }
+        if (source === 'line') { return 'LINE 照片'; }
+        if (source === 'fallback') { return '預設剪影'; }
+        return '照片來源未標記';
+    }
+
+    */
+    function memberInfoAvatarSourceText(source) {
+        if (source === 'primary') { return '\u7167\u7247'; }
+        if (source === 'line') { return 'LINE'; }
+        return '';
+    }
+
+    function memberInfoAvatarSourceTitle(source) {
+        if (source === 'primary') { return '\u4e3b\u8981\u7167\u7247'; }
+        if (source === 'line') { return 'LINE \u7167\u7247'; }
+        if (source === 'fallback') { return '\u9810\u8a2d\u526a\u5f71'; }
