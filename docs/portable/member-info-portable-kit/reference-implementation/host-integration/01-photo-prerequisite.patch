+    var memberInfoQueuedImageIds = {};
+    var memberInfoPreloadTimer = null;
+    var memberInfoPreloadComponent = null;
+    // 載入中的本地佔位圖：綠底白色「上半身剪影」(頭與身體相連)。轉圈停止後不可再保留綠底。
+    var memberInfoLoadingAvatar = 'data:image/svg+xml;utf8,' + encodeURIComponent(
+        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='40' height='40'>" +
+        "<defs><clipPath id='mig'><circle cx='32' cy='32' r='32'/></clipPath></defs>" +
+        "<circle cx='32' cy='32' r='32' fill='#16a34a'/>" +
+        "<g clip-path='url(#mig)' fill='#ffffff'>" +
+        "<circle cx='32' cy='24.2' r='10.2'/>" +
+        "<path d='M8 64c1.5-17.2 10.9-29.6 24-29.6S54.5 46.8 56 64H8z'/>" +
+        "</g></svg>");
+    var memberInfoFinalFallbackAvatar = 'data:image/svg+xml;utf8,' + encodeURIComponent(
+        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='40' height='40'>" +
+        "<defs><clipPath id='migf'><circle cx='32' cy='32' r='32'/></clipPath></defs>" +
+        "<circle cx='32' cy='32' r='32' fill='#aeb6bf'/>" +
+        "<g clip-path='url(#migf)' fill='#ffffff'>" +
+        "<circle cx='32' cy='24.2' r='10.2'/>" +
+        "<path d='M8 64c1.5-17.2 10.9-29.6 24-29.6S54.5 46.8 56 64H8z'/>" +
+        "</g></svg>");
+
+    // ── 顯示照片 / 顯示全部 切換 ──
+    // 預設：顯示全部(按鈕綠色、文字「顯示照片」)；按下後只顯示真正有照片者(按鈕變藍、文字「顯示全部」)，再按一次切回。
+    var memberInfoPhotoOnly = false;
+    // 僅「全教會」管理者顯示「重新同步LINE」按鈕（由伺服器端 ViewBag 決定）。
+    var memberInfoCanResync = @(ViewBag.MemberInfoCanResync == true ? "true" : "false");
+
+    // 將後端或批次 API 回傳的照片來源值正規化，確保前端只處理三種合法狀態。
+    function memberInfoNormalizeAvatarSource(source) {
+        if (source === 'primary' || source === 'line' || source === 'fallback') {
+            return source;
+        }
+        return '';
+    }
+
+    /*
+        這段舊版註解保留下來，主要是方便比對來源文案的演進。
