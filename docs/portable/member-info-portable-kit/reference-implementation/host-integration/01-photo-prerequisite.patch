+            target.scrollLeft = 0;
+        });
+
+        $content.each(function () {
+            this.scrollTop = 0;
+            this.scrollLeft = 0;
+        });
+
+        var anchor = memberInfoGetDetailTopAnchor(contentElement);
+        if (!scrollTargets.length && anchor && typeof anchor.scrollIntoView === 'function') {
+            try {
+                anchor.scrollIntoView({ block: 'start', inline: 'nearest' });
+            } catch (ex) {
+                anchor.scrollIntoView(true);
+            }
+        }
+    };
+
+    // 以多次延遲重試的方式重設捲動，因為 popup / DataGrid 可能在數個 reflow 後才完成佈局。
+    window.memberInfoResetDetailScrollSoon = function (contentElement) {
+        var requestFrame = window.requestAnimationFrame || function (callback) {
+            window.setTimeout(callback, 0);
+        };
+        var token = ++memberInfoDetailScrollResetToken;
+
+        function resetIfCurrent() {
+            if (token !== memberInfoDetailScrollResetToken || memberInfoDetailUserInteracted) {
+                return;
+            }
+
+            window.memberInfoResetDetailScroll(contentElement);
+        }
+
+        resetIfCurrent();
+        requestFrame(resetIfCurrent);
+        window.setTimeout(resetIfCurrent, 40);
+        window.setTimeout(resetIfCurrent, 120);
+        window.setTimeout(resetIfCurrent, 260);
+        window.setTimeout(resetIfCurrent, 520);
+        window.setTimeout(resetIfCurrent, 900);
+        window.setTimeout(resetIfCurrent, 1400);
+        window.setTimeout(resetIfCurrent, 2100);
+        window.setTimeout(function () {
+            if (token === memberInfoDetailScrollResetToken && !memberInfoDetailUserInteracted && !memberInfoIsDetailTopVisible(contentElement)) {
