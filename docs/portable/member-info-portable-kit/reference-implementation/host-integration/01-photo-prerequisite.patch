@@ -0,0 +1,1262 @@
+@using ChurchReport.ViewModels
+
+@{
+    ViewBag.Title = "會友資訊";
+}
+
+<style>
+    /*
+        本頁為會友清單主畫面：上方工具列提供搜尋與操作按鈕，下方資料表負責呈現清單內容。
+        版面以桌機優先設計，手機時則透過 media query 壓縮間距與改變工具列排列方式，避免視覺擁擠。
+    */
+    .member-info-page {
+        padding: 10px 8px 20px;
+    }
+
+    /* 工具列分成左右兩側：左邊標題、右邊目前權限/提示文字。 */
+    .member-info-toolbar {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 12px;
+        margin-bottom: 10px;
+    }
+
+    /* 頁面標題維持簡潔強調，讓使用者一眼看出目前是在「會友資訊」頁。 */
+    .member-info-title {
+        margin: 0;
+        color: #1f2937;
+        font-size: 1.15rem;
+        font-weight: 700;
+    }
+
+    /* 權限/說明文字使用較淡的灰色，避免與標題競爭視覺焦點。 */
+    .member-info-access {
+        color: #64748b;
+        font-size: .9rem;
+        white-space: nowrap;
+    }
+
+    /* 白色卡片外框把 DevExtreme Grid 包起來，讓整體與頁面背景形成明確層次。 */
+    .member-info-grid-shell {
+        background: #fff;
+        border: 1px solid #d9e2ec;
+        border-radius: 8px;
+        padding: 10px;
+        box-shadow: 0 8px 18px rgba(15, 23, 42, .06);
+    }
+
+    /* 這顆按鈕用來快速切換「顯示全部 / 顯示照片」的資料模式，並保持與工具列同高。 */
+    .member-info-photo-filter-btn {
+        box-sizing: border-box;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        border: none;
+        border-radius: 6px;
+        padding: 0 16px;
+        height: 34px;
+        line-height: 1;
+        white-space: nowrap;
+        font-size: .95rem;
+        font-weight: 700;
+        color: #fff;
+        cursor: pointer;
+        background: #16a34a; /* 預設：綠色「顯示照片」 */
+        transition: background-color .15s ease;
+    }
+
+    /*
+        DevExtreme 的 toolbar 可能會因為預設 overflow 而裁切自訂按鈕。
