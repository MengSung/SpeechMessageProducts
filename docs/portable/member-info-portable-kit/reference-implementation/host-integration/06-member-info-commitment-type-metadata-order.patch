diff --git a/ChurchReport/Services/MemberInfo/MemberInfoCommitmentTypeCountQuery.cs b/ChurchReport/Services/MemberInfo/MemberInfoCommitmentTypeCountQuery.cs
new file mode 100644
index 0000000000000000000000000000000000000000..bf2ea61d57bca8a03b81dc1a145eab37d096b0c0
--- /dev/null
