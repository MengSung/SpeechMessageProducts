  <diagram name="3 · P6 卡點評估" id="p3">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="P6 卡點評估：安全檢查是否過於嚴謹？" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="結論：安全做法本身多數正確，但被用在錯的地方 —— P6.2 在替一個「擴充點」做生產級的真機驗證。" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1300" height="18" as="geometry" /></mxCell>

        <mxCell id="prog" value="P1～P8 進度（原計劃 vs 實際）" style="swimlane;html=1;startSize=32;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1420" height="290" as="geometry" /></mxCell>
        <mxCell id="pr1" value="P1　契約層對齊　　　　　　　　　　　✔ 完成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="prog">
          <mxGeometry x="18" y="42" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr2" value="P2　Data8 修 IDisposable　　　　　　 ✔ 完成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="prog">
          <mxGeometry x="18" y="78" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr3" value="P3　世代化連線池　　　　　　　　　　✔ 完成並歸檔（08-04）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="prog">
          <mxGeometry x="18" y="114" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr4" value="P4　Embedded F5　　　　　　　　　　 ✔ 完成並歸檔（08-05）★ 使用者設定的終點" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6D4;strokeColor=#1F7A4C;strokeWidth=2;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="prog">
          <mxGeometry x="18" y="150" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr5" value="P5　Dedicated Gateway　　　　　　　 ✔ 完成並歸檔（08-05）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="prog">
          <mxGeometry x="18" y="186" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr6" value="P6.1　Official Worker 接進 Router　　✔ 完成 ← 這就是原計劃的 P6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="prog">
          <mxGeometry x="718" y="42" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr7" value="P6.2　CE 真機整合驗證　　　　　　　 ✘ 卡關 3 天 ← 不在原計劃內" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;strokeWidth=2;fontSize=11;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="prog">
          <mxGeometry x="718" y="78" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr8" value="P7　消費者遷移（Package01 實際切換）　○ 未開始 ← 使用者真正會用到的" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="prog">
          <mxGeometry x="718" y="114" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="pr9" value="P8　Central Gateway　　　　　　　　 ○ 未開始（只有一個產品時無收益）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=12;fontColor=#666666;" vertex="1" parent="prog">
          <mxGeometry x="718" y="150" width="684" height="30" as="geometry" /></mxCell>
        <mxCell id="prn" value="★ 原計劃的 P6 是「把 63 檔 Worker 資產接成 ConnectorKind 的第二種實作，作為擴充點保留，1～2 天，不進 CI」。&#10;　 P6.1 正是那件事，已完成。之後展開的 P6.2「讓 net48 官方 Worker 真的連上 CE」從未寫在計劃裡。" style="text;html=1;fontSize=11;fontColor=#7A1D18;align=left;" vertex="1" parent="prog">
          <mxGeometry x="18" y="228" width="1384" height="46" as="geometry" /></mxCell>

        <mxCell id="sec" value="P6.2 要求操作者做的事 · 逐項評估" style="swimlane;html=1;startSize=32;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="396" width="1420" height="380" as="geometry" /></mxCell>
        <mxCell id="sh1" value="做法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="18" y="40" width="560" height="28" as="geometry" /></mxCell>
        <mxCell id="sh2" value="評估" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="586" y="40" width="120" height="28" as="geometry" /></mxCell>
        <mxCell id="sh3" value="理由" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="714" y="40" width="688" height="28" as="geometry" /></mxCell>

        <mxCell id="sa1" value="憑證放 Windows 認證管理員，不放設定檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="76" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb1" value="必要" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="586" y="76" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc1" value="這是專案自己列的底線之一，也是正確做法。做一次就長期有效。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="76" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="sa2" value="不把密碼貼進 chat／repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="114" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb2" value="必要" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="586" y="114" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc2" value="基本紀律，成本為零。而且你的 repo 有 GitHub remote。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="114" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="sa3" value="只回貼 sanitized JSON，不貼原始輸出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="152" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb3" value="合理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;" vertex="1" parent="sec">
          <mxGeometry x="586" y="152" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc3" value="避免誤貼 endpoint／GUID／例外堆疊。成本低，保留。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="152" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="sa4" value="12 個 Read-Host 提示逐一輸入 URI／GUID／home realm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="190" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb4" value="過度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="586" y="190" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc4" value="這些值大多已經在 OrganizationCatalog 裡（5 個 Organization 的 GUID 早就取得）。而且它們不是秘密。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="190" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="sa5" value="每個診斷步驟一支獨立 .ps1 ＋ 對應的 .Tests.ps1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="228" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb5" value="過度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="586" y="228" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc5" value="為一次性的診斷步驟寫單元測試。這些腳本用完就不會再用，測試維護成本沒有回收機會。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="228" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="sa6" value="專門寫腳本比對「帳號形式」但不揭露該形式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="266" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb6" value="過度" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;fontStyle=1;" vertex="1" parent="sec">
          <mxGeometry x="586" y="266" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc6" value="這是在保護「使用者自己說過可以公開、將來都會更換」的實驗室憑證。防護等級與資產價值不成比例。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="266" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="sa7" value="要求手動開瀏覽器確認 CE Organization 首頁能載入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="18" y="304" width="560" height="34" as="geometry" /></mxCell>
        <mxCell id="sb7" value="合理但無效" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;" vertex="1" parent="sec">
          <mxGeometry x="586" y="304" width="120" height="34" as="geometry" /></mxCell>
        <mxCell id="sc7" value="確認過了、結果是 confirmed，Worker 仍然 exitCode 20／21。這代表問題不在授權，在 SDK 的權杖交換。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="sec">
          <mxGeometry x="714" y="304" width="688" height="34" as="geometry" /></mxCell>

        <mxCell id="verd" value="關鍵判斷" style="swimlane;html=1;startSize=32;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=14;fontStyle=1;fontColor=#7A1D18;" vertex="1" parent="1">
          <mxGeometry x="40" y="802" width="1420" height="300" as="geometry" /></mxCell>
        <mxCell id="vd1" value="① 安全做法本身沒有錯，錯在被用到「擴充點」上&#10;&#10;憑證進 Credential Manager、不貼密碼、回傳去識別化 JSON —— 這三項在任何專案都該做，成本也低。&#10;但把它們擴展成「每步一支腳本＋一份測試＋一次去識別化比對」，是生產級遷移才需要的儀式。&#10;而 P6.2 保護的對象，是使用者自己說過「將來都會更換掉，不用太擔心暴露」的 Hyper-V 實驗室憑證。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A32620;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="verd">
          <mxGeometry x="18" y="42" width="1384" height="76" as="geometry" /></mxCell>
        <mxCell id="vd2" value="② P6.2 撞上的是 v1 與 v2 死掉的同一道牆&#10;&#10;現況：workerExitCode 20／21，startupClassification = sdk-unclassified-failure ／ sdk-diagnostic-unavailable。&#10;handoff 文件自己寫下一步需要「CE／AD FS owner 對 SDK username/password 權杖交換失敗的分類」。&#10;那正是 v1（服務身分權杖不存在）與 v2（需要 AD FS 管理員註冊 client）卡住的同一類問題 —— 需要 AD FS 專業與權限。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A32620;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="verd">
          <mxGeometry x="18" y="126" width="1384" height="76" as="geometry" /></mxCell>
        <mxCell id="vd3" value="③ 主線目標早就達成了&#10;&#10;P4（Embedded F5）是你在 08-04 親自設定的任務終點，已於 08-05 完成並歸檔。P5 也完成了。&#10;Data8 主線健康：462 項測試通過，連線池、世代管理、借還淘汰全部就緒。&#10;卡住的 Official Worker 是「保留但不進 CI 的擴充點」—— 它不需要通過真機驗證才能存在。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontColor=#12492E;" vertex="1" parent="verd">
          <mxGeometry x="18" y="210" width="1384" height="76" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4 · 建議" id="p4">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="建議：停 P6.2，往 P7 走" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" /></mxCell>

        <mxCell id="a1" value="① 把 Official Worker 標記為「擴充點 · 未經真機驗證」，結束 P6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1320" height="40" as="geometry" /></mxCell>
        <mxCell id="a1b" value="這與 08-04 的原始決定一致：「不進 CI、不寫平行行為測試、不承諾兩種 Connector 行為一致」。&#10;程式碼保留（63 檔＋新增的診斷腳本），文件註明「已完成 Router 接線，真機驗證未通過，需 AD FS 端支援」。&#10;將來若真的需要原廠元件，屆時再連同 AD FS 支援一起處理 —— 那時才有解決它的條件。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="124" width="1320" height="80" as="geometry" /></mxCell>

        <mxCell id="a2" value="② 往 P7 走：把 Package01 讀取路徑實際切到 Data8 新架構" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE9F7;strokeColor=#1F5FA8;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="224" width="1320" height="40" as="geometry" /></mxCell>
        <mxCell id="a2b" value="這是唯一還沒兌現的實際價值。目前 Package01FeeReadsEnabled 仍為 false，&#10;所有產品讀取仍走 legacy 路徑 —— 15 天下來，架構圖上那條粗紅線從未改變。&#10;做法：依既有 Tier A～D 分級逐步開啟，每一級與 legacy 對帳筆數與金額，任一級失敗即關旗標回退。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F5FA8;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="268" width="1320" height="80" as="geometry" /></mxCell>

        <mxCell id="a3" value="③ 保留這三項安全做法，刪掉其餘儀式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="368" width="1320" height="40" as="geometry" /></mxCell>
        <mxCell id="a3b" value="保留：憑證進 Windows 認證管理員　·　不貼密碼進 chat／repo　·　回傳去識別化 JSON&#10;&#10;停用：為一次性診斷腳本寫 .Tests.ps1　·　12 個 Read-Host 逐項輸入（值已在 OrganizationCatalog）&#10;　　　專門的帳號形式比對腳本　·　多層 go／no-go 交接文件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="412" width="1320" height="90" as="geometry" /></mxCell>

        <mxCell id="warn" value="要注意的一件事：任務樹已經長出五層" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;strokeWidth=2;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fontColor=#7A1D18;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1320" height="40" as="geometry" /></mxCell>
        <mxCell id="warnb" value="07-23-dynamics-connection-compatibility　（父，官方 Worker 方向）&#10;　└─ 08-04-dynamics-connection-management-plan　（規劃，3/4 done）&#10;　　　└─ 08-05-official-worker-router-ce-integration　（P6，卡關中）&#10;&#10;另有 08-05-gateway-purpose-and-positioning ＋ 08-05-gateway-capability-inventory 兩個平行規劃任務。&#10;目前 8 個 active 任務，其中 4 個與 Dynamics 有關。任務數量本身已是一種成本 —— 每個都要維護狀態、都會觸發 loop 偵測。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A32620;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="40" y="574" width="1320" height="130" as="geometry" /></mxCell>

        <mxCell id="fin" value="一句話：程式碼那一側已經沒有東西擋路了。卡住的是一條我們早就說好「不必打通」的支線。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6D4;strokeColor=#1F7A4C;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#12492E;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1320" height="46" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
