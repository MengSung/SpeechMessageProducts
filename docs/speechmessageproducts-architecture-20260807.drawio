  <diagram name="2 · Dynamics 模組詳解" id="p2">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Dynamics 連線管理 · 每個模組在做什麼" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="核心觀念：ConnectionMode 決定「共用核心跑在哪個進程」，不決定「要不要治理」。三種模式在 ControlPlane 之後共用完全相同的程式碼。" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1300" height="18" as="geometry" /></mxCell>

        <mxCell id="abs" value="Abstractions · 24 檔（net10 · 零相依）&#10;&#10;【它是什麼】&#10;整個連線管理層的「共同語言」。所有模組&#10;都參考它，它不參考任何人。&#10;&#10;【裡面有什麼】&#10;ConnectionMode　三值列舉&#10;　Embedded／DedicatedGateway／CentralGateway&#10;&#10;ConnectorKind　三值列舉&#10;　Data8／OfficialCrm82Worker／OfficialCrm91Worker&#10;&#10;CeVersion　Ce82／Ce91&#10;&#10;IDynamicsOperationExecutor&#10;　唯一的執行抽象&#10;&#10;OrganizationCatalog&#10;　5 個 Organization 的身分事實&#10;　FriendlyName／UniqueName／OrganizationId／State&#10;　★ 只存身分，不存憑證&#10;&#10;IProfileResolver／ResolvedProfile&#10;ProductDynamicsOptions（只有三欄位）&#10;DynamicsErrorCodes&#10;&#10;【為什麼重要】&#10;四次架構轉向，這一層都沒被打掉重寫。&#10;它就是可以換掉底層實作的原因。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef7;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="330" height="560" as="geometry" /></mxCell>

        <mxCell id="prod" value="ChurchReport（產品 · net10）　只參考 Abstractions ＋ ProductClient ＋ Embedded　★ 有邊界測試禁止它直接碰傳輸層" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="80" width="1110" height="46" as="geometry" /></mxCell>

        <mxCell id="pc" value="ProductClient · 8 檔（net10）　【產品唯一入口】" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="156" width="1110" height="120" as="geometry" /></mxCell>
        <mxCell id="pc1" value="Package01FeeReadClient&#10;產品呼叫的業務方法：依聯絡人／&#10;日期查奉獻費用、課程紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="14" y="34" width="352" height="70" as="geometry" /></mxCell>
        <mxCell id="pc2" value="GatewayDynamicsOperationExecutor&#10;把 ProfileAlias ＋ OperationId ＋ 具名參數&#10;打包送出。不能送 FetchXML／URL／SQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="378" y="34" width="352" height="70" as="geometry" /></mxCell>
        <mxCell id="pc3" value="FeeRecordDto／StorLessonRecordDto&#10;純資料模型。裡面沒有任何 CRM 概念&#10;（沒有 Entity、沒有 GUID 欄位語意）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pc">
          <mxGeometry x="742" y="34" width="354" height="70" as="geometry" /></mxCell>

        <mxCell id="mode" value="ConnectionMode　決定共用核心跑在哪個進程（三種都是正式部署選項）" style="swimlane;html=1;startSize=28;fillColor=#DDE9F7;strokeColor=#1F5FA8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="306" width="1110" height="120" as="geometry" /></mxCell>
        <mxCell id="mo1" value="Embedded　【開發用中】&#10;共用核心在產品進程內，無 HTTP 跳躍&#10;VS 2026 按 F5 直接跑&#10;沿用既有 CrmConnection 設定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="mode">
          <mxGeometry x="14" y="34" width="352" height="70" as="geometry" /></mxCell>
        <mxCell id="mo2" value="DedicatedGateway　【正式設定中】&#10;獨立進程，與單一產品一起部署&#10;同主機可用 https://localhost:7244/&#10;故障隔離但不跨產品共用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="mode">
          <mxGeometry x="378" y="34" width="352" height="70" as="geometry" /></mxCell>
        <mxCell id="mo3" value="CentralGateway　【未啟用】&#10;共用服務，多產品集中治理&#10;只有第二個產品接入時才有收益&#10;多節點時才需要分散式協調器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=8;fontColor=#666666;" vertex="1" parent="mode">
          <mxGeometry x="742" y="34" width="354" height="70" as="geometry" /></mxCell>

        <mxCell id="gw" value="Gateway · 11 檔（net10）　【信任邊界】僅 DedicatedGateway／CentralGateway 使用" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="456" width="1110" height="110" as="geometry" /></mxCell>
        <mxCell id="gw1" value="Kestrel ＋ Negotiate&#10;Windows 身分驗證&#10;未驗證即 401（讀 body 之前）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="14" y="34" width="352" height="62" as="geometry" /></mxCell>
        <mxCell id="gw2" value="Security/　WorkloadBinding&#10;身分 → 可用 alias／可執行 operation&#10;未授權即 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="378" y="34" width="352" height="62" as="geometry" /></mxCell>
        <mxCell id="gw3" value="RequestLimits／ReadinessService&#10;請求大小上限、就緒檢查&#10;部署設定與雜湊綁定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="gw">
          <mxGeometry x="742" y="34" width="354" height="62" as="geometry" /></mxCell>

        <mxCell id="band" value="★★★　三種模式在這裡匯合 —— 以下每一層都是同一份程式碼、同一套規則、同一組測試　★★★" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6D4;strokeColor=#1F7A4C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#12492E;" vertex="1" parent="1">
          <mxGeometry x="410" y="596" width="1110" height="38" as="geometry" /></mxCell>

        <mxCell id="cp" value="ControlPlane · 37 檔（net10）　【治理層】決定「誰能跑、跑幾個、用哪一代連線」" style="swimlane;html=1;startSize=28;fillColor=#cfe2f3;strokeColor=#3d6ea5;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="664" width="1110" height="230" as="geometry" /></mxCell>
        <mxCell id="cp1" value="RequestGuard　G1～G6&#10;拒絕 Request 自帶 OrganizationId／&#10;ConnectorKind／Credential／endpoint／&#10;FetchXML。在讀 body 之前完成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="14" y="34" width="352" height="76" as="geometry" /></mxCell>
        <mxCell id="cp2" value="ProfileResolver　R1～R6&#10;ProfileAlias → OrganizationAlias →&#10;OrganizationCatalog → OrganizationId&#10;不存在／停用／不相容一律 Fail Closed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="378" y="34" width="352" height="76" as="geometry" /></mxCell>
        <mxCell id="cp3" value="ConnectorRouter&#10;只讀 Profile 固定的 ConnectorKind&#10;禁止 Request-time fallback&#10;版本不相容立即拒絕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="742" y="34" width="354" height="76" as="geometry" /></mxCell>
        <mxCell id="cp4" value="AdmissionControl&#10;有界佇列 · 併發號誌 · 逾時&#10;佇列滿立即拒絕，保護記憶體&#10;★ Permit 必須先取得，才解析世代" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="14" y="120" width="352" height="76" as="geometry" /></mxCell>
        <mxCell id="cp5" value="ProfileGenerationManager&#10;設定不可變；變更建立新世代&#10;每 alias 最多 1 Active ＋ 1 Draining&#10;舊世代 Lease 歸零後才 Dispose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="378" y="120" width="352" height="76" as="geometry" /></mxCell>
        <mxCell id="cp6" value="CapacityCoordinator&#10;InMemory（預設，Embedded／Dedicated／&#10;單節點 Central 皆足夠）&#10;SQL 版僅多節點 Central 需要，非必要條件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cp">
          <mxGeometry x="742" y="120" width="354" height="76" as="geometry" /></mxCell>

        <mxCell id="ck" value="ConnectorKind　傳輸實作（由 Profile 固定，不可由 Request 指定）" style="swimlane;html=1;startSize=28;fillColor=#ffffff;strokeColor=#1F5FA8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="924" width="1110" height="290" as="geometry" /></mxCell>
        <mxCell id="ck1" value="Connectors.Data8 · 7 檔　【主線 · 唯一啟用】&#10;&#10;Data8ConnectorPool　世代化連線池&#10;　池鍵 =（ProfileAlias, GenerationId）&#10;　MinSize／MaxSize／IdleTimeout／健康檢查&#10;IConnectorLease　含 MarkFaulted&#10;　健康 → 歸還原世代池&#10;　故障／取消／逾時 → 淘汰並 Dispose，永不回池&#10;&#10;傳輸：PowerPlatform.Dataverse.Client（Data8，MIT）&#10;　同進程 WS-Trust，支援 CE 8.2 與 9.1&#10;　★ 已修 IDisposable（WCF channel 確定關閉）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="ck">
          <mxGeometry x="14" y="34" width="536" height="240" as="geometry" /></mxCell>
        <mxCell id="ck2" value="Official Worker　【擴充點 · 未經真機驗證】&#10;&#10;WorkerProtocol · 19（netstandard2.0）&#10;　IPC 契約：Request／Response／Ready／Drain&#10;　編解碼 · 驗證 · 大小上限 · 版本協商&#10;WorkerHost · 20（netstandard2.0）&#10;　具名管道 · 進程宿主 · Windows 認證管理員&#10;WorkerSupervisor · 11（net10）&#10;　派工 · 回收政策 · 資源觀測 · 子行程環境隔離&#10;Crm82Worker／Crm91Worker · 各 4（net48）&#10;　官方 XrmTooling 8.2.0.5／9.1.1.65&#10;&#10;⚠ 真機啟動卡在 SDK 驗證邊界（見分頁 4）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="ck">
          <mxGeometry x="562" y="34" width="534" height="240" as="geometry" /></mxCell>

        <mxCell id="crm" value="D365 CE 8.2 ／ 9.1　（IFD · WS-Trust · AD FS）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="1250" width="410" height="46" as="geometry" /></mxCell>

        <mxCell id="ea" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="prod" target="pc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="pc" target="mode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="mode" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F7A4C;" edge="1" parent="1" source="gw" target="band"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" value="Embedded 直接到這裡（省略 HTTP，不省略治理）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#1F7A4C;fontSize=10;exitX=0;exitY=0.5;" edge="1" parent="1" source="mo1" target="band">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="375" /><mxPoint x="390" y="615" /></Array></mxGeometry></mxCell>
        <mxCell id="ef" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="band" target="cp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eg" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="cp" target="ck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eh" value="借出 ↺ 歸還" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" edge="1" parent="1" source="ck1" target="crm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei" value="卡關" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#8A5A00;dashed=1;fontSize=11;" edge="1" parent="1" source="ck2" target="crm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ej" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="pc" target="abs"><mxGeometry relative="1" as="geometry" /></mxCell>

