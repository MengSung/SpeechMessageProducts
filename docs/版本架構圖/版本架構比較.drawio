          <mxGeometry x="20" y="168" width="370" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n122" value="WorkerSupervisor&#10;生出 / 看管 / 回收 worker 子行程" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n118">
          <mxGeometry x="20" y="230" width="370" height="52" as="geometry" />
