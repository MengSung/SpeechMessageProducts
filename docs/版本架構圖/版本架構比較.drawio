        <mxCell id="e123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7d5b96;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n117" target="n118">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n124" value="行程 C、D … · Worker 子行程（由 WorkerSupervisor 啟動）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fff8ee;strokeColor=#cc7a2e;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="450" height="460" as="geometry" />
        </mxCell>
        <mxCell id="n125" value="SpeechMessage.Dynamics.Crm91Worker&#10;處理 CE 9.1&#10;Web API / 官方 ServiceClient" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bd9a26;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n124">
          <mxGeometry x="20" y="50" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n126" value="SpeechMessage.Dynamics.Crm82Worker&#10;.NET Framework 4.8 執行環境&#10;Microsoft 官方 CrmServiceClient — WS-Trust / SOAP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n124">
          <mxGeometry x="20" y="180" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n127" value="重點：舊 CRM SDK 沒有被刪掉，而是關在這個獨立行程裡。&#10;它掛掉、記憶體漏、綁死 .NET Framework，都不會拖累主網站。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontSize=11.5;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="n124">
          <mxGeometry x="20" y="320" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e128" value="HTTP ← 行程邊界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#cc7a2e;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n111" target="n116">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e129" value="WorkerProtocol ← 行程邊界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4a72a8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n118" target="n125">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e130" value="WorkerProtocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4a72a8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n118" target="n126">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n131" value="外部 CRM" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#f7f7f8;strokeColor=#8c8c8c;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="130" width="270" height="460" as="geometry" />
        </mxCell>
        <mxCell id="n132" value="D365 CE 9.1&#10;sunnyvalechback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#8c8c8c;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n131">
          <mxGeometry x="20" y="60" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n133" value="D365 CE 8.2&#10;jesus" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#8c8c8c;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n131">
          <mxGeometry x="20" y="200" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e134" value="Web API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#bd9a26;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n125" target="n132">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e135" value="SOAP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b03a35;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n126" target="n133">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n136" value="② 容量控管落到 SQL" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#f2fafa;strokeColor=#3d8b8b;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n137" value="SqlRuntimeHostSlotCoordinator：跨行程 / 跨主機的租約。&#10;1.0.0.2 只有 InMemory 版本，同一台機器起兩個行程就各算各的；1.0.0.3 把 host slot 租約寫進 SQL，Gateway / Worker / 藍綠部署才真的共用同一份併發預算。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d8b8b;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n136">
          <mxGeometry x="20" y="44" width="760" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n138" value="③ Embedded 在這一版的下場" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fffdf5;strokeColor=#bd9a26;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="630" width="770" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n139" value="沒有被刪除，但被降級：commit 58fa04bf 註明「Embedded 專案僅保留測試參考」，設計指南也寫「先保留、不再擴大」。&#10;Local Gateway（在本機另起一個 Gateway 行程）實際上取代了 Embedded 原本的定位。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bd9a26;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n138">
          <mxGeometry x="20" y="44" width="730" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n140" value="④ 相對於 1.0.0.2，本質上只改了三件事&#10;&#10;1  隔離的粒度：專案 → 行程。真正打 CRM 的動作被推到獨立子行程，中間用 WorkerProtocol 傳訊框。&#10;2  「完全不用 SDK」的教條鬆綁。現場證明 8.2 IFD 只有 SOAP 走得通，於是改用官方 CrmServiceClient，但關進 net48 的獨立 worker；Data8 版只當暫時橋接。&#10;3  治理從記憶體搬到持久化儲存。加上 SqlRuntimeHostSlotCoordinator，租約有 fencing、有 TTL、可跨主機。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=16;spacingTop=12;verticalAlign=top;fontSize=12.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1620" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6 · 同一動作三版路徑對照" id="pg216">
