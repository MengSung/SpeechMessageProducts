        </mxCell>
        <mxCell id="n19" value="1.0.0.1 · MemberInfo" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#5d8a4e;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="366" width="520" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="純功能版：完全沒有任何 Dynamics 專案" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="n19">
          <mxGeometry x="20" y="44" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="做了什麼&#10;· 會友樹狀介面、搜尋、頭像分塊載入&#10;· 可攜部署套件 portable kit&#10;&#10;Dynamics 怎麼連&#10;· ChurchReport 直接呼叫 ToolUtility&#10;· ToolUtility 抱著 Data8 的 CRM SDK&#10;· 整站共用一個 singleton 連線池&#10;· CRM 密碼放在產品設定裡&#10;&#10;痛點&#10;· 未來 5～10 個產品各抱一份 SDK 與密碼&#10;· 8.2 / 9.1 相容邏輯每個產品各寫一次" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#4b5563;align=left;" vertex="1" parent="n19">
          <mxGeometry x="20" y="104" width="480" height="330" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="起點：連線器和產品綁在一起" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#5d8a4e;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="n19">
          <mxGeometry x="20" y="442" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="1.0.0.2 · IsolateConnector" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#4a72a8;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="366" width="520" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="把連線器抽成 7 個獨立專案，但仍在同一個行程內" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="n23">
          <mxGeometry x="20" y="44" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="做了什麼&#10;＋ 新增 7 個 .NET 10 專案&#10;＋ 連線改走純 HTTP OData v4（no-SDK）&#10;＋ 能力白名單 Package01OperationRegistry&#10;＋ CI 閘門 eng/Verify-NoDynamicsSdk.ps1&#10;&#10;Gateway / Embedded 在這版誕生&#10;· 同一套 runtime 的兩個「寄生位置」&#10;&#10;限制&#10;▲ 容量協調只有 InMemory&#10;▲ Package01FeeReadsEnabled = false（尚未上線）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#4b5563;align=left;" vertex="1" parent="n23">
          <mxGeometry x="20" y="104" width="480" height="330" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="隔離「程式碼」，還沒隔離「行程」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4a72a8;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="n23">
          <mxGeometry x="20" y="442" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="1.0.0.3 · Gateway&amp;Embedded" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#7d5b96;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="366" width="520" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="承認 8.2 必須用官方 SDK，於是把它關進獨立子行程" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7d5b96;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="n27">
          <mxGeometry x="20" y="44" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="刪掉&#10;－ SpeechMessage.Dynamics.WebApi&#10;－ SpeechMessage.Dynamics.SmokeTests&#10;&#10;新增&#10;＋ ControlPlane（原 WebApi 內容搬來並擴充）&#10;＋ WorkerProtocol / WorkerHost / WorkerSupervisor&#10;＋ Crm82Worker（net48＋官方 CrmServiceClient）、Crm91Worker&#10;＋ SqlRuntimeHostSlotCoordinator&#10;&#10;觀念轉向&#10;▲ 舊 SDK 不消滅，改隔離&#10;▲ Embedded 降級為僅測試參考" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#4b5563;align=left;" vertex="1" parent="n27">
          <mxGeometry x="20" y="104" width="480" height="330" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="隔離「行程」，舊 SDK 被關進沙箱" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#7d5b96;strokeColor=#7d5b96;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="n27">
          <mxGeometry x="20" y="442" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="一句話串起來：1.0.0.1「連線器住在產品裡」 → 1.0.0.2「連線器搬到隔壁專案，但還住同一棟樓」 → 1.0.0.3「危險的舊 SDK 搬去另一棟樓，用對講機溝通」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#22252d;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1620" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
