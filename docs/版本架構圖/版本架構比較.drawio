        <mxCell id="n120" value="OrganizationAdmissionManager&#10;同一個 CRM 的總併發上限" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n118">
