        <mxCell id="n32" value="1.0.0.1 · MemberInfo — 起點架構" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=24;fontColor=#22252d;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="連線器和產品綁在一起。ChurchReport 自己抱著 CRM SDK、自己存密碼、自己開連線池。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12.5;fontColor=#6b7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="作業系統行程 #1（唯一） — w3wp.exe / dotnet ChurchReport" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#f4faf2;strokeColor=#5d8a4e;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="860" height="620" as="geometry" />
        </mxCell>
        <mxCell id="n35" value="SpeechMessageProducts.ChurchReport&#10;Controllers / Services" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="n34">
          <mxGeometry x="40" y="60" width="780" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="ToolUtility&#10;組 QueryExpression / FetchXML" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bd9a26;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n34">
          <mxGeometry x="40" y="180" width="780" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="PowerPlatform.Dataverse.Client（Data8 版）&#10;IOrganizationService / OrganizationRequest — 底層 WS-Trust / SOAP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n34">
          <mxGeometry x="40" y="300" width="780" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="singleton CrmConnectionPool（全站共用一個）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n34">
          <mxGeometry x="40" y="420" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="CrmConnection 設定：帳號 / 密碼 / Organization 由產品自己保管" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe0c2;strokeColor=#cc7a2e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n34">
          <mxGeometry x="40" y="510" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e40" value="直接呼叫，沒有任何契約限制" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5d8a4e;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n35" target="n36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#bd9a26;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n36" target="n37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b03a35;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n37" target="n39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="D365 CE 8.2 IFD&#10;jesus" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#8c8c8c;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="330" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="D365 CE 9.1 IFD&#10;sunnyvalechback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#8c8c8c;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="960" y="450" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e45" value="SOAP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b03a35;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n34" target="n43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e46" value="SOAP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b03a35;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n34" target="n44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="這個架構的 4 個問題（就是 1.0.0.2 想解決的）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fff8f8;strokeColor=#b03a35;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="130" width="420" height="620" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="1  誰都能對 CRM 下任意查詢&#10;&#10;任何一行程式碼都能組任意 FetchXML 直接送出去，沒有白名單、沒有審計、沒有上限。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c9c7;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n47">
          <mxGeometry x="20" y="50" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="2  密碼跟 SDK 綁在產品身上&#10;&#10;未來 5～10 個產品，就會有 5～10 份 CRM 密碼與 SDK DLL 各自散落。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c9c7;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n47">
          <mxGeometry x="20" y="190" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="3  一個 singleton 連線池管全部&#10;&#10;8.2 與 9.1、正式與測試都擠同一個池子，沒有 per-profile 隔離也沒有總量控管。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c9c7;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n47">
          <mxGeometry x="20" y="330" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="4  SDK 綁死執行環境&#10;&#10;舊 CRM SDK 屬於 .NET Framework 世界，擋住整個產品往 .NET 10 走。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c9c7;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n47">
          <mxGeometry x="20" y="470" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="怎麼記住這一版：「ChurchReport 這個網站，自己就是 CRM 客戶端。」ToolUtility 和 CRM SDK 只是它身上的兩層皮 — 沒有邊界、沒有契約、沒有第二個行程。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontSize=13;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1620" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · 1.0.0.2 抽出連線器" id="pg213">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n53" value="1.0.0.2 · IsolateConnector — 你現在的版本" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=24;fontColor=#22252d;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="把連線器從產品身上剝下來，變成 7 個獨立專案，並用「誰可以參考誰」把邊界釘死。箭頭 = csproj 的 ProjectReference（A → B 表示 A 參考 B）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12.5;fontColor=#6b7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n55" value="① 7 個新專案，以及允許的參考方向" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fbfcfd;strokeColor=#c8ced6;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1040" height="520" as="geometry" />
        </mxCell>
        <mxCell id="n56" value="SpeechMessageProducts.ChurchReport&#10;只准參考 Abstractions / ProductClient / Embedded" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="n55">
          <mxGeometry x="60" y="60" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n57" value="ProductClient&#10;IPackage01FeeReadClient" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d4f0f0;strokeColor=#3d8b8b;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n55">
          <mxGeometry x="60" y="180" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n58" value="Embedded&#10;內嵌宿主轉接器" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n55">
          <mxGeometry x="320" y="180" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n59" value="WebApi（PRIVATE）&#10;no-SDK 連線器&#10;純 HTTP / OData v4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n55">
          <mxGeometry x="320" y="300" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n60" value="另一個作業系統行程" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#f8f5fa;strokeColor=#7d5b96;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="n55">
          <mxGeometry x="600" y="160" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n61" value="Gateway&#10;POST /v1/organizations/{alias}/operations/{id}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7d5b96;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n60">
          <mxGeometry x="20" y="50" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n62" value="WebApi（同一份程式碼）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n60">
          <mxGeometry x="20" y="150" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="SpeechMessage.Dynamics.Abstractions&#10;DTO / IDynamicsOperationExecutor / Package01OperationRegistry（能力白名單）— 大家都參考它" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe0c2;strokeColor=#cc7a2e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n55">
          <mxGeometry x="60" y="420" width="940" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5d8a4e;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n56" target="n57">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5d8a4e;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n56" target="n58">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4a72a8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n58" target="n59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7d5b96;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n61" target="n62">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e68" value="HTTP（不是 ProjectReference）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#3d8b8b;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="n57" target="n60">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="✗ 產品禁止直接參考 WebApi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;dashed=1;fontColor=#b03a35;fontStyle=1;" vertex="1" parent="n55">
          <mxGeometry x="60" y="300" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n70" value="② 呼叫契約：這才是「隔離」真正的意思" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fbfcfd;strokeColor=#c8ced6;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1040" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="POST /v1/organizations/{alias}/operations/{capabilityOperationId}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontColor=#7dd3fc;fontFamily=Courier New;fontSize=15;" vertex="1" parent="n70">
          <mxGeometry x="20" y="50" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n72" value="呼叫端「只能」給這三樣&#10;&#10;· 邏輯環境別名 alias&#10;· 已註冊的能力代號 capabilityOperationId&#10;· 型別受限、有邊界的具名參數" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="n70">
          <mxGeometry x="20" y="120" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n73" value="呼叫端「不能」給這些&#10;&#10;· FetchXML 或任何片段（樣板寫死在伺服器端）&#10;· OData 查詢字串、CRM 資料表 / 欄位名稱&#10;· 實體 profile、CRM 網址、憑證、Authorization 標頭" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;" vertex="1" parent="n70">
          <mxGeometry x="530" y="120" width="490" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n74" value="③ 三道守門機制（邊界不是靠自律，是靠工具擋）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fbfcfd;strokeColor=#c8ced6;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="120" width="540" height="400" as="geometry" />
        </mxCell>
        <mxCell id="n75" value="1  csproj 宣告：WebApi.csproj 的 Description 直接寫死&#10;「Only Gateway and Embedded may reference this project.」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dbe3ec;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n74">
          <mxGeometry x="20" y="50" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n76" value="2  單元測試守線：ProjectReferenceBoundaryTests.cs&#10;有人偷加參考，測試就紅。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dbe3ec;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n74">
          <mxGeometry x="20" y="162" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n77" value="3  CI 掃描：eng/Verify-NoDynamicsSdk.ps1 + no-sdk-source-roots.json&#10;掃 Microsoft.Xrm* / Microsoft.CrmSdk* / IOrganizationService 殘留。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dbe3ec;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n74">
          <mxGeometry x="20" y="274" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n78" value="④ 但是——現況要看清楚（程式碼到位 ≠ 已經上線）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fffdf5;strokeColor=#bd9a26;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="550" width="540" height="400" as="geometry" />
        </mxCell>
        <mxCell id="n79" value="appsettings.json&#10;DynamicsAccess:Package01FeeReadsEnabled = false" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bd9a26;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontFamily=Courier New;fontSize=12;" vertex="1" parent="n78">
          <mxGeometry x="20" y="50" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n80" value="整套新路徑已接好線，但開關是關的。&#10;正式查詢仍走 1.0.0.1 的舊 ToolUtility / SOAP 路徑。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#7c5c14;align=left;" vertex="1" parent="n78">
          <mxGeometry x="20" y="134" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n81" value="為什麼還不能開？&#10;&#10;· 目標 CE 9.1 是 IFD，Web API 不能用 Windows NTLM（回 302）&#10;· 改走 ADFS OAuth，但 ADFS 回 MSIS9611：只支援 authorization_code / refresh_token&#10;· 現有 ClientId 沒有註冊在該台 on-prem ADFS 上&#10;&#10;→ 需要 ADFS 管理員先 Add-AdfsClient 註冊 client 與 redirect URI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e8dfc4;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;verticalAlign=top;fontSize=11.5;" vertex="1" parent="n78">
          <mxGeometry x="20" y="200" width="500" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 · Gateway vs Embedded" id="pg214">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n82" value="Gateway 與 Embedded 到底差在哪？" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=24;fontColor=#22252d;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n83" value="它們在 1.0.0.2 同時誕生，但不是兩套系統、也不是兩個版本。同一份連線器程式碼放在「兩個不同的住處」執行——契約一樣、安全規則一樣，只有跑在誰的行程裡不一樣。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12.5;fontColor=#6b7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n84" value="Embedded 模式 — ExecutionMode = &quot;Embedded&quot;（VS 除錯 / 刻意隔離的單機部署）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#f7fafe;strokeColor=#4a72a8;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="790" height="420" as="geometry" />
        </mxCell>
        <mxCell id="n85" value="作業系統行程 #1（w3wp.exe / dotnet ChurchReport）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf1fb;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#4a72a8;" vertex="1" parent="n84">
          <mxGeometry x="20" y="50" width="750" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n86" value="SpeechMessageProducts.ChurchReport" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n84">
          <mxGeometry x="60" y="100" width="670" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n87" value="SpeechMessage.Dynamics.Embedded（轉接器）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n84">
          <mxGeometry x="60" y="180" width="670" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n88" value="SpeechMessage.Dynamics.WebApi — 連線池 / token / 白名單都在這個行程" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n84">
          <mxGeometry x="60" y="260" width="670" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4a72a8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n86" target="n87">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4a72a8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n87" target="n88">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n91" value="Dynamics 365 CE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#8c8c8c;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="580" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e92" value="HTTPS / OData v4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b03a35;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n84" target="n91">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n93" value="特徵：從產品到 CRM 全程行程內呼叫，中間沒有任何一次網路跳躍。CRM 憑證與連線池就在產品自己的行程裡。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bfdbfe;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontSize=11.5;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="790" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n94" value="Gateway 模式 — ExecutionMode = &quot;Gateway&quot;（正式環境預設，5～10 產品共用）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#faf7fc;strokeColor=#7d5b96;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="130" width="790" height="420" as="geometry" />
        </mxCell>
        <mxCell id="n95" value="ChurchReport" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n94">
          <mxGeometry x="30" y="60" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n96" value="ProductClient（只組 HTTP 請求）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d4f0f0;strokeColor=#3d8b8b;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n94">
          <mxGeometry x="30" y="140" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n97" value="這個行程裡&#10;沒有 CRM 憑證、沒有連線池" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef7ec;strokeColor=#5d8a4e;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#3d6b4e;" vertex="1" parent="n94">
          <mxGeometry x="30" y="220" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n98" value="Gateway（ASP.NET Core）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7d5b96;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n94">
          <mxGeometry x="420" y="60" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n99" value="WebApi（同一份程式碼）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b03a35;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n94">
          <mxGeometry x="420" y="140" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n100" value="5～10 個產品共用&#10;一份憑證、一組連線池" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4eef8;strokeColor=#7d5b96;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#6a4a82;" vertex="1" parent="n94">
          <mxGeometry x="420" y="220" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5d8a4e;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n95" target="n96">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e102" value="HTTP  ← 行程邊界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#cc7a2e;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n96" target="n98">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#7d5b96;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n98" target="n99">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n104" value="Dynamics 365 CE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#8c8c8c;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="580" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e105" value="HTTPS / OData v4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#b03a35;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n94" target="n104">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n106" value="特徵：產品與 CRM 之間多一次 HTTP。換來的是憑證集中、連線池集中、總量控管集中，產品端變乾淨。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e3d3ee;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;fontSize=11.5;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="650" width="790" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n107" value="逐項對照（綠底 = 兩邊完全相同，這正是「同一套 runtime」的證據）" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#fbfcfd;strokeColor=#c8ced6;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="716" width="1620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n108" value="相同：連線器程式碼（同一個 WebApi 專案）｜呼叫契約（operation ID + 具名參數）｜能力白名單 Package01OperationRegistry｜加入同一個 organization admission 容量計畫&#10;&#10;不同：執行位置（獨立行程 vs 產品行程內）｜網路跳躍（多一次 HTTP vs 無）｜CRM 憑證位置（只在 Gateway vs 在產品行程）｜連線池歸屬（共用 vs 各自一份）｜典型用途（正式環境 vs VS 除錯與隔離部署）&#10;&#10;重要：模式在啟動時由部署 JSON 決定，之後定案。不能由使用者、LINE ID、session 或請求欄位在執行期切換。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;fontSize=12;" vertex="1" parent="n107">
          <mxGeometry x="20" y="44" width="1580" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5 · 1.0.0.3 子行程模型" id="pg215">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n109" value="1.0.0.3 · Gateway&amp;Embedded — 把舊 SDK 關進子行程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=24;fontColor=#22252d;align=left;fontStyle=1;" vertex="1" parent="1">
