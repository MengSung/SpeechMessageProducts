        <mxCell id="n110" value="承認 CE 8.2 的 IFD 現場只有 WS-Trust/SOAP 走得通。既然消滅不了舊 SDK，就把它隔離到另一個行程。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=12.5;fontColor=#6b7280;align=left;" vertex="1" parent="1">
