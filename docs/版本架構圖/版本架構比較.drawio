        <mxCell id="n119" value="DynamicsProfileRuntimeManager&#10;每個 profile 一個獨立 runtime 世代" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a72a8;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="n118">
