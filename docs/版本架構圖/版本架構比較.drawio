        <mxCell id="e154" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#94a3b8;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n151" target="n153">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n155" value="沒有白名單、沒有排隊、沒有 profile 隔離。任何一行程式碼都能自己組查詢直接送出去。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=11.5;fontColor=#5d8a4e;align=left;" vertex="1" parent="n143">
          <mxGeometry x="20" y="126" width="1560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n156" value="1.0.0.2 · Embedded　—　行程數 1" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;arcSize=4;fillColor=#ffffff;strokeColor=#4a72a8;strokeWidth=2;swimlaneFillColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
