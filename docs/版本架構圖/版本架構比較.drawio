        <mxCell id="n141" value="同一個動作，三個版本各走什麼路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=24;fontColor=#22252d;align=left;fontStyle=1;" vertex="1" parent="1">
