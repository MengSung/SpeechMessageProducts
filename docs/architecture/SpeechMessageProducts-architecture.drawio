<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17" type="device">
  <diagram id="page-landscape" name="1. 系統全景">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="SpeechMessageProducts　系統全景圖&lt;br&gt;快照：2026-08-05 · 分支 1.0.0.3.Gateway&amp;Embedded.Worktree · HEAD 7d984981「新增 Dedicated Gateway 模式與 Data8 專用初始化」&lt;br&gt;組成：1 個對外產品（ChurchReport）＋ 4 組共用能力模組（LINE 訊息／金流／Dynamics 連線治理／ToolUtility legacy CRM）＋ 5 類外部系統。&lt;br&gt;本分支的主線工程是「Dynamics 連線治理平台」：把過去「每個產品自己抓 CRM 連線、自己存密碼」的做法，換成「產品只送已註冊的 Operation，連線由治理核心借出並保證歸還」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="110" as="geometry"/></mxCell>
        <mxCell id="g_in" value="① 外部進入點" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="1060" height="110" as="geometry"/></mxCell>
