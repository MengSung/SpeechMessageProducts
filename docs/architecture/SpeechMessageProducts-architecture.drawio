        <mxCell id="m_tu" value="ToolUtility（net10.0 · 90 檔）&lt;br&gt;Contact／Activity／Fee／Lessons／Attachment&lt;br&gt;Appointment／Query／List／Owner／Collection&lt;br&gt;＋ CrmConnectionPool／CrmConnectionService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1405" y="550" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="m_data8" value="PowerPlatform.Dataverse.Client（Data8）&lt;br&gt;第三方 MIT WS-Trust／SOAP 實作&lt;br&gt;OnPremiseClient : IOrganizationService&lt;br&gt;含 NSspi 子專案 · 維護責任在本專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1405" y="668" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="g_plat" value="④　Dynamics 連線治理平台（本分支主線）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1720" height="290" as="geometry"/></mxCell>
        <mxCell id="d_abs" value="Abstractions&lt;br&gt;（零專案相依的契約層）&lt;br&gt;ConnectionMode／ConnectorKind／CeVersion&lt;br&gt;ProductDynamicsOptions／ResolvedProfile&lt;br&gt;IConnectorPool／Lease／Router&lt;br&gt;IDynamicsOperationExecutor／錯誤碼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="845" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="d_cp" value="ControlPlane&lt;br&gt;（治理核心 · 三模式共用）&lt;br&gt;Guard：保留字／alias／operation 守門&lt;br&gt;Capacity：Organization 准入、&lt;br&gt;　In-Memory 與 SQL 協調器&lt;br&gt;Runtime：Profile 世代管理、路由執行器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="845" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="d_conn" value="Connectors.Data8&lt;br&gt;（連線池實作）&lt;br&gt;Data8ConnectorPool／Registry／Router&lt;br&gt;池鍵＝(ProfileAlias, GenerationId)&lt;br&gt;Data8ProfileRuntime／Executor&lt;br&gt;OnPremiseData8ConnectorClientFactory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="845" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="d_gw" value="Gateway&lt;br&gt;（net10 · Exe · Minimal API 主機）&lt;br&gt;GET /health · GET /ready&lt;br&gt;GET /v1/operations&lt;br&gt;POST /v1/organizations/{alias}/operations/{id}&lt;br&gt;Negotiate／IIS 驗證 ＋ 請求大小／JSON 深度硬上限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="845" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="d_wk" value="Worker 群（官方 SDK 隔離）&lt;br&gt;WorkerProtocol（netstandard2.0）線路協定&lt;br&gt;WorkerHost（netstandard2.0）Named Pipe 主機&lt;br&gt;WorkerSupervisor（net10）進程監督與回收&lt;br&gt;Crm82Worker／Crm91Worker（net48 · Exe）&lt;br&gt;XrmTooling 8.2.0.5 ／ 9.1.1.65 鎖版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="845" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="n_plat" value="治理鏈（三種 ConnectionMode 完全共用，Embedded 不是繞過治理的後門）：&lt;br&gt;①守門 RequestGuard　→　②解析 ProfileResolver（Alias → Catalog → ResolvedProfile）　→　③准入 AdmissionController（有界佇列＋逾時）　→　④借出 ConnectorPool（依當下 Active Generation）　→　⑤執行（獨立 Request Context）　→　⑥歸還或淘汰＋finally 釋放 Permit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="1660" height="70" as="geometry"/></mxCell>
        <mxCell id="g_ext" value="⑤　外部系統" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1720" height="140" as="geometry"/></mxCell>
        <mxCell id="x_91" value="D365 CE 9.1&lt;br&gt;已登錄 5 個組織&lt;br&gt;（sunnyvalechback 為實機目標）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1155" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="x_82" value="D365 CE 8.2 IFD&lt;br&gt;已登錄 27 個組織&lt;br&gt;目前可行路徑仍是 WS-Trust／SOAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="1155" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="x_lineapi" value="LINE Messaging API&lt;br&gt;推播／回覆／RichMenu&lt;br&gt;多組織多 Channel Token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="1155" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="x_paysvc" value="金流服務&lt;br&gt;永豐 Sinopac／高鉅 MyPay／台新 Taishin&lt;br&gt;建立訂單 · 查詢 · 回呼驗簽" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="1155" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="x_sql" value="SQL Server（可選）&lt;br&gt;僅「多節點 Central Gateway」&lt;br&gt;才需要分散式容量協調器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="1155" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="n_foot" value="現況重點：ChurchReport 的 appsettings.json 目前是 ConnectionMode=DedicatedGateway、ProfileAlias=crm91、Endpoint=https://localhost:5101/，但 Package01FeeReadsEnabled=false —— 意思是新架構已經接好、可啟動、可健檢，實際業務讀寫仍走 ③-D 的 ToolUtility／Data8 legacy 路徑。旗標為 false 時產品不會建立任何 Gateway client、socket pool、timer 或背景工作。切換上線＝把這個旗標打開（計畫書 P7 分級遷移）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1285" width="1720" height="80" as="geometry"/></mxCell>
