        <mxCell id="dp_wh" value="Dynamics.WorkerHost&lt;br&gt;netstandard2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="720" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="dp_wp" value="Dynamics.WorkerProtocol&lt;br&gt;netstandard2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="720" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="g_w48" value="跨 Framework 邊界：net48 Worker 進程（官方 XrmTooling 鎖版隔離）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1260" height="130" as="geometry"/></mxCell>
        <mxCell id="dp_w82" value="Dynamics.Crm82Worker&lt;br&gt;net48 · Exe · XrmTooling 8.2.0.5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="885" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="dp_w91" value="Dynamics.Crm91Worker&lt;br&gt;net48 · Exe · XrmTooling 9.1.1.65" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="885" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="n_w48" value="netstandard2.0 是刻意選的：WorkerProtocol／WorkerHost 必須同時被 net10 監督者與 net48 Worker 參考。&lt;br&gt;舊 SDK 的 Assembly Binding 只活在 net48 進程內，不會污染產品進程。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="885" width="590" height="70" as="geometry"/></mxCell>
        <mxCell id="g_misc" value="未被參考／工具專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="1620" y="300" width="440" height="380" as="geometry"/></mxCell>
        <mxCell id="dp_trace" value="Trace（net10.0 · Lib）&lt;br&gt;BSUStackTrace／BSUTextWriterTraceListener&lt;br&gt;目前沒有專案 ProjectReference" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1645" y="335" width="390" height="70" as="geometry"/></mxCell>
        <mxCell id="dp_linepay" value="LinePayCSharp（netstandard1.3）&lt;br&gt;早期 LINE Pay 客戶端&lt;br&gt;目前沒有任何專案參考，僅留在方案中" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1645" y="420" width="390" height="70" as="geometry"/></mxCell>
        <mxCell id="dp_wth" value="Dynamics.WorkerTestHost（net10.0 · Exe）&lt;br&gt;Dynamics.SqlCoordinatorTestWorker（net10.0 · Exe）&lt;br&gt;跨進程驗證用的輔助主機" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1645" y="505" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="dp_diag" value=".ccg/diagnostics/LegacySoapProbe&lt;br&gt;LegacyOfficialProxyNet48&lt;br&gt;離線診斷探針，不屬於產品建置鏈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1645" y="600" width="390" height="65" as="geometry"/></mxCell>
        <mxCell id="g_tests" value="測試專案（9 個）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="1620" y="700" width="440" height="280" as="geometry"/></mxCell>
        <mxCell id="dp_tests" value="SpeechMessage.Dynamics.Tests（47 檔 · 主力）&lt;br&gt;　守門／世代／連線池／洩漏 soak／Worker 協定／&lt;br&gt;　Gateway 邊界／SQL 協調器／專案相依邊界&lt;br&gt;ChurchReport.MemberInfo.Tests&lt;br&gt;ToolUtility.Tests&lt;br&gt;Line.Messaging.Tests&lt;br&gt;LineMessagingProcessor(.AspNetCore/.RichMenus/.Workflows).Tests&lt;br&gt;SpeechMessage.Payments.Tests&lt;br&gt;Dynamics.Crm82Worker.Tests／Crm91Worker.Tests" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#808080;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1645" y="735" width="390" height="225" as="geometry"/></mxCell>
        <mxCell id="n_dep" value="讀圖提示：Gateway 同時參考 Abstractions、ControlPlane、Connectors.Data8、WorkerSupervisor —— 它是「組合根」，負責把治理鏈接起來。&lt;br&gt;Embedded 只參考 Abstractions ＋ ControlPlane，Connector 由 ChurchReport 的組合根注入，因此同一套治理程式碼可以跑在產品進程內。&lt;br&gt;ToolUtility 直接參考 Data8，這條線就是規格書要長期取代的 legacy 傳輸；在 Package01 旗標打開前它仍是唯一實際承載業務的路徑。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1500" height="90" as="geometry"/></mxCell>
        <mxCell id="de0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_cr" target="dp_lasp"><mxGeometry relative="1" as="geometry"/></mxCell>
