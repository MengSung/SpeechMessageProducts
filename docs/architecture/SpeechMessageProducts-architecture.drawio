        <mxCell id="de21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_lwf" target="dp_lproc"><mxGeometry relative="1" as="geometry"/></mxCell>
