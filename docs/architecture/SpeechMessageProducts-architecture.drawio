  <diagram id="page-deps" name="2. 專案相依關係（ProjectReference）">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="專案相依關係圖　—　箭頭方向＝「A 參考 B」，越下層越基礎&lt;br&gt;方案共 44 個 .csproj。此頁只畫產品／函式庫的 ProjectReference；測試與診斷專案獨立列於右側。&lt;br&gt;關鍵不變式：Abstractions 沒有任何專案相依（純契約）；ChurchReport 不得直接參考 Connector 實作專案（有 ProjectReferenceBoundaryTests 守著）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2020" height="90" as="geometry"/></mxCell>
        <mxCell id="dp_cr" value="SpeechMessageProducts.ChurchReport　（net10.0 · Exe）&lt;br&gt;參考 13 個專案：Line.Messaging · LineMessagingProcessor(.AspNetCore/.Workflows/.RichMenus) · ToolUtility ·&lt;br&gt;Dynamics.Abstractions/.ControlPlane/.Connectors.Data8/.Embedded/.ProductClient · Payments(.AspNetCore/.Workflows)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="150" width="1080" height="90" as="geometry"/></mxCell>
