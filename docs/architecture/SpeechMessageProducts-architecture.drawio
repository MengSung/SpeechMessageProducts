        <mxCell id="de23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_lproc" target="dp_lsdk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_paywf" target="dp_pay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_cp" target="dp_abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_cp" target="dp_sup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_sup" target="dp_abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_sup" target="dp_wh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_sup" target="dp_wp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_wh" target="dp_wp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_w82" target="dp_wh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_w91" target="dp_wh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de_gwsup" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_gw" target="dp_sup"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-modes" name="3. 三種 ConnectionMode">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t3" value="三種部署模式（ConnectionMode）　—　決定「共用核心跑在哪個進程」，不決定「要不要治理」&lt;br&gt;三種都是正式部署選項。Embedded 不是「開發專用」，DedicatedGateway 也能上正式環境。&lt;br&gt;治理層（Guard／Resolver／Admission／Router／Pool）三者完全共用同一份程式碼；Embedded 省掉的只有 HTTP 傳輸這一段。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="90" as="geometry"/></mxCell>
        <mxCell id="cfg" value="產品端只被允許設定這三個欄位（ProductDynamicsOptions）：&lt;br&gt;　ConnectionMode　共用核心跑在哪　｜　ProfileAlias　唯一的產品選擇鍵　｜　Gateway.Endpoint／ApiPrefix　僅兩種 Gateway 模式使用&lt;br&gt;禁止出現在產品設定或請求中：OrganizationId、ConnectorKind、CredentialReference、CRM endpoint、FetchXML、OData 查詢字串、任何 CRM schema 識別碼。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1720" height="80" as="geometry"/></mxCell>
        <mxCell id="mA_h" value="Embedded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="mA_m" value="共用核心位置：產品進程內&lt;br&gt;網路跳躍：無&lt;br&gt;適用：VS 2026 按 F5 開發、最低延遲、單一產品部署" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="mA_t" value="進程拓撲&lt;br&gt;ChurchReport 進程&lt;br&gt;├ ASP.NET Core 主機&lt;br&gt;├ EmbeddedHostAdapter&lt;br&gt;├ ControlPlane（Guard／Admission／Runtime 世代）&lt;br&gt;└ Data8ConnectorPool（進程內）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="mA_c" value="設定形狀：&lt;br&gt;ConnectionMode: &quot;Embedded&quot;&lt;br&gt;ProfileAlias: &quot;sunnyvalechback&quot;&lt;br&gt;（Gateway 區段必須不存在或被忽略）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="560" height="130" as="geometry"/></mxCell>
        <mxCell id="mB_h" value="DedicatedGateway　★ 目前 ChurchReport 設定值" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="mB_m" value="共用核心位置：獨立進程，與單一產品一起部署&lt;br&gt;網路跳躍：HTTPS（本機或同網段）&lt;br&gt;適用：需要故障隔離但不需跨產品共用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620" y="295" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="mB_t" value="進程拓撲&lt;br&gt;ChurchReport 進程　→　HTTPS　→　Gateway 進程&lt;br&gt;　　　　　　　　　　　　　　├ 只允許單一 profile alias&lt;br&gt;　　　　　　　　　　　　　　├ 強制載入 Data8 Connector 組態&lt;br&gt;　　　　　　　　　　　　　　└ DedicatedData8RuntimeHostedService&lt;br&gt;　　　　　　　　　　　　　　　（host 停止時確定釋放資源）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620" y="380" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="mB_c" value="設定形狀（產品端）：&lt;br&gt;ConnectionMode: &quot;DedicatedGateway&quot;&lt;br&gt;ProfileAlias: &quot;crm91&quot;&lt;br&gt;Gateway.Endpoint: &quot;https://localhost:5101/&quot;&lt;br&gt;&lt;br&gt;Gateway 端：&lt;br&gt;DynamicsGateway:DeploymentMode = &quot;DedicatedGateway&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620" y="535" width="560" height="130" as="geometry"/></mxCell>
        <mxCell id="mC_h" value="CentralGateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1200" y="250" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="mC_m" value="共用核心位置：獨立服務，多產品共用&lt;br&gt;網路跳躍：HTTPS（內部服務位址）&lt;br&gt;適用：多產品、集中治理與資源重用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="295" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="mC_t" value="進程拓撲&lt;br&gt;產品 A／B／C…　→　HTTPS　→　Central Gateway（可多節點）&lt;br&gt;　├ 多 Profile 世代並存&lt;br&gt;　├ 跨產品公平排程&lt;br&gt;　└ 多節點時才需要&lt;br&gt;　　 IDistributedCapacityCoordinator（SQL 實作已備妥）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="380" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="mC_c" value="設定形狀（產品端）：&lt;br&gt;ConnectionMode: &quot;CentralGateway&quot;&lt;br&gt;ProfileAlias: &quot;crm91&quot;&lt;br&gt;Gateway.Endpoint: &quot;https://dynamics-gateway.internal/&quot;&lt;br&gt;&lt;br&gt;計畫書 P8：只有一個產品時不執行本階段，&lt;br&gt;觸發條件是「第二個產品要接入」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="535" width="560" height="130" as="geometry"/></mxCell>
        <mxCell id="g_core" value="三種模式共用的治理鏈（同一份程式碼 · Embedded 一步都不能少）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1720" height="300" as="geometry"/></mxCell>
        <mxCell id="c1" value="① RequestGuard&lt;br&gt;（守門 · fail closed）&lt;br&gt;G1 保留字參數&lt;br&gt;G2 alias 格式&lt;br&gt;G3 operation 未註冊&lt;br&gt;G4 未驗證身分&lt;br&gt;G5 無權使用 alias&lt;br&gt;G6 本體超過上限&lt;br&gt;&lt;br&gt;必須在讀取本體、&lt;br&gt;解析 Profile、取得&lt;br&gt;Permit、建立任何&lt;br&gt;連線之前完成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="c2" value="② ProfileResolver&lt;br&gt;（兩段解析）&lt;br&gt;ProfileAlias&lt;br&gt;　↓ DynamicsProfiles&lt;br&gt;OrganizationAlias&lt;br&gt;　↓ OrganizationCatalog&lt;br&gt;ResolvedProfile&lt;br&gt;（含 GenerationId）&lt;br&gt;&lt;br&gt;R1 alias 不存在&lt;br&gt;R2 org 不存在&lt;br&gt;R3 org Disabled&lt;br&gt;R4 佔位 GUID&lt;br&gt;R5 版本不相容&lt;br&gt;R6 credential 無解" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="350" y="740" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="c3" value="③ AdmissionController&lt;br&gt;（容量准入）&lt;br&gt;以 OrganizationId 為鍵&lt;br&gt;的聚合總預算&lt;br&gt;&lt;br&gt;佇列必須有界&lt;br&gt;（LocalQueueCapacity）&lt;br&gt;等待必須有逾時&lt;br&gt;&lt;br&gt;IAdmissionPermit&lt;br&gt;實作 IDisposable，&lt;br&gt;Dispose 必定釋放容量" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630" y="740" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="c4" value="④ ConnectorRouter&lt;br&gt;＋ ConnectorPool&lt;br&gt;（借出）&lt;br&gt;&lt;br&gt;Router 只讀&lt;br&gt;ResolvedProfile&lt;br&gt;.ConnectorKind，&lt;br&gt;不做 fallback&lt;br&gt;&lt;br&gt;池鍵 =&lt;br&gt;(ProfileAlias,&lt;br&gt;　GenerationId)&lt;br&gt;&lt;br&gt;取得 Permit 之後&lt;br&gt;才解析 Active Generation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="910" y="740" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="c5" value="⑤ 執行&lt;br&gt;（獨立 Request Context）&lt;br&gt;&lt;br&gt;呼叫 D365&lt;br&gt;Organization Service&lt;br&gt;&lt;br&gt;使用者身分、Token、&lt;br&gt;Session 絕對不得放進&lt;br&gt;Pool 或連線物件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1190" y="740" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="c6" value="⑥ 歸還 / 淘汰&lt;br&gt;＋ finally&lt;br&gt;&lt;br&gt;健康 → 重設狀態後&lt;br&gt;歸還原世代的 Pool&lt;br&gt;故障／取消／逾時 →&lt;br&gt;標記失效並淘汰&lt;br&gt;&lt;br&gt;finally 無條件釋放&lt;br&gt;Permit 與 Cancellation&lt;br&gt;Registration；多個清理&lt;br&gt;失敗需彙總不遮蔽" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1470" y="740" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="ce0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n_gen" value="世代（Generation）與容量是兩個不同的切分維度 —— 這是整個治理設計最容易誤解的地方：&lt;br&gt;　· Organization Capacity：鍵是 OrganizationId，代表同一個「實體 Organization」的聚合總預算。不同 ProfileAlias 指向同一個 Org 時共用同一份預算。&lt;br&gt;　· 實體 Pool：鍵是 (ProfileAlias, GenerationId)，是實際的連線物件容器，按世代隔離，防止不同 Connector／憑證／設定混用。&lt;br&gt;同一 ProfileAlias 同時最多存在「1 個 Active ＋ 1 個 Draining」世代；舊世代停止接受新 Lease，保留既有 Lease 直到歸零才 Dispose 整個 Pool。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1720" height="110" as="geometry"/></mxCell>
        <mxCell id="n_conn" value="ConnectorKind × CeVersion 相容性矩陣（不相容組合在 Profile 載入時就拒絕，不是等到 Request 才發現）：&lt;br&gt;　Data8　　　　　　　　　CE 8.2 ✔　CE 9.1 ✔　—　同進程 WS-Trust，per-instance sdkVersion&lt;br&gt;　OfficialCrm82Worker　CE 8.2 ✔　CE 9.1 ✘　—　net48 進程，鎖 XrmTooling 8.2.0.5&lt;br&gt;　OfficialCrm91Worker　CE 8.2 ✘　CE 9.1 ✔　—　net48 進程，鎖 XrmTooling 9.1.1.65&lt;br&gt;ConnectionMode 與 ConnectorKind 是兩個獨立維度，任意組合皆合法（除非被上面的相容性規則否決）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1145" width="1720" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-lifecycle" name="4. 一次操作的完整生命週期">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t4" value="一次 Dynamics 操作的完整生命週期　—　每一次操作都必須完整走完六步，任何一步失敗都要 fail closed&lt;br&gt;左側是正常路徑，右側是對應的拒絕點與錯誤碼。錯誤回應一律不得包含 CRM hostname、Organization endpoint、GUID、CredentialReference、Token 或連線字串。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1640" height="80" as="geometry"/></mxCell>
        <mxCell id="s0" value="產品呼叫&lt;br&gt;OperationExecutionRequest {&lt;br&gt;　ProfileAlias, CapabilityOperationId,&lt;br&gt;　Parameters, IdempotencyKey? }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="520" height="80" as="geometry"/></mxCell>
        <mxCell id="s0_r" value="公開表面不含 OrganizationId／ConnectorKind／Credential／Endpoint／FetchXML —— 這是編譯期保證，不是執行期檢查（有反射測試守著）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="1030" height="80" as="geometry"/></mxCell>
        <mxCell id="s1" value="① 傳輸邊界&lt;br&gt;EmbeddedHostAdapter（同進程）&lt;br&gt;或 GatewayHttpsApi（HTTPS）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="520" height="80" as="geometry"/></mxCell>
        <mxCell id="s1_r" value="Gateway 模式：驗證呼叫者身分（Negotiate／IIS）、限制要求大小與 JSON 深度、逾時。&lt;br&gt;Embedded 模式：省略 HTTP，其餘一致。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="1030" height="80" as="geometry"/></mxCell>
        <mxCell id="le_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2" value="② RequestGuard 守門" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="s2_r" value="G1 request.reserved-parameter　400&lt;br&gt;G2 request.invalid-profile-alias　400&lt;br&gt;G3 operation.not-registered　403&lt;br&gt;G4 caller.unauthenticated　401&lt;br&gt;G5 caller.profile-forbidden　403&lt;br&gt;G6 request.too-large　413&lt;br&gt;必須在讀本體與建立任何資源之前完成。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="1030" height="110" as="geometry"/></mxCell>
        <mxCell id="le_s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3" value="③ ProfileResolver 解析&lt;br&gt;Alias → Catalog → ResolvedProfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="s3_r" value="R1 profile.not-found　404&lt;br&gt;R2 organization.not-found　404&lt;br&gt;R3 organization.disabled　409&lt;br&gt;R4 organization.identity-placeholder　500&lt;br&gt;R5 profile.connector-incompatible　500&lt;br&gt;R6 credential.unresolvable　500" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="500" width="1030" height="110" as="geometry"/></mxCell>
        <mxCell id="le_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4" value="④ AdmissionController 取得 Permit&lt;br&gt;有界等待 ＋ 逾時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="520" height="80" as="geometry"/></mxCell>
        <mxCell id="s4_r" value="admission.queue-full　429（含 Retry-After）&lt;br&gt;admission.timeout　429（含 Retry-After）&lt;br&gt;佇列不得無上限累積。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="1030" height="80" as="geometry"/></mxCell>
        <mxCell id="le_s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s5" value="⑤ 借出 Lease&lt;br&gt;先取得 Permit，之後才解析 Active Generation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="s5_r" value="pool.acquire-timeout　503&lt;br&gt;排隊期間不得持有任何連線物件、Runtime 或 Token Provider —— 否則舊世代永遠無法收斂。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="750" width="1030" height="110" as="geometry"/></mxCell>
        <mxCell id="le_s5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6" value="⑥ 執行&lt;br&gt;建立獨立 Request Context&lt;br&gt;呼叫 D365 Organization Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="s6_r" value="connector.transport-failure　502（可重試，有界）&lt;br&gt;operation.timeout　504（可重試，有界）&lt;br&gt;operation.cancelled　499（不可重試）&lt;br&gt;使用者身分／Token／Session 絕對不得放進 Pool 或連線物件。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="890" width="1030" height="110" as="geometry"/></mxCell>
        <mxCell id="le_s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s7" value="⑦ 判定與歸還&lt;br&gt;健康 → 歸還原世代 Pool&lt;br&gt;故障／取消／逾時 → MarkFaulted 後淘汰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="520" height="80" as="geometry"/></mxCell>
        <mxCell id="s7_r" value="故障資源永遠不得回到 Pool。Dispose 連線／終止 Worker。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="1030" width="1030" height="80" as="geometry"/></mxCell>
        <mxCell id="le_s7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s8" value="⑧ finally（無條件執行）&lt;br&gt;釋放 Permit、清除 Cancellation Registration、&lt;br&gt;清除 Request Context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="s8_r" value="即使 ⑤～⑦ 任一步拋例外都要釋放。多個清理失敗必須彙總（AggregateException）回報，不得互相遮蔽。&lt;br&gt;操作完成後不得留下 Process、Timer、Handle、Task 或 Cancellation Registration。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="1140" width="1030" height="110" as="geometry"/></mxCell>
        <mxCell id="le_s8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n_life" value="為什麼順序不能換：&lt;br&gt;　· 守門（②）必須在解析 Profile 與取得 Permit 之前 —— 否則惡意請求可以在被拒絕前就消耗容量與連線資源。&lt;br&gt;　· Permit（④）必須在解析 Active Generation（⑤）之前 —— 排隊中的請求若先綁定世代，設定變更時舊世代就永遠等不到 Lease 歸零，Drain 無法收斂。&lt;br&gt;　· finally（⑧）與判定（⑦）分離 —— 歸還／淘汰是業務判斷，資源釋放是無條件義務，兩者混在一起就會在例外路徑漏掉 Permit。&lt;br&gt;&lt;br&gt;對應測試（SpeechMessage.Dynamics.Tests）：Permit_acquired_before_generation_resolved、Admission_permit_released_on_exception、&lt;br&gt;Faulted_lease_never_returns_to_pool、Cleanup_failures_aggregate_without_masking、No_process_timer_handle_task_left_after_operation、&lt;br&gt;Soak_repeated_acquire_release_no_monotonic_growth、Two_organizations_same_process_do_not_share_state。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="1610" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-catalog" name="5. 模組職責清冊">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t5" value="模組職責清冊　—　每一個專案是什麼、用什麼 Framework、負責什麼&lt;br&gt;顏色沿用前幾頁：藍＝產品層　綠＝共用能力　橘＝Dynamics 平台　灰＝legacy／工具／測試" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="th1" value="專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334E68;strokeColor=#243B53;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="th2" value="型態 / TFM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334E68;strokeColor=#243B53;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="190" height="34" as="geometry"/></mxCell>
        <mxCell id="th3" value="職責與重點" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334E68;strokeColor=#243B53;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="1150" height="34" as="geometry"/></mxCell>
        <mxCell id="r0c1" value="SpeechMessageProducts.ChurchReport" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="164" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r0c2" value="net10.0 · Exe&lt;br&gt;ASP.NET Core MVC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="164" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r0c3" value="唯一對外產品。教會報表主站：會友資料、奉獻收費與稽核、小組、設備、排班、QR、LINE 綁定、金流付款。23 個 Controller、40＋ Service 群、36 檔 WebServiceConnector 整合層、Razor＋DevExtreme 前端。也是所有共用模組的組合根（Startup.cs）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="164" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r1c1" value="ToolUtility" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="226" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r1c2" value="net10.0 · Lib · 90 檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="226" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r1c3" value="Legacy CRM 操作外觀。20＋ 個操作群：Contact／Activity／Fee／Lessons／Attachment／Appointment／Query／List／Owner／Collection／MeetingStatistics／Entity／Attribute，另含 CrmConnectionPool、CrmConnectionService、CrmCacheService。目前實際承載 ChurchReport 的 Dynamics 業務流量。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="226" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r2c1" value="PowerPlatform.Dataverse.Client（Data8）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="288" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r2c2" value="net10.0 · Lib&lt;br&gt;＋ NSspi 子專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="288" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r2c3" value="第三方 MIT 授權的 WS-Trust／SOAP 相容實作，提供 OnPremiseClient : IOrganizationService。注意：與 Microsoft 官方 NuGet 的 Microsoft.PowerPlatform.Dataverse.Client 不是同一個東西。上游最後發布 2.4.2（2024-05-29），維護責任已落在本專案。規格書已決議永久保留為合法 Connector。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="288" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r3c1" value="Line.Messaging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r3c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r3c3" value="LINE Messaging API 的型別層：Messages／Flex（Component／Style／ParameterTypes）／Template／Imagemap／QuickReply／RichMenu／Webhooks／Liff／Exceptions／Json 轉換。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="350" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r4c1" value="LineMessagingProcessor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="412" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r4c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="412" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r4c3" value="單一 Facade（LineMessagingProcessorClass），把所有對外 LINE API 呼叫收斂到一個進入點。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="412" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r5c1" value="LineMessagingProcessor.Workflows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="474" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r5c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="474" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r5c3" value="回覆與推播工作流：ILineReplyWorkflow／ILineNotificationWorkflow，加上 Carousel／Imagemap／QuickReply／Template 動作工廠與訊息驗證，並定義收件人種類、結果狀態與例外型別。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="474" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r6c1" value="LineMessagingProcessor.RichMenus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="536" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r6c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="536" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r6c3" value="RichMenu 完整生命週期：Catalog 定義、Fingerprint 比對、建立上傳連結、別名 Id 快取、指派工作流、文字觸發解析與政策、到期清掃（Sweep）、Orchestrator 與 StateStore。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="536" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r7c1" value="LineMessagingProcessor.AspNetCore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="598" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r7c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="598" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r7c3" value="LINE 模組的 Options 與 DI 註冊進入點；ChurchReport 由此帶入多組織 Channel Access Token。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="598" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r8c1" value="SpeechMessage.Payments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r8c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="660" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r8c3" value="金流核心。抽象：IPaymentGateway／IPaymentProvider／IPaymentProfileResolver。三家 Provider 各自的請求映射、簽章與加解密、回呼解析、狀態對應：永豐 Sinopac（Crypto＋Signer）、高鉅 MyPay（SignatureVerifier）、台新 Taishin（HashVerifier）。含診斷遮罩（PaymentDiagnosticsSanitizer）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r9c1" value="SpeechMessage.Payments.Workflows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="722" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r9c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="722" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r9c3" value="訂單草稿模型（Order／LineItem／Payer／Schedule／MethodSelection）與付款後工作流（PostPaymentWorkflow）、結果映射。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="722" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r10c1" value="SpeechMessage.Payments.AspNetCore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="784" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r10c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="784" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r10c3" value="金流模組的 DI 註冊。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="784" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r11c1" value="SpeechMessage.Dynamics.Abstractions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="846" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r11c2" value="net10.0 · Lib&lt;br&gt;零專案相依" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="846" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r11c3" value="契約層，整個 Dynamics 平台的地基。Execution：ConnectionMode／ConnectorKind／CeVersion。Configuration：ProductDynamicsOptions、DynamicsProfileOptions、OrganizationCatalogEntry／State、PoolPolicy、OperationPolicy、IProfileResolver、ResolvedProfile。Connectors：IConnectorClient／Lease／Pool／Router。Operations：IDynamicsOperationExecutor、Request／Result、OperationDefinition／Ids、Package01OperationRegistry、DynamicsErrorCodes。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="846" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r12c1" value="SpeechMessage.Dynamics.ControlPlane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="908" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r12c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="908" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r12c3" value="治理核心，三種模式共用。Guard：IRequestGuard／RequestGuard／RequestOrigin。Capacity：OrganizationAdmissionManager／Registry／Plan／Options、DispatchEnvelope、IRuntimeHostSlotCoordinator 的 InMemory 與 SQL 兩種實作。Runtime：DynamicsProfileRuntimeManager（世代）、Factory、ProfileRoutedOperationExecutor、ControlledOperationExecutor、OperationDispatchPreparer。Configuration：ConfigurationProfileResolver。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="908" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r13c1" value="SpeechMessage.Dynamics.Connectors.Data8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="970" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r13c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="970" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r13c3" value="Data8 傳輸的 Connector 實作：Data8ConnectorPool（池鍵 =(ProfileAlias, GenerationId)）、Data8ConnectorPoolRegistry、Data8ConnectorRouter、Data8ProfileRuntime、Data8ProfileOperationExecutor、OnPremiseData8ConnectorClientFactory。這是 P3 階段從 ToolUtility.CrmConnectionPool 複製後改造出來的，原始 legacy 程式碼刻意保留不動。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="970" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r14c1" value="SpeechMessage.Dynamics.Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1032" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r14c2" value="net10.0 · Exe&lt;br&gt;Minimal API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1032" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r14c3" value="HTTPS 主機與組合根。端點：GET /health、GET /ready、GET /v1/operations、POST /v1/organizations/{alias}/operations/{capabilityOperationId}。Development 由 Kestrel 直接註冊 Negotiate handler；另支援 IIS 模式。請求本體大小與 JSON 深度由同一份已驗證設定同時套用到 Kestrel、IIS 與 MVC/Http JsonOptions，設定無效時 ValidateOnStart 會在接流量前中止。DeploymentMode=DedicatedGateway 時走專屬啟動流程：只允許單一 profile alias、強制載入 Data8 組態、註冊 DedicatedData8RuntimeHostedService 保證停機釋放。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1032" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r15c1" value="SpeechMessage.Dynamics.Embedded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1094" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r15c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1094" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r15c3" value="同進程 Adapter（EmbeddedHostAdapter ＋ DI 擴充）。省掉 HTTP 跳躍，但 Guard／Resolver／Admission／Pool 一步不少，因此 Embedded 不是繞過治理的後門。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1094" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r16c1" value="SpeechMessage.Dynamics.ProductClient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1156" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r16c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1156" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r16c3" value="產品端 HTTP 客戶端：GatewayDynamicsOperationExecutor、Package01FeeReadClient、FeeRecordDto／StorLessonRecordDto、GatewayProductClientLimits 與設定驗證器。產品只透過這一層看見 Gateway。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1156" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r17c1" value="SpeechMessage.Dynamics.WorkerProtocol" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1218" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r17c2" value="netstandard2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1218" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r17c3" value="net10 監督者與 net48 Worker 共用的線路協定：Frame／Envelope 編解碼與驗證、協定版本與限制、Ready／Request／Response／Drain 訊息、WorkerValue 型別系統、失敗分類。選 netstandard2.0 就是為了同時被兩個 Framework 參考。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1218" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r18c1" value="SpeechMessage.Dynamics.WorkerHost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1280" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r18c2" value="netstandard2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1280" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r18c3" value="Worker 端主機：NamedPipeOfficialWorkerConnector、OfficialWorkerProcessHost／Session、IOfficialCrmClient(Factory) 抽象、驗證與身分模式、Windows Credential Manager 存取（原生 API 封裝）、XmlWorkerProfileStore、結果大小上限例外。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1280" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r19c1" value="SpeechMessage.Dynamics.WorkerSupervisor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1342" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r19c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1342" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r19c3" value="net10 端的 Worker 監督者：OfficialWorkerProfileExecutor、進程環境與啟動例外、回收政策與回收原因、資源觀測、生命週期快照、Package01 回應投影、版本標示。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1342" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r20c1" value="SpeechMessage.Dynamics.Crm82Worker&lt;br&gt;SpeechMessage.Dynamics.Crm91Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1404" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r20c2" value="net48 · Exe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1404" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r20c3" value="隔離的官方 XrmTooling 進程，分別鎖 8.2.0.5 與 9.1.1.65。刻意不合併：兩者的 Microsoft.Xrm.Sdk 版本、Assembly Binding、IFD WS-Trust 與 OAuth 狀態都不同，要合併必須先有實機證據。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1404" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r21c1" value="Trace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1466" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r21c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1466" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r21c3" value="堆疊追蹤與 TraceListener 工具（BSUStackTrace、BSUTextWriterTraceListener）。目前沒有專案 ProjectReference。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1466" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r22c1" value="LinePayCSharp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1528" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r22c2" value="netstandard1.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1528" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r22c3" value="早期 LINE Pay 客戶端。目前沒有任何專案參考，僅保留在方案中。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1528" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r23c1" value="測試專案（9 個）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1590" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r23c2" value="net10.0 / net48" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1590" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r23c3" value="SpeechMessage.Dynamics.Tests 是主力（47 檔）：守門與契約邊界、Profile 解析、世代與容量、借還與洩漏 soak、Worker 協定與進程生命週期、Gateway 請求邊界與 Negotiate、SQL 協調器（含跨進程）、ProjectReferenceBoundaryTests。另有 ChurchReport.MemberInfo.Tests、ToolUtility.Tests、Line.Messaging.Tests、LineMessagingProcessor(.AspNetCore/.RichMenus/.Workflows).Tests、SpeechMessage.Payments.Tests、Crm82/91Worker.Tests。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1590" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="r24c1" value="測試輔助進程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1652" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="r24c2" value="net10.0 · Exe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1652" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="r24c3" value="SpeechMessage.Dynamics.WorkerTestHost（Worker 協定驗證）、SpeechMessage.Dynamics.SqlCoordinatorTestWorker（跨進程 SQL 容量協調器驗證）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1652" width="1150" height="58" as="geometry"/></mxCell>
        <mxCell id="n_cat" value="設定的三層分工（規格書 §4，這是理解整個平台最關鍵的一張表）：&lt;br&gt;　· DynamicsProfiles　　　ProfileAlias → OrganizationAlias、CeVersion、ConnectorKind、CredentialReference、Pool／容量／逾時／重試政策　【不得含憑證值或 Token】&lt;br&gt;　· OrganizationCatalog　OrganizationAlias → FriendlyName、UniqueName、OrganizationId、State、CeVersion、ServiceUri　【只保存身分事實，不含憑證與 ConnectorKind】&lt;br&gt;　· CredentialProvider　　CredentialReference → 實際憑證　【開發可讀 Configuration／User Secrets；正式必須接 Environment 或 Secret Store】&lt;br&gt;&lt;br&gt;目前 ChurchReport 的 CrmConnection:OrganizationCatalog 已登錄 5 個 CE 9.1 ＋ 27 個 CE 8.2 組織。只有 sunnyvalechback 有已核准的 HTTPS ServiceUri，其餘 alias 一旦被選取會在建立任何 client／permit／credential 之前 fail closed，不會誤連到別的組織。speechmessage 同時存在於兩個版本，因此拆成 speechmessage-ce82 與 speechmessage-ce91。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1734" width="1700" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-status" name="6. ChurchReport 現況與遷移路徑">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t6" value="ChurchReport 目前的兩條 Dynamics 路徑　—　新架構已就位，但業務流量還沒切過去&lt;br&gt;這是理解「Codex 做了十幾個小時之後，專案現在到底在哪」最重要的一頁。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="sw" value="唯一的切換開關：DynamicsAccess:Package01FeeReadsEnabled&lt;br&gt;目前值 = false。旗標為 false 時，產品完全不建立 Gateway client、socket pool、timer 或背景工作，也不會因為設定存在就送出任何 Dynamics operation。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="g_old" value="路徑 A　legacy（現行 · 承載 100% 業務流量）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="820" height="480" as="geometry"/></mxCell>
        <mxCell id="o1" value="ChurchReport Controllers / Services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="760" height="44" as="geometry"/></mxCell>
        <mxCell id="o2" value="WebServiceConnector（36 檔）&lt;br&gt;DownloadIntegrateData.* ／ UploadIntegrateData.*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="760" height="60" as="geometry"/></mxCell>
        <mxCell id="o3" value="ToolUtility Facade（20＋ 操作群）&lt;br&gt;＋ CrmConnectionService／CrmConnectionPool／CrmCacheService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="760" height="60" as="geometry"/></mxCell>
        <mxCell id="o4" value="Data8 OnPremiseClient（WS-Trust ／ SOAP）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="760" height="44" as="geometry"/></mxCell>
        <mxCell id="o5" value="D365 CE 8.2 IFD ／ CE 9.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="544" width="760" height="44" as="geometry"/></mxCell>
        <mxCell id="o_note" value="已知缺口（規格書 §11.2，列為必修）：OnPremiseClient 沒有實作 IDisposable，&lt;br&gt;既有池裡的 (connection?.Service as IDisposable)?.Dispose() 是 no-op，WCF channel 與 ChannelFactory 從未 Close()／Abort()。&lt;br&gt;另 §11.1：_sdkMajorVersion 是 static，8.2 與 9.1 在同一進程共存時會送出相同 sdkversion。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="608" width="760" height="70" as="geometry"/></mxCell>
        <mxCell id="g_new" value="路徑 B　新治理架構（已建置 · 等待旗標開啟）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="900" y="215" width="850" height="480" as="geometry"/></mxCell>
        <mxCell id="w1" value="ChurchReport Services&lt;br&gt;DonationDynamicsAccessBootstrap ／ ProcessHost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="255" width="790" height="50" as="geometry"/></mxCell>
        <mxCell id="w2" value="SpeechMessage.Dynamics.ProductClient&lt;br&gt;GatewayDynamicsOperationExecutor ／ Package01FeeReadClient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="320" width="790" height="55" as="geometry"/></mxCell>
        <mxCell id="w3" value="HTTPS　POST /v1/organizations/{alias}/operations/{id}&lt;br&gt;Endpoint = https://localhost:5101/　·　ProfileAlias = crm91" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="390" width="790" height="55" as="geometry"/></mxCell>
        <mxCell id="w4" value="SpeechMessage.Dynamics.Gateway（DeploymentMode = DedicatedGateway）&lt;br&gt;Guard → Resolver → Admission → Router → Data8ConnectorPool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="460" width="790" height="55" as="geometry"/></mxCell>
        <mxCell id="w5" value="D365 CE 9.1（sunnyvalechback）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="530" width="790" height="44" as="geometry"/></mxCell>
        <mxCell id="w_note" value="同一份治理核心也可以用 Embedded 模式跑在 ChurchReport 進程內（EmbeddedData8Runtime ／ CrmConnectionEmbeddedProfileMapper），&lt;br&gt;VS 2026 按 F5 即可，不需要第二個進程。切換只需要改一個 ConnectionMode 字串。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="594" width="790" height="70" as="geometry"/></mxCell>
        <mxCell id="oe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="o4" target="o5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w3" target="w4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="we4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w4" target="w5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g_phase" value="計畫書階段進度（docs/dynamics-connection-management-plan.md）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1720" height="250" as="geometry"/></mxCell>
        <mxCell id="ph0" value="P1 契約層對齊　【已完成】&lt;br&gt;&lt;br&gt;ConnectionMode 三值、ConnectorKind／CeVersion、ProductDynamicsOptions 精簡為三欄位、OrganizationCatalog、IProfileResolver、IRequestGuard 補齊 G1 保留字檢查。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph1" value="P2 Data8 連接器修正　【已完成】&lt;br&gt;&lt;br&gt;OnPremiseClient 實作 IDisposable（OnPremiseClientDisposalTests 佐證）；sdkVersion 依 A1 結果處理。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="268" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph2" value="P3 連線池抽出與世代化　【已完成】&lt;br&gt;&lt;br&gt;新專案 Connectors.Data8；池鍵改為 (ProfileAlias, GenerationId)；IConnectorLease 含 MarkFaulted；接上既有世代管理。ToolUtility legacy 原始碼保留不動。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="476" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph3" value="P4 Embedded 模式　【已完成】&lt;br&gt;&lt;br&gt;重寫 AddSpeechMessageDynamicsEmbedded 與 EmbeddedHostAdapter；ChurchReport 端設定映射器；F5 可跑受控離線組合根。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="684" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph4" value="P5 Dedicated Gateway 對齊　【進行中】&lt;br&gt;&lt;br&gt;HEAD 7d984981 已導入 DeploymentMode 分流、DedicatedGatewayOptions／Data8Configuration、專屬 /ready 與 HostedService。工作區還有未提交的 P5 對齊分析輸出。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="892" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph5" value="P6 Official Worker 接進 Router　【待辦】&lt;br&gt;&lt;br&gt;把 WorkerSupervisor 以下的資產接成 ConnectorKind 的第二種實作，並在 Profile 載入時強制相容性矩陣。外部 CE 真機量測集中在此階段之後。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1100" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph6" value="P7 消費者遷移　【待辦】&lt;br&gt;&lt;br&gt;依 Tier A～D 分級逐步打開 Package01FeeReadsEnabled，每一級與 legacy 路徑做筆數與金額對帳，任一級失敗即關旗標回退。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1308" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="ph7" value="P8 Central Gateway　【可選】&lt;br&gt;&lt;br&gt;只有一個產品時不執行。觸發條件是「第二個產品要接入」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1516" y="760" width="195" height="180" as="geometry"/></mxCell>
        <mxCell id="n_risk" value="刻意保留、不要誤刪的東西：&lt;br&gt;　· Data8（PowerPlatform.Dataverse.Client）—— 規格書 §0.2 明列為永久保留的合法 Connector，不是過渡品。刪除條件見設計說明書第 13 章的 10 項 Gate。&lt;br&gt;　· 63 檔 Worker 資產（WorkerProtocol／WorkerHost／WorkerSupervisor／兩個 net48 Worker）—— 保留為 ConnectorKind 的擴充點，用來吸收未來的傳輸變化，不再改架構。&lt;br&gt;　· ToolUtility 的 CrmConnectionPool 原始碼 —— 新池是複製後改造，不是就地重構，這樣 legacy 路徑在遷移期間不受影響。&lt;br&gt;　· SQL 協調器 —— 規則 6.9：SQL 不是本架構的必要條件，只是 IDistributedCapacityCoordinator 的一種可替換實作，Embedded 與 Dedicated 模式下不得要求任何資料庫。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="1720" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
