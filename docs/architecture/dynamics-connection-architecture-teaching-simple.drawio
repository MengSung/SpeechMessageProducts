        <mxCell id="e-dedicated-manager" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#C58B00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dedicated" target="manager"><mxGeometry relative="1" as="geometry" /></mxCell>
