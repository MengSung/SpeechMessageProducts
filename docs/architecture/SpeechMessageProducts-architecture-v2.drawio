        <mxCell id="m_lasp" value="LineMessagingProcessor.AspNetCore　—　Options 與 DI 註冊進入點" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="730" width="515" height="34" as="geometry"/></mxCell>
        <mxCell id="g_pay" value="③-B　金流能力（不受影響）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="620" y="515" width="380" height="265" as="geometry"/></mxCell>
        <mxCell id="m_pay" value="SpeechMessage.Payments&lt;br&gt;IPaymentGateway／IPaymentProvider&lt;br&gt;三家 Provider：永豐 Sinopac、&lt;br&gt;高鉅 MyPay、台新 Taishin&lt;br&gt;請求映射／簽章加解密／回呼解析／&lt;br&gt;狀態對應／診斷遮罩" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="645" y="550" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="m_paywf" value="….Workflows&lt;br&gt;訂單草稿（Order／LineItem／Payer／&lt;br&gt;Schedule）與付款後工作流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="645" y="690" width="330" height="60" as="geometry"/></mxCell>
