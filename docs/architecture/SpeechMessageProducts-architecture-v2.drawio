  <diagram id="p2" name="2. 專案相依關係">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="專案相依關係圖　—　箭頭方向＝「A 參考 B」，越下層越基礎。方案共 44 個 .csproj。&lt;br&gt;關鍵不變式：Abstractions 沒有任何專案相依（純契約）。P7.5 完成後，ChurchReport 對 ToolUtility 與 Connectors.Data8 的參考都要移除。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2020" height="70" as="geometry"/></mxCell>
        <mxCell id="dp_cr" value="SpeechMessageProducts.ChurchReport　（net10.0 · Exe）&lt;br&gt;目前參考 13 個專案。★ P7.5 removal gate 要刪掉的是：ToolUtility、Connectors.Data8，以及任何 CRM SDK 型別使用。&lt;br&gt;遷移後合法的 Dynamics 相依只剩：Dynamics.Abstractions（契約列舉）＋ Dynamics.ProductClient（強型別客戶端）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="1080" height="90" as="geometry"/></mxCell>
