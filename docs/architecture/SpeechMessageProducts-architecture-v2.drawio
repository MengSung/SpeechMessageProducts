        <mxCell id="cr_wsc" value="WebServiceConnector（36 檔）&lt;br&gt;DownloadIntegrateData.*／UploadIntegrateData.*&lt;br&gt;Fee／Appointment／Equipment／LineBinding&lt;br&gt;★ P7.4 要逐 capability 改依賴 ProductClient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="374" width="400" height="100" as="geometry"/></mxCell>
