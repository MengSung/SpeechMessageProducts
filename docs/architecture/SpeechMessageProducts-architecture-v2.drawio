        <mxCell id="cr" value="SpeechMessageProducts.ChurchReport　（net10.0 · Exe · ASP.NET Core MVC）　—　目前唯一的對外產品" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="1660" height="34" as="geometry"/></mxCell>
