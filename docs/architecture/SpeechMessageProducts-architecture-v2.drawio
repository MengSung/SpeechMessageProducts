        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_tu" target="m_data8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="HTTPS /v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_pc" target="d_gw"><mxGeometry relative="1" as="geometry"/></mxCell>
