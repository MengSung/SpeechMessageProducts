        <mxCell id="de24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_lproc" target="dp_lsdk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_paywf" target="dp_pay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_cp" target="dp_abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_cp" target="dp_sup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_sup" target="dp_abs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_sup" target="dp_wh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_sup" target="dp_wp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_wh" target="dp_wp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_w82" target="dp_wh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#9AA5B1;" edge="1" parent="1" source="dp_w91" target="dp_wh"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="3. 兩種存取模型（關鍵概念）">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="★ 最關鍵的一頁：ToolUtility 與 Gateway 不是兩條可互換的水管&lt;br&gt;常見誤解：「ToolUtility 可以選擇走 Data8 或走 Gateway」。實際上兩者是完全不同的存取模型，型別層面就接不起來。&lt;br&gt;一句話：ToolUtility 是「把工具借給你、你自己動手」；Gateway 是「你不碰工具，告訴我要什麼，我做好給你」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1720" height="90" as="geometry"/></mxCell>
        <mxCell id="gA" value="模型 A：借連接器（ToolUtility 現況）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="850" height="460" as="geometry"/></mxCell>
        <mxCell id="a_code" value="// ToolUtility/ContactOperations/ContactService.cs:143&lt;br&gt;public Entity RetrieveByLineId(string lineId)&lt;br&gt;{&lt;br&gt;    var query = new QueryByAttribute(&quot;contact&quot;)&lt;br&gt;        { ColumnSet = new ColumnSet(true), TopCount = 1 };&lt;br&gt;    query.Attributes.AddRange(&quot;new_lineid&quot;, &quot;statecode&quot;);&lt;br&gt;    query.Values.AddRange(lineId, 0);&lt;br&gt;    var result = _organizationService.RetrieveMultiple(query);&lt;br&gt;    return result.Entities.Count &gt; 0 ? result.Entities[0] : null;&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="55" y="185" width="800" height="170" as="geometry"/></mxCell>
        <mxCell id="a_desc" value="產品拿到什麼：IOrganizationService —— 一個可任意操作的物件&lt;br&gt;誰組查詢：產品自己（QueryByAttribute／FetchXML）&lt;br&gt;看得到 CRM schema 嗎：看得到（contact、new_lineid、statecode）&lt;br&gt;能做的事：任何 CRM 操作，包含未預期的&lt;br&gt;回傳型別：SDK 的 Entity（全欄位）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="55" y="370" width="800" height="105" as="geometry"/></mxCell>
        <mxCell id="a_pro" value="優點：靈活、開發快、團隊熟悉、既有程式碼可直接沿用&lt;br&gt;代價：每個產品都要自己保管 CRM 密碼、SDK 相依、連線池與 retry；無法證明沒有跨產品洩漏" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="490" width="800" height="90" as="geometry"/></mxCell>
        <mxCell id="gB" value="模型 B：送請求、要資料（Gateway）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="910" y="145" width="840" height="460" as="geometry"/></mxCell>
        <mxCell id="b_code" value="// ProductClient/FeeReads/Package01FeeReadClient.cs:49&lt;br&gt;var parameters = new Dictionary&lt;string, object?&gt;&lt;br&gt;{&lt;br&gt;    [&quot;contactId&quot;] = contactId,&lt;br&gt;    [&quot;startDate&quot;] = startDate,&lt;br&gt;    [&quot;endDate&quot;]   = endDate&lt;br&gt;};&lt;br&gt;return ExecuteAndMapFeesAsync(&lt;br&gt;    profileAlias, workloadSubjectId,&lt;br&gt;    OperationIds.FeeDedicationRetrieveByContactDateRange,&lt;br&gt;    parameters, cancellationToken);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="935" y="185" width="790" height="170" as="geometry"/></mxCell>
        <mxCell id="b_desc" value="產品拿到什麼：FeeRecordDto[] —— 已投影的資料，沒有連接器&lt;br&gt;誰組查詢：伺服器端已註冊的 template&lt;br&gt;看得到 CRM schema 嗎：看不到&lt;br&gt;能做的事：只有已註冊的 operation，其餘 403&lt;br&gt;回傳型別：具名 DTO（欄位固定）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="935" y="370" width="790" height="105" as="geometry"/></mxCell>
        <mxCell id="b_pro" value="優點：產品端零 CRM 知識、密碼只有一份、可稽核、可統一換傳輸&lt;br&gt;代價：每個能力都要手工開一個「窗口」，開之前產品什麼都做不了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="935" y="490" width="790" height="90" as="geometry"/></mxCell>
        <mxCell id="phys" value="★ 為什麼 ToolUtility 不可能「改走 Gateway」—— 這是物理限制，不是設計偏好&lt;br&gt;&lt;br&gt;IOrganizationService 背後是一個活的 WCF channel：有 socket、有驗證狀態、有 session。這種東西無法序列化過 HTTP 傳給另一個進程。&lt;br&gt;&lt;br&gt;　· Embedded（治理核心在 ChurchReport 進程內）　→　✔ 可以借連接器。物件就在同一個記憶體裡，Data8ConnectorPool 借你 lease。&lt;br&gt;　· Dedicated／Central Gateway（另一個進程）　　→　✘ 不可能。連線物件過不去，跨進程只能傳「請求」和「資料」。&lt;br&gt;&lt;br&gt;而且 Abstractions/Connectors/IConnectorLease.cs 實際上根本沒有 IOrganizationService Service 屬性（規格書 §7.1 寫有，程式碼沒有 —— 兩者已分岔）。&lt;br&gt;實際契約是 ExecuteAsync(ConnectorOperation, CancellationToken)，參數與回應都是扁平的 IReadOnlyDictionary&lt;string, string?&gt;。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="1720" height="190" as="geometry"/></mxCell>
        <mxCell id="closed" value="★ 回應契約是「封閉聯集」，這正是 Gateway 的安全價值所在&lt;br&gt;&lt;br&gt;Abstractions/Operations/OperationResponseData.cs 目前只允許 4 種回應：&lt;br&gt;　　public enum OperationResponseKind { Unsupported = 0, WhoAmI = 1, Package01FeeRecords = 2, Package01StorLessonRecords = 3 }&lt;br&gt;而且建構子有 ValidateSingleSafeBranch，強制「同時只能有一個分支非 null」。&lt;br&gt;&lt;br&gt;這代表你不能回傳「一個 Entity」——  每一種新的回應形狀都要新增 enum 值、新的具名 record、新的分支與驗證。&lt;br&gt;為什麼要這麼麻煩？因為如果允許回傳任意 Entity JSON，產品就又能看到整張 CRM 表 —— 那 Gateway 就退化成一根多繞一次網路的水管，安全性反而更差。&lt;br&gt;封閉聯集不是設計缺陷，它就是「櫃檯只開特定窗口」的實現方式。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="845" width="1720" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4. 一個 Capability 要做什麼">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="把一個 ToolUtility 方法變成 Gateway capability，實際要動什麼&lt;br&gt;以 ContactService.RetrieveByLineId（7 行）為例。重點：Gateway 不會自動產生任何 operation，registry 是手工維護的白名單。&lt;br&gt;★ 遷移單位是「業務 use case」，不是「ToolUtility 方法」—— 一個 capability 可在 Gateway 內組合多次 Retrieve／Update，避免產品端細碎 HTTP 往返。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1720" height="90" as="geometry"/></mxCell>
        <mxCell id="s0" value="① 宣告 Operation ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s0w" value="Abstractions/Operations/OperationIds.cs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="60" y="188" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s0b" value="public const string ContactRetrieveByLineId&lt;br&gt;    = &quot;contact.retrieve.by.lineid&quot;;&lt;br&gt;&lt;br&gt;必須符合 ^[a-z0-9]+(\.[a-z0-9]+)+$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s1" value="② 註冊定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="485" y="150" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s1w" value="Abstractions/Operations/Package01OperationRegistry.cs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="485" y="188" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s1b" value="13 個必填欄位：kind／templateKind／templateId／&lt;br&gt;templateHash／responseKind／4 個上限／&lt;br&gt;dataClassification／auditRequirement／&lt;br&gt;idempotencyClass／parameters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="485" y="232" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s2" value="③ 新增回應型別　★ 真正的成本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s2w" value="Abstractions/Operations/OperationResponseData.cs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="910" y="188" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s2b" value="新增 enum 值 ＋ 具名 record ＋ 新分支&lt;br&gt;＋ 更新 ValidateSingleSafeBranch&lt;br&gt;＋ JSON 序列化屬性&lt;br&gt;&lt;br&gt;★ 你必須決定要哪幾個欄位&lt;br&gt;（ColumnSet(true) 那種「全撈」不再合法）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="232" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s3" value="④ 寫真正的 FetchXML template" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1335" y="150" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s3w" value="★ 目前沒有存放機制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1335" y="188" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s3b" value="templateId 現在只是一個字串，&lt;br&gt;對應的 FetchXML 不存在於任何檔案。&lt;br&gt;templateHash 目前 hash 的是 metadata，&lt;br&gt;不是 template 內容。&lt;br&gt;&lt;br&gt;第一次做必須先建立 template store。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1335" y="232" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s4" value="⑤ 讓 Connector 能執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s4w" value="Connectors.Data8/OnPremiseData8ConnectorClientFactory.cs:191" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="60" y="438" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s4b" value="目前寫死只接受 whoami，其餘拒絕。&lt;br&gt;要改成可分派多 operation 的結構，&lt;br&gt;並實作：套用 template → 執行 →&lt;br&gt;把 Entity 投影成扁平 scalar map。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="482" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s5" value="⑥ 改 Executor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="485" y="400" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s5w" value="Connectors.Data8/Data8ProfileOperationExecutor.cs:163" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="485" y="438" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s5b" value="IsSupportedWhoAmIRequest 同樣寫死，&lt;br&gt;要一併改成 registry 驅動的分派。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="485" y="482" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s6" value="⑦ ProductClient 方法 ＋ DTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="910" y="400" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s6w" value="ProductClient/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="910" y="438" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s6b" value="public Task&lt;ContactDto?&gt;&lt;br&gt;    RetrieveContactByLineIdAsync(...)&lt;br&gt;&lt;br&gt;＋ 去敏的錯誤映射&lt;br&gt;＋ 取消／逾時契約" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="482" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="s7" value="⑧ Gateway 授權白名單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1335" y="400" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s7w" value="Gateway/appsettings.json → WorkloadBindingSets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#BCCCDC;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1335" y="438" width="400" height="40" as="geometry"/></mxCell>
        <mxCell id="s7b" value="沒加進 allowlist 的話，&lt;br&gt;ConfigurationGatewayOperationAuthorizer&lt;br&gt;會直接 403。&lt;br&gt;&lt;br&gt;★ 產品猜中 ID 也不能越權呼叫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;verticalAlign=top;spacingTop=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1335" y="482" width="400" height="145" as="geometry"/></mxCell>
        <mxCell id="states" value="★ 四個獨立狀態，任何一個都不能推論出另一個（P7.0 inventory 的核心規則）&lt;br&gt;&lt;br&gt;　① Registry declared　　　契約存在且可被授權　　　　　　　　目前：9&lt;br&gt;　② Executor implemented　真的有程式碼會去查 CRM　　　　　　目前：Data8 = 1（whoami）、Official Worker = 1（fee.dedication.retrieve.by.contact.date.range）&lt;br&gt;　③ Consumer enabled　　　產品端真的在用　　　　　　　　　　目前：0&lt;br&gt;　④ CE real evidence　　　真實 Organization 驗證過　　　　　　目前：CE 8.2 = 0、CE 9.1 = 0&lt;br&gt;&lt;br&gt;「Registry 登錄」只代表契約存在，不代表可上線。離線測試全綠也不能冒充真機證據。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="1690" height="190" as="geometry"/></mxCell>
        <mxCell id="cost" value="成本估算與現實檢查&lt;br&gt;&lt;br&gt;· 熟悉之後，每個 capability 約 0.5～1 天（含契約、executor、DTO、測試與對帳）。&lt;br&gt;· 但 70 個 call site 不等於 70 個 operation —— P7.0 已把它們歸成 12 個 capability family，實際 operation 數會少於 70、多於 12。&lt;br&gt;· 部分 ToolUtility 方法根本無法直接搬移：那些「借連接器出去讓呼叫端自己組查詢」的方法（例如 RetrieveByContactId(IOrganizationService externalService, ...)），&lt;br&gt;  本質上是在傳遞水管，封閉契約無法承載，必須重新設計成具體的業務操作。&lt;br&gt;· 計畫書已把舊的「P7 只需 3～5 天」估算作廢，改為「由 P7.0 capability matrix 依獨立 rollback owner 與真機 evidence 數量估算」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1690" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="5. P7 全量遷移路線圖與現況">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="P7　ChurchReport 完全 Gateway 化　—　路線圖與目前真實進度&lt;br&gt;決策日期 2026-08-05：最終 ChurchReport 不再直接透過 ToolUtility／IOrganizationService 存取 D365。&lt;br&gt;ToolUtility 在遷移期間作為對帳與回滾來源，但不是永久雙軌架構。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="90" as="geometry"/></mxCell>
        <mxCell id="score" value="★ 目前 coverage 記分板（來自 P7.0 preliminary-capability-inventory.json，與程式碼核對過）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1720" height="30" as="geometry"/></mxCell>
        <mxCell id="sc0" value="Phase 0 call sites&lt;br&gt;&lt;br&gt;　70&lt;br&gt;&lt;br&gt;35 讀 / 23 寫 / 4 action / 2 function / 1 metadata / 5 連線基礎設施" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc1" value="Capability families&lt;br&gt;&lt;br&gt;　12&lt;br&gt;&lt;br&gt;P7.0 已完成初步歸group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="472" y="185" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc2" value="Registry declared&lt;br&gt;&lt;br&gt;　9&lt;br&gt;&lt;br&gt;只代表契約存在" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="904" y="185" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc3" value="Data8 executor&lt;br&gt;&lt;br&gt;　1&lt;br&gt;&lt;br&gt;只有 whoami" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1336" y="185" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc4" value="Official Worker executor&lt;br&gt;&lt;br&gt;　1&lt;br&gt;&lt;br&gt;只有 fee.dedication.retrieve.by.contact.date.range&lt;br&gt;（inventory 記 3，與程式碼不符，待確認）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc5" value="Consumer enabled&lt;br&gt;&lt;br&gt;　0&lt;br&gt;&lt;br&gt;產品端還沒有任何 capability 上線" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="472" y="295" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc6" value="CE 8.2 / 9.1 真機證據&lt;br&gt;&lt;br&gt;　0 / 0&lt;br&gt;&lt;br&gt;尚未執行真機整合量測" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="904" y="295" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="sc7" value="Temporary legacy rows&lt;br&gt;&lt;br&gt;　16&lt;br&gt;&lt;br&gt;P7.5 前必須歸零" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1336" y="295" width="415" height="95" as="geometry"/></mxCell>
        <mxCell id="fam" value="70 個 call site → 12 個 capability family（P7.0 初步歸group）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1720" height="30" as="geometry"/></mxCell>
        <mxCell id="fm0" value="platform.shared.runtime　（6 rows）&lt;br&gt;P5/P6 平台閘門；沒有 ChurchReport consumer cutover" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm1" value="platform.legacy.blocked　（5 rows）&lt;br&gt;P7.5 removal gate；不得建立任何遠端 capability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="472" y="470" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm2" value="churchreport.list.membership　（23 rows）&lt;br&gt;★ 最大宗。P7.1 讀、P7.2 寫、P7.3 分頁／大型圖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="904" y="470" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm3" value="churchreport.fee.lessons　（10 rows）&lt;br&gt;P7.1 typed reads；fee 寫入留在 P7.2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1336" y="470" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm4" value="churchreport.donation.lifecycle　（9 rows）&lt;br&gt;P7.1 讀 ＋ P7.2 財務寫入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm5" value="churchreport.member.profile　（8 rows）&lt;br&gt;P7.1 讀 ＋ P7.2 profile／圖片寫入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="472" y="560" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm6" value="churchreport.attendance　（3 rows）&lt;br&gt;P7.1 讀 ＋ P7.2 create/upsert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="904" y="560" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm7" value="churchreport.authentication　（2 rows）&lt;br&gt;P7.1 身分查詢 ＋ workload authorization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1336" y="560" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm8" value="churchreport.contact.onboarding　（1 rows）&lt;br&gt;P7.2 typed orchestration；絕不做 generic CRUD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm9" value="churchreport.appointments　（1 rows）&lt;br&gt;P7.2 appointment create／update／assign 契約" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="472" y="650" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm10" value="churchreport.metadata　（1 rows）&lt;br&gt;P7.3 有界 metadata 與 cache 生命週期" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="904" y="650" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="fm11" value="churchreport.weekly.reporting　（1 rows）&lt;br&gt;P7.3 有界聚合／分頁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1336" y="650" width="415" height="78" as="geometry"/></mxCell>
        <mxCell id="phases" value="P7 六個批次（每批可獨立驗證與回滾）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1720" height="30" as="geometry"/></mxCell>
        <mxCell id="ph0" value="P7.0&lt;br&gt;Capability inventory&lt;br&gt;&lt;br&gt;70 rows → 業務 use case → Operation ID → ProductClient owner →&lt;br&gt;consumer → ConnectorKind／CeVersion support → rollout 狀態。&lt;br&gt;建立 deterministic coverage validator。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="ph1" value="P7.1&lt;br&gt;Read capabilities&lt;br&gt;&lt;br&gt;先完成既有 Package 1 fee／stor 六個 operations 的 executor、&lt;br&gt;typed projection、ProductClient 與 Tier A～D rollout；&lt;br&gt;再依矩陣拆 MemberInfo／Contact／List／Activity／metadata。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="618" y="800" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="ph2" value="P7.2&lt;br&gt;Write／Action／Function&lt;br&gt;&lt;br&gt;依 transaction／idempotency／authorization 邊界拆分。&lt;br&gt;每次只允許一條 authoritative writer，禁止未設計的 dual-write。&lt;br&gt;明確定義重複送達、樂觀併發、部分完成、timeout-after-commit。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1196" y="800" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="ph3" value="P7.3&lt;br&gt;特殊資源能力&lt;br&gt;&lt;br&gt;Attachment、large paging、background／scheduler、metadata cache。&lt;br&gt;Payload／page／queue／concurrency／retention 全部有硬上限。&lt;br&gt;cleanup／drain／dispose 失敗是 release blocker。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="ph4" value="P7.4&lt;br&gt;Product cutover&lt;br&gt;&lt;br&gt;Controller／Service／WebServiceConnector 逐 capability 改依賴&lt;br&gt;ProductClient。每個 capability 獨立 feature gate，&lt;br&gt;任一退步只回滾該 capability。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="618" y="965" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="ph5" value="P7.5&lt;br&gt;ToolUtility removal gate&lt;br&gt;&lt;br&gt;matrix 不得再有 temporary-legacy rows。移除 project reference、&lt;br&gt;DI／Factory、legacy credential／endpoint 與直接呼叫。&lt;br&gt;zero-reference scan ＋ 真機結果 ＋ soak 全通過才關閉 rollback window。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1196" y="965" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="children" value="★ implement.md 定義的 9 個 child task 與依賴順序&lt;br&gt;&lt;br&gt;　inventory → catalog modules → Package01 first vertical slice → ┬ remaining reads ┐&lt;br&gt;　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　├ writes/actions　├→ product cutover → ToolUtility removal&lt;br&gt;　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　└ special resources┘&lt;br&gt;　catalog modules → multiproduct onboarding（第二產品觸發）&lt;br&gt;&lt;br&gt;1. gateway-capability-inventory　2. gateway-operation-catalog-modules　3. churchreport-package01-read-migration&lt;br&gt;4. churchreport-read-capability-migrations　5. churchreport-write-action-migrations　6. churchreport-special-resource-migrations&lt;br&gt;7. churchreport-productclient-cutover　8. churchreport-toolutility-removal　9. gateway-multiproduct-onboarding" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1720" height="180" as="geometry"/></mxCell>
        <mxCell id="p8" value="P8　多產品 Operation 治理與 Central Gateway（第二產品觸發，不阻塞 P7）&lt;br&gt;目標：讓建設公司、票款通、協會等新產品從第一天只使用 ProductClient／capability operation，不複製 ToolUtility／CRM SDK／credential ownership。&lt;br&gt;Operation catalog 分三層：① 平台共同 capability　② 共用領域 capability（契約完全相同才共用）　③ 產品專屬 capability（churchreport.* / construction.* / ticketing.* / association.*）。&lt;br&gt;★ 重要：ChurchReport 那 70 個 call site 是十餘年的歷史包袱，不是新產品的入門門檻。新產品需要幾個 operation 就註冊幾個。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1720" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="6. 模組職責清冊">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="2080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="模組職責清冊　—　每一個專案是什麼、用什麼 Framework、負責什麼&lt;br&gt;顏色沿用前幾頁：藍＝產品層　綠＝共用能力　橘＝Dynamics 平台　灰＝legacy／工具／測試。★ 標記＝2026-08-05 更新或需要注意的事實。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2933;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="th1" value="專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334E68;strokeColor=#243B53;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="340" height="34" as="geometry"/></mxCell>
        <mxCell id="th2" value="型態 / TFM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334E68;strokeColor=#243B53;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="190" height="34" as="geometry"/></mxCell>
        <mxCell id="th3" value="職責與重點" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334E68;strokeColor=#243B53;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="1150" height="34" as="geometry"/></mxCell>
        <mxCell id="r0c1" value="SpeechMessageProducts.ChurchReport" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="164" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r0c2" value="net10.0 · Exe · MVC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="164" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r0c3" value="唯一對外產品。教會報表主站：會友資料、奉獻收費與稽核、小組、設備、排班、QR、LINE 綁定、金流付款。23 個 Controller、40＋ Service 群、36 檔 WebServiceConnector 整合層。★ P7 的遷移對象；P7.5 後不得再引用 ToolUtility 或任何 CRM SDK 型別。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="164" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r1c1" value="ToolUtility" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r1c2" value="net10.0 · Lib · 90 檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r1c3" value="Legacy CRM 操作外觀，142 個公開方法。20＋ 操作群：Contact／Activity／Fee／Lessons／Attachment／Appointment／Query／List／Owner／Collection／MeetingStatistics／Entity／Attribute，另含 CrmConnectionPool、CrmConnectionService、CrmCacheService。★ 目前承載 100% Dynamics 業務流量；遷移期作為對帳與回滾來源。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r2c1" value="PowerPlatform.Dataverse.Client（Data8）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="296" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r2c2" value="net10.0 · Lib ＋ NSspi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="296" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r2c3" value="第三方 MIT 授權的 WS-Trust／SOAP 實作，提供 OnPremiseClient : IOrganizationService。★ §11.2 已修：現已實作 IDisposable，Dispose 對 federatedChannel 與 ChannelFactory 做 Close()／失敗 Abort()，並彙總清理失敗不互相遮蔽。★ §11.1 未修：_sdkMajorVersion 仍是 static（fallback = 9），同進程雙 CE 版本並存前需先完成前置決策 A1。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="296" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r3c1" value="Line.Messaging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="362" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r3c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="362" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r3c3" value="LINE Messaging API 的型別層：Messages／Flex（Component／Style／ParameterTypes）／Template／Imagemap／QuickReply／RichMenu／Webhooks／Liff／Exceptions／Json 轉換。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="362" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r4c1" value="LineMessagingProcessor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="428" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r4c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="428" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r4c3" value="單一 Facade（LineMessagingProcessorClass），把所有對外 LINE API 呼叫收斂到一個進入點。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="428" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r5c1" value="LineMessagingProcessor.Workflows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="494" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r5c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="494" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r5c3" value="回覆與推播工作流：ILineReplyWorkflow／ILineNotificationWorkflow，加上 Carousel／Imagemap／QuickReply／Template 動作工廠與訊息驗證，並定義收件人種類、結果狀態與例外型別。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="494" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r6c1" value="LineMessagingProcessor.RichMenus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r6c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r6c3" value="RichMenu 完整生命週期：Catalog 定義、Fingerprint 比對、建立上傳連結、別名 Id 快取、指派工作流、文字觸發解析與政策、到期清掃（Sweep）、Orchestrator 與 StateStore。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r7c1" value="LineMessagingProcessor.AspNetCore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="626" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r7c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="626" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r7c3" value="LINE 模組的 Options 與 DI 註冊進入點；ChurchReport 由此帶入多組織 Channel Access Token。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="626" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r8c1" value="SpeechMessage.Payments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="692" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r8c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="692" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r8c3" value="金流核心。抽象：IPaymentGateway／IPaymentProvider／IPaymentProfileResolver。三家 Provider 各自的請求映射、簽章與加解密、回呼解析、狀態對應：永豐 Sinopac（Crypto＋Signer）、高鉅 MyPay（SignatureVerifier）、台新 Taishin（HashVerifier）。含診斷遮罩（PaymentDiagnosticsSanitizer）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="692" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r9c1" value="SpeechMessage.Payments.Workflows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="758" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r9c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="758" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r9c3" value="訂單草稿模型（Order／LineItem／Payer／Schedule／MethodSelection）與付款後工作流（PostPaymentWorkflow）、結果映射。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="758" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r10c1" value="SpeechMessage.Payments.AspNetCore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="824" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r10c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="824" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r10c3" value="金流模組的 DI 註冊。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="824" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r11c1" value="SpeechMessage.Dynamics.Abstractions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="890" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r11c2" value="net10.0 · Lib&lt;br&gt;零專案相依" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="890" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r11c3" value="契約層，整個 Dynamics 平台的地基。Execution：ConnectionMode／ConnectorKind／CeVersion。Configuration：ProductDynamicsOptions、DynamicsProfileOptions、OrganizationCatalogEntry／State、PoolPolicy、OperationPolicy、IProfileResolver、ResolvedProfile。Connectors：IConnectorClient／Lease／Pool／Router。Operations：IDynamicsOperationExecutor、Request／Result、OperationDefinition／Ids、Package01OperationRegistry、OperationResponseData（★ 封閉聯集）、DynamicsErrorCodes。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="890" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r12c1" value="SpeechMessage.Dynamics.ControlPlane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="956" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r12c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="956" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r12c3" value="治理核心，三種模式共用。Guard：IRequestGuard／RequestGuard／RequestOrigin（G1～G6 fail closed）。Capacity：OrganizationAdmissionManager／Registry／Plan／Options、DispatchEnvelope、IRuntimeHostSlotCoordinator 的 InMemory（IsDurable=false，僅進程內）與 SQL（跨進程）兩種實作。Runtime：DynamicsProfileRuntimeManager（世代）、Factory、ProfileRoutedOperationExecutor、ControlledOperationExecutor、OperationDispatchPreparer。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="956" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r13c1" value="SpeechMessage.Dynamics.Connectors.Data8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1022" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r13c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1022" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r13c3" value="Data8 傳輸的 Connector 實作：Data8ConnectorPool（池鍵 =(ProfileAlias, GenerationId)）、Registry、Router、Data8ProfileRuntime、Data8ProfileOperationExecutor、OnPremiseData8ConnectorClientFactory。★ 目前只實作 runtime.health.whoami 一個 operation，其餘一律拒絕（見 OnPremiseData8ConnectorClientFactory.cs:191）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1022" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r14c1" value="SpeechMessage.Dynamics.Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1088" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r14c2" value="net10.0 · Exe&lt;br&gt;Minimal API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1088" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r14c3" value="HTTPS 主機與組合根。端點：GET /health、GET /ready、GET /v1/operations、POST /v1/organizations/{alias}/operations/{capabilityOperationId}。Development 由 Kestrel 註冊 Negotiate handler；另支援 IIS 模式。請求本體大小與 JSON 深度由同一份已驗證設定同時套用到 Kestrel、IIS 與 JsonOptions，設定無效時 ValidateOnStart 在接流量前中止。DeploymentMode=DedicatedGateway 時只允許單一 profile alias、強制 Data8 組態、註冊 DedicatedData8RuntimeHostedService，且不註冊 SQL 協調器。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1088" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r15c1" value="SpeechMessage.Dynamics.Embedded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1154" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r15c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1154" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r15c3" value="同進程 Adapter（EmbeddedHostAdapter ＋ DI 擴充）。省掉 HTTP 跳躍，但 Guard／Resolver／Admission／Pool 一步不少。★ 注意：即使選 Embedded，新產品仍不得借用 IOrganizationService（design.md §3）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1154" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r16c1" value="SpeechMessage.Dynamics.ProductClient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1220" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r16c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1220" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r16c3" value="產品端強型別客戶端：GatewayDynamicsOperationExecutor、Package01FeeReadClient、FeeRecordDto／StorLessonRecordDto、GatewayProductClientLimits 與設定驗證器。★ P7 後這是產品看見 Dynamics 的唯一介面。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1220" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r17c1" value="SpeechMessage.Dynamics.WorkerProtocol" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1286" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r17c2" value="netstandard2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1286" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r17c3" value="net10 監督者與 net48 Worker 共用的線路協定：Frame／Envelope 編解碼與驗證、協定版本與限制、Ready／Request／Response／Drain 訊息、WorkerValue 型別系統、失敗分類、Package01FeeWorkerContract。選 netstandard2.0 是為了同時被兩個 Framework 參考。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1286" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r18c1" value="SpeechMessage.Dynamics.WorkerHost" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1352" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r18c2" value="netstandard2.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1352" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r18c3" value="Worker 端主機：NamedPipeOfficialWorkerConnector、OfficialWorkerProcessHost／Session、IOfficialCrmClient(Factory) 抽象、驗證與身分模式、Windows Credential Manager 存取（原生 API 封裝）、XmlWorkerProfileStore、結果大小上限例外。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1352" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r19c1" value="SpeechMessage.Dynamics.WorkerSupervisor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1418" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r19c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1418" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r19c3" value="net10 端的 Worker 監督者：OfficialWorkerProfileExecutor、進程環境與啟動例外、回收政策與回收原因、資源觀測、生命週期快照、Package01FeeWorkerResponseProjector、版本標示。★ 目前只執行 fee.dedication.retrieve.by.contact.date.range 一個 capability。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1418" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r20c1" value="SpeechMessage.Dynamics.Crm82Worker&lt;br&gt;SpeechMessage.Dynamics.Crm91Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1484" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r20c2" value="net48 · Exe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1484" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r20c3" value="隔離的官方 XrmTooling 進程，分別鎖 8.2.0.5 與 9.1.1.65。刻意不合併：兩者的 Microsoft.Xrm.Sdk 版本、Assembly Binding、IFD WS-Trust 與 OAuth 狀態都不同，要合併必須先有實機證據。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1484" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r21c1" value="Trace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1550" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r21c2" value="net10.0 · Lib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1550" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r21c3" value="堆疊追蹤與 TraceListener 工具（BSUStackTrace、BSUTextWriterTraceListener）。目前沒有專案 ProjectReference。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1550" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r22c1" value="LinePayCSharp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1616" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r22c2" value="netstandard1.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1616" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r22c3" value="早期 LINE Pay 客戶端。目前沒有任何專案參考，僅保留在方案中。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1616" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r23c1" value="測試專案（9 個）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1682" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r23c2" value="net10.0 / net48" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1682" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r23c3" value="SpeechMessage.Dynamics.Tests 是主力（47＋ 檔）：守門與契約邊界、Profile 解析、世代與容量、借還與洩漏 soak、Worker 協定與進程生命週期、Gateway 請求邊界與 Negotiate、SQL 協調器（含跨進程）、DedicatedGatewayOptionsTests、ProjectReferenceBoundaryTests。另有 ChurchReport.MemberInfo.Tests、ToolUtility.Tests、Line.Messaging.Tests、LineMessagingProcessor(.AspNetCore/.RichMenus/.Workflows).Tests、SpeechMessage.Payments.Tests、Crm82/91Worker.Tests。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1682" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="r24c1" value="測試輔助進程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1748" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="r24c2" value="net10.0 · Exe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="1748" width="190" height="62" as="geometry"/></mxCell>
        <mxCell id="r24c3" value="SpeechMessage.Dynamics.WorkerTestHost（Worker 協定驗證）、SpeechMessage.Dynamics.SqlCoordinatorTestWorker（跨進程 SQL 容量協調器驗證）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F4F8;strokeColor=#BCCCDC;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="580" y="1748" width="1150" height="62" as="geometry"/></mxCell>
        <mxCell id="n_cat" value="設定的三層分工（規格書 §4 —— 理解整個平台最關鍵的一張表）：&lt;br&gt;　· DynamicsProfiles　　　ProfileAlias → OrganizationAlias、CeVersion、ConnectorKind、CredentialReference、Pool／容量／逾時／重試政策　【不得含憑證值或 Token】&lt;br&gt;　· OrganizationCatalog　OrganizationAlias → FriendlyName、UniqueName、OrganizationId、State、CeVersion、ServiceUri　【只保存身分事實】&lt;br&gt;　· CredentialProvider　　CredentialReference → 實際憑證　【開發可讀 Configuration／User Secrets；正式必須接 Environment 或 Secret Store】&lt;br&gt;&lt;br&gt;ChurchReport 的 CrmConnection:OrganizationCatalog 已登錄 5 個 CE 9.1 ＋ 27 個 CE 8.2 組織。只有 sunnyvalechback 有已核准的 HTTPS ServiceUri，其餘 alias 一旦被選取會在建立任何 client／permit／credential 之前 fail closed。speechmessage 同時存在於兩個版本，因此拆成 speechmessage-ce82 與 speechmessage-ce91。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1834" width="1700" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
