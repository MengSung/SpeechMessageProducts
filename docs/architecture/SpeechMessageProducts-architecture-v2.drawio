        <mxCell id="g_dynaccess" value="③-C　Dynamics 存取（★ 遷移後唯一合法入口）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="1020" y="515" width="340" height="265" as="geometry"/></mxCell>
        <mxCell id="m_pc" value="SpeechMessage.Dynamics.ProductClient&lt;br&gt;產品端強型別客戶端&lt;br&gt;GatewayDynamicsOperationExecutor&lt;br&gt;Package01FeeReadClient ＋ DTO&lt;br&gt;★ P7 後所有 D365 行為都必須經過這裡" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="550" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="m_emb" value="SpeechMessage.Dynamics.Embedded&lt;br&gt;同進程 Adapter（EmbeddedHostAdapter）&lt;br&gt;省掉 HTTP 跳躍，治理鏈一步不少&lt;br&gt;產品 API 形狀與 Gateway 完全相同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="668" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="g_legacy" value="③-D　Legacy 路徑（★ 已改列為「遷移期對帳／回滾來源」，非長期架構）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="1380" y="515" width="380" height="265" as="geometry"/></mxCell>
        <mxCell id="m_tu" value="ToolUtility（net10.0 · 90 檔 · 142 方法）&lt;br&gt;Contact／Activity／Fee／Lessons／Attachment&lt;br&gt;Appointment／Query／List／Owner／Collection&lt;br&gt;＋ CrmConnectionPool／CrmConnectionService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1405" y="550" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="m_data8" value="PowerPlatform.Dataverse.Client（Data8）&lt;br&gt;第三方 MIT WS-Trust／SOAP 實作&lt;br&gt;OnPremiseClient : IOrganizationService, IDisposable&lt;br&gt;★ §11.2 已修，Dispose 走 Close／Abort 並彙總失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1405" y="668" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="g_plat" value="④　Dynamics 連線治理平台" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1720" height="290" as="geometry"/></mxCell>
        <mxCell id="d_abs" value="Abstractions&lt;br&gt;（零專案相依的契約層）&lt;br&gt;ConnectionMode／ConnectorKind／CeVersion&lt;br&gt;ProductDynamicsOptions／ResolvedProfile&lt;br&gt;IConnectorPool／Lease／Router&lt;br&gt;IDynamicsOperationExecutor／OperationRegistry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="845" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="d_cp" value="ControlPlane&lt;br&gt;（治理核心 · 三模式共用）&lt;br&gt;Guard：保留字／alias／operation 守門&lt;br&gt;Capacity：Organization 准入、&lt;br&gt;　In-Memory 與 SQL 協調器&lt;br&gt;Runtime：Profile 世代管理、路由執行器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="845" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="d_conn" value="Connectors.Data8&lt;br&gt;（連線池實作）&lt;br&gt;Data8ConnectorPool／Registry／Router&lt;br&gt;池鍵＝(ProfileAlias, GenerationId)&lt;br&gt;Data8ProfileRuntime／Executor&lt;br&gt;★ 目前只實作 whoami 一個 operation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="845" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="d_gw" value="Gateway&lt;br&gt;（net10 · Exe · Minimal API 主機）&lt;br&gt;GET /health · GET /ready&lt;br&gt;GET /v1/operations&lt;br&gt;POST /v1/organizations/{alias}/operations/{id}&lt;br&gt;DeploymentMode=DedicatedGateway 走專屬啟動流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="845" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="d_wk" value="Worker 群（官方 SDK 隔離）&lt;br&gt;WorkerProtocol（netstandard2.0）線路協定&lt;br&gt;WorkerHost（netstandard2.0）Named Pipe 主機&lt;br&gt;WorkerSupervisor（net10）進程監督與回收&lt;br&gt;Crm82Worker／Crm91Worker（net48 · Exe）&lt;br&gt;★ 目前只實作 1 個 fee operation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="845" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="n_plat" value="治理鏈（三種 ConnectionMode 完全共用，Embedded 不是繞過治理的後門）：&lt;br&gt;①守門 RequestGuard　→　②解析 ProfileResolver（Alias → Catalog → ResolvedProfile）　→　③准入 AdmissionController（有界佇列＋逾時）　→　④借出 ConnectorPool（依當下 Active Generation）　→　⑤執行（獨立 Request Context）　→　⑥歸還或淘汰　→　⑦finally 無條件釋放 Permit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1000" width="1660" height="70" as="geometry"/></mxCell>
        <mxCell id="g_ext" value="⑤　外部系統" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1720" height="140" as="geometry"/></mxCell>
        <mxCell id="x_91" value="D365 CE 9.1&lt;br&gt;已登錄 5 個組織&lt;br&gt;sunnyvalechback 為實機目標" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1155" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="x_82" value="D365 CE 8.2 IFD&lt;br&gt;已登錄 27 個組織&lt;br&gt;可行路徑仍是 WS-Trust／SOAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="1155" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="x_lineapi" value="LINE Messaging API&lt;br&gt;推播／回覆／RichMenu&lt;br&gt;多組織多 Channel Token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="1155" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="x_paysvc" value="金流服務&lt;br&gt;永豐 Sinopac／高鉅 MyPay／台新 Taishin&lt;br&gt;建立訂單 · 查詢 · 回呼驗簽" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="1155" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="x_sql" value="SQL Server（可選）&lt;br&gt;僅多節點 Central Gateway&lt;br&gt;需要分散式容量協調器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="1155" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="n_foot" value="★ 現況一句話：新架構已建置且可啟動，但實際業務流量 100% 仍走 ③-D。&lt;br&gt;ChurchReport appsettings.json：ConnectionMode=DedicatedGateway、ProfileAlias=crm91、Endpoint=https://localhost:5101/、Package01FeeReadsEnabled=false。&lt;br&gt;旗標為 false 時產品不建立任何 Gateway client、socket pool、timer 或背景工作。P7 的工作就是把 70 個 call site 逐批搬到 ③-C，最後在 P7.5 拆掉 ③-D。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1285" width="1720" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u_web" target="cr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5568;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u_line" target="cr"><mxGeometry relative="1" as="geometry"/></mxCell>
