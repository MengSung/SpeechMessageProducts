        <mxCell id="g_w48" value="跨 Framework 邊界：net48 Worker 進程（官方 XrmTooling 鎖版隔離）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="1260" height="130" as="geometry"/></mxCell>
