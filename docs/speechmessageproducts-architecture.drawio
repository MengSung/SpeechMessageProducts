        <mxCell id="wa_cap" value="Capacity/　容量與租約" style="swimlane;html=1;startSize=26;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=12;fontStyle=1;" vertex="1" parent="d_wa">
