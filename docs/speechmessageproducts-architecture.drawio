  <diagram name="3 · 一次請求的旅程" id="page-flow">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t3" value="一次「查詢奉獻費用」的完整旅程（官方 Worker 路線）" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="綠 = 已由 333 項通過測試涵蓋　　黃 = 已實作但未真機驗證　　紅 = 尚未打通或已孤兒" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="18" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="① 使用者在 ChurchReport 開啟「奉獻收費清單」" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="fg" value="Package01FeeReadsEnabled ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="475" y="165" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="fl" value="false（目前值）&#10;→ ToolUtility → Data8 → WS-Trust/SOAP → CE 8.2&#10;這是現在真正在跑的路徑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="172" width="350" height="62" as="geometry" />
        </mxCell>

        <mxCell id="f2" value="② ProductClient 組請求：Operation ID + 具名參數（contactId、起訖日）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="270" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="③ HTTP POST → Gateway&#10;/v1/organizations/{alias}/operations/{capabilityOperationId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="345" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="④ Windows Negotiate 驗證　未驗證 → 401（在讀 body 之前）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="425" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="⑤ WorkloadBindingSet 授權　alias / operation 未授權 → 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="501" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="⑥ ControlPlane 容量准入&#10;排隊 → 取得 Permit。佇列滿 / 超封包上限 / 逾期 → 拒絕&#10;★ 排隊期間不持有任何連線物件，舊世代可正常收斂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="577" width="490" height="64" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="⑦ 取得 Host Slot 租約（InMemory 或 SQL）&#10;⚠ SQL 版 7 項 live 測試全部 SKIP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="671" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="⑧ 解析當下 Active Profile 世代 → 取得 Execution Lease" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="751" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="⑨ WorkerSupervisor 依 profile 挑選 worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="827" width="450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="⑩ 序列化成 WorkerRequestV1 → 具名管道送出&#10;WorkerEnvelopeValidator 檢查大小 / 版本 / 型別" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="903" width="450" height="50" as="geometry" />
        </mxCell>

        <mxCell id="f11" value="⑪ 進程邊界" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="985" width="240" height="66" as="geometry" />
        </mxCell>
        <mxCell id="f12a" value="Crm82Worker（net48）&#10;官方 XrmTooling 8.2.0.5&#10;CrmServiceClient → IOrganizationService&#10;→ CE 8.2 IFD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="1100" width="300" height="86" as="geometry" />
        </mxCell>
        <mxCell id="f12b" value="Crm91Worker（net48）&#10;官方 XrmTooling 9.1.1.65&#10;CrmServiceClient → IOrganizationService&#10;→ CE 9.1 IFD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="1100" width="300" height="86" as="geometry" />
        </mxCell>
        <mxCell id="f12c" value="憑證來源：Windows 認證管理員（DPAPI）&#10;不再從設定檔或環境變數取得明文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="1100" width="310" height="50" as="geometry" />
        </mxCell>

        <mxCell id="f13" value="⑫ WorkerResponseV1 回傳 → 投影成 DTO&#10;★ 不得把 CRM 真實 hostname / endpoint 洩漏給產品" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="1230" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f14" value="⑬ 釋放 Execution Lease → 釋放 Admission Permit&#10;★ 中途例外時兩者獨立清理並彙總回報" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="1310" width="450" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fx1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f1" target="fg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx2" value="false" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" edge="1" parent="1" source="fg" target="fl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx3" value="true" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="fg" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry" /></mxCell>
