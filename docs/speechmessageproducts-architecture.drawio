        <mxCell id="cp1" value="OrganizationAdmissionManager&#10;有界佇列 · 併發號誌 · 每工作負載上限&#10;封包大小檢查 · 期限檢查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="wa_cap">
