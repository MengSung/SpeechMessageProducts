  <diagram name="3 · 一次請求的完整旅程" id="page-flow">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t3" value="一次「查詢奉獻費用」請求的完整旅程" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="綠色 = 已由 253 項測試驗證　　橘色 = 已實作但只有本機假目標驗證　　紅色 = 尚未打通" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="① 使用者在 ChurchReport 開啟「奉獻收費清單」" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fgate" value="Package01FeeReadsEnabled ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="flegacy" value="false（目前設定）&#10;→ 走 ToolUtility → Data8 → WS-Trust/SOAP → CE 8.2&#10;這是現在真正在跑的路徑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f2" value="② ProductClient 組出請求&#10;只放 Operation ID + 具名參數（contactId, 起訖日）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f3" value="③ HTTP POST → Gateway&#10;/v1/organizations/{alias}/operations/{capabilityOperationId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="385" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f4" value="④ Gateway 驗證身分（Windows Negotiate）&#10;未驗證 → 401，在讀 body / 碰 CRM 之前就擋掉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f5" value="⑤ 授權檢查（WorkloadBindingSet）&#10;alias 或 operation 不在允許清單 → 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="555" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f6" value="⑥ 容量准入（OrganizationAdmissionManager）&#10;排隊 → 取得 Permit。佇列滿 / 超過封包上限 / 逾期 → 拒絕&#10;★ 排隊期間不持有任何連線物件，所以舊世代能正常收斂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="640" width="440" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f7" value="⑦ 取得 Host Slot 租約（記憶體版或 SQL 版）&#10;確保所有主機加總不超過該組織的總併發上限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="740" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f8" value="⑧ 解析「當下」的 Active Profile 世代&#10;取得 Execution Lease → 綁定該世代的 Client / Transport / TokenProvider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="825" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f9" value="⑨ 套用 server-owned FetchXML 範本&#10;參數經 FetchXmlValueEncoder 編碼（防注入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="915" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="f10" value="⑩ Profile 路由" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="1000" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f11a" value="crm91 → Web API v9.1&#10;（尚未打通真機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="1005" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f11b" value="crm82 → 方案 A：Web API v8.2&#10;方案 B：net48 Worker（0 行程式）&#10;暫時：Data8 SOAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="1000" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f12" value="⑪ 回應投影：只回傳 DTO&#10;★ 不能把 CRM 真實 hostname / @odata.context / nextLink 傳給產品&#10;（此項為 Phase 4 未結項）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="1110" width="440" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f13" value="⑫ 釋放 Execution Lease → 釋放 Admission Permit&#10;★ 即使中途例外，兩者都會被獨立清理並彙總回報" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="1210" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fx1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f1" target="fgate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx2" value="false" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=3;fontSize=11;fontStyle=1;" edge="1" parent="1" source="fgate" target="flegacy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx3" value="true" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="fgate" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f8" target="f9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f9" target="f10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="f10" target="f11a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx13" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="f10" target="f11b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f10" target="f12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fx15" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="1" source="f12" target="f13"><mxGeometry relative="1" as="geometry" /></mxCell>

