  <diagram name="4 · 三次路線變更與遺留物" id="page-history">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t4" value="三次路線變更（2026-07-23 → 08-02，11 天）" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="800" height="34" as="geometry" />
        </mxCell>

        <mxCell id="v1" value="v1 · 07-23　完全禁用 SDK&#10;&#10;目標：純 HTTP / OData v4&#10;移除所有 Microsoft.Xrm / CrmSdk&#10;移除 Data8&#10;&#10;產出：WebApi 專案（41 檔）&#10;　　　HTTP 傳輸 / ADFS OAuth&#10;　　　FetchXML 編碼 / 世代管理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="v2" value="v2 · 07-29　官方優先 + Central/Local&#10;&#10;放棄「完全禁用 SDK」&#10;判準改為「是不是微軟官方」&#10;Embedded → Local Gateway&#10;&#10;產出：SPEC 63KB + 說明書 84KB&#10;　　　＋ 互動架構圖 68KB&#10;　　　Gateway 授權層 / SQL 協調器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="v3" value="v3 · 08-02　官方 NuGet Worker（現行）&#10;&#10;放棄直接 Web API&#10;改用官方 CrmServiceClient&#10;關在 net48 獨立進程&#10;具名管道 IPC 溝通&#10;&#10;產出：8 個新專案&#10;　　　ControlPlane / WorkerProtocol&#10;　　　WorkerHost / WorkerSupervisor&#10;　　　Crm82Worker / Crm91Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="卡住：CE on-prem 的 ADFS&#10;服務身分權杖可能不存在" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" value="卡住：需管理員身分註冊&#10;ADFS client，停滯 17.5 小時" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="keyIns" value="★ v3 之所以解開僵局，是因為 CrmServiceClient 走 IFD / WS-Trust —— 跟現有 legacy SOAP 是同一條認證路徑。&#10;不需要新的 ADFS client 註冊，也就不需要那個 Codex 打不開的管理通道。這才是這次轉向真正的價值。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1120" height="64" as="geometry" />
        </mxCell>

        <mxCell id="dead" value="遺留物處置（08-02 14:37 已清除）" style="swimlane;html=1;startSize=30;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="435" width="1120" height="300" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="✔ SpeechMessage.Dynamics.WebApi · 41 檔　已刪除&#10;v1 的核心產出。約 26 檔（Capacity/ 與部分 Runtime/）已先搬進 ControlPlane 保住；&#10;約 15 檔傳輸相關（DynamicsHttpTransport · AdfsOAuthTokenProvider · DynamicsWebApiClient · ApprovedWebApiRootFactory&#10;· FetchXmlValueEncoder · Package01ServerOwnedTemplates · SecretResolver 系列）隨專案一併移除。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="dead">
