          <mxGeometry x="15" y="105" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cp3" value="OrganizationAdmissionPlan&#10;LocalMaxInFlight =&#10;floor(Aggregate / MaximumRuntimeHosts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="wa_cap">
          <mxGeometry x="320" y="105" width="305" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cp4" value="InMemoryRuntimeHostSlotCoordinator&#10;IsDurable = false&#10;單一進程 / 開發用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf5ea;strokeColor=#82b366;fontSize=11;" vertex="1" parent="wa_cap">
          <mxGeometry x="15" y="192" width="290" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cp5" value="SqlRuntimeHostSlotCoordinator&#10;IsDurable = true · Fencing Token&#10;AdmissionEpoch · 設定指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="wa_cap">
          <mxGeometry x="320" y="192" width="305" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cpN" value="⚠ SQL 版本是為「跨進程 / 主機動態增減」設計。單一 Local Gateway 用記憶體版即可（RequireDurableHostCoordinator 開關控制）。&#10;⚠ 唯一未通過驗證的測試就在這裡：SqlRuntimeHostSlotCoordinatorTests 需真實 SQL 實例，目前 SKIP。" style="text;html=1;fontSize=11;fontColor=#8a6d00;align=left;" vertex="1" parent="wa_cap">
          <mxGeometry x="15" y="265" width="610" height="35" as="geometry" />
