        <mxCell id="gw1" value="POST /v1/organizations/{alias}/operations/{id}&#10;Windows Negotiate 驗證 → 未驗證即 401" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="w_gw">
          <mxGeometry x="18" y="36" width="345" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gw2" value="ConfigurationGatewayOperationAuthorizer&#10;WorkloadBindingSet → alias / operation 授權，否則 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="w_gw">
          <mxGeometry x="375" y="36" width="347" height="50" as="geometry" />
        </mxCell>

        <mxCell id="w_cp" value="ControlPlane · 26（net10）　容量與世代治理　【由原 WebApi 專案搬遷而來】" style="swimlane;html=1;startSize=28;fillColor=#cfe2f3;strokeColor=#3d6ea5;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="450" width="1100" height="185" as="geometry" />
        </mxCell>
        <mxCell id="cp1" value="Capacity/　12 檔&#10;OrganizationAdmissionManager（有界佇列 · 併發號誌 · 每工作負載上限）&#10;CapacityKeys · AdmissionPlan · InMemory / SQL HostSlotCoordinator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="w_cp">
          <mxGeometry x="18" y="38" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cp2" value="Runtime/　13 檔&#10;DynamicsProfileRuntimeManager（每 alias 最多 1 Active + 1 Draining）&#10;ControlledOperationExecutor · ProfileRoutedOperationExecutor · DispatchPreparer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="w_cp">
          <mxGeometry x="550" y="38" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cp3" value="⚠ SQL 協調器的 7 項 live 測試全部 SKIP（需真實 SQL 實例）——這是目前最大的未驗證面。&#10;⚠ CE on-premises 沒有微軟服務保護配額；此處容量控管的正當理由已改為「限制 net48 worker 進程數量」。" style="text;html=1;fontSize=11;fontColor=#8a6d00;align=left;" vertex="1" parent="w_cp">
          <mxGeometry x="18" y="118" width="1062" height="40" as="geometry" />
        </mxCell>

        <mxCell id="w_sup" value="WorkerSupervisor · 4（net10）　Worker 選擇與生命週期" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="670" width="740" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sp1" value="OfficialWorkerProfileExecutor&#10;依 profile 挑 8.2 或 9.1 worker 並派工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="w_sup">
          <mxGeometry x="18" y="36" width="345" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sp2" value="OfficialWorkerLifecycleSnapshot · OfficialWorkerVersion&#10;可觀測狀態 + 執行檔版本／雜湊綁定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="w_sup">
          <mxGeometry x="375" y="36" width="347" height="45" as="geometry" />
        </mxCell>

        <mxCell id="w_bridge" value="跨框架橋接層【netstandard2.0】　★ 唯一能同時被 net48 與 net10 參考的目標框架" style="swimlane;html=1;startSize=28;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="1100" height="185" as="geometry" />
        </mxCell>
        <mxCell id="wh1" value="WorkerProtocol · 18　IPC 契約（純資料 + 驗證）&#10;WorkerRequestV1 / WorkerResponseV1 / WorkerReadyV1 / WorkerDrainV1&#10;WorkerFrameCodec · WorkerEnvelopeCodec · Validators · ProtocolLimits · Version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="w_bridge">
          <mxGeometry x="18" y="38" width="520" height="72" as="geometry" />
        </mxCell>
        <mxCell id="wh2" value="WorkerHost · 18　Worker 進程宿主與傳輸&#10;NamedPipeOfficialWorkerConnector（具名管道）&#10;OfficialWorkerProcessHost / Session / ExitCode&#10;WindowsCredentialManagerProvider　★ 憑證改由 Windows 認證管理員提供" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="w_bridge">
          <mxGeometry x="550" y="38" width="530" height="72" as="geometry" />
        </mxCell>
        <mxCell id="wh3" value="IOfficialCrmClient / IOfficialCrmClientFactory —— 抽象介面在此，實作在各 worker，因此橋接層本身不相依任何 CRM SDK。" style="text;html=1;fontSize=11;fontColor=#2d6b3f;align=left;" vertex="1" parent="w_bridge">
          <mxGeometry x="18" y="120" width="1062" height="36" as="geometry" />
        </mxCell>

        <mxCell id="w82" value="Crm82Worker · 3　【net48 獨立進程】" style="swimlane;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="1020" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="w82a" value="Program.cs · OfficialCrmServiceClientFactory · OfficialCrmServiceClientAdapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w82">
          <mxGeometry x="18" y="36" width="484" height="36" as="geometry" />
        </mxCell>
        <mxCell id="w82b" value="微軟官方 NuGet（版本鎖定 8.2）&#10;Microsoft.CrmSdk.XrmTooling.CoreAssembly 8.2.0.5&#10;Microsoft.CrmSdk.CoreAssemblies 8.2.0.2&#10;Microsoft.CrmSdk.Deployment / Workflow 8.2.0.2&#10;Microsoft.IdentityModel.Clients.ActiveDirectory 2.29.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="w82">
          <mxGeometry x="18" y="82" width="484" height="86" as="geometry" />
        </mxCell>

        <mxCell id="w91" value="Crm91Worker · 3　【net48 獨立進程】" style="swimlane;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="1020" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="w91a" value="Program.cs · OfficialCrmServiceClientFactory · OfficialCrmServiceClientAdapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="w91">
