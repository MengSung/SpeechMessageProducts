        <mxCell id="d_emb" value="Dynamics.Embedded（1 檔）　【凍結】" style="swimlane;html=1;startSize=30;fillColor=#eeeeee;strokeColor=#999999;fontSize=13;fontStyle=1;fontColor=#777777;dashed=1;" vertex="1" parent="1">
