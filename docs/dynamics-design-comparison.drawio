  <diagram name="1 · 兩個設計並排" id="p1">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Codex 的設計　vs　我的設計" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="800" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="共同點：兩者都是雙軸（連線模式 × 連接器種類）、都用 per-Organization Profile、都把 Data8 當正當選項。差異在下面五處。" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1300" height="18" as="geometry" /></mxCell>

        <!-- ============ 左：Codex ============ -->
        <mxCell id="LX" value="Codex 的設計" style="swimlane;html=1;startSize=34;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=15;fontStyle=1;fontColor=#5A3B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="800" height="1090" as="geometry" /></mxCell>

        <mxCell id="Lp" value="產品" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="LX">
          <mxGeometry x="330" y="48" width="140" height="42" as="geometry" /></mxCell>
        <mxCell id="Lm" value="ConnectionMode" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="300" y="128" width="200" height="80" as="geometry" /></mxCell>

        <mxCell id="Ld" value="產品內 Data8 Pool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=12;fontStyle=1;fontColor=#7A1D18;" vertex="1" parent="LX">
          <mxGeometry x="24" y="740" width="210" height="52" as="geometry" /></mxCell>

        <mxCell id="Llg" value="Local Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="280" y="252" width="170" height="46" as="geometry" /></mxCell>
        <mxCell id="Lcg" value="Central Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="500" y="252" width="170" height="46" as="geometry" /></mxCell>

        <mxCell id="Lpf" value="per-Organization Profile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="360" y="352" width="230" height="46" as="geometry" /></mxCell>
        <mxCell id="Lck" value="ConnectorKind" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="385" y="452" width="180" height="76" as="geometry" /></mxCell>

        <mxCell id="Lgd" value="Gateway 內 Data8 Pool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="270" y="740" width="210" height="52" as="geometry" /></mxCell>
        <mxCell id="Lwk" value="net48 Worker Process Pool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8A5A00;fontSize=12;" vertex="1" parent="LX">
          <mxGeometry x="520" y="740" width="230" height="52" as="geometry" /></mxCell>

        <mxCell id="Lcrm" value="D365 8.2 ／ 9.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="LX">
          <mxGeometry x="300" y="880" width="200" height="46" as="geometry" /></mxCell>

        <mxCell id="Le1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="LX" source="Lp" target="Lm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le2" value="DirectData8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#A32620;fontSize=11;fontStyle=1;fontColor=#A32620;" edge="1" parent="LX" source="Lm" target="Ld">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="129" y="168" /></Array></mxGeometry></mxCell>
        <mxCell id="Le3" value="LocalGateway" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="LX" source="Lm" target="Llg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le4" value="CentralGateway" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="LX" source="Lm" target="Lcg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="LX" source="Llg" target="Lpf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="LX" source="Lcg" target="Lpf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="LX" source="Lpf" target="Lck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le8" value="Data8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="LX" source="Lck" target="Lgd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le9" value="Official" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="LX" source="Lck" target="Lwk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#A32620;" edge="1" parent="LX" source="Ld" target="Lcrm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le11" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="LX" source="Lgd" target="Lcrm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Le12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="LX" source="Lwk" target="Lcrm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="Lwarn" value="⚠ DirectData8 這條線繞過了 Profile、ConnectorKind 與所有治理層。&#10;　 產品又自己持有 CRM 憑證與連線 —— 等於回到現在 ToolUtility 的狀態。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=11;align=left;spacingLeft=10;fontColor=#7A1D18;" vertex="1" parent="LX">
          <mxGeometry x="24" y="812" width="330" height="52" as="geometry" /></mxCell>
        <mxCell id="Lnote" value="三個不同的 Pool 方塊 → 是三份實作，還是同一份掛在不同宿主？&#10;圖上看不出來。若是三份，就有三倍維護成本與三種洩漏風險。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;align=left;spacingLeft=10;fontColor=#5A3B00;" vertex="1" parent="LX">
          <mxGeometry x="380" y="812" width="390" height="52" as="geometry" /></mxCell>
        <mxCell id="Lnote2" value="ConnectorKind 讓 Data8 與 Official 成為長期並存的一等公民 →&#10;兩套傳輸都要維護、都要測、行為差異要持續比對。測試矩陣 ×2。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;fontSize=11;align=left;spacingLeft=10;fontColor=#5A3B00;" vertex="1" parent="LX">
          <mxGeometry x="24" y="960" width="746" height="46" as="geometry" /></mxCell>
        <mxCell id="Lnote3" value="開發體驗：LocalGateway 仍是獨立進程（要 profile、要起第二個進程）；&#10;DirectData8 雖然同進程，但走的是完全不同的路 → 開發測到的 ≠ 正式跑的。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=11;align=left;spacingLeft=10;fontColor=#7A1D18;" vertex="1" parent="LX">
          <mxGeometry x="24" y="1016" width="746" height="46" as="geometry" /></mxCell>

        <!-- ============ 右：我的 ============ -->
        <mxCell id="RX" value="我的設計" style="swimlane;html=1;startSize=34;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=15;fontStyle=1;fontColor=#12492E;" vertex="1" parent="1">
          <mxGeometry x="880" y="86" width="800" height="1090" as="geometry" /></mxCell>

        <mxCell id="Rp" value="產品（只給 ProfileAlias + Operation ID）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="RX">
          <mxGeometry x="250" y="48" width="300" height="42" as="geometry" /></mxCell>
        <mxCell id="Rpc" value="ProductClient（唯一入口）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=12;" vertex="1" parent="RX">
          <mxGeometry x="270" y="112" width="260" height="40" as="geometry" /></mxCell>

        <mxCell id="Rm" value="ExecutionMode&#10;（只決定「走不走 HTTP」）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=11;" vertex="1" parent="RX">
          <mxGeometry x="280" y="176" width="240" height="86" as="geometry" /></mxCell>

        <mxCell id="Remb" value="Embedded&#10;同進程直接呼叫&#10;★ VS 按 F5 就跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" vertex="1" parent="RX">
          <mxGeometry x="40" y="300" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="Rlg" value="Local Gateway&#10;獨立進程 · HTTP&#10;（要驗證邊界時用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=11;" vertex="1" parent="RX">
          <mxGeometry x="310" y="300" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="Rcg" value="Central Gateway&#10;共用服務 · HTTP&#10;（正式部署）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=11;" vertex="1" parent="RX">
          <mxGeometry x="580" y="300" width="180" height="60" as="geometry" /></mxCell>

        <mxCell id="Rband" value="★ 三條路在這裡匯合 —— 以下完全共用同一套程式碼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6D4;strokeColor=#1F7A4C;fontSize=12;fontStyle=1;fontColor=#12492E;" vertex="1" parent="RX">
          <mxGeometry x="40" y="392" width="720" height="34" as="geometry" /></mxCell>

        <mxCell id="Rcp" value="ControlPlane&#10;容量准入（有界佇列 · 併發號誌 · 每產品上限）&#10;Profile 世代管理（1 Active + 1 Draining · replace-and-drain）&#10;Operation Registry（只有註冊過的操作能執行）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="RX">
          <mxGeometry x="40" y="442" width="720" height="86" as="geometry" /></mxCell>

        <mxCell id="Rpool" value="ConnectionPool（唯一一份實作，per-Organization）" style="swimlane;html=1;startSize=28;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=12;fontStyle=1;" vertex="1" parent="RX">
          <mxGeometry x="40" y="560" width="720" height="180" as="geometry" /></mxCell>
        <mxCell id="Rp1" value="Pool: sunnyvalechback&#10;（9.1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=10;" vertex="1" parent="Rpool">
          <mxGeometry x="16" y="36" width="164" height="46" as="geometry" /></mxCell>
