          <mxGeometry x="192" y="36" width="164" height="46" as="geometry" /></mxCell>
        <mxCell id="Rp3" value="Pool: david / solomon…&#10;（9.1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=10;" vertex="1" parent="Rpool">
          <mxGeometry x="368" y="36" width="164" height="46" as="geometry" /></mxCell>
        <mxCell id="Rp4" value="Pool: jesus&#10;（8.2）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=10;" vertex="1" parent="Rpool">
          <mxGeometry x="544" y="36" width="160" height="46" as="geometry" /></mxCell>
        <mxCell id="Rpn" value="每個 Organization 一個池。借出 → 使用 → 歸還。&#10;Min/Max 池大小 · 閒置回收 · 健康檢查 · 確定性 Dispose（修好 IDisposable 之後）" style="text;html=1;fontSize=11;fontColor=#12492E;align=left;" vertex="1" parent="Rpool">
          <mxGeometry x="16" y="96" width="690" height="36" as="geometry" /></mxCell>
        <mxCell id="Rpret" value="↺　借出 ／ 歸還" style="text;html=1;fontSize=12;fontColor=#1F7A4C;align=center;fontStyle=1" vertex="1" parent="Rpool">
          <mxGeometry x="16" y="138" width="690" height="20" as="geometry" /></mxCell>

        <mxCell id="Rconn" value="Data8 連接器（單一傳輸實作 · MIT · 原始碼在 repo）&#10;crm82 → sdkVersion:8　　crm91 → sdkVersion:9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" vertex="1" parent="RX">
          <mxGeometry x="40" y="772" width="500" height="54" as="geometry" /></mxCell>
        <mxCell id="Rres" value="net48 官方 Worker&#10;【保留但停用】&#10;作為退路，不平行維護" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#999999;fontSize=10;dashed=1;fontColor=#777777;" vertex="1" parent="RX">
          <mxGeometry x="570" y="772" width="190" height="54" as="geometry" /></mxCell>

        <mxCell id="Rcrm" value="D365 8.2 ／ 9.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="RX">
          <mxGeometry x="190" y="860" width="200" height="46" as="geometry" /></mxCell>

        <mxCell id="Re1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="RX" source="Rp" target="Rpc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Re2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="RX" source="Rpc" target="Rm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Re3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#1F7A4C;" edge="1" parent="RX" source="Rm" target="Remb"><mxGeometry relative="1" as="geometry" /></mxCell>
