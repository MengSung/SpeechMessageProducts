        <mxCell id="Re7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F7A4C;" edge="1" parent="RX" source="Rlg" target="Rband"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Re8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#1F7A4C;" edge="1" parent="RX" source="Rcg" target="Rband"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Re9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" edge="1" parent="RX" source="Rband" target="Rcp"><mxGeometry relative="1" as="geometry" /></mxCell>
