  <diagram name="2 · 五個差異" id="p2">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="五個實質差異" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="700" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="先講相同的：兩者都採雙軸決策、都用 per-Organization Profile、都承認 Data8 是正當選項。Codex 已經吸收了前兩輪討論的修正。" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1300" height="18" as="geometry" /></mxCell>

        <mxCell id="h1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="1420" height="150" as="geometry" /></mxCell>
        <mxCell id="h1t" value="差異 1　DirectData8 是後門，不是模式　★ 我認為這是設計缺陷" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#7A1D18;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="h1a" value="Codex：產品 ──DirectData8──▶ 產品內 Data8 Pool ──▶ CRM&#10;　　　　　　　　　　　　　　（繞過 Profile、繞過 ConnectorKind、繞過 ControlPlane）&#10;&#10;後果：產品又自己持有 CRM 憑證與連線 → 回到現在 ToolUtility 的狀態。&#10;　　　沒有容量准入、沒有操作白名單、沒有世代管理、沒有集中稽核。" style="text;html=1;fontSize=12;fontColor=#7A1D18;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="128" width="680" height="96" as="geometry" /></mxCell>
        <mxCell id="h1b" value="我的：產品 ──Embedded──▶ ControlPlane ──▶ Pool ──▶ CRM&#10;　　　　　　　　　　　（同進程，但治理層一個都不少）&#10;&#10;差別：Embedded 省掉的只有「HTTP 那一跳」，不是省掉治理。&#10;　　　開發時測到的行為，跟正式環境完全一致。" style="text;html=1;fontSize=12;fontColor=#12492E;align=left;" vertex="1" parent="1">
          <mxGeometry x="770" y="128" width="680" height="96" as="geometry" /></mxCell>

        <mxCell id="h2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;" vertex="1" parent="1">
          <mxGeometry x="40" y="252" width="1420" height="130" as="geometry" /></mxCell>
        <mxCell id="h2t" value="差異 2　Pool 是三份還是一份？" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#5A3B00;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="266" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="h2a" value="Codex 圖上有三個 Pool 方塊：&#10;· 產品內 Data8 Pool&#10;· Gateway 內 Data8 Pool&#10;· net48 Worker Process Pool&#10;&#10;圖上看不出是三份實作還是同一份。若是三份 → 三倍維護、三種洩漏風險。" style="text;html=1;fontSize=12;fontColor=#5A3B00;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="294" width="680" height="80" as="geometry" /></mxCell>
        <mxCell id="h2b" value="我的：只有一份 Pool 實作。&#10;&#10;它被掛進不同的宿主（產品進程 / Local Gateway 進程 / Central Gateway 進程），&#10;但程式碼是同一份、生命週期規則是同一套、洩漏測試也只要寫一次。&#10;&#10;宿主換了，池不變。" style="text;html=1;fontSize=12;fontColor=#12492E;align=left;" vertex="1" parent="1">
          <mxGeometry x="770" y="294" width="680" height="80" as="geometry" /></mxCell>

        <mxCell id="h3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAEDD4;strokeColor=#8A5A00;" vertex="1" parent="1">
          <mxGeometry x="40" y="398" width="1420" height="130" as="geometry" /></mxCell>
        <mxCell id="h3t" value="差異 3　兩種傳輸長期並存，還是選一個？" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#5A3B00;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="412" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="h3a" value="Codex：ConnectorKind 是執行期可切換的選項 → Data8 與 Official 都是一等公民。&#10;&#10;代價：兩套傳輸都要維護、都要測試、行為差異要持續比對。&#10;測試矩陣 ＝ 2 × Organization 數 × Operation 數。&#10;以你 5 個 Organization 來算，成本會明顯放大。" style="text;html=1;fontSize=12;fontColor=#5A3B00;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="680" height="80" as="geometry" /></mxCell>
        <mxCell id="h3b" value="我的：選 Data8 為唯一傳輸。net48 官方 Worker「保留但停用」。&#10;&#10;它是退路，不是平行維護的選項 —— 程式碼留著（萬一要回頭），&#10;但不進 CI、不寫平行測試、不承諾行為一致。&#10;測試矩陣 ＝ 1 × Organization 數 × Operation 數。" style="text;html=1;fontSize=12;fontColor=#12492E;align=left;" vertex="1" parent="1">
          <mxGeometry x="770" y="440" width="680" height="80" as="geometry" /></mxCell>

        <mxCell id="h4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;" vertex="1" parent="1">
          <mxGeometry x="40" y="544" width="1420" height="130" as="geometry" /></mxCell>
        <mxCell id="h4t" value="差異 4　F5 開發體驗" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#7A1D18;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="558" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="h4a" value="Codex 的兩個選擇都不理想：&#10;&#10;· LocalGateway → 仍是獨立進程，要 profile、要起第二個進程&#10;· DirectData8 → 同進程很方便，但走完全不同的路&#10;&#10;⚠ 這正是當初否定 Embedded 的理由（「開發測的 ≠ 正式跑的」），現在換個名字回來了。" style="text;html=1;fontSize=12;fontColor=#7A1D18;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="586" width="680" height="82" as="geometry" /></mxCell>
        <mxCell id="h4b" value="我的：Embedded 同時滿足兩件事。&#10;&#10;· 同進程 → VS 按 F5 直接跑，沿用既有 CrmConnection 設定&#10;· 完整治理 → 走的是跟正式環境同一套 ControlPlane 與 Pool&#10;&#10;要驗證 HTTP 邊界時，改設定切成 Local Gateway 跑一次即可。" style="text;html=1;fontSize=12;fontColor=#12492E;align=left;" vertex="1" parent="1">
          <mxGeometry x="770" y="586" width="680" height="82" as="geometry" /></mxCell>

        <mxCell id="h5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="1420" height="106" as="geometry" /></mxCell>
        <mxCell id="h5t" value="差異 5　沒有畫出「歸還」" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#3A4152;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="704" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="h5a" value="Codex 的圖全部是單向箭頭，看不出借出 → 使用 → 歸還的循環。&#10;&#10;這比較是表達問題，但你把「用完以後就還回來」列為三個必要條件之一，&#10;圖上應該看得見它。" style="text;html=1;fontSize=12;fontColor=#3A4152;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="732" width="1380" height="56" as="geometry" /></mxCell>

        <mxCell id="cc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="816" width="1420" height="200" as="geometry" /></mxCell>
        <mxCell id="cct" value="結論：差距比看起來小，但差異 1 必須修" style="text;html=1;fontSize=17;fontStyle=1;fontColor=#12492E;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="832" width="900" height="26" as="geometry" /></mxCell>
        <mxCell id="ccb" value="Codex 這一版已經收斂了很多：雙軸框架、per-Organization Profile、承認 Data8 是正當選項 —— 這三點跟我一致。&#10;&#10;真正需要修的只有一個：把 DirectData8 從「繞過治理的後門」改成「同進程但走完整治理的 Embedded」。&#10;這個改動不大，但它決定了「開發時測到的東西能不能代表正式環境」。&#10;&#10;其餘三項（一份 Pool、選一種傳輸、畫出歸還）是取捨與表達問題，可以討論，不是對錯。&#10;&#10;如果 Codex 願意改差異 1，其他都可以接受 —— 我不堅持要用我的版本。" style="text;html=1;fontSize=13;fontColor=#12492E;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="862" width="1380" height="140" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
