  <diagram name="4 · 驗證狀態與路線演進" id="p4">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="驗證狀態與路線演進" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="800" height="34" as="geometry" /></mxCell>

        <mxCell id="v1" value="v1 · 07-23　完全禁用 SDK&#10;&#10;純 HTTP / OData v4&#10;移除所有 Microsoft.Xrm / CrmSdk&#10;&#10;產出 WebApi 專案（41 檔）&#10;→ 已於 08-02 全數刪除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="370" height="170" as="geometry" /></mxCell>
        <mxCell id="v2" value="v2 · 07-29　官方優先 + Central/Local&#10;&#10;判準改為「是不是微軟官方」&#10;Embedded → Local Gateway&#10;&#10;產出 SPEC 63KB + 說明書 84KB&#10;Gateway 授權層 / SQL 協調器&#10;→ 授權層與協調器保留至今" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="370" height="170" as="geometry" /></mxCell>
        <mxCell id="v3" value="v3 · 08-02～03　官方 NuGet Worker（現行）&#10;&#10;官方 CrmServiceClient 關在 net48 進程&#10;具名管道 IPC · 版本鎖定分離&#10;&#10;15 個專案 · 159 檔&#10;本輪新增：Package01 業務操作落地&#10;Worker 回收政策 · 資源觀測 · Soak 測試" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="400" height="170" as="geometry" /></mxCell>

        <mxCell id="ar1" value="卡住：CE on-prem 服務身分權杖&#10;可能不存在" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ar2" value="卡住：需管理員身分註冊&#10;ADFS client，停滯 17.5 小時" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="key" value="★ v3 解開僵局的原因：CrmServiceClient 走 IFD / WS-Trust —— 跟現有 legacy SOAP 是同一條認證路徑。&#10;　 不需要新的 ADFS client 註冊，也就不需要那個一直打不開的管理通道。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=13;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1220" height="60" as="geometry" /></mxCell>

        <mxCell id="gs" value="驗證狀態（2026-08-03 07:05 實跑 dotnet test）" style="swimlane;html=1;startSize=30;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="1220" height="300" as="geometry" /></mxCell>
        <mxCell id="gs1" value="✔ 409 項通過&#10;契約 · 授權 · 容量 · 世代管理 · Worker 協定 · Package01 投影 · 回收政策 · 部署疊加" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="gs">
          <mxGeometry x="20" y="42" width="1180" height="52" as="geometry" /></mxCell>
        <mxCell id="gs2" value="✘ 1 項失敗　OfficialWorkerSoakAndPerformanceTests.WorkerSoak_repeated_package01_recycle_returns_all_owners_to_zero_without_unbounded_trends&#10;「within-generation private bytes must not show a material monotonic post-warm-up trend, but found True」&#10;→ 這不是佔位測試，是 Soak 真的偵測到世代內記憶體持續成長。屬於必須查清的實質問題。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="gs">
          <mxGeometry x="20" y="106" width="1180" height="76" as="geometry" /></mxCell>
        <mxCell id="gs3" value="⚠ 7 項略過　全部是 Live_sql_*（需真實 SQL 實例）&#10;跨進程容量 · 優雅收斂 · 協調器斷線 · 崩潰隔離 · fencing 失效 · nonce 綁定 · 多擁有者共享&#10;→ 持久化協調器正確性目前零驗證。你有 LocalDB，不需新權限即可跑。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="gs">
          <mxGeometry x="20" y="194" width="1180" height="76" as="geometry" /></mxCell>

        <mxCell id="rem" value="仍未改變的四件事（11 天來一致）" style="swimlane;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1220" height="180" as="geometry" /></mxCell>
        <mxCell id="r1" value="① 真機 CRM 驗證 0%　　官方 worker 全鏈路尚無任何真實 CE 連線證據" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="rem">
          <mxGeometry x="20" y="42" width="1180" height="30" as="geometry" /></mxCell>
        <mxCell id="r2" value="② Package01FeeReadsEnabled = false　　所有讀取仍走 legacy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="rem">
          <mxGeometry x="20" y="78" width="1180" height="30" as="geometry" /></mxCell>
        <mxCell id="r3" value="③ Data8 PowerPlatform.Dataverse.Client 仍在 sln，ToolUtility 仍在使用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="rem">
          <mxGeometry x="20" y="114" width="1180" height="30" as="geometry" /></mxCell>
        <mxCell id="r4" value="④ ChurchReport 的 Microsoft.Crm.Sdk.Proxy HintPath 2 處仍在" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="rem">
          <mxGeometry x="20" y="150" width="1180" height="26" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

