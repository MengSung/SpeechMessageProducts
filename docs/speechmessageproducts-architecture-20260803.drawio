  <diagram name="3 · 一次 Package01 請求的旅程" id="p3">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="一次「查詢奉獻費用」的完整旅程" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="s" value="綠 = 已由 409 項通過測試涵蓋　　黃 = 已實作但未真機驗證　　紅 = 現行實際路徑 / 未打通" style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="18" as="geometry" /></mxCell>

        <mxCell id="f1" value="① 使用者在 ChurchReport 開啟「奉獻收費清單」" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="415" y="86" width="450" height="44" as="geometry" /></mxCell>
        <mxCell id="fg" value="Package01FeeReadsEnabled ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="158" width="300" height="72" as="geometry" /></mxCell>
        <mxCell id="fl" value="false（目前值）&#10;→ ToolUtility → Data8 → WS-Trust / SOAP → CE 8.2&#10;★ 這是現在真正在跑的路徑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="164" width="360" height="60" as="geometry" /></mxCell>

        <mxCell id="f2" value="② ProductClient 組請求：Operation ID + 具名參數（contactId、起訖日）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="258" width="450" height="44" as="geometry" /></mxCell>
        <mxCell id="f3" value="③ HTTP POST → Gateway&#10;/v1/organizations/{alias}/operations/{capabilityOperationId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="330" width="450" height="48" as="geometry" /></mxCell>
        <mxCell id="f4" value="④ Windows Negotiate 驗證　未驗證 → 401（在讀 body 之前）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="406" width="450" height="44" as="geometry" /></mxCell>
        <mxCell id="f5" value="⑤ WorkloadBindingSet 授權　alias / operation 未授權 → 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="478" width="450" height="44" as="geometry" /></mxCell>
        <mxCell id="f6" value="⑥ ControlPlane 容量准入&#10;排隊 → 取得 Permit。佇列滿 / 超封包上限 / 逾期 → 拒絕&#10;★ 排隊期間不持有連線物件，舊世代可正常收斂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="395" y="550" width="490" height="62" as="geometry" /></mxCell>
        <mxCell id="f7" value="⑦ 取得 Host Slot 租約（InMemory 或 SQL）&#10;⚠ SQL 版 7 項 live 測試全部 SKIP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="640" width="450" height="48" as="geometry" /></mxCell>
        <mxCell id="f8" value="⑧ 解析當下 Active Profile 世代 → 取得 Execution Lease" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="716" width="450" height="44" as="geometry" /></mxCell>
        <mxCell id="f9" value="⑨ WorkerSupervisor 依 profile 挑 worker&#10;檢查回收政策：資源觀測是否已觸發需要重啟" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="788" width="450" height="48" as="geometry" /></mxCell>
        <mxCell id="f10" value="⑩ 序列化成 Package01FeeWorkerContract → WorkerRequestV1&#10;WorkerEnvelopeValidator 檢查大小 / 版本 / 型別 → 具名管道送出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="395" y="864" width="490" height="48" as="geometry" /></mxCell>

        <mxCell id="f11" value="⑪ 進程邊界" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="945" width="240" height="64" as="geometry" /></mxCell>
        <mxCell id="f12a" value="Crm82Worker（net48）&#10;Package01FeeQueryOperation&#10;→ CrmServiceClient（官方 8.2.0.5）&#10;→ IOrganizationService → CE 8.2 IFD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="1055" width="310" height="86" as="geometry" /></mxCell>
        <mxCell id="f12b" value="Crm91Worker（net48）&#10;Package01FeeQueryOperation&#10;→ CrmServiceClient（官方 9.1.1.65）&#10;→ IOrganizationService → CE 9.1 IFD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="1055" width="310" height="86" as="geometry" /></mxCell>
        <mxCell id="f12c" value="憑證：Windows 認證管理員（DPAPI）&#10;子行程環境由 ProcessEnvironment 隔離&#10;結果超過上限 → ResultLimitExceeded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="1055" width="340" height="66" as="geometry" /></mxCell>

        <mxCell id="f13" value="⑫ WorkerResponseV1 回傳&#10;Package01FeeWorkerResponseProjector → 產品 DTO&#10;★ 不得洩漏 CRM 真實 hostname / endpoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="395" y="1190" width="490" height="62" as="geometry" /></mxCell>
        <mxCell id="f14" value="⑬ 釋放 Execution Lease → 釋放 Admission Permit&#10;⑭ 依回收政策決定 worker 進程是否重啟&#10;★ 中途例外時各自獨立清理並彙總回報" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="395" y="1285" width="490" height="62" as="geometry" /></mxCell>
        <mxCell id="f15" value="⚠ Soak 測試目前在這一段抓到問題：重複 Package01 + 回收之後，世代內 private bytes 呈現持續單調成長。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="395" y="1375" width="490" height="52" as="geometry" /></mxCell>

