          <mxGeometry x="16" y="208" width="518" height="20" as="geometry" /></mxCell>

        <mxCell id="w91" value="Crm91Worker · 4　＋　Crm91Worker.Tests · 3　【net48 獨立進程】" style="swimlane;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
