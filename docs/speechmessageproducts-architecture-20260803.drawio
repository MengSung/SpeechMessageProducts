          <mxGeometry x="16" y="36" width="350" height="56" as="geometry" /></mxCell>
        <mxCell id="gw2" value="Security/&#10;ConfigurationGatewayOperationAuthorizer&#10;GatewayWorkloadBinding → alias/operation 授權，否則 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="378" y="36" width="360" height="56" as="geometry" /></mxCell>
        <mxCell id="gw3" value="OfficialWorkerDeploymentConfiguration【新】&#10;綁定 worker 執行檔路徑與雜湊&#10;RequestLimits/ · ReadinessService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="gw">
          <mxGeometry x="750" y="36" width="354" height="56" as="geometry" /></mxCell>

        <mxCell id="cp" value="ControlPlane · 26（net10）　容量與世代治理" style="swimlane;html=1;startSize=28;fillColor=#cfe2f3;strokeColor=#3d6ea5;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="435" width="1120" height="150" as="geometry" /></mxCell>
        <mxCell id="cp1" value="Capacity/　12 檔&#10;OrganizationAdmissionManager　有界佇列 · 併發號誌 · 每工作負載上限&#10;CapacityKeys · AdmissionPlan · InMemory / SQL HostSlotCoordinator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cp">
          <mxGeometry x="16" y="36" width="540" height="64" as="geometry" /></mxCell>
        <mxCell id="cp2" value="Runtime/　13 檔&#10;DynamicsProfileRuntimeManager　每 alias 最多 1 Active + 1 Draining&#10;ControlledOperationExecutor · ProfileRoutedOperationExecutor · DispatchPreparer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d6ea5;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="cp">
          <mxGeometry x="568" y="36" width="536" height="64" as="geometry" /></mxCell>
        <mxCell id="cp3" value="⚠ SQL 協調器 7 項 live 測試全部 SKIP（需真實 SQL 實例）—— 持久化跨進程容量保證目前零驗證。" style="text;html=1;fontSize=11;fontColor=#8a6d00;align=left;" vertex="1" parent="cp">
          <mxGeometry x="16" y="110" width="1080" height="20" as="geometry" /></mxCell>

        <mxCell id="sup" value="WorkerSupervisor · 11（net10）　Worker 派工、回收與觀測　【本輪從 4 檔擴充到 11 檔】" style="swimlane;html=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="615" width="1120" height="180" as="geometry" /></mxCell>
        <mxCell id="sp1" value="OfficialWorkerProfileExecutor&#10;依 profile 挑 8.2 或 9.1 worker 並派工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sup">
          <mxGeometry x="16" y="36" width="352" height="48" as="geometry" /></mxCell>
        <mxCell id="sp2" value="OfficialWorkerRecyclePolicy + Options + Reason【新】&#10;依資源觀測決定何時回收 worker 進程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sup">
          <mxGeometry x="380" y="36" width="352" height="48" as="geometry" /></mxCell>
        <mxCell id="sp3" value="OfficialWorkerResourceObservation【新】&#10;private bytes / handles / threads / p95 觀測" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sup">
          <mxGeometry x="744" y="36" width="360" height="48" as="geometry" /></mxCell>
        <mxCell id="sp4" value="OfficialWorkerProcessEnvironment【新】&#10;子行程環境變數隔離" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sup">
          <mxGeometry x="16" y="96" width="352" height="48" as="geometry" /></mxCell>
        <mxCell id="sp5" value="Package01FeeWorkerResponseProjector【新】&#10;Worker 回應 → 產品 DTO 投影" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="sup">
          <mxGeometry x="380" y="96" width="352" height="48" as="geometry" /></mxCell>
        <mxCell id="sp6" value="LifecycleSnapshot · Version · StartupException【新】&#10;可觀測狀態 / 執行檔版本綁定 / 啟動失敗分類" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sup">
          <mxGeometry x="744" y="96" width="360" height="48" as="geometry" /></mxCell>

        <mxCell id="br" value="跨框架橋接層【netstandard2.0】　★ 唯一能同時被 net48 與 net10 參考的目標框架" style="swimlane;html=1;startSize=28;fillColor=#e8f4ea;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="825" width="1120" height="185" as="geometry" /></mxCell>
        <mxCell id="br1" value="WorkerProtocol · 19　IPC 契約（純資料 + 驗證，零 SDK 相依）&#10;WorkerRequestV1 / ResponseV1 / ReadyV1 / DrainV1&#10;WorkerFrameCodec · EnvelopeCodec · Validators · ProtocolLimits · Version&#10;Package01FeeWorkerContract【新】　業務操作的線上格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="br">
          <mxGeometry x="16" y="36" width="540" height="88" as="geometry" /></mxCell>
        <mxCell id="br2" value="WorkerHost · 19　進程宿主與傳輸&#10;NamedPipeOfficialWorkerConnector（具名管道）&#10;OfficialWorkerProcessHost / Session / ExitCode&#10;WindowsCredentialManagerProvider　★ 憑證來自 Windows 認證管理員&#10;OfficialWorkerResultLimitExceededException【新】　結果大小上限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="br">
          <mxGeometry x="568" y="36" width="536" height="88" as="geometry" /></mxCell>
        <mxCell id="br3" value="IOfficialCrmClient / IOfficialCrmClientFactory —— 介面在此、實作在各 worker，所以橋接層本身不相依任何 CRM SDK。" style="text;html=1;fontSize=11;fontColor=#2d6b3f;align=left;" vertex="1" parent="br">
          <mxGeometry x="16" y="132" width="1080" height="20" as="geometry" /></mxCell>

        <mxCell id="w82" value="Crm82Worker · 4　＋　Crm82Worker.Tests · 3　【net48 獨立進程】" style="swimlane;html=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="1040" width="550" height="245" as="geometry" /></mxCell>
        <mxCell id="w82a" value="Program.cs　進程進入點 / 管道連線&#10;OfficialCrmServiceClientFactory　建立 CrmServiceClient&#10;OfficialCrmServiceClientAdapter　包成 IOfficialCrmClient&#10;Package01FeeQueryOperation【新】　真正的業務查詢" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="w82">
          <mxGeometry x="16" y="36" width="518" height="76" as="geometry" /></mxCell>
