  <diagram name="1 · 你的理解 vs 實際" id="e1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;fontSize=26;fontStyle=1;align=left;" value="Gateway 到底是什麼？" vertex="1">
          <mxGeometry height="36" width="800" x="40" y="14" as="geometry" />
        </mxCell>
        <mxCell id="s" parent="1" style="text;html=1;fontSize=13;fontColor=#666666;align=left;" value="你的理解有一半對、一半錯。錯的那一半很自然 —— 因為 Gateway 這個字在日常用語裡就是「通往某處的門」。" vertex="1">
          <mxGeometry height="20" width="1300" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="wrongbox" parent="1" style="swimlane;html=1;startSize=36;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=16;fontStyle=1;fontColor=#7A1D18;" value="你以為的（❌ 不正確）" vertex="1">
          <mxGeometry height="330" width="680" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="w1" parent="wrongbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" value="產品" vertex="1">
          <mxGeometry height="46" width="160" x="260" y="56" as="geometry" />
        </mxCell>
        <mxCell id="w2" parent="wrongbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=13;fontStyle=1;" value="Gateway&#xa;（以為它會連 D365）" vertex="1">
          <mxGeometry height="60" width="200" x="240" y="146" as="geometry" />
        </mxCell>
        <mxCell id="w3" parent="wrongbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" value="D365" vertex="1">
          <mxGeometry height="46" width="160" x="260" y="250" as="geometry" />
        </mxCell>
        <mxCell id="we1" edge="1" parent="wrongbox" source="w1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" target="w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we2" edge="1" parent="wrongbox" source="w2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#A32620;fontSize=11;" target="w3" value="以為是這裡連線">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wn" parent="wrongbox" style="text;html=1;fontSize=12;fontColor=#7A1D18;align=left;" value="這個模型裡，Gateway 是「通往 D365 的門」，&#xa;所以 Central／Dedicated 看起來像「兩種不同的門」。" vertex="1">
          <mxGeometry height="24" width="640" x="20" y="298" as="geometry" />
        </mxCell>
        <mxCell id="rightbox" parent="1" style="swimlane;html=1;startSize=36;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=16;fontStyle=1;fontColor=#12492E;" value="實際上（✔ 正確）" vertex="1">
          <mxGeometry height="330" width="700" x="760" y="90" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="rightbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=1;" value="產品" vertex="1">
          <mxGeometry height="36" width="160" x="270" y="48" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="rightbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE9F7;strokeColor=#1F5FA8;fontSize=12;fontStyle=1;" value="Gateway　＝　大門（收發室）&#xa;驗身分 · 查權限 · 限大小　★ 不碰 D365" vertex="1">
          <mxGeometry height="44" width="400" x="150" y="100" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="rightbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#3d6ea5;fontSize=12;fontStyle=1;" value="ControlPlane　＝　管理制度&#xa;誰能做什麼 · 同時幾個 · 用哪一代設定　★ 不碰 D365" vertex="1">
          <mxGeometry height="44" width="400" x="150" y="160" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="rightbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=12;fontStyle=1;" value="Data8 Connector　＝　真正的工人&#xa;★ 只有這一層真的連到 D365" vertex="1">
          <mxGeometry height="44" width="400" x="150" y="220" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="rightbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=1;" value="D365" vertex="1">
          <mxGeometry height="36" width="160" x="270" y="280" as="geometry" />
        </mxCell>
        <mxCell id="re1" edge="1" parent="rightbox" source="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" edge="1" parent="rightbox" source="r2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" edge="1" parent="rightbox" source="r3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" edge="1" parent="rightbox" source="r4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=3;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" target="r5" value="借出 ↺ 歸還">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="proof" parent="1" style="swimlane;html=1;startSize=34;fillColor=#ffffff;strokeColor=#666666;fontSize=15;fontStyle=1;" value="程式碼證據（我剛剛在你的 repo 實查）" vertex="1">
          <mxGeometry height="230" width="1420" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="pf1" parent="proof" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE9F7;strokeColor=#1F5FA8;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontFamily=Consolas;" value="SpeechMessage.Dynamics.Gateway　11 個 .cs&#xa;&#xa;Program.cs　　　　　　　　　　HTTP 端點與啟動&#xa;Security/　3 檔　　　　　　　　誰能用哪個 alias、能跑哪個 operation&#xa;RequestLimits/　2 檔　　　　　 請求大小上限&#xa;DynamicsGatewayReadinessService　就緒檢查&#xa;DedicatedGateway*　3 檔　　　　啟動時讀設定，把 Data8 註冊進 DI&#xa;OfficialWorkerDeploymentConfiguration　Worker 執行檔雜湊綁定&#xa;&#xa;搜尋 IOrganizationService／CrmServiceClient／Organization.svc&#xa;→ 只有 1 個檔案命中，而且它只是「讀設定」，不是「連線」" vertex="1">
          <mxGeometry height="170" width="680" x="18" y="42" as="geometry" />
        </mxCell>
        <mxCell id="pf2" parent="proof" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontFamily=Consolas;" value="SpeechMessage.Dynamics.Connectors.Data8　7 個 .cs&#xa;&#xa;OnPremiseData8ConnectorClientFactory　★ 真正建立 D365 連線&#xa;Data8ConnectorPool　　　　　　　　　　連線池（借出／歸還／淘汰）&#xa;Data8ConnectorPoolRegistry　　　　　　每個 Organization 一個池&#xa;Data8ConnectorRouter　　　　　　　　　依 Profile 選 Connector&#xa;Data8ProfileOperationExecutor　　　　 執行操作&#xa;Data8ProfileRuntime　　　　　　　　　 世代化執行環境&#xa;IData8ConnectorClientFactory　　　　　工廠介面&#xa;&#xa;★ 這裡才是「連到 D365 的地方」" vertex="1">
          <mxGeometry height="170" width="688" x="714" y="42" as="geometry" />
        </mxCell>
        <mxCell id="key" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6D4;strokeColor=#1F7A4C;strokeWidth=3;fontSize=18;fontStyle=1;fontColor=#12492E;" value="一句話：Gateway 是「大門」，不是「路」。Data8 才是路。" vertex="1">
          <mxGeometry height="60" width="1420" x="40" y="710" as="geometry" />
        </mxCell>
        <mxCell id="keyn" parent="1" style="text;html=1;fontSize=13;fontColor=#12492E;align=center;" value="所以 Central Gateway 與 Dedicated Gateway 不是「兩種不同的連線方式」——&#xa;它們是「同一個大門程式，擺在不同位置」。不論擺在哪，門後面走的路都是同一條 Data8。" vertex="1">
          <mxGeometry height="46" width="1420" x="40" y="782" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · 三種模式的實際呼叫路徑" id="e3">
