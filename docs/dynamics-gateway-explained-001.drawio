          <mxGeometry height="32" width="438" x="16" y="440" as="geometry" />
        </mxCell>
        <mxCell id="C8" parent="C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;fontStyle=1;" value="Data8ConnectorPool　多產品共用" vertex="1">
          <mxGeometry height="32" width="438" x="16" y="492" as="geometry" />
        </mxCell>
        <mxCell id="C9" parent="C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=11;" value="OnPremiseClient（WS-Trust）" vertex="1">
          <mxGeometry height="32" width="438" x="16" y="544" as="geometry" />
        </mxCell>
        <mxCell id="C10" parent="C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontStyle=1;" value="D365　5 個 Organization" vertex="1">
          <mxGeometry height="32" width="438" x="16" y="596" as="geometry" />
        </mxCell>
        <mxCell id="Cn" parent="C" style="text;html=1;fontSize=11;fontColor=#555555;align=left;" value="★ 跟 ② 完全一樣，只差 Endpoint 指向&#xa;　 共用服務，而且連線池被多個產品共用。" vertex="1">
          <mxGeometry height="40" width="438" x="16" y="638" as="geometry" />
        </mxCell>
        <mxCell id="fin" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6D4;strokeColor=#1F7A4C;strokeWidth=3;fontSize=16;fontStyle=1;fontColor=#12492E;" value="三欄從「RequestGuard」以下完全相同 —— 那是同一份程式碼。差別只在上面那三格：走不走 HTTP、走到哪裡。" vertex="1">
          <mxGeometry height="50" width="1480" x="40" y="965" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 · 常見誤解澄清" id="e4">
    <mxGraphModel dx="1515" dy="858" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;fontSize=26;fontStyle=1;align=left;" value="常見誤解澄清" vertex="1">
          <mxGeometry height="36" width="800" x="40" y="14" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" value="Q1　Gateway 是連到 D365 的東西嗎？" vertex="1">
          <mxGeometry height="34" width="1320" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" value="不是。Gateway 是「產品跟共用核心之間的 HTTP 大門」——它驗身分、查權限、限制大小，然後把工作交給後面的層。&#xa;真正連 D365 的是 Connectors.Data8（或未來的 Official Worker）。Gateway 專案 11 個檔案裡，零個含連線程式碼。" vertex="1">
          <mxGeometry height="56" width="1320" x="40" y="108" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" value="Q2　Central Gateway 跟 Dedicated Gateway 是兩支不同的程式嗎？" vertex="1">
          <mxGeometry height="34" width="1320" x="40" y="184" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" value="不是。是同一支 SpeechMessage.Dynamics.Gateway.exe，擺在不同位置、服務不同數量的產品。&#xa;程式碼裡沒有 CentralGateway 類別，也沒有 DedicatedGateway 類別 —— 差別只在部署與設定。" vertex="1">
          <mxGeometry height="56" width="1320" x="40" y="222" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" value="Q3　Data8 跟 Gateway 是競爭關係、二選一嗎？" vertex="1">
          <mxGeometry height="34" width="1320" x="40" y="298" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" value="不是。它們在不同層，是上下關係，不是左右關係。&#xa;Gateway 在上（大門），Data8 在下（真正做事）。三種 ConnectionMode 底下都是 Data8 在連 D365。&#xa;真正跟 Data8 二選一的是 Official Worker —— 那才是同一層的替代品（ConnectorKind）。" vertex="1">
          <mxGeometry height="68" width="1320" x="40" y="336" as="geometry" />
        </mxCell>
        <mxCell id="q4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" value="Q4　Embedded 模式沒有 Gateway，那它怎麼驗身分、限流量？" vertex="1">
          <mxGeometry height="34" width="1320" x="40" y="424" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#79839A;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;" value="Embedded 省掉的只有「HTTP 那一跳」與「跨進程的身分驗證」，其餘一項都沒省。&#xa;RequestGuard、ProfileResolver、AdmissionControl、世代管理、連線池 —— 全部照走，而且是同一份程式碼。&#xa;（跨進程身分驗證在同進程沒有意義：呼叫者就是產品自己。）" vertex="1">
          <mxGeometry height="68" width="1320" x="40" y="462" as="geometry" />
        </mxCell>
        <mxCell id="q5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F4;strokeColor=#79839A;fontSize=14;fontStyle=1;align=left;spacingLeft=14;" value="Q5　那我現在的產品到底走哪一條？" vertex="1">
          <mxGeometry height="34" width="1320" x="40" y="550" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDD;strokeColor=#A32620;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=8;fontColor=#7A1D18;" value="都不走。Package01FeeReadsEnabled 目前是 false，所以產品讀取仍走 15 天前那條 legacy 路徑：&#xa;　　ChurchReport → ToolUtility → Data8（舊的、非池化的用法）→ D365&#xa;上面畫的三種新路徑都已經蓋好、測試綠燈，但還沒承載任何產品流量。這就是 P7 要做的事。" vertex="1">
          <mxGeometry height="68" width="1320" x="40" y="588" as="geometry" />
        </mxCell>
        <mxCell id="sum" parent="1" style="swimlane;html=1;startSize=32;fillColor=#ffffff;strokeColor=#1F7A4C;strokeWidth=2;fontSize=15;fontStyle=1;" value="三個名詞的正確關係" vertex="1">
          <mxGeometry height="150" width="1320" x="40" y="680" as="geometry" />
        </mxCell>
        <mxCell id="sm1" parent="sum" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE9F7;strokeColor=#1F5FA8;fontSize=12;align=left;spacingLeft=14;" value="Central Gateway ／ Dedicated Gateway ／ Embedded&#xa;→ 同一個維度（ConnectionMode）的三個選項：共用核心跑在哪個進程" vertex="1">
          <mxGeometry height="44" width="1284" x="18" y="42" as="geometry" />
        </mxCell>
        <mxCell id="sm2" parent="sum" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEFE3;strokeColor=#1F7A4C;fontSize=12;align=left;spacingLeft=14;" value="Data8 ／ OfficialCrm82Worker ／ OfficialCrm91Worker&#xa;→ 另一個維度（ConnectorKind）的三個選項：用什麼技術真的打到 D365" vertex="1">
          <mxGeometry height="44" width="1284" x="18" y="94" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
