+// 只接受明確分類，歷史紀錄中提到的 Warning／失敗不會被當作目前阻擋。
+// 所有文字皆跳脫後插入；分類只從固定白名單選取，避免資料成為 HTML 屬性。
+function renderNotice(notice, actions = "") {
+  const level = ["info", "warn", "error"].includes(notice.level) ? notice.level : "info";
+  const label = { info: "一般資訊", warn: "注意事項", error: "錯誤／阻擋" }[level];
+  const icon = ICON[level === "error" ? "alert" : level];
+  const heading = `<span class="notice-heading">${icon}<span><span class="notice-label">${label}</span>${esc(notice.title || "")}</span></span>`;
+  const steps = Array.isArray(notice.steps) ? notice.steps : [];
+  const content = `<div class="notice-content">${notice.body ? `<p>${esc(notice.body)}</p>` : ""}
+    ${steps.length ? `<ol>${steps.map(s => `<li>${esc(s)}</li>`).join("")}</ol>` : ""}${actions}</div>`;
+  const toggle = '<span class="notice-toggle" aria-hidden="true"></span>';
+  if (level === "info") {
+    return `<details class="notice info"><summary>${heading}${toggle}</summary>${content}</details>`;
+  }
+  return `<article class="notice ${level}" role="${level === "error" ? "alert" : "status"}">${heading}
+    <details class="notice-details"><summary>查看詳細資訊${toggle}</summary>${content}</details></article>`;
+}
+
+const noticesRegion = document.getElementById("notices");
+const notices = Array.isArray(D.notices)
+  ? D.notices.filter(notice => notice && typeof notice === "object" && !Array.isArray(notice)) : [];
+noticesRegion.hidden = notices.length === 0;
+noticesRegion.innerHTML = notices.map(notice => renderNotice(notice)).join("");
+
