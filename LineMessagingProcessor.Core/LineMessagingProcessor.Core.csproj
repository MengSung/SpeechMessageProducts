<!--
檔案整體說明

目的與定位：定義跨目標LINE傳輸、Flex範本與sender政策的MSBuild專案邊界，集中target、套件及向下參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net462;net10.0；條件評估後的實際輸出以MSBuild為準。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <!-- SDK 在 targets 之前決定 XML 文件輸出；嚴格開關與文件開關必須同在專案本體。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Line.Messaging/Line.Messaging.csproj" />
    <ProjectReference Include="../SpeechMessage.Localization/SpeechMessage.Localization.csproj" />
    <PackageReference Include="Newtonsoft.Json" />
    <InternalsVisibleTo Include="LineMessagingProcessor.Tests" />
    <InternalsVisibleTo Include="SpeechMessage.Dynamics.Plugins.Tests" />
    <InternalsVisibleTo Include="SpeechMessageProducts.GoodShepherd.Core.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
