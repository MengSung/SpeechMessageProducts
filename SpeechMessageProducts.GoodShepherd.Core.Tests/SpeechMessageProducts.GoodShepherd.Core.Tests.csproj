<!--
檔案整體說明

目的與定位：定義 GoodShepherd.Core 的雙目標 smoke 與後續產品規則測試邊界。
測試宿主使用 net48 與 net10.0，但產品參考在 net48 宿主中必須實際解析
GoodShepherd.Core 的 net462 輸出；測試目標不得被誤當成產品部署目標。

主要功能與流程：本檔集中 xUnit 測試框架、文件產出、嚴格分析器開關及對
GoodShepherd.Core 的單一專案參考。P2-02 先以 smoke 測試確認兩個產品目標、
組件身分及方案參考正確；P2-09a 以嵌入 TSV 保留舊來源合成黃金，避免依賴本機
相對路徑或建置殘留。後續 P2/P5 規則測試在此專案雙目標執行。

使用邊界與維護：測試只使用合成輸入，不連 D365、LINE、Hyper-V 或真實金流，
也不讀取秘密。每個涉及背景工作、連線、stream 或 cancellation 的後續測試，
必須由測試本身擁有並在 finally／await using 中確定清理；本檔不新增任何跨測試
共享可變狀態。修改 target 或參考後，須同步核對方案清單、兩目標建置與測試結果。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>SpeechMessageProducts.GoodShepherd.Core.Tests</RootNamespace>
    <AssemblyName>SpeechMessageProducts.GoodShepherd.Core.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeechMessageProducts.GoodShepherd.Core\SpeechMessageProducts.GoodShepherd.Core.csproj" />
    <EmbeddedResource Include="Golden\qr-content-legacy.tsv" />
    <EmbeddedResource Include="..\SpeechMessageProducts.LineWebhook.Tests\Golden\Keywords\routing.json" Link="Golden\webhook-routing.json" />
    <EmbeddedResource Include="Golden\flex-diagnostics.json" />
    <EmbeddedResource Include="Golden\Legacy\**\*.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <!-- 與 ToolUtility.Core 相同的條件 SDK 型別參考；不建立 ServiceClient 或引入主機 I/O。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" PrivateAssets="all" />
  </ItemGroup>
</Project>
