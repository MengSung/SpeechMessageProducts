<!--
檔案整體說明

目的與定位：定義語系、文字、金額及教會時間的雙目標純核心的MSBuild專案邊界，集中target、套件及專案參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net462;net10.0；條件評估後的實際輸出以MSBuild為準。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net10.0</TargetFrameworks>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <!-- SDK 在匯入 targets 前決定文件產出，必須於本體啟用以通過 SMQ0001／CS1591 守門。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- resx 是唯一來源，由 I18nCheck 產生程式碼；不重複嵌入資源，也不建立衛星組件。 -->
    <EmbeddedResource Remove="Resources/**/*.resx" />
    <InternalsVisibleTo Include="SpeechMessage.Localization.Tests" />
  </ItemGroup>
</Project>
