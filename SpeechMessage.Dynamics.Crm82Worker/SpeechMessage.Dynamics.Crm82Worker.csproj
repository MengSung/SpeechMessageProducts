<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- 專案已明確鎖定 net48 reference-assembly 套件；禁止 SDK 再隱式加入泛型 meta package，
         否則 packages.lock.json 會出現不一致並使 Visual Studio 進入 NuGet restore loop。 -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SpeechMessage.Dynamics.Crm82Worker</RootNamespace>
    <AssemblyName>SpeechMessage.Dynamics.Crm82Worker</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <Description>Version-isolated Dynamics CE 8.2 worker using the Microsoft XRM Tooling CrmServiceClient package.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="8.2.0.5" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="8.2.0.2" />
    <PackageReference Include="Microsoft.CrmSdk.Deployment" Version="8.2.0.2" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="8.2.0.2" />
    <PackageReference Include="Microsoft.IdentityModel.Clients.ActiveDirectory" Version="2.29.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpeechMessage.Dynamics.WorkerHost\SpeechMessage.Dynamics.WorkerHost.csproj" />
    <ProjectReference Include="..\SpeechMessage.Dynamics.WorkerProtocol\SpeechMessage.Dynamics.WorkerProtocol.csproj" />
  </ItemGroup>
</Project>
