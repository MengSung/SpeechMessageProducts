{"size":{"width":2500,"height":1686},"selected":false,"name":"nice richmenu","chatBarText":"touch me","areas":[{"bounds":{"x":0,"y":0,"width":2500,"height":1686},"action":{"type":"postback","label":"ButtonA","data":"Menu A","displayText":"Menu A"}}]}
