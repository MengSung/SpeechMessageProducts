      "dotnet",
      "build",
      "SpeechMessageProducts.sln",
      "-c",
      "Release",
      "-warnaserror:NU1605"
    ],
    "exitCode": 0,
    "childKeyUnset": true
  },
  {
    "name": "release-build",
    "command": [
      "dotnet",
      "build",
      "SpeechMessageProducts.sln",
      "-c",
      "Release",
      "-warnaserror:NU1605"
    ],
    "exitCode": 0,
    "childKeyUnset": false
  },
  {
    "name": "release-tests",
    "command": [
      "dotnet",
      "test",
      "SpeechMessageProducts.sln",
      "-c",
      "Release",
      "--no-build"
    ],
    "exitCode": 0,
    "childKeyUnset": false
  },
  {
    "name": "debug-tracer",
    "command": [
      "dotnet",
      "test",
      "ToolUtility.Dataverse.Tests",
      "-c",
      "Debug",
