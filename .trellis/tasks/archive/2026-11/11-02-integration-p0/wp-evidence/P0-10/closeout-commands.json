    ],
    "exitCode": 0,
    "childKeyUnset": false
  },
  {
    "name": "i18n",
    "command": [
      "dotnet",
      "run",
      "--project",
      "tools/I18nCheck",
      "--",
      "verify"
    ],
    "exitCode": 0,
    "childKeyUnset": false
  },
  {
    "name": "explicit-package",
    "command": [
      "dotnet",
      "build",
      "SpeechMessage.Dynamics.Plugins",
      "-c",
      "Release",
      "-p:SpeechMessagePackagePlugin=true"
    ],
    "exitCode": 0,
    "childKeyUnset": false
  },
  {
    "name": "assembly-check",
    "command": [
      "powershell",
      "-NoProfile",
      "-File",
      "tools/PluginPackaging/Test-PluginAssembly.ps1"
    ],
    "exitCode": 0,
    "childKeyUnset": false
  },
  {
    "name": "progress",
    "command": [
