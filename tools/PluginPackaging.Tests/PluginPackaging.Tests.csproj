<!--
檔案整體說明

目的與定位：定義自動化測試與契約驗證的MSBuild專案邊界，集中target、套件及專案參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net10.0；條件評估後的實際輸出以MSBuild為準。
專案參考包含PluginPackaging.csproj；不能新增反向相依或將主機狀態引入純核心。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PluginPackaging/PluginPackaging.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- 只複製中央固定 1.0.3 套件的 net462 編譯參考，產生不執行的 PE；不參考正式 Plugin 或正式金鑰。 -->
    <Content Include="$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net462/1.0.3/build/.NETFramework/v4.6.2/mscorlib.dll"
             Link="Framework/mscorlib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
