<!--
檔案整體說明

目的與定位：定義 P5-02 舊程式黃金資料工具的 net48 命令列專案；工具只讀操作者明確指定的工作樹外 Dynamics365Line 專案來源，在離線替身中執行 Plugin／Activity，不連 D365 或 LINE。

主要功能與流程：bounded reader 讀取有限舊 C# 來源閉包，Roslyn 語意改寫 HttpClient／RestClient 與檔案操作，拒絕無法攔截的 API。逐案例 AppDomain 執行真正入口，以連結共用的 FakeOrganizationService 記錄寫入、以傳輸替身記錄請求，候選通過秘密掃描後才原子發布。只編譯矩陣維持三種分類，不把編譯成功當成舊行為執行證據。

使用邊界與維護：不複製舊來源、不保存 Session、credential 或跨呼叫快取。動態組件只在案例域載入，記錄client沒有真網路handler；runner擁有域與scratch，finally卸載並關閉遺漏Dispose的有界stream，失敗不發布部分結果。套件由方案中央管理；修改後須執行建置、隔離／容量／傳輸測試、方案清單、文件與位元組檢查。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LegacyGolden.PluginHarness</RootNamespace>
    <AssemblyName>LegacyGolden.PluginHarness</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" />
    <PackageReference Include="Moq" />
    <Reference Include="System.Activities" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Xml.Linq" />
    <Compile Include="../../../SpeechMessage.Dynamics.Plugins.Tests/Fakes/*.cs" Exclude="../../../SpeechMessage.Dynamics.Plugins.Tests/Fakes/*Tests.cs" Link="Fakes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
