<!--
檔案整體說明

目的與定位：定義離線來源、翻譯資源及固定生成檔品質工具的MSBuild專案邊界，集中target、套件及專案參考，讓產品／測試依正確方向編譯。

主要功能與流程：
宣告的產品／測試target為net10.0；條件評估後的實際輸出以MSBuild為準。

使用邊界與維護：修改前先核對引用此檔的專案、頁面、腳本或CI步驟，保留既有參數、輸出及失敗結束碼。
涉及寫入、外部命令或暫存資源時，依本檔實際實作的owner及清理路徑處理；說明不能取代執行前的範圍驗證。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpeechMessageStrictCode>true</SpeechMessageStrictCode>
    <!-- 文件開關必須在 SDK 決定 DocumentationFile 之前啟用，避免嚴格模式假綠燈。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- 用真實 ILogger 符號辨識訊息樣板，避免僅按 logger 名稱造成假排除；版本沿用中央表。 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="I18nCheck.Tests" />
  </ItemGroup>
</Project>
