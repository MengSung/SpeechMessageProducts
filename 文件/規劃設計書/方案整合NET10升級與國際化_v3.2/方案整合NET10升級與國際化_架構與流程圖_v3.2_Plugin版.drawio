ometry x="840" y="432" width="420" height="180" as="geometry"/></mxCell><mxCell id="p12_c15" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="829" y="421" width="24" height="24" as="geometry"/></mxCell><mxCell id="d12_job" value="生日、年資：D365 遞迴流程照舊（決定 D20）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="582" width="380" height="40" as="geometry"/></mxCell><mxCell id="p12_c16" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="409" y="571" width="24" height="24" as="geometry"/></mxCell><mxCell id="d12_old" value="舊程式：DateTime.Now、ToLocalTime() 約 2,800 處（含副本）都跟著伺服器時區 → 搬移時一律改成 IChurchClock；新程式由分析器禁止這兩個 API。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontColor=#B85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="642" width="1220" height="52" as="geometry"/></mxCell><mxCell id="p12_c17" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="631" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="13｜宮格（Rich Menu）多語：只為啟用該語系的教會產生，數量算進 Channel 容量"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13_title" value="13｜宮格（Rich Menu）多語：只為啟用該語系的教會產生，數量算進 Channel 容量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=lef