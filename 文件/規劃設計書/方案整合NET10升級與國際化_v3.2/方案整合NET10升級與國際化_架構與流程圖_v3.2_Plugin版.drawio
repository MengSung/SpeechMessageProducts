0;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d18_r1" target="d18_s5"><mxGeometry x="-0.419" relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="482"/></Array></mxGeometry></mxCell><mxCell id="p18_c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d18_s7" target="d18_s8"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d18_s1" value="匯出現有外掛步驟與流程&lt;br&gt;（當作回復的依據）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c14" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s2" value="匯入解決方案：國際化欄位、對外待辦&lt;br&gt;（只新增）＋盤點日期欄位" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="180" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c15" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="169" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s3" value="註冊新的 Plugins.dll、Workflows.dll&lt;br&gt;新步驟先設為「停用」" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c16" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="259" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s4" value="部署 LineWebhook 的對外待辦工作&lt;br&gt;（先只記錄、不發送）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c17" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="349" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s5" value="影子模式：新 Plugin 以「只記錄」設定執行&lt;br&gt;和舊 Plugin 的結果逐筆比對" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c18" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_d1" value="差異歸零？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="545" width="240" height="96" as="geometry"/></mxCell><mxCell id="p18_c19" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="534" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s6" value="切換：停用舊步驟、啟用新步驟&lt;br&gt;流程改用新活動、待辦開始發送" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="670" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c20" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="659" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_d2" value="觀察 1 週&lt;br&gt;沒有異常？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="765" width="240" height="96" as="geometry"/></mxCell><mxCell id="p18_c21" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="754" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s7" value="移除舊 DLL 與舊步驟註冊" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="890" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c22" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="879" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_s8" value="✔ 這個組織完成&lt;br&gt;換下一個組織" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="980" width="380" height="64" as="geometry"/></mxCell><mxCell id="p18_c23" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="319" y="969" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_f1" value="修正新程式&lt;br&gt;再比對一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontColor=#B85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="553" width="220" height="80" as="geometry"/></mxCell><mxCell id="d18_r1" value="回復：重新啟用舊步驟&lt;br&gt;流程改回舊活動" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="773" width="260" height="80" as="geometry"/></mxCell><mxCell id="d18_ord" value="切換順序：&lt;br&gt;1. 測試組織&lt;br&gt;2. 使用量最小的教會&lt;br&gt;3. 使用量最大的教會&lt;br&gt;一次只動一個組織" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="260" height="150" as="geometry"/></mxCell><mxCell id="p18_c24" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="779" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d18_conv" value="日期欄位轉換&lt;br&gt;（UserLocal → DateOnly）&lt;br&gt;做了就不能改回：&lt;br&gt;先完整備份、另排時段&lt;br&gt;不和切換同一天" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="790" y="270" width="260" height="150" as="geometry"/></mxCell><mxCell id="p18_c25" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="779" y="259" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p19" name="19｜決定總表：全部已定案（2026-11-02）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1024" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p19_title" value="19｜決定總表：全部已定案（2026-11-02）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="44" as="geometry"/></mxCell><mxCell id="d19_A1" value="&lt;b&gt;A1　保留 Plugin／Workflow&lt;/b&gt;&lt;br&gt;D365 端照舊用 Plugin 與自訂工作流程活動；DLL 目標 .NET&lt;br&gt;Framework 4.8，其他維持 .NET 10。&lt;br&gt;決定：已定案：保留&lt;br&gt;對應圖：02、03" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_A2" value="&lt;b&gt;A2　36 個 DLL 收斂成 2 個&lt;/b&gt;&lt;br&gt;Plugins.dll、Workflows.dll；共用程式庫在建置時用 ILRepack&lt;br&gt;併入並簽章；日常更新用 PRT 的 Update。&lt;br&gt;決定：已定案：2 個&lt;br&gt;對應圖：04、16" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="90" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_A3" value="&lt;b&gt;A3　業務規則集中在 GoodShepherd.Core&lt;/b&gt;&lt;br&gt;同一份程式同時編出 4.8 與 .NET 10 兩版；Plugin 與網站都用&lt;br&gt;它。&lt;br&gt;決定：已定案：雙目標&lt;br&gt;對應圖：03、04" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_A4" value="&lt;b&gt;A4　Plugin 直接推播&lt;/b&gt;&lt;br&gt;非同步 Plugin 在記錄或活動建立時直接發 LINE；快速行銷活動＝&lt;br&gt;每人一次單人發送；只有圖片與撥款查詢交給 .NET 10。&lt;br&gt;決定：已定案：直接推播&lt;br&gt;對應圖：08、10、10A" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_D15" value="&lt;b&gt;D15　D365 版本&lt;/b&gt;&lt;br&gt;新程式部署在 D365 9.1。&lt;br&gt;決定：已定案：9.1&lt;br&gt;對應圖：02" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="220" width="390" height="94" as="geometry"/></mxCell><mxCell id="d19_D16" value="&lt;b&gt;D16　去重與待辦資料放哪裡&lt;/b&gt;&lt;br&gt;LINE Webhook 去重放平台 SQL；對外待辦放 D365 實體（可稽核&lt;br&gt;、可查詢）。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：08" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="220" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_D17" value="&lt;b&gt;D17　LINE Pay 是否移植&lt;/b&gt;&lt;br&gt;目前沒有客戶使用就不移植，需要時再加。&lt;br&gt;決定：已定案：不移植&lt;br&gt;對應圖：16" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="390" height="94" as="geometry"/></mxCell><mxCell id="d19_D18" value="&lt;b&gt;D18　LineWebhook 的部署位置&lt;/b&gt;&lt;br&gt;放 DMZ 對外；它同時執行對外待辦，需能連到內網的 D365。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：03" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="350" width="390" height="94" as="geometry"/></mxCell><mxCell id="d19_D19" value="&lt;b&gt;D19　LINE 訊息是否仍寫入 D365 letter&lt;/b&gt;&lt;br&gt;保留紀錄供客服查詢，但不再當作觸發機制。&lt;br&gt;決定：已定案：保留紀錄&lt;br&gt;對應圖：09" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="350" width="390" height="94" as="geometry"/></mxCell><mxCell id="d19_D20" value="&lt;b&gt;D20　生日、年資的遞迴等待流程&lt;/b&gt;&lt;br&gt;先維持 D365 遞迴流程（活動程式改用共用規則）；等待中的流程過&lt;br&gt;多時再改每日排程。&lt;br&gt;決定：已定案：先維持&lt;br&gt;對應圖：12" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="462" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_D21" value="&lt;b&gt;D21　Plugin 的目標框架&lt;/b&gt;&lt;br&gt;.NET Framework 4.8；階段 0 確認伺服器已安裝 4.8；萬一不支&lt;br&gt;援才退回 4.6.2，程式不用改。&lt;br&gt;決定：已定案：4.8&lt;br&gt;對應圖：02" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="462" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I1" value="&lt;b&gt;I1　國際化範圍&lt;/b&gt;&lt;br&gt;繁中為主；架構現在做（十件事），偽語系驗收現在做，英文只建空&lt;br&gt;殼，翻譯以後做。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：05、05A、09" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="462" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I2" value="&lt;b&gt;I2　字典的唯一來源&lt;/b&gt;&lt;br&gt;.resx 是唯一來源；建置時產生程式碼（所有語系在同一個 DLL）&lt;br&gt;並匯出 LIFF 用的 JSON。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：06、06A、14" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="592" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I3" value="&lt;b&gt;I3　會友語言存在哪裡&lt;/b&gt;&lt;br&gt;Contact.new_preferredlanguage；LIFF 偵測只當初始值。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：07、08" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="592" width="390" height="94" as="geometry"/></mxCell><mxCell id="d19_I4" value="&lt;b&gt;I4　教會改的字存在哪裡&lt;/b&gt;&lt;br&gt;新實體 new_localizedtext；會友看到的字不讀 D365 欄位標籤。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：06、08、11" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="592" width="390" height="94" as="geometry"/></mxCell><mxCell id="d19_I5" value="&lt;b&gt;I5　宮格多語策略&lt;/b&gt;&lt;br&gt;只為已啟用該語系的教會產生宮格；圖面少字；容量算進 Channel&lt;br&gt;池。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：13" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="722" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I6" value="&lt;b&gt;I6　1.5 ChurchReport 是否全面國際化&lt;/b&gt;&lt;br&gt;不全面改寫；只改搬到共用層的部分，其餘用棘輪讓中文字串只減不&lt;br&gt;增。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：14" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="722" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I7" value="&lt;b&gt;I7　時間規則&lt;/b&gt;&lt;br&gt;時間點存 UTC；聚會用當地時間＋IANA 時區（4.8 以對照表換算）&lt;br&gt;；生日 DateOnly；欄位轉換只在備份後做。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：12、18" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="722" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I8" value="&lt;b&gt;I8　2.0 新組織建立參數&lt;/b&gt;&lt;br&gt;基礎語言 zh-TW（1028）、基礎幣別 TWD；定序以實際中文資料測&lt;br&gt;試後決定。&lt;br&gt;決定：已定案：照建議&lt;br&gt;對應圖：02" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="852" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I9" value="&lt;b&gt;I9　教會自訂名詞與清單&lt;/b&gt;&lt;br&gt;名稱不同用字典的教會覆寫；奉獻類別等項目不同用教會清單（&lt;br&gt;new_offeringcategory）；都在教會設定網頁維護。&lt;br&gt;決定：已定案&lt;br&gt;對應圖：11、11A" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="425" y="852" width="390" height="112" as="geometry"/></mxCell><mxCell id="d19_I10" value="&lt;b&gt;I10　偽語系＋英文空殼&lt;/b&gt;&lt;br&gt;偽語系測試取代英文試點；英文只登記語系代碼與現有英文關鍵字，&lt;br&gt;不翻譯、不開放給教會。&lt;br&gt;決定：已定案&lt;br&gt;對應圖：05A、09" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="852" width="390" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
