ntryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05_p" target="d05_d2"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="414"/><mxPoint x="290" y="414"/></Array></mxGeometry></mxCell><mxCell id="p05_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.109;exitY=1.000;exitDx=0;exitDy=0;entryX=0.781;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05_p" target="d05_d3"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05_p" target="d05_d4"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.891;exitY=1.000;exitDx=0;exitDy=0;entryX=0.219;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05_p" target="d05_d5"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05_p" target="d05_d6"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="414"/><mxPoint x="970" y="414"/></Array></mxGeometry></mxCell><mxCell id="p05_c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05_p" target="d05_d7"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="414"/><mxPoint x="1140" y="414"/></Array></mxGeometry></mxCell><mxCell id="d05_now" value="&lt;b&gt;✔ 現在做（2.0 第一版就要有）&lt;/b&gt;&lt;br&gt;使用者看得到的字全部進字典（LINE、Flex、宮格、LIFF、錯誤訊息）&lt;br&gt;zh-TW 是預設，也是最後的後備&lt;br&gt;教會可以改術語（小組 → 細胞小組）＋sender 名稱範本&lt;br&gt;會友身分與 LINE 帳號分開；語言存在會友身上&lt;br&gt;時間存 UTC＋教會時區（IANA，例如 Asia/Taipei）&lt;br&gt;金額＝數字＋幣別（ISO 4217，例如 TWD）&lt;br&gt;偽語系測試＋英文空殼（第 05A、09 節）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="560" height="166" as="geometry"/></mxCell><mxCell id="p05_c8" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_later" value="&lt;b&gt;⏳ 有真實海外教會再做&lt;/b&gt;&lt;br&gt;英文翻譯與母語審校（現在只建英文空殼）&lt;br&gt;日、韓、印尼、越、菲等語言的翻譯&lt;br&gt;WhatsApp、Messenger 等其他通道&lt;br&gt;各國個資法規、金流、電子發票&lt;br&gt;各語系的宮格圖全套" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="560" height="130" as="geometry"/></mxCell><mxCell id="p05_c9" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="649" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_p" value="王弟兄（會友）&lt;br&gt;userId → Contact → 所屬教會" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="322" width="320" height="56" as="geometry"/></mxCell><mxCell id="p05_c10" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="459" y="311" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_d1" value="&lt;b&gt;介面語言&lt;/b&gt;&lt;br&gt;zh-TW&lt;br&gt;Contact 偏好" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="p05_c11" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_d2" value="&lt;b&gt;日期數字格式&lt;/b&gt;&lt;br&gt;跟著語言&lt;br&gt;不另外存" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="210" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="p05_c12" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="199" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_d3" value="&lt;b&gt;教會所在國家&lt;/b&gt;&lt;br&gt;GB&lt;br&gt;Account 國家" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="p05_c13" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="369" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_d4" value="&lt;b&gt;時區&lt;/b&gt;&lt;br&gt;Europe/London&lt;br&gt;Account 時區" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="d05_d5" value="&lt;b&gt;幣別&lt;/b&gt;&lt;br&gt;GBP&lt;br&gt;Account 幣別" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="d05_d6" value="&lt;b&gt;平台帳號&lt;/b&gt;&lt;br&gt;LINE userId&lt;br&gt;Contact（可多個）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="890" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="p05_c14" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="879" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_d7" value="&lt;b&gt;教會與權限&lt;/b&gt;&lt;br&gt;AccountId&lt;br&gt;伺服器判定" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="160" height="84" as="geometry"/></mxCell><mxCell id="p05_c15" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1049" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05_rule" value="規則：語言只決定「顯示什麼字」。換成英文介面，不會改變教會、權限、幣別或時區；這幾項一律由伺服器依教會資料決定。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1180" height="44" as="geometry"/></mxCell><mxCell id="p05_c16" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="549" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p05a" name="05A｜繁中為主，但現在就預留：十件「以後才補會大動干戈」的事"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="858" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p05a_title" value="05A｜繁中為主，但現在就預留：十件「以後才補會大動干戈」的事" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1260" height="44" as="geometry"/></mxCell><mxCell id="d05a_tl" value="✔ 現在就做（搬移時順手做，成本最低）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2F7D50;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="560" height="28" as="geometry"/></mxCell><mxCell id="d05a_tr" value="✖ 以後才補的代價" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="760" y="88" width="500" height="28" as="geometry"/></mxCell><mxCell id="p05a_c1" value="不做的話" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d05a_n1" target="d05a_c1"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05a_c2" value="不做的話" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fon