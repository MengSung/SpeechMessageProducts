ometry x="760" y="264" width="500" height="56" as="geometry"/></mxCell><mxCell id="d05a_n4" value="&lt;b&gt;時間存法現在定案&lt;/b&gt;&lt;br&gt;發生時間存 UTC、生日只存日期" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="600" height="56" as="geometry"/></mxCell><mxCell id="p05a_c14" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="321" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05a_c4" value="日期欄位行為改了不能改回&lt;br&gt;既有資料要逐筆轉換" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="332" width="500" height="56" as="geometry"/></mxCell><mxCell id="d05a_n5" value="&lt;b&gt;新組織建立參數&lt;/b&gt;&lt;br&gt;基礎語言繁中（1028）、基礎幣別 TWD、定序" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="600" height="56" as="geometry"/></mxCell><mxCell id="p05a_c15" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="389" width="24" height="24" as="geometry"/></mxCell><mxCell id="d05a_c5" value="組織建好後不能改&lt;br&gt;選錯只能重建" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="500" height="56" as="geometry"/></mxCell><mxCell id="d05a_n6" value="&lt;b&gt;金額一律帶幣別（TWD）&lt;/b&gt;&lt;br&gt;格式交給共用程式" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="468" width="6