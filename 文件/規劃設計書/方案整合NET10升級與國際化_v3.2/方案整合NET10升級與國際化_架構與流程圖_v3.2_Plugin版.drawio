3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1209" y="467" width="24" height="24" as="geometry"/></mxCell><mxCell id="d11_s9" value="下一則訊息&lt;br&gt;就是「細胞小組」" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1344" y="103" width="150" height="64" as="geometry"/></mxCell><mxCell id="p11_c20" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1333" y="92" width="24" height="24" as="geometry"/></mxCell><mxCell id="d11_w2" value="防：A 教會的人&lt;br&gt;改到 B 教會" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontColor=#B85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="305" y="582" width="118" height="62" as="geometry"/></mxCell><mxCell id="p11_c21" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="294" y="571" width="24" height="24" as="geometry"/></mxCell><mxCell id="d11_w3" value="防：太長被 LINE&lt;br&gt;截斷或拒收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontColor=#B85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="505" y="582" width="118" height="62" as="geometry"/></mxCell><mxCell id="d11_w8" value="防：一改就重建&lt;br&gt;全部教會" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontColor=#B85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1201" y="582" width="118" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11a" name="11A｜教會自訂：名稱不同用字典覆寫，項目不同用教會清單；兩者都在「教會設定」網頁維護"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="622" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11a_title" value="11A｜教會自訂：名稱不同用字典覆寫，項目不同用教會清單；兩者都在「教會設定」網頁維護" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1260" height="44" as="geometry"/></mxCell><mxCell id="p11a_c1" value="維護" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.238;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d11a_set" target="d11a_a"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11a_c2" value="維護" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.762;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d11a_set" target="d11a_b"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d11a_a" value="&lt;b&gt;A. 名稱不同 → 字典的教會覆寫&lt;/b&gt;&lt;br&gt;例：副小組長 → 實習小組長；小組 → 細胞小組&lt;br&gt;同一個角色或層級，只是換個名字&lt;br&gt;存在 new_localizedtext（教會＋key＋語系）&lt;br&gt;程式判斷用角色代碼，改名不影響權限&lt;br&gt;只開放白名單裡的名詞；錯誤訊息等不能改" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="580" height="130" as="geometry"/></mxCell><mxCell id="p11a_c3" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d11a_b" value="&lt;b&gt;B. 項目不同 → 教會自己的清單&lt;/b&gt;&lt;br&gt;例：奉獻類別 什一奉獻／主日奉獻／禮拜現金&lt;br&gt;每間教會的項目數量、順序、種類都不同&lt;br&gt;存在新實體 new_offeringcategory（每筆固定 ID）&lt;br&gt;收費單與報表記錄類別 ID，改名不影響舊資料&lt;br&gt;教會要「多一個角色」也屬於這一類" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="580" height="130" as="geometry"/></mxCell><mxCell id="p11a_c4" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="669" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d11a_set" value="&lt;b&gt;教會設定網頁（只有該教會的管理員）&lt;/b&gt;&lt;br&gt;名詞頁：系統預設｜本教會名稱｜預覽｜還原預設（教會啟用其他語言時才多一欄）&lt;br&gt;清單頁：新增、停用、拖曳排序、會計科目&lt;br&gt;長度上限：宮格選單列 14 字、sender 20 字，超過就不能存&lt;br&gt;管理員與教會由伺服器判定，不信任網頁送來的教會代碼；修改紀錄：誰、何時、從什麼改成什麼&lt;br&gt;存檔後 60 秒內網頁與 LINE 都換成新名稱，不用重新啟動" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1220" height="130" as="geometry"/></mxCell><mxCell id="p11a_c5" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="279" width="24" height="24" as="geometry"/></mxCell><mxCell id="d11a_now" value="&lt;b&gt;現況：要改掉的寫死處（2026-11-02 實測）&lt;/b&gt;&lt;br&gt;角色名單寫死兩份：PersonalController.cs:1457、_GeneralGroupGrids.cshtml:1313&lt;br&gt;奉獻類別「代碼 → 文字」寫了多份：DonationFeePaymentProcessor.cs:1460、RecurringDonationPaymentProcessor.cs:1012&lt;br&gt;畫面另有寫死清單：DonationPaymentView.cshtml:1003、KeyInDedicationFeeViewWeb.cshtml:679&lt;br&gt;用字已經不一致：「十一奉獻」與「什一奉獻」並存" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1220" height="112" as="geometry"/></mxCell><mxCell id="p11a_c6" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="439" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12" name="12｜時間與時區：三種時間三種存法；同一份時鐘程式在 4.8 與 .NET 10 都要算出一樣的結果"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12_title" value="12｜時間與時區：三種時間三種存法；同一份時鐘程式在 4.8 與 .NET 10 都要算出一樣的結果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1260" height="44" as="geometry"/></mxCell><mxCell id="d12_t1" value="三種時間，三種存法" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="900" height="28" as="geometry"/></mxCell><mxCell id="d12_t2" value="教會時區在兩邊怎麼換算（同一份 IChurchClock 程式）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="900" height="28" as="geometry"/></mxCell><mxCell id="p12_c1" value="存成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d12_a1" target="d12_b1"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_c2" value="使用時" st