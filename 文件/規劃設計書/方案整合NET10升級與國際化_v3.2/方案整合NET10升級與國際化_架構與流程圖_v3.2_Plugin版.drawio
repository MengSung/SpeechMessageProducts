<mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p02_c12" value="先盤點" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d02_x6l" target="d02_x6r"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d02_c1l" value="Plugin／自訂工作流程活動（.NET Framework 4.6.2～4.8，沙箱執行）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c13" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="109" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_c1r" value="照你的做法保留：36 個 DLL 收斂成 2 個，目標 4.8" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="560" height="50" as="geometry"/></mxCell><mxCell id="d02_c2l" value="語言套件＋標籤翻譯（匯出／匯入翻譯）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c14" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="173" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_c2r" value="只給 D365 後台畫面用；會友看到的字不來自這裡" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="184" width="560" height="50" as="geometry"/></mxCell><mxCell id="d02_c3l" value="日期欄位三種行為：UserLocal／DateOnly／TimeZoneIndependent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c15" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="237" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_c3r" value="時間點存 UTC；生日用 DateOnly；聚會當地時間用 TimeZoneIndependent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="248" width="560" height="50" as="geometry"/></mxCell><mxCell id="d02_c4l" value="多幣別：Account 內建 transactioncurrencyid 與匯率" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c16" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="301" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_c4r" value="教會幣別＝Account 幣別；金額一律連同幣別存" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="312" width="560" height="50" as="geometry"/></mxCell><mxCell id="d02_c5l" value="替代索引鍵＋Upsert（同一個鍵只會有一筆）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c17" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="365" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_c5r" value="術語覆寫、對外待辦都不會重複建立" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="376" width="560" height="50" as="geometry"/></mxCell><mxCell id="d02_c6l" value="樂觀並行（RowVersion）：更新時比對版本" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c18" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="429" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_c6r" value=".NET 10 認領對外待辦時，不會兩邊同時處理同一筆" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="440" width="560" height="50" as="geometry"/></mxCell><mxCell id="d02_x1l" value="Plugin 不能是 .NET 10（.NET Core 系列明列不支援）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="560" height="50" as="geometry"/></mxCell><mxCell id="p02_c19" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="553" width="24" height="24" as="geometry"/></mxCell><mxCell id="d02_x1r" value="Plugin 用 4.8；業務規則放雙目標共用程式庫（4.8＋.NET 10）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x=