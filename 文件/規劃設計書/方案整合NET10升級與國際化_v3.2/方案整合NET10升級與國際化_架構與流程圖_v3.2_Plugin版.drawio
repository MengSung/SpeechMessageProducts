ell><mxCell id="d14_g3" value="③ 每個語系的 key&lt;br&gt;與參數一致；長度上限&lt;br&gt;（sender 20、選單列 14）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="536" y="750" width="228" height="100" as="geometry"/></mxCell><mxCell id="p14_c19" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="739" width="24" height="24" as="geometry"/></mxCell><mxCell id="d14_g4" value="④ 偽語系測試：&lt;br&gt;抓出漏掉的字&lt;br&gt;與被截斷的版面" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="776" y="750" width="228" height="100" as="geometry"/></mxCell><mxCell id="p14_c20" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765" y="739" width="24" height="24" as="geometry"/></mxCell><mxCell id="d14_g5" value="⑤ 雙目標建置：&lt;br&gt;4.8 與 .NET 10 都要編過&lt;br&gt;測試兩邊都跑" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1016" y="750" width="228" height="100" as="geometry"/></mxCell><mxCell id="p14_c21" value="13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1005" y="739" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15" name="15｜效能與資源：國際化的成本小到量不出來；Plugin 只做資料與規則"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p15_title" value="15｜效能與資源：國際化的成本小到量不出來；Plugin 只做資料與規則" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1260" height="44" as="geometry"/></mxCell><mxCell id="d15_t" value="一則 LINE 回覆的時間花在哪裡（同一把尺：900 px＝200 ms）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1000" height="28" as="geometry"/></mxCell><mxCell id="d15_v1" value="約 5 µs（最慢的做法）；預載字典約 0.5 µs" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="338" y="124" width="600" height="32" as="geometry"/></mxCell><mxCell id="d15_v2" value="約 1～2 µs" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="338" y="174" width="600" height="32" as="geometry"/></mxCell><mxCell id="d15_v3" value="數十 ms（以 30 ms 示意）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="469" y="224" width="600" height="32" as="geometry"/></mxCell><mxCell id="d15_sum" value="國際化占整則處理時間 &amp;lt; 0.01%（研究報告：.NET 10.0.14 本機實測＋推估）" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2F7D50;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="1200" height="28" as="geometry"/></mxCell><mxCell id="d15_l1" value="字典取字 30 次" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="40" as="geometry"/></mxCell><mxCell id="p15_c1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="109" width="24" height="24" as="geometry"/></mxCell><mxCell id="d15_b1" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="4" height="40" as="geometry"/></mxCell><mxCell id="d15_l2" value="決定語言" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="260" height="40" as="geometry"/></mxCell><mxCell id="p15_c2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="159" width="24" height="24" as="geometry"/></mxCell><mxCell id="d15_b2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="4" height="40" as="geometry"/></mxCell><mxCell id="d15_l3" value="查 D365（同機房）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="260" height="40" as="geometry"/></mxCell><mxCell id="p15_c3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="209" width="24" height="24" as="geometry"/></mxCell><mxCell id="d15_b3" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="135" height="40" as="geometry"/></mxCell><mxCell id="d15_l4" value="呼叫 LINE API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="260" height="40" as="geometry"/></mxCell><mxCell id="p15_c4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="259" width="24" height="24" as="geometry"/></mxCell><mxCell id="d15_b4" value="數十～數百 ms（以 200 ms 示意）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="900" height="40" as="geometry"/></mxCell><mxCell id="d15_bad" value="&lt;b&gt;會讓系統變慢的錯誤做法（禁止）&lt;/b&gt;&lt;br&gt;每次請求讀檔解析 JSON：約 121 µs（慢 1 萬倍）&lt;br&gt;執行期呼叫機器翻譯：秒級，還要付費&lt;br&gt;每次組訊息都查 D365 覆寫：多一次數十 ms&lt;br&gt;在 Plugin 裡一次推播多人、畫圖或呼叫金流&lt;br&gt;LIFF 一次載入所有語系的字典" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="600" height="130" as="geometry"/></mxCell><mxCell id="p15_c5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="359" width="24" height="24" as="geometry"/></mxCell><mxCell id="d15_good" value="&lt;b&gt;本計畫的做法&lt;/b&gt;&lt;br&gt;系統字典：建置時產生程式碼，啟動時載入一次&lt;br&gt;教會覆寫：每間教會一份快照，60 秒內換新&lt;br&gt;語言：讀一次 Contact，跟著工作一起走&lt;br&gt;Plugin 推播每次 1 人；圖片與撥款查詢交給對外待辦&lt;br&gt;LIFF：只載入目前語言的 JSON" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="580" height="130" as="geometry"/></mxCell><mxCell id="p15_c6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="669" y="359" width="24" height="24" as="geometry"/></mxCell><mxCell id="d15_res" value="&lt;b&gt;資源與隔離（AGENTS.md 硬規則）&lt;/b&gt;&lt;br&gt;快取上限：教會快照最多 2,000 份、閒置 30 分鐘釋放；同一間教會同時只載入一次&lt;br&gt;快取的鍵一定包含教會 ID＋異動時間；不會只用語言當鍵，所以 A 教會改的字不會出現在 B 教會&lt;br&gt;Plugin 不放跨執行的可變靜態資料（沙箱會重用程序）；推播以活動 ID 當 Retry Key 防重複&lt;br&gt;背景工作不保存 HttpContext／Session；不修改程序全域的 DefaultThreadCurrentCulture&lt;br&gt;驗收：A／B 教會、不同語言同時壓測，回應不串、快取筆數與記憶體回到基線" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="1220" height="130" as="geometry"/></mxCell><mxCell id="p15_c7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="524" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="16｜每個舊專案去哪裡（◆ Dynamics365Line　● LineApiWebhook　■ 主方案自己要合併的部分）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p16_title" value="16｜每個舊專案去哪裡（◆ Dynamics365Line　● LineApiWebhook　■ 主方案自己要合併的部分）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1420" height="44" as="geometry"/></mxCell><mxCell id="c_core_band" value="SpeechMessageProducts.GoodShepherd.Core（新・雙目標 net48＋net10.0）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;arcSize=4;" vertex="1" parent="1"><mxGeometry x="410" y="82" width="540" height="1056" as="geometry"/></mxCell><mxCell id="c_lw" value="&lt;b&gt;SpeechMessageProducts.LineWebhook（新・.NET 10）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9673A6&quot;&gt;●&lt;/font&gt; LineApiWebhook 的 Program.cs（只留組裝）&lt;br&gt;新建：對外待辦的背景工作" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="372" height="76" as="geometry"/></mxCell><mxCell id="c_plg" value="&lt;b&gt;SpeechMessage.Dynamics.Plugins（D365・4.8）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; 11 個外掛的外殼（IPlugin）&lt;br&gt;規則在 GoodShepherd.Core，建置時併入" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="372" height="76" as="geometry"/></mxCell><mxCell id="c_wf" value="&lt;b&gt;SpeechMessage.Dynamics.Workflows（D365・4.8）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; 18 個工作流程活動的外殼（CodeActivity）&lt;br&gt;規則在 GoodShepherd.Core，建置時併入" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="372" height="76" as="geometry"/></mxCell><mxCell id="c_del" value="&lt;b&gt;刪除／不移植&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; TemplatePlugIn・ExampleWorkflow&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; WorkflowTemplate&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; NewPersonCareWorkflow-ForDebug&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; Line.NotifyBot（LINE Notify 已終止）&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; Trace（改用 ITracingService／ILogger）&lt;br&gt;&lt;font color=&quot;#D79B00&quot;&gt;◆&lt;/font&gt; Dynamics365Line.csproj（空專案）&lt;br&gt;&lt;font color=&quot;#9673A6&quot;&gt;●&lt;/font&gt; LineNotifyLibrary・QPay.Domain・Trace&lt;br&gt;&