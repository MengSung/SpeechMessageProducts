ht="76" as="geometry"/></mxCell><mxCell id="p06a_c12" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="325" width="24" height="24" as="geometry"/></mxCell><mxCell id="d06a_b3" value="每個語系一個 JSON 檔&lt;br&gt;檔名帶內容雜湊" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="310" y="336" width="300" height="76" as="geometry"/></mxCell><mxCell id="d06a_c3" value="只下載目前語言那一份&lt;br&gt;瀏覽器長期快取" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="336" width="330" height="76" as="geometry"/></mxCell><mxCell id="d06a_d3" value="下載一次後&lt;br&gt;不再下載" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="336" width="240" height="76" as="geometry"/></mxCell><mxCell id="d06a_mem" value="記憶體上限：&lt;br&gt;系統字典每個語系約 1～2 MB（數千到一萬筆）&lt;br&gt;教會快照最多 2,000 份、閒置 30 分鐘釋放&lt;br&gt;同一間教會同時只讀一次 D365" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="600" height="110" as="geometry"/></mxCell><mxCell id="p06a_c13" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="439" width="24" height="24" as="geometry"/></mxCell><mxCell id="d06a_iso" value="隔離與正確性：&lt;br&gt;快取鍵一定含教會 ID：A 教會的字不會出現在 B 教會&lt;br&gt;字典唯讀、不含個資，Plugin 多次執行共用同一份是安全的&lt;br&gt;key 重複、缺字、參數不一致在建置或啟動時就報錯" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="660" y="450" width="600" height="110" as="geometry"/></mxCell><mxCell id="p06a_c14" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="649" y="439" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p07" name="07｜會友的語言怎麼決定：寫進 Contact，每次用的時候再讀"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p07_title" value="07｜會友的語言怎麼決定：寫進 Contact，每次用的時候再讀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1180" height="44" as="geometry"/></mxCell><mxCell id="d07_ta" value="A. 語言怎麼寫進 Contact" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="340" height="28" as="geometry"/></mxCell><mxCell id="d07_tb" value="B. 每次要用時怎麼決定" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="430" y="90" width="400" height="28" as="geometry"/></mxCell><mxCell id="p07_c1" value="取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_l1" target="d07_l2"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c2" value="儲存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_l3" target="d07_l4"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_s1" target="d07_s2"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_s2" target="d07_d1"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c5" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_d1" target="d07_d2"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_d2" target="d07_r1"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_d2" target="d07_s4"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_c8" value="沒有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_d1" target="d07_s4"><mxGeometry x="0.111" relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="365"/><mxPoint x="400" y="625"/></Array></mxGeometry></mxCell><mxCell id="p07_c9" value="沒設" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d07_s4" target="d07_s5"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d07_l1" value="LIFF 第一次開啟&lt;br&gt;liff.getAppLanguage()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="64" as="geometry"/></mxCell><mxCell id="p07_c10" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="119" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_l2" value="Contact 還沒有偏好時才寫入&lt;br&gt;（來源＝LIFF 偵測）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="64" as="geometry"/></mxCell><mxCell id="d07_l3" value="會友自己選：LIFF 設定頁&lt;br&gt;或打「English」「中文」" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="320" height="64" as="geometry"/></mxCell><mxCell id="p07_c11" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="359" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_l4" value="寫入 Contact（來源＝自選）&lt;br&gt;換成該語系的宮格" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="320" height="64" as="geometry"/></mxCell><mxCell id="d07_l5" value="LINE 的 Messaging API&lt;br&gt;拿不到會友的語言，&lt;br&gt;所以一定要先存在 Contact" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="320" height="100" as="geometry"/></mxCell><mxCell id="p07_c12" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="599" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_s1" value="收到 LINE 事件，或會友開啟 LIFF" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="130" width="340" height="56" as="geometry"/></mxCell><mxCell id="p07_c13" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="419" y="119" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_s2" value="userId → Contact → 所屬教會&lt;br&gt;先決定是哪間教會（不看語言）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="220" width="340" height="60" as="geometry"/></mxCell><mxCell id="d07_d1" value="Contact 有&lt;br&gt;語言偏好？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="315" width="260" height="100" as="geometry"/></mxCell><mxCell id="p07_c14" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="459" y="304" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_d2" value="在教會啟用的&lt;br&gt;語系清單內？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="455" width="260" height="100" as="geometry"/></mxCell><mxCell id="p07_c15" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="459" y="444" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_r1" value="✔ 用會友自己的語言" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="475" width="300" height="60" as="geometry"/></mxCell><mxCell id="d07_s4" value="用教會預設語言&lt;br&gt;（Account.new_defaultlanguage）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="595" width="340" height="60" as="geometry"/></mxCell><mxCell id="p07_c16" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="419" y="584" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_s5" value="教會也沒設 → zh-TW（系統預設）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="695" width="340" height="56" as="geometry"/></mxCell><mxCell id="p07_c17" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="419" y="684" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_n1" value="規則：&lt;br&gt;語言只決定顯示什麼字&lt;br&gt;不改教會、權限、幣別、時區&lt;br&gt;教會一定先由 userId 決定" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="300" height="130" as="geometry"/></mxCell><mxCell id="p07_c18" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="849" y="119" width="24" height="24" as="geometry"/></mxCell><mxCell id="d07_n2" value="背景工作（推播、排程）：&lt;br&gt;語言是工作參數的一部分&lt;br&gt;不用執行緒的預設文化" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="590" width="300" height="110" as="geometry"/></mxCell><mxCell id="p07_c19" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="849" y="579" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p08" name="08｜D365 9.1 要加什麼：2 個既有實體加欄位、3 個新實體、4 組 Plugin 步驟"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p08_title" value="08｜D365 9.1 要加什麼：2 個既有實體加欄位、3 個新實體、4 組 Plugin 步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1260" height="44" as="geometry"/></mxCell><mxCell id="p08_c1" value="N:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d08_lt" target="d08_acc"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08_c2" value="所屬教會" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.337;entryDx=0;entryDy=0;" edge="1" parent="1" source="d08_con" target="d08_acc"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08_c3" value="異動時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d08_lt" target="d08_plg"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08_c4" value="建立待辦" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="d08_plg" target="d08_ob"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="566"/><mxPoint x="680" y="416"/></Array></mxGeometry></mxCell><mxCell id="p08_c5" value="認領" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4D4D4D;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="d08_wk" target="d08_ob"><mxGeometry x="0.000" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d08_acc" value="&lt;b&gt;Account（教會）— 既有實體，加 5 個欄位&lt;/b&gt;&lt;br&gt;new_defaultlanguage　預設語言（zh-TW）&lt;br&gt;new_enabledlanguages　啟用語系（zh-TW,en）&lt;br&gt;new_timezone　時區（Asia/Taipei，IANA）&lt;br&gt;new_countrycode　國家（TW，ISO 3166）&lt;br&gt;new_textchangedon　教會改字的時間（Plugin 更新）&lt;br&gt;transactioncurrencyid　幣別（內建，TWD）&lt;br&gt;品牌欄位：名稱・Logo・主題色（既有設計）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="600" height="166" as="geometry"/></mxCell><mxCell id="p08_c6" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_con" value="&lt;b&gt;Contact（會友）— 既有實體，加 2 個欄位&lt;/b&gt;&lt;br&gt;new_preferredlanguage　偏好語言（空白＝跟教會）&lt;br&gt;new_languagesource　來源（自選／LIFF 偵測／預設）&lt;br&gt;new_lineid　LINE userId（既有）&lt;br&gt;birthdate　生日（內建，DateOnly）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="540" height="112" as="geometry"/></mxCell><mxCell id="p08_c7" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="709" y="79" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_ch" value="&lt;b&gt;new_linechannel（新實體：LINE Channel）&lt;/b&gt;&lt;br&gt;Channel ID、名稱、所屬教會&lt;br&gt;Access Token（加密存放，只有系統管理員可讀）&lt;br&gt;解密金鑰：Plugin 在步驟安全設定、主機在設定檔" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="540" height="94" as="geometry"/></mxCell><mxCell id="p08_c8" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="709" y="209" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_lt" value="&lt;b&gt;new_localizedtext（新實體：教會改的字）&lt;/b&gt;&lt;br&gt;new_accountid　教會（必填，Lookup）&lt;br&gt;new_key　字典 key（例：Org.Level.Group）&lt;br&gt;new_culture　語系（* ＝不分語系）&lt;br&gt;new_text　文字&lt;br&gt;替代索引鍵：教會＋key＋語系（唯一）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="600" height="130" as="geometry"/></mxCell><mxCell id="p08_c9" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="329" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_ob" value="&lt;b&gt;new_outboundtask（新實體：對外待辦）&lt;/b&gt;&lt;br&gt;new_type　宮格產生／QR 圖片／撥款查詢&lt;br&gt;new_payload　只放 ID 與數值&lt;br&gt;new_status　待處理／處理中／完成／失敗&lt;br&gt;new_idempotencykey　冪等鍵（替代索引鍵）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="540" height="112" as="geometry"/></mxCell><mxCell id="p08_c10" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="709" y="349" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_plg" value="&lt;b&gt;Plugin 步驟（Plugins.dll，非同步）&lt;/b&gt;&lt;br&gt;letter／LINE 活動 建立 → 直接推播給該會友（群發）&lt;br&gt;Contact 偏好語言更新 → 直接換綁宮格&lt;br&gt;Account 語系欄位更新 → 建對外待辦（產生宮格）&lt;br&gt;new_localizedtext 異動 → 更新 new_textchangedon" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="600" height="112" as="geometry"/></mxCell><mxCell id="p08_c11" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="499" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_wk" value="&lt;b&gt;.NET 10 端（LineWebhook 背景工作）&lt;/b&gt;&lt;br&gt;每 5 秒認領對外待辦（宮格、QR 圖片、撥款）&lt;br&gt;每 30 秒查 new_textchangedon → 換快照" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="540" height="76" as="geometry"/></mxCell><mxCell id="p08_c12" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="709" y="509" width="24" height="24" as="geometry"/></mxCell><mxCell id="d08_note" value="欄位前綴 new_ 沿用現有發行者；欄位、實體與 Plugin 步驟放在同一個受管理解決方案，2.0 新組織與既有組織都能匯入。" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1220" height="40" as="geometry"/></mxCell><mxCell id="p08_c13" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="639" width="24" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p09" name="09｜偽語系測試：不用翻譯，就能證明系統已經準備好國際化（紅框是要抓出的問題）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1602" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p09_title" value="09｜偽語系測試：不用翻譯，就能證明系統已經準備好國際化（紅框是要抓出的問題）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1522" height="44" as="geometry"/></mxCell><mxCell id="d09_L1_b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="1352" height="90" as="geometry"/></mxCell><mxCell id="d09_L1" value="建置&lt;br&gt;（I18nCheck）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#3A5068;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="170" height="90" as="geometry"/></mxCell><mxCell id="d09_L2_b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#D0D7DE;" vertex="1" parent="1"><mxGeometry x="190" y="180" width="1352" height="90" as="geometry"/></mxCell><mxCell id="d09_L2" value="測試環境&lt;br&gt;（偽語系教會）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#3A5068;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="170" height="90" as="geometry"/></mxCell><mxCell id="d09_L3_b" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;" vertex="1" parent="1"><mxGeometry x="190" y="270" width="1352" height="100" as="geometry"/></mxCell><mxCell id="d09_L3" value="自動檢查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3A5068;strokeColor=#3A5068;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry 